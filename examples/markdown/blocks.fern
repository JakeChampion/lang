// The block structure of a CommonMark 0.31.2 document. This is the first of
// the two phases in the appendix of the spec. The parser reads the source one
// line at a time. It keeps a stack of the open blocks, and it writes each
// block to a log, as md4c does. The second phase, the inline parse, reads the
// text of the paragraphs and headings in the log.
//
// The log has RS i32 fields for each record, in the order of the document.
// A container block has a record where it starts and an END record where it
// ends, with the records of its children between them. A leaf block gets its
// record when it closes. A leaf block keeps no copy of its text: it holds a
// range of line segments, and each segment is a range of the source.
import "core/map";
import "std/string";
import "./refs";
import "./tags";

pub const DOCUMENT: i32 = 0;

pub const QUOTE: i32 = 1;

pub const LIST: i32 = 2;

pub const ITEM: i32 = 3;

pub const CODE: i32 = 4;

pub const HTML: i32 = 5;

pub const PARAGRAPH: i32 = 6;

pub const HEADING: i32 = 7;

pub const RULE: i32 = 8;

// The end of a container block.
pub const END: i32 = 9;

pub const NONE: i32 = -1;

// The fields of a record. The first field holds the kind in its low four
// bits, and the flags above them.
pub const KIND: i32 = 0;

// The first segment of a leaf block, and the segment after its last one.
pub const SFROM: i32 = 1;

pub const STO: i32 = 2;

// The level of a heading, the start number of an ordered list, or the kind
// of the container that an END record ends.
pub const A: i32 = 3;

pub const RS: i32 = 4;

// The flags of a record.
pub const F_TIGHT: i32 = 16;

pub const F_FENCED: i32 = 32;

pub const F_ORDERED: i32 = 64;

// The flags of an open block. F_BLANK is true when the block ends with a
// blank line. F_PARA is true for a block that starts as a paragraph.
const F_BLANK: i32 = 128;

const F_LOOSE: i32 = 256;

const F_PARA: i32 = 512;

// The fields of an open block on the stack. S_A is the marker of a list, the
// fence character of a code block, the kind of an HTML block or the level of
// a heading. S_B is the start number of a list or the length of a code fence.
// S_C is the column of a list marker or the indent of a code fence. S_D is
// the width of a list marker and the spaces after it.
const S_KIND: i32 = 0;

const S_FLAGS: i32 = 1;

const S_A: i32 = 2;

const S_B: i32 = 3;

const S_C: i32 = 4;

const S_D: i32 = 5;

const S_LINE: i32 = 6;

const S_FROM: i32 = 7;

const S_LOG: i32 = 8;

// What a list or a list item needs to know of its last closed child: NONE
// when it has no child, else L_BLANK when the child ends with a blank line,
// and L_DEEP with L_DEEP_BLANK for a child that is a list or an item that
// is not empty. The last block in such a child gives the answer for it.
const S_LAST: i32 = 9;

const SS: i32 = 16;

const L_BLANK: i32 = 1;

const L_DEEP: i32 = 2;

const L_DEEP_BLANK: i32 = 4;

// A parsed document. A segment is the start and the end of a line in `src`,
// with the spaces that a partly used tab gives at the start of the line.
pub struct Doc { src: string, log: i32[], segs: i64[], refs: Map[string, refs.Ref] }

// The number of records.
pub function (d: Doc) count(): i32 {
  return d.log.len() / RS;
}

pub function (d: Doc) get(r: i32, field: i32): i32 {
  return d.log[r * RS + field];
}

pub function (d: Doc) kind(r: i32): i32 {
  return d.log[r * RS] & 15;
}

pub function (d: Doc) has_flag(r: i32, flag: i32): boolean {
  return (d.log[r * RS] & flag) != 0;
}

@inline
pub function seg_start(s: i64): i32 {
  return (s & 0x7FFFFFFFi64) as i32;
}

@inline
pub function seg_end(s: i64): i32 {
  return (s >> 31i64 & 0x7FFFFFFFi64) as i32;
}

@inline
pub function seg_pad(s: i64): i32 {
  return (s >> 62i64 & 3i64) as i32;
}

@inline
function seg(start: i32, end: i32, pad: i32): i64 {
  return start as i64 | end as i64 << 31i64 | pad as i64 << 62i64;
}

struct P { log: i32[], segs: i64[], st: i32[], depth: i32, refs: Map[string, refs.Ref] }

@inline
function sget(p: P, d: i32, field: i32): i32 {
  return p.st[d * SS + field];
}

@inline
function sset(p: P, d: i32, field: i32, v: i32): P {
  return P { ...p, st: p.st.with(d * SS + field, v) };
}

@inline
function skind(p: P, d: i32): i32 {
  return p.st[d * SS + S_KIND];
}

@inline
function has_flag(p: P, d: i32, flag: i32): boolean {
  return (p.st[d * SS + S_FLAGS] & flag) != 0;
}

function set_flag(p: P, d: i32, flag: i32, on: boolean): P {
  let f = sget(p, d, S_FLAGS);
  if (on == ((f & flag) != 0)) {
    return p;
  }
  return sset(p, d, S_FLAGS, f ^ flag);
}

// The byte at `i` on the line that ends at `le`. The parser sees a line feed
// at the end of every line, and nothing after it.
@inline
function at(src: string, le: i32, i: i32): i32 {
  if (i < le) {
    return src[i] as i32;
  }
  if (i == le) {
    return 10;
  }
  return 0;
}

@inline
function is_space_or_tab(c: i32): boolean {
  return c == 32 || c == 9;
}

function can_contain(parent: i32, child: i32): boolean {
  if (parent == DOCUMENT || parent == QUOTE || parent == ITEM) {
    return child != ITEM;
  }
  return parent == LIST && child == ITEM;
}

@inline
function accepts_lines(k: i32): boolean {
  return k == PARAGRAPH || k == HEADING || k == CODE || k == HTML;
}

// The first byte after the spaces and tabs at `off`, and its column.
@inline
function first_nonspace(src: string, le: i32, off: i32, col: i32): (i32, i32) {
  let i = off;
  let c = col;
  while (i < le) {
    let b = src[i];
    if (b == b' ') {
      c += 1;
    } else if (b == b'\t') {
      c += 4 - (c & 3);
    } else {
      break;
    }
    i += 1;
  }
  return (i, c);
}

// The cursor `off`, `col` and `partial` moved on by `count` bytes, or by
// `count` columns when `columns` is true. A tab that is wider than the
// columns that are left is used only in part, and then `partial` is true.
function advance(src: string, le: i32, off0: i32, col0: i32, partial0: boolean, count: i32, columns: boolean): (i32, i32, boolean) {
  let off = off0;
  let col = col0;
  let partial = partial0;
  let left = count;
  while (left > 0 && off <= le) {
    if (off < le && src[off] == b'\t') {
      let tab = 4 - (col & 3);
      if (columns) {
        partial = tab > left;
        let step = tab;
        if (left < tab) {
          step = left;
        }
        col += step;
        if (!partial) {
          off += 1;
        }
        left -= step;
      } else {
        partial = false;
        col += tab;
        off += 1;
        left -= 1;
      }
    } else {
      partial = false;
      off += 1;
      col += 1;
      left -= 1;
    }
  }
  return (off, col, partial);
}

// Adds the rest of the line from the cursor, up to `end`, to the open leaf
// block.
function add_line(p: P, off: i32, col: i32, partial: boolean, end: i32): P {
  let pad = 0;
  let start = off;
  if (partial) {
    start += 1;
    pad = 4 - (col & 3);
  }
  if (start > end) {
    start = end;
  }
  return P { ...p, segs: p.segs.append(seg(start, end, pad)) };
}

// Closes open blocks until the block at `depth` is the deepest open block.
function close_below(p: P, src: string, depth: i32): P {
  let q = p;
  while (q.depth - 1 > depth) {
    q = close_top(q, src);
  }
  return q;
}

// What the parent of the block at `d` needs to know of it when it closes.
function last_info(p: P, d: i32, k: i32): i32 {
  let info = 0;
  if (has_flag(p, d, F_BLANK)) {
    info = L_BLANK;
  }
  let last = sget(p, d, S_LAST);
  if (k == LIST || k == ITEM && last != NONE) {
    info |= L_DEEP;
    if (ends_blank(last)) {
      info |= L_DEEP_BLANK;
    }
  }
  return info;
}

// True when the closed block that `info` describes ends with a blank line.
// A list or an item ends with one when its last child does.
@inline
function ends_blank(info: i32): boolean {
  if ((info & L_DEEP) != 0) {
    return (info & L_DEEP_BLANK) != 0;
  }
  return (info & L_BLANK) != 0;
}

// A list is loose when a blank line is between two of its items, or between
// two blocks of one item. The block at `parent` gets a new child after the
// closed child that `last` describes, so that child is not the end of the
// list. A paragraph that holds only link reference definitions is not a
// block, so the check for a paragraph waits until it closes.
function check_loose(p: P, parent: i32, last: i32): P {
  if (last == NONE) {
    return p;
  }
  let k = skind(p, parent);
  if (k == ITEM && ends_blank(last)) {
    return set_flag(p, parent - 1, F_LOOSE, true);
  }
  if (k == LIST && ((last & L_BLANK) != 0 || (last & L_DEEP_BLANK) != 0)) {
    return set_flag(p, parent, F_LOOSE, true);
  }
  return p;
}

function close_top(p0: P, src: string): P {
  let d = p0.depth - 1;
  let k = skind(p0, d);
  let p = P { ...p0, depth: d };
  if (k == PARAGRAPH) {
    let (q, has_text) = take_defs(p, src, d);
    if (!has_text) {
      return q;
    }
    p = q;
  }
  if (has_flag(p, d, F_PARA)) {
    p = check_loose(p, d - 1, sget(p, d - 1, S_LAST));
  }
  p = write_record(p, src, d, k);
  return sset(p, d - 1, S_LAST, last_info(p, d, k));
}

// Writes the record of the block at `d`, which closes.
function write_record(p: P, src: string, d: i32, k: i32): P {
  let to = p.segs.len();
  let from = sget(p, d, S_FROM);
  if (k == PARAGRAPH || k == HTML) {
    return P { ...p, log: p.log.append(k).append(from).append(to).append(0) };
  }
  if (k == HEADING) {
    return P { ...p, log: p.log.append(k).append(from).append(to).append(sget(p, d, S_A)) };
  }
  if (k == CODE) {
    if (has_flag(p, d, F_FENCED)) {
      return P { ...p, log: p.log.append(CODE | F_FENCED).append(from).append(to).append(0) };
    }
    while (to > from && blank_segment(src, p.segs[to - 1])) {
      to -= 1;
    }
    return P { ...p, log: p.log.append(CODE).append(from).append(to).append(0) };
  }
  if (k == RULE) {
    return P { ...p, log: p.log.append(RULE).append(0).append(0).append(0) };
  }
  if (k == LIST) {
    let flags = sget(p, d, S_FLAGS) & F_ORDERED;
    let head = flags | LIST;
    if (!has_flag(p, d, F_LOOSE)) {
      head |= F_TIGHT;
    }
    let r = sget(p, d, S_LOG);
    return P { ...p, log: p.log.with(r, head).with(r + 1, sget(p, d, S_B)).append(END | flags).append(0).append(0).append(LIST) };
  }
  return P { ...p, log: p.log.append(END).append(0).append(0).append(k) };
}

// Adds a new block of `k` as the last child of the open block at `depth`, or
// of the nearest open block above it that can hold it. Each open block below
// the parent closes. The new block is the deepest open block.
function add_child(p0: P, src: string, depth: i32, k: i32, line: i32): P {
  let p = close_below(p0, src, depth);
  while (!can_contain(skind(p, p.depth - 1), k)) {
    p = close_top(p, src);
  }
  let parent = p.depth - 1;
  let flags = 0;
  if (k == PARAGRAPH) {
    flags = F_PARA;
  } else {
    p = check_loose(p, parent, sget(p, parent, S_LAST));
  }
  let d = p.depth;
  let at = d * SS;
  if (at + SS > p.st.len()) {
    p = P { ...p, st: grow(p.st) };
  }
  let r = p.log.len();
  if (k == QUOTE || k == LIST || k == ITEM) {
    p = P { ...p, log: p.log.append(k).append(0).append(0).append(0) };
  }
  let from = p.segs.len();
  return P { ...p, st: p.st.with(at + S_KIND, k).with(at + S_FLAGS, flags).with(at + S_LINE, line).with(at + S_FROM, from).with(at + S_LOG, r).with(at + S_LAST, NONE), depth: d + 1 };
}

// The stack with room for one more open block.
function grow(st: i32[]): i32[] {
  let out = st;
  for _ in 0..SS {
    out = out.append(0);
  }
  return out;
}

// The text of the segments `from` to `to`, a line feed after each line.
pub function seg_text(src: string, segs: i64[], from: i32, to: i32): string {
  let b = buf_new(64);
  for k in from..to {
    let s = segs[k];
    for _ in 0..seg_pad(s) {
      buf_push_byte(b, 32);
    }
    buf_push_range(b, src, seg_start(s), seg_end(s));
    buf_push_byte(b, 10);
  }
  let out = buf_take(b);
  buf_free(b);
  return out;
}

// Takes the link reference definitions at the start of the paragraph at `d`
// out of its lines. Gives false when no text is left.
function take_defs(p: P, src: string, d: i32): (P, boolean) {
  let from = sget(p, d, S_FROM);
  let to = p.segs.len();
  if (from == to) {
    return (p, false);
  }
  let first = p.segs[from];
  if (seg_pad(first) > 0 || src[seg_start(first)] != b'[') {
    return (p, true);
  }
  let text = seg_text(src, p.segs, from, to);
  let (end, found) = refs.take_defs(text, p.refs);
  let k = from;
  let pos = 0;
  while (pos < end) {
    let s = p.segs[k];
    pos += seg_pad(s) + seg_end(s) - seg_start(s) + 1;
    k += 1;
  }
  let q = sset(P { ...p, refs: found }, d, S_FROM, k);
  return (q, k < to);
}

function blank_segment(src: string, s: i64): boolean {
  for i in seg_start(s)..seg_end(s) {
    if (!is_space_or_tab(src[i] as i32)) {
      return false;
    }
  }
  return true;
}

// The length of a closing code fence of `fence` at `i`, or 0.
function closing_fence(src: string, le: i32, i: i32, fence: i32): i32 {
  let j = i;
  while (at(src, le, j) == fence) {
    j += 1;
  }
  let len = j - i;
  if (len < 3) {
    return 0;
  }
  while (is_space_or_tab(at(src, le, j))) {
    j += 1;
  }
  if (j != le) {
    return 0;
  }
  return len;
}

// The length of an opening code fence at `i`, or 0. The info string of a
// backtick fence has no backtick.
function opening_fence(src: string, le: i32, i: i32): i32 {
  let fence = at(src, le, i);
  let j = i;
  while (at(src, le, j) == fence) {
    j += 1;
  }
  let len = j - i;
  if (len < 3) {
    return 0;
  }
  if (fence == 96) {
    for k in j..le {
      if (src[k] == b'`') {
        return 0;
      }
    }
  }
  return len;
}

// The length of the start of an ATX heading at `i`: one to six `#`, then
// spaces and tabs or the end of the line. Gives 0 when there is none.
function atx_start(src: string, le: i32, i: i32): i32 {
  let j = i;
  while (at(src, le, j) == 35 && j - i < 7) {
    j += 1;
  }
  let level = j - i;
  if (level > 6) {
    return 0;
  }
  let c = at(src, le, j);
  if (c == 10) {
    return level + 1;
  }
  if (!is_space_or_tab(c)) {
    return 0;
  }
  while (is_space_or_tab(at(src, le, j))) {
    j += 1;
  }
  return j - i;
}

// 1 for a line of `=` and 2 for a line of `-`, with optional spaces and tabs
// after it, or 0.
function setext_level(src: string, le: i32, i: i32): i32 {
  let c = at(src, le, i);
  let j = i;
  while (at(src, le, j) == c) {
    j += 1;
  }
  while (is_space_or_tab(at(src, le, j))) {
    j += 1;
  }
  if (j != le) {
    return 0;
  }
  if (c == 61) {
    return 1;
  }
  return 2;
}

// True for three or more `*`, `-` or `_` of one kind, with only spaces and
// tabs between them.
function is_rule(src: string, le: i32, i: i32): boolean {
  let c = at(src, le, i);
  if (c != 42 && c != 45 && c != 95) {
    return false;
  }
  let count = 0;
  let j = i;
  let d = c;
  while (d == c || is_space_or_tab(d)) {
    if (d == c) {
      count += 1;
    }
    j += 1;
    d = at(src, le, j);
  }
  return count >= 3 && d == 10;
}

// The end of the text of an ATX heading: the line without a closing
// sequence of `#` and without the spaces at its end.
function atx_text_end(src: string, start: i32, le: i32): i32 {
  let e = rtrim(src, start, le);
  let k = e - 1;
  while (k >= start && src[k] == b'#') {
    k -= 1;
  }
  if (k != e - 1 && k >= start && is_space_or_tab(src[k] as i32)) {
    return rtrim(src, start, k);
  }
  if (k != e - 1 && k < start) {
    return start;
  }
  return e;
}

function rtrim(src: string, start: i32, end: i32): i32 {
  let e = end;
  while (e > start && refs.is_space(src[e - 1] as i32)) {
    e -= 1;
  }
  return e;
}

pub function parse(source: string): Doc {
  let src = without_nul(source);
  let st: i32[] = __alloc_i32(SS * 8).with(S_LAST, NONE);
  let p = P { log: [], segs: [], st: st, depth: 1, refs: Map { } };
  let n = src.len();
  let ends = __alloc_u8(14).with(10, 1 as u8).with(13, 1 as u8);
  if (__memchr(src, 13, 0) < 0) {
    ends = [];
  }
  let pos = bom_length(src);
  let line = 0;
  while (pos < n) {
    let le = line_end(src, pos, ends);
    line += 1;
    p = process_line(p, src, pos, le, line);
    pos = le + 1;
    if (le + 1 < n && src[le] == b'\r' && src[le + 1] == b'\n') {
      pos += 1;
    }
  }
  while (p.depth > 1) {
    p = close_top(p, src);
  }
  return Doc { src: src, log: p.log, segs: p.segs, refs: p.refs };
}

// 3 when the source starts with a UTF-8 byte order mark, and 0 otherwise.
function bom_length(s: string): i32 {
  if (s.len() >= 3 && s[0] == 0xEF as u8 && s[1] == 0xBB as u8 && s[2] == 0xBF as u8) {
    return 3;
  }
  return 0;
}

// The index of the line ending after `pos`, or the length of the source. A
// source with a carriage return gives the table of line ending bytes `ends`,
// and other sources give an empty table.
function line_end(src: string, pos: i32, ends: u8[]): i32 {
  if (ends.len() > 0) {
    return __scan_set(src, pos, ends);
  }
  let le = __memchr(src, 10, pos);
  if (le < 0) {
    return src.len();
  }
  return le;
}

// The source with each NUL byte replaced by U+FFFD.
function without_nul(s: string): string {
  if (__memchr(s, 0, 0) < 0) {
    return s;
  }
  let b = buf_new(s.len() + 16);
  let from = 0;
  let i = __memchr(s, 0, 0);
  while (i >= 0) {
    buf_push_range(b, s, from, i);
    buf_push(b, "�");
    from = i + 1;
    i = __memchr(s, 0, from);
  }
  buf_push_range(b, s, from, s.len());
  let out = buf_take(b);
  buf_free(b);
  return out;
}

// Reads the line `src[ls:le]`, which is line number `line`.
function process_line(p0: P, src: string, ls: i32, le: i32, line: i32): P {
  let p = p0;
  let off = ls;
  let col = 0;
  let partial = false;
  let i = 1;
  let all = true;
  while (i < p.depth) {
    let (fns, fnscol) = first_nonspace(src, le, off, col);
    let indent = fnscol - col;
    let blank = fns == le;
    let k = skind(p, i);
    let goes_on = true;
    if (k == QUOTE) {
      if (indent <= 3 && fns < le && src[fns] == b'>') {
        let (o, c, t) = advance(src, le, off, col, partial, indent + 1, true);
        let (o2, c2, t2) = after_quote_marker(src, le, o, c, t);
        off = o2;
        col = c2;
        partial = t2;
      } else {
        goes_on = false;
      }
    } else if (k == ITEM) {
      let width = sget(p, i, S_C) + sget(p, i, S_D);
      if (indent >= width) {
        let (o, c, t) = advance(src, le, off, col, partial, width, true);
        off = o;
        col = c;
        partial = t;
      } else if (blank && (i + 1 < p.depth || sget(p, i, S_LAST) != NONE)) {
        let (o, c, t) = advance(src, le, off, col, partial, fns - off, false);
        off = o;
        col = c;
        partial = t;
      } else {
        goes_on = false;
      }
    } else if (k == CODE) {
      if (has_flag(p, i, F_FENCED)) {
        let fence = sget(p, i, S_A);
        if (indent <= 3 && fns < le && src[fns] as i32 == fence && closing_fence(src, le, fns, fence) >= sget(p, i, S_B)) {
          return close_top(p, src);
        }
        let n = sget(p, i, S_C);
        while (n > 0 && off < le && is_space_or_tab(src[off] as i32)) {
          let (o, c, t) = advance(src, le, off, col, partial, 1, true);
          off = o;
          col = c;
          partial = t;
          n -= 1;
        }
      } else if (indent >= 4) {
        let (o, c, t) = advance(src, le, off, col, partial, 4, true);
        off = o;
        col = c;
        partial = t;
      } else if (blank) {
        let (o, c, t) = advance(src, le, off, col, partial, fns - off, false);
        off = o;
        col = c;
        partial = t;
      } else {
        goes_on = false;
      }
    } else if (k == HEADING || blank && (k == PARAGRAPH || k == HTML && sget(p, i, S_A) >= 6)) {
      goes_on = false;
    }
    if (!goes_on) {
      all = false;
      break;
    }
    i += 1;
  }
  let matched = i - 1;
  let maybe_lazy = skind(p, p.depth - 1) == PARAGRAPH;
  let cd = matched;
  let ck = skind(p, cd);
  while (ck != CODE && ck != HTML) {
    let (q, started, o, c, t) = open_block(p, src, le, line, cd, all, maybe_lazy, off, col, partial);
    p = q;
    off = o;
    col = c;
    partial = t;
    if (!started) {
      break;
    }
    cd = p.depth - 1;
    ck = skind(p, cd);
    if (accepts_lines(ck)) {
      break;
    }
    maybe_lazy = false;
  }
  return add_text(p, src, le, line, cd, matched, off, col, partial);
}

// Moves the cursor over the space or tab after a `>`, if there is one.
@inline
function after_quote_marker(src: string, le: i32, off: i32, col: i32, partial: boolean): (i32, i32, boolean) {
  if (off < le && is_space_or_tab(src[off] as i32)) {
    return advance(src, le, off, col, partial, 1, true);
  }
  return (off, col, partial);
}

// True for the bytes that can start a block after an indent of less than
// four columns: `>`, `#`, a code fence, `<`, `=`, `-`, `*`, `_`, `+` and the
// digits.
@inline
function can_start(c: i32): boolean {
  if (c < 64) {
    return (0x73FF2C0800000000i64 >> c as i64 & 1i64) != 0i64;
  }
  return c == 95 || c == 96 || c == 126;
}

// Opens the block that starts at the first byte after the indent, if one
// does. The new block is the deepest open block. Gives the cursor after the
// start of the block.
function open_block(p: P, src: string, le: i32, line: i32, cd: i32, all: boolean, maybe_lazy: boolean, off: i32, col: i32, partial: boolean): (P, boolean, i32, i32, boolean) {
  let (fns, fnscol) = first_nonspace(src, le, off, col);
  let indent = fnscol - col;
  if (indent >= 4) {
    if (maybe_lazy || fns == le) {
      return (p, false, off, col, partial);
    }
    let (o, c, t) = advance(src, le, off, col, partial, 4, true);
    return (add_child(p, src, cd, CODE, line), true, o, c, t);
  }
  let c = at(src, le, fns);
  if (!can_start(c)) {
    return (p, false, off, col, partial);
  }
  if (c == 62) {
    let (o, c1, t) = advance(src, le, off, col, partial, fns + 1 - off, false);
    let (o2, c2, t2) = after_quote_marker(src, le, o, c1, t);
    return (add_child(p, src, cd, QUOTE, line), true, o2, c2, t2);
  }
  let ck = skind(p, cd);
  if (c == 35 || c == 96 || c == 126 || c == 60) {
    let (q, started, o, c1, t) = open_leaf(p, src, le, line, cd, c, fns, off, col, partial, ck == PARAGRAPH || maybe_lazy);
    return (q, started, o, c1, t);
  }
  if (ck == PARAGRAPH && (c == 61 || c == 45)) {
    let level = setext_level(src, le, fns);
    if (level > 0) {
      let (q, heading) = setext(p, src, cd, level);
      if (heading) {
        let (o, c1, t) = advance(src, le, off, col, partial, le - off, false);
        return (q, true, o, c1, t);
      }
      return (q, true, off, col, partial);
    }
  }
  if (!(ck == PARAGRAPH && !all) && is_rule(src, le, fns)) {
    let (o, c1, t) = advance(src, le, off, col, partial, le - off, false);
    return (add_child(p, src, cd, RULE, line), true, o, c1, t);
  }
  return open_item(p, src, le, line, cd, c, ck, fns, indent, off, col, partial);
}

// The blocks that start with `#`, a code fence or `<`: an ATX heading, a
// fenced code block and an HTML block. Gives the cursor after the start.
function open_leaf(p: P, src: string, le: i32, line: i32, cd: i32, c: i32, fns: i32, off: i32, col: i32, partial: boolean, in_paragraph: boolean): (P, boolean, i32, i32, boolean) {
  if (c == 35) {
    let len = atx_start(src, le, fns);
    if (len > 0) {
      let level = 0;
      while (at(src, le, fns + level) == 35) {
        level += 1;
      }
      let q = add_child(p, src, cd, HEADING, line);
      let (o, c1, t) = advance(src, le, off, col, partial, fns + len - off, false);
      return (sset(q, q.depth - 1, S_A, level), true, o, c1, t);
    }
  }
  if (c == 96 || c == 126) {
    let len = opening_fence(src, le, fns);
    if (len > 0) {
      let q = add_child(p, src, cd, CODE, line);
      let d = q.depth - 1;
      q = set_flag(sset(sset(sset(q, d, S_A, c), d, S_B, len), d, S_C, fns - off), d, F_FENCED, true);
      let (o, c1, t) = advance(src, le, off, col, partial, fns + len - off, false);
      return (q, true, o, c1, t);
    }
  }
  if (c == 60) {
    let hk = tags.block_start(src, fns, le, in_paragraph);
    if (hk > 0) {
      let q = add_child(p, src, cd, HTML, line);
      return (sset(q, q.depth - 1, S_A, hk), true, off, col, partial);
    }
  }
  return (p, false, off, col, partial);
}

// Makes the paragraph at `d` a setext heading, unless it holds only link
// reference definitions. Then the line is text of the paragraph, and the
// result is false.
function setext(p: P, src: string, d: i32, level: i32): (P, boolean) {
  let (q, has_text) = take_defs(p, src, d);
  if (!has_text) {
    return (q, false);
  }
  return (sset(sset(q, d, S_KIND, HEADING), d, S_A, level), true);
}

// A list item, and the list around it when the item does not continue the
// open list.
function open_item(p: P, src: string, le: i32, line: i32, cd: i32, c: i32, ck: i32, fns: i32, indent: i32, off: i32, col: i32, partial: boolean): (P, boolean, i32, i32, boolean) {
  let ordered = false;
  let mark = c;
  let start = 0;
  let len = 1;
  if (c != 42 && c != 45 && c != 43) {
    let i = fns;
    while (i - fns < 9 && i < le && src[i] >= b'0' && src[i] <= b'9') {
      start = start * 10 + src[i] as i32 - 48;
      i += 1;
    }
    mark = at(src, le, i);
    if (i == fns || mark != 46 && mark != 41) {
      return (p, false, off, col, partial);
    }
    ordered = true;
    len = i + 1 - fns;
  }
  let after = at(src, le, fns + len);
  if (!refs.is_space(after)) {
    return (p, false, off, col, partial);
  }
  if (ck == PARAGRAPH && (ordered && start != 1 || rest_is_blank(src, le, fns + len))) {
    return (p, false, off, col, partial);
  }
  let (o0, c0, t0) = advance(src, le, off, col, partial, fns + len - off, false);
  let o = o0;
  let cl = c0;
  let t = t0;
  while (cl - c0 <= 5 && o < le && is_space_or_tab(src[o] as i32)) {
    let (o1, c1, t1) = advance(src, le, o, cl, t, 1, true);
    o = o1;
    cl = c1;
    t = t1;
  }
  let spaces = cl - c0;
  let width = len + spaces;
  if (spaces >= 5 || spaces < 1 || o == le) {
    width = len + 1;
    o = o0;
    cl = c0;
    t = t0;
    if (spaces > 0) {
      let (o1, c1, t1) = advance(src, le, o, cl, t, 1, true);
      o = o1;
      cl = c1;
      t = t1;
    }
  }
  let q = p;
  let depth = cd;
  let same = skind(q, cd) == LIST && has_flag(q, cd, F_ORDERED) == ordered && sget(q, cd, S_A) == mark;
  if (!same) {
    q = add_child(q, src, cd, LIST, line);
    depth = q.depth - 1;
    q = set_flag(sset(sset(q, depth, S_A, mark), depth, S_B, start), depth, F_ORDERED, ordered);
  }
  q = add_child(q, src, depth, ITEM, line);
  let item = q.depth - 1;
  return (sset(sset(q, item, S_C, indent), item, S_D, width), true, o, cl, t);
}

// True when only spaces and tabs are after `i` on the line.
function rest_is_blank(src: string, le: i32, i: i32): boolean {
  let j = i;
  while (j < le && is_space_or_tab(src[j] as i32)) {
    j += 1;
  }
  return j == le;
}

// Adds the text that is left on the line to the right block: a lazy line to
// the open paragraph, or a line to the deepest open block, or a line to a new
// paragraph.
function add_text(p0: P, src: string, le: i32, line: i32, cd: i32, matched: i32, off: i32, col: i32, partial: boolean): P {
  let (fns, _) = first_nonspace(src, le, off, col);
  let blank = fns == le;
  let p = mark_blank(p0, cd, blank, line);
  let top = p.depth - 1;
  if (top != matched && cd == matched && !blank && skind(p, top) == PARAGRAPH) {
    return add_line(p, off, col, partial, le);
  }
  p = close_below(p, src, cd);
  let ck = skind(p, cd);
  if (ck == CODE) {
    return add_line(p, off, col, partial, le);
  }
  if (ck == HTML) {
    let q = add_line(p, off, col, partial, le);
    if (tags.block_end(sget(q, cd, S_A), src, fns, le)) {
      return close_top(q, src);
    }
    return q;
  }
  if (blank) {
    return p;
  }
  let (o, c, t) = advance(src, le, off, col, partial, fns - off, false);
  if (ck == HEADING) {
    return add_line(p, o, c, t, atx_text_end(src, o, le));
  }
  if (ck == PARAGRAPH) {
    return add_line(p, o, c, t, le);
  }
  return add_line(add_child(p, src, cd, PARAGRAPH, line), o, c, t, le);
}

// Keeps in the flags whether the line is a blank line at the end of the
// block at `cd`, and of the last child of that block. The blocks above `cd`
// do not end with a blank line.
function mark_blank(p0: P, cd: i32, blank: boolean, line: i32): P {
  let p = p0;
  if (blank) {
    if (cd + 1 < p.depth) {
      p = set_flag(p, cd + 1, F_BLANK, true);
    } else {
      let last = sget(p, cd, S_LAST);
      if (last != NONE && (last & L_BLANK) == 0) {
        p = sset(p, cd, S_LAST, last | L_BLANK);
      }
    }
  }
  p = set_flag(p, cd, F_BLANK, blank && blank_counts(p, cd, line));
  for d in 0..cd {
    if (has_flag(p, d, F_BLANK)) {
      p = set_flag(p, d, F_BLANK, false);
    }
  }
  return p;
}

// False for the blocks whose blank lines do not make a list loose: a block
// quote, a heading, a thematic break, a fenced code block, and a list item
// that is empty on its first line.
function blank_counts(p: P, d: i32, line: i32): boolean {
  let k = skind(p, d);
  if (k == QUOTE || k == HEADING || k == RULE) {
    return false;
  }
  if (k == CODE) {
    return !has_flag(p, d, F_FENCED);
  }
  if (k == ITEM) {
    return d + 1 < p.depth || sget(p, d, S_LAST) != NONE || sget(p, d, S_LINE) != line;
  }
  return true;
}
