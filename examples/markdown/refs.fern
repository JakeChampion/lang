// Link reference definitions (CommonMark 0.31.2, section 4.7) and the
// normalization of link labels. The block parser calls `parse_def` on the
// text of a paragraph when the paragraph closes. The inline parser looks a
// label up with `normalize`.
import "core/map";
import "std/string";
import "std/unicode";

// The destination and the title of a definition, as they are in the source.
// Backslash escapes and entity references are not decoded yet.
pub struct Ref { dest: string, title: string }

// A definition that `parse_def` found: `end` is the index after its line, or
// -1 when the text at the start index is not a definition.
pub struct Def { end: i32, label: string, dest: string, title: string }

const NO_DEF: Def = Def { end: -1, label: "", dest: "", title: "" };

pub function is_punct(c: i32): boolean {
  return c >= 33 && c <= 47 || c >= 58 && c <= 64 || c >= 91 && c <= 96 || c >= 123 && c <= 126;
}

// The whitespace of cmark: space, tab, line feed, vertical tab, form feed and
// carriage return.
pub function is_space(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}

function at(s: string, i: i32): i32 {
  if (i < s.len()) {
    return s[i] as i32;
  }
  return 0;
}

function skip_spaces(s: string, i: i32): i32 {
  let j = i;
  while (at(s, j) == 32 || at(s, j) == 9) {
    j += 1;
  }
  return j;
}

// The index after a line ending at `i`, or `i` at the end of the text, or -1.
function line_end(s: string, i: i32): i32 {
  let j = i;
  if (at(s, j) == 13) {
    j += 1;
  }
  if (at(s, j) == 10) {
    j += 1;
  }
  if (j > i || j >= s.len()) {
    return j;
  }
  return -1;
}

// Spaces and tabs, then at most one line ending, then spaces and tabs.
function spnl(s: string, i: i32): i32 {
  let j = skip_spaces(s, i);
  let k = line_end(s, j);
  if (k > j) {
    return skip_spaces(s, k);
  }
  return j;
}

// The index after the `]` of a link label that starts at `i`, or -1. A label
// has at most 999 characters and no unescaped bracket.
pub function label_end(s: string, i: i32): i32 {
  if (at(s, i) != 91) {
    return -1;
  }
  let j = i + 1;
  let n = 0;
  while (j < s.len()) {
    let c = s[j] as i32;
    if (c == 91 || c == 93) {
      break;
    }
    j += 1;
    n += 1;
    if (c == 92 && is_punct(at(s, j))) {
      j += 1;
      n += 1;
    }
    if (n > 999) {
      return -1;
    }
  }
  if (at(s, j) == 93) {
    return j + 1;
  }
  return -1;
}

// The end of a link destination that starts at `i`, or -1. A destination in
// pointy brackets ends after its `>`.
pub function dest_end(s: string, i: i32): i32 {
  if (at(s, i) == 60) {
    let j = i + 1;
    while (j < s.len()) {
      let c = s[j] as i32;
      if (c == 62) {
        return j + 1;
      }
      if (c == 10 || c == 60) {
        return -1;
      }
      j += 1;
      if (c == 92) {
        j += 1;
      }
    }
    return -1;
  }
  return bare_dest_end(s, i);
}

// A destination without brackets: no space or control character, and each
// unescaped parenthesis balanced, at most 32 deep.
// fern-lint: allow cyclomatic-complexity
function bare_dest_end(s: string, i: i32): i32 {
  let j = i;
  let depth = 0;
  while (j < s.len() && depth <= 32) {
    let c = s[j] as i32;
    if (c <= 32 || c == 127 || c == 41 && depth == 0) {
      break;
    }
    if (c == 40) {
      depth += 1;
    } else if (c == 41) {
      depth -= 1;
    } else if (c == 92 && is_punct(at(s, j + 1))) {
      j += 1;
    }
    j += 1;
  }
  if (j == i && at(s, j) != 41 || j >= s.len() || depth != 0) {
    return -1;
  }
  return j;
}

// The end of a link title that starts at `i`, or -1: text in double quotes,
// in single quotes or in parentheses.
pub function title_end(s: string, i: i32): i32 {
  let open = at(s, i);
  let close = open;
  if (open == 40) {
    close = 41;
  } else if (open != 34 && open != 39) {
    return -1;
  }
  let j = i + 1;
  while (j < s.len()) {
    let c = s[j] as i32;
    if (c == 92 && is_punct(at(s, j + 1))) {
      j += 2;
    } else if (c == close) {
      return j + 1;
    } else if (open == 40 && c == 40) {
      return -1;
    } else {
      j += 1;
    }
  }
  return -1;
}

function has_text(s: string): boolean {
  for i in 0..s.len() {
    if (!is_space(s[i] as i32)) {
      return true;
    }
  }
  return false;
}

// The definition that starts at `i` in the text of a paragraph.
pub function parse_def(s: string, i: i32): Def {
  let le = label_end(s, i);
  if (le < 0 || at(s, le) != 58) {
    return NO_DEF;
  }
  let raw = slice_unchecked(s, i + 1, le - 1).to_owned();
  if (!has_text(raw)) {
    return NO_DEF;
  }
  let ds = spnl(s, le + 1);
  let de = dest_end(s, ds);
  if (de < 0) {
    return NO_DEF;
  }
  let dest = slice_unchecked(s, ds, de).to_owned();
  if (at(s, ds) == 60) {
    dest = slice_unchecked(s, ds + 1, de - 1).to_owned();
  }
  let ts = spnl(s, de);
  let te = -1;
  if (ts > de) {
    te = title_end(s, ts);
  }
  if (te > 0) {
    let end = line_end(s, skip_spaces(s, te));
    if (end >= 0) {
      return Def { end: end, label: normalize(raw), dest: dest, title: slice_unchecked(s, ts + 1, te - 1).to_owned() };
    }
  }
  let end = line_end(s, skip_spaces(s, de));
  if (end < 0) {
    return NO_DEF;
  }
  return Def { end: end, label: normalize(raw), dest: dest, title: "" };
}

// The form of a label that two matching labels share: Unicode case folding,
// with each run of whitespace made one space, and no space at either end.
pub function normalize(label: string): string {
  let folded = label.case_fold();
  let b = buf_new(folded.len());
  let gap = false;
  let any = false;
  for i in 0..folded.len() {
    let c = folded[i] as i32;
    if (is_space(c)) {
      gap = any;
    } else {
      if (gap) {
        buf_push_byte(b, 32);
        gap = false;
      }
      buf_push_byte(b, c);
      any = true;
    }
  }
  let out = buf_take(b);
  buf_free(b);
  return out;
}

// Adds each definition at the start of `s` to `refs`. The first definition of
// a label wins. Gives the index after the last definition.
pub function take_defs(s: string, refs: Map[string, Ref]): (i32, Map[string, Ref]) {
  let i = 0;
  let out = refs;
  while (at(s, i) == 91) {
    let d = parse_def(s, i);
    if (d.end < 0) {
      break;
    }
    if (!out.contains(d.label)) {
      out = out.insert(d.label, Ref { dest: d.dest, title: d.title });
    }
    i = d.end;
  }
  return (i, out);
}
