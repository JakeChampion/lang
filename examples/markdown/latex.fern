// The LaTeX of a node tree, as cmark writes it.
import "./commonmark";
import "./markdown";
import "./nodes";
import "./out";

const SECTIONS: string[] = ["", "\\section", "\\subsection", "\\subsubsection", "\\paragraph", "\\subparagraph", ""];

const COUNTERS: string[] = ["", "i", "ii", "iii", "iv", "v"];

// The start of emphasis and of strong emphasis.
const EMPHASIS: string[] = ["\\emph{", "\\textbf{"];

pub function render(t: nodes.Tree, o: markdown.Options): u8[] {
  let r = out.new(out.LATEX, o, o.width);
  let s = nodes.Step { node: 0, exit: false };
  while (s.node != nodes.NONE) {
    let (r2, skip) = node(r, t, s.node, !s.exit);
    r = r2;
    if (skip) {
      s = nodes.Step { node: s.node, exit: true };
    }
    s = t.step(s);
  }
  return r.bytes();
}

function allow_wrap(r: out.R): boolean {
  return r.width > 0 && !r.o.nobreaks;
}

function node(r: out.R, t: nodes.Tree, x: i32, entering: boolean): (out.R, boolean) {
  let k = t.kind(x);
  if (k == nodes.LIST) {
    return (list(r, t, x, entering), false);
  }
  if (k == nodes.CODE_BLOCK) {
    return (r.cr().lit("\\begin{verbatim}").cr().out(t.lit(t.text, x), false, out.LITERAL).cr().lit("\\end{verbatim}").blankline(), false);
  }
  if (k == nodes.RULE) {
    return (r.blankline().lit("\\begin{center}\\rule{0.5\\linewidth}{\\linethickness}\\end{center}").blankline(), false);
  }
  if (k <= nodes.HEADING && entering) {
    return (enter_block(r, t, x, k), false);
  }
  if (k <= nodes.HEADING) {
    return (leave_block(r, k), false);
  }
  return inline(r, t, x, k, entering);
}

function enter_block(r: out.R, t: nodes.Tree, x: i32, k: i32): out.R {
  if (k == nodes.QUOTE) {
    return r.lit("\\begin{quote}").cr();
  }
  if (k == nodes.ITEM) {
    return r.lit("\\item ");
  }
  if (k == nodes.HEADING) {
    return r.lit(SECTIONS[t.value(x)]).lit("{");
  }
  return r;
}

function leave_block(r: out.R, k: i32): out.R {
  if (k == nodes.QUOTE) {
    return r.lit("\\end{quote}").blankline();
  }
  if (k == nodes.ITEM) {
    return r.cr();
  }
  if (k == nodes.HEADING) {
    return r.lit("}").blankline();
  }
  if (k == nodes.PARAGRAPH) {
    return r.blankline();
  }
  return r;
}

// The start of a list sets the counter of an ordered list that does not
// start at 1. As in cmark, the depth of the counter counts each list that
// holds the list.
function list(r0: out.R, t: nodes.Tree, x: i32, entering: boolean): out.R {
  let env = "itemize";
  if (t.has(x, nodes.ORDERED)) {
    env = "enumerate";
  }
  if (!entering) {
    return r0.lit("\\end{" + env + "}").blankline();
  }
  let r = r0.lit("\\begin{" + env + "}").cr();
  let start = t.value(x);
  if (start <= 1) {
    return r;
  }
  let level = 0;
  if (t.has(x, nodes.ORDERED)) {
    let p = x;
    while (p != nodes.NONE) {
      if (t.kind(p) == nodes.LIST) {
        level += 1;
      }
      p = t.parent(p);
    }
  }
  if (level >= 1 && level <= 5) {
    r = r.lit("\\setcounter{enum" + COUNTERS[level] + "}{").out(start.to_string(), false, out.NORMAL).lit("}");
  }
  return r.cr();
}

function inline(r: out.R, t: nodes.Tree, x: i32, k: i32, entering: boolean): (out.R, boolean) {
  if (k == nodes.TEXT) {
    return (r.out(t.lit(t.text, x), allow_wrap(r), out.NORMAL), false);
  }
  if (k == nodes.LINEBREAK || k == nodes.SOFTBREAK) {
    return (line_break(r, k == nodes.LINEBREAK), false);
  }
  if (k == nodes.CODE) {
    return (r.lit("\\texttt{").out(t.lit(t.text, x), false, out.NORMAL).lit("}"), false);
  }
  if (k == nodes.IMAGE) {
    return (r.lit("\\protect\\includegraphics{").out(t.lit(t.text, x), false, out.URL).lit("}"), true);
  }
  return span(r, t, x, k, entering);
}

// Emphasis, strong emphasis, a link or raw HTML, which LaTeX does not have.
// An image skips its text.
function span(r: out.R, t: nodes.Tree, x: i32, k: i32, entering: boolean): (out.R, boolean) {
  if (k == nodes.HTML) {
    return (r, false);
  }
  if (!entering) {
    return (r.lit("}"), false);
  }
  if (k == nodes.LINK) {
    return link(r, t, x);
  }
  return (r.lit(EMPHASIS[k - nodes.EMPH]), false);
}

// A hard line break is `\\`, and the option `hardbreaks` makes a soft line
// break one. A soft line break is a line feed, or a space where a line can
// wrap.
function line_break(r: out.R, hard: boolean): out.R {
  if (hard || r.o.hardbreaks) {
    return r.lit("\\\\").cr();
  }
  if (r.width == 0 && !r.o.nobreaks) {
    return r.cr();
  }
  return r.out(" ", allow_wrap(r), out.NORMAL);
}

// The kinds of link.
const NO_LINK: i32 = 0;

const URL_AUTOLINK: i32 = 1;

const EMAIL_AUTOLINK: i32 = 2;

const NORMAL_LINK: i32 = 3;

const INTERNAL_LINK: i32 = 4;

function link(r: out.R, t: nodes.Tree, x: i32): (out.R, boolean) {
  let url = t.lit(t.text, x);
  let kind = link_kind(t, x);
  if (kind == URL_AUTOLINK) {
    return (r.lit("\\url{").out(url, false, out.URL).lit("}"), true);
  }
  if (kind == EMAIL_AUTOLINK) {
    return (r.lit("\\href{").out(url, false, out.URL).lit("}\\nolinkurl{"), false);
  }
  if (kind == NORMAL_LINK) {
    return (r.lit("\\href{").out(url, false, out.URL).lit("}{"), false);
  }
  if (kind == INTERNAL_LINK) {
    return (r.lit("\\protect\\hyperlink{").out(slice_unchecked(url, 1, url.len()), false, out.URL).lit("}{"), false);
  }
  return (r.lit("{"), false);
}

// As in cmark, a link with a scheme and no title is an autolink when the
// text of its first child is its destination without `mailto:`. A node
// that is not text, code or raw HTML has an empty text.
function link_kind(t: nodes.Tree, x: i32): i32 {
  let url = t.lit(t.text, x);
  if (url.len() > 0 && url[0] == b'#') {
    return INTERNAL_LINK;
  }
  if (url.len() == 0 || commonmark.scheme_length(url) == 0) {
    return NO_LINK;
  }
  if (t.extra(t.text, x).len() > 0) {
    return NORMAL_LINK;
  }
  let first = t.first(x);
  if (first == nodes.NONE) {
    return NO_LINK;
  }
  return autolink_kind(t, url, first);
}

// URL_AUTOLINK or EMAIL_AUTOLINK when the text of the first child of a link
// is its destination `url` without `mailto:`, and else NORMAL_LINK.
function autolink_kind(t: nodes.Tree, url: string, first: i32): i32 {
  let fk = t.kind(first);
  let text = slice_unchecked(t.text, 0, 0);
  if (fk == nodes.TEXT || fk == nodes.CODE || fk == nodes.HTML) {
    text = t.lit(t.text, first);
  }
  let email = url.starts_with("mailto:");
  let real = slice_unchecked(url, 0, url.len());
  if (email) {
    real = slice_unchecked(url, 7, url.len());
  }
  if (real != text) {
    return NORMAL_LINK;
  }
  if (email) {
    return EMAIL_AUTOLINK;
  }
  return URL_AUTOLINK;
}
