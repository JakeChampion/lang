// A CommonMark command line: `md [FILE...]`. It reads the files one after
// the other, or stdin when there is none, and writes their HTML to stdout a
// part at a time. It replaces each byte sequence that is not UTF-8 with
// U+FFFD, as cmark does.
import "std/io";
import "std/io_buffered";
import "./markdown";

// The text of the files one after the other, or of stdin when there is no
// file. The text of one file of valid UTF-8 is not copied.
function read_text(files: string[]): Result[string, string] {
  if (files.len() == 1) {
    if let Ok(text) = read_file(files[0]) {
      return Ok(text);
    }
  }
  let all = buf_new(4096);
  if (files.len() == 0) {
    match (io.read_all_stdin_bytes()) {
      Ok(b) => {
        buf_push_bytes_range(all, b, 0, b.len());
      },
      Err(e) => {
        buf_free(all);
        return Err("could not read stdin: " + e.message());
      }
    }
  }
  for f in files {
    match (read_file_bytes(f)) {
      Ok(b) => {
        buf_push_bytes_range(all, b, 0, b.len());
      },
      Err(e) => {
        buf_free(all);
        return Err("could not open " + f + ": " + e.message());
      }
    }
  }
  let text = buf_take(all);
  buf_free(all);
  return Ok(text);
}

function main(): i32 {
  let argv = args();
  let files: string[] = [];
  for i in 1..argv.len() {
    files = files.append(argv[i]);
  }
  let text = "";
  match (read_text(files)) {
    Ok(t) => {
      text = t;
    },
    Err(e) => {
      eprint("md: " + e);
      return 1;
    }
  }
  let w = io_buffered.buf_writer_new(stdout(), 65536);
  let done = match (markdown.write(w, text, 65536)) {
    Ok(rest) => rest.flush(),
    Err(e) => Err(e),
  };
  if let Err(e) = done {
    eprint("md: could not write stdout: " + e.message());
    return 1;
  }
  return 0;
}
