// A CommonMark command line: `md [FILE...]`. It reads the files one after
// the other, or stdin when there is none, and writes their HTML to stdout.
// It replaces each byte sequence that is not UTF-8 with U+FFFD, as cmark does.
import "std/io";
import "./markdown";

function read_inputs(files: string[]): Result[u8[], string] {
  if (files.len() == 0) {
    return match (io.read_all_stdin_bytes()) {
      Ok(b) => Ok(b),
      Err(e) => Err("could not read stdin: " + e.message()),
    };
  }
  let all = buf_new(4096);
  for f in files {
    match (read_file_bytes(f)) {
      Ok(b) => {
        buf_push_bytes_range(all, b, 0, b.len());
      },
      Err(e) => {
        buf_free(all);
        return Err("could not open " + f + ": " + e.message());
      }
    }
  }
  let bytes = buf_take_bytes(all);
  buf_free(all);
  return Ok(bytes);
}

function main(): i32 {
  let argv = args();
  let files: string[] = [];
  for i in 1..argv.len() {
    files = files.append(argv[i]);
  }
  let bytes: u8[] = [];
  match (read_inputs(files)) {
    Ok(b) => {
      bytes = b;
    },
    Err(e) => {
      eprint("md: " + e);
      return 1;
    }
  }
  let text_buf = buf_new(bytes.len());
  buf_push_bytes_range(text_buf, bytes, 0, bytes.len());
  let text = buf_take(text_buf);
  buf_free(text_buf);
  let out = buf_new(text.len() + text.len() / 4 + 64);
  markdown.render(out, text);
  let html = buf_take_bytes(out);
  buf_free(out);
  if let Err(e) = stdout().write_bytes(html) {
    eprint("md: could not write stdout: " + e.message());
    return 1;
  }
  return 0;
}
