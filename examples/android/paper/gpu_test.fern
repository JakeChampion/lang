// Draws screens of Paper with the GPU painter on an offscreen canvas, and
// checks each one against the same screen drawn on the CPU. It is a shared
// object: check() gives one digit for each screen that matches.
// internal/testing/e2e loads it with Mesa's OpenGL ES 2 on the host.
import "std/android/draw";
import "std/android/gl";
import "std/android/testkit";
import "./face";
import "./gpu";
import "./ui";
import "./ui_test";

// The CPU truncates each blend and the GPU rounds it, so a pixel under
// several translucent layers can differ by a few steps.
const TOLERANCE: i32 = 6;

// The screen of `nodes` on the CPU.
function cpu(fs: face.Fonts, nodes: ui.Node[], m: ui.Metrics): draw.Frame {
  let f = draw.offscreen(m.w, m.h);
  let wall = ui.wallpaper_layer(ui.themed(ui_test.wallpaper(m.w), m.pal));
  let c = ui.render(f, fs, face.new_cache(), nodes, wall, m.d, m.pal);
  draw.release(wall);
  return f;
}

// The frame that the painter shows for `passes`, and the painter.
function gpu_frame(p: gpu.Painter, passes: ui.Pass[]): (draw.Frame, gpu.Painter) {
  let q = gpu.present(p, passes);
  if let Some(c) = q.canvas {
    return (c.read(), q);
  }
  return (draw.offscreen(0, 0), q);
}

function sheet(): ui.Sheet {
  let rows: ui.Row[] = [];
  for name in ["Chrome", "Gmail", "Maps", "Spotify", "WhatsApp"] {
    rows = rows.append(ui.Row { text: name, sub: "", check: 1, act: "check:" + name });
  }
  return ui.Sheet { title: "Home apps", rows: rows, buttons: [ui.Row { text: "Done", sub: "", check: -1, act: "done" }], field: false, text: "", hint: "", scroll: 0 };
}

// Each check is a digit of the result: home, the app list half slid in over
// home, the app list with a dialog over it, and home in the dark theme.
pub function check(): i32 {
  let fs = ui_test.fonts();
  let v = ui_test.home_view();
  let m = v.m;
  let canvas = gl.open_offscreen(m.w, m.h);
  if (canvas.is_none()) {
    return 9;
  }
  let p = gpu.on_canvas(gpu.with_screen(gpu.painter(fs), ui.wallpaper_layer(ui_test.wallpaper(m.w)), m.w, m.h, m.d, m.pal), canvas);
  let n = 0;
  let home = ui.nodes(fs, v);
  let (got, p1) = gpu_frame(p, [ui.Pass { nodes: home, dy: 0, alpha: 1.0 }]);
  let want = cpu(fs, home, m);
  if (testkit.differ(got, want, TOLERANCE) == 0) {
    n += 1;
  }
  draw.release(got);
  let list = ui.nodes(fs, ui.View { ...v, layer: ui.DRAWER });
  let (slid, p2) = gpu_frame(p1, [ui.Pass { nodes: home, dy: 0, alpha: 1.0 }, ui.Pass { nodes: list, dy: 96, alpha: 0.5 }]);
  let over = cpu(fs, list, m);
  want.blend_frame(over, 0, 96, 128);
  if (testkit.differ(slid, want, TOLERANCE) == 0) {
    n += 10;
  }
  draw.release(slid);
  draw.release(want);
  draw.release(over);
  let dialog = ui.nodes(fs, ui.View { ...v, layer: ui.DRAWER, sheet: Some(sheet()) });
  let (shown, p3) = gpu_frame(p2, [ui.Pass { nodes: dialog, dy: 0, alpha: 1.0 }]);
  let expect = cpu(fs, dialog, m);
  if (testkit.differ(shown, expect, TOLERANCE) == 0) {
    n += 100;
  }
  draw.release(shown);
  draw.release(expect);
  let q = gpu.detach(p3);
  let dm = ui.Metrics { ...m, pal: ui.palette(true) };
  let dv = ui.View { ...v, m: dm };
  let dp = gpu.on_canvas(gpu.with_screen(gpu.painter(fs), ui.wallpaper_layer(ui.themed(ui_test.wallpaper(m.w), dm.pal)), m.w, m.h, m.d, dm.pal), gl.open_offscreen(m.w, m.h));
  let dark_home = ui.nodes(fs, dv);
  let (dark_got, dp1) = gpu_frame(dp, [ui.Pass { nodes: dark_home, dy: 0, alpha: 1.0 }]);
  let dark_want = cpu(fs, dark_home, dm);
  if (testkit.differ(dark_got, dark_want, TOLERANCE) == 0 && dark_got.pixel(m.w / 2, 2) == dm.pal.paper) {
    n += 1000;
  }
  draw.release(dark_got);
  draw.release(dark_want);
  let dq = gpu.detach(dp1);
  return n;
}

function main(): i32 {
  return 0;
}
