// The text of Paper: Roboto, the sans-serif face of Android, in the five
// weights that the screens use. The fonts come from the system, and
// std/android/text measures and draws the text.
import "std/android/fonts";
import "std/android/text";
pub use "std/android/text".{Fonts, Cache, Sprite, Placed, new_cache, ascent, descent, line, width, spaced_width, fit, fit_end, layout, sprite, shadow, put, text};

pub const REGULAR: i32 = 0;

pub const MEDIUM: i32 = 1;

pub const SEMIBOLD: i32 = 2;

pub const BOLD: i32 = 3;

pub const EXTRABOLD: i32 = 4;

// The family of the text.
pub const FAMILY: string = "Roboto";

// The weight of each constant, in the order of the constants.
pub function weights(): i32[] {
  return [400, 500, 600, 700, 800];
}

// The fonts of the files in `found`, one for each weight of `weights`.
// `read` gives the bytes of a file.
pub function load(found: Option[fonts.Found][], read: (string) => u8[]): text.Fonts {
  return text.load(found, weights(), read);
}
