// The Paper app: a NativeActivity home screen. control.fern holds its
// behaviour. This file gives it the device of the phone, through JNI: the
// installed apps and the intents that open them, the location, the weather
// request, the system bars and the files of the app. It also holds the
// Java classes of the app, which have native methods only: the activity,
// which hears the home key, a task for the UI thread that sets the system
// bars, and the notification listener of the notification filter.
import "std/android";
import "std/android/draw";
import "std/fetch";
import "std/jni";
import "std/log";
import "std/option";
import "std/utf8";
import "std/worker";
import "./control";
import "./face";
import "./gpu";
import "./paper";
import "./ui";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

const OWN_PACKAGE: string = "dev.fern.paper";

// Intent.FLAG_ACTIVITY_NEW_TASK and FLAG_ACTIVITY_RESET_TASK_IF_NEEDED.
const NEW_TASK: i32 = 268435456;

const RESET_TASK: i32 = 2097152;

// --- small JNI helpers

function failed(e: usize): boolean {
  if (jni.exception_occurred(e) != 0 as usize) {
    let cleared: usize = jni.exception_clear(e);
    return true;
  }
  return false;
}

function drop(e: usize, r: usize): void {
  if (r != 0 as usize) {
    let gone: usize = jni.delete_local_ref(e, r);
  }
}

function text_of(e: usize, obj: usize): string {
  if (obj == 0 as usize) {
    return "";
  }
  let s = jni.call_object(e, obj, "toString", "()Ljava/lang/String;", []);
  if (failed(e)) {
    return "";
  }
  let out = jni.string_of(e, s);
  drop(e, s);
  return out;
}

function new_object(e: usize, class_name: string, sig: string, args: usize[]): usize {
  let c = jni.find_class(e, class_name);
  let a = jni.jvalues(args);
  let obj = jni.new_object_a(e, c, jni.get_method_id(e, c, "<init>", sig), a);
  jni.free_buffer(a);
  drop(e, c);
  if (failed(e)) {
    return 0 as usize;
  }
  return obj;
}

function static_object(e: usize, class_name: string, name: string, sig: string, args: usize[]): usize {
  let c = jni.find_class(e, class_name);
  let a = jni.jvalues(args);
  let got = jni.call_static_object_method_a(e, c, jni.get_static_method_id(e, c, name, sig), a);
  jni.free_buffer(a);
  drop(e, c);
  if (failed(e)) {
    return 0 as usize;
  }
  return got;
}

function object_field(e: usize, obj: usize, name: string, sig: string): usize {
  let c = jni.get_object_class(e, obj);
  let got = jni.get_object_field(e, obj, jni.get_field_id(e, c, name, sig));
  drop(e, c);
  if (failed(e)) {
    return 0 as usize;
  }
  return got;
}

function string_field(e: usize, obj: usize, name: string): string {
  let s = object_field(e, obj, name, "Ljava/lang/String;");
  let out = jni.string_of(e, s);
  drop(e, s);
  return out;
}

function int_method(e: usize, obj: usize, name: string, sig: string, args: usize[]): i32 {
  let c = jni.get_object_class(e, obj);
  let a = jni.jvalues(args);
  let got = jni.call_int_method_a(e, obj, jni.get_method_id(e, c, name, sig), a);
  jni.free_buffer(a);
  drop(e, c);
  if (failed(e)) {
    return 0;
  }
  return got;
}

function bool_method(e: usize, obj: usize, name: string): boolean {
  let c = jni.get_object_class(e, obj);
  let a = jni.jvalues([]);
  let got = jni.call_boolean_method_a(e, obj, jni.get_method_id(e, c, name, "()Z"), a);
  jni.free_buffer(a);
  drop(e, c);
  if (failed(e)) {
    return false;
  }
  return got != 0;
}

function long_method(e: usize, obj: usize, name: string): i64 {
  let c = jni.get_object_class(e, obj);
  let a = jni.jvalues([]);
  let got = jni.call_long_method_a(e, obj, jni.get_method_id(e, c, name, "()J"), a);
  jni.free_buffer(a);
  drop(e, c);
  if (failed(e)) {
    return 0i64;
  }
  return got as i64;
}

function double_method(e: usize, obj: usize, name: string): f64 {
  let c = jni.get_object_class(e, obj);
  let a = jni.jvalues([]);
  let got = jni.call_double_method_a(e, obj, jni.get_method_id(e, c, name, "()D"), a);
  jni.free_buffer(a);
  drop(e, c);
  if (failed(e)) {
    return 0.0;
  }
  return got;
}

function object_method(e: usize, obj: usize, name: string, sig: string, args: usize[]): usize {
  let got = jni.call_object(e, obj, name, sig, args);
  if (failed(e)) {
    return 0 as usize;
  }
  return got;
}

function system_service(e: usize, context: usize, name: string): usize {
  let n = jni.new_string(e, name);
  let got = object_method(e, context, "getSystemService", "(Ljava/lang/String;)Ljava/lang/Object;", [n]);
  drop(e, n);
  return got;
}

// --- the installed apps

function launcher_intent(e: usize): usize {
  let main = jni.new_string(e, "android.intent.action.MAIN");
  let intent = new_object(e, "android/content/Intent", "(Ljava/lang/String;)V", [main]);
  drop(e, main);
  let cat = jni.new_string(e, "android.intent.category.LAUNCHER");
  drop(e, object_method(e, intent, "addCategory", "(Ljava/lang/String;)Landroid/content/Intent;", [cat]));
  drop(e, cat);
  return intent;
}

// Each launchable activity, Paper included, with its label when `labels`.
function query_apps(ctx: usize, labels: boolean): paper.Entry[] {
  let e = android.env(ctx);
  let act = android.activity_object(ctx);
  let out: paper.Entry[] = [];
  let pm = object_method(e, act, "getPackageManager", "()Landroid/content/pm/PackageManager;", []);
  let intent = launcher_intent(e);
  let list = object_method(e, pm, "queryIntentActivities", "(Landroid/content/Intent;I)Ljava/util/List;", [intent, 0 as usize]);
  if (list == 0 as usize) {
    drop(e, intent);
    drop(e, pm);
    return out;
  }
  let n = int_method(e, list, "size", "()I", []);
  for i in 0..n {
    let ri = object_method(e, list, "get", "(I)Ljava/lang/Object;", [i as usize]);
    let ai = object_field(e, ri, "activityInfo", "Landroid/content/pm/ActivityInfo;");
    let pkg = string_field(e, ai, "packageName");
    let cls = string_field(e, ai, "name");
    let label = pkg;
    if (labels) {
      let cs = object_method(e, ri, "loadLabel", "(Landroid/content/pm/PackageManager;)Ljava/lang/CharSequence;", [pm]);
      let t = text_of(e, cs).trim();
      if (t.len() > 0) {
        label = t;
      }
      drop(e, cs);
    }
    if (pkg.len() > 0 && cls.len() > 0) {
      out = out.append(paper.entry(pkg, cls, label, ""));
    }
    drop(e, ai);
    drop(e, ri);
  }
  drop(e, list);
  drop(e, intent);
  drop(e, pm);
  return out;
}

function app_keys(ctx: usize): string[] {
  let out: string[] = [];
  for a in query_apps(ctx, false) {
    out = out.append(a.key);
  }
  return out;
}

// --- intents

function start_intent(ctx: usize, intent: usize, options: usize): boolean {
  let e = android.env(ctx);
  if (intent == 0 as usize) {
    return false;
  }
  drop(e, object_method(e, intent, "addFlags", "(I)Landroid/content/Intent;", [NEW_TASK as usize]));
  let ok = jni.call_void(e, android.activity_object(ctx), "startActivity", "(Landroid/content/Intent;Landroid/os/Bundle;)V", [intent, options]);
  drop(e, intent);
  drop(e, options);
  return ok;
}

function action_intent(e: usize, action: string): usize {
  let a = jni.new_string(e, action);
  let intent = new_object(e, "android/content/Intent", "(Ljava/lang/String;)V", [a]);
  drop(e, a);
  return intent;
}

function uri_intent(e: usize, action: string, uri: string): usize {
  let u = jni.new_string(e, uri);
  let parsed = static_object(e, "android/net/Uri", "parse", "(Ljava/lang/String;)Landroid/net/Uri;", [u]);
  drop(e, u);
  let a = jni.new_string(e, action);
  let intent = new_object(e, "android/content/Intent", "(Ljava/lang/String;Landroid/net/Uri;)V", [a, parsed]);
  drop(e, a);
  drop(e, parsed);
  return intent;
}

// The options of an app that grows from the rectangle of its label.
function reveal(ctx: usize, x: i32, y: i32, w: i32, h: i32): usize {
  if (w <= 0 || h <= 0) {
    return 0 as usize;
  }
  let e = android.env(ctx);
  let window = object_method(e, android.activity_object(ctx), "getWindow", "()Landroid/view/Window;", []);
  let decor = object_method(e, window, "getDecorView", "()Landroid/view/View;", []);
  let opts = static_object(e, "android/app/ActivityOptions", "makeClipRevealAnimation", "(Landroid/view/View;IIII)Landroid/app/ActivityOptions;", [decor, x as usize, y as usize, w as usize, h as usize]);
  let bundle = object_method(e, opts, "toBundle", "()Landroid/os/Bundle;", []);
  drop(e, opts);
  drop(e, decor);
  drop(e, window);
  return bundle;
}

function launch(ctx: usize, key: string, x: i32, y: i32, w: i32, h: i32): boolean {
  log.info("paper: launch " + key);
  let e = android.env(ctx);
  let intent = launcher_intent(e);
  let k = jni.new_string(e, key);
  let cn = static_object(e, "android/content/ComponentName", "unflattenFromString", "(Ljava/lang/String;)Landroid/content/ComponentName;", [k]);
  drop(e, k);
  if (cn == 0 as usize) {
    drop(e, intent);
    return false;
  }
  drop(e, object_method(e, intent, "setComponent", "(Landroid/content/ComponentName;)Landroid/content/Intent;", [cn]));
  drop(e, cn);
  drop(e, object_method(e, intent, "addFlags", "(I)Landroid/content/Intent;", [RESET_TASK as usize]));
  return start_intent(ctx, intent, reveal(ctx, x, y, w, h));
}

function open(ctx: usize, what: string, arg: string): boolean {
  let e = android.env(ctx);
  let intent = 0 as usize;
  if (what == "alarms") {
    intent = action_intent(e, "android.intent.action.SHOW_ALARMS");
  } else if (what == "calendar") {
    intent = uri_intent(e, "android.intent.action.VIEW", "content://com.android.calendar/time/" + now_unix_ms().to_string());
  } else if (what == "search") {
    intent = action_intent(e, "android.intent.action.WEB_SEARCH");
    let q = jni.new_string(e, "query");
    let v = jni.new_string(e, arg);
    drop(e, object_method(e, intent, "putExtra", "(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;", [q, v]));
    drop(e, q);
    drop(e, v);
  } else if (what == "info") {
    intent = uri_intent(e, "android.settings.APPLICATION_DETAILS_SETTINGS", "package:" + arg);
  } else if (what == "uninstall") {
    intent = uri_intent(e, "android.intent.action.DELETE", "package:" + arg);
  } else if (what == "music") {
    let main = jni.new_string(e, "android.intent.action.MAIN");
    let cat = jni.new_string(e, "android.intent.category.APP_MUSIC");
    intent = static_object(e, "android/content/Intent", "makeMainSelectorActivity", "(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;", [main, cat]);
    drop(e, main);
    drop(e, cat);
  } else if (what == "home-settings") {
    intent = action_intent(e, "android.settings.HOME_SETTINGS");
  } else if (what == "listener-settings") {
    intent = action_intent(e, "android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS");
  }
  return start_intent(ctx, intent, 0 as usize);
}

// Opens the notification shade. StatusBarManager.expandNotificationsPanel
// is not in the SDK, so some phones refuse it, and then nothing happens.
function expand_notifications(ctx: usize): void {
  let e = android.env(ctx);
  let sbm = system_service(e, android.activity_object(ctx), "statusbar");
  if (sbm != 0 as usize) {
    let ok = jni.call_void(e, sbm, "expandNotificationsPanel", "()V", []);
    drop(e, sbm);
  }
  let cleared = failed(e);
}

// --- the system bars

// View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR and SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR.
const LIGHT_STATUS: i32 = 8192;

const LIGHT_NAV: i32 = 16;

// Asks the UI thread to give the bars dark icons where the screen behind
// them is light. Bars.fern holds the flags for the task.
function set_bars(ctx: usize, light_top: boolean, light_bottom: boolean): void {
  let e = android.env(ctx);
  let act = android.activity_object(ctx);
  let flags = 0;
  if (light_top) {
    flags |= LIGHT_STATUS;
  }
  if (light_bottom) {
    flags |= LIGHT_NAV;
  }
  let class = jni.load_class(e, act, "dev.fern.paper.Bars");
  if (failed(e) || class == 0 as usize) {
    return;
  }
  let field = jni.get_static_field_id(e, class, "fern", "J");
  let set = jni.set_static_long_field(e, class, field, flags as usize);
  let a = jni.jvalues([]);
  let task = jni.new_object_a(e, class, jni.get_method_id(e, class, "<init>", "()V"), a);
  jni.free_buffer(a);
  if (!failed(e) && task != 0 as usize) {
    let posted = jni.call_void(e, act, "runOnUiThread", "(Ljava/lang/Runnable;)V", [task]);
    drop(e, task);
  }
  drop(e, class);
}

@jni("dev.fern.paper.Bars implements java.lang.Runnable", "void run()")
pub function bars_run(env: usize, thiz: usize): void {
  let activity = android.live_activity(env);
  if (activity == 0 as usize) {
    return;
  }
  let class = jni.get_object_class(env, thiz);
  let flags = jni.get_static_long_field(env, class, jni.get_static_field_id(env, class, "fern", "J")) as i32;
  drop(env, class);
  let obj = 0 as usize;
  unsafe {
    obj = __load_ptr(activity + 24 as usize);
  }
  let window = object_method(env, obj, "getWindow", "()Landroid/view/Window;", []);
  let decor = object_method(env, window, "getDecorView", "()Landroid/view/View;", []);
  if (decor != 0 as usize) {
    let ok = jni.call_void(env, decor, "setSystemUiVisibility", "(I)V", [flags as usize]);
  }
  drop(env, decor);
  drop(env, window);
}

// --- the home key

// The activity of Paper. Android starts it again with the home intent when
// the home key is pressed while Paper shows, and then the app goes back to
// its home screen.
@jni("dev.fern.paper.Home extends android.app.NativeActivity", "void onNewIntent(android.content.Intent)")
pub function home_new_intent(env: usize, thiz: usize, intent: usize): void {
  let activity = android.live_activity(env);
  if (activity != 0 as usize) {
    android.send(activity, control.KIND_HOME, 0 as usize);
  }
}

// --- location and weather

const LOCATION: string = "android.permission.ACCESS_COARSE_LOCATION";

// The newest location that a location provider knows, as latitude and
// longitude.
function last_location(ctx: usize): Option[(f64, f64)] {
  if (!android.has_permission(ctx, LOCATION)) {
    return None;
  }
  let e = android.env(ctx);
  let lm = system_service(e, android.activity_object(ctx), "location");
  if (lm == 0 as usize) {
    return None;
  }
  let providers = object_method(e, lm, "getProviders", "(Z)Ljava/util/List;", [1 as usize]);
  let best: Option[(f64, f64)] = None;
  let best_at = 0i64;
  if (providers != 0 as usize) {
    let n = int_method(e, providers, "size", "()I", []);
    for i in 0..n {
      let p = object_method(e, providers, "get", "(I)Ljava/lang/Object;", [i as usize]);
      let loc = object_method(e, lm, "getLastKnownLocation", "(Ljava/lang/String;)Landroid/location/Location;", [p]);
      if (loc != 0 as usize) {
        let at = long_method(e, loc, "getTime");
        if (at > best_at) {
          best_at = at;
          best = Some((double_method(e, loc, "getLatitude"), double_method(e, loc, "getLongitude")));
        }
        drop(e, loc);
      }
      drop(e, p);
    }
    drop(e, providers);
  }
  drop(e, lm);
  return best;
}

// Sends the weather request. It runs in a worker, so it can wait for the
// network.
function get(url: string): string {
  match (fetch.send(fetch.request("GET", url))) {
    Ok(resp) => {
      if (resp.status == 200) {
        return utf8.from_bytes_lossy(resp.body.bytes());
      }
      return "";
    },
    Err(e) => {
      log.info("paper: weather: " + e.message());
      return "";
    }
  }
}

function fetch_weather(url: string): worker.Worker[string] {
  return worker.spawn((): string => get(url));
}

// --- locale

function is_24h(ctx: usize): boolean {
  let e = android.env(ctx);
  let c = jni.find_class(e, "android/text/format/DateFormat");
  let a = jni.jvalues([android.activity_object(ctx)]);
  let got = jni.call_static_int_method_a(e, c, jni.get_static_method_id(e, c, "is24HourFormat", "(Landroid/content/Context;)Z"), a);
  jni.free_buffer(a);
  drop(e, c);
  if (failed(e)) {
    return false;
  }
  return (got & 255) != 0;
}

function country(ctx: usize): string {
  let e = android.env(ctx);
  let locale = static_object(e, "java/util/Locale", "getDefault", "()Ljava/util/Locale;", []);
  let c = object_method(e, locale, "getCountry", "()Ljava/lang/String;", []);
  let out = jni.string_of(e, c);
  drop(e, c);
  drop(e, locale);
  return out;
}

// --- the notification filter

// The component of the listener, as Android lists the enabled listeners.
const LISTENER: string = "dev.fern.paper/dev.fern.paper.Filter";

function listener_on(ctx: usize): boolean {
  let e = android.env(ctx);
  let cr = object_method(e, android.activity_object(ctx), "getContentResolver", "()Landroid/content/ContentResolver;", []);
  let name = jni.new_string(e, "enabled_notification_listeners");
  let v = static_object(e, "android/provider/Settings$Secure", "getString", "(Landroid/content/ContentResolver;Ljava/lang/String;)Ljava/lang/String;", [cr, name]);
  let text = jni.string_of(e, v);
  drop(e, v);
  drop(e, name);
  drop(e, cr);
  return text.contains(LISTENER);
}

// The phone app and the SMS app, whose notifications pass the filter until
// the user chooses other apps.
function default_allowed(ctx: usize): string[] {
  let e = android.env(ctx);
  let act = android.activity_object(ctx);
  let out: string[] = [];
  let tm = system_service(e, act, "telecom");
  if (tm != 0 as usize) {
    let d = object_method(e, tm, "getDefaultDialerPackage", "()Ljava/lang/String;", []);
    let s = jni.string_of(e, d);
    if (s.len() > 0) {
      out = out.append(s);
    }
    drop(e, d);
    drop(e, tm);
  }
  let sms = static_object(e, "android/provider/Telephony$Sms", "getDefaultSmsPackage", "(Landroid/content/Context;)Ljava/lang/String;", [act]);
  let s = jni.string_of(e, sms);
  if (s.len() > 0 && !paper.has(out, s)) {
    out = out.append(s);
  }
  drop(e, sms);
  return out;
}

// The intents of the held notifications, by key, in a java.util.HashMap
// whose global reference Filter.fern holds. A PendingIntent cannot go in a
// file, so the intents last as long as the process.
function intents(e: usize, class: usize): usize {
  let field = jni.get_static_field_id(e, class, "fern", "J");
  let map = jni.get_static_long_field(e, class, field);
  if (map != 0 as usize) {
    return map;
  }
  let fresh = new_object(e, "java/util/HashMap", "()V", []);
  if (fresh == 0 as usize) {
    return 0 as usize;
  }
  let global = jni.new_global_ref(e, fresh);
  drop(e, fresh);
  let set = jni.set_static_long_field(e, class, field, global);
  return global;
}

function files_dir(e: usize, context: usize): string {
  let dir = object_method(e, context, "getFilesDir", "()Ljava/io/File;", []);
  let p = object_method(e, dir, "getAbsolutePath", "()Ljava/lang/String;", []);
  let out = jni.string_of(e, p);
  drop(e, p);
  drop(e, dir);
  return out;
}

function read_text(path: string): string {
  if let Ok(b) = read_file_bytes(path) {
    return unsafe { string_from_bytes_unchecked(b) };
  }
  return "";
}

function write_text(path: string, text: string): void {
  let written = write_file(path, text);
}

function app_label(e: usize, context: usize, pkg: string): string {
  let pm = object_method(e, context, "getPackageManager", "()Landroid/content/pm/PackageManager;", []);
  let p = jni.new_string(e, pkg);
  let info = object_method(e, pm, "getApplicationInfo", "(Ljava/lang/String;I)Landroid/content/pm/ApplicationInfo;", [p, 0 as usize]);
  let out = pkg;
  if (info != 0 as usize) {
    let cs = object_method(e, pm, "getApplicationLabel", "(Landroid/content/pm/ApplicationInfo;)Ljava/lang/CharSequence;", [info]);
    let t = text_of(e, cs);
    if (t.len() > 0) {
      out = t;
    }
    drop(e, cs);
    drop(e, info);
  }
  drop(e, p);
  drop(e, pm);
  return out;
}

function extra_text(e: usize, extras: usize, name: string): string {
  if (extras == 0 as usize) {
    return "";
  }
  let k = jni.new_string(e, name);
  let cs = object_method(e, extras, "getCharSequence", "(Ljava/lang/String;)Ljava/lang/CharSequence;", [k]);
  drop(e, k);
  let out = text_of(e, cs);
  drop(e, cs);
  return out;
}

// Notification.FLAG_GROUP_SUMMARY: the notification that stands for a group.
const GROUP_SUMMARY: i32 = 512;

// Takes the notification `sbn` out of the shade when the filter holds it,
// keeps it in the held file, and tells the home screen.
function hold(e: usize, service: usize, sbn: usize): void {
  let dir = files_dir(e, service);
  let settings = paper.parse_settings(read_text(dir + "/" + control.SETTINGS_FILE));
  let pkg_s = object_method(e, sbn, "getPackageName", "()Ljava/lang/String;", []);
  let pkg = jni.string_of(e, pkg_s);
  drop(e, pkg_s);
  let n = object_method(e, sbn, "getNotification", "()Landroid/app/Notification;", []);
  if (n == 0 as usize) {
    return;
  }
  let category = string_field(e, n, "category");
  if (!paper.holds(settings, OWN_PACKAGE, pkg, category, bool_method(e, sbn, "isClearable"), bool_method(e, sbn, "isOngoing"))) {
    drop(e, n);
    return;
  }
  let key_s = object_method(e, sbn, "getKey", "()Ljava/lang/String;", []);
  let key = jni.string_of(e, key_s);
  let c = jni.get_object_class(e, n);
  let flags = jni.get_int_field(e, n, jni.get_field_id(e, c, "flags", "I"));
  drop(e, c);
  if ((flags & GROUP_SUMMARY) == 0) {
    let extras = object_field(e, n, "extras", "Landroid/os/Bundle;");
    let text = extra_text(e, extras, "android.bigText");
    if (text.len() == 0) {
      text = extra_text(e, extras, "android.text");
    }
    let h = paper.Held { pkg: pkg, app: app_label(e, service, pkg), title: extra_text(e, extras, "android.title"), text: text, posted: long_method(e, sbn, "getPostTime"), key: key };
    drop(e, extras);
    let held_path = dir + "/" + control.HELD_FILE;
    write_text(held_path, paper.format_held(paper.add_held(paper.parse_held(read_text(held_path)), h)));
    let pi = object_field(e, n, "contentIntent", "Landroid/app/PendingIntent;");
    let class = jni.get_object_class(e, service);
    let map = intents(e, class);
    if (pi != 0 as usize && map != 0 as usize) {
      drop(e, object_method(e, map, "put", "(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;", [key_s, pi]));
    }
    drop(e, class);
    drop(e, pi);
  }
  let cancelled = jni.call_void(e, service, "cancelNotification", "(Ljava/lang/String;)V", [key_s]);
  drop(e, key_s);
  drop(e, n);
  let activity = android.live_activity(e);
  if (activity != 0 as usize) {
    android.send(activity, control.KIND_HELD, 0 as usize);
  }
}

@jni("dev.fern.paper.Filter extends android.service.notification.NotificationListenerService", "void onNotificationPosted(android.service.notification.StatusBarNotification)")
pub function filter_posted(env: usize, thiz: usize, sbn: usize): void {
  hold(env, thiz, sbn);
  let cleared = failed(env);
}

@jni("dev.fern.paper.Filter", "void onListenerConnected()")
pub function filter_connected(env: usize, thiz: usize): void {
  let all = object_method(env, thiz, "getActiveNotifications", "()[Landroid/service/notification/StatusBarNotification;", []);
  if (all == 0 as usize) {
    return;
  }
  let n = jni.get_array_length(env, all);
  for i in 0..n {
    let sbn = jni.get_object_array_element(env, all, i);
    hold(env, thiz, sbn);
    let cleared = failed(env);
    drop(env, sbn);
  }
  drop(env, all);
}

// ActivityOptions.MODE_BACKGROUND_ACTIVITY_START_ALLOWED: Android 14 lets an
// app that shows send another app's PendingIntent only with this mode.
const BACKGROUND_START_ALLOWED: i32 = 1;

// Opens a held notification: its own intent while the process keeps it,
// or else its app.
function open_held(ctx: usize, pkg: string, key: string): void {
  let e = android.env(ctx);
  let act = android.activity_object(ctx);
  let class = jni.load_class(e, act, "dev.fern.paper.Filter");
  if (!failed(e) && class != 0 as usize) {
    let map = jni.get_static_long_field(e, class, jni.get_static_field_id(e, class, "fern", "J"));
    drop(e, class);
    if (map != 0 as usize) {
      let k = jni.new_string(e, key);
      let pi = object_method(e, map, "remove", "(Ljava/lang/Object;)Ljava/lang/Object;", [k]);
      drop(e, k);
      if (pi != 0 as usize) {
        let opts = static_object(e, "android/app/ActivityOptions", "makeBasic", "()Landroid/app/ActivityOptions;", []);
        if (android.sdk_version(ctx) >= 34) {
          drop(e, object_method(e, opts, "setPendingIntentBackgroundActivityStartMode", "(I)Landroid/app/ActivityOptions;", [BACKGROUND_START_ALLOWED as usize]));
        }
        let bundle = object_method(e, opts, "toBundle", "()Landroid/os/Bundle;", []);
        let sent = jni.call_void(e, pi, "send", "(Landroid/content/Context;ILandroid/content/Intent;Landroid/app/PendingIntent$OnFinished;Landroid/os/Handler;Ljava/lang/String;Landroid/os/Bundle;)V", [act, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, bundle]);
        drop(e, bundle);
        drop(e, opts);
        drop(e, pi);
        if (sent) {
          return;
        }
      }
    }
  }
  let pm = object_method(e, act, "getPackageManager", "()Landroid/content/pm/PackageManager;", []);
  let p = jni.new_string(e, pkg);
  let intent = object_method(e, pm, "getLaunchIntentForPackage", "(Ljava/lang/String;)Landroid/content/Intent;", [p]);
  drop(e, p);
  drop(e, pm);
  let started = start_intent(ctx, intent, 0 as usize);
}

// --- the device

function asset_bytes(ctx: usize, name: string): u8[] {
  if let Some(b) = android.asset(ctx, name) {
    return b;
  }
  log.info("paper: no asset " + name);
  return [];
}

function fonts(ctx: usize): face.Fonts {
  let data: u8[][] = [];
  for name in face.files() {
    data = data.append(asset_bytes(ctx, name));
  }
  return face.load(data);
}

function window_size(window: usize): (i32, i32) {
  let w = android.Window { ptr: window };
  return (w.width(), w.height());
}

function device(ctx: usize, wall: u8[]): control.Device {
  return control.Device {
    mono_ms: (): i64 => monotonic_ns() / 1000000i64,
    wall_ms: (): i64 => now_unix_ms(),
    utc_offset_ms: (unix_ms: i64): i32 => android.utc_offset_ms(ctx, unix_ms),
    is_24h: (): boolean => is_24h(ctx),
    country: (): string => country(ctx),
    read: (path: string): string => read_text(path),
    write: (path: string, text: string): void => write_text(path, text),
    size: (window: usize): (i32, i32) => window_size(window),
    wallpaper: (w: i32): draw.Image => ui.wallpaper(wall, w),
    apps: (): paper.Entry[] => query_apps(ctx, true),
    app_keys: (): string[] => app_keys(ctx),
    launch: (key: string, x: i32, y: i32, w: i32, h: i32): boolean => launch(ctx, key, x, y, w, h),
    open: (what: string, arg: string): boolean => open(ctx, what, arg),
    notifications: (): void => expand_notifications(ctx),
    keyboard: (show: boolean): void => android.show_keyboard(ctx, show),
    bars: (top: boolean, bottom: boolean): void => set_bars(ctx, top, bottom),
    has_location: (): boolean => android.has_permission(ctx, LOCATION),
    ask_location: (): void => android.request_permissions(ctx, [LOCATION]),
    location: (): Option[(f64, f64)] => last_location(ctx),
    fetch: (url: string): worker.Worker[string] => fetch_weather(url),
    listener_on: (): boolean => listener_on(ctx),
    default_allowed: (): string[] => default_allowed(ctx),
    open_held: (pkg: string, key: string): void => open_held(ctx, pkg, key),
    request_frame: (): void => android.request_frame(ctx),
    open_gpu: (p: gpu.Painter, window: usize): gpu.Painter => open_gpu(p, window),
    present: (p: gpu.Painter, passes: ui.Pass[]): gpu.Painter => gpu.present(p, passes),
    close_gpu: (p: gpu.Painter): gpu.Painter => gpu.detach(p),
  };
}

function open_gpu(p: gpu.Painter, window: usize): gpu.Painter {
  let q = gpu.attach(p, window);
  if (!gpu.attached(q)) {
    log.error("paper: the window has no OpenGL ES 2 canvas");
  }
  return q;
}

// One step of the app, with a log line for each change that the emulator
// check waits for.
function step(own s: control.App, e: android.Event): control.App {
  let layer = s.layer;
  let apps = s.installed.len();
  let drawn = s.nodes.len() > 0;
  let t = control.step(s, e);
  if (!drawn && t.nodes.len() > 0) {
    log.info("paper: drawn " + t.w.to_string() + "x" + t.h.to_string());
  }
  if (t.layer != layer) {
    log.info("paper: layer " + t.layer.to_string());
  }
  if (t.installed.len() != apps) {
    let listed = paper.find_package(t.installed, OWN_PACKAGE).is_some();
    log.info("paper: apps " + t.installed.len().to_string() + ", Paper listed " + listed.to_string());
  }
  return t;
}

function app_main(ctx: usize): usize {
  let first = control.with_density(control.new(device(ctx, asset_bytes(ctx, "wallpaper.jpg")), android.data_dir(ctx), fonts(ctx)), android.density(ctx));
  let last = android.run(ctx, first, (own s: control.App, e: android.Event): control.App => step(s, e), (s: control.App): i32 => control.timeout(s, monotonic_ns() / 1000000i64));
  control.close(last);
  return 0 as usize;
}
