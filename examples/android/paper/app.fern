// The Paper app: a NativeActivity home screen. control.fern holds its
// behaviour. This file gives it the device of the phone, through JNI: the
// installed apps and the intents that open them, the location, the weather
// request, the system bars and the files of the app. It also holds the
// Java classes of the app, which have native methods only: the activity,
// which hears the home key, a task for the UI thread that sets the system
// bars, and the notification listener of the notification filter.
import "std/android";
import "std/android/access";
import "std/android/draw";
import "std/android/fonts";
import "std/android/keyboard";
import "std/android/property";
import "std/android/ui/painter";
import "std/android/ui/scene";
import "std/fetch";
import "std/jni";
import "std/log";
import "std/option";
import "std/utf8";
import "std/worker";
import "./bindings";
import "./control";
import "./face";
import "./paper";
import "./ui";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

const OWN_PACKAGE: string = "dev.fern.paper";

// --- small JNI helpers

function failed(e: usize): boolean {
  if (jni.exception_occurred(e) != 0 as usize) {
    let cleared: usize = jni.exception_clear(e);
    return true;
  }
  return false;
}

function drop(e: usize, r: usize): void {
  if (r != 0 as usize) {
    let gone: usize = jni.delete_local_ref(e, r);
  }
}

function text_of(e: usize, obj: usize): string {
  if (obj == 0 as usize) {
    return "";
  }
  let s = jni.call_object(e, obj, "toString", "()Ljava/lang/String;", []);
  if (failed(e)) {
    return "";
  }
  let out = jni.string_of(e, s);
  drop(e, s);
  return out;
}

function object_field(e: usize, obj: usize, name: string, sig: string): usize {
  let c = jni.get_object_class(e, obj);
  let got = jni.get_object_field(e, obj, jni.get_field_id(e, c, name, sig));
  drop(e, c);
  if (failed(e)) {
    return 0 as usize;
  }
  return got;
}

function object_method(e: usize, obj: usize, name: string, sig: string, args: usize[]): usize {
  let got = jni.call_object(e, obj, name, sig, args);
  if (failed(e)) {
    return 0 as usize;
  }
  return got;
}

function system_service(e: usize, context: usize, name: string): usize {
  let n = jni.new_string(e, name);
  let got = object_method(e, context, "getSystemService", "(Ljava/lang/String;)Ljava/lang/Object;", [n]);
  drop(e, n);
  return got;
}

// --- the typed wrappers of bindings.fern

// The value of `r`, or `d` when the Java code threw.
function value_or[T](r: Result[T, jni.JavaError], d: T): T {
  match (r) {
    Ok(v) => {
      return v;
    },
    Err(err) => {
      log.info("paper: " + err.message());
      return d;
    }
  }
}

// True when the Java code of a call with no result did not throw.
function done(r: Result[void, jni.JavaError]): boolean {
  match (r) {
    Ok(_) => {
      return true;
    },
    Err(err) => {
      log.info("paper: " + err.message());
      return false;
    }
  }
}

function no_intent(): bindings.Intent {
  return bindings.Intent { ref: 0 as usize };
}

function no_bundle(): bindings.Bundle {
  return bindings.Bundle { ref: 0 as usize };
}

// The activity as a Context.
function context(ctx: usize): bindings.Context {
  let act = bindings.Activity { ref: android.activity_object(ctx) };
  return act.as_context();
}

function package_manager(ctx: usize, e: usize, j: bindings.Classes): bindings.PackageManager {
  return value_or(j.context.get_package_manager(e, context(ctx)), bindings.PackageManager { ref: 0 as usize });
}

// --- the installed apps

function launcher_intent(e: usize, j: bindings.Classes): bindings.Intent {
  let intent = value_or(j.intent.new_string(e, bindings.INTENT_ACTION_MAIN), no_intent());
  drop(e, value_or(j.intent.add_category(e, intent, bindings.INTENT_CATEGORY_LAUNCHER), no_intent()).ref);
  return intent;
}

// The package and the class of the activity of `ri`.
function activity_of(e: usize, j: bindings.Classes, ri: bindings.ResolveInfo): (string, string) {
  let ai = value_or(j.resolve_info.activity_info(e, ri), bindings.ActivityInfo { ref: 0 as usize });
  if (ai.is_null()) {
    return ("", "");
  }
  let item = ai.as_package_item_info();
  let pkg = value_or(j.package_item_info.package_name(e, item), "");
  let cls = value_or(j.package_item_info.name(e, item), "");
  drop(e, ai.ref);
  return (pkg, cls);
}

// Each launchable activity, Paper included, with its label when `labels`.
function query_apps(ctx: usize, labels: boolean): paper.Entry[] {
  let e = android.env(ctx);
  let out: paper.Entry[] = [];
  let Ok(j) = bindings.classes(e) else {
    return out;
  };
  let pm = package_manager(ctx, e, j);
  let intent = launcher_intent(e, j);
  let list = value_or(j.package_manager.query_intent_activities(e, pm, intent, 0), bindings.List { ref: 0 as usize });
  let n = 0;
  if (!list.is_null()) {
    n = value_or(j.list.size(e, list), 0);
  }
  for i in 0..n {
    let ri = bindings.ResolveInfo { ref: value_or(j.list.get(e, list, i), jni.Object { ref: 0 as usize }).ref };
    let (pkg, cls) = activity_of(e, j, ri);
    let label = pkg;
    if (labels) {
      let cs = value_or(j.resolve_info.load_label(e, ri, pm), jni.Object { ref: 0 as usize });
      let t = text_of(e, cs.ref).trim();
      if (t.len() > 0) {
        label = t;
      }
      drop(e, cs.ref);
    }
    if (pkg.len() > 0 && cls.len() > 0) {
      out = out.append(paper.entry(pkg, cls, label, ""));
    }
    drop(e, ri.ref);
  }
  drop(e, list.ref);
  drop(e, intent.ref);
  drop(e, pm.ref);
  j.release(e);
  return out;
}

function app_keys(ctx: usize): string[] {
  let out: string[] = [];
  for a in query_apps(ctx, false) {
    out = out.append(a.key);
  }
  return out;
}

// --- intents

// Starts the activity of `intent` in a new task, and deletes the
// references to `intent` and `options`.
function start_intent(ctx: usize, e: usize, j: bindings.Classes, intent: bindings.Intent, options: bindings.Bundle): boolean {
  if (intent.is_null()) {
    return false;
  }
  drop(e, value_or(j.intent.add_flags(e, intent, bindings.INTENT_FLAG_ACTIVITY_NEW_TASK), no_intent()).ref);
  let ok = match (j.context.start_activity(e, context(ctx), intent, options)) {
    Ok(_) => true,
    Err(err) => false,
  };
  drop(e, intent.ref);
  drop(e, options.ref);
  return ok;
}

// The launch intent of the clock app: the app that shows the alarms. When
// no app gives one, or the system must choose among several, it is the
// intent that shows the alarms.
function clock_intent(ctx: usize, e: usize, j: bindings.Classes): bindings.Intent {
  let alarms = value_or(j.intent.new_string(e, "android.intent.action.SHOW_ALARMS"), no_intent());
  let pm = package_manager(ctx, e, j);
  let ri = value_or(j.package_manager.resolve_activity(e, pm, alarms, bindings.PACKAGE_MANAGER_MATCH_DEFAULT_ONLY), bindings.ResolveInfo { ref: 0 as usize });
  let pkg = "";
  if (!ri.is_null()) {
    let (found, cls) = activity_of(e, j, ri);
    pkg = found;
    drop(e, ri.ref);
  }
  let launch = no_intent();
  if (pkg.len() > 0 && pkg != "android") {
    launch = value_or(j.package_manager.get_launch_intent_for_package(e, pm, pkg), no_intent());
  }
  drop(e, pm.ref);
  if (launch.is_null()) {
    log.info("paper: open clock by its alarms");
    return alarms;
  }
  log.info("paper: open clock " + pkg);
  drop(e, alarms.ref);
  return launch;
}

function uri_intent(e: usize, j: bindings.Classes, action: string, uri: string): bindings.Intent {
  let parsed = value_or(j.uri.parse(e, uri), bindings.Uri { ref: 0 as usize });
  let intent = value_or(j.intent.new_string_uri(e, action, parsed), no_intent());
  drop(e, parsed.ref);
  return intent;
}

// The options of an app that grows from the rectangle of its label.
function reveal(ctx: usize, e: usize, j: bindings.Classes, x: i32, y: i32, w: i32, h: i32): bindings.Bundle {
  if (w <= 0 || h <= 0) {
    return no_bundle();
  }
  let act = bindings.Activity { ref: android.activity_object(ctx) };
  let window = value_or(j.activity.get_window(e, act), bindings.Window { ref: 0 as usize });
  let decor = value_or(j.window.get_decor_view(e, window), bindings.View { ref: 0 as usize });
  let opts = value_or(j.activity_options.make_clip_reveal_animation(e, decor, x, y, w, h), bindings.ActivityOptions { ref: 0 as usize });
  let bundle = value_or(j.activity_options.to_bundle(e, opts), no_bundle());
  drop(e, opts.ref);
  drop(e, decor.ref);
  drop(e, window.ref);
  return bundle;
}

function launch(ctx: usize, key: string, x: i32, y: i32, w: i32, h: i32): boolean {
  log.info("paper: launch " + key);
  let e = android.env(ctx);
  let Ok(j) = bindings.classes(e) else {
    return false;
  };
  let intent = launcher_intent(e, j);
  let cn = value_or(j.component_name.unflatten_from_string(e, key), bindings.ComponentName { ref: 0 as usize });
  let started = false;
  if (cn.is_null()) {
    drop(e, intent.ref);
  } else {
    drop(e, value_or(j.intent.set_component(e, intent, cn), no_intent()).ref);
    drop(e, cn.ref);
    drop(e, value_or(j.intent.add_flags(e, intent, bindings.INTENT_FLAG_ACTIVITY_RESET_TASK_IF_NEEDED), no_intent()).ref);
    started = start_intent(ctx, e, j, intent, reveal(ctx, e, j, x, y, w, h));
  }
  j.release(e);
  return started;
}

// The intent that opens `what`, or the null intent for a name that this
// function does not know.
function intent_for(ctx: usize, e: usize, j: bindings.Classes, what: string, arg: string): bindings.Intent {
  if (what == "clock") {
    return clock_intent(ctx, e, j);
  }
  if (what == "calendar") {
    return uri_intent(e, j, bindings.INTENT_ACTION_VIEW, "content://com.android.calendar/time/" + now_unix_ms().to_string());
  }
  if (what == "search") {
    let intent = value_or(j.intent.new_string(e, bindings.INTENT_ACTION_WEB_SEARCH), no_intent());
    drop(e, value_or(j.intent.put_extra(e, intent, "query", arg), no_intent()).ref);
    return intent;
  }
  if (what == "info") {
    return uri_intent(e, j, "android.settings.APPLICATION_DETAILS_SETTINGS", "package:" + arg);
  }
  if (what == "uninstall") {
    return uri_intent(e, j, bindings.INTENT_ACTION_DELETE, "package:" + arg);
  }
  if (what == "music") {
    return value_or(j.intent.make_main_selector_activity(e, bindings.INTENT_ACTION_MAIN, bindings.INTENT_CATEGORY_APP_MUSIC), no_intent());
  }
  if (what == "home-settings") {
    return value_or(j.intent.new_string(e, "android.settings.HOME_SETTINGS"), no_intent());
  }
  if (what == "listener-settings") {
    return value_or(j.intent.new_string(e, "android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS"), no_intent());
  }
  return no_intent();
}

function open(ctx: usize, what: string, arg: string): boolean {
  let e = android.env(ctx);
  let Ok(j) = bindings.classes(e) else {
    return false;
  };
  let started = start_intent(ctx, e, j, intent_for(ctx, e, j, what, arg), no_bundle());
  j.release(e);
  return started;
}

// Opens the notification shade. StatusBarManager.expandNotificationsPanel
// is not in the SDK, so some phones refuse it, and then nothing happens.
function expand_notifications(ctx: usize): void {
  let e = android.env(ctx);
  let sbm = system_service(e, android.activity_object(ctx), "statusbar");
  if (sbm != 0 as usize) {
    let ok = jni.call_void(e, sbm, "expandNotificationsPanel", "()V", []);
    drop(e, sbm);
  }
  let cleared = failed(e);
}

// --- the system bars

// Asks the UI thread to give the bars dark icons where the screen behind
// them is light. Bars.fern holds the flags for the task.
function set_bars(ctx: usize, light_top: boolean, light_bottom: boolean): void {
  let e = android.env(ctx);
  let act = android.activity_object(ctx);
  let flags = 0;
  if (light_top) {
    flags |= bindings.VIEW_SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
  }
  if (light_bottom) {
    flags |= bindings.VIEW_SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR;
  }
  let class = jni.load_class(e, act, "dev.fern.paper.Bars");
  if (failed(e) || class == 0 as usize) {
    return;
  }
  let field = jni.get_static_field_id(e, class, "fern", "J");
  let set = jni.set_static_long_field(e, class, field, flags as usize);
  let a = jni.jvalues([]);
  let task = jni.new_object_a(e, class, jni.get_method_id(e, class, "<init>", "()V"), a);
  jni.free_buffer(a);
  if (!failed(e) && task != 0 as usize) {
    if let Ok(j) = bindings.classes(e) {
      let posted = done(j.activity.run_on_ui_thread(e, bindings.Activity { ref: act }, jni.Object { ref: task }));
      j.release(e);
    }
    drop(e, task);
  }
  drop(e, class);
}

@jni("dev.fern.paper.Bars implements java.lang.Runnable", "void run()")
pub function bars_run(env: usize, thiz: usize): void {
  let activity = android.live_activity(env);
  if (activity == 0 as usize) {
    return;
  }
  let class = jni.get_object_class(env, thiz);
  let flags = jni.get_static_long_field(env, class, jni.get_static_field_id(env, class, "fern", "J")) as i32;
  drop(env, class);
  let obj = 0 as usize;
  unsafe {
    obj = __load_ptr(activity + 24 as usize);
  }
  let Ok(j) = bindings.classes(env) else {
    return;
  };
  let window = value_or(j.activity.get_window(env, bindings.Activity { ref: obj }), bindings.Window { ref: 0 as usize });
  let decor = value_or(j.window.get_decor_view(env, window), bindings.View { ref: 0 as usize });
  if (!decor.is_null()) {
    let ok = done(j.view.set_system_ui_visibility(env, decor, flags));
  }
  drop(env, decor.ref);
  drop(env, window.ref);
  j.release(env);
}

// --- the home key

// The activity of Paper. Android starts it again with the home intent when
// the home key is pressed while Paper shows, and then the app goes back to
// its home screen.
@jni("dev.fern.paper.Home extends android.app.NativeActivity", "void onNewIntent(android.content.Intent)")
pub function home_new_intent(env: usize, thiz: usize, intent: usize): void {
  let sent = android.tell(env, control.KIND_HOME, 0 as usize);
}

// --- location and weather

const LOCATION: string = "android.permission.ACCESS_COARSE_LOCATION";

// The newest location that a location provider knows, as latitude and
// longitude.
function last_location(ctx: usize): Option[(f64, f64)] {
  if (!android.has_permission(ctx, LOCATION)) {
    return None;
  }
  let e = android.env(ctx);
  let Ok(j) = bindings.classes(e) else {
    return None;
  };
  let lm = bindings.LocationManager { ref: value_or(j.context.get_system_service(e, context(ctx), "location"), jni.Object { ref: 0 as usize }).ref };
  let best: Option[(f64, f64)] = None;
  if (!lm.is_null()) {
    best = newest_location(e, j, lm);
    drop(e, lm.ref);
  }
  j.release(e);
  return best;
}

// The newest location of the providers of `lm`.
function newest_location(e: usize, j: bindings.Classes, lm: bindings.LocationManager): Option[(f64, f64)] {
  let best: Option[(f64, f64)] = None;
  let best_at = 0i64;
  let providers = value_or(j.location_manager.get_providers(e, lm, true), bindings.List { ref: 0 as usize });
  if (providers.is_null()) {
    return best;
  }
  for i in 0..value_or(j.list.size(e, providers), 0) {
    let p = value_or(j.list.get(e, providers, i), jni.Object { ref: 0 as usize });
    let loc = value_or(j.location_manager.get_last_known_location(e, lm, jni.string_of(e, p.ref)), bindings.Location { ref: 0 as usize });
    if (!loc.is_null()) {
      let at = value_or(j.location.get_time(e, loc), 0i64);
      if (at > best_at) {
        best_at = at;
        best = Some((value_or(j.location.get_latitude(e, loc), 0.0), value_or(j.location.get_longitude(e, loc), 0.0)));
      }
      drop(e, loc.ref);
    }
    drop(e, p.ref);
  }
  drop(e, providers.ref);
  return best;
}

// Sends the weather request. It runs in a worker, so it can wait for the
// network.
function get(url: string): string {
  match (fetch.send(fetch.request("GET", url))) {
    Ok(resp) => {
      if (resp.status == 200) {
        return utf8.from_bytes_lossy(resp.body.bytes());
      }
      return "";
    },
    Err(e) => {
      log.info("paper: weather: " + e.message());
      return "";
    }
  }
}

function fetch_weather(url: string): worker.Worker[string] {
  return worker.spawn((): string => get(url));
}

// --- locale

function is_24h(ctx: usize): boolean {
  let e = android.env(ctx);
  let Ok(j) = bindings.classes(e) else {
    return false;
  };
  let out = value_or(j.date_format.is24_hour_format(e, context(ctx)), false);
  j.release(e);
  return out;
}

function country(ctx: usize): string {
  let e = android.env(ctx);
  let Ok(j) = bindings.classes(e) else {
    return "";
  };
  let locale = value_or(j.locale.get_default(e), bindings.Locale { ref: 0 as usize });
  let out = "";
  if (!locale.is_null()) {
    out = value_or(j.locale.get_country(e, locale), "");
    drop(e, locale.ref);
  }
  j.release(e);
  return out;
}

// --- the notification filter

// The component of the listener, as Android lists the enabled listeners.
const LISTENER: string = "dev.fern.paper/dev.fern.paper.Filter";

function listener_on(ctx: usize): boolean {
  let e = android.env(ctx);
  let Ok(j) = bindings.classes(e) else {
    return false;
  };
  let cr = value_or(j.context.get_content_resolver(e, context(ctx)), bindings.ContentResolver { ref: 0 as usize });
  let text = value_or(j.settings_secure.get_string(e, cr, "enabled_notification_listeners"), "");
  drop(e, cr.ref);
  j.release(e);
  return text.contains(LISTENER);
}

// The phone app and the SMS app, whose notifications pass the filter until
// the user chooses other apps.
function default_allowed(ctx: usize): string[] {
  let e = android.env(ctx);
  let out: string[] = [];
  let Ok(j) = bindings.classes(e) else {
    return out;
  };
  let tm = bindings.TelecomManager { ref: value_or(j.context.get_system_service(e, context(ctx), "telecom"), jni.Object { ref: 0 as usize }).ref };
  if (!tm.is_null()) {
    let dialer = value_or(j.telecom_manager.get_default_dialer_package(e, tm), "");
    if (dialer.len() > 0) {
      out = out.append(dialer);
    }
    drop(e, tm.ref);
  }
  let sms = value_or(j.telephony_sms.get_default_sms_package(e, context(ctx)), "");
  if (sms.len() > 0 && !paper.has(out, sms)) {
    out = out.append(sms);
  }
  j.release(e);
  return out;
}

// The intents of the held notifications, by key, in a java.util.HashMap
// whose global reference Filter.fern holds. A PendingIntent cannot go in a
// file, so the intents last as long as the process.
function intents(e: usize, j: bindings.Classes, class: usize): usize {
  let field = jni.get_static_field_id(e, class, "fern", "J");
  let map = jni.get_static_long_field(e, class, field);
  if (map != 0 as usize) {
    return map;
  }
  let fresh = value_or(j.hash_map.new(e), bindings.HashMap { ref: 0 as usize });
  if (fresh.is_null()) {
    return 0 as usize;
  }
  let global = jni.new_global_ref(e, fresh.ref);
  drop(e, fresh.ref);
  let set = jni.set_static_long_field(e, class, field, global);
  return global;
}

function files_dir(e: usize, context: usize): string {
  let Ok(j) = bindings.classes(e) else {
    return "";
  };
  let out = files_dir_of(e, j, context);
  j.release(e);
  return out;
}

function files_dir_of(e: usize, j: bindings.Classes, context: usize): string {
  let dir = value_or(j.context.get_files_dir(e, bindings.Context { ref: context }), bindings.File { ref: 0 as usize });
  let out = "";
  if (!dir.is_null()) {
    out = value_or(j.file.get_absolute_path(e, dir), "");
    drop(e, dir.ref);
  }
  return out;
}

function read_text(path: string): string {
  if let Ok(b) = read_file_bytes(path) {
    return unsafe { string_from_bytes_unchecked(b) };
  }
  return "";
}

function write_text(path: string, text: string): void {
  let written = write_file(path, text);
}

function app_label(e: usize, context: usize, pkg: string): string {
  let Ok(j) = bindings.classes(e) else {
    return pkg;
  };
  let out = app_label_of(e, j, context, pkg);
  j.release(e);
  return out;
}

function app_label_of(e: usize, j: bindings.Classes, context: usize, pkg: string): string {
  let out = pkg;
  let pm = value_or(j.context.get_package_manager(e, bindings.Context { ref: context }), bindings.PackageManager { ref: 0 as usize });
  let info = value_or(j.package_manager.get_application_info(e, pm, pkg, 0), bindings.ApplicationInfo { ref: 0 as usize });
  if (!info.is_null()) {
    let cs = value_or(j.package_manager.get_application_label(e, pm, info), jni.Object { ref: 0 as usize });
    let t = text_of(e, cs.ref);
    if (t.len() > 0) {
      out = t;
    }
    drop(e, cs.ref);
    drop(e, info.ref);
  }
  drop(e, pm.ref);
  return out;
}

function extra_text(e: usize, j: bindings.Classes, extras: bindings.Bundle, name: string): string {
  if (extras.is_null()) {
    return "";
  }
  let cs = value_or(j.bundle.get_char_sequence(e, extras, name), jni.Object { ref: 0 as usize });
  let out = text_of(e, cs.ref);
  drop(e, cs.ref);
  return out;
}

// Notification.FLAG_AUTOGROUP_SUMMARY, which the SDK hides: the summary
// that the device makes for the notifications of an app with no group.
const FLAG_AUTOGROUP_SUMMARY: i32 = 1024;

// Takes the notification `sbn` out of the shade when the filter holds it,
// keeps it in the held file, and tells the home screen.
function hold(e: usize, j: bindings.Classes, service: usize, sbn: bindings.StatusBarNotification): void {
  let dir = files_dir_of(e, j, service);
  let settings = paper.parse_settings(read_text(dir + "/" + control.SETTINGS_FILE));
  let pkg = value_or(j.status_bar_notification.get_package_name(e, sbn), "");
  let n = value_or(j.status_bar_notification.get_notification(e, sbn), bindings.Notification { ref: 0 as usize });
  if (n.is_null()) {
    return;
  }
  // The device removes this summary when its last notification goes. A
  // cancel of the summary also cancels each notification of the group,
  // and one of them can be from before the filter was on.
  if ((value_or(j.notification.flags(e, n), 0) & FLAG_AUTOGROUP_SUMMARY) != 0) {
    log.info("paper: left the summary of the device for " + pkg);
    drop(e, n.ref);
    return;
  }
  let category = value_or(j.notification.category(e, n), "");
  let clearable = value_or(j.status_bar_notification.is_clearable(e, sbn), false);
  let ongoing = value_or(j.status_bar_notification.is_ongoing(e, sbn), false);
  if (!paper.holds(settings, OWN_PACKAGE, pkg, category, clearable, ongoing)) {
    drop(e, n.ref);
    return;
  }
  let key = value_or(j.status_bar_notification.get_key(e, sbn), "");
  if ((value_or(j.notification.flags(e, n), 0) & bindings.NOTIFICATION_FLAG_GROUP_SUMMARY) == 0) {
    keep(e, j, service, sbn, n, paper.Held { pkg: pkg, app: "", title: "", text: "", posted: 0i64, key: key }, dir);
  }
  let cancelled = done(j.notification_listener_service.cancel_notification(e, bindings.NotificationListenerService { ref: service }, key));
  drop(e, n.ref);
  let sent = android.tell(e, control.KIND_HELD, 0 as usize);
}

// Writes the notification `n` of `sbn` to the held file, and keeps its
// intent. `h` has the package and the key of the notification.
function keep(e: usize, j: bindings.Classes, service: usize, sbn: bindings.StatusBarNotification, n: bindings.Notification, h: paper.Held, dir: string): void {
  let extras = value_or(j.notification.extras(e, n), no_bundle());
  let text = extra_text(e, j, extras, "android.bigText");
  if (text.len() == 0) {
    text = extra_text(e, j, extras, "android.text");
  }
  let held = paper.Held { pkg: h.pkg, app: app_label_of(e, j, service, h.pkg), title: extra_text(e, j, extras, "android.title"), text: text, posted: value_or(j.status_bar_notification.get_post_time(e, sbn), 0i64), key: h.key };
  drop(e, extras.ref);
  let held_path = dir + "/" + control.HELD_FILE;
  write_text(held_path, paper.format_held(paper.add_held(paper.parse_held(read_text(held_path)), held)));
  let pi = value_or(j.notification.content_intent(e, n), bindings.PendingIntent { ref: 0 as usize });
  let class = jni.get_object_class(e, service);
  let map = intents(e, j, class);
  if (!pi.is_null() && map != 0 as usize) {
    let k = jni.new_string(e, h.key);
    drop(e, value_or(j.hash_map.put(e, bindings.HashMap { ref: map }, jni.Object { ref: k }, pi.object()), jni.Object { ref: 0 as usize }).ref);
    drop(e, k);
  }
  drop(e, class);
  drop(e, pi.ref);
}

@jni("dev.fern.paper.Filter extends android.service.notification.NotificationListenerService", "void onNotificationPosted(android.service.notification.StatusBarNotification)")
pub function filter_posted(env: usize, thiz: usize, sbn: usize): void {
  if let Ok(j) = bindings.classes(env) {
    hold(env, j, thiz, bindings.StatusBarNotification { ref: sbn });
    j.release(env);
  }
  let cleared = failed(env);
}

@jni("dev.fern.paper.Filter", "void onListenerConnected()")
pub function filter_connected(env: usize, thiz: usize): void {
  let Ok(j) = bindings.classes(env) else {
    return;
  };
  let all = value_or(j.notification_listener_service.get_active_notifications(env, bindings.NotificationListenerService { ref: thiz }), jni.Object { ref: 0 as usize });
  if (!all.is_null()) {
    for i in 0..jni.get_array_length(env, all.ref) {
      let sbn = jni.get_object_array_element(env, all.ref, i);
      hold(env, j, thiz, bindings.StatusBarNotification { ref: sbn });
      let cleared = failed(env);
      drop(env, sbn);
    }
    drop(env, all.ref);
  }
  j.release(env);
}

// ActivityOptions.MODE_BACKGROUND_ACTIVITY_START_ALLOWED: Android 14 lets an
// app that shows send another app's PendingIntent only with this mode.
const BACKGROUND_START_ALLOWED: i32 = 1;

// Opens a held notification: its own intent while the process keeps it,
// or else its app.
function open_held(ctx: usize, pkg: string, key: string): void {
  log.info("paper: open held " + pkg);
  let e = android.env(ctx);
  let Ok(j) = bindings.classes(e) else {
    return;
  };
  if (!send_held(ctx, e, j, key)) {
    let pm = package_manager(ctx, e, j);
    let intent = value_or(j.package_manager.get_launch_intent_for_package(e, pm, pkg), no_intent());
    drop(e, pm.ref);
    let started = start_intent(ctx, e, j, intent, no_bundle());
  }
  j.release(e);
}

// Sends the intent that the process keeps for the held notification with
// the key `key`. False when the process has no such intent.
function send_held(ctx: usize, e: usize, j: bindings.Classes, key: string): boolean {
  let act = android.activity_object(ctx);
  let class = jni.load_class(e, act, "dev.fern.paper.Filter");
  if (failed(e) || class == 0 as usize) {
    return false;
  }
  let map = jni.get_static_long_field(e, class, jni.get_static_field_id(e, class, "fern", "J"));
  drop(e, class);
  if (map == 0 as usize) {
    return false;
  }
  let k = jni.new_string(e, key);
  let pi = value_or(j.hash_map.remove(e, bindings.HashMap { ref: map }, jni.Object { ref: k }), jni.Object { ref: 0 as usize });
  drop(e, k);
  if (pi.is_null()) {
    return false;
  }
  let opts = value_or(j.activity_options.make_basic(e), bindings.ActivityOptions { ref: 0 as usize });
  // The method came in Android 14. On an older device it is an error,
  // and the options stay as they are.
  if let Ok(same) = j.activity_options.set_pending_intent_background_activity_start_mode(e, opts, BACKGROUND_START_ALLOWED) {
    drop(e, same.ref);
  }
  let bundle = value_or(j.activity_options.to_bundle(e, opts), no_bundle());
  let none = jni.Object { ref: 0 as usize };
  let sent = done(j.pending_intent.send(e, bindings.PendingIntent { ref: pi.ref }, context(ctx), 0, no_intent(), none, none, None, bundle));
  drop(e, bundle.ref);
  drop(e, opts.ref);
  drop(e, pi.ref);
  return sent;
}

// --- the device

function asset_bytes(ctx: usize, name: string): u8[] {
  if let Some(b) = android.asset(ctx, name) {
    return b;
  }
  log.info("paper: no asset " + name);
  return [];
}

function file_bytes(path: string): u8[] {
  if let Ok(b) = read_file_bytes(path) {
    return b;
  }
  log.info("paper: no font file " + path);
  return [];
}

// The fonts of the system for the weights of Paper.
function system_fonts(ctx: usize): face.Fonts {
  let found: Option[fonts.Found][] = [];
  for w in face.weights() {
    found = found.append(fonts.find(ctx, face.FAMILY, w));
  }
  return face.load(found, (path: string): u8[] => file_bytes(path));
}

function window_size(window: usize): (i32, i32) {
  let w = android.Window { ptr: window };
  return (w.width(), w.height());
}

function device(ctx: usize, wall: u8[]): control.Device {
  return control.Device {
    mono_ms: (): i64 => monotonic_ns() / 1000000i64,
    wall_ms: (): i64 => now_unix_ms(),
    utc_offset_ms: (unix_ms: i64): i32 => android.utc_offset_ms(ctx, unix_ms),
    is_24h: (): boolean => is_24h(ctx),
    country: (): string => country(ctx),
    read: (path: string): string => read_text(path),
    write: (path: string, text: string): void => write_text(path, text),
    size: (window: usize): (i32, i32) => window_size(window),
    wallpaper: (w: i32): worker.Worker[draw.Image] => worker.spawn((): draw.Image => ui.wallpaper(wall, w)),
    apps: (): paper.Entry[] => query_apps(ctx, true),
    app_keys: (): string[] => app_keys(ctx),
    launch: (key: string, x: i32, y: i32, w: i32, h: i32): boolean => launch(ctx, key, x, y, w, h),
    open: (what: string, arg: string): boolean => open(ctx, what, arg),
    notifications: (): void => expand_notifications(ctx),
    show_field: (text: string, action: i32): void => keyboard.show(ctx, text, android.INPUT_TEXT, action),
    set_field: (text: string): void => keyboard.set_text(ctx, text),
    hide_field: (): void => keyboard.hide(ctx),
    access: (items: android.AccessItem[]): void => access.publish(ctx, items),
    bars: (top: boolean, bottom: boolean): void => set_bars(ctx, top, bottom),
    has_location: (): boolean => android.has_permission(ctx, LOCATION),
    ask_location: (): void => android.request_permissions(ctx, [LOCATION]),
    location: (): Option[(f64, f64)] => last_location(ctx),
    fetch: (url: string): worker.Worker[string] => fetch_weather(url),
    listener_on: (): boolean => listener_on(ctx),
    default_allowed: (): string[] => default_allowed(ctx),
    open_held: (pkg: string, key: string): void => open_held(ctx, pkg, key),
    request_frame: (): void => android.request_frame(ctx),
    property: (name: string): string => property.get(name).unwrap_or(""),
    attach_gpu: (p: painter.Painter, window: usize): painter.Painter => attach_gpu(p, window),
    present: (own p: painter.Painter, passes: scene.Pass[], background: i32): painter.Painter => painter.present(p, passes, background),
    detach_gpu: (p: painter.Painter): painter.Painter => painter.detach(p),
    close_gpu: (p: painter.Painter): painter.Painter => painter.close(p),
  };
}

function attach_gpu(p: painter.Painter, window: usize): painter.Painter {
  let q = painter.attach(p, window);
  if (!painter.attached(q)) {
    log.error("paper: the window has no OpenGL ES 2 canvas");
  }
  return q;
}

// The middle of the clock among `ns`, for the emulator check to tap, or "".
function clock_place(ns: scene.Node[]): string {
  for n in ns {
    if (n.tap.name == "clock") {
      return ", clock at " + (n.x + n.w / 2).to_string() + " " + (n.y + n.h / 2).to_string();
    }
  }
  return "";
}

// One step of the app, with a log line for each change that the emulator
// check waits for.
function step(own s: control.App, e: android.Event): control.App {
  let layer = s.layer;
  let apps = s.installed.len();
  let drawn = s.nodes.len() > 0;
  let clock = clock_place(s.nodes);
  let t = control.step(s, e);
  let placed = clock_place(t.nodes);
  if (!drawn && t.nodes.len() > 0) {
    log.info("paper: drawn " + t.w.to_string() + "x" + t.h.to_string() + placed);
  } else if (clock.len() > 0 && placed.len() > 0 && placed != clock) {
    log.info("paper: moved" + placed);
  }
  if (t.layer != layer) {
    log.info("paper: layer " + t.layer.to_string());
  }
  if (t.installed.len() != apps) {
    let listed = paper.find_package(t.installed, OWN_PACKAGE).is_some();
    log.info("paper: apps " + t.installed.len().to_string() + ", Paper listed " + listed.to_string());
  }
  return t;
}

function app_main(ctx: usize): usize {
  let first = control.with_theme(control.with_density(control.new(device(ctx, asset_bytes(ctx, "wallpaper.jpg")), android.data_dir(ctx), system_fonts(ctx)), android.density(ctx)), android.night_mode(ctx));
  let last = android.run(ctx, first, (own s: control.App, e: android.Event): control.App => step(s, e), (s: control.App): i32 => control.timeout(s, monotonic_ns() / 1000000i64));
  control.close(last);
  return 0 as usize;
}
