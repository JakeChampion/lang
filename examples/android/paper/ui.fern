// The look of Paper. `nodes` lays out a screen as a list of nodes of
// std/android/ui/scene: a rectangle, what it shows, and the actions of a
// tap and of a long press on it. The drawing and the touches use that one
// layout. The sizes are those of Paper's Android views: text in sp and
// boxes in dp. Every function is pure: a paint writes only into the frame
// that it gets.
import "std/android";
import "std/android/draw";
import "std/android/ui/scene";
import "std/jpeg";
import "./face";
import "./paper";

pub const HOME: i32 = 0;

pub const DRAWER: i32 = 1;

pub const PAUSE: i32 = 2;

pub const BLOCKED: i32 = 3;

// Where the dark sky starts below the yellow ridge, as a part of the height
// of the wallpaper.
pub const SKY_TOP: f64 = 0.445;

// --- colours

// The colours of the paper, the ink and the dialogs, light or dark. The
// wallpaper keeps its own colours in both.
pub struct Palette { paper: i32, ink: i32, ink_soft: i32, ink_faded: i32, dialog: i32, dialog_text: i32, dialog_soft: i32 }

// The palette of the system theme: dark when `dark` is true.
pub function palette(dark: boolean): Palette {
  if (dark) {
    return Palette { paper: draw.rgb(28, 26, 23), ink: draw.rgb(240, 230, 215), ink_soft: draw.rgb(168, 154, 136), ink_faded: draw.rgba(240, 230, 215, 102), dialog: draw.rgb(43, 40, 37), dialog_text: draw.rgb(236, 230, 224), dialog_soft: draw.rgb(190, 182, 172) };
  }
  return Palette { paper: draw.rgb(255, 244, 230), ink: draw.rgb(17, 17, 17), ink_soft: draw.rgb(138, 122, 102), ink_faded: draw.rgba(17, 17, 17, 102), dialog: draw.rgb(247, 242, 236), dialog_text: draw.rgb(29, 27, 32), dialog_soft: draw.rgb(73, 69, 79) };
}

pub function ridge(): i32 {
  return draw.rgb(227, 180, 0);
}

pub function night(): i32 {
  return draw.rgb(23, 50, 58);
}

pub function cream(): i32 {
  return draw.rgb(255, 244, 230);
}

// --- metrics

// The window is w by h. `d` is the pixels of one density-independent pixel.
// `top` and `bottom` are the parts that the status bar, and the navigation
// bar or the keyboard, cover. `pal` holds the colours of the theme.
pub struct Metrics { w: i32, h: i32, d: f64, top: i32, bottom: i32, pal: Palette }

pub function dp(m: Metrics, v: f64): i32 {
  return (v * m.d).round() as i32;
}

// --- the wallpaper

// The wallpaper in the JPEG `bytes`, at the width `w`, as an image. The app
// copies it once into a layer, which each frame copies to the window.
pub function wallpaper_layer(img: draw.Image): draw.Frame {
  let f = draw.offscreen(img.width, img.height);
  if (f.width > 0) {
    f.image(0, 0, img.width, img.height, img);
  }
  return f;
}

// A pixel within NEAR_PAPER of the light paper, in each channel, takes the
// dark paper in full. Between that and FAR_PAPER it takes less of it.
const NEAR_PAPER: i32 = 48;

const FAR_PAPER: i32 = 96;

// The wallpaper `img` in the theme of `pal`. With a dark paper, a pixel near
// the light paper moves to the dark paper with a third of its difference
// from the light paper, so the sky above the ridge keeps a faint grain.
pub function themed(img: draw.Image, pal: Palette): draw.Image {
  let light = palette(false).paper;
  if (pal.paper == light) {
    return img;
  }
  let px = img.pixels;
  for i in 0..img.width * img.height {
    let k = i * 4;
    let far = 0;
    for ch in 0..3 {
      far = far.max((px[k + ch] as i32 - (light >> 8 * ch & 255)).abs());
    }
    if (far < FAR_PAPER) {
      let weight = (FAR_PAPER - far).min(FAR_PAPER - NEAR_PAPER);
      for ch in 0..3 {
        let v = px[k + ch] as i32;
        let target = (pal.paper >> 8 * ch & 255) + (v - (light >> 8 * ch & 255)) / 3;
        px = px.with(k + ch, (v + (target - v) * weight / (FAR_PAPER - NEAR_PAPER)).max(0).min(255) as u8);
      }
    }
  }
  return draw.Image { ...img, pixels: px };
}

pub function wallpaper(bytes: [u8], w: i32): draw.Image {
  match (jpeg.decode_image(bytes)) {
    Ok(img) => {
      let h = (img.height as i64 * (w as i64) / (img.width as i64)) as i32;
      return draw.Image { width: img.width, height: img.height, pixels: img.pixels }.scaled(w, h);
    },
    Err(_) => {
      return draw.Image { width: 0, height: 0, pixels: [] };
    }
  }
}

// --- what a screen shows

// A row of a dialog. `check` is -1 for a row with no check box, else 0 or
// 1. A line break in `text` gives the row two lines.
pub struct Row { text: string, sub: string, check: i32, act: string }

// A dialog over the screen: a title, rows that scroll, a text field when
// `field` is true, and buttons. The first button of three goes on the left.
pub struct Sheet { title: string, rows: Row[], buttons: Row[], field: boolean, text: string, hint: string, scroll: i32 }

pub struct Pause { title: string, lines: string[], open: string, ready: boolean, breath: f64 }

pub struct View {
  m: Metrics,
  layer: i32,
  date: string,
  time: string,
  weather: Option[paper.Weather],
  weather_note: string,
  favourites: paper.Entry[],
  fav_scroll: i32,
  held: i32,
  hint: boolean,
  query: string,
  typing: boolean,
  results: paper.Entry[],
  dim: string[],
  list_scroll: i32,
  sheet: Option[Sheet],
  pause: Pause,
  note: string,
  // The layer of the wallpaper at the width of the window.
  wall: draw.Frame,
}

pub function no_pause(): Pause {
  return Pause { title: "", lines: [], open: "", ready: false, breath: 0.0 };
}

// --- nodes

// The nodes are those of std/android/ui/scene. The name of the action of a
// tap or of a long press tells the app what to do: "" for none. A node
// with a group is in a list that scrolls. What Paper draws itself is a
// Custom paint, with a key that names its pixels.

function node(x: i32, y: i32, w: i32, h: i32, paint: scene.Paint): scene.Node {
  return scene.node(x, y, w, h, paint);
}

function fill(x: i32, y: i32, w: i32, h: i32, color: i32, r: i32): scene.Node {
  return node(x, y, w, h, scene.Fill(color, r));
}

function label(f: face.Fonts, x: i32, y: i32, s: string, px: i32, weight: i32, color: i32): scene.Node {
  return node(x, y, face.width(f, weight, px, s), face.line(f, weight, px), scene.Label(s, px, weight, 0, color));
}

function tap(n: scene.Node, act: string): scene.Node {
  return scene.Node { ...n, tap: scene.Action { name: act, arg: 0 } };
}

function held(n: scene.Node, act: string, long: string): scene.Node {
  return scene.Node { ...n, tap: scene.Action { name: act, arg: 0 }, long: scene.Action { name: long, arg: 0 } };
}

// A node that takes the touches, so they do not go to the nodes below it.
function barrier(n: scene.Node): scene.Node {
  return scene.Node { ...n, barrier: true };
}

function in_list(n: scene.Node, group: string, c0: i32, c1: i32): scene.Node {
  return scene.Node { ...n, group: group, clip0: c0, clip1: c1 };
}

// A node that `draw` draws in its box. It can draw `margin` pixels past the
// box. `key` names the pixels.
function shape(x: i32, y: i32, w: i32, h: i32, key: string, margin: i32, draw: (draw.Frame, scene.Node) => void): scene.Node {
  return node(x, y, w, h, scene.Custom(key, margin, (fr: draw.Frame, bx: i32, by: i32, bw: i32, bh: i32): void => draw(fr, scene.node(bx, by, bw, bh, scene.Blank))));
}

// The margin of the shapes: the round ends of their lines go past the box.
function shape_margin(m: Metrics): i32 {
  return (8.0 * m.d) as i32;
}

function sky_index(sky: paper.Sky): i32 {
  match (sky) {
    paper.Clear => {
      return 0;
    },
    paper.Partly => {
      return 1;
    },
    paper.Cloudy => {
      return 2;
    },
    paper.Fog => {
      return 3;
    },
    paper.Rain => {
      return 4;
    },
    paper.Snow => {
      return 5;
    },
    paper.Storm => {
      return 6;
    }
  }
}

// The key of the colours of `pal`.
function pal_key(pal: Palette): string {
  return pal.paper.to_string() + "," + pal.ink.to_string();
}

// Text with a soft shadow, which an accessibility service reads.
pub function shadowed(m: Metrics, f: face.Fonts, x: i32, y: i32, w: i32, h: i32, s: string, px: i32, weight: i32, color: i32, blur: i32): scene.Node {
  let d = m.d;
  let key = "shadow|" + px.to_string() + "|" + weight.to_string() + "|" + color.to_string() + "|" + blur.to_string() + "|" + s;
  let n = shape(x, y, w, h, key, 3 * blur + d.ceil() as i32 + 4, (fr: draw.Frame, b: scene.Node): void => { let c = paint_shadowed(face.new_cache(), fr, f, b, s, px, weight, color, blur, d); });
  return scene.Node { ...n, say: s };
}

// The wallpaper on the paper colour, on the whole window.
function wallpaper_node(m: Metrics, wall: draw.Frame): scene.Node {
  let paper_color = m.pal.paper;
  let key = "wall|" + wall.width.to_string() + "x" + wall.height.to_string() + "|" + paper_color.to_string();
  return shape(0, 0, m.w, m.h, key, 0, (fr: draw.Frame, b: scene.Node): void => {
    fr.store(b.x, b.y, b.w, b.h, paper_color);
    fr.blit(wall, b.x, b.y + b.h - wall.height);
  });
}

// The wallpaper drawn back over the edge of a list: all of it at the edge
// of the list, and none of it `h` pixels in.
function fade_node(m: Metrics, wall: draw.Frame, x: i32, y: i32, w: i32, h: i32, top: boolean): scene.Node {
  let paper_color = m.pal.paper;
  let win_h = m.h;
  let key = "fade|" + top.to_string() + "|" + x.to_string() + "," + y.to_string() + "|" + wall.width.to_string() + "x" + wall.height.to_string() + "|" + win_h.to_string() + "|" + paper_color.to_string();
  return shape(x, y, w, h, key, 0, (fr: draw.Frame, b: scene.Node): void => paint_fade(fr, b, x, y, wall, win_h, top, paper_color));
}

pub function weather_node(m: Metrics, x: i32, y: i32, w: i32, h: i32, sky: paper.Sky): scene.Node {
  let ink = m.pal.ink;
  return shape(x, y, w, h, "sky|" + sky_index(sky).to_string() + "|" + ink.to_string(), shape_margin(m), (fr: draw.Frame, b: scene.Node): void => paint_sky(fr, b, sky, ink));
}

function gauge_node(m: Metrics, f: face.Fonts, x: i32, y: i32, w: i32, h: i32, now: string, range: string, frac: f64): scene.Node {
  let pal = m.pal;
  let key = "gauge|" + now + "|" + range + "|" + ((frac * 1000.0).round() as i32).to_string() + "|" + pal_key(pal);
  return shape(x, y, w, h, key, shape_margin(m), (fr: draw.Frame, b: scene.Node): void => { let c = paint_gauge(face.new_cache(), fr, f, b, now, range, frac, pal); });
}

function music_node(m: Metrics, x: i32, y: i32, w: i32, h: i32): scene.Node {
  let pal = m.pal;
  return shape(x, y, w, h, "music|" + pal_key(pal), shape_margin(m), (fr: draw.Frame, b: scene.Node): void => paint_music(fr, b, pal));
}

function ridge_node(m: Metrics, x: i32, y: i32, w: i32, h: i32): scene.Node {
  let d = m.d;
  return shape(x, y, w, h, "ridge", shape_margin(m), (fr: draw.Frame, b: scene.Node): void => paint_ridge(fr, b, d));
}

function breath_node(m: Metrics, x: i32, y: i32, w: i32, h: i32, scale: f64): scene.Node {
  let d = m.d;
  return shape(x, y, w, h, "breath|" + ((scale * 1000.0).round() as i32).to_string(), shape_margin(m), (fr: draw.Frame, b: scene.Node): void => paint_breath(fr, b, scale, d));
}

// The check box of a row. The app draws the image of such a node again when
// its key changes.
pub function check_node(m: Metrics, x: i32, y: i32, w: i32, h: i32, on: boolean): scene.Node {
  let d = m.d;
  let pal = m.pal;
  return shape(x, y, w, h, "check|" + on.to_string() + "|" + pal_key(pal), shape_margin(m), (fr: draw.Frame, b: scene.Node): void => paint_check(fr, b, on, d, pal));
}

function cat(a: scene.Node[], b: scene.Node[]): scene.Node[] {
  let out = a;
  for n in b {
    out = out.append(n);
  }
  return out;
}

// --- the home screen

// The size of the clock text: 27% of the width in dp, at most 108 sp.
pub function clock_px(m: Metrics): i32 {
  let sp = m.w as f64 / m.d * 0.27;
  if (sp > 108.0) {
    sp = 108.0;
  }
  return dp(m, sp);
}

// The y of the part `part` of the height of the wallpaper, which fills the
// width and sits on the bottom edge. The image is `ratio` times as high as
// it is wide.
pub function wallpaper_y(m: Metrics, ratio: f64, part: f64): i32 {
  let h = m.w as f64 * ratio;
  return (m.h as f64 - h + part * h) as i32;
}

pub const WALLPAPER_RATIO: f64 = 2048.0 / 947.0;

function date_y(m: Metrics): i32 {
  return m.top + dp(m, 40.0);
}

function clock_y(m: Metrics, f: face.Fonts): i32 {
  return date_y(m) + face.line(f, face.BOLD, dp(m, 21.0)) + dp(m, 2.0);
}

function row_y(m: Metrics, f: face.Fonts): i32 {
  return clock_y(m, f) + face.line(f, face.EXTRABOLD, clock_px(m)) + dp(m, 22.0);
}

// The height of the weather text: three lines with 3 dp between them.
function widget_h(m: Metrics, f: face.Fonts): i32 {
  return face.line(f, face.BOLD, dp(m, 19.0)) + 2 * (face.line(f, face.SEMIBOLD, dp(m, 19.0)) + dp(m, 3.0));
}

// The bottom of the header: the date, the clock and the widgets.
pub function header_bottom(m: Metrics, f: face.Fonts): i32 {
  let h = widget_h(m, f);
  if (h < dp(m, 70.0)) {
    h = dp(m, 70.0);
  }
  return row_y(m, f) + h;
}

// The top of the list of home apps: in the dark sky under the ridge, below
// the widgets.
pub function favourites_top(m: Metrics, f: face.Fonts): i32 {
  let sky = wallpaper_y(m, WALLPAPER_RATIO, SKY_TOP) + dp(m, 20.0);
  let below = header_bottom(m, f) + dp(m, 28.0);
  if (sky > below) {
    return sky;
  }
  return below;
}

pub function favourites_bottom(m: Metrics): i32 {
  return m.h - m.bottom - dp(m, 16.0);
}

pub function fav_row(m: Metrics, f: face.Fonts): i32 {
  return face.line(f, face.SEMIBOLD, dp(m, 27.0)) + dp(m, 14.0);
}

function held_h(m: Metrics, f: face.Fonts): i32 {
  return face.line(f, face.SEMIBOLD, dp(m, 16.0)) + dp(m, 21.0);
}

// The height of the content of the list of home apps.
pub function favourites_height(m: Metrics, f: face.Fonts, v: View): i32 {
  let h = v.favourites.len() * fav_row(m, f);
  if (v.held > 0) {
    h += held_h(m, f);
  }
  return h;
}

pub function fav_scroll_limit(m: Metrics, f: face.Fonts, v: View): i32 {
  let room = favourites_bottom(m) - favourites_top(m, f);
  let over = favourites_height(m, f, v) - room;
  if (over < 0) {
    return 0;
  }
  return over;
}

function home_base(m: Metrics, f: face.Fonts, v: View): scene.Node[] {
  let ns: scene.Node[] = [wallpaper_node(m, v.wall)];
  let date_px = dp(m, 21.0);
  let dw = face.spaced_width(f, face.BOLD, date_px, -10, v.date);
  ns = ns.append(tap(node((m.w - dw) / 2, date_y(m), dw, face.line(f, face.BOLD, date_px), Label(v.date, date_px, face.BOLD, -10, m.pal.ink)), "calendar"));
  let cpx = clock_px(m);
  let cw = face.spaced_width(f, face.EXTRABOLD, cpx, -35, v.time);
  ns = ns.append(tap(node((m.w - cw) / 2, clock_y(m, f), cw, face.line(f, face.EXTRABOLD, cpx), Label(v.time, cpx, face.EXTRABOLD, -35, m.pal.ink)), "clock"));
  ns = cat(ns, widgets(m, f, v, row_y(m, f)));
  return cat(ns, hint(m, f, v));
}

// The hint of a home screen with no apps on it.
function hint(m: Metrics, f: face.Fonts, v: View): scene.Node[] {
  if (!v.hint || v.favourites.len() > 0) {
    return [];
  }
  let x = dp(m, 36.0);
  let top = favourites_top(m, f);
  let spx = dp(m, 16.0);
  let lh = face.line(f, face.MEDIUM, spx) + dp(m, 4.0);
  let soft = draw.rgba(255, 244, 230, 204);
  return [shadowed(m, f, x, top + dp(m, 8.0), m.w - 2 * x, lh, "Swipe up for all apps.", spx, face.MEDIUM, soft, dp(m, 6.0)), shadowed(m, f, x, top + dp(m, 8.0) + lh, m.w - 2 * x, lh, "Long-press anywhere to pick home apps.", spx, face.MEDIUM, soft, dp(m, 6.0))];
}

function widgets(m: Metrics, f: face.Fonts, v: View, y: i32): scene.Node[] {
  let px = dp(m, 19.0);
  let x = dp(m, 40.0);
  let gauge = dp(m, 62.0);
  let music = dp(m, 62.0);
  let gx = m.w - dp(m, 40.0) - gauge;
  let mx = gx - dp(m, 22.0) - music;
  let room = mx - x;
  let ns: scene.Node[] = [];
  let sky = paper.Cloudy;
  let first = "--°";
  let second = "Tap for";
  let third = "weather";
  if let Some(w) = v.weather {
    sky = paper.sky(w);
    first = paper.degrees(w.temp) + "°";
    second = paper.describe(w);
    third = "H:" + paper.degrees(w.high) + "° L:" + paper.degrees(w.low) + "°";
  } else if (v.weather_note.len() > 0) {
    second = "Weather";
    third = v.weather_note;
  }
  let top_line = face.line(f, face.BOLD, px);
  let line = face.line(f, face.SEMIBOLD, px) + dp(m, 3.0);
  let ix = dp(m, 24.0);
  let iy = dp(m, 18.0);
  ns = ns.append(weather_node(m, x, y + (top_line - iy) / 2, ix, iy, sky));
  ns = ns.append(label(f, x + ix + dp(m, 4.0), y, first, px, face.BOLD, m.pal.ink));
  ns = ns.append(label(f, x, y + top_line + dp(m, 3.0), face.fit(f, face.SEMIBOLD, px, second, room), px, face.SEMIBOLD, m.pal.ink));
  ns = ns.append(label(f, x, y + top_line + dp(m, 3.0) + line, face.fit(f, face.SEMIBOLD, px, third, room), px, face.SEMIBOLD, m.pal.ink));
  let block_h = widget_h(m, f);
  ns = ns.append(tap(node(x, y, room, block_h, scene.Blank), "weather"));
  ns = ns.append(scene.Node { ...held(music_node(m, mx, y + (block_h - music) / 2, music, music), "music", "pick-music"), say: "Music" });
  let now = "--";
  let range = "";
  let frac = -1.0;
  if let Some(w) = v.weather {
    now = paper.degrees(w.temp);
    range = paper.degrees(w.low) + "  " + paper.degrees(w.high);
    frac = 0.5;
    if (w.high > w.low) {
      frac = (w.temp - w.low) / (w.high - w.low);
    }
  }
  ns = ns.append(scene.Node { ...tap(gauge_node(m, f, gx, y + (block_h - dp(m, 70.0)) / 2, gauge, dp(m, 70.0), now, range, frac), "weather"), say: "Weather" });
  return ns;
}

function favourites(m: Metrics, f: face.Fonts, v: View): scene.Node[] {
  let top = favourites_top(m, f);
  let bottom = favourites_bottom(m);
  let px = dp(m, 27.0);
  let row = fav_row(m, f);
  let x = dp(m, 36.0);
  let width = m.w - 2 * x;
  let ns: scene.Node[] = [];
  let y = top - v.fav_scroll;
  let widest = 0;
  let cream_text = cream();
  for a in v.favourites {
    let text = face.fit(f, face.SEMIBOLD, px, a.label, width);
    let w = face.width(f, face.SEMIBOLD, px, text);
    if (w > widest) {
      widest = w;
    }
    if (y + row > top && y < bottom) {
      let n = shadowed(m, f, x, y, w, row, text, px, face.SEMIBOLD, cream_text, dp(m, 8.0));
      ns = ns.append(in_list(held(n, "open:" + a.key, "menu:" + a.key), "fav", top, bottom));
    }
    y += row;
  }
  if (v.held > 0) {
    let spx = dp(m, 16.0);
    let text = v.held.to_string() + " held notifications";
    if (v.held == 1) {
      text = "1 held notification";
    }
    let n = shadowed(m, f, x, y + dp(m, 14.0), face.width(f, face.SEMIBOLD, spx, text), held_h(m, f) - dp(m, 14.0), text, spx, face.SEMIBOLD, draw.rgba(255, 244, 230, 204), dp(m, 6.0));
    ns = ns.append(in_list(tap(n, "held"), "fav", top, bottom));
  }
  if (ns.len() == 0) {
    return ns;
  }
  // The scroll area covers the rows only, so a long press beside them opens
  // the settings.
  let area = node(x, top, widest, bottom - top, scene.Blank);
  ns = cat([in_list(area, "fav", top, bottom)], ns);
  // The faded edges of a list that scrolls, as Android's ScrollView draws.
  let edge = dp(m, 24.0);
  if (v.fav_scroll > 0) {
    ns = ns.append(fade_node(m, v.wall, x - dp(m, 12.0), top, width + dp(m, 24.0), edge, true));
  }
  if (v.fav_scroll < fav_scroll_limit(m, f, v)) {
    ns = ns.append(fade_node(m, v.wall, x - dp(m, 12.0), bottom - edge, width + dp(m, 24.0), edge, false));
  }
  return ns;
}

// --- the app list

pub function search_px(m: Metrics): i32 {
  return dp(m, 32.0);
}

function search_y(m: Metrics): i32 {
  return m.top + dp(m, 36.0);
}

pub function list_top(m: Metrics, f: face.Fonts): i32 {
  return search_y(m) + face.line(f, face.EXTRABOLD, search_px(m)) + dp(m, 6.0) + dp(m, 22.0) + dp(m, 4.0);
}

pub function list_row(m: Metrics, f: face.Fonts): i32 {
  return face.line(f, face.SEMIBOLD, dp(m, 25.0)) + dp(m, 22.0);
}

pub function list_bottom(m: Metrics): i32 {
  return m.h - m.bottom;
}

pub function list_scroll_limit(m: Metrics, f: face.Fonts, n: i32): i32 {
  let over = n * list_row(m, f) + dp(m, 36.0) - (list_bottom(m) - list_top(m, f));
  if (over < 0) {
    return 0;
  }
  return over;
}

// The top of the app list: the search field and the ridge.
function drawer_head(m: Metrics, f: face.Fonts, v: View): scene.Node[] {
  let ns: scene.Node[] = [fill(0, 0, m.w, m.h, m.pal.paper, 0)];
  let x = dp(m, 32.0);
  let spx = search_px(m);
  let sy = search_y(m);
  let room = m.w - 2 * x - dp(m, 4.0);
  let shown = face.fit_end(f, face.EXTRABOLD, spx, v.query, room);
  if (v.query.len() == 0) {
    ns = ns.append(label(f, x, sy, "Search", spx, face.EXTRABOLD, m.pal.ink_soft));
  } else {
    ns = ns.append(label(f, x, sy, shown, spx, face.EXTRABOLD, m.pal.ink));
  }
  if (v.typing) {
    let qw = 0;
    if (v.query.len() > 0) {
      qw = face.width(f, face.EXTRABOLD, spx, shown);
    }
    ns = ns.append(fill(x + qw + dp(m, 1.0), sy, dp(m, 2.0), face.line(f, face.EXTRABOLD, spx), m.pal.ink, 0));
  }
  ns = ns.append(tap(node(0, m.top, m.w, sy + face.line(f, face.EXTRABOLD, spx) - m.top, scene.Blank), "type"));
  let ridge_y = sy + face.line(f, face.EXTRABOLD, spx) + dp(m, 6.0);
  return ns.append(ridge_node(m, 0, ridge_y, m.w, dp(m, 22.0)));
}

// The rows of the app list.
function drawer_rows(m: Metrics, f: face.Fonts, v: View): scene.Node[] {
  let x = dp(m, 32.0);
  let ns: scene.Node[] = [];
  let top = list_top(m, f);
  let bottom = list_bottom(m);
  let row = list_row(m, f);
  let px = dp(m, 25.0);
  ns = ns.append(in_list(node(0, top, m.w, bottom - top, scene.Blank), "list", top, bottom));
  if (v.results.len() == 0) {
    let epx = dp(m, 17.0);
    ns = ns.append(label(f, x, top + dp(m, 12.0), "No matching apps.", epx, face.MEDIUM, m.pal.ink_soft));
    ns = ns.append(label(f, x, top + dp(m, 12.0) + face.line(f, face.MEDIUM, epx), "Press enter to search the web.", epx, face.MEDIUM, m.pal.ink_soft));
    return ns;
  }
  let first = v.list_scroll / row;
  let y = top + dp(m, 4.0) + first * row - v.list_scroll;
  let i = first;
  while (i < v.results.len() && y < bottom) {
    let a = v.results[i];
    let text = a.label;
    let color = m.pal.ink;
    if (paper.has(v.dim, a.key)) {
      color = m.pal.ink_faded;
      if (paper.has(v.dim, "blocked:" + a.key)) {
        text += " · blocked";
      }
    }
    let ty = y + (row - face.line(f, face.SEMIBOLD, px)) / 2;
    let n = node(x, ty, m.w - x, face.line(f, face.SEMIBOLD, px), Label(face.fit(f, face.SEMIBOLD, px, text, m.w - 2 * x), px, face.SEMIBOLD, 0, color));
    ns = ns.append(in_list(n, "list", top, bottom));
    ns = ns.append(in_list(held(node(0, y, m.w, row, scene.Blank), "open:" + a.key, "menu:" + a.key), "list", top, bottom));
    y += row;
    i += 1;
  }
  if (v.query.len() == 0) {
    ns = cat(ns, letter_index(m, f, v.results, top, bottom));
  }
  return ns;
}

const ALPHABET: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

// The letter of an app name in the index: its first letter, A to Z, or "#".
pub function letter_of(name: string): string {
  if (name.len() == 0) {
    return "#";
  }
  let b = name[0] as i32;
  if (b >= 97 && b <= 122) {
    b -= 32;
  }
  if (b < 65 || b > 90) {
    return "#";
  }
  return ALPHABET.drop(b - 65).take(1).to_owned();
}

// The letters of the apps, in the order of the list, each once.
pub function letters(apps: paper.Entry[]): string[] {
  let out: string[] = [];
  for a in apps {
    let l = letter_of(a.label);
    if (!paper.has(out, l)) {
      out = out.append(l);
    }
  }
  return out;
}

// The scroll of the app list that puts the first app of `letter` at the top.
pub function letter_scroll(m: Metrics, f: face.Fonts, apps: paper.Entry[], letter: string): i32 {
  for i in 0..apps.len() {
    if (letter_of(apps[i].label) == letter) {
      return (i * list_row(m, f)).min(list_scroll_limit(m, f, apps.len()));
    }
  }
  return 0;
}

// A column of the letters of the apps on each edge of the app list. A tap
// or a drag on a letter goes to its apps.
function letter_index(m: Metrics, f: face.Fonts, apps: paper.Entry[], top: i32, bottom: i32): scene.Node[] {
  let ls = letters(apps);
  if (ls.len() < 2) {
    return [];
  }
  let px = dp(m, 13.0);
  let col = dp(m, 28.0);
  let slot = ((bottom - top) / ls.len()).min(dp(m, 26.0));
  let y = top + (bottom - top - slot * ls.len()) / 2;
  let lh = face.line(f, face.SEMIBOLD, px);
  let ns: scene.Node[] = [];
  for l in ls {
    let w = face.width(f, face.SEMIBOLD, px, l);
    for x in [0, m.w - col] {
      ns = ns.append(label(f, x + (col - w) / 2, y + (slot - lh) / 2, l, px, face.SEMIBOLD, m.pal.ink_soft));
      ns = ns.append(scene.Node { ...tap(node(x, y, col, slot, scene.Blank), "jump:" + l), group: "index" });
    }
    y += slot;
  }
  return ns;
}

// --- dialogs

pub function dialog_width(m: Metrics): i32 {
  let w = m.w - 2 * dp(m, 32.0);
  if (w > dp(m, 560.0)) {
    return dp(m, 560.0);
  }
  return w;
}

function row_lines(r: Row): string[] {
  return r.text.split("\n");
}

pub function row_height(m: Metrics, f: face.Fonts, r: Row): i32 {
  let lines = row_lines(r).len();
  if (lines <= 1) {
    return dp(m, 48.0);
  }
  return lines * face.line(f, face.REGULAR, dp(m, 16.0)) + dp(m, 20.0);
}

function rows_height(m: Metrics, f: face.Fonts, s: Sheet): i32 {
  let h = 0;
  for r in s.rows {
    h += row_height(m, f, r);
  }
  return h;
}

// The top and the height of the card, and the top and the bottom of its
// rows.
pub function dialog_box(m: Metrics, f: face.Fonts, s: Sheet): (i32, i32, i32, i32) {
  let title_h = dp(m, 24.0) + face.line(f, face.REGULAR, dp(m, 24.0)) + dp(m, 16.0);
  let field_h = 0;
  if (s.field) {
    field_h = dp(m, 8.0) + dp(m, 48.0) + dp(m, 8.0);
  }
  let buttons_h = dp(m, 24.0);
  if (s.buttons.len() > 0) {
    buttons_h = dp(m, 8.0) + dp(m, 40.0) + dp(m, 24.0);
  }
  let rows_h = rows_height(m, f, s);
  let avail = m.h - m.top - m.bottom - dp(m, 48.0);
  let most = avail - title_h - field_h - buttons_h;
  if (rows_h > most) {
    rows_h = most;
  }
  let h = title_h + field_h + rows_h + buttons_h;
  let top = m.top + (m.h - m.top - m.bottom - h) / 2;
  let rows_top = top + title_h + field_h;
  return (top, h, rows_top, rows_top + rows_h);
}

pub function sheet_scroll_limit(m: Metrics, f: face.Fonts, s: Sheet): i32 {
  let (_, _, r0, r1) = dialog_box(m, f, s);
  let over = rows_height(m, f, s) - (r1 - r0);
  if (over < 0) {
    return 0;
  }
  return over;
}

function dialog(m: Metrics, f: face.Fonts, s: Sheet): scene.Node[] {
  let ns: scene.Node[] = [barrier(tap(fill(0, 0, m.w, m.h, draw.rgba(0, 0, 0, 82), 0), "dismiss"))];
  let (top, h, r0, r1) = dialog_box(m, f, s);
  let w = dialog_width(m);
  let left = (m.w - w) / 2;
  ns = ns.append(barrier(tap(fill(left, top, w, h, m.pal.dialog, dp(m, 28.0)), "none")));
  let pad = dp(m, 24.0);
  let x = left + pad;
  let inner = w - 2 * pad;
  let tpx = dp(m, 24.0);
  ns = ns.append(label(f, x, top + pad, face.fit(f, face.REGULAR, tpx, s.title, inner), tpx, face.REGULAR, m.pal.dialog_text));
  let y = top + pad + face.line(f, face.REGULAR, tpx) + dp(m, 16.0);
  if (s.field) {
    let fpx = dp(m, 18.0);
    let fy = y + dp(m, 8.0);
    let fh = dp(m, 48.0);
    ns = ns.append(tap(node(x, fy, inner, fh, scene.Blank), "type"));
    let ty = fy + (fh - face.line(f, face.REGULAR, fpx)) / 2;
    let room = inner - dp(m, 8.0);
    let shown = face.fit_end(f, face.REGULAR, fpx, s.text, room);
    if (s.text.len() == 0) {
      ns = ns.append(label(f, x + dp(m, 4.0), ty, face.fit(f, face.REGULAR, fpx, s.hint, room), fpx, face.REGULAR, m.pal.dialog_soft));
    } else {
      ns = ns.append(label(f, x + dp(m, 4.0), ty, shown, fpx, face.REGULAR, m.pal.dialog_text));
    }
    let tw = 0;
    if (s.text.len() > 0) {
      tw = face.width(f, face.REGULAR, fpx, shown);
    }
    ns = ns.append(fill(x + dp(m, 4.0) + tw + dp(m, 1.0), ty, dp(m, 2.0), face.line(f, face.REGULAR, fpx), m.pal.ink, 0));
    ns = ns.append(fill(x, fy + fh - dp(m, 8.0), inner, dp(m, 2.0), m.pal.ink, 0));
  }
  let rpx = dp(m, 16.0);
  ns = ns.append(in_list(node(left, r0, w, r1 - r0, scene.Blank), "sheet", r0, r1));
  let ry = r0 - s.scroll;
  for r in s.rows {
    let rh = row_height(m, f, r);
    if (ry + rh > r0 && ry < r1) {
      ns = ns.append(in_list(tap(node(left, ry, w, rh, scene.Blank), r.act), "sheet", r0, r1));
      let tx = x;
      if (r.check >= 0) {
        let c = dp(m, 18.0);
        ns = ns.append(in_list(check_node(m, x, ry + (rh - c) / 2, c, c, r.check == 1), "sheet", r0, r1));
        tx = x + dp(m, 32.0) + dp(m, 2.0);
      }
      let lines = row_lines(r);
      let lh = face.line(f, face.REGULAR, rpx);
      let ly = ry + (rh - lines.len() * lh) / 2;
      for k in 0..lines.len() {
        let color = m.pal.dialog_text;
        if (k == 0 && lines.len() > 1) {
          color = m.pal.dialog_soft;
        }
        ns = ns.append(in_list(label(f, tx, ly, face.fit(f, face.REGULAR, rpx, lines[k], left + w - pad - tx), rpx, face.REGULAR, color), "sheet", r0, r1));
        ly += lh;
      }
    }
    ry += rh;
  }
  if (s.buttons.len() > 0) {
    let bpx = dp(m, 14.0);
    let by = r1 + dp(m, 8.0);
    let bh = dp(m, 40.0);
    let bx = left + w - pad + dp(m, 12.0);
    let k = s.buttons.len() - 1;
    // With three buttons, the first is the neutral one, on the left.
    let neutral = s.buttons.len() == 3;
    while (k >= 0) {
      let b = s.buttons[k];
      let bw = face.width(f, face.MEDIUM, bpx, b.text) + dp(m, 24.0);
      let at = bx - bw;
      if (neutral && k == 0) {
        at = left + pad - dp(m, 12.0);
      }
      ns = ns.append(tap(node(at, by, bw, bh, scene.Blank), b.act));
      ns = ns.append(label(f, at + dp(m, 12.0), by + (bh - face.line(f, face.MEDIUM, bpx)) / 2, b.text, bpx, face.MEDIUM, m.pal.ink));
      bx = at - dp(m, 8.0);
      k -= 1;
    }
  }
  return ns;
}

// --- the pause before an app

function pause(m: Metrics, f: face.Fonts, p: Pause, blocked: boolean): scene.Node[] {
  let ns: scene.Node[] = [barrier(tap(fill(0, 0, m.w, m.h, night(), 0), "none"))];
  let tpx = dp(m, 34.0);
  let spx = dp(m, 18.0);
  let bpx = dp(m, 18.0);
  let circle = dp(m, 150.0);
  let bh = face.line(f, face.BOLD, bpx) + dp(m, 28.0);
  let sub_line = face.line(f, face.MEDIUM, spx);
  let buttons = bh;
  if (!blocked) {
    buttons = 2 * bh + dp(m, 12.0);
  }
  let total = circle + dp(m, 48.0) + face.line(f, face.EXTRABOLD, tpx) + dp(m, 12.0) + p.lines.len() * sub_line + dp(m, 56.0) + buttons;
  let y = m.top + (m.h - m.top - m.bottom - total) / 2;
  ns = ns.append(breath_node(m, (m.w - circle) / 2, y, circle, circle, p.breath));
  y = y + circle + dp(m, 48.0);
  let tw = face.width(f, face.EXTRABOLD, tpx, p.title);
  ns = ns.append(label(f, (m.w - tw) / 2, y, p.title, tpx, face.EXTRABOLD, cream()));
  y = y + face.line(f, face.EXTRABOLD, tpx) + dp(m, 12.0);
  for line in p.lines {
    let lw = face.width(f, face.MEDIUM, spx, line);
    ns = ns.append(label(f, (m.w - lw) / 2, y, line, spx, face.MEDIUM, draw.rgba(255, 244, 230, 204)));
    y += sub_line;
  }
  y += dp(m, 56.0);
  let bw = dp(m, 240.0);
  let bx = (m.w - bw) / 2;
  let ty = (bh - face.line(f, face.BOLD, bpx)) / 2;
  if (!blocked) {
    // The button of a pause that is not over shows at 45%.
    let fg = night();
    let bg = cream();
    if (!p.ready) {
      fg = draw.over(draw.rgba(23, 50, 58, 115), draw.over(draw.rgba(255, 244, 230, 115), night()));
      bg = draw.over(draw.rgba(255, 244, 230, 115), night());
    }
    ns = ns.append(tap(fill(bx, y, bw, bh, bg, bh / 2), "pause-open"));
    let text = face.fit(f, face.BOLD, bpx, p.open, bw - dp(m, 56.0));
    let ow = face.width(f, face.BOLD, bpx, text);
    ns = ns.append(label(f, bx + (bw - ow) / 2, y + ty, text, bpx, face.BOLD, fg));
    y = y + bh + dp(m, 12.0);
  }
  let cancel = "Not now";
  if (blocked) {
    cancel = "Back home";
  }
  ns = ns.append(tap(node(bx, y, bw, bh, scene.Outline(cream(), bh / 2, dp(m, 1.5))), "pause-cancel"));
  let cw = face.width(f, face.BOLD, bpx, cancel);
  ns = ns.append(label(f, bx + (bw - cw) / 2, y + ty, cancel, bpx, face.BOLD, cream()));
  return ns;
}

// --- the screen

// A message at the bottom of the screen, as Android's toast shows it.
function note(m: Metrics, f: face.Fonts, text: string): scene.Node[] {
  if (text.len() == 0) {
    return [];
  }
  let px = dp(m, 14.0);
  let shown = face.fit(f, face.REGULAR, px, text, m.w - dp(m, 96.0));
  let w = face.width(f, face.REGULAR, px, shown) + dp(m, 32.0);
  let h = face.line(f, face.REGULAR, px) + dp(m, 24.0);
  let y = m.h - m.bottom - dp(m, 64.0) - h;
  return [fill((m.w - w) / 2, y, w, h, draw.rgba(50, 50, 50, 235), h / 2), label(f, (m.w - w) / 2 + dp(m, 16.0), y + dp(m, 12.0), shown, px, face.REGULAR, draw.rgb(255, 255, 255))];
}

// Each screen in two parts: a base that changes seldom, which the app keeps
// as a layer and copies to each frame, and a top that it draws on each
// frame. The key names what the base shows, so a new key means a new base.
// The nodes of the screen, in the order they draw: the screen, the dialog
// over it, and the note over both.
pub function nodes(f: face.Fonts, v: View): scene.Node[] {
  let all = screen_nodes(f, v);
  if let Some(s) = v.sheet {
    all = cat(all, dialog(v.m, f, s));
  }
  return cat(all, note(v.m, f, v.note));
}

// The nodes of the screen of the layer of `v`. The breathing circle of the
// pause draws over the rest of the pause.
function screen_nodes(f: face.Fonts, v: View): scene.Node[] {
  let m = v.m;
  if (v.layer == PAUSE || v.layer == BLOCKED) {
    let still: scene.Node[] = [];
    let breath: scene.Node[] = [];
    for n in pause(m, f, v.pause, v.layer == BLOCKED) {
      if (scene.paint_key(n).starts_with("custom|breath|")) {
        breath = breath.append(n);
      } else {
        still = still.append(n);
      }
    }
    return cat(still, breath);
  }
  if (v.layer == DRAWER) {
    return cat(drawer_head(m, f, v), drawer_rows(m, f, v));
  }
  return cat(home_base(m, f, v), favourites(m, f, v));
}

// --- drawing

// The wallpaper drawn back over the box `n` of the frame, which is at wx
// and wy of a window of `win_h` rows: all of it at the edge of the list,
// and none of it at the other edge of the box. The wallpaper sits on the
// bottom edge of the window.
function paint_fade(fr: draw.Frame, n: scene.Node, wx: i32, wy: i32, wall: draw.Frame, win_h: i32, top: boolean, paper_color: i32): void {
  if (wall.width <= 0) {
    return;
  }
  let wall_top = win_h - wall.height;
  for row in 0..n.h {
    let part = row as f64 / (n.h as f64);
    if (!top) {
      part = 1.0 - part;
    }
    let a = ((1.0 - part) * 255.0) as i32;
    let iy = wy + row - wall_top;
    for col in 0..n.w {
      let color = paper_color;
      if (iy >= 0 && iy < wall.height && wx + col >= 0 && wx + col < wall.width) {
        color = wall.pixel(wx + col, iy);
      }
      fr.cover(n.x + col, n.y + row, color, a);
    }
  }
}

// Text with a soft shadow below it, at 67% black and 1 dp down: the blur of
// Android's text shadows of radius `blur`.
function paint_shadowed(own c: face.Cache, fr: draw.Frame, f: face.Fonts, n: scene.Node, s: string, px: i32, weight: i32, color: i32, blur: i32, d: f64): face.Cache {
  let r = (blur as f64 * 0.577 / 1.5 + 0.5) as i32;
  if (r < 1) {
    r = 1;
  }
  let base = n.y + (n.h - face.line(f, weight, px)) / 2 + face.ascent(f, weight, px);
  let (c1, sh) = face.shadow(c, f, weight, px, s, r);
  face.put(fr, sh, n.x, base + (d + 0.5) as i32, draw.rgba(0, 0, 0, 170));
  return face.text(c1, fr, f, weight, px, 0, n.x, base, s, color);
}

// A thick line from (x0, y0) to (x1, y1), as discs along it.
function stroke(fr: draw.Frame, x0: f64, y0: f64, x1: f64, y1: f64, r: f64, color: i32): void {
  let dx = x1 - x0;
  let dy = y1 - y0;
  let len = (dx * dx + dy * dy).sqrt();
  let steps = (len / 0.75) as i32 + 1;
  for i in 0..steps + 1 {
    let t = i as f64 / (steps as f64);
    disc(fr, x0 + dx * t, y0 + dy * t, r, color);
  }
}

// A disc with a smooth edge at a point between pixels.
function disc(fr: draw.Frame, cx: f64, cy: f64, r: f64, color: i32): void {
  let x0 = (cx - r - 1.0).floor() as i32;
  let x1 = (cx + r + 1.0).ceil() as i32;
  let y0 = (cy - r - 1.0).floor() as i32;
  let y1 = (cy + r + 1.0).ceil() as i32;
  for y in y0..y1 {
    for x in x0..x1 {
      let ddx = x as f64 + 0.5 - cx;
      let ddy = y as f64 + 0.5 - cy;
      let a = r + 0.5 - (ddx * ddx + ddy * ddy).sqrt();
      if (a >= 1.0) {
        fr.cover(x, y, color, 255);
      } else if (a > 0.0) {
        fr.cover(x, y, color, (a * 255.0) as i32);
      }
    }
  }
}

function paint_sky(fr: draw.Frame, n: scene.Node, sky: paper.Sky, ink: i32): void {
  let w = n.w as f64;
  let h = n.h as f64;
  let x = n.x as f64;
  let y = n.y as f64;
  match (sky) {
    paper.Clear => {
      sun(fr, x + w * 0.5, y + h * 0.5, h * 0.24, w * 0.08, ink);
    },
    paper.Partly => {
      sun(fr, x + w * 0.62, y + h * 0.32, w * 0.15, w * 0.08, ink);
      cloud(fr, x, y + h * 0.12, w, h * 0.88, ink);
    },
    paper.Fog => {
      for i in 0..3 {
        let ly = y + h * (0.3 + i as f64 * 0.22);
        stroke(fr, x + w * 0.12, ly, x + w * 0.88, ly, w * 0.04, ink);
      }
    },
    paper.Cloudy => {
      cloud(fr, x, y + h * 0.1, w, h * 0.9, ink);
    },
    paper.Snow => {
      cloud(fr, x, y, w, h * 0.72, ink);
      for i in 0..3 {
        disc(fr, x + w * (0.3 + i as f64 * 0.2), y + h * 0.86, w * 0.05, ink);
      }
    },
    _ => {
      cloud(fr, x, y, w, h * 0.72, ink);
      for i in 0..3 {
        let px = x + w * (0.3 + i as f64 * 0.2);
        stroke(fr, px, y + h * 0.8, px - w * 0.06, y + h * 0.96, w * 0.04, ink);
      }
    }
  }
}

function sun(fr: draw.Frame, cx: f64, cy: f64, r: f64, ray: f64, ink: i32): void {
  disc(fr, cx, cy, r, ink);
  for i in 0..8 {
    let a = 3.14159265 * (i as f64) / 4.0;
    stroke(fr, cx + a.cos() * r * 1.45, cy + a.sin() * r * 1.45, cx + a.cos() * r * 1.95, cy + a.sin() * r * 1.95, ray / 2.0, ink);
  }
}

// The cloud of Paper's weather icon: a pill with two circles on it, in a
// box of w by h at x and y.
function cloud(fr: draw.Frame, x: f64, y: f64, w: f64, h: f64, ink: i32): void {
  let base = y + h * 0.92;
  let bh = (base - y) * 0.42;
  disc(fr, x + w * 0.04 + bh / 2.0, base - bh / 2.0, bh / 2.0, ink);
  disc(fr, x + w * 0.96 - bh / 2.0, base - bh / 2.0, bh / 2.0, ink);
  fr.fill((x + w * 0.04 + bh / 2.0) as i32, (base - bh) as i32, (w * 0.92 - bh) as i32 + 1, bh as i32, ink);
  disc(fr, x + w * 0.33, base - bh * 0.95, w * 0.2, ink);
  disc(fr, x + w * 0.6, base - bh * 1.25, w * 0.27, ink);
}

// An arc of the circle at cx, cy of radius r, from angle a0 to a1 in
// degrees clockwise from the x axis, of half width `half`.
function arc(fr: draw.Frame, cx: f64, cy: f64, r: f64, a0: f64, a1: f64, half: f64, color: i32): void {
  let len = r * (a1 - a0) * 3.14159265 / 180.0;
  let steps = (len / 0.75) as i32 + 1;
  for i in 0..steps + 1 {
    let a = (a0 + (a1 - a0) * (i as f64) / (steps as f64)) * 3.14159265 / 180.0;
    disc(fr, cx + a.cos() * r, cy + a.sin() * r, half, color);
  }
}

// Today's temperature as a knob on the arc from the low to the high, with
// the temperature in the middle and the range in the gap at the bottom.
function paint_gauge(own c: face.Cache, fr: draw.Frame, f: face.Fonts, n: scene.Node, now: string, range: string, frac: f64, pal: Palette): face.Cache {
  let w = n.w as f64;
  let s = w * 0.06;
  let r = w / 2.0 - s;
  let cx = n.x as f64 + w / 2.0;
  let cy = n.y as f64 + r + s;
  arc(fr, cx, cy, r, 135.0, 405.0, s / 2.0, pal.ink);
  let big = (w * 0.42) as i32;
  let bw = face.width(f, face.EXTRABOLD, big, now);
  let cache = face.text(c, fr, f, face.EXTRABOLD, big, 0, (cx - bw as f64 / 2.0) as i32, (cy + big as f64 * 0.36) as i32, now, pal.ink);
  if (frac < 0.0) {
    return cache;
  }
  let t = frac;
  if (t > 1.0) {
    t = 1.0;
  }
  let a = (135.0 + 270.0 * t) * 3.14159265 / 180.0;
  let kx = cx + a.cos() * r;
  let ky = cy + a.sin() * r;
  disc(fr, kx, ky, s * 1.5, pal.paper);
  disc(fr, kx, ky, s * 0.85, pal.ink);
  let small = (w * 0.22) as i32;
  let rw = face.width(f, face.BOLD, small, range);
  return face.text(cache, fr, f, face.BOLD, small, 0, (cx - rw as f64 / 2.0) as i32, (cy + r + small as f64 * 0.35) as i32, range, pal.ink);
}

// A round ink button with three sound-wave arcs.
function paint_music(fr: draw.Frame, n: scene.Node, pal: Palette): void {
  let r = n.w as f64 / 2.0;
  let cx = n.x as f64 + r;
  let cy = n.y as f64 + n.h as f64 / 2.0;
  disc(fr, cx, cy, r, pal.ink);
  for i in 0..3 {
    let y = cy - r * 0.26 + i as f64 * r * 0.27;
    let half = r * (0.6 - i as f64 * 0.1);
    let width = r * (0.14 - i as f64 * 0.022);
    let x0 = cx - half;
    let y0 = y + r * 0.02;
    let y1 = y - r * 0.2;
    let x2 = cx + half;
    let y2 = y + r * 0.1;
    let steps = (half * 2.5) as i32 + 4;
    for k in 0..steps + 1 {
      let t = k as f64 / (steps as f64);
      let u = 1.0 - t;
      disc(fr, u * u * x0 + 2.0 * u * t * cx + t * t * x2, u * u * y0 + 2.0 * u * t * y1 + t * t * y2, width / 2.0, pal.paper);
    }
  }
}

// The yellow mountain line of the wallpaper, as a divider.
function paint_ridge(fr: draw.Frame, n: scene.Node, d: f64): void {
  let pts = [0.0, 0.7, 0.07, 0.55, 0.16, 0.62, 0.26, 0.42, 0.34, 0.08, 0.4, 0.3, 0.5, 0.38, 0.58, 0.6, 0.66, 0.92, 0.76, 0.88, 0.86, 0.7, 0.94, 0.4, 1.0, 0.3];
  let half = 1.25 * d;
  let w = n.w as f64;
  let h = n.h as f64 - 4.0 * half;
  let k = 0;
  while (k + 3 < pts.len()) {
    let x0 = n.x as f64 + pts[k] * w;
    let y0 = n.y as f64 + 2.0 * half + pts[k + 1] * h;
    let x1 = n.x as f64 + pts[k + 2] * w;
    let y1 = n.y as f64 + 2.0 * half + pts[k + 3] * h;
    stroke(fr, x0, y0, x1, y1, half, ridge());
    k += 2;
  }
}

// The breathing circle: a pale disc in a ridge-coloured ring, at `scale` of
// its full size.
function paint_breath(fr: draw.Frame, n: scene.Node, scale: f64, d: f64): void {
  let r = n.w as f64 / 2.0 * scale;
  let cx = n.x as f64 + n.w as f64 / 2.0;
  let cy = n.y as f64 + n.h as f64 / 2.0;
  disc(fr, cx, cy, r, draw.rgba(255, 244, 230, 34));
  arc(fr, cx, cy, r - d, 0.0, 360.0, d, ridge());
}

// A check box of Android's dialogs: a rounded square with a 2 dp border,
// filled with a tick when it is on.
function paint_check(fr: draw.Frame, n: scene.Node, on: boolean, d: f64, pal: Palette): void {
  let r = (2.0 * d) as i32;
  let b = (2.0 * d) as i32;
  if (on) {
    fr.round_rect(n.x, n.y, n.w, n.h, r, pal.ink);
    let x = n.x as f64;
    let y = n.y as f64;
    let w = n.w as f64;
    stroke(fr, x + w * 0.22, y + w * 0.52, x + w * 0.42, y + w * 0.72, d * 0.9, pal.dialog);
    stroke(fr, x + w * 0.42, y + w * 0.72, x + w * 0.8, y + w * 0.32, d * 0.9, pal.dialog);
  } else {
    fr.round_rect(n.x, n.y, n.w, n.h, r, pal.dialog_soft);
    fr.round_rect(n.x + b, n.y + b, n.w - 2 * b, n.h - 2 * b, 0, pal.dialog);
  }
}
