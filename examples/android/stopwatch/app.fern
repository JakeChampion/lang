// The Fern Stopwatch app: a NativeActivity with no Java code. control.fern
// holds its behaviour. This file gives it the device of the phone: the
// clocks, the files of the app, the window, the beeper and the system calls
// of the activity.
import "std/android";
import "std/android/audio";
import "std/android/draw";
import "std/log";
import "std/rand";
import "./control";
import "./stopwatch";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function mono_ms(): i64 {
  return monotonic_ns() / 1000000i64;
}

function read_text(path: string): string {
  if let Ok(b) = read_file_bytes(path) {
    return string_from_bytes_unchecked(b);
  }
  return "";
}

function write_text(path: string, text: string): void {
  let written = write_file(path, text);
}

function window_size(window: usize): (i32, i32) {
  let w = android.Window { ptr: window };
  return (w.width(), w.height());
}

function lock(window: usize): draw.Frame {
  let w = android.Window { ptr: window };
  return w.lock();
}

function open_tone(usage: i32): (usize, i32) {
  let tone = audio.playback_for(48000, usage);
  return (tone.ptr, tone.rate);
}

function play_tone(ptr: usize, rate: i32): void {
  let tone = audio.Stream { ptr: ptr, rate: rate };
  if (tone.start()) {
    let wrote = tone.write(stopwatch.beep_samples(rate), stopwatch.BEEP_MS * 2);
    tone.stop();
  }
}

function close_tone(ptr: usize): void {
  let tone = audio.Stream { ptr: ptr, rate: 0 };
  tone.stop();
  tone.close();
}

function device(ctx: usize): control.Device {
  return control.Device {
    mono_ms: (): i64 => mono_ms(),
    wall_ms: (): i64 => now_unix_ms(),
    utc_offset_ms: (unix_ms: i64): i32 => android.utc_offset_ms(ctx, unix_ms),
    read: (path: string): string => read_text(path),
    write: (path: string, text: string): void => write_text(path, text),
    size: (window: usize): (i32, i32) => window_size(window),
    lock: (window: usize): draw.Frame => lock(window),
    post: (f: draw.Frame): void => android.post(f),
    immersive: (on: boolean): void => android.immersive(ctx, on),
    keep_screen_on: (on: boolean): void => android.keep_screen_on(ctx, on),
    volume_stream: (stream: i32): void => android.volume_stream(ctx, stream),
    finish: (): void => android.finish(ctx),
    open_tone: (usage: i32): (usize, i32) => open_tone(usage),
    play_tone: (ptr: usize, rate: i32): void => play_tone(ptr, rate),
    close_tone: (ptr: usize): void => close_tone(ptr),
    random: (): i32 => rand.next_i32() & 2147483647,
  };
}

function app_main(ctx: usize): usize {
  let first = control.new(device(ctx), android.data_dir(ctx));
  let last = android.run(ctx, first, (own s: control.App, e: android.Event): control.App => control.step(s, e), (s: control.App): i32 => control.timeout(s, mono_ms()));
  log.info("stopwatch: destroyed");
  control.close(last);
  return 0 as usize;
}
