// The JNI methods of dev.fern.stopwatch.Core. Each one adapts JNI types to a
// function in stopwatch.fern: a jboolean is a u8, and a String result is a
// new Java string. build.sh writes Core.java from the @jni declarations.
import "std/jni";
import "./stopwatch";

function flag(b: u8): boolean {
  return b != 0;
}

function jbool(b: boolean): u8 {
  if (b) {
    return 1;
  }
  return 0;
}

@jni("dev.fern.stopwatch.Core", "static long elapsedMs(long, long, long)")
pub function elapsed_ms(env: usize, cls: usize, started_at: i64, anteriority: i64, now: i64): i64 {
  return stopwatch.elapsed_ms(started_at, anteriority, now);
}

@jni("dev.fern.stopwatch.Core", "static boolean isRunning(long)")
pub function is_running(env: usize, cls: usize, started_at: i64): u8 {
  return jbool(stopwatch.is_running(started_at));
}

@jni("dev.fern.stopwatch.Core", "static long start(long, long)")
pub function start(env: usize, cls: usize, started_at: i64, now: i64): i64 {
  return stopwatch.start(started_at, now);
}

@jni("dev.fern.stopwatch.Core", "static long pause(long, long, long)")
pub function pause(env: usize, cls: usize, started_at: i64, anteriority: i64, now: i64): i64 {
  return stopwatch.pause(started_at, anteriority, now);
}

@jni("dev.fern.stopwatch.Core", "static String stopwatchText(long, boolean)")
pub function stopwatch_text(env: usize, cls: usize, elapsed: i64, show_seconds: u8): usize {
  return jni.new_string(env, stopwatch.stopwatch_text(elapsed, flag(show_seconds)));
}

@jni("dev.fern.stopwatch.Core", "static String clockText(long)")
pub function clock_text(env: usize, cls: usize, local_ms: i64): usize {
  return jni.new_string(env, stopwatch.clock_text(local_ms));
}

@jni("dev.fern.stopwatch.Core", "static long stopwatchTickIn(long, boolean)")
pub function stopwatch_tick_in(env: usize, cls: usize, elapsed: i64, show_seconds: u8): i64 {
  return stopwatch.stopwatch_tick_in(elapsed, flag(show_seconds));
}

@jni("dev.fern.stopwatch.Core", "static long clockTickIn(long)")
pub function clock_tick_in(env: usize, cls: usize, local_ms: i64): i64 {
  return stopwatch.clock_tick_in(local_ms);
}

@jni("dev.fern.stopwatch.Core", "static int stopwatchColor(boolean, long, int)")
pub function stopwatch_color(env: usize, cls: usize, running: u8, elapsed: i64, opacity: i32): i32 {
  return stopwatch.stopwatch_color(flag(running), elapsed, opacity);
}

