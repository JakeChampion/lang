// The behaviour of the Fern Stopwatch app. Every function is pure: app.fern
// passes in the clock, the stored state and the settings, and shows what
// comes back.
import "std/f64";
import "../look";

// A stopwatch is two numbers. `started_at` is the wall-clock time of the
// current run, or 0 when paused. `anteriority` is the sum of all earlier runs.
pub function elapsed_ms(started_at: i64, anteriority: i64, now: i64): i64 {
  if (started_at == 0) {
    return anteriority;
  }
  return anteriority + nonneg(now - started_at);
}

pub function is_running(started_at: i64): boolean {
  return started_at != 0;
}

// The new `started_at` after a start. Starting a running stopwatch keeps it.
pub function start(started_at: i64, now: i64): i64 {
  if (started_at != 0) {
    return started_at;
  }
  return now;
}

// The new `anteriority` after a pause.
pub function pause(started_at: i64, anteriority: i64, now: i64): i64 {
  return elapsed_ms(started_at, anteriority, now);
}

// "1:02:03", or "1:02" when the seconds are hidden.
pub function stopwatch_text(elapsed: i64, show_seconds: boolean): string {
  let total_s = nonneg(elapsed) / 1000;
  let h = total_s / 3600;
  let m = total_s / 60 % 60;
  let text = h.to_string() + ":" + two_digits(m);
  if (show_seconds) {
    return text + ":" + two_digits(total_s % 60);
  }
  return text;
}

// "HH:MM" for a local time given as milliseconds since the epoch.
pub function clock_text(local_ms: i64): string {
  let minute_of_day = floor_mod(local_ms, 86400000) / 60000;
  return two_digits(minute_of_day / 60) + ":" + two_digits(minute_of_day % 60);
}

// Milliseconds until the stopwatch text next changes. The display updates
// once per second, or once per minute when the seconds are hidden. The extra
// 10 ms makes sure that the tick lands after the boundary, not before it.
pub function stopwatch_tick_in(elapsed: i64, show_seconds: boolean): i64 {
  if (show_seconds) {
    return 1010 - floor_mod(elapsed, 1000);
  }
  return 60010 - floor_mod(elapsed, 60000);
}

// Milliseconds until the clock text next changes.
pub function clock_tick_in(local_ms: i64): i64 {
  return 60010 - floor_mod(local_ms, 60000);
}

// The colour of the digits. They are red while the stopwatch is paused with
// time on it, and white otherwise.
pub function stopwatch_color(running: boolean, elapsed: i64): i32 {
  if (!running && elapsed > 0) {
    return look.red();
  }
  return look.ink();
}

// The words under the digits.
pub function status_text(running: boolean, elapsed: i64): string {
  if (running) {
    return "RUNNING";
  }
  if (elapsed > 0) {
    return "HOLD TO RESET";
  }
  return "TAP TO START";
}

// The ring around the digits has one dot for each second of the current
// minute, or for each minute of the current hour when the seconds are hidden.
pub const RING_DOTS: i32 = 60;

// The dot of the ring that the stopwatch is on.
pub function ring_position(elapsed: i64, show_seconds: boolean): i32 {
  let unit: i64 = 1000;
  if (!show_seconds) {
    unit = 60000;
  }
  return (nonneg(elapsed) / unit % (RING_DOTS as i64)) as i32;
}

// The colour of dot `k` of the ring. The dots that passed are white while the
// stopwatch runs and grey while it is paused. The current dot is red while it
// runs. The other dots are dim.
pub function ring_color(k: i32, elapsed: i64, show_seconds: boolean, running: boolean): i32 {
  let at = ring_position(elapsed, show_seconds);
  if (running && k == at) {
    return look.red();
  }
  if (k < at && running) {
    return look.ink();
  }
  if (k < at) {
    return look.muted();
  }
  return look.outline();
}

// A press on the stopwatch that lasts this long resets it.
pub const LONG_PRESS_MS: i64 = 500;

// The milliseconds of a beep, and its pitch in hertz.
pub const BEEP_MS: i32 = 200;

pub const BEEP_HZ: i32 = 880;

// The samples of one beep at `rate` samples a second: a sine at half of the
// full scale, which rises and falls over 10 ms at each end so that it does
// not click.
pub function beep_samples(rate: i32): i32[] {
  let n = rate * BEEP_MS / 1000;
  let edge = rate / 100;
  let out: i32[] = [];
  for k in 0..n {
    let gain: f64 = 1.0;
    if (k < edge) {
      gain = k as f64 / (edge as f64);
    } else if (n - k < edge) {
      gain = (n - k) as f64 / (edge as f64);
    }
    let a: f64 = 6.283185307179586 * (BEEP_HZ as f64) * (k as f64) / (rate as f64);
    out = out.append((16000.0 * gain * a.sin()) as i32);
  }
  return out;
}

// The screen keeps on while the stopwatch runs. With the stopwatch turned
// off the app is a bedside clock, so the screen keeps on all the time.
pub function keep_screen_on(running: boolean, stopwatch_enabled: boolean): boolean {
  return running || !stopwatch_enabled;
}

pub const BUTTONS_HIDE_DELAY_MS: i32 = 5000;

pub const BURN_IN_PERIOD_MS: i32 = 60000;

pub const BURN_IN_MAX: i32 = 10;

// How far the content moves from the centre of `panel` on one axis, in
// pixels. The content stays clear of a band of `reserved` pixels at each end.
// A `displacement` above 0 moves it by a random amount, up to
// displacement / BURN_IN_MAX of half the free space. `random` is any
// non-negative number.
pub function burn_in_offset(panel: i32, content: i32, reserved: i32, displacement: i32, random: i32): i32 {
  let space = panel - content - 2 * reserved;
  if (content <= 0 || space <= 0) {
    return 0;
  }
  let reach = clamp(displacement, 0, BURN_IN_MAX) * space / (2 * BURN_IN_MAX);
  if (reach == 0) {
    return 0;
  }
  return (nonneg(random as i64) % ((2 * reach + 1) as i64)) as i32 - reach;
}

// Milliseconds until the next beep, or -1 when the beeper is off. The beeper
// sounds at each whole multiple of the interval on the stopwatch.
pub function next_beep_in(elapsed: i64, interval_minutes: i32): i64 {
  if (interval_minutes <= 0) {
    return -1;
  }
  let period = interval_minutes as i64 * 60000;
  return period - floor_mod(elapsed, period);
}

// The stored values of the app are lines of "key=value", with an integer
// value. The value of `key` in `text`, or `fallback` when no line has it.
pub function stored(text: string, key: string, fallback: i64): i64 {
  for line in text.split("\n") {
    if (line.starts_with(key + "=")) {
      if let Some(v) = parse_i64(line.drop(key.len() + 1)) {
        return v;
      }
    }
  }
  return fallback;
}

// The text of a file of stored values.
pub function store(keys: string[], values: i64[]): string {
  let out = "";
  for k in 0..keys.len() {
    out = out + keys[k] + "=" + values[k].to_string() + "\n";
  }
  return out;
}

// The value of each setting in `text`, clamped to its range, or its default.
pub function load_settings(text: string): i32[] {
  let all = settings();
  let out: i32[] = [];
  for s in all {
    let v = stored(text, s.key, s.default as i64);
    if (v < s.min as i64) {
      v = s.min as i64;
    }
    if (v > s.max as i64) {
      v = s.max as i64;
    }
    out = out.append(v as i32);
  }
  return out;
}

pub function save_settings(values: i32[]): string {
  let keys: string[] = [];
  let vs: i64[] = [];
  let all = settings();
  for k in 0..all.len() {
    keys = keys.append(all[k].key);
    vs = vs.append(values[k] as i64);
  }
  return store(keys, vs);
}

// The value of setting `key` in `values`, or 0 when there is no such setting.
pub function value(values: i32[], key: string): i32 {
  let i = setting_index(key);
  if (i < 0 || i >= values.len()) {
    return 0;
  }
  return values[i];
}

pub function on(values: i32[], key: string): boolean {
  return value(values, key) != 0;
}

function parse_i64(s: string): Option[i64] {
  if (s.len() == 0) {
    return None;
  }
  let neg = s[0] as i32 == 45;
  let start = 0;
  if (neg) {
    start = 1;
  }
  if (start >= s.len()) {
    return None;
  }
  let v: i64 = 0;
  for k in start..s.len() {
    let c = s[k] as i32;
    if (c < 48 || c > 57) {
      return None;
    }
    v = v * 10 + (c - 48) as i64;
  }
  if (neg) {
    return Some(-v);
  }
  return Some(v);
}

pub function about_text(total_runtime_ms: i64): string {
  let hours = nonneg(total_runtime_ms) / 3600000;
  let unit = " hours";
  if (hours == 1) {
    unit = " hour";
  }
  return "Usage\nStart or pause: tap\nReset: long tap\nMenu: tap anywhere\n\nStats\nTotal runtime: " + hours.to_string() + unit + "\n\nThe logic of this app is written in Fern.";
}

// One row of the settings screen. A toggle stores 0 or 1. A slider stores a
// value from `min` to `max`.
pub struct Setting {
  key: string,
  section: string,
  title: string,
  summary: string,
  toggle: boolean,
  min: i32,
  max: i32,
  default: i32,
}

function toggle(key: string, section: string, title: string, summary: string, on: boolean): Setting {
  let d = 0;
  if (on) {
    d = 1;
  }
  return Setting { key: key, section: section, title: title, summary: summary, toggle: true, min: 0, max: 1, default: d };
}

function slider(key: string, section: string, title: string, summary: string, min: i32, max: i32, d: i32): Setting {
  return Setting { key: key, section: section, title: title, summary: summary, toggle: false, min: min, max: max, default: d };
}

// The settings, in the order that the settings screen shows them.
pub function settings(): Setting[] {
  return [
    toggle("clock_enabled", "Clock", "Show the clock", "", true),
    toggle("clock_thin", "Clock", "Thin font", "", true),
    slider("clock_opacity", "Clock", "Opacity", "", 1, 20, 13),
    slider("clock_size", "Clock", "Size", "", 40, 100, 60),
    toggle("stopwatch_enabled", "Stopwatch", "Show the stopwatch", "", true),
    toggle("stopwatch_seconds", "Stopwatch", "Show seconds", "", true),
    toggle("stopwatch_thin", "Stopwatch", "Thin font", "", true),
    slider("stopwatch_opacity", "Stopwatch", "Opacity", "", 1, 20, 13),
    slider("stopwatch_size", "Stopwatch", "Size", "", 40, 100, 60),
    slider("beep_interval", "Beeper", "Beep interval", "A beep at each multiple of this time on the stopwatch", 0, 120, 0),
    toggle("beep_override_silent", "Beeper", "Override silent mode", "Use the alarm volume, which sounds when the phone is silent", false),
    slider("burn_in", "Global", "Screen burn-in protection", "The content moves by this amount every minute", 0, BURN_IN_MAX, 0),
  ];
}

// The index of the setting with `key`, or -1.
pub function setting_index(key: string): i32 {
  let all = settings();
  let i = 0;
  while (i < all.len()) {
    if (all[i].key == key) {
      return i;
    }
    i += 1;
  }
  return -1;
}

// A value clamped to the range of setting `i`.
pub function setting_clamp(i: i32, value: i32): i32 {
  let s = settings()[i];
  return clamp(value, s.min, s.max);
}

// The label beside a slider.
pub function setting_value_text(i: i32, value: i32): string {
  let s = settings()[i];
  let v = clamp(value, s.min, s.max);
  if (s.key == "beep_interval") {
    if (v == 0) {
      return "Off";
    }
    return v.to_string() + " min";
  }
  if (s.key == "burn_in" && v == 0) {
    return "Off";
  }
  if (s.key == "clock_size" || s.key == "stopwatch_size") {
    return v.to_string() + " sp";
  }
  return v.to_string();
}

function two_digits(n: i64): string {
  if (n < 10) {
    return "0" + n.to_string();
  }
  return n.to_string();
}

function nonneg(n: i64): i64 {
  if (n < 0) {
    return 0;
  }
  return n;
}

function floor_mod(n: i64, d: i64): i64 {
  let r = n % d;
  if (r < 0) {
    return r + d;
  }
  return r;
}

function clamp(v: i32, lo: i32, hi: i32): i32 {
  if (v < lo) {
    return lo;
  }
  if (v > hi) {
    return hi;
  }
  return v;
}
