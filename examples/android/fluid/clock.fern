// The time of the simulation. Each frame, the simulation takes the time
// since the frame before it, so the fluid moves by the same amount in each
// frame of a display, at each refresh rate. It makes no Android call, so the
// host tests it.
import "std/f64";

// The longest step in seconds. A frame of a display of 60 Hz is one step,
// with room for a frame that comes a little late. A longer frame is two or
// more steps of the same size.
pub const MAX_STEP: f64 = 0.020833333333333332;

// The most steps of one frame. After a stall, the clock drops the time that
// these steps do not use.
pub const MAX_SUBSTEPS: i32 = 4;

// The longest frame in seconds. A longer time means that the app did not
// draw, and the fluid must not jump.
pub const MAX_FRAME_TIME: f64 = 0.1;

// `last_ns` is the time of the last frame.
pub struct Clock { last_ns: i64 }

pub function new(now_ns: i64): Clock {
  return Clock { last_ns: now_ns };
}

// The clock at the frame of `now_ns`, and the seconds since the frame
// before it, from 0 to MAX_FRAME_TIME.
pub function (c: Clock) frame(now_ns: i64): (Clock, f64) {
  let dt = ((now_ns - c.last_ns) as f64 / 1.0e9).clamp(0.0, MAX_FRAME_TIME);
  return (Clock { last_ns: now_ns }, dt);
}

// The number of steps for a frame of `frame_time` seconds, and the seconds
// of each step.
pub function steps(frame_time: f64): (i32, f64) {
  if (frame_time <= 0.0) {
    return (0, 0.0);
  }
  let n = (frame_time / MAX_STEP).ceil() as i32;
  if (n > MAX_SUBSTEPS) {
    return (MAX_SUBSTEPS, MAX_STEP);
  }
  return (n, frame_time / (n as f64));
}
