// A counter with no Java code of its own. NativeActivity loads this library
// and calls ANativeActivity_onCreate, and std/android/ui/app runs the
// program of counter.fern.
import "std/android";
import "std/android/ui/app";
import "std/log";
import "./counter";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last = app.run(ctx, counter.Model { count: 0 }, counter.program());
  log.info("counter: closed at " + last.count.to_string());
  return 0 as usize;
}
