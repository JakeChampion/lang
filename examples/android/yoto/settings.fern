import "std/android/ui";
import "std/i32";
import "std/json";
import "std/string";
import "./api";
import "./light_colour";

enum Kind { Text, ClockTime, Colour, Brightness, Limit, TimeoutChoice, Switch, ClockFormat, Shortcut, PlayerInfo }

pub enum AlarmEdit { Add, Remove(i32), Toggle(i32) }

struct Field { key: string, label: string, kind: Kind }

pub struct Choice { label: string, value: string }

function fields(): (string, Field[])[] {
  return [
    ("Player", [Field { key: "name", label: "Player name", kind: Text }]),
    ("Day mode", [
      Field { key: "dayTime", label: "Morning starts", kind: ClockTime },
      Field { key: "dayDisplayBrightness", label: "Day display brightness", kind: Brightness },
      Field { key: "ambientColour", label: "Morning light color", kind: Colour },
      Field { key: "maxVolumeLimit", label: "Day volume limit", kind: Limit },
    ]),
    ("Night mode", [
      Field { key: "nightTime", label: "Bedtime starts", kind: ClockTime },
      Field { key: "nightDisplayBrightness", label: "Night display brightness", kind: Brightness },
      Field { key: "nightAmbientColour", label: "Nightlight color", kind: Colour },
      Field { key: "nightMaxVolumeLimit", label: "Night volume limit", kind: Limit },
    ]),
    ("Display and power", [
      Field { key: "displayDimBrightness", label: "Dimmed display brightness", kind: Brightness },
      Field { key: "displayDimTimeout", label: "Dim display after", kind: TimeoutChoice },
      Field { key: "shutdownTimeout", label: "Power off after", kind: TimeoutChoice },
      Field { key: "hourFormat", label: "24-hour clock", kind: ClockFormat },
      Field { key: "clockFace", label: "Clock face", kind: PlayerInfo },
      Field { key: "locale", label: "Player language", kind: PlayerInfo },
    ]),
    ("Sound and Bluetooth", [
      Field { key: "headphonesVolumeLimited", label: "Limit headphone volume", kind: Switch },
      Field { key: "bluetoothEnabled", label: "Bluetooth speaker pairing", kind: Switch },
      Field { key: "btHeadphonesEnabled", label: "Allow Bluetooth headphones", kind: Switch },
      Field { key: "repeatAll", label: "Repeat all tracks", kind: Switch },
    ]),
    ("Right button shortcuts", [
      Field { key: "dayYotoDaily", label: "Day first press", kind: Shortcut },
      Field { key: "dayYotoRadio", label: "Day second press", kind: Shortcut },
      Field { key: "nightYotoDaily", label: "Night first press", kind: Shortcut },
      Field { key: "nightYotoRadio", label: "Night second press", kind: Shortcut },
    ]),
  ];
}

function field_for(key: string): Option[Field] {
  for section in fields() {
    for field in section.1 {
      if (field.key == key) {
        return Some(field);
      }
    }
  }
  return None;
}

pub function label(key: string): string {
  if let Some(field) = field_for(key) {
    return field.label;
  }
  return "";
}

pub function is_shortcut(key: string): boolean {
  if let Some(field) = field_for(key) {
    if let Shortcut = field.kind {
      return true;
    }
  }
  return false;
}

pub function light_key(key: string): boolean {
  return key == "ambientColour" || key == "nightAmbientColour";
}

pub function choices(key: string): Choice[] {
  if (key == "displayDimTimeout") {
    return [Choice { label: "1 minute", value: "60" }, Choice { label: "5 minutes", value: "300" }];
  }
  if (key == "shutdownTimeout") {
    return [Choice { label: "15 minutes", value: "900" }, Choice { label: "30 minutes", value: "1800" }, Choice { label: "1 hour", value: "3600" }];
  }
  if (is_shortcut(key)) {
    return [
      Choice { label: "Yoto Daily", value: "3nC80/daily/<yyyymmdd>" },
      Choice { label: "Yoto Radio", value: "3nC80/radio-day/01" },
      Choice { label: "Yoto Sleep Radio", value: "3nC80/radio-night/01" },
    ];
  }
  return [];
}

pub function shortcut_track(track: api.Track): boolean {
  return track.chapter_key.len() > 0 && !track.chapter_key.contains("/") && !track.track_key.contains("/");
}

pub function shortcut_value(card: api.Card, track: api.Track): string {
  return card.id + "/" + track.chapter_key + "/" + track.track_key;
}

pub function setting_value(config: api.PlayerConfig, draft: Map[string, string], key: string): string {
  if let Some(value) = draft.get(key) {
    return value;
  }
  return as_text(original(config, key).unwrap_or(json.JNull));
}

pub function choice_caption(key: string, value: string, cards: api.Card[]): string {
  for item in choices(key) {
    if (item.value == value) {
      return item.label;
    }
  }
  if (key == "clockFace" && value == "digital-sun") {
    return "Digital clock with sun and moon";
  }
  if (key == "locale") {
    match (value) {
      "en" => {
        return "English";
      },
      "fr" => {
        return "French";
      },
      "es" => {
        return "Spanish";
      },
      _ => {}
    }
  }
  if (is_shortcut(key)) {
    if (value.len() == 0) {
      return "No shortcut";
    }
    let parts = value.split("/");
    if (parts.len() == 3) {
      for card in cards {
        if (card.id == parts[0]) {
          for track in card.tracks {
            if (track.chapter_key == parts[1] && track.track_key == parts[2] && track.title != card.title) {
              return card.title + " · " + track.title;
            }
          }
          return card.title;
        }
      }
    }
    return "Custom shortcut";
  }
  if (key == "displayDimTimeout" || key == "shutdownTimeout") {
    if let Ok(seconds) = i32.parse_i32(value) {
      if (seconds > 0 && seconds % 3600 == 0) {
        return (seconds / 3600).to_string() + " hours";
      }
      if (seconds > 0 && seconds % 60 == 0) {
        return (seconds / 60).to_string() + " minutes";
      }
      return seconds.to_string() + " seconds";
    }
  }
  return "Current player setting";
}

function as_text(value: json.JsonValue): string {
  match (value) {
    json.JBool(on) => {
      return if (on) { "1" } else { "0" };
    },
    json.JString(text) | json.JNumber(text) => {
      return text;
    },
    _ => {
      return "";
    }
  }
}

function original(config: api.PlayerConfig, key: string): Option[json.JsonValue] {
  if (key == "name") {
    return Some(json.JString(config.name));
  }
  return json.get(config.values, key);
}

function clock_time(s: string): boolean {
  let parts = s.split(":");
  if (parts.len() != 2 || parts[0].len() != 2 || parts[1].len() != 2) {
    return false;
  }
  let h = i32.parse_i32(parts[0]).unwrap_or(-1);
  let m = i32.parse_i32(parts[1]).unwrap_or(-1);
  return h >= 0 && h < 24 && m >= 0 && m < 60;
}

function valid(field: Field, text: string): boolean {
  let n = i32.parse_i32(text).unwrap_or(-1);
  match (field.kind) {
    Text => {
      return text.len() > 0 && text.len() <= 80;
    },
    ClockTime => {
      return clock_time(text);
    },
    Colour => {
      return light_colour.parse(text).is_some();
    },
    Brightness => {
      return n >= 0 && n <= 100 || text == "auto" && field.key != "displayDimBrightness";
    },
    Limit => {
      return n >= 0 && n <= 16;
    },
    TimeoutChoice => {
      return choices(field.key).any((item: Choice): boolean => item.value == text);
    },
    Switch => {
      return text == "0" || text == "1";
    },
    ClockFormat => {
      return text == "12" || text == "24";
    },
    Shortcut => {
      let parts = text.split("/");
      return text.len() == 0 || parts.len() == 3 && parts[0].len() > 0 && parts[1].len() > 0;
    },
    PlayerInfo => {
      return false;
    }
  }
}

pub function changes(config: api.PlayerConfig, draft: Map[string, string]): Result[(string, json.JsonValue)[], string] {
  let out: (string, json.JsonValue)[] = [];
  for section in fields() {
    for field in section.1 {
      if let (Some(old), Some(raw)) = (original(config, field.key), draft.get(field.key)) {
        let text = raw.trim();
        if (text == as_text(old)) {
          continue;
        }
        if (!valid(field, text)) {
          return Err("Check " + field.label.to_lower() + ".");
        }
        let value = match (old) {
          json.JBool(_) => json.JBool(text == "1"),
          json.JNumber(_) => if (i32.parse_i32(text).is_ok()) { json.JNumber(i32.parse_i32(text).unwrap_or(0).to_string()) } else { json.JString(text) },
          _ => json.JString(text),
        };
        out = out.append((field.key, value));
      }
    }
  }
  if let (Some(old), Some(raw)) = (json.get_array(config.values, "alarms"), draft.get("alarms")) {
    if let Ok(json.JArray(next)) = json.parse(raw) {
      if (json.encode(json.JArray(old)) != json.encode(json.JArray(next))) {
        out = out.append(("alarms", json.JArray(next)));
      }
    }
  }
  return Ok(out);
}

function named_field[M](field: Field, caption: string, action: string, choose: (string) => M): ui.El[M] {
  let description: ui.El[M] = ui.column([ui.text[M](field.label), ui.text[M](caption).colored(ui.MUTED).clamped(2)]).wide().spaced(4.0);
  if let PlayerInfo = field.kind {
    return description;
  }
  return ui.row([description, ui.text_button("Choose", choose(field.key)).described(action)]).aligned(ui.CENTER).spaced(6.0);
}

function field_view[M](field: Field, value: string, edit: (string, string) => M): ui.El[M] {
  let label = field.label;
  let key = field.key;
  if let Switch | ClockFormat = field.kind {
    let yes = if let ClockFormat = field.kind { "24" } else { "1" };
    let no = if let ClockFormat = field.kind { "12" } else { "0" };
    let on = value == yes;
    return ui.row([ui.text[M](label).wide(), ui.toggle(on, label, edit(key, if (on) { no } else { yes }))]).aligned(ui.CENTER).height(48.0);
  }
  if let Brightness | Limit = field.kind {
    let max = if let Limit = field.kind { 16 } else { 100 };
    let at = i32.parse_i32(value).unwrap_or(max).min(max).max(0);
    let head: ui.El[M][] = [ui.text[M](label).wide(), ui.text[M](value).colored(ui.MUTED)];
    if ((key == "dayDisplayBrightness" || key == "nightDisplayBrightness") && value != "auto") {
      head = head.append(ui.text_button("Auto", edit(key, "auto")));
    }
    return ui.column([
      ui.row(head).aligned(ui.CENTER).spaced(6.0),
      ui.slider(at as f64 / (max as f64), (part: f64): M => edit(field.key, ((part * (max as f64) + 0.5) as i32).to_string())).described(field.label),
    ]).wide();
  }
  let hint = if let ClockTime = field.kind { "HH:MM" } else { label };
  let rows = [ui.text[M](label), ui.field[M]("config:" + key, value, hint).on_edit((text: string): M => edit(key, text))];
  if let ClockTime = field.kind {
    rows = rows.append(time_steps(label, value, (time: string): M => edit(key, time)));
  }
  return ui.column(rows).spaced(4.0).wide();
}

// The brightness setting `from` after `step` steps of 1 down to `target`
// percent. A display on "auto" starts from 100. A display at `target` or
// below stays as it is.
pub function dimmed(from: string, step: i32, target: i32): string {
  let start = i32.parse_i32(from).unwrap_or(100);
  if (start <= target) {
    return from;
  }
  return (start - step).max(target).to_string();
}

// The number of the steps of 1 from the brightness setting `from` down to
// `target` percent.
pub function dim_steps(from: string, target: i32): i32 {
  return (i32.parse_i32(from).unwrap_or(100) - target).max(0);
}

// The clock time `value`, as HH:MM, after `minutes` more minutes. The time
// stays in one day. A value that is not a time counts as 07:00.
pub function shifted_time(value: string, minutes: i32): string {
  let parts = value.trim().split(":");
  let at = 420;
  if (parts.len() == 2) {
    at = i32.parse_i32(parts[0]).unwrap_or(7) * 60 + i32.parse_i32(parts[1]).unwrap_or(0);
  }
  let total = ((at + minutes) % 1440 + 1440) % 1440;
  return (total / 60).to_string().pad_start(2, '0') + ":" + (total % 60).to_string().pad_start(2, '0');
}

// Buttons that move the clock time `value` by an hour or by 15 minutes.
pub function time_steps[M](label: string, value: string, set: (string) => M): ui.El[M] {
  let steps = [(-60, "−1 h"), (60, "+1 h"), (-15, "−15 min"), (15, "+15 min")];
  let buttons = steps.map((step: (i32, string)): ui.El[M] => ui.text_button(step.1, set(shifted_time(value, step.0))).described(label + " " + step.1));
  return ui.row(buttons).spaced(4.0).wrapped().wide();
}

function light_field[M](field: Field, value: string, choose: (string) => M): ui.El[M] {
  let row: ui.El[M][] = [ui.text[M](field.label).wide()];
  if let Some(colour) = light_colour.parse(value) {
    row = row.append(light_colour.swatch[M](colour).width(32.0).height(32.0));
  }
  return ui.row(row.append(ui.text_button("Choose", choose(field.key)).described("Choose " + field.label))).aligned(ui.CENTER).spaced(6.0);
}

pub function alarms(config: api.PlayerConfig, draft: Map[string, string]): Option[json.JsonValue[]] {
  if let Some(value) = draft.get("alarms") {
    if let Ok(json.JArray(items)) = json.parse(value) {
      return Some(items);
    }
  }
  return json.get_array(config.values, "alarms");
}

pub function alarm_change(config: api.PlayerConfig, draft: Map[string, string], edit: AlarmEdit): Result[Map[string, string], string] {
  let Some(items) = alarms(config, draft) else {
    return Err("Alarm settings are unavailable on this player.");
  };
  let next = items;
  match (edit) {
    Add => {
      let time = draft.get("alarm-time").unwrap_or("07:00").trim();
      let days = draft.get("alarm-days").unwrap_or("1111111").trim();
      let card = draft.get("alarm-card").unwrap_or("").trim();
      let volume = i32.parse_i32(draft.get("alarm-volume").unwrap_or("5")).unwrap_or(-1);
      if (items.len() == 10) {
        return Err("This player already has ten alarms.");
      }
      if (!clock_time(time) || !card.is_ascii_alphanumeric() || volume < 0 || volume > 8) {
        return Err("Enter a time, a card ID, and an alarm volume from 0 to 8.");
      }
      if (days.len() != 7 || days.replace("1", "").replace("0", "").len() > 0 || days == "0000000") {
        return Err("Select at least one day for the alarm.");
      }
      next = next.append(json.JString(days + "," + time + "," + card + ",,," + volume.to_string() + ",1"));
    },
    Remove(i) => {
      if (i >= 0 && i < next.len()) {
        next = next.take(i).concat(next.drop(i + 1));
      }
    },
    Toggle(i) => {
      if (i >= 0 && i < next.len()) {
        if let json.JString(wire) = next[i] {
          let parts = wire.split(",");
          if (parts.len() == 7) {
            let mark = if (parts[6] == "1") { "0" } else { "1" };
            next = next.with(i, json.JString(parts.with(6, mark).join(",")));
          }
        }
      }
    }
  }
  return Ok(draft.insert("alarms", json.encode(json.JArray(next))));
}

pub function controls[M](config: api.PlayerConfig, draft: Map[string, string], cards: api.Card[], edit: (string, string) => M, choose: (string) => M): ui.El[M][] {
  let out: ui.El[M][] = [];
  for section in fields() {
    let rows: ui.El[M][] = [];
    for field in section.1 {
      if let Some(raw) = original(config, field.key) {
        let value = draft.get(field.key).unwrap_or(as_text(raw));
        if let Colour = field.kind {
          rows = rows.append(light_field(field, value, choose));
        } else if let TimeoutChoice | Shortcut | PlayerInfo = field.kind {
          rows = rows.append(named_field(field, choice_caption(field.key, value, cards), "Choose " + field.label.to_lower(), choose));
        } else {
          rows = rows.append(field_view(field, value, edit));
        }
      }
    }
    if (rows.len() > 0) {
      out = out.append(ui.card([ui.text[M](section.0).sized(18.0).weighted(650)].concat(rows)).spaced(10.0).wide());
    }
  }
  if (config.timezone.len() > 0) {
    out = out.append(ui.text[M]("Time zone · " + config.timezone).colored(ui.MUTED));
  }
  if (config.version.len() > 0) {
    out = out.append(ui.text[M]("Yoto OS · " + config.version).colored(ui.MUTED));
  }
  return out;
}
