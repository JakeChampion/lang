import "std/android";
import "std/android/player";
import "std/string";
import "./api";

pub enum Phase { Idle, Loading, Preparing, Playing, Paused }

enum Action { Open, Start, Pause, Close, Seek(i64) }

pub struct State {
  revision: i64,
  card: string,
  title: string,
  queue: api.Stream[],
  at: i32,
  phase: Phase,
  note: string,
  media: Option[player.Player],
  action: Option[Action],
  resume_ms: i64,
}

pub struct Output {
  open: (string) => Option[player.Player],
  start: (player.Player) => boolean,
  pause: (player.Player) => boolean,
  close: (player.Player) => void,
  seek: (player.Player, i64) => boolean,
  position: (player.Player) => i64,
}

pub function empty(): State {
  return State { revision: 0i64, card: "", title: "", queue: [], at: 0, phase: Idle, note: "", media: None, action: None, resume_ms: 0i64 };
}

pub function stop(s: State): State {
  return State { ...empty(), revision: s.revision + 1i64, media: s.media, action: Some(Close) };
}

pub function loading(s: State, card: string, title: string, resume_ms: i64): State {
  return State { ...stop(s), card: card, title: title, phase: Loading, resume_ms: resume_ms };
}

function prepare(s: State, at: i32): State {
  if (at >= s.queue.len()) {
    return stop(s);
  }
  if (s.queue[at].url.len() == 0) {
    return State { ...stop(s), note: "Yoto did not provide playable audio for the next track." };
  }
  return State { ...s, at: at, phase: Preparing, action: Some(Open) };
}

pub function next(s: State): State {
  if (s.queue.len() > 0) {
    return prepare(s, s.at + 1);
  }
  return s;
}

pub function previous(s: State): State {
  if (s.queue.len() > 0) {
    return prepare(s, (s.at - 1).max(0));
  }
  return s;
}

pub function seek(s: State, ms: i64): State {
  if let Playing | Paused = s.phase {
    return State { ...s, action: Some(Seek(ms.max(0i64))) };
  }
  return s;
}

pub function received(s: State, revision: i64, result: Result[api.Stream[], api.Failure]): State {
  if (s.revision != revision) {
    return s;
  }
  match (result) {
    Ok(queue) => {
      return prepare(State { ...s, queue: queue }, 0);
    },
    Err(error) => {
      return State { ...stop(s), note: error.message };
    }
  }
}

pub function control(s: State, command: api.Command): State {
  match (command) {
    api.Pause => {
      if let Playing = s.phase {
        return State { ...s, action: Some(Pause) };
      }
    },
    api.Resume => {
      if let Paused = s.phase {
        return State { ...s, action: Some(Start) };
      }
    },
    api.Stop => {
      return stop(s);
    },
    _ => {}
  }
  return s;
}

pub function event(s: State, event: android.Event): State {
  let Some(media) = s.media else {
    return s;
  };
  if (!media.sent(event)) {
    return s;
  }
  match (player.event(event)) {
    Some(player.Prepared) => {
      if let Preparing = s.phase {
        return State { ...s, action: Some(Start) };
      }
    },
    Some(player.Completed) => {
      return next(s);
    },
    Some(player.Failed(_, _)) => {
      return unavailable(s);
    },
    Some(player.Seeked) => {
      return State { ...s, revision: s.revision + 1i64 };
    },
    _ => {}
  }
  return s;
}

pub function close(s: State, output: Output): void {
  if let Some(media) = s.media {
    output.close(media);
  }
}

function unavailable(s: State): State {
  let note = "Could not play this track on your phone. Check your connection and try again.";
  if (s.at < s.queue.len() && s.queue[s.at].url.starts_with("file://")) {
    note = "Could not open the saved audio. Remove the download and save it again while online.";
  }
  return State { ...stop(s), note: note };
}

pub function apply(s: State, output: Output): State {
  let Some(action) = s.action else {
    return s;
  };
  let next = State { ...s, action: None };
  match (action) {
    Close => {
      close(s, output);
      return State { ...next, media: None };
    },
    Open => {
      let media = output.open(s.queue[s.at].url);
      close(s, output);
      if (media.is_none()) {
        return State { ...unavailable(next), media: None, action: None };
      }
      return State { ...next, media: media };
    },
    Seek(ms) => {
      if let Some(media) = s.media {
        let located = output.seek(media, ms);
      }
      return next;
    },
    _ => {}
  }
  if let Some(media) = s.media {
    if let Start = action {
      if (s.resume_ms > 0i64) {
        let located = output.seek(media, s.resume_ms);
      }
      if (output.start(media)) {
        return State { ...next, phase: Playing, resume_ms: 0i64 };
      }
    } else if (output.pause(media)) {
      return State { ...next, phase: Paused };
    }
  }
  close(s, output);
  return State { ...unavailable(next), media: None, action: None };
}
