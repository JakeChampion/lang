import "std/android/download";
import "std/base64";
import "std/crypto";
import "std/i64";
import "std/json";
import "std/kv";
import "std/rand";
import "std/string";
import "./api";

pub struct Track { id: i64, name: string, title: string, chapter: string, key: string, art: string }

pub struct Entry { id: string, title: string, creator: string, tracks: Track[], ready: boolean, failed_at: i32, resume_from: i32, card: Option[api.Card] }

pub struct Catalog { dir: string, entries: Entry[], cleanup: i64[], note: string }

pub struct Output {
  start: (string, string, string) => i64,
  status: (i64) => i32,
  remove: (i64[]) => boolean,
  save: (Entry[], i64[]) => boolean,
}

enum Action { Check, Remove(string), HoldActive(string), Repair((string, i32)[]), Clear, Cancel }

struct Install { plan: api.DownloadPlan, entry: Entry, prefix: string }

pub struct State {
  catalog: Catalog,
  queue: api.Card[],
  held: api.Card[],
  fetching: Option[api.Card],
  installing: Option[Install],
  revision: i64,
  checked: i32,
  failed: i32,
  paused: boolean,
  note: string,
  action: Option[Action],
}

const PREFIX: string = "yoto-offline-";

const BATCH: i32 = 4;

const REMOVE_BATCH: i32 = 8;

pub function empty(catalog: Catalog): State {
  return State { catalog: catalog, queue: [], held: [], fetching: None, installing: None, revision: 0i64, checked: 0, failed: 0, paused: false, note: catalog.note, action: None };
}

function safe_name(name: string): boolean {
  if (!name.starts_with(PREFIX) || !name.ends_with(".audio") || name.len() > 96) {
    return false;
  }
  for c in name.bytes() {
    if (!c.is_ascii_alphanumeric() && c != 45u8 && c != 95u8 && c != 46u8) {
      return false;
    }
  }
  return true;
}

function decode_track(value: json.JsonValue): Option[Track] {
  let name = json.get_string(value, "name").unwrap_or("");
  let id = json.get_i64(value, "download").unwrap_or(-1i64);
  if (id < 0i64 || !safe_name(name)) {
    return None;
  }
  return Some(Track { id: id, name: name, title: json.get_string(value, "title").unwrap_or("Track"), chapter: json.get_string(value, "chapter").unwrap_or(""), key: json.get_string(value, "key").unwrap_or(""), art: json.get_string(value, "art").unwrap_or("") });
}

function decode_entry(value: json.JsonValue): Option[Entry] {
  let id = json.get_string(value, "id").unwrap_or("");
  let tracks: Track[] = [];
  for item in json.get_array(value, "tracks").unwrap_or([]) {
    let Some(track) = decode_track(item) else {
      return None;
    };
    tracks = tracks.append(track);
  }
  if (id.len() == 0 || tracks.len() == 0) {
    return None;
  }
  return Some(Entry { id: id, title: json.get_string(value, "title").unwrap_or("Untitled card"), creator: json.get_string(value, "creator").unwrap_or(""), tracks: tracks, ready: json.get_bool(value, "ready").unwrap_or(false), failed_at: json.get_i32(value, "failed").unwrap_or(-1), resume_from: json.get_i32(value, "resumeFrom").unwrap_or(-1), card: api.restore_card(json.get(value, "card").unwrap_or(json.JNull)) });
}

function encode_track(track: Track): json.JsonValue {
  return json.JObject(json.from([
    ("download", json.JNumber(track.id.to_string())), ("name", json.JString(track.name)),
    ("title", json.JString(track.title)), ("chapter", json.JString(track.chapter)), ("key", json.JString(track.key)),
    ("art", json.JString(track.art)),
  ]));
}

function encode_entry(entry: Entry): json.JsonValue {
  return json.JObject(json.from([
    ("id", json.JString(entry.id)), ("title", json.JString(entry.title)), ("creator", json.JString(entry.creator)),
    ("tracks", json.JArray(entry.tracks.map(encode_track))), ("ready", json.JBool(entry.ready)),
    ("failed", json.JNumber(entry.failed_at.to_string())), ("resumeFrom", json.JNumber(entry.resume_from.to_string())), ("card", entry.card.map(api.cached_card).unwrap_or(json.JNull)),
  ]));
}

pub function load(store_dir: string, media_dir: string): Catalog {
  let blank = Catalog { dir: media_dir, entries: [], cleanup: [], note: "" };
  if (store_dir.len() == 0 || media_dir.len() == 0) {
    return Catalog { ...blank, dir: "", note: "Download storage is unavailable." };
  }
  let Ok(store) = kv.open(store_dir + "/yoto-downloads") else {
    return Catalog { ...blank, note: "Could not read the saved downloads." };
  };
  let text = store.get("titles").unwrap_or("[]");
  let Ok(json.JArray(values)) = json.parse(text) else {
    return Catalog { ...blank, note: "Could not read the saved downloads." };
  };
  let entries: Entry[] = [];
  for value in values {
    if let Some(entry) = decode_entry(value) {
      entries = entries.append(entry);
    }
  }
  let cleanup: i64[] = [];
  let ids = json.parse(store.get("cleanup").unwrap_or("[]")).unwrap_or(json.JNull);
  if let json.JArray(items) = ids {
    for item in items {
      if let json.JNumber(raw) = item {
        let id = i64.parse_i64(raw).unwrap_or(-1i64);
        if (id >= 0i64) {
          cleanup = cleanup.append(id);
        }
      }
    }
  }
  return Catalog { ...blank, entries: entries, cleanup: cleanup };
}

pub function save(dir: string, entries: Entry[], cleanup: i64[]): boolean {
  if (dir.len() == 0) {
    return false;
  }
  let data = json.encode(json.JArray(entries.map(encode_entry)));
  let pending = json.encode(json.JArray(cleanup.map((id: i64): json.JsonValue => json.JNumber(id.to_string()))));
  return kv.empty(dir + "/yoto-downloads").set("titles", data).set("cleanup", pending).save().is_ok();
}

pub function card(entry: Entry): api.Card {
  if let Some(info) = entry.card {
    return info;
  }
  let tracks = entry.tracks.map((t: Track): api.Track => api.Track {
    title: t.title, chapter: "", chapter_key: t.chapter, track_key: t.key, search: t.title.to_lower(), art: t.art, chapter_art: "",
  });
  return api.Card {
    id: entry.id, title: entry.title, creator: entry.creator, cover: "", thumb: "", preview: "", kind: api.Standard, myo: false, club: false, sleep_sounds: false,
    last_played: 0i64, seconds: 0i64, bytes: 0i64, sort_title: entry.title.to_lower(), search: (entry.title + " " + entry.creator).to_lower(),
    tracks: tracks, indexed: true,
  };
}

pub function saved_cards(s: State): api.Card[] {
  return s.catalog.entries.filter((entry: Entry): boolean => entry.ready).map(card);
}

pub function picture(dir: string, address: string, online: boolean): u8[] {
  return picture_until(dir, address, online, -1);
}

pub function picture_until(dir: string, address: string, online: boolean, cancel: i32): u8[] {
  if (dir.len() == 0) {
    return if (online) { api.cover_bytes_until(address, cancel) } else { [] };
  }
  let key = base64.encode_url(crypto.sha256(address.bytes()));
  let path = dir + "/story-deck-art-" + key;
  if let Ok(data) = read_file_bytes(path) {
    if (data.len() > 0 && data.len() <= 2000000) {
      return data;
    }
  }
  if (!online) {
    return [];
  }
  let data = api.cover_bytes_until(address, cancel);
  if (data.len() > 0) {
    let temp = path + ".tmp";
    if (write_file_bytes(temp, data).is_ok()) {
      let moved = rename(temp, path);
    }
  }
  return data;
}

pub function saved(s: State, id: string): Option[Entry] {
  for entry in s.catalog.entries {
    if (entry.id == id && entry.ready) {
      return Some(entry);
    }
  }
  return None;
}

function active(s: State): Option[Entry] {
  for entry in s.catalog.entries {
    if (!entry.ready && entry.failed_at < 0) {
      return Some(entry);
    }
  }
  return None;
}

pub function busy(s: State): boolean {
  return s.fetching.is_some() || s.installing.is_some() || s.queue.len() > 0 || active(s).is_some();
}

pub function contains(s: State, id: string): boolean {
  if (s.catalog.entries.any((entry: Entry): boolean => entry.id == id)) {
    return true;
  }
  if let Some(card) = s.fetching {
    if (card.id == id) {
      return true;
    }
  }
  if let Some(install) = s.installing {
    if (install.plan.id == id) {
      return true;
    }
  }
  return s.queue.any((card: api.Card): boolean => card.id == id) || s.held.any((card: api.Card): boolean => card.id == id);
}

pub function enqueue(s: State, cards: api.Card[]): State {
  if (s.catalog.dir.len() == 0) {
    return State { ...s, note: "Download storage is unavailable." };
  }
  let next = if (busy(s)) { s } else { State { ...s, note: "", failed: 0 } };
  for card in cards {
    if (!contains(next, card.id)) {
      next = State { ...next, queue: next.queue.append(card) };
    }
  }
  return next;
}

pub function retry(s: State, id: string): State {
  if (s.held.any((card: api.Card): boolean => card.id == id)) {
    return s;
  }
  let entry = s.catalog.entries.find((entry: Entry): boolean => entry.id == id && entry.failed_at >= 0);
  if let Some(failed) = entry {
    if (!s.queue.any((item: api.Card): boolean => item.id == id) && !s.fetching.map((item: api.Card): boolean => item.id == id).unwrap_or(false)
      && !s.installing.map((item: Install): boolean => item.plan.id == id).unwrap_or(false)) {
      return State { ...s, queue: s.queue.append(card(failed)), note: "", paused: false };
    }
  }
  return s;
}

pub function current(s: State): Option[api.Card] {
  if let Some(card) = s.fetching {
    return Some(card);
  }
  if let Some(setup) = s.installing {
    return Some(card(setup.entry));
  }
  return active(s).map(card);
}

pub function label(s: State, id: string): string {
  if (s.held.any((item: api.Card): boolean => item.id == id)) {
    return "Paused";
  }
  if let Some(entry) = s.catalog.entries.find((item: Entry): boolean => item.id == id) {
    if (entry.ready) {
      return "Saved";
    }
    if (entry.failed_at >= 0) {
      return "Needs attention";
    }
  }
  if (current(s).map((item: api.Card): boolean => item.id == id).unwrap_or(false)) {
    return "Downloading";
  }
  return if (s.queue.any((item: api.Card): boolean => item.id == id)) { "Queued" } else { "" };
}

pub function hold(s: State, id: string): State {
  if let Some(item) = s.queue.find((item: api.Card): boolean => item.id == id) {
    return State { ...s, queue: s.queue.filter((item: api.Card): boolean => item.id != id), held: s.held.append(item) };
  }
  if let Some(item) = current(s) {
    if (item.id == id) {
      if (active(s).is_some() && s.installing.is_none() && s.fetching.is_none()) {
        return State { ...s, action: Some(HoldActive(id)), held: s.held.append(item) };
      }
      let stopped = remove(s, id);
      return State { ...stopped, held: stopped.held.append(item), checked: 0 };
    }
  }
  return s;
}

pub function restore_held(s: State, cards: api.Card[]): State {
  let next = State { ...s, held: cards };
  if let Some(entry) = active(next) {
    if (cards.any((card: api.Card): boolean => card.id == entry.id)) {
      next = State { ...next, action: Some(HoldActive(entry.id)) };
    }
  }
  return next;
}

pub function repair(s: State, items: (string, i32)[]): State {
  if (items.len() == 0) {
    return s;
  }
  return State { ...s, action: Some(Repair(items)) };
}

pub function resume_card(s: State, id: string): State {
  if let Some(item) = s.held.find((item: api.Card): boolean => item.id == id) {
    let ready = State { ...s, held: s.held.filter((item: api.Card): boolean => item.id != id) };
    if (s.catalog.entries.any((entry: Entry): boolean => entry.id == id && entry.failed_at >= 0)) {
      return retry(ready, id);
    }
    return enqueue(ready, [item]);
  }
  return s;
}

pub function move_first(s: State, id: string): State {
  if let Some(item) = s.queue.find((item: api.Card): boolean => item.id == id) {
    return State { ...s, queue: [item].concat(s.queue.filter((item: api.Card): boolean => item.id != id)) };
  }
  return s;
}

pub function pending(s: State): api.Card[] {
  if let Some(card) = s.fetching {
    return [card].concat(s.queue);
  }
  if let Some(setup) = s.installing {
    return [card(setup.entry)].concat(s.queue);
  }
  return s.queue;
}

pub function restore_pending(s: State, pending: api.Card[]): State {
  let next = s;
  for card in pending {
    if let Some(entry) = next.catalog.entries.find((item: Entry): boolean => item.id == card.id) {
      if (entry.failed_at >= 0) {
        next = retry(next, card.id);
      }
    } else {
      next = enqueue(next, [card]);
    }
  }
  return next;
}

pub function has_failed(s: State): boolean {
  return s.catalog.entries.any((item: Entry): boolean => item.failed_at >= 0 && !s.held.any((held: api.Card): boolean => held.id == item.id));
}

pub function retry_on_wifi(s: State): State {
  let next = resume(s);
  for entry in s.catalog.entries {
    if (entry.failed_at >= 0) {
      next = retry(next, entry.id);
    }
  }
  return next;
}

pub function next(s: State): Option[api.Card] {
  if (!s.paused && s.catalog.cleanup.len() == 0 && s.queue.len() > 0 && s.fetching.is_none() && s.installing.is_none() && active(s).is_none()) {
    return Some(s.queue[0]);
  }
  return None;
}

pub function fetching(s: State, card: api.Card): State {
  return State { ...s, queue: s.queue.drop(1), fetching: Some(card), revision: s.revision + 1i64 };
}

pub function received(s: State, revision: i64, result: Result[api.DownloadPlan, api.Failure]): State {
  let Some(card) = s.fetching else {
    return s;
  };
  if (s.revision != revision) {
    return s;
  }
  let next = State { ...s, fetching: None };
  match (result) {
    Ok(plan) => {
      let blank = Entry { id: plan.id, title: plan.title, creator: plan.creator, tracks: [], ready: false, failed_at: -1, resume_from: -1, card: plan.card };
      let entry = s.catalog.entries.find((entry: Entry): boolean => entry.id == plan.id && entry.failed_at >= 0).unwrap_or(blank);
      if (entry.resume_from >= 0) {
        let count = entry.resume_from.min(entry.tracks.len()).min(plan.tracks.len());
        let good = entry.tracks.take(count);
        for i in 0..good.len() {
          if (good[i].chapter != plan.tracks[i].chapter || good[i].key != plan.tracks[i].key) {
            return State { ...next, note: "The card changed. Remove this download and save the card again." };
          }
        }
        entry = Entry { ...blank, tracks: good };
      }
      let setup = Install { plan: plan, entry: entry, prefix: PREFIX + base64.encode_url(rand.bytes(12)) + "-" };
      return State { ...next, installing: Some(setup), action: Some(Check) };
    },
    Err(error) => {
      if (error.pause_index) {
        return State { ...next, paused: !error.expired, queue: [card].concat(next.queue), note: error.message };
      }
      return State { ...next, failed: next.failed + 1, note: card.title + " · " + error.message };
    }
  }
}

pub function check(s: State): State {
  if (s.action.is_none() && work_interval(s) >= 0) {
    return State { ...s, action: Some(Check) };
  }
  return s;
}

pub function clear(s: State): State {
  return State { ...s, queue: [], held: [], fetching: None, installing: None, paused: false, revision: s.revision + 1i64, action: Some(Clear) };
}

pub function cancel(s: State): State {
  return State { ...s, queue: [], held: [], fetching: None, installing: None, paused: false, revision: s.revision + 1i64, action: Some(Cancel) };
}

pub function resume(s: State): State {
  return State { ...s, paused: false, note: "" };
}

pub function work_interval(s: State): i32 {
  if (s.installing.is_some() || s.catalog.cleanup.len() > 0) {
    return 100;
  }
  if (active(s).is_some()) {
    return 750;
  }
  return -1;
}

pub function remove(s: State, id: string): State {
  let fetching = s.fetching.map((card: api.Card): boolean => card.id == id).unwrap_or(false);
  let installing = s.installing.map((item: Install): boolean => item.plan.id == id).unwrap_or(false);
  return State {
    ...s, action: Some(Remove(id)), queue: s.queue.filter((card: api.Card): boolean => card.id != id), held: s.held.filter((card: api.Card): boolean => card.id != id),
    fetching: if (fetching) { None } else { s.fetching }, revision: if (fetching) { s.revision + 1i64 } else { s.revision },
    installing: if (installing) { None } else { s.installing },
  };
}

function with_catalog(s: State, entries: Entry[], cleanup: i64[], output: Output): Result[State, string] {
  if (!output.save(entries, cleanup)) {
    return Err("Could not save the download list.");
  }
  return Ok(State { ...s, catalog: Catalog { ...s.catalog, entries: entries, cleanup: cleanup } });
}

pub function enrich(s: State, cards: api.Card[], output: Output): State {
  let entries: Entry[] = [];
  let changed = false;
  for entry in s.catalog.entries {
    if (entry.card.is_none()) {
      if let Some(info) = cards.find((card: api.Card): boolean => card.id == entry.id) {
        let saved = card(entry);
        let enriched = api.Card { ...info, tracks: if (info.indexed) { info.tracks } else { saved.tracks }, indexed: true };
        entries = entries.append(Entry { ...entry, card: Some(enriched) });
        changed = true;
        continue;
      }
    }
    entries = entries.append(entry);
  }
  if (changed) {
    return with_catalog(s, entries, s.catalog.cleanup, output).unwrap_or(s);
  }
  return s;
}

function replace_track(s: State, setup: Install, output: Output): State {
  let entry = setup.entry;
  let plan = setup.plan;
  let i = entry.failed_at;
  if (i >= entry.tracks.len() || plan.tracks.len() != entry.tracks.len()) {
    return State { ...s, installing: None, note: "The card changed. Remove this download and save the card again." };
  }
  for j in 0..entry.tracks.len() {
    if (plan.tracks[j].chapter != entry.tracks[j].chapter || plan.tracks[j].key != entry.tracks[j].key) {
      return State { ...s, installing: None, note: "The card changed. Remove this download and save the card again." };
    }
  }
  let track = plan.tracks[i];
  let previous = entry.tracks[i];
  let name = setup.prefix + i.to_string() + ".audio";
  let id = output.start(track.url, name, entry.title);
  if (id < 0i64) {
    return State { ...s, installing: None, note: "Android could not retry " + track.title + "." };
  }
  let fixed = Entry { ...entry, failed_at: -1, card: plan.card, tracks: entry.tracks.with(i, Track { ...previous, id: id, name: name, art: track.art }) };
  let entries = s.catalog.entries.map((item: Entry): Entry => if (item.id == entry.id) { fixed } else { item });
  match (with_catalog(s, entries, s.catalog.cleanup.append(previous.id), output)) {
    Ok(next) => {
      return State { ...next, checked: 0, installing: None };
    },
    Err(note) => {
      let removed = output.remove([id]);
      return State { ...s, installing: None, note: note };
    }
  }
}

function install(s: State, setup: Install, output: Output): State {
  if (setup.entry.failed_at >= 0) {
    return replace_track(s, setup, output);
  }
  let entry = setup.entry;
  let plan = setup.plan;
  let ids: i64[] = [];
  let first = entry.tracks.len();
  for i in first..(first + BATCH).min(plan.tracks.len()) {
    let track = plan.tracks[i];
    let name = setup.prefix + i.to_string() + ".audio";
    let id = output.start(track.url, name, entry.title);
    if (id < 0i64) {
      let removed = output.remove(ids);
      return State { ...s, installing: None, failed: s.failed + 1, note: "Android could not start the download for " + entry.title + "." };
    }
    ids = ids.append(id);
    entry = Entry { ...entry, tracks: entry.tracks.append(Track { id: id, name: name, title: track.title, chapter: track.chapter, key: track.key, art: track.art }) };
  }
  // Keep the Android IDs in the cleanup list until every track is queued.
  let pending = s.catalog.cleanup.concat(ids);
  let entries = s.catalog.entries;
  let installing = Some(Install { ...setup, entry: entry });
  if (entry.tracks.len() == plan.tracks.len()) {
    let committed: Map[i64, boolean] = map_new(entry.tracks.len());
    for track in entry.tracks {
      committed = committed.insert(track.id, true);
    }
    pending = pending.filter((download_id: i64): boolean => !committed.contains(download_id));
    entries = entries.filter((item: Entry): boolean => item.id != entry.id).append(entry);
    installing = None;
  }
  match (with_catalog(s, entries, pending, output)) {
    Ok(next) => {
      return State { ...next, installing: installing, checked: 0 };
    },
    Err(note) => {
      let removed = output.remove(ids);
      return State { ...s, installing: None, failed: s.failed + 1, note: note };
    }
  }
}

function removed(s: State, entries: Entry[], output: Output): State {
  if (entries.len() == 0) {
    return s;
  }
  let keep = s.catalog.entries.filter((entry: Entry): boolean => !entries.any((drop: Entry): boolean => drop.id == entry.id));
  let pending = s.catalog.cleanup;
  for entry in entries {
    pending = pending.concat(entry.tracks.map((track: Track): i64 => track.id));
  }
  match (with_catalog(s, keep, pending, output)) {
    Ok(next) => {
      return next;
    },
    Err(note) => {
      return State { ...s, note: note };
    }
  }
}

function held_active(s: State, id: string, output: Output): State {
  let Some(entry) = s.catalog.entries.find((item: Entry): boolean => item.id == id && !item.ready && item.failed_at < 0) else {
    return s;
  };
  let count = s.checked.min((entry.tracks.len() - 1).max(0));
  let paused = Entry { ...entry, failed_at: count, resume_from: count };
  let entries = s.catalog.entries.map((item: Entry): Entry => if (item.id == id) { paused } else { item });
  let cleanup = s.catalog.cleanup.concat(entry.tracks.drop(count).map((track: Track): i64 => track.id));
  match (with_catalog(s, entries, cleanup, output)) {
    Ok(next) => {
      return State { ...next, checked: 0, note: "" };
    },
    Err(note) => {
      return State { ...s, held: s.held.filter((item: api.Card): boolean => item.id != id), note: note };
    }
  }
}

function repair_ready(s: State, items: (string, i32)[], output: Output): State {
  let entries = s.catalog.entries;
  let repair_ids: string[] = [];
  for (id, index) in items {
    if let Some(at) = entries.position((entry: Entry): boolean => entry.id == id && entry.ready && index >= 0 && index < entry.tracks.len()) {
      entries = entries.with(at, Entry { ...entries[at], ready: false, failed_at: index });
      repair_ids = repair_ids.append(id);
    }
  }
  if (repair_ids.len() == 0) {
    return s;
  }
  let Ok(next) = with_catalog(s, entries, s.catalog.cleanup, output) else {
    return State { ...s, note: "Could not queue the missing audio." };
  };
  for id in repair_ids {
    next = retry(next, id);
  }
  return next;
}

function checked(s: State, output: Output): State {
  if let Some(setup) = s.installing {
    return install(s, setup, output);
  }
  let cleanup = s.catalog.cleanup;
  if (cleanup.len() > 0) {
    if (output.remove(cleanup.take(REMOVE_BATCH))) {
      return with_catalog(s, s.catalog.entries, cleanup.drop(REMOVE_BATCH), output).unwrap_or(s);
    }
    return s;
  }
  let Some(entry) = active(s) else {
    return s;
  };
  let n = s.checked;
  let limit = (n + BATCH).min(entry.tracks.len());
  for i in n..limit {
    let status = output.status(entry.tracks[i].id);
    if (status == download.FAILED || status == download.GONE) {
      let blocked = Entry { ...entry, failed_at: i };
      let entries = s.catalog.entries.map((item: Entry): Entry => if (item.id == entry.id) { blocked } else { item });
      let saved = with_catalog(s, entries, cleanup, output).unwrap_or(s);
      return State { ...saved, checked: 0, failed: s.failed + 1, note: "Could not download " + entry.tracks[i].title + "." };
    }
    if (status != download.DONE) {
      return State { ...s, checked: i };
    }
  }
  if (limit < entry.tracks.len()) {
    return State { ...s, checked: limit };
  }
  let ready = Entry { ...entry, ready: true };
  let entries = s.catalog.entries.map((e: Entry): Entry => if (e.id == entry.id) { ready } else { e });
  match (with_catalog(s, entries, cleanup, output)) {
    Ok(next) => {
      return State { ...next, checked: 0 };
    },
    Err(note) => {
      return State { ...s, note: note };
    }
  }
}

pub function apply(s: State, output: Output): State {
  let Some(action) = s.action else {
    return s;
  };
  let next = State { ...s, action: None };
  match (action) {
    Check => {
      return checked(next, output);
    },
    HoldActive(id) => {
      return held_active(next, id, output);
    },
    Repair(items) => {
      return repair_ready(next, items, output);
    },
    Remove(id) => {
      return removed(next, next.catalog.entries.filter((e: Entry): boolean => e.id == id), output);
    },
    Clear => {
      return removed(next, next.catalog.entries, output);
    },
    Cancel => {
      return removed(State { ...next, checked: 0, note: "Download canceled." }, next.catalog.entries.filter((e: Entry): boolean => !e.ready && e.failed_at < 0), output);
    }
  }
}

pub function message(s: State): string {
  if let Some(card) = s.fetching {
    return "Preparing " + card.title + "…";
  }
  if let Some(setup) = s.installing {
    return "Preparing " + setup.entry.title + " · " + setup.entry.tracks.len().to_string() + "/" + setup.plan.tracks.len().to_string() + " tracks";
  }
  if let Some(entry) = active(s) {
    return "Downloading " + entry.title + " · " + s.checked.to_string() + "/" + entry.tracks.len().to_string() + " tracks";
  }
  if (s.failed > 1) {
    return s.failed.to_string() + " downloads failed. " + s.note;
  }
  return s.note;
}

pub function playlist(s: State, entry: Entry, from: i32): api.Stream[] {
  let tracks: api.Stream[] = [];
  if (from < 0 || from >= entry.tracks.len() || s.catalog.dir.len() == 0) {
    return tracks;
  }
  for track in entry.tracks.drop(from) {
    tracks = tracks.append(api.Stream { title: track.title, url: "file://" + s.catalog.dir + "/" + track.name, chapter: track.chapter, key: track.key, art: track.art });
  }
  return tracks;
}
