import "std/fetch";
import "std/base64";
import "std/utf8";
import "std/http";
import "std/json";
import "std/time";
import "std/string";
import "std/url";
import "./oauth";

const API: string = "https://api.yotoplay.com";

pub struct Player { id: string, name: string, online: boolean }

pub struct DeviceStatus { volume: i32, battery: i32, free_bytes: i64, syncing: Option[boolean] }

pub function parse_device_status(value: json.JsonValue): DeviceStatus {
  let data = json.get_object(value, "status").unwrap_or(value);
  return DeviceStatus {
    volume: json.get_i32(data, "userVolumePercentage").unwrap_or(-1),
    battery: json.get_i32(data, "batteryLevelPercentage").unwrap_or(-1),
    free_bytes: json.get_i64(data, "freeDiskSpaceBytes").unwrap_or(-1i64),
    syncing: json.get_bool(data, "isBackgroundDownloadActive"),
  };
}

pub function device_status(token: string, id: string): Result[DeviceStatus, Failure] {
  let response = send(request(token, "GET", "/device-v2/" + url.encode(id) + "/status"))?;
  return Ok(parse_device_status(response));
}

pub struct PlayerConfig { name: string, values: json.JsonValue, timezone: string, version: string }

pub enum Kind { Standard, Myo, Podcast, Radio }

pub struct Track { title: string, chapter: string, chapter_key: string, track_key: string, search: string, art: string, chapter_art: string, seconds: i64 }

pub struct Stream { title: string, url: string, chapter: string, key: string, art: string }

pub struct DownloadTrack { title: string, chapter: string, key: string, url: string, art: string }

pub struct DownloadPlan { id: string, title: string, creator: string, tracks: DownloadTrack[], card: Option[Card] }

pub struct Card {
  id: string,
  title: string,
  creator: string,
  cover: string,
  thumb: string,
  preview: string,
  kind: Kind,
  myo: boolean,
  club: boolean,
  sleep_sounds: boolean,
  last_played: i64,
  seconds: i64,
  bytes: i64,
  sort_title: string,
  search: string,
  tracks: Track[],
  indexed: boolean,
}

pub struct Failure { message: string, expired: boolean, pause_index: boolean }

pub struct Tokens { access: string, refresh: string }

pub struct Session { client: string, refresh: string }

pub struct Group { id: string, name: string, cards: Map[string, boolean], members: string[], image: string }

pub struct Library { players: Player[], cards: Card[], groups: Result[Group[], Failure], note: string }

pub enum Command { Play(string), PlayTrack(string, string, string), PlayAt(string, string, string, i32), Pause, Resume, Stop, Volume(i32), DeviceSleep(i32) }

pub function failure(message: string): Failure {
  return Failure { message: message, expired: false, pause_index: false };
}

function response(req: fetch.Request, limit: i64): Result[HttpResponse, Failure] {
  let seconds = time.duration_seconds(limit);
  let opts = fetch.Timeouts { connect: seconds, inactivity: seconds, total: seconds };
  let Ok(resp) = fetch.send(req.with_redirects(0).with_timeouts(opts)) else {
    return Err(Failure { ...failure("Could not reach Yoto. Check your connection and try again."), pause_index: true });
  };
  return Ok(resp);
}

function send(req: fetch.Request): Result[json.JsonValue, Failure] {
  let resp = response(req, 10i64)?;
  if (resp.status == 401) {
    return Err(Failure { message: "Your Yoto session expired. Connect again.", expired: true, pause_index: true });
  }
  if (resp.status == 403) {
    return Err(failure("Yoto denied access. Check the permissions for this client."));
  }
  if (resp.status == 429) {
    return Err(Failure { ...failure("Yoto is limiting requests. Refresh the library later to retry."), pause_index: true });
  }
  if (resp.status == 204) {
    return Ok(json.JNull);
  }
  if (resp.status != 200 && resp.status != 201) {
    return Err(Failure { ...failure("Yoto returned HTTP " + resp.status.to_string() + "."), pause_index: resp.status >= 500 });
  }
  let Ok(value) = json.parse(resp.body_text_lossy()) else {
    return Err(failure("Yoto returned an invalid response."));
  };
  return Ok(value);
}

pub function token_reply(status: i32, value: json.JsonValue): Result[Tokens, Failure] {
  if (status != 200) {
    if ((status == 400 || status == 401 || status == 403) && json.get_string(value, "error").unwrap_or("") == "invalid_grant") {
      return Err(Failure { ...failure("Your Yoto sign-in expired. Connect again."), expired: true });
    }
    return Err(failure("Yoto could not complete sign-in (HTTP " + status.to_string() + "). Try again."));
  }
  let access = json.get_string(value, "access_token").unwrap_or("");
  if (access.len() == 0) {
    return Err(failure("Yoto did not return a session token."));
  }
  return Ok(Tokens { access: access, refresh: json.get_string(value, "refresh_token").unwrap_or("") });
}

function token_request(fields: (string, string)[]): Result[Tokens, Failure] {
  let req = fetch.request("POST", oauth.LOGIN + "/oauth/token").with_header("Content-Type", "application/x-www-form-urlencoded").with_text(url.query_encode(fields));
  let resp = response(req, 5i64)?;
  return token_reply(resp.status, json.parse(resp.body_text_lossy()).unwrap_or(json.JNull));
}

pub function exchange(client: string, verifier: string, code: string): Result[Tokens, Failure] {
  return token_request([
    ("grant_type", "authorization_code"),
    ("client_id", client),
    ("code_verifier", verifier),
    ("code", code),
    ("redirect_uri", oauth.REDIRECT),
  ]);
}

pub function renew(saved: Session): Result[Tokens, Failure] {
  return token_request([
    ("grant_type", "refresh_token"),
    ("client_id", saved.client),
    ("refresh_token", saved.refresh),
  ]);
}

function request(token: string, method: string, path: string): fetch.Request {
  return fetch.request(method, API + path).with_header("Authorization", "Bearer " + token);
}

pub function parse_players(value: json.JsonValue): Result[Player[], Failure] {
  let Some(items) = json.get_array(value, "devices") else {
    return Err(failure("Yoto did not return a player list."));
  };
  let out: Player[] = [];
  for item in items {
    let id = json.get_string(item, "deviceId").unwrap_or("");
    if (id.len() > 0) {
      let name = json.get_string(item, "name").unwrap_or("Yoto player");
      let online = json.get_bool(item, "online").unwrap_or(false);
      out = out.append(Player { id: id, name: name, online: online });
    }
  }
  return Ok(out);
}

function field(value: json.JsonValue, key: string): string {
  return json.get_string(value, key).unwrap_or("");
}

function object(value: json.JsonValue, key: string): json.JsonValue {
  return json.get_object(value, key).unwrap_or(json.JNull);
}

function entries(value: json.JsonValue, key: string): json.JsonValue[] {
  return json.get_array(value, key).unwrap_or([]);
}

function config_path(id: string): string {
  return "/device-v2/" + url.encode(id) + "/config";
}

pub function parse_config(value: json.JsonValue, player: Player): Result[PlayerConfig, Failure] {
  let device = object(value, "device");
  let Some(config) = json.get_object(device, "config") else {
    return Err(failure("Yoto did not return settings for this player."));
  };
  if (json.get_string(device, "deviceId").unwrap_or(player.id) != player.id) {
    return Err(failure("Yoto returned settings for a different player."));
  }
  return Ok(PlayerConfig { name: json.get_string(device, "name").unwrap_or(player.name), values: config, timezone: field(device, "geoTimezone"), version: field(device, "releaseChannelVersion") });
}

pub function player_config(token: string, player: Player): Result[PlayerConfig, Failure] {
  return parse_config(send(request(token, "GET", config_path(player.id)))?, player);
}

pub function merge_config(config: PlayerConfig, edits: (string, json.JsonValue)[]): PlayerConfig {
  let json.JObject(old) = config.values else {
    return config;
  };
  let pairs: (string, json.JsonValue)[] = [];
  for i in 0..old.names.len() {
    pairs = pairs.append((old.names[i], old.items[i]));
  }
  let name = config.name;
  for edit in edits {
    if (edit.0 == "name") {
      if let json.JString(changed) = edit.1 {
        name = changed;
      }
    } else {
      pairs = pairs.append(edit);
    }
  }
  return PlayerConfig { ...config, name: name, values: json.JObject(json.from(pairs)) };
}

pub function save_config(token: string, player: Player, original: PlayerConfig, edits: (string, json.JsonValue)[]): Result[PlayerConfig, Failure] {
  let current = player_config(token, player)?;
  for edit in edits {
    if (edit.0 == "alarms" && json.encode(json.get(current.values, "alarms").unwrap_or(json.JNull))
      != json.encode(json.get(original.values, "alarms").unwrap_or(json.JNull))) {
      return Err(failure("Alarms changed on another device. Reload the player settings."));
    }
  }
  return write_config(token, player, current, edits);
}

// Writes the settings `current` of `player` with `edits`, and reads nothing
// first. Use it for a series of writes, where each one starts from the
// settings that the write before it gave.
pub function write_config(token: string, player: Player, current: PlayerConfig, edits: (string, json.JsonValue)[]): Result[PlayerConfig, Failure] {
  let next = merge_config(current, edits);
  let fields = [("config", next.values)];
  if (edits.any((edit: (string, json.JsonValue)): boolean => edit.0 == "name")) {
    fields = fields.append(("name", json.JString(next.name)));
  }
  let body = json.JObject(json.from(fields));
  let reply = send(request(token, "PUT", config_path(player.id)).with_header("Content-Type", "application/json").with_text(json.encode(body)))?;
  if (field(reply, "status") != "ok") {
    return Err(failure("Yoto did not save the player settings."));
  }
  return Ok(next);
}

function kind(category: string, feed: string, myo: boolean): Kind {
  if (category == "radio" || category == "radio-station") {
    return Radio;
  }
  if (category.starts_with("podcast") || feed.len() > 0) {
    return Podcast;
  }
  if (myo) {
    return Myo;
  }
  return Standard;
}

function cover(card: json.JsonValue, metadata: json.JsonValue, content: json.JsonValue, sizes: string[]): string {
  for value in [metadata, content, card] {
    let image = object(value, "cover");
    for key in sizes {
      let link = field(image, key);
      if (link.starts_with("https://")) {
        return link;
      }
    }
  }
  return "";
}

function icon_url(value: string): string {
  if (value.starts_with("https://")) {
    return value;
  }
  if (value.starts_with("yoto:#") && value.len() == 49) {
    let id = value.drop(6);
    if (id.bytes().all((c: u8): boolean => c.is_ascii_alphanumeric() || c == 45u8 || c == 95u8)) {
      return "https://card-content.yotoplay.com/yoto/" + id;
    }
  }
  return "";
}

function artwork(item: json.JsonValue, fallback: string): string {
  let display = object(item, "display");
  for key in ["iconUrl16x16", "icon16x16"] {
    let address = icon_url(field(display, key));
    if (address.len() > 0) {
      return address;
    }
  }
  return fallback;
}

function default_track_art(chapter: json.JsonValue): string {
  let address = icon_url(field(chapter, "defaultTrackDisplay"));
  return if (address.len() > 0) { address } else { artwork(chapter, "") };
}

function tracks(chapters: json.JsonValue[]): Track[] {
  let out: Track[] = [];
  for c in chapters {
    let name = field(c, "title");
    let chapter_key = field(c, "key");
    let items = entries(c, "tracks");
    let chapter_art = artwork(c, "");
    let fallback = default_track_art(c);
    if (items.len() == 0 && name.len() > 0) {
      out = out.append(Track { title: name, chapter: "", chapter_key: chapter_key, track_key: "", search: name.to_lower(), art: chapter_art, chapter_art: chapter_art, seconds: json.get_f64(c, "duration").unwrap_or(0.0).max(0.0).round() as i64 });
    }
    for t in items {
      let title = json.get_string(t, "title").unwrap_or(name);
      let meta = object(t, "metadata");
      let search = [
        title, name, field(t, "description"), field(t, "artist"), field(t, "author"),
        field(t, "narrator"), field(meta, "description"), field(meta, "artist"), field(meta, "author"),
      ].join(" ").to_lower();
      let key = field(t, "key");
      let start = if (items.len() > 1 && key.len() == 0) { "" } else { chapter_key };
      out = out.append(Track { title: title, chapter: name, chapter_key: start, track_key: key, search: search, art: artwork(t, fallback), chapter_art: chapter_art, seconds: json.get_f64(t, "duration").unwrap_or(0.0).max(0.0).round() as i64 });
    }
  }
  return out;
}

function sleep_sound(value: json.JsonValue, meta: json.JsonValue, category: string): boolean {
  return category == "sleep-sounds"
    || entries(meta, "list").any((v: json.JsonValue): boolean => v == json.JString("sleep-sounds"))
    || entries(value, "tags").any((v: json.JsonValue): boolean => v == json.JString("sleepsounds"));
}

function club_card(value: json.JsonValue, entry: json.JsonValue): boolean {
  return entries(value, "clubAvailability").len() > 0
    || field(value, "availability") == "premium"
    || json.get_bool(object(entry, "ownership"), "isAccessibleUsingSubscription").unwrap_or(false);
}

function preview_address(meta: json.JsonValue): string {
  let address = field(meta, "audioPreviewUrl");
  return if (address.starts_with("https://")) { address } else { "" };
}

function card(value: json.JsonValue, entry: json.JsonValue, myo: boolean): Card {
  let meta = object(value, "metadata");
  let content = object(value, "content");
  let chapters = json.get_array(content, "chapters");
  let id = json.get_string(value, "cardId").unwrap_or(field(entry, "cardId"));
  let title = json.get_string(value, "title").unwrap_or("Untitled card");
  let creator = field(meta, "author");
  let category = field(meta, "category").to_lower();
  let search = [title, creator, category, field(meta, "description"), field(meta, "readBy"), field(meta, "seriestitle")].join(" ").to_lower();
  let played = time.timestamp_parse_rfc3339(field(entry, "lastPlayedAt")).map((at: time.Timestamp): i64 => at.unix_millis()).unwrap_or(0i64);
  let sort = field(value, "sortkey");
  let media = object(meta, "media");
  return Card {
    id: id, title: title, creator: creator, cover: cover(value, meta, content, ["imageL", "imageM", "imageS"]), thumb: cover(value, meta, content, ["imageM", "imageS"]), preview: preview_address(meta), kind: kind(category, field(meta, "feedUrl"), myo), myo: myo,
    club: club_card(value, entry), sleep_sounds: sleep_sound(value, meta, category), last_played: played,
    seconds: json.get_f64(media, "duration").unwrap_or(0.0).max(0.0).round() as i64, bytes: json.get_i64(media, "fileSize").unwrap_or(0i64),
    sort_title: (if (sort.len() > 0) { sort } else { title }).to_lower(), search: search, tracks: tracks(chapters.unwrap_or([])), indexed: chapters.is_some(),
  };
}

pub function cached_card(c: Card): json.JsonValue {
  let category = match (c.kind) {
    Podcast => "podcast",
    Radio => "radio",
    _ => "",
  };
  let items = c.tracks.map((t: Track): json.JsonValue => json.JObject(json.from([
    ("title", json.JString(t.title)), ("chapter", json.JString(t.chapter)), ("c", json.JString(t.chapter_key)), ("k", json.JString(t.track_key)),
    ("search", json.JString(t.search)), ("art", json.JString(t.art)), ("chapterArt", json.JString(t.chapter_art)), ("seconds", json.JNumber(t.seconds.to_string())),
  ])));
  return json.JObject(json.from([
    ("id", json.JString(c.id)), ("title", json.JString(c.title)), ("creator", json.JString(c.creator)), ("cover", json.JString(c.cover)), ("thumb", json.JString(c.thumb)),
    ("category", json.JString(category)), ("myo", json.JBool(c.myo)), ("club", json.JBool(c.club)), ("sleep", json.JBool(c.sleep_sounds)),
    ("played", json.JNumber(c.last_played.to_string())), ("seconds", json.JNumber(c.seconds.to_string())), ("bytes", json.JNumber(c.bytes.to_string())),
    ("sort", json.JString(c.sort_title)), ("search", json.JString(c.search)), ("tracks", json.JArray(items)), ("indexed", json.JBool(c.indexed)),
  ]));
}

pub function restore_card(value: json.JsonValue): Option[Card] {
  let id = field(value, "id");
  if (id.len() == 0) {
    return None;
  }
  let myo = json.get_bool(value, "myo").unwrap_or(false);
  let items = entries(value, "tracks").map((t: json.JsonValue): Track => Track {
    title: field(t, "title"), chapter: field(t, "chapter"), chapter_key: field(t, "c"), track_key: field(t, "k"),
    search: field(t, "search"), art: field(t, "art"), chapter_art: field(t, "chapterArt"), seconds: json.get_i64(t, "seconds").unwrap_or(0i64),
  });
  return Some(Card {
    id: id, title: field(value, "title"), creator: field(value, "creator"), cover: field(value, "cover"), thumb: field(value, "thumb"), preview: "", kind: kind(field(value, "category"), "", myo), myo: myo,
    club: json.get_bool(value, "club").unwrap_or(false), sleep_sounds: json.get_bool(value, "sleep").unwrap_or(false),
    last_played: json.get_i64(value, "played").unwrap_or(0i64), seconds: json.get_i64(value, "seconds").unwrap_or(0i64), bytes: json.get_i64(value, "bytes").unwrap_or(0i64),
    sort_title: field(value, "sort"), search: field(value, "search"), tracks: items, indexed: json.get_bool(value, "indexed").unwrap_or(true),
  });
}

pub function parse_cards(value: json.JsonValue, mine: boolean): Result[Card[], Failure] {
  let Some(items) = json.get_array(value, "cards") else {
    return Err(failure("Yoto did not return a card list."));
  };
  let out: Card[] = [];
  for entry in items {
    let value = json.get_object(entry, "card").unwrap_or(entry);
    if (json.get_bool(value, "deleted").unwrap_or(false) || !json.get_bool(entry, "inFamilyLibrary").unwrap_or(true)) {
      continue;
    }
    let myo = mine || field(entry, "reason") == "myo-content-add" || field(entry, "shareType") == "myo";
    let item = card(value, entry, myo);
    if (item.id.len() > 0) {
      out = out.append(Card { ...item, indexed: item.tracks.len() > 0 });
    }
  }
  return Ok(out);
}

pub function merge_cards(family: Card[], mine: Card[]): Card[] {
  let found: Map[string, boolean] = map_new(64);
  let out: Card[] = [];
  for c in family.concat(mine) {
    if (found.get(c.id).is_none()) {
      found = found.insert(c.id, true);
      out = out.append(c);
    }
  }
  return out;
}

function load_cards(token: string, path: string, mine: boolean): Result[Card[], Failure] {
  return parse_cards(send(request(token, "GET", path))?, mine);
}

pub function parse_groups(value: json.JsonValue): Result[Group[], Failure] {
  let json.JArray(items) = value else {
    return Err(failure("Yoto did not return a list of family groups."));
  };
  let groups: Group[] = [];
  for item in items {
    let id = field(item, "id");
    let name = field(item, "name");
    if (id.len() == 0 || name.len() == 0) {
      continue;
    }
    let cards: Map[string, boolean] = map_new(16);
    let members: string[] = [];
    for row in entries(item, "items") {
      let card = field(row, "contentId");
      if (card.len() > 0 && !cards.contains(card)) {
        cards = cards.insert(card, true);
        members = members.append(card);
      }
    }
    groups = groups.append(Group { id: id, name: name, cards: cards, members: members, image: field(item, "imageId") });
  }
  return Ok(groups);
}

pub function save_group(token: string, id: string, name: string, members: string[], image: string): Result[Group, Failure] {
  let entries = members.map((card: string): json.JsonValue => json.JObject(json.from([("contentId", json.JString(card))])));
  let fields = [
    ("name", json.JString(name)), ("items", json.JArray(entries)),
    ("imageId", json.JString(if (image.len() > 0) { image } else { "fp-cards" })),
  ];
  let base = "/card/family/library/groups";
  let req = if (id.len() > 0) { request(token, "PUT", base + "/" + url.encode(id)) } else { request(token, "POST", base) };
  let reply = send(req.with_header("Content-Type", "application/json").with_text(json.encode(json.JObject(json.from(fields)))))?;
  let groups = parse_groups(json.JArray([json.get_object(reply, "group").unwrap_or(reply)]))?;
  if (groups.len() == 0) {
    return Err(failure("Yoto did not return the saved group. Refresh the library."));
  }
  return Ok(groups[0]);
}

pub function delete_group(token: string, id: string): Result[void, Failure] {
  let reply = send(request(token, "DELETE", "/card/family/library/groups/" + url.encode(id)))?;
  return Ok(());
}

function library_groups(token: string): Result[Group[], Failure] {
  return parse_groups(send(request(token, "GET", "/card/family/library/groups"))?);
}

pub function library(token: string): Result[Library, Failure] {
  let players = parse_players(send(request(token, "GET", "/device-v2/devices/mine"))?)?;
  let family = load_cards(token, "/card/family/library", false);
  if let Err(err) = family {
    if (err.expired || err.pause_index) {
      return Err(err);
    }
  }
  let mine = load_cards(token, "/content/mine", true);
  let note = "";
  for result in [family, mine] {
    if let Err(err) = result {
      if (err.expired || err.pause_index) {
        return Err(err);
      }
      note = "Some cards are unavailable. " + err.message;
    }
  }
  return Ok(Library { players: players, cards: merge_cards(family.unwrap_or([]), mine.unwrap_or([])), groups: library_groups(token), note: note });
}

function request_card(token: string, summary: Card, query: string): Result[json.JsonValue, Failure] {
  let path = if (summary.myo) { "/content/" } else { "/card/" };
  return send(request(token, "GET", path + url.encode(summary.id) + query));
}

function card_reply(token: string, summary: Card, query: string): Result[json.JsonValue, Failure] {
  let response = request_card(token, summary, query)?;
  let Some(value) = json.get_object(response, "card") else {
    return Err(failure("Yoto did not return track information."));
  };
  return Ok(value);
}

pub function details(token: string, summary: Card): Result[Card, Failure] {
  let value = card_reply(token, summary, "")?;
  let item = card(value, json.JNull, summary.myo);
  if (!item.indexed) {
    return Err(failure("Yoto did not return track information."));
  }
  let art = if (summary.cover.len() > 0) { summary.cover } else { item.cover };
  let thumb = if (summary.thumb.len() > 0) { summary.thumb } else { item.thumb };
  let category = match (item.kind) {
    Podcast => Podcast,
    Radio => Radio,
    _ => summary.kind,
  };
  return Ok(Card { ...summary, cover: art, thumb: thumb, kind: category, club: summary.club || item.club, sleep_sounds: summary.sleep_sounds || item.sleep_sounds, search: summary.search + " " + item.search, tracks: item.tracks, indexed: true });
}

pub function parse_streams(value: json.JsonValue, chapter_key: string, track_key: string): Result[Stream[], Failure] {
  let out: Stream[] = [];
  let found = chapter_key.len() == 0;
  for chapter in entries(object(value, "content"), "chapters") {
    let key = field(chapter, "key");
    let fallback = default_track_art(chapter);
    for track in entries(chapter, "tracks") {
      if (!found && key == chapter_key && (track_key.len() == 0 || field(track, "key") == track_key)) {
        found = true;
      }
      if (found) {
        let address = field(track, "trackUrl");
        let link = if (address.starts_with("https://")) { address } else { "" };
        out = out.append(Stream { title: json.get_string(track, "title").unwrap_or(field(chapter, "title")), url: link, chapter: key, key: field(track, "key"), art: artwork(track, fallback) });
      }
    }
  }
  if (out.len() == 0 || out[0].url.len() == 0) {
    return Err(failure("Yoto did not provide playable audio for this selection."));
  }
  return Ok(out);
}

pub function streams(token: string, summary: Card, chapter: string, track: string): Result[Stream[], Failure] {
  let value = card_reply(token, summary, "?playable=true")?;
  return parse_streams(value, chapter, track);
}

pub function chapter_download_id(id: string, chapter: string): string {
  return "chapter:" + base64.encode_url((id + "\t" + chapter).bytes());
}

pub function download_selection(id: string): (string, string) {
  if (id.starts_with("chapter:")) {
    if let Ok(bytes) = base64.decode_url(id.drop(8)) {
      let parts = utf8.from_bytes_lossy(bytes).split("\t");
      if (parts.len() == 2 && parts[0].len() > 0 && parts[1].len() > 0) {
        return (parts[0], parts[1]);
      }
    }
  }
  return (id, "");
}

pub function chapter_download(summary: Card, key: string, title: string): Card {
  let tracks = summary.tracks.filter((track: Track): boolean => track.chapter_key == key);
  let seconds = 0i64;
  for track in tracks {
    seconds += track.seconds;
  }
  let label = summary.title + " · " + title;
  return Card { ...summary, id: chapter_download_id(summary.id, key), title: label, sort_title: label.to_lower(), seconds: seconds, bytes: 0i64, tracks: tracks };
}

pub function parse_download(reply: json.JsonValue, summary: Card): Result[DownloadPlan, Failure] {
  let Some(value) = json.get_object(reply, "card") else {
    return Err(failure("Yoto did not return downloadable card details."));
  };
  let (origin, section) = download_selection(summary.id);
  if (json.get_string(value, "cardId").unwrap_or(origin) != origin) {
    return Err(failure("Yoto returned audio for a different card."));
  }
  let access = object(reply, "ownership");
  if (!json.get_bool(access, "canAccess").unwrap_or(true) || json.get_bool(access, "previewAccessOnly").unwrap_or(false)
    || json.get_bool(access, "isAccessibleUsingSubscription").unwrap_or(false)) {
    return Err(failure("Yoto did not give offline access to the full card."));
  }
  let content = object(value, "content");
  let config = object(content, "config");
  let meta = object(value, "metadata");
  if (json.get_bool(config, "onlineOnly").unwrap_or(false)
    || json.get_bool(content, "restricted").unwrap_or(false) || json.get_bool(object(meta, "media"), "hasStreams").unwrap_or(false)) {
    return Err(failure("This title is unavailable for offline download."));
  }
  let out: DownloadTrack[] = [];
  for chapter in entries(content, "chapters") {
    if (section.len() > 0 && field(chapter, "key") != section) {
      continue;
    }
    let fallback = default_track_art(chapter);
    for track in entries(chapter, "tracks") {
      let address = field(track, "trackUrl");
      if (field(track, "type") != "audio" || !address.starts_with("https://")) {
        return Err(failure("Yoto did not provide downloadable audio for every track."));
      }
      out = out.append(DownloadTrack { title: json.get_string(track, "title").unwrap_or(field(chapter, "title")), chapter: field(chapter, "key"), key: field(track, "key"), url: address, art: artwork(track, fallback) });
    }
  }
  if (out.len() == 0) {
    return Err(failure("Yoto did not provide downloadable audio for this title."));
  }
  let info = card(value, json.JNull, summary.myo);
  let metadata = Card {
    ...summary, indexed: true, tracks: if (section.len() == 0) {
      info.tracks
    } else { info.tracks.filter((track: Track): boolean => track.chapter_key == section) },
    seconds: if (section.len() == 0) { info.seconds.max(summary.seconds) } else { summary.seconds }, bytes: if (section.len() == 0) { info.bytes.max(summary.bytes) } else { 0i64 }, cover: if (summary.cover.len() > 0) { summary.cover } else { info.cover },
  };
  return Ok(DownloadPlan { id: summary.id, title: summary.title, creator: summary.creator, tracks: out, card: Some(metadata) });
}

pub function download_plan(token: string, summary: Card): Result[DownloadPlan, Failure] {
  let (origin, _) = download_selection(summary.id);
  let value = request_card(token, Card { ...summary, id: origin }, "?playable=true")?;
  return parse_download(value, summary);
}

pub function cover_bytes(address: string): u8[] {
  return cover_bytes_until(address, -1);
}

pub function cover_bytes_until(address: string, cancel: i32): u8[] {
  if (!address.starts_with("https://")) {
    return [];
  }
  let seconds = time.duration_seconds(6i64);
  let opts = fetch.Timeouts { connect: seconds, inactivity: seconds, total: seconds };
  let cap = http.HttpLimits { ...http.limits(), body: 2000000 };
  let req = fetch.get(address).with_limits(cap).with_timeouts(opts).with_redirects(2);
  let response = if (cancel >= 0) { fetch.send_public_until(req, cancel) } else { fetch.send_public(req) };
  if let Ok(resp) = response {
    if (resp.status == 200) {
      return resp.body_bytes();
    }
  }
  return [];
}

pub function command_name(c: Command): string {
  match (c) {
    Play(_) | PlayTrack(_, _, _) | PlayAt(_, _, _, _) => {
      return "card/start";
    },
    Pause => {
      return "card/pause";
    },
    Resume => {
      return "card/resume";
    },
    Volume(_) => {
      return "volume/set";
    },
    DeviceSleep(_) => {
      return "sleep-timer/set";
    },
    Stop => {
      return "card/stop";
    }
  }
}

pub function command_body(c: Command): string {
  if let Volume(value) = c {
    return "{\"volume\":" + value.max(0).min(100).to_string() + "}";
  }
  if let DeviceSleep(seconds) = c {
    return "{\"seconds\":" + seconds.max(0).to_string() + "}";
  }
  if let Play(id) = c {
    return "{\"uri\":" + json.encode(json.JString("https://yoto.io/" + url.encode(id))) + "}";
  }
  if let PlayAt(id, chapter, track, seconds) = c {
    let fields = [
      ("uri", json.JString("https://yoto.io/" + url.encode(id))), ("chapterKey", json.JString(chapter)),
      ("trackKey", json.JString(track)), ("secondsIn", json.JNumber(seconds.max(0).to_string())),
    ];
    return json.encode(json.JObject(json.from(fields)));
  }
  if let PlayTrack(id, chapter, track) = c {
    let fields = [("uri", json.JString("https://yoto.io/" + url.encode(id))), ("chapterKey", json.JString(chapter))];
    if (track.len() > 0) {
      fields = fields.append(("trackKey", json.JString(track)));
    }
    return json.encode(json.JObject(json.from(fields)));
  }
  return "{}";
}

pub function send_command(token: string, player: string, c: Command): Result[void, Failure] {
  let path = "/device-v2/" + url.encode(player) + "/command/" + command_name(c);
  let req = request(token, "POST", path).with_header("Content-Type", "application/json").with_text(command_body(c));
  let response = send(req)?;
  if (json.get_string(response, "status").unwrap_or("") != "ok") {
    return Err(failure("Yoto did not accept the playback request."));
  }
  return Ok(());
}

pub const MAX_CHAPTER_BYTES: i64 = 100000000i64;

pub const MAX_PLAYLIST_CHAPTERS: i32 = 100;

pub struct LocalAudio { path: string, title: string, mime: string, temporary: boolean }

pub struct Chapter { title: string, prior: json.JsonValue, audio: Option[LocalAudio] }

pub struct Playlist {
  id: string,
  title: string,
  cover: string,
  prior: json.JsonValue,
  chapters: Chapter[],
}

pub function empty_playlist(): Playlist {
  return Playlist { id: "", title: "", cover: "", prior: json.JNull, chapters: [] };
}

pub function edit_playlist(token: string, summary: Card): Result[Playlist, Failure] {
  let value = card_reply(token, summary, "")?;
  let parts = entries(object(value, "content"), "chapters");
  let chapters = parts.map((part: json.JsonValue): Chapter => Chapter { title: field(part, "title"), prior: part, audio: None });
  return Ok(Playlist { id: summary.id, title: summary.title, cover: summary.cover, prior: value, chapters: chapters });
}

function myo_transcode(token: string, upload: string): Result[json.JsonValue, Failure] {
  let path = "/media/upload/" + url.encode(upload) + "/transcoded?loudnorm=false";
  for i in 0..75 {
    let response = response(request(token, "GET", path), 10i64)?;
    if (response.status == 401 || response.status == 403) {
      return Err(failure("Yoto did not give access to upload audio. Check the content permission."));
    }
    if (response.status == 200) {
      let value = json.parse(response.body_text_lossy()).unwrap_or(json.JNull);
      let media = object(value, "transcode");
      if (field(media, "transcodedSha256").len() > 0) {
        return Ok(media);
      }
    }
    sleep_ms(1000i64);
  }
  return Err(failure("Yoto has not finished converting the audio. Try again later."));
}

function uploaded_audio(token: string, audio: LocalAudio): Result[json.JsonValue, Failure] {
  let Ok(info) = stat(audio.path) else {
    return Err(failure("Could not read " + audio.title + "."));
  };
  if (info.size <= 0i64 || info.size > MAX_CHAPTER_BYTES) {
    return Err(failure("Each audio track must be between 1 byte and 100 MB."));
  }
  let Ok(data) = read_file_bytes(audio.path) else {
    return Err(failure("Could not open " + audio.title + ". Add the audio to the playlist again."));
  };
  let reply = send(request(token, "GET", "/media/transcode/audio/uploadUrl"))?;
  let upload = object(reply, "upload");
  let address = field(upload, "uploadUrl");
  let id = field(upload, "uploadId");
  if (!address.starts_with("https://") || id.len() == 0) {
    return Err(failure("Yoto did not provide an upload address."));
  }
  let limit = time.duration_seconds(180i64);
  let opts = fetch.Timeouts { connect: time.duration_seconds(15i64), inactivity: time.duration_seconds(30i64), total: limit };
  let req = fetch.request("PUT", address).with_bytes(data).with_header("Content-Type", audio.mime).with_timeouts(opts).with_redirects(0);
  let Ok(sent) = fetch.send_public(req) else {
    return Err(failure("Could not upload " + audio.title + "."));
  };
  if (sent.status < 200 || sent.status >= 300) {
    return Err(failure("Yoto could not accept " + audio.title + "."));
  }
  return myo_transcode(token, id);
}

function replace_fields(before: json.JsonValue, edits: (string, json.JsonValue)[]): json.JsonValue {
  let old = if let json.JObject(value) = before { value } else { json.from([]) };
  for (name, value) in edits {
    old = old.insert(name, value);
  }
  return json.JObject(old);
}

function playlist_chapter(token: string, part: Chapter, index: i32): Result[json.JsonValue, Failure] {
  let Some(audio) = part.audio else {
    return Ok(replace_fields(part.prior, [("title", json.JString(part.title))]));
  };
  let converted = uploaded_audio(token, audio)?;
  let media = object(converted, "transcodedInfo");
  let hash = field(converted, "transcodedSha256");
  let key = "new" + index.to_string();
  let title = json.JString(part.title);
  let track: (string, json.JsonValue)[] = [
    ("key", json.JString("01")), ("title", title), ("trackUrl", json.JString("yoto:#" + hash)), ("type", json.JString("audio")),
  ];
  for name in ["duration", "fileSize", "channels", "format"] {
    if let Some(value) = json.get(media, name) {
      track = track.append((name, value));
    }
  }
  let icon = json.JObject(json.from([("icon16x16", json.JString("yoto:#aUm9i3ex3qqAMYBv-i-O-pYMKuMJGICtR3Vhf289u2Q"))]));
  return Ok(json.JObject(json.from([
    ("key", json.JString(key)), ("title", title), ("display", icon), ("tracks", json.JArray([json.JObject(json.from(track))])),
  ])));
}

pub function save_playlist(token: string, draft: Playlist): Result[string, Failure] {
  let chapters: json.JsonValue[] = [];
  for i in 0..draft.chapters.len() {
    chapters = chapters.append(playlist_chapter(token, draft.chapters[i], i)?);
  }
  let previous = object(draft.prior, "content");
  let content = replace_fields(previous, [("chapters", json.JArray(chapters))]);
  let metadata = replace_fields(object(draft.prior, "metadata"), []);
  if (draft.cover.starts_with("https://")) {
    let picture = json.JObject(json.from([("imageL", json.JString(draft.cover))]));
    metadata = replace_fields(metadata, [("cover", picture)]);
  }
  let fields = [("title", json.JString(draft.title)), ("content", content), ("metadata", metadata)];
  if (draft.id.len() > 0) {
    fields = fields.append(("cardId", json.JString(draft.id)));
  }
  let reply = send(request(token, "POST", "/content").with_header("Content-Type", "application/json").with_text(json.encode(json.JObject(json.from(fields)))))?;
  let saved = field(object(reply, "card"), "cardId");
  let id = if (saved.len() > 0) { saved } else { field(reply, "cardId") };
  return Ok(id);
}

pub function scan_code(address: string): string {
  let clean = address.trim();
  let domain = "https://yoto.io/";
  let suffix = if (clean.starts_with(domain)) { clean.drop(domain.len()).split("?")[0].split("#")[0] } else { clean.to_owned() };
  let code = if (suffix.starts_with("c/")) { suffix.drop(2) } else { suffix };
  if (code.len() < 5 || code.len() > 48 || !code.contains_only("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-")) {
    return "";
  }
  return code;
}

pub function lookup_card(token: string, id: string): Result[Card, Failure] {
  let reply = send(request(token, "GET", "/card/" + url.encode(id)))?;
  let Some(value) = json.get_object(reply, "card") else {
    return Err(failure("Yoto did not return a card for this code."));
  };
  let result = card(value, reply, false);
  if (result.id.len() == 0) {
    return Err(failure("Yoto did not return a card ID."));
  }
  return Ok(result);
}

pub struct ShopTitle { title: string, address: string }

pub function parse_shop_titles(value: json.JsonValue): ShopTitle[] {
  let cards: ShopTitle[] = [];
  for item in entries(value, "products") {
    let category = field(item, "product_type");
    let handle = field(item, "handle");
    let title = field(item, "title");
    if ((category == "single-card" || category == "content-bundle") && title.len() > 0 && handle.len() > 0
      && handle.contains_only("abcdefghijklmnopqrstuvwxyz0123456789-")) {
      cards = cards.append(ShopTitle { title: title, address: "https://uk.yotoplay.com/products/" + handle });
    }
  }
  return cards;
}

pub function shop_titles(): Result[ShopTitle[], Failure] {
  let req = fetch.request("GET", "https://uk.yotoplay.com/products.json?limit=50");
  let seconds = time.duration_seconds(10i64);
  let limits = http.HttpLimits { ...http.limits(), body: 4000000 };
  let opts = fetch.Timeouts { connect: seconds, inactivity: seconds, total: seconds };
  let Ok(reply) = fetch.send_public(req.with_limits(limits).with_timeouts(opts).with_redirects(1)) else {
    return Err(failure("Could not reach the Yoto card shop."));
  };
  if (reply.status != 200) {
    return Err(failure("The Yoto card shop is unavailable."));
  }
  let Ok(value) = json.parse(reply.body_text_lossy()) else {
    return Err(failure("The Yoto card shop returned an invalid response."));
  };
  return Ok(parse_shop_titles(value));
}
