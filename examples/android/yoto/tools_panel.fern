import "std/json";
import "./api";

pub enum Page { Hub, Scan, Create, Discover, Setup }

pub enum Native { ScanStart, ScanStop, RecordStart, RecordStop, RecordDiscard, PickAudio, LaunchOfficial, LaunchLink(string) }

pub struct State {
  page: Option[Page],
  return_to_hub: boolean,
  action: Option[Native],
  note: string,
  scanning: boolean,
  address: string,
  scan_result: Option[api.Card],
  recording: boolean,
  choosing_cover: boolean,
  audio: Option[api.LocalAudio[]],
  draft: api.Playlist,
  editing: boolean,
  busy: boolean,
  discover_filter: i32,
  show_shop: boolean,
  shop: api.ShopTitle[],
}

pub function empty(): State {
  return State {
    page: None, return_to_hub: false, action: None, note: "", scanning: false, address: "", scan_result: None, recording: false, choosing_cover: false,
    audio: None, draft: api.empty_playlist(), editing: false, busy: false, discover_filter: 0, show_shop: false, shop: [],
  };
}

pub function close_tool(s: State): State {
  let action: Option[Native] = None;
  if (s.scanning) {
    action = Some(ScanStop);
  } else if (s.recording) {
    action = Some(RecordDiscard);
  }
  return State { ...s, page: None, return_to_hub: false, action: action, scanning: false, recording: false, choosing_cover: false, audio: None, note: "" };
}

pub function open_page(s: State, page: Page): State {
  let parent = match (s.page) {
    Some(Hub()) => true,
    _ => false,
  };
  return State { ...s, page: Some(page), return_to_hub: parent, show_shop: false, choosing_cover: false, note: "", audio: None };
}

pub function back(s: State): State {
  match (s.page) {
    Some(Create()) => {
      if (s.audio.is_some() || s.choosing_cover) {
        return State { ...s, audio: None, choosing_cover: false };
      }
    },
    Some(Discover()) => {
      if (s.show_shop) {
        return State { ...s, show_shop: false, note: "" };
      }
    },
    _ => {}
  }
  let closed = close_tool(s);
  if (s.return_to_hub) {
    return State { ...closed, page: Some(Hub) };
  }
  return closed;
}

pub function audio_added(s: State, audio: api.LocalAudio): State {
  let chapter = api.Chapter { title: audio.title, prior: json.JNull, audio: Some(audio) };
  let draft = s.draft;
  return State { ...s, draft: api.Playlist { ...draft, chapters: draft.chapters.append(chapter) }, audio: None, note: "" };
}
