import "std/json";
import "./api";

pub enum Page { Scan, Create, Discover, Setup }

pub enum Native { ScanStart, ScanStop, RecordStart, RecordStop, RecordDiscard, PickAudio, LaunchOfficial, LaunchLink(string) }

pub struct State {
  page: Option[Page],
  action: Option[Native],
  note: string,
  scanning: boolean,
  address: string,
  scan_result: Option[api.Card],
  recording: boolean,
  choosing_cover: boolean,
  importing: boolean,
  import_id: i32,
  draft: api.Playlist,
  editing: boolean,
  busy: boolean,
  discover_filter: i32,
  show_shop: boolean,
  shop: api.ShopTitle[],
}

pub function empty(): State {
  return State {
    page: None, action: None, note: "", scanning: false, address: "", scan_result: None, recording: false, choosing_cover: false,
    importing: false, import_id: 0, draft: api.empty_playlist(), editing: false, busy: false, discover_filter: 0, show_shop: false, shop: [],
  };
}

pub function close_tool(s: State): State {
  let action: Option[Native] = None;
  if (s.scanning) {
    action = Some(ScanStop);
  } else if (s.recording) {
    action = Some(RecordDiscard);
  }
  return State { ...s, page: None, action: action, scanning: false, recording: false, choosing_cover: false, importing: false, note: "" };
}

pub function open_page(s: State, page: Page): State {
  return State { ...s, page: Some(page), show_shop: false, choosing_cover: false, importing: false, note: "" };
}

pub function back(s: State): State {
  match (s.page) {
    Some(Create()) => {
      if (s.choosing_cover) {
        return State { ...s, choosing_cover: false };
      }
    },
    Some(Discover()) => {
      if (s.show_shop) {
        return State { ...s, show_shop: false, note: "" };
      }
    },
    _ => {}
  }
  return close_tool(s);
}

pub function audio_added(s: State, audio: api.LocalAudio): State {
  return add_audio(s, [audio], "");
}

pub function add_audio(s: State, audio: api.LocalAudio[], note: string): State {
  let chapters = audio.map((file: api.LocalAudio): api.Chapter => api.Chapter { title: file.title, prior: json.JNull, audio: Some(file) });
  let draft = s.draft;
  return State { ...s, draft: api.Playlist { ...draft, chapters: draft.chapters.concat(chapters) }, importing: false, note: note };
}

pub function clear_audio(draft: api.Playlist): void {
  for chapter in draft.chapters {
    if let Some(audio) = chapter.audio {
      if (audio.temporary) {
        let removed = remove_file(audio.path);
      }
    }
  }
}
