}

function open_stream(ctx: usize, address: string): Option[player.Player] {
  let Some(media) = player.new(ctx, LISTENER) else {
    return None;
  };
  if (!player.open(ctx, media, address)) {
    player.close(ctx, media);
    return None;
  }
  return Some(media);
}

function open_browser(ctx: usize, address: string): boolean {
  let e = android.env(ctx);
  let zero = 0 as usize;
  let uri_class = jni.find_class(e, "android/net/Uri");
  let parse = jni.get_static_method_id(e, uri_class, "parse", "(Ljava/lang/String;)Landroid/net/Uri;");
  let text = jni.new_string(e, address);
  let args = jni.jvalues([text]);
  let uri = jni.call_static_object_method_a(e, uri_class, parse, args);
  jni.free_buffer(args);
  let text_ref = jni.delete_local_ref(e, text);
  let uri_ref = jni.delete_local_ref(e, uri_class);
  if (jni.check(e).is_err() || uri == zero) {
    return false;
  }
  let intent_class = jni.find_class(e, "android/content/Intent");
  let ctor = jni.get_method_id(e, intent_class, "<init>", "(Ljava/lang/String;Landroid/net/Uri;)V");
  let action = jni.new_string(e, "android.intent.action.VIEW");
  let init = jni.jvalues([action, uri]);
  let intent = jni.new_object_a(e, intent_class, ctor, init);
  jni.free_buffer(init);
  let action_ref = jni.delete_local_ref(e, action);
  let data_ref = jni.delete_local_ref(e, uri);
  let class_ref = jni.delete_local_ref(e, intent_class);
  if (jni.check(e).is_err() || intent == zero) {
    return false;
  }
  let ok = jni.call_void(e, android.activity_object(ctx), "startActivity", "(Landroid/content/Intent;)V", [intent]);
  let intent_ref = jni.delete_local_ref(e, intent);
  return ok;
}

function car_event(ctx: usize, event: android.Event, catalog: offline.Catalog, media: Media): Option[deck.Msg] {
  if let Some(focus.Loss) | Some(focus.Duck) = focus.event(event) {
    return Some(deck.PhoneControl(api.Pause));
  }
  if let Some(command) = media_session.event(event) {
    match (command) {
      media_session.Play => {
        if (android.detached(ctx) && media.token != 0 as usize) {
          let foreground = service.start_media(ctx, PLAYING, media.token);
        }
        return Some(deck.PhoneResume);
      },
      media_session.Hold => {
        return Some(deck.PhoneControl(api.Pause));
      },
      media_session.End => {
        return Some(deck.PhoneControl(api.Stop));
      },
      media_session.Next => {
        return Some(deck.PhoneNext);
      },
      media_session.Previous => {
        return Some(deck.PhonePrevious);
      },
      media_session.SeekTo(ms) => {
        return Some(deck.PhoneSeek(ms));
      }
    }
  }
  if let Some(request) = browse.event(event) {
    match (request) {
      browse.Connected(link) => {
        let connected = browse.connect(ctx, link, media.token);
      },
      browse.Asked(query) => {
        let parent = browse.parent(ctx, query);
        let items: browse.Item[] = [];
        if (parent == browse.ROOT) {
          for entry in catalog.entries {
            if (entry.ready) {
              items = items.append(browse.Item { id: entry.id, title: entry.title, subtitle: entry.creator, playable: true });
            }
          }
        }
        let answered = browse.answer(ctx, query, items);
      },
      browse.PlayFrom(item) => {
        let id = browse.media_id(ctx, item);
        if (catalog.entries.any((entry: offline.Entry): boolean => entry.ready && entry.id == id)) {
          if (android.detached(ctx) && media.token != 0 as usize) {
            let foreground = service.start_media(ctx, PLAYING, media.token);
          }
          return Some(deck.ResumeCard(id));
        }
      }
    }
  }
  return None;
}

function release_media(ctx: usize, media: Media): void {
  if let Some(held) = media.awake.get() {
    service.release_awake(ctx, held);
    media.awake.set(None);
  }
  if let Some(audio) = media.focus {
    focus.release(ctx, audio);
  }
  service.stop(ctx, PLAYING);
}

function start_audio(ctx: usize, audio: player.Player, media: Media): boolean {
  if let Some(held) = media.focus {
    if (!focus.request(ctx, held)) {
      return false;
    }
  }
  return player.start(ctx, audio);
}

function publish_media(ctx: usize, current: phone.State, media: Media): void {
  let Some(session) = media.session else {
    return;
  };
  let last = media.last.get();
  let phase = match (current.phase) {
    phone.Playing => "playing",
    phone.Paused => "paused",
    phone.Idle => "idle",
    _ => "loading",
  };
  let identity = current.revision.to_string() + ":" + current.at.to_string() + ":" + current.rate.to_string() + ":" + phase;
  if (last == identity || phase == "loading") {
    return;
  }
  let playing = phase == "playing";
  let position = 0i64;
  if let Some(audio) = current.media {
    if (current.at < current.queue.len()) {
      media_session.set_track(ctx, session, current.queue[current.at].title, "", current.title, player.duration_ms(ctx, audio), None);
      position = player.position_ms(ctx, audio);
    }
  }
  media_session.set_state(ctx, session, playing, position);
  android.keep_alive(ctx, playing);
  if (playing && !last.ends_with(":playing")) {
    media.awake.set(Some(service.stay_awake(ctx, "fern:story-deck")));
    let started = service.start_media(ctx, PLAYING, media.token);
  } else if (!playing) {
    release_media(ctx, media);
  }
  media.last.set(identity);
}

function native_action(ctx: usize, model: deck.Model, recorder: Cell[Option[native_tools.Recorder]]): deck.Model {
  let Some(action) = model.tools_page.action else {
    return model;
  };
  let state = panel_tools.State { ...model.tools_page, action: None };
  match (action) {
    panel_tools.ScanStart => {
      let started = native_tools.scan(ctx, true);
      return deck.tools_update(model, panel_tools.State { ...state, scanning: started, note: if (started) { "" } else { "Turn on NFC and try again on a compatible phone." } });
    },
    panel_tools.ScanStop => {
      let disabled = native_tools.scan(ctx, false);
    },
    panel_tools.RecordStart => {
      if (recorder.get().is_none()) {
        match (native_tools.record(ctx)) {
          Ok(active) => {
            recorder.set(Some(active));
            return deck.tools_update(model, panel_tools.State { ...state, recording: true, note: "Recording…" });
          },
          Err(error) => {
            return deck.tools_update(model, panel_tools.State { ...state, note: error });
          }
        }
      }
    },
    panel_tools.RecordStop | panel_tools.RecordDiscard => {
      if let Some(active) = recorder.get() {
        recorder.set(None);
        let keep = match (action) { panel_tools.RecordStop => true, _ => false };
        let finished = panel_tools.State { ...state, recording: false, note: "" };
        match (native_tools.stop(ctx, active, keep)) {
          Ok(audio) => {
            return deck.tools_update(model, panel_tools.audio_added(finished, audio));
          },
          Err(error) => {
            return deck.tools_update(model, panel_tools.State { ...finished, note: if (keep) { error } else { "" } });
          }
        }
      }
    },
    panel_tools.PickAudio => {
      match (native_tools.audio_files(ctx)) {
        Ok(files) => {
          return deck.tools_update(model, panel_tools.State { ...state, audio: Some(files), note: "" });
        },
        Err(error) => {
          return deck.tools_update(model, panel_tools.State { ...state, note: error });
        }
      }
    },
    panel_tools.LaunchOfficial => {
      if (!native_tools.official_app(ctx)) {
        let launched = open_browser(ctx, "https://play.google.com/store/apps/details?id=com.yotoplay.yoto");
      }
    },
    panel_tools.LaunchLink(address) => {
      if (!open_browser(ctx, address)) {
        return deck.tools_update(model, panel_tools.State { ...state, note: "Could not open this page." });
      }
    }
  }
  return deck.tools_update(model, state);
}

function app_main(ctx: usize): usize {
  let dir = android.no_backup_dir(ctx);
  let env = android.env(ctx);
  let saved = session.load(dir, env);
  let catalog = offline.load(dir, download.dir(ctx));
  let session_ref = media_session.new(ctx, "dev.fern.storydeck.MediaControls", "Story Deck");
  let token = if let Some(ref) = session_ref { media_session.token(ctx, ref) } else { 0 as usize };
  let unlocked: Option[service.Awake] = None;
  let media = Media { session: session_ref, token: token, focus: focus.music(ctx, "dev.fern.storydeck.AudioFocus"), last: cell_new(""), awake: cell_new(unlocked) };
  let visible = cell_new(catalog);
  let empty_recording: Option[native_tools.Recorder] = None;
  let recorder = cell_new(empty_recording);
  let initial = deck.program(
    (address: string): boolean => open_browser(ctx, address),
    (data: u8[]): Option[draw.Image] => cover.decode(android.env(ctx), data),
    (value: Option[api.Session]): boolean => session.save(dir, env, value),
    phone.Output {
      open: (address: string): Option[player.Player] => open_stream(ctx, address),
      start: (audio: player.Player): boolean => start_audio(ctx, audio, media),
      pause: (media: player.Player): boolean => player.pause(ctx, media),
      close: (media: player.Player): void => player.close(ctx, media),
      seek: (media: player.Player, ms: i64): boolean => player.seek(ctx, media, ms, player.Exact),
      position: (media: player.Player): i64 => player.position_ms(ctx, media),
      duration: (media: player.Player): i64 => player.duration_ms(ctx, media),
      speed: (media: player.Player, rate: f32): boolean => player.set_speed(ctx, media, rate),
    },
    offline.Output {
      start: (address: string, name: string, title: string): i64 => download.start(ctx, address, [], name, title),
      status: (id: i64): i32 => download.progress(ctx, id).status,
      remove: (ids: i64[]): boolean => download.remove_many(ctx, ids),
      save: (entries: offline.Entry[], cleanup: i64[]): boolean => offline.save(dir, entries, cleanup),
    },
    (state: listening.Saved): boolean => listening.save(dir, state),
  );
  let p = initial.with_system((event: android.Event): Option[deck.Msg] => {
    if let android.Pause = event {
      if (recorder.get().is_some()) {
        return Some(deck.SetRecorder);
      }
    }
    if let android.Posted(kind, ref) = event {
      if (kind == native_tools.SCANNED) {
        let e = android.env(ctx);
        let address = jni.string_of(e, ref);
        jni.delete_global_ref(e, ref);
        return Some(deck.ReadScan(address));
      }
    }
    let command = car_event(ctx, event, visible.get(), media);
    return if (command.is_some()) { command } else { initial.system(event) };
  }).with_effects((m: deck.Model): deck.Model => {
    let next = native_action(ctx, initial.effects(m), recorder);
    visible.set(next.downloads.catalog);
    publish_media(ctx, next.phone, media);
    return next;
  }).with_close((own m: deck.Model): own deck.Model => {
    release_media(ctx, media);
    if (m.tools_page.scanning) {
      let disabled = native_tools.scan(ctx, false);
    }
    if let Some(active) = recorder.get() {
      let stopped = native_tools.stop(ctx, active, false);
    }
    if let Some(session) = media.session {
      media_session.close(ctx, session);
    }
    if let Some(f) = media.focus {
      focus.close(ctx, f);
    }
    jni.delete_global_ref(env, media.token);
    return initial.close(m);
  });
  let opened = deck.with_downloads(deck.restored(saved), catalog);
  let closed = app.run(ctx, deck.with_art(deck.with_listening(opened, listening.load(dir)), android.cache_dir(ctx)), p);
  return 0 as usize;
}
