const LISTENER: string = "dev.fern.storydeck.PhoneListener";

const PLAYING: string = "dev.fern.storydeck.Playing";

const MEDIA_REWIND: i32 = 0x53445257;

const MEDIA_READY: i32 = 0x53444d52;

const MEDIA_PLAY_ACTION: string = "dev.fern.storydeck.media.PLAY";

const MEDIA_PAUSE_ACTION: string = "dev.fern.storydeck.media.PAUSE";

const MEDIA_NEXT_ACTION: string = "dev.fern.storydeck.media.NEXT";

const MEDIA_REWIND_ACTION: string = "dev.fern.storydeck.media.REWIND";

const SHORTCUT_INTENT: i32 = 0x53444354;

struct Media {
  session: Option[media_session.Session],
  token: usize,
  focus: Option[focus.Focus],
  last: Cell[string],
  metadata: Cell[string],
  showing: Cell[boolean],
  awake: Cell[Option[service.Awake]],
}

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@jni("dev.fern.storydeck.MainActivity extends android.app.NativeActivity", "void onNewIntent(android.content.Intent)")
pub function new_intent(env: usize, thiz: usize, intent: usize): void {
  shortcuts.keep_intent(env, thiz, intent);
  let posted = android.tell(env, SHORTCUT_INTENT, 0 as usize);
}

@callback("app_main")
function app_main_entry(): usize;

@jni("dev.fern.storydeck.MediaControls extends android.media.session.MediaSession$Callback", "void onPlay()")
pub function media_play(env: usize, thiz: usize): void {
  media_session.play(env);
}

@jni("dev.fern.storydeck.MediaControls", "void onPause()")
pub function media_pause(env: usize, thiz: usize): void {
  media_session.pause(env);
}

@jni("dev.fern.storydeck.MediaControls", "void onSkipToNext()")
pub function media_next(env: usize, thiz: usize): void {
  media_session.next(env);
}

@jni("dev.fern.storydeck.MediaControls", "void onSkipToPrevious()")
pub function media_previous(env: usize, thiz: usize): void {
  media_session.previous(env);
}

@jni("dev.fern.storydeck.MediaControls", "void onStop()")
pub function media_stop(env: usize, thiz: usize): void {
  media_session.stop(env);
}

@jni("dev.fern.storydeck.MediaControls", "void onRewind()")
pub function media_rewind(env: usize, thiz: usize): void {
  let sent = android.tell(env, MEDIA_REWIND, 0 as usize);
}

@jni("dev.fern.storydeck.MediaControls", "void onCustomAction(java.lang.String, android.os.Bundle)")
pub function media_custom(env: usize, thiz: usize, action: usize, extras: usize): void {
  if (jni.string_of(env, action) == MEDIA_REWIND_ACTION) {
    media_rewind(env, thiz);
  }
}

@jni("dev.fern.storydeck.MediaControls", "void onSeekTo(long)")
pub function media_seek(env: usize, thiz: usize, ms: i64): void {
  media_session.seek_to(env, ms);
}

@jni("dev.fern.storydeck.MediaControls", "void onPlayFromMediaId(java.lang.String, android.os.Bundle)")
pub function media_play_from(env: usize, thiz: usize, id: usize, extras: usize): void {
  browse.play_from(env, id);
}

@jni("dev.fern.storydeck.CarBrowse extends android.service.media.MediaBrowserService", "android.service.media.MediaBrowserService$BrowserRoot onGetRoot(java.lang.String, int, android.os.Bundle)")
pub function car_root(env: usize, thiz: usize, client: usize, uid: i32, hints: usize): usize {
  let name = jni.string_of(env, client);
  if (name == "com.google.android.projection.gearhead" || name == "com.android.car.media" || name == "com.google.android.car.media" || name == "dev.fern.storydeck") {
    return browse.root(env, thiz, app_main_entry());
  }
  return 0 as usize;
}

@jni("dev.fern.storydeck.CarBrowse", "void onLoadChildren(java.lang.String, android.service.media.MediaBrowserService$Result)")
pub function car_children(env: usize, thiz: usize, parent: usize, request: usize): void {
  browse.children(env, thiz, parent, request);
}

@jni("dev.fern.storydeck.CarBrowse", "void onDestroy()")
pub function car_destroy(env: usize, thiz: usize): void {
  browse.destroyed(env, thiz);
}

@jni("dev.fern.storydeck.Playing extends android.app.Service", "android.os.IBinder onBind(android.content.Intent)")
pub function playing_bind(env: usize, thiz: usize, intent: usize): usize {
  return 0 as usize;
}

function media_notice(title: string, text: string): service.Notice {
  return service.Notice { channel: "story-deck", channel_name: "Playback", title: title, text: text, action: "", stop: "", unlock: false };
}

function media_buttons(playing: boolean): service.MediaButton[] {
  let toggle = if (playing) {
    service.MediaButton { label: "Pause", action: MEDIA_PAUSE_ACTION, icon: 17301539 }
  } else {
    service.MediaButton { label: "Play", action: MEDIA_PLAY_ACTION, icon: 17301540 }
  };
  return [
    service.MediaButton { label: "Back 15 seconds", action: MEDIA_REWIND_ACTION, icon: 17301542 },
    toggle,
    service.MediaButton { label: "Next track", action: MEDIA_NEXT_ACTION, icon: 17301538 },
  ];
}

@jni("dev.fern.storydeck.Playing", "int onStartCommand(android.content.Intent, int, int)")
pub function playing_command(env: usize, thiz: usize, intent: usize, flags: i32, id: i32): i32 {
  if (intent != 0 as usize) {
    let action = android.intent_action(env, intent);
    if (action == MEDIA_PLAY_ACTION) {
      media_session.play(env);
      return 2;
    }
    if (action == MEDIA_PAUSE_ACTION) {
      media_session.pause(env);
      return 2;
    }
    if (action == MEDIA_NEXT_ACTION) {
      media_session.next(env);
      return 2;
    }
    if (action == MEDIA_REWIND_ACTION) {
      let sent = android.tell(env, MEDIA_REWIND, 0 as usize);
      return 2;
    }
  }
  let result = service.command_media(env, thiz, intent, media_notice("Story Deck", "Playback"), media_buttons(true));
  if (intent != 0 as usize) {
    let sent = android.tell(env, MEDIA_READY, 0 as usize);
  }
  return result;
}

@jni("dev.fern.storydeck.AudioFocus implements android.media.AudioManager$OnAudioFocusChangeListener", "void onAudioFocusChange(int)")
pub function focus_changed(env: usize, thiz: usize, change: i32): void {
  focus.changed(env, thiz, change);
}

@jni("dev.fern.storydeck.PhoneListener implements android.media.MediaPlayer$OnPreparedListener, android.media.MediaPlayer$OnCompletionListener, android.media.MediaPlayer$OnErrorListener, android.media.MediaPlayer$OnInfoListener, android.media.MediaPlayer$OnSeekCompleteListener", "void onPrepared(android.media.MediaPlayer)")
pub function prepared(env: usize, listener: usize, media: usize): void {
  player.prepared(env, listener, media);
}

