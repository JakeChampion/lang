    ["Abc12", ""],
  );
}

function test_android_back_returns_through_tabs(): test.TestOutcome {
  let s = sim.tap(library_sim(), "Library");
  s = sim.type_in(s, "library-search", "woodland");
  s = sim.back(s);
  if (s.shell.app.tab != 1 || sim.keyboard(s).is_some()) {
    return test.fail("Back clears the search field focus before it leaves Library");
  }
  s = sim.tap(s, "Tracks for Woodland Walk");
  if (s.shell.app.shelf.opened.len() == 0) {
    return test.fail("open a card to test Back");
  }
  s = sim.back(s);
  if (s.shell.app.shelf.opened.len() > 0 || !sim.says(s, "Tracks for Woodland Walk")) {
    return test.fail("Back returns from the card to the same search");
  }
  s = sim.tap(s, "Downloads");
  s = sim.tap(s, "Choose cards to download");
  if (!s.shell.app.trip_select) {
    return test.fail("open the batch download picker");
  }
  s = sim.back(s);
  if (s.shell.app.tab != 2 || s.shell.app.trip_select || sim.finished(s)) {
    return test.fail("Back returns from the batch picker to Downloads");
  }
  s = sim.back(s);
  if (s.shell.app.tab != 1 || s.shell.app.shelf.query != "woodland") {
    return test.fail("Back returns to Library with the search intact");
  }
  s = sim.back(s);
  if (s.shell.app.tab != 0 || sim.finished(s)) {
    return test.fail("Back returns to Players before it leaves the app");
  }
  return test.assert_eq(sim.finished(sim.back(s)), true);
}

function test_android_back_returns_through_tools(): test.TestOutcome {
  let s = sim.tap(library_sim(), "Library");
  s = sim.tap(s, "More options");
  s = sim.back(s);
  if (s.shell.app.menu_open || s.shell.app.tab != 1) {
    return test.fail("Back closes the menu before it leaves Library");
  }
  s = sim.tap(sim.tap(s, "More options"), "Library tools");
  s = sim.tap(s, "Create a playlist");
  s = sim.tap(s, "Choose a library cover");
  if (!s.shell.app.tools_page.choosing_cover) {
    return test.fail("open the cover picker");
  }
  s = sim.back(s);
  if (!sim.says(s, "Choose a library cover") || s.shell.app.tools_page.choosing_cover) {
    return test.fail("Back returns from the cover picker to the playlist");
  }
  s = sim.back(s);
  if (!sim.says(s, "Discover") || !sim.says(s, "Scan a card")) {
    return test.fail("Back returns from the playlist to Library tools");
  }
  s = sim.tap(s, "Discover");
  s = sim.tap(s, "Browse new cards in the Yoto shop");
  let generation = s.shell.app.generation;
  s = sim.back(s);
  if (s.shell.app.tools_page.show_shop || !sim.says(s, "Browse new cards in the Yoto shop")) {
    return test.fail("Back leaves the shop view while the request runs");
  }
  s = sim.send(s, deck.ShopLoaded(generation, Ok([api.ShopTitle { title: "A book", address: "https://uk.yotoplay.com/products/a-book" }])));
  s = sim.tap(s, "Browse new cards in the Yoto shop");
  if (!sim.says(s, "A book")) {
    return test.fail("open the shop results");
  }
  s = sim.back(s);
  if (!sim.says(s, "Browse new cards in the Yoto shop") || s.shell.app.tools_page.show_shop) {
    return test.fail("Back returns from the shop results to Discover");
  }
  s = sim.back(sim.back(s));
  return test.assert_eq(s.shell.app.tab == 1 && s.shell.app.tools_page.page.is_none() && !sim.finished(s), true);
}

function test_reopen_trip_and_downloads(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-reopen") else {
    return test.fail("create the storage fixture");
  };
  let catalog = offline.Catalog { dir: dir, entries: [], cleanup: [], note: "" };
  let cards = fixture_cards();
  let m = deck.with_index(deck.with_downloads(deck.start(), catalog), "", cards);
  let draft = deck.update(deck.update(m, deck.OpenLineup("")), deck.LineupTitle("Bedtime"));
  draft = deck.update(deck.update(draft, deck.AddLineupCard("book")), deck.AddLineupCard("pod"));
  draft = deck.update(draft, deck.MoveLineupCard(1, 0));
  let ready = deck.update(draft, deck.SaveLineup);
  let plans = ready.playback_tools.saved;
  if (plans.lineups.len() != 1 || plans.lineups[0].cards.len() != 2) {
    return test.fail("save two selected cards in the trip");
  }
  let renamed = listening.keep_lineup(plans, "Bedtime", "Holiday", plans.lineups[0].cards);
  let item = plans.lineups[0].cards[1];
  let first = listening.Bookmark { item: item, chapter: "01", key: "03", position: 1000i64, name: "First story" };
  let saved = listening.pin(listening.pin(renamed, first), listening.Bookmark { ...first, name: "After dinner", position: 2000i64 });
  let history = listening.heard(listening.heard(saved, item, false, 10i64), item, true, 20i64);
  let pending = offline.fetching(offline.enqueue(offline.empty(catalog), cards.take(2)), cards[0]);
  if (!listening.save(dir, listening.Saved { ...history, downloads: offline.pending(pending) })) {
    return test.fail("save the trip, history, bookmarks and pending downloads");
  }
  let restored = listening.load(dir);
  let restarted = deck.with_listening(deck.with_downloads(deck.start(), catalog), restored);
  if (restored.lineups.len() != 1 || restored.history.len() != 1) {
    return test.fail("restore the trip and listening history");
  }
  let line = restored.lineups[0];
  if (line.id != plans.lineups[0].id || line.name != "Holiday" || line.cards[0].id != "pod" || restored.pins.len() != 2 || !restored.history[0].done) {
    return test.fail("restore the renamed trip, drag order, named bookmarks and finished history");
  }
  return test.assert_eq_array(offline.pending(restarted.downloads).map((c: api.Card): string => c.id), [cards[0].id, cards[1].id]);
}

