    return test.fail("accept only the correct PIN");
  }
  let cards = fixture_cards();
  let saved = listening.toggle_favourite(listening.Saved { ...listening.empty(), kids: true, parent_key: key }, listening.Item { id: "book", title: "Woodland Walk" });
  if (!listening.save(dir, saved) || !library_cache.save(dir, library_cache.encode(cards))) {
    return test.fail("save kids mode and the search index");
  }
  let cached = library_cache.load(dir);
  let matches = search.find(cached, "ice", 0);
  if (matches.len() != 1 || cached[matches[0].card].id != "pod" || search.excerpt("ice", "Sky Journal", cached[matches[0].card].tracks[matches[0].track].search) != "ice") {
    return test.fail("search cached episode metadata and show the matched word");
  }
  let m = deck.with_index(deck.with_listening(deck.start(), listening.load(dir)), dir, cached);
  let s = artwork_simulator(m);
  if (!sim.says(s, "Favourites") || sim.says(s, "Library") || !sim.says(s, "Woodland Walk") || sim.says(s, "Sky Journal")) {
    return test.fail("restart with only the favourite covers and adult gate");
  }
  s = sim.tap(s, "Grown-ups");
  if (!sim.says(s, "Enter parent PIN") || !s.shell.app.playback_tools.saved.kids) {
    return test.fail("opening the PIN pad keeps kids mode locked");
  }
  let removed = sim.send(s, deck.ResumeCard("pod")).shell.app;
  return test.assert_eq(removed.phone.card, "");
}

function keypad_is_aligned(s: sim.Sim[deck.Model, deck.Msg]): boolean {
  let previous_y = -1000;
  for row in 0..3 {
    let Some((left, y)) = sim.place_of(s, (row * 3 + 1).to_string(), 0) else {
      return false;
    };
    let Some((middle, middle_y)) = sim.place_of(s, (row * 3 + 2).to_string(), 0) else {
      return false;
    };
    let Some((right, right_y)) = sim.place_of(s, (row * 3 + 3).to_string(), 0) else {
      return false;
    };
    if (left >= middle || middle >= right || y != middle_y || y != right_y || y - previous_y < 96) {
      return false;
    }
    previous_y = y;
  }
  let Some((center, _)) = sim.place_of(s, "2", 0) else {
    return false;
  };
  let Some((zero, bottom)) = sim.place_of(s, "0", 0) else {
    return false;
  };
  let Some((_, submit)) = sim.place_of(s, "Continue", 0) else {
    return false;
  };
  return center == zero && bottom - previous_y >= 96 && submit - bottom >= 96;
}

function test_parent_pin_keypad(): test.TestOutcome {
  let s = sim.scaled(sim.themed(simulator(deck.update(deck.start(), deck.EnterKids)), true), 1.0);
  if (!keypad_is_aligned(s)) {
    return test.fail("show every PIN key in four separate rows with Continue below them");
  }
  preview(s, "parent-pin");
  s = sim.scaled(s, 1.8);
  if (!keypad_is_aligned(s)) {
    return test.fail("keep all ten keys and Continue separate at large text size");
  }
  preview(s, "parent-pin-large-text");
  for label in ["0", "5", "7", "9"] {
    s = sim.tap(s, label);
  }
  s = sim.tap(s, "Delete last digit");
  s = sim.tap(s, "Continue");
  if (s.shell.app.parent.code != "057" || s.shell.app.parent.first.len() > 0) {
    return test.fail("delete one digit and require at least four to continue");
  }
  s = sim.tap(sim.tap(s, "4"), "Continue");
  if (s.shell.app.parent.first != "0574" || s.shell.app.parent.code.len() > 0 || !keypad_is_aligned(s)) {
    return test.fail("clear the entry before asking for confirmation");
  }
  for label in ["0", "5", "7", "4", "Continue"] {
    s = sim.tap(s, label);
  }
  return test.assert_eq(s.shell.app.parent.busy && sim.shows(s, "Checking PIN…"), true);
}

function test_chapter_timer_and_prefetch(): test.TestOutcome {
  let opened = cell_new(0);
  let played = cell_new(0);
  let sought = cell_new(0i64);
  let output = phone.Output {
    ...no_audio(),
    open: (url: string): Option[player.Player] => {
      let slot = opened.get();
      opened.set(slot + 1);
      return Some(player.Player { obj: 1 as usize, listener: 1 as usize, slot: slot });
    },
    start: (media: player.Player): boolean => {
      played.set(played.get() + 1);
      return true;
    },
    seek: (media: player.Player, ms: i64): boolean => {
      sought.set(ms);
      return true;
    },
  };
  let first = api.Stream { title: "Part 1", url: "file:///part1", chapter: "01", key: "01", art: "" };
  let second = api.Stream { ...first, title: "Part 2", url: "file:///part2", chapter: "02" };
  let loading = phone.loading(phone.chapter_timer(phone.empty(), true), "card", "Test card", 30000i64);
  let state = phone.apply(phone.received(loading, loading.revision, Ok([first, second])), output);
  let (prepared, first_arg) = player.posted(player.Prepared, 0);
  state = phone.apply(phone.event(state, android.Posted(prepared, first_arg)), output);
  if (sought.get() != 30000i64 || played.get() != 0) {
    return test.fail("seek to the resume position before playing");
  }
  let (seeked, seek_arg) = player.posted(player.Seeked, 0);
  state = phone.apply(phone.event(state, android.Posted(seeked, seek_arg)), output);
  state = phone.prime(state, output);
  let (prepared_next, next_arg) = player.posted(player.Prepared, 1);
  state = phone.event(state, android.Posted(prepared_next, next_arg));
  let (ended, ended_arg) = player.posted(player.Completed, 0);
  state = phone.apply(phone.event(state, android.Posted(ended, ended_arg)), output);
  if (opened.get() != 2 || played.get() != 1 || !state.sleep_ended || state.at != 1) {
    return test.fail("prepare the next track early and hold it at the chapter boundary");
  }
  let paused = phone.State { ...state, elapsed: 40000i64, paused_at: monotonic_ns() - 121000000000i64 };
  let resumed = phone.apply(phone.control(paused, api.Resume), output);
  return test.assert_eq(resumed.starting_seek && sought.get() == 30000i64, true);
}

function test_phone_player_handoff(): test.TestOutcome {
  let Some(playback) = player_status.event("{\"playbackStatus\":\"playing\",\"cardId\":\"book\",\"chapterKey\":\"01\",\"trackKey\":\"03\",\"position\":43}".bytes()) else {
    return test.fail("read the Yoto chapter, track and position");
  };
  let s = sim.tap(library_sim(), "Bedroom, Online");
  let initial = s.shell.app;
  s = sim.send(s, deck.PlaybackLoaded(initial.generation, initial.now_playing.revision, Ok(playback)));
  let transferring = sim.send(s, deck.MoveToPhone).shell.app;
  if (!transferring.on_phone || transferring.phone.resume_ms != 43000i64 || transferring.transfer_from != "one") {
    return test.fail("open the phone at the Yoto player position");
  }
  let track = api.Stream { title: "Fox at dusk", url: "file:///fox", chapter: "01", key: "03", art: "" };
  let playing = phone.State { ...transferring.phone, queue: [track], phase: phone.Playing, elapsed: 51000i64 };
  let current = deck.Model { ...deck.start(), token: "test", players: initial.players, on_phone: true, phone: playing };
  let pending = deck.update(deck.update(current, deck.MoveToPlayer("one")), deck.Tick);
  let generation = pending.generation;
  let revision = pending.phone.revision;
  let done = deck.update(pending, deck.PlaybackMoved(generation, revision, "one", true, Ok(())));
  return test.assert_eq(!done.on_phone && done.selected == "one" && done.phone.card.len() == 0, true);
}

function label_height(s: sim.Sim[deck.Model, deck.Msg], label: string): i32 {
  for n in s.shell.host.lay.nodes {
    match (n.paint) {
      scene.Label(t, _, _, _, _) => {
        if (t == label) {
          return n.h;
        }
      },
      _ => {}
    }
  }
  return -1;
}

function test_player_transport_fits(): test.TestOutcome {
  let Some(playback) = player_status.event("{\"playbackStatus\":\"playing\",\"cardId\":\"book\",\"chapterKey\":\"01\",\"trackKey\":\"03\",\"position\":19,\"trackLength\":114}".bytes()) else {
    return test.fail("read the Yoto chapter, track and position");
  };
  let book = fixture_cards()[0];
  let middle = book.tracks[0];
  let tracks = [api.Track { ...middle, track_key: "02" }, middle, api.Track { ...middle, track_key: "04" }];
  let players = [api.Player { id: "one", name: "Bedroom", online: true }];
  let library = api.Library { players: players, cards: [api.Card { ...book, tracks: tracks }], groups: Ok([]), note: "" };
  let m = deck.update(deck.Model { ...deck.start(), token: "test session" }, deck.LibraryLoaded(Ok(library)));
  let s = sim.tap(simulator(m), "Bedroom, Online");
  let initial = s.shell.app;
  s = sim.send(s, deck.PlaybackLoaded(initial.generation, initial.now_playing.revision, Ok(playback)));
  s = sim.send(s, deck.OpenNowPlaying);
  let line = label_height(s, "Stop");
  for label in ["Previous", "Pause", "Next", "Back 15 s", "Forward 30 s"] {
    if (line <= 0 || label_height(s, label) != line) {
      return test.fail("show " + label + " on one line");
    }
  }
  let Some((_, previous)) = sim.place_of(s, "Previous", 0) else {
    return test.fail("show Previous");
  };
  let Some((_, next)) = sim.place_of(s, "Next", 0) else {
    return test.fail("show Next");
  };
  return test.assert_eq(previous, next);
}

function test_library_search_jobs(): test.TestOutcome {
  let first = fixture_cards()[0];
  let tracks: api.Track[] = [];
  for i in 0..24 {
    let track = "Woodland chapter " + i.to_string();
    tracks = tracks.append(api.Track { title: track, chapter: "Forest", chapter_key: "01", track_key: i.to_string(), search: track.to_lower(), art: "", chapter_art: "", seconds: 0i64 });
  }
  let cards: api.Card[] = [fixture_cards()[2]];
  for i in 0..1500 {
    let name = "Book " + i.to_string();
    cards = cards.append(api.Card { ...first, title: name, id: i.to_string(), search: name.to_lower(), tracks: tracks });
  }
  let real = deck.program((url: string): boolean => false, (data: u8[], limit: i32): Option[draw.Image] => None, (session: Option[api.Session]): boolean => true, no_audio(), no_downloads(), (state: listening.Saved): boolean => true);
  let m = deck.update(deck.Model { ...deck.start(), tab: 1 }, deck.LibraryLoaded(Ok(api.Library { players: [], cards: cards, groups: Ok([]), note: "" })));
  let from = monotonic_ns();
  m = deck.update(m, deck.Search("woodland"));
  let edit_ms = (monotonic_ns() - from) / 1000000i64;
  sleep_ms(80i64);
  m = deck.update(m, deck.Tick);
  let obsolete = real.start(m, deck.Tick);
  if (obsolete.len() != 1) {
    return test.fail("start one search batch after the delay");
  }
  let begin = monotonic_ns();
  m = deck.update(m, deck.Search("night"));
  for job in obsolete {
    m = deck.update(m, job.join());
  }
  if (m.shelf.hits.len() != 0 || m.shelf.search_due == 0i64) {
    return test.fail("discard results from the superseded query");
  }
  sleep_ms(80i64);
  for i in 0..24 {
    if (m.shelf.search_due == 0i64) {
      break;
    }
    m = deck.update(m, deck.Tick);
    for job in real.start(m, deck.Tick) {
      m = deck.update(m, job.join());
    }
  }
  if (m.shelf.hits.len() != 1 || m.shelf.sections != [0, 0, 1]) {
    return test.fail("find and group the radio result");
  }
  let query_ms = (monotonic_ns() - begin) / 1000000i64;
  let scroll_started = monotonic_ns();
  let shown = simulator(deck.update(m, deck.Search("")));
  let scrolled = shown;
  for turn in 0..3 {
    scrolled = sim.settle(sim.drag(scrolled, 175, 1260, 175, 550, 460i64));
  }
  let scroll_ms = (monotonic_ns() - scroll_started) / 1000000i64;
  if (scrolled.shell.app.shelf.first_art <= 0) {
    return test.fail("scroll the virtualized large library");
  }
  print("# 1501-card host simulation · edit " + edit_ms.to_string() + " ms · replacement query " + query_ms.to_string() + " ms · grid mount and scroll " + scroll_ms.to_string() + " ms\n");
  return test.assert_eq(search.highlight("night", "Night Radio", "night radio"), "night");
}

function test_profiles_and_collections(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-profiles") else {
    return test.fail("open profile storage");
  };
  let book = listening.Item { id: "book", title: "Woodland Walk" };
  let pin = listening.Bookmark { item: book, chapter: "01", key: "03", position: 14000i64, name: "Chapter one" };
  let first = listening.toggle_favourite(listening.remember(listening.empty(), pin), book);
  let second = listening.switch_profile(first, "Robin");
  if (second.marks.len() > 0 || second.favourites.len() > 0) {
    return test.fail("start a profile with separate progress and favourites");
  }
  let collection = listening.Collection { name: "Car favourites", cards: ["pod"], available: false, category: 0, scope: search.TRACKS };
  if (!listening.save(dir, listening.Saved { ...second, collections: [collection], wifi_only: true, compact: true })) {
    return test.fail("save profiles and collection filters");
  }
  let saved = listening.load(dir);
  let with_family = listening.switch_profile(saved, "Family");
  if (!listening.favourite(with_family, book.id) || listening.mark(with_family, book.id).is_none() || !saved.wifi_only || !saved.compact) {
    return test.fail("restore the family profile settings");
  }
  let cards = fixture_cards();
  let m = deck.with_index(deck.with_listening(deck.Model { ...deck.start(), tab: 1 }, saved), "", cards);
  let found = deck.update(deck.update(m, deck.UsePersonal("Car favourites")), deck.Search("ice"));
  return test.assert_eq(found.shelf.search_scope == search.TRACKS && found.shelf.hits.len() == 1 && cards[found.shelf.hits[0].card].id == "pod", true);
}

function test_concurrent_download_removal(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-concurrent") else {
    return test.fail("open download storage");
  };
  let cards = fixture_cards();
  let tracks: offline.Track[] = [];
  for i in 0..52 {
    let suffix = i.to_string();
    tracks = tracks.append(offline.Track { id: (i + 1) as i64, name: "yoto-offline-test-" + suffix + ".audio", title: suffix, chapter: "01", key: suffix, art: "" });
  }
  let saved = offline.Entry { id: cards[0].id, title: cards[0].title, creator: "", tracks: tracks, ready: true, failed_at: -1, resume_from: -1, card: Some(cards[0]) };
  let active = offline.Entry { ...saved, id: cards[1].id, title: cards[1].title, tracks: [offline.Track { ...tracks[0], id: 100i64 }], ready: false, card: Some(cards[1]) };
  let removed = cell_new(0);
  let disk = offline.Output {
    ...no_downloads(),
    status: (id: i64): i32 => if (id == 100i64) { download.RUNNING } else { download.DONE },
    remove: (ids: i64[]): boolean => {
      if (ids.len() > 8 || ids.contains(100i64)) {
        return false;
      }
      removed.set(removed.get() + ids.len());
      return true;
    },
    save: (items: offline.Entry[], cleanup: i64[]): boolean => offline.save(dir, items, cleanup),
  };
  let catalog = offline.Catalog { dir: dir, entries: [saved, active], cleanup: [], note: "" };
  let downloads = offline.enqueue(offline.empty(catalog), [cards[2]]);
  let opened = deck.Model { ...deck.start(), downloads: downloads, tab: 2, offline_open: saved.id };
  let real = deck.program((url: string): boolean => false, (data: u8[], limit: i32): Option[draw.Image] => None, (session: Option[api.Session]): boolean => true, no_audio(), disk, (state: listening.Saved): boolean => listening.save(dir, state));
  let dry = ui.program(deck.view, deck.update).with_effects(real.effects).with_back(real.back);
  let s = sim.start(opened, dry, test_fonts(), 720, 1600, 2.0);
  let start = monotonic_ns();
  s = sim.tap(s, "Remove download");
  let touch_ms = (monotonic_ns() - start) / 1000000i64;
  if (s.shell.app.offline_open.len() > 0 || removed.get() != 0 || !sim.shows(s, "Downloading " + active.title + " · 0/1 tracks")) {
    return test.fail("leave the track list immediately while the second title downloads");
  }
  s = sim.tap(s, "Library");
  s = sim.tap(s, "Downloads");
  if (s.shell.app.tab != 2) {
    return test.fail("keep navigation responsive during cleanup");
  }
  let persisted = listening.load(dir);
  let state = offline.restore_pending(offline.empty(offline.load(dir, dir)), persisted.downloads);
  let next = state;
  for turn in 0..8 {
    next = offline.apply(offline.check(next), disk);
  }
  print("# 52-track removal with a second title active in the host simulation · tap and redraw " + touch_ms.to_string() + " ms\n");
  return test.assert_eq(removed.get() == 52 && next.catalog.cleanup.len() == 0 && offline.current(next).map((card: api.Card): string => card.id).unwrap_or("") == active.id && next.queue.len() == 1, true);
}

function test_pause_and_repair_download(): test.TestOutcome {
  let card = fixture_cards()[0];
  let first = offline.Track { id: 1i64, name: "yoto-offline-one.audio", title: "One", chapter: "01", key: "01", art: "" };
  let second = offline.Track { ...first, id: 2i64, name: "yoto-offline-two.audio", title: "Two", key: "02" };
  let entry = offline.Entry { id: card.id, title: card.title, creator: "", tracks: [first, second], ready: false, failed_at: -1, resume_from: -1, card: Some(card) };
  let done = cell_new(false);
  let deleted = cell_new([] as i64[]);
  let disk = offline.Output {
    ...no_downloads(),
    start: (url: string, name: string, title: string): i64 => 3i64,
    status: (id: i64): i32 => if (id == 1i64 || done.get()) { download.DONE } else { download.RUNNING },
    remove: (ids: i64[]): boolean => {
      deleted.set(deleted.get().concat(ids));
      return true;
    },
    save: (entries: offline.Entry[], cleanup: i64[]): boolean => true,
  };
  let state = offline.empty(offline.Catalog { dir: "/media", entries: [entry], cleanup: [], note: "" });
  state = offline.apply(offline.check(state), disk);
  state = offline.apply(offline.hold(state, card.id), disk);
  if (offline.label(state, card.id) != "Paused" || state.catalog.cleanup != [2i64]) {
    return test.fail("preserve the first complete track when pausing");
  }
  state = offline.apply(offline.check(state), disk);
  state = offline.resume_card(state, card.id);
  let Some(wanted) = offline.next(state) else {
    return test.fail("reopen the paused title on resume");
  };
  let plan = api.DownloadPlan { id: card.id, title: card.title, creator: card.creator, card: Some(card), tracks: [
    api.DownloadTrack { title: first.title, chapter: first.chapter, key: first.key, url: "https://example.com/one", art: "" },
    api.DownloadTrack { title: second.title, chapter: second.chapter, key: second.key, url: "https://example.com/two", art: "" },
  ] };
  state = offline.fetching(state, wanted);
  state = offline.apply(offline.received(state, state.revision, Ok(plan)), disk);
  done.set(true);
  state = offline.apply(offline.check(state), disk);
  let Some(saved) = offline.saved(state, card.id) else {
    return test.fail("verify the resumed title");
  };
  if (saved.tracks[0].id != first.id || saved.tracks[1].id != 3i64 || deleted.get() != [2i64]) {
    return test.fail("replace only the unfinished file");
  }
  state = offline.apply(offline.repair(state, [(card.id, 1)]), disk);
  return test.assert_eq(state.catalog.entries[0].failed_at == 1 && offline.next(state).is_some(), true);
}

function test_trip_sample_and_target(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-checklist") else {
    return test.fail("open trip storage");
  };
  let card = fixture_cards()[0];
  let track = offline.Track { id: 1i64, name: "yoto-offline-start.audio", title: "Fox at dusk", chapter: "01", key: "03", art: "" };
  let entry = offline.Entry { id: card.id, title: card.title, creator: "", tracks: [track], ready: true, failed_at: -1, resume_from: -1, card: Some(card) };
  let item = listening.Item { id: card.id, title: card.title };
  let plans = listening.keep_lineup(listening.empty(), "", "Car ride", [item]);
  let catalog = offline.Catalog { dir: dir, entries: [entry], cleanup: [], note: "" };
  let made = write_file_bytes(dir + "/" + track.name, "RIFF    WAVEfmt                     data    ".bytes());
  if (made.is_err()) {
    return test.fail("write a local audio fixture");
  }
  let m = deck.with_downloads(deck.start(), catalog);
  let base = deck.with_listening(m, plans);
  let s = simulator(deck.update(base, deck.SelectTab(3)));
  s = sim.tap(s, "Trip dashboard");
  s = sim.send(s, deck.TripChecked(listening.check_trip(catalog, [item])));
  preview(s, "trip-dashboard");
  if (!sim.shows(s, "1 of 1 ready offline") || !sim.shows(s, "Test offline playback")) {
    return test.fail("show the trip checklist result");
  }
  s = sim.tap(s, "Test offline playback");
  if (s.shell.app.phone.queue.len() == 0 || !s.shell.app.phone.queue[0].url.starts_with("file://") || s.shell.app.playback_tools.trip_test_until <= 0i64) {
    return test.fail("test the local track and set a time limit");
  }
  s = sim.send(s, deck.PlaybackTarget);
  if (!sim.shows(s, "Playback device") || !sim.shows(s, "This phone")) {
    return test.fail("show the playback destination picker");
  }
  s = sim.back(s);
  return test.assert_eq(sim.shows(s, "Car ride") && !s.shell.app.target_open, true);
}

function test_artwork_read_cancellation(): test.TestOutcome {
  let address = [127u8, 0u8, 0u8, 1u8];
  let server = tcp_listen_with(address, 0, 4, false);
  let port = tcp_local_port(server);
  let client = tcp_connect_with(address, port, false);
  let peer = tcp_accept(server);
  let signal = tcp_connect_with(address, port, false);
  let ending = tcp_accept(server);
  let closed = tcp_close(ending);
  let result = net.read_watched_until(client, 16, time.duration_seconds(2i64), 1, signal.fd);
  let remaining = tcp_close(client) + tcp_close(peer) + tcp_close(signal) + tcp_close(server);
  if let Ok(net.Abandoned) = result {
    return test.assert_eq(closed + remaining, 0);
  }
  return test.fail("closing the signal peer must cancel the pending artwork read");
}

function test_choose_saved_chapters(): test.TestOutcome {
  let book = fixture_cards()[0];
  let selected = api.chapter_download(book, "02", "Second chapter");
  let raw = "{\"card\":{\"cardId\":\"book\",\"content\":{\"chapters\":["
    + "{\"key\":\"01\",\"tracks\":[{\"type\":\"stream\"}]},"
    + "{\"key\":\"02\",\"title\":\"Second chapter\",\"tracks\":[{\"key\":\"01\",\"title\":\"Second track\",\"type\":\"audio\",\"trackUrl\":\"https://example.com/second.mp3\",\"duration\":42}]}]}}}";
  let reply = json.parse(raw).unwrap_or(json.JNull);
  let Ok(plan) = api.parse_download(reply, selected) else {
    return test.fail("use the card's authorized audio for the selected chapter");
  };
  let (origin, chapter) = api.download_selection(plan.id);
  if (origin != book.id || chapter != "02" || plan.tracks.len() != 1 || api.parse_download(reply, book).is_ok()) {
    return test.fail("keep a partial download separate from the complete card");
  }
  let track = offline.Track { id: 1i64, name: "yoto-offline-second.audio", title: "Second track", chapter: "02", key: "01", art: "" };
  let entry = offline.Entry { id: selected.id, title: selected.title, creator: "", tracks: [track], ready: true, failed_at: -1, resume_from: -1, card: plan.card };
  let catalog = offline.Catalog { dir: "/media", entries: [entry], cleanup: [], note: "" };
  let m = deck.with_downloads(deck.start(), catalog);
  let next = deck.update(m, deck.PlayChapter(selected.id));
  return test.assert_eq(next.phone.queue.len() == 1 && next.phone.queue[0].url.starts_with("file://") && offline.saved(next.downloads, book.id).is_none(), true);
}

function test_travel_fits_and_protection(): test.TestOutcome {
  let path = "/media";
  let book = fixture_cards()[0];
  let card = api.Card { ...book, seconds: 900i64 };
  let track = offline.Track { id: 1i64, name: "yoto-offline-forest.audio", title: "Fox at dusk", chapter: "01", key: "03", art: "" };
  let entry = offline.Entry { id: card.id, title: card.title, creator: "", tracks: [track], ready: true, failed_at: -1, resume_from: -1, card: Some(card) };
  let catalog = offline.Catalog { dir: path, entries: [entry], cleanup: [], note: "" };
  let item = listening.Item { id: card.id, title: card.title };
  let bookmark = listening.Bookmark { item: item, chapter: "01", key: "03", name: "", position: 360000i64 };
  let saved = listening.remember(listening.empty(), bookmark);
  let shorter = travel.fit([card], catalog, saved, 10);
  if (shorter.len() != 1 || shorter[0].seconds != 540i64 || travel.fit([card], catalog, listening.empty(), 10).len() != 0) {
    return test.fail("use the remaining time on an in-progress saved card");
  }
  let liked = listening.toggle_favourite(saved, item);
  let other = listening.switch_profile(liked, "Jess");
  let report = [listening.Trip { id: card.id, title: card.title, expected: 1, present: 1, bytes: 42i64, first_bad: -1 }];
  return test.assert_eq(travel.largest(other, report).len() == 0 && travel.surprise(liked, catalog, "").is_some(), true);
}

function test_bedtime_and_stickers(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-bedtime") else {
    return test.fail("open a bedtime settings store");
  };
  let cards = fixture_cards();
  let story = listening.Item { id: cards[0].id, title: cards[0].title };
  let sound = listening.Item { id: cards[1].id, title: cards[1].title };
  let routine = listening.Routine { profile: "Family", story: story, sound: sound, minutes: 15 };
  let track = offline.Track { id: 1i64, name: "yoto-offline-bedtime.audio", title: "Story", chapter: "01", key: "03", art: "" };
  let first = offline.Entry { id: story.id, title: story.title, creator: "", tracks: [track], ready: true, failed_at: -1, resume_from: -1, card: Some(cards[0]) };
  let second = offline.Entry { ...first, id: sound.id, title: sound.title, card: Some(cards[1]) };
  let catalog = offline.Catalog { dir: dir, entries: [first, second], cleanup: [], note: "" };
  let settings = listening.Saved { ...listening.empty(), routines: [routine], fade: true, budget_mb: 2048 };
  let m = deck.with_listening(deck.with_downloads(deck.start(), catalog), settings);
  m = deck.update(deck.update(m, deck.OpenTravel(deck.NfcTags)), deck.LinkRoutineTag);
  m = deck.tools_update(m, panel_tools.State { ...m.tools_page, scanning: true });
  m = deck.update(m, deck.ReadPhysicalTag("NfcFixture|"));
  if (m.playback_tools.saved.tags.len() != 1 || !listening.save(dir, m.playback_tools.saved)) {
    return test.fail("save the sticker binding for the current profile");
  }
  let restored = listening.load(dir);
  if (restored.routines.len() != 1 || restored.budget_mb != 2048 || !restored.fade || restored.tags[0].uid != "NfcFixture") {
    return test.fail("restore travel preferences across restarts");
  }
  m = deck.tools_update(m, panel_tools.State { ...m.tools_page, scanning: true });
  m = deck.update(m, deck.ReadPhysicalTag("NfcFixture|"));
  if (m.phone.card != story.id || m.playback_tools.sleep_at != 0i64) {
    return test.fail("play the bedtime story first");
  }
  let media = player.Player { obj: 1 as usize, listener: 1 as usize, slot: 0 };
  let (ended, value) = player.posted(player.Completed, 0);
  let playing = phone.State { ...m.phone, media: Some(media), phase: phone.Playing };
  m = deck.update(deck.Model { ...m, phone: playing }, deck.PhoneEvent(ended, value));
  return test.assert_eq(m.phone.card == sound.id && m.playback_tools.sleep_at > monotonic_ns(), true);
}

function test_import_audio_keeps_playlist_and_rejects_stale_results(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-audio-import") else {
    return test.fail("open a temporary audio store");
  };
  defer remove_dir(dir);
  let original = dir + "/original.mp3";
  let copy = dir + "/copied.mp3";
  let late = dir + "/late.mp3";
  if (write_file_bytes(original, [1u8]).is_err() || write_file_bytes(copy, [2u8]).is_err() || write_file_bytes(late, [3u8]).is_err()) {
    return test.fail("create audio fixtures");
  }
  defer remove_file(original);
  defer remove_file(copy);
  defer remove_file(late);
  let ready = deck.update(deck.start(), deck.OpenTools(panel_tools.Create));
  let model = deck.update(ready, deck.DraftTitle("My trip playlist"));
  model = deck.update(model, deck.ImportAudio);
  let canceled = model.tools_page.import_id;
  model = deck.update(model, deck.AudioImported(canceled, [], ""));
  if (model.tools_page.importing || model.tools_page.draft.title != "My trip playlist" || model.tools_page.draft.chapters.len() != 0) {
    return test.fail("cancel the picker and keep the playlist draft");
  }
  model = deck.update(model, deck.ImportAudio);
  let active = model.tools_page.import_id;
  model = deck.update(model, deck.AudioImportStarted(active));
  let source = api.LocalAudio { path: original, title: "First", mime: "audio/mpeg", temporary: false };
  let duplicate = api.LocalAudio { ...source, path: copy, title: "Second", temporary: true };
  let stale = api.LocalAudio { ...duplicate, path: late };
  model = deck.update(model, deck.AudioImported(canceled, [stale], ""));
  if (stat(late).is_ok() || !model.tools_page.importing) {
    return test.fail("discard stale imports and keep the current request active");
  }
  model = deck.update(model, deck.AudioImported(active, [source, duplicate], ""));
  let names = model.tools_page.draft.chapters.map((chapter: api.Chapter): string => chapter.title);
  if (names != ["First", "Second"] || model.tools_page.importing || model.tools_page.draft.title != "My trip playlist") {
    return test.fail("add two chapters in order to the current playlist");
  }
  model = deck.update(deck.update(model, deck.DropChapter(1)), deck.DropChapter(0));
  return test.assert_eq(stat(copy).is_err() && stat(original).is_ok() && model.tools_page.draft.chapters.len() == 0, true);
}

function test_audio_editor_trims_splits_and_matches(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-audio-edits") else {
    return test.fail("open the audio editor's temporary store");
  };
  let format = pcm.Format { sample_rate: 8000, channels: 1, bits_per_sample: 16 };
  let points: i32[] = [];
  for i in 0..16000 {
    points = points.append(if (i < 8000) { 1000 } else { 2000 });
  }
  let Ok(original) = wav.encode(points, format, pcm.default_limits()) else {
    return test.fail("encode a small WAV fixture");
  };
  let input = dir + "/fixture.wav";
  if (write_file_bytes(input, original).is_err()) {
    return test.fail("write the WAV fixture");
  }
  let audio = api.LocalAudio { path: input, title: "Family recording", mime: "audio/wav", temporary: false };
  let wave = myo_audio.analyze(audio).unwrap_or(myo_audio.Wave { duration: 0, peaks: [] });
  if (wave.duration != 2000 || wave.peaks.len() != 48) {
    return test.fail("read the recording and build a waveform");
  }
  let edit = myo_audio.Edit { first: 250, last: 1750, markers: [1000], match_volume: true };
  let Ok(parts) = myo_audio.render(audio, audio.title, dir, edit) else {
    return test.fail("render the trim and chapter split");
  };
  defer myo_audio.discard(parts);
  if (parts.len() != 2 || parts[0].path == input) {
    return test.fail("save edits as separate files");
  }
  let Ok(first) = wav.decode(read_file_bytes(parts[0].path).unwrap_or([]), pcm.default_limits()) else {
    return test.fail("read the first edited chapter");
  };
  let Ok(second) = wav.decode(read_file_bytes(parts[1].path).unwrap_or([]), pcm.default_limits()) else {
    return test.fail("read the second edited chapter");
  };
  return test.assert_eq(
    first.samples.len() == 6000 && second.samples.len() == 6000 && first.samples[0] == second.samples[0]
      && first.samples[0] > 3000 && read_file_bytes(input).unwrap_or([]) == original,
    true,
  );
}

function test_gapless_and_rewind(): test.TestOutcome {
  let first = api.Stream { title: "One", url: "file:///one", chapter: "01", key: "01", art: "" };
  let second = api.Stream { ...first, title: "Two", url: "file:///two", chapter: "02" };
  let media = player.Player { obj: 1 as usize, listener: 1 as usize, slot: 0 };
  let next = player.Player { ...media, slot: 1 };
  let connected = cell_new(false);
  let volume = cell_new(1.0f32);
  let output = phone.Output {
    ...no_audio(),
    link: (media: player.Player, adjacent: Option[player.Player]): boolean => {
      connected.set(adjacent.is_some());
      return true;
    },
    volume: (media: player.Player, gain: f32): boolean => {
      volume.set(gain);
      return true;
    },
  };
  let playing = phone.State { ...phone.empty(), queue: [first, second], media: Some(media), standby: Some(next), standby_at: 1, standby_ready: true, phase: phone.Playing, elapsed: 43000i64 };
  let linked = phone.link_gapless(playing, output);
  if (!linked.linked || !connected.get()) {
    return test.fail("link the prepared next track");
  }
  let limited = phone.link_gapless(phone.chapter_timer(linked, true), output);
  if (limited.linked || connected.get()) {
    return test.fail("disable gapless playback at a sleep boundary");
  }
  let faded = phone.volume(limited, 0.25f32, output);
  let model = deck.update(deck.Model { ...deck.start(), phone: faded }, deck.PhoneRewind);
  return test.assert_eq(volume.get() == 0.25f32 && model.phone.elapsed == 28000i64, true);
}

function main(): i32 {
  let r = test.new("Story Deck");
  r = r.it("PKCE matches the standard example", test_pkce);
  r = r.it("the callback requires the correct path and state", test_callback_matches_state);
  r = r.it("parse lists of players and cards", test_service_responses);
  r = r.it("the player commands follow the API format", test_playback_requests);
  r = r.it("family and Make Your Own cards merge with cover data", test_family_library);
  r = r.it("search covers tracks, episodes, stations and card metadata", test_search);
  r = r.it("track playback addresses the exact chapter and track", test_exact_track);
  r = r.it("the search box opens a matching track's card", test_search_in_ui);
  r = r.it("cards can play on a selected online player", test_player_selection);
  r = r.it("save a rotated session before close and clear it on sign-out", test_saved_session);
  r = r.it("distinguish token rejection from a retryable error", test_token_errors);
  r = r.it("hold Backspace in search and stop on release", test_held_backspace);
  r = r.it("a search with matches keeps the sync error out of the results", test_successful_search_hides_sync_error);
  r = r.it("show the selected player's paused track", test_player_playback);
  r = r.it("scroll a library of large covers past the former page limit", test_continuous_posters);
  r = r.it("start a phone playlist at the exact authorized track", test_signed_streams);
  r = r.it("select the phone and advance, pause, resume, and stop its audio", test_phone_playback);
  r = r.it("load and save settings for the selected player", test_player_settings);
  r = r.it("save a family card and open it without a Yoto session after restart", test_offline_download);
  r = r.it("queue, check, and remove 52-track downloads in bounded turns", test_download_work_batches);
  r = r.it("download one library card, filter saved cards, and prefer local playback", test_library_download_filter);
  r = r.it("choose named player settings, services, and library tracks", test_settings_choices);
  r = r.it("preview and apply the selected day or night light colour", test_light_picker);
  r = r.it("check trip files, restore a bookmark, and advance the queue with a sleep timer", test_playback_tools);
  r = r.it("find the exact chapter or track with search filters", test_search_scope);
  r = r.it("use chapter and track icons in search, track lists, and phone playback", test_track_artwork);
  r = r.it("use sharp artwork at full size and keep player icons small", test_playback_artwork_resolution);
  r = r.it("draw the Story Deck launcher icon", test_launcher_icon);
  r = r.it("filter the library by collection and family group", test_library_collections);
  r = r.it("show account actions only in the menu", test_account_menu);
  r = r.it("open the full phone player and build device commands", test_now_playing_controls);
  r = r.it("keep each player transport button on one line", test_player_transport_fits);
  r = r.it("retry one track and find the saved card after restart", test_downloaded_search_and_retry);
  r = r.it("validate scanned card codes and shop links", test_scan_and_shop);
  r = r.it("Android Back returns through search, downloads, and tabs", test_android_back_returns_through_tabs);
  r = r.it("Android Back returns through the menu and Library tools", test_android_back_returns_through_tools);
  r = r.it("reopen trip playlists, named bookmarks, history, and the download queue", test_reopen_trip_and_downloads);
  r = r.it("restore the searchable index and keep kids mode locked after restart", test_cache_and_kids_reopen);
  r = r.it("enter and confirm a parent PIN with a regular or large keypad", test_parent_pin_keypad);
  r = r.it("seek before playback, preload the next track, and stop at the chapter boundary", test_chapter_timer_and_prefetch);
  r = r.it("transfer the chapter and position between the phone and a Yoto player", test_phone_player_handoff);
  r = r.it("cancel superseded search work in a large library and group results", test_library_search_jobs);
  r = r.it("restore isolated listening profiles and personal collection filters", test_profiles_and_collections);
  r = r.it("remove 52 tracks while another download runs and restore the queue", test_concurrent_download_removal);
  r = r.it("pause, resume, and repair downloads without replacing complete tracks", test_pause_and_repair_download);
  r = r.it("check a trip and play a local sample from the dashboard", test_trip_sample_and_target);
  r = r.it("cancel a pending artwork read when its signal closes", test_artwork_read_cancellation);
  r = r.it("save and play a single authorized chapter offline", test_choose_saved_chapters);
  r = r.it("choose a title by remaining time and protect a family favourite", test_travel_fits_and_protection);
  r = r.it("restore a sticker-linked bedtime routine and start sleep sounds after the story", test_bedtime_and_stickers);
  r = r.it("import several chapters, keep the draft on cancel, and discard stale imports", test_import_audio_keeps_playlist_and_rejects_stale_results);
  r = r.it("read a waveform and render trimmed, split, volume-matched chapters", test_audio_editor_trims_splits_and_matches);
  r = r.it("link prepared tracks, respect sleep boundaries, and rewind from the media control", test_gapless_and_rewind);
  return r.finish();
}
