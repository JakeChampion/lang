function test_pkce(): test.TestOutcome {
  let verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk";
  return test.assert_eq(oauth.challenge(verifier), "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM");
}

function callback(target: string): oauth.Callback {
  return oauth.callback("GET " + target + " HTTP/1.1\r\nHost: 127.0.0.1:8787\r\n\r\n", "expected");
}

function test_callback_matches_state(): test.TestOutcome {
  let oauth.Ignore = callback("/callback?state=other&code=abc") else {
    return test.fail("the callback accepted a different state");
  };
  let oauth.Ignore = callback("/callback?state=expected&state=other&code=abc") else {
    return test.fail("the callback accepted two state values");
  };
  let oauth.Ignore = callback("/other?state=expected&code=abc") else {
    return test.fail("the callback accepted a different path");
  };
  let oauth.Denied = callback("/callback?state=expected&error=access_denied") else {
    return test.fail("the callback missed the sign-in denial");
  };
  let oauth.Code(code) = callback("/callback?state=expected&code=A%2BB") else {
    return test.fail("the callback missed the authorization code");
  };
  return test.assert_eq(code, "A+B");
}

function test_service_responses(): test.TestOutcome {
  let p = json.parse("{\"devices\":[{\"deviceId\":\"a\",\"name\":\"Bedroom\",\"online\":true},{\"name\":\"Missing ID\"}]}").unwrap_or(json.JNull);
  let c = json.parse("{\"cards\":[{\"cardId\":\"one\",\"title\":\"Woodland Walk\"},{\"cardId\":\"two\",\"deleted\":true}]}").unwrap_or(json.JNull);
  let Ok(players) = api.parse_players(p) else {
    return test.fail("the player response must parse");
  };
  let Ok(cards) = api.parse_cards(c, true) else {
    return test.fail("the card response must parse");
  };
  if (players.len() != 1 || cards.len() != 1) {
    return test.fail("the lists must omit incomplete and deleted entries");
  }
  return test.assert_eq(players[0].name + "|" + players[0].online.to_string() + "|" + cards[0].title, "Bedroom|true|Woodland Walk");
}

function test_playback_requests(): test.TestOutcome {
  return test.assert_eq_array(
    [api.command_name(api.Play("card")), api.command_body(api.Play("card")), api.command_name(api.Pause), api.command_name(api.Resume), api.command_name(api.Stop)],
    ["card/start", "{\"uri\":\"https://yoto.io/card\"}", "card/pause", "card/resume", "card/stop"],
  );
}

// These fixtures use invented titles and the same keys as the Yoto responses.
function fixture_cards(): api.Card[] {
  let family = "{\"cards\":["
    + "{\"cardId\":\"book\",\"inFamilyLibrary\":true,\"card\":{\"title\":\"Woodland Walk\",\"metadata\":{\"author\":\"A. Writer\",\"readBy\":\"M. Reader\",\"cover\":{\"imageL\":\"https://example.com/cover.jpg\"}},\"content\":{\"chapters\":[{\"key\":\"01\",\"title\":\"Forest\",\"display\":{\"icon16x16\":\"yoto:#_WWpLHoOj6iqeREcGkJnGlsis2QSF6znM0UPFdXTjf8\"},\"tracks\":[{\"key\":\"03\",\"title\":\"Fox at dusk\",\"display\":{\"iconUrl16x16\":\"https://example.com/fox.png\"}}]}]}}},"
    + "{\"cardId\":\"pod\",\"card\":{\"title\":\"Sky Journal\",\"metadata\":{\"category\":\"podcast\"},\"content\":{\"chapters\":[{\"key\":\"204\",\"title\":\"Comet night\",\"tracks\":[{\"key\":\"1\",\"description\":\"Watch for ice\"}]}]}}},"
    + "{\"cardId\":\"radio\",\"card\":{\"title\":\"Night Radio\",\"metadata\":{\"category\":\"radio\"}}},"
    + "{\"cardId\":\"old\",\"inFamilyLibrary\":false,\"card\":{\"title\":\"Removed title\"}}]}";
  let mine = "{\"cards\":[{\"cardId\":\"book\",\"title\":\"Duplicate\"},{\"cardId\":\"myo\",\"title\":\"My stories\"}]}";
  let f = api.parse_cards(json.parse(family).unwrap_or(json.JNull), false).unwrap_or([]);
  let m = api.parse_cards(json.parse(mine).unwrap_or(json.JNull), true).unwrap_or([]);
  return api.merge_cards(f, m);
}

function test_family_library(): test.TestOutcome {
  let cards = fixture_cards();
  if (cards.len() != 4 || cards[0].tracks.len() != 1) {
    return test.fail("family and Make Your Own cards must merge by ID");
  }
  return test.assert_eq_array(
    [cards[0].title, cards[0].cover, search.category(cards[1].kind).to_string(), search.category(cards[2].kind).to_string(), search.category(cards[3].kind).to_string()],
    ["Woodland Walk", "https://example.com/cover.jpg", "3", "4", "2"],
  );
}

function test_search(): test.TestOutcome {
  let cards = fixture_cards();
  let track = search.find(cards, "WOODLAND  dusk", 0);
  let podcast = search.find(cards, "ice", 3);
  let station = search.find(cards, "night", 4);
  let narrator = search.find(cards, "M. Reader", 0);
  if (track.len() != 1 || podcast.len() != 1 || station.len() != 1 || narrator.len() != 1) {
    return test.fail("track, episode, station and narrator queries must each return one match");
  }
  return test.assert_eq_array(
    [track[0].card, track[0].track, podcast[0].card, podcast[0].track, station[0].card, station[0].track, narrator[0].card, narrator[0].track],
    [0, 0, 1, 0, 2, -1, 0, -1],
  );
}

function test_exact_track(): test.TestOutcome {
  let command = api.PlayTrack("book", "01", "03");
  let payload = json.parse(api.command_body(command)).unwrap_or(json.JNull);
  return test.assert_eq_array(
    [api.command_name(command), json.get_string(payload, "uri").unwrap_or(""), json.get_string(payload, "chapterKey").unwrap_or(""), json.get_string(payload, "trackKey").unwrap_or("")],
    ["card/start", "https://yoto.io/book", "01", "03"],
  );
}

function test_fonts(): text.Fonts {
  let dir = "examples/android/paper/testfonts";
  if (read_file_bytes(dir + "/Roboto-Regular.ttf").is_err()) {
    dir = "../paper/testfonts";
  }
  let weights = [400, 500, 700];
  let found = weights.map((weight: i32): Option[fonts.Found] => fonts.find_in(dir, "Roboto", weight));
  return text.load(found, weights, (path: string): u8[] => read_file_bytes(path).unwrap_or([]));
}

function preview(s: sim.Sim[deck.Model, deck.Msg], name: string): void {
  if let Some(dir) = env("STORY_DECK_UI_PNG") {
    let frame = sim.picture(s);
    let saved = testkit.save_png(frame, dir + "/" + name + ".png");
    draw.release(frame);
  }
}

function no_audio(): phone.Output {
  return phone.Output {
    open: (address: string): Option[player.Player] => None,
    start: (media: player.Player): boolean => false,
    pause: (media: player.Player): boolean => false,
    close: (media: player.Player): void => {},
    seek: (media: player.Player, ms: i64): boolean => false,
    position: (media: player.Player): i64 => 0i64,
  };
}

function no_downloads(): offline.Output {
  return offline.Output {
    start: (address: string, name: string, title: string): i64 => -1i64,
    status: (id: i64): i32 => 0,
    remove: (ids: i64[]): boolean => true,
    save: (entries: offline.Entry[], cleanup: i64[]): boolean => true,
  };
}

function simulator(own model: deck.Model): sim.Sim[deck.Model, deck.Msg] {
  let real = deck.program((address: string): boolean => false, (data: u8[]): Option[draw.Image] => None, (saved: Option[api.Session]): boolean => true, no_audio(), no_downloads(), (state: listening.Saved): boolean => true);
  let dry = ui.program(deck.view, deck.update).with_theme_of(real.theme).with_visible(deck.visible_posters);
  return sim.start(model, dry, test_fonts(), 720, 1600, 2.0);
}

function test_player_selection(): test.TestOutcome {
  let model = deck.Model {
    ...deck.start(),
    token: "test session",
    players: [api.Player { id: "first", name: "Bedroom", online: false }, api.Player { id: "second", name: "Living room", online: true }],
  };
  let sign_in = simulator(deck.start());
  preview(sign_in, "connect");
  let library = api.Library { players: model.players, cards: fixture_cards(), groups: Ok([]), note: "" };
  let s = sim.scaled(sim.themed(simulator(deck.update(model, deck.LibraryLoaded(Ok(library)))), true), 1.0);
  s = sim.tap(s, "Bedroom, Offline");
  s = sim.tap(s, "Library");
  if (sim.says(s, "Play Woodland Walk") || !sim.shows(s, "Bedroom is offline.")) {
    return test.fail("an offline player must not offer playback");
  }
  s = sim.tap(s, "Players");
  s = sim.tap(s, "Living room, Online");
  preview(s, "players");
  s = sim.tap(s, "Library");
  preview(s, "cards");
  if (!sim.says(s, "Play Woodland Walk")) {
    return test.fail("the card must offer playback for the selected online player");
  }
  s = sim.tap(s, "Play Woodland Walk");
  return test.assert_eq(s.shell.app.busy && s.shell.app.job.is_some() && s.shell.app.selected == "second", true);
}

function test_search_in_ui(): test.TestOutcome {
  let m = deck.Model { ...deck.start(), token: "test session" };
  let library = api.Library { players: [], cards: fixture_cards(), groups: Ok([]), note: "" };
  let s = simulator(deck.update(m, deck.LibraryLoaded(Ok(library))));
  s = sim.tap(s, "Library");
  s = sim.type_in(s, "library-search", "woodland dusk");
  if (!sim.shows(s, "Fox at dusk") || !sim.shows(s, "Woodland Walk") || !sim.shows(s, "Forest")) {
    return test.fail("the search result must show the matching track and its card");
  }
  s = sim.tap(s, "Tracks for Fox at dusk");
  return test.assert_eq(sim.shows(s, "Back to library") && sim.shows(s, "Fox at dusk"), true);
}

function test_saved_session(): test.TestOutcome {
  let original = api.Session { client: "client", refresh: "first" };
  let saved = cell_new(Some(original));
  let p = deck.program(
    (address: string): boolean => false,
    (data: u8[]): Option[draw.Image] => None,
    (current: Option[api.Session]): boolean => {
      saved.set(current);
      return true;
    },
    no_audio(),
    no_downloads(),
    (state: listening.Saved): boolean => true,
  );
  let m = deck.restored(Ok(Some(original)));
  if (p.wait(m) != 0 || m.client != "client") {
    return test.fail("the saved account must reconnect on launch");
  }
  let rotated = api.token_reply(200, json.parse("{\"access_token\":\"access\",\"refresh_token\":\"second\"}").unwrap_or(json.JNull));
  let auth = [worker.spawn((): Result[api.Tokens, api.Failure] => rotated)];
  let closed = p.close(deck.Model { ...m, reconnect: false, auth: auth, busy: true });
  let Some(token) = saved.get() else {
    return test.fail("the new refresh token must be saved during close");
  };
  let signed_out = p.effects(deck.update(deck.restored(Ok(Some(token))), deck.SignOut));
  return test.assert_eq(token.refresh == "second" && saved.get().is_none() && signed_out.refresh.len() == 0, true);
}

function test_token_errors(): test.TestOutcome {
  let revoked = json.parse("{\"error\":\"invalid_grant\"}").unwrap_or(json.JNull);
  let Err(expired) = api.token_reply(400, revoked) else {
    return test.fail("a revoked refresh token must require a new sign-in");
  };
  let Err(temporary) = api.token_reply(503, json.JNull) else {
    return test.fail("a server failure must report a retryable sign-in");
  };
  return test.assert_eq(expired.expired && !temporary.expired, true);
}

function library_sim(): sim.Sim[deck.Model, deck.Msg] {
  let players = [api.Player { id: "one", name: "Bedroom", online: true }, api.Player { id: "two", name: "Living room", online: true }];
  let m = deck.Model { ...deck.start(), token: "test session" };
  let library = api.Library { players: players, cards: fixture_cards(), groups: Ok([]), note: "" };
  return simulator(deck.update(m, deck.LibraryLoaded(Ok(library))));
}

function test_held_backspace(): test.TestOutcome {
  let s = sim.tap(library_sim(), "Library");
  s = sim.type_in(s, "library-search", "woodland");
  s = sim.event(s, android.Key(67, 0));
  s = sim.after(s, 700i64);
  let remaining = s.shell.app.shelf.query;
  s = sim.event(s, android.Key(67, 1));
  s = sim.after(s, 800i64);
  return test.assert_eq(remaining == "wood" && s.shell.app.shelf.query == remaining, true);
}

function test_successful_search_hides_sync_error(): test.TestOutcome {
  let s = sim.tap(library_sim(), "Library");
  let problem = api.Failure { ...api.failure("Network unavailable."), pause_index: true };
  let generation = s.shell.app.generation;
  s = sim.send(s, deck.TracksLoaded(generation, 0, Err(problem)));
  s = sim.type_in(s, "library-search", "woodland");
  if (!sim.shows(s, "Woodland Walk") || sim.shows(s, "Track search is incomplete. Network unavailable.")) {
    return test.fail("a search with matches must show the results without the sync error");
  }
  s = sim.type_in(s, "library-search", "no result");
  return test.assert_eq(sim.shows(s, "Track search is incomplete. Network unavailable."), true);
}

function test_player_playback(): test.TestOutcome {
  let Some(playing) = player_status.event("{\"playbackStatus\":\"playing\",\"cardId\":\"book\",\"trackTitle\":\"Fox at dusk\"}".bytes()) else {
    return test.fail("the player playback event must parse");
  };
  let s = sim.tap(library_sim(), "Bedroom, Online");
  let before = s.shell.app;
  s = sim.tap(s, "Living room, Online");
  s = sim.send(s, deck.PlaybackLoaded(before.generation, before.now_playing.revision, Ok(playing)));
  if (sim.shows(s, "Playing")) {
    return test.fail("a late status from the previous player must be ignored");
  }
  let state = s.shell.app;
  s = sim.send(s, deck.PlaybackLoaded(state.generation, state.now_playing.revision, Ok(player_status.Playback { ...playing, state: "paused" })));
  return test.assert_eq(sim.shows(s, "Paused") && sim.shows(s, "Woodland Walk") && sim.shows(s, "Fox at dusk"), true);
}

function search_position(s: sim.Sim[deck.Model, deck.Msg]): i32 {
  for node in s.shell.host.lay.nodes {
    if (node.tap.name == ui.FIELD_ACTION + "library-search") {
      return node.y;
    }
  }
  return -1;
}

function test_continuous_posters(): test.TestOutcome {
  let first = fixture_cards()[0];
  let cards: api.Card[] = [];
  let tracks: api.Track[] = [];
  for i in 0..22 {
    let title = "Track " + i.to_string();
    tracks = tracks.append(api.Track { title: title, chapter: "", chapter_key: "01", track_key: i.to_string(), search: title.to_lower(), art: "", chapter_art: "" });
  }
  for i in 0..22 {
    let id = "card-" + i.to_string();
    cards = cards.append(api.Card { ...first, id: id, title: "Cover " + i.to_string(), cover: "https://example.com/" + id, tracks: tracks });
  }
  let model = deck.Model { ...deck.start(), token: "test session", tab: 1 };
  let library = api.Library { players: [], cards: cards, groups: Ok([]), note: "" };
  let s = simulator(deck.update(model, deck.LibraryLoaded(Ok(library))));
  let grid = s.shell.host.lay.scrollers[0];
  if (grid.count != 11 || grid.row < 400 || !sim.says(s, "Tracks for Cover 0") || s.shell.app.shelf.first_art != 0) {
    return test.fail("the library must show large cover tiles in a single list");
  }
  let search_at_top = search_position(s);
  s = sim.settle(sim.drag(s, 160, 1250, 160, 770, 450i64));
  let pinned_at = search_position(s);
  if (pinned_at < 0 || pinned_at >= search_at_top || sim.says(s, "More options") || !s.shell.app.shelf.pinned) {
    return test.fail("the library header must scroll away and leave the search field at the top");
  }
  preview(s, "search-pinned");
  for i in 0..16 {
    if (sim.says(s, "Tracks for Cover 21") && s.shell.app.shelf.first_art >= 16) {
      break;
    }
    s = sim.settle(sim.drag(s, 160, 1450, 160, 580, 450i64));
  }
  if (!sim.says(s, "Tracks for Cover 21") || sim.shows(s, "Next") || s.shell.app.shelf.first_art < 16) {
    return test.fail("a swipe must reach titles and request their covers past the old page limits");
  }
  s = sim.tap(s, "Tracks for Cover 21");
  if (s.shell.host.lay.scrollers[0].count != 22) {
    return test.fail("card details must put every track in the same list");
  }
  s = sim.tap(s, "Back to library");
  if (!sim.says(s, "Tracks for Cover 21")) {
    return test.fail("opening a card must preserve the library's scroll position");
  }
  if (search_position(s) != pinned_at) {
    return test.fail("the search field must stay at the top throughout the scroll");
  }
  s = sim.type_in(s, "library-search", "woodland");
  if (s.shell.host.lay.scrollers[0].count != 11 || !sim.says(s, "Tracks for Cover 0") || search_position(s) != pinned_at) {
    return test.fail("search from the pinned field and return to the first result");
  }
  s = sim.settle(sim.drag(s, 160, 200, 160, 800, 450i64));
  return test.assert_eq(sim.says(s, "More options") && !s.shell.app.shelf.pinned && search_position(s) == search_at_top, true);
}

function test_signed_streams(): test.TestOutcome {
  let value = json.parse("{\"content\":{\"chapters\":[{\"key\":\"01\",\"display\":{\"icon16x16\":\"https://example.com/chapter.png\"},\"defaultTrackDisplay\":\"https://example.com/default.png\",\"tracks\":[{\"key\":\"01\",\"title\":\"Intro\",\"trackUrl\":\"yoto:#private\"},{\"key\":\"02\",\"title\":\"Forest\",\"display\":{\"icon16x16\":\"http://example.com/rejected.png\"},\"trackUrl\":\"https://example.com/forest.mp3?signature=sample\"}]},{\"key\":\"02\",\"tracks\":[{\"key\":\"01\",\"title\":\"The clearing\",\"trackUrl\":\"https://example.com/clearing.mp3\"}]}]}}").unwrap_or(json.JNull);
  let Ok(queue) = api.parse_streams(value, "01", "02") else {
    return test.fail("Yoto's signed URLs must form a playlist");
  };
  if (api.parse_streams(value, "", "").is_ok() || api.parse_streams(value, "01", "99").is_ok() || queue.len() != 2) {
    return test.fail("missing links or keys must not start a different track");
  }
  return test.assert_eq_array(
    [queue[0].title, queue[0].art, queue[1].title, queue[1].art],
    ["Forest", "https://example.com/default.png", "The clearing", ""],
  );
}

function test_phone_playback(): test.TestOutcome {
  let s = sim.tap(sim.tap(library_sim(), "This phone"), "Library");
  s = sim.tap(s, "Play Woodland Walk");
  let m = s.shell.app;
  if (!m.on_phone || m.job.is_none() || !sim.shows(s, "Play on this phone")) {
    return test.fail("the phone must be a selectable playback target");
  }
  let opened = cell_new([] as string[]);
  let closes = cell_new(0);
  let output = phone.Output {
    ...no_audio(),
    open: (address: string): Option[player.Player] => {
      let previous = opened.get();
      opened.set(previous.append(address));
      return Some(player.Player { obj: 1 as usize, listener: 1 as usize, slot: previous.len() });
    },
    start: (media: player.Player): boolean => true,
    pause: (media: player.Player): boolean => true,
    close: (media: player.Player): void => closes.set(closes.get() + 1),
  };
  let queue = [api.Stream { title: "Intro", url: "https://example.com/intro", chapter: "01", key: "01", art: "" }, api.Stream { title: "Fox at dusk", url: "https://example.com/fox", chapter: "01", key: "03", art: "" }];
  let state = phone.apply(phone.received(m.phone, m.phone.revision, Ok(queue)), output);
  let (prepared, arg) = player.posted(player.Prepared, 0);
  state = phone.apply(phone.event(state, android.Posted(prepared, arg)), output);
  state = phone.apply(phone.control(state, api.Pause), output);
  if let phone.Paused = state.phase {
    state = phone.apply(phone.control(state, api.Resume), output);
  } else {
    return test.fail("prepared phone audio must pause and resume");
  }
  let (ended, value) = player.posted(player.Completed, 0);
  state = phone.apply(phone.event(state, android.Posted(ended, value)), output);
  state = phone.apply(phone.event(state, android.Posted(ended, value)), output);
  if (state.at != 1 || closes.get() != 1) {
    return test.fail("completion advances once and releases the old audio");
  }
  state = phone.apply(phone.stop(state), output);
  state = phone.apply(phone.received(state, m.phone.revision, Ok(queue)), output);
  if (state.media.is_some() || closes.get() != 2) {
    return test.fail("stop releases the player and ignores a late stream response");
  }
  return test.assert_eq_array(opened.get(), ["https://example.com/intro", "https://example.com/fox"]);
}

function test_player_settings(): test.TestOutcome {
  let s = sim.tap(library_sim(), "Settings for Bedroom");
  let panel = s.shell.app.config_panel;
  let device = panel.device.unwrap_or(api.Player { id: "", name: "", online: false });
  if (device.id != "one" || !sim.shows(s, "Loading settings…")) {
    return test.fail("open settings for the player whose button was pressed");
  }
  let reply = json.parse("{\"device\":{\"deviceId\":\"one\",\"config\":{\"dayDisplayBrightness\":\"auto\",\"nightAmbientColour\":\"#112233\",\"alarms\":[\"keep\"],\"headphonesVolumeLimited\":true,\"unknown\":\"keep\"}}}").unwrap_or(json.JNull);
  let Ok(config) = api.parse_config(reply, device) else {
    return test.fail("parse the device config and retain its other fields");
  };
  s = sim.send(s, deck.ConfigLoaded(panel.revision - 1i64, false, Ok(config)));
  if (s.shell.app.config_panel.config.is_some()) {
    return test.fail("ignore a stale settings response");
  }
  s = sim.send(s, deck.ConfigLoaded(panel.revision, false, Ok(config)));
  if (!sim.shows(s, "Day display brightness")) {
    return test.fail("show the brightness setting from the API");
  }
  s = sim.slide(s, "Day display brightness", 0.35);
  let edited = s.shell.app.config_panel.draft;
  let Ok(changes) = settings.changes(config, edited.insert("headphonesVolumeLimited", "0")) else {
    return test.fail("brightness and headphone limit changes must validate");
  };
  let updated = api.merge_config(config, changes).values;
  if (json.get_string(updated, "dayDisplayBrightness").unwrap_or("") != "35"
    || json.get_string(updated, "unknown").unwrap_or("") != "keep"
    || json.get_array(updated, "alarms").unwrap_or([]).len() != 1
    || json.get_bool(updated, "headphonesVolumeLimited").unwrap_or(true)) {
    return test.fail("saving changes must retain unrelated settings and the stored JSON types");
  }
  if (settings.changes(config, edited.insert("nightAmbientColour", "blue")).is_ok()) {
    return test.fail("reject a light color that is not six hex digits");
  }
  let alarm = edited.insert("alarm-card", "book").insert("alarm-time", "06:30").insert("alarm-days", "1111100");
  let Ok(added) = settings.alarm_change(config, alarm, settings.Add) else {
    return test.fail("accept a scheduled alarm for a library card");
  };
  let Ok(disabled) = settings.alarm_change(config, added, settings.Toggle(1)) else {
    return test.fail("disable the new alarm without removing it");
  };
  let wire = json.encode(json.JArray(settings.alarms(config, disabled).unwrap_or([])));
  if (wire != "[\"keep\",\"1111100,06:30,book,,,5,0\"]") {
    return test.fail("add and disable an alarm while preserving the old alarm");
  }
  s = sim.tap(s, "Save");
  return test.assert_eq(s.shell.app.config_panel.working && s.shell.app.job.is_some(), true);
}

function test_offline_download(): test.TestOutcome {
  let card = fixture_cards()[0];
  let payload = "{\"ownership\":{\"canAccess\":true,\"cardIsInFamilyLibrary\":true},\"card\":{\"content\":{\"chapters\":[{\"key\":\"01\",\"tracks\":[{\"key\":\"03\",\"title\":\"Fox at dusk\",\"type\":\"audio\",\"display\":{\"iconUrl16x16\":\"https://example.com/fox.png\"},\"trackUrl\":\"https://example.com/fox?signature=sample\"}]}]}}}";
  let value = json.parse(payload).unwrap_or(json.JNull);
  let Ok(plan) = api.parse_download(value, card) else {
    return test.fail("a full-access purchased library card can download");
  };
  let stream = json.parse(payload.replace("\"audio\"", "\"stream\"")).unwrap_or(json.JNull);
  let online = json.parse(payload.replace("\"chapters\"", "\"config\":{\"onlineOnly\":true},\"chapters\"")).unwrap_or(json.JNull);
  let preview = json.parse(payload.replace("\"canAccess\":true", "\"canAccess\":true,\"previewAccessOnly\":true")).unwrap_or(json.JNull);
  let subscription = json.parse(payload.replace("\"canAccess\":true", "\"canAccess\":true,\"isAccessibleUsingSubscription\":true")).unwrap_or(json.JNull);
  let myo = json.parse(payload.replace("\"ownership\":{\"canAccess\":true,\"cardIsInFamilyLibrary\":true},", "")).unwrap_or(json.JNull);
  if (!api.parse_download(myo, api.Card { ...card, myo: true }).is_ok() || api.parse_download(stream, card).is_ok() || api.parse_download(online, card).is_ok()
    || api.parse_download(preview, card).is_ok() || api.parse_download(subscription, card).is_ok()) {
    return test.fail("save full audio for purchased and Make Your Own cards, and reject streams, previews, and online-only cards");
  }
  let Ok(dir) = temp_dir("story-deck-downloads") else {
    return test.fail("make an isolated store");
  };
  let status = cell_new(download.PENDING);
  let removed = cell_new(0);
  let disk = offline.Output {
    start: (address: string, name: string, title: string): i64 => 17i64,
    status: (id: i64): i32 => status.get(),
    remove: (ids: i64[]): boolean => {
      removed.set(removed.get() + ids.len());
      return true;
    },
    save: (entries: offline.Entry[], cleanup: i64[]): boolean => offline.save(dir, entries, cleanup),
  };
  let state = offline.empty(offline.load(dir, dir));
  let busy = offline.fetching(offline.enqueue(state, [card]), card);
  let started = offline.apply(offline.received(busy, busy.revision, Ok(plan)), disk);
  if (started.catalog.entries.len() != 1 || offline.saved(started, card.id).is_some()) {
    return test.fail("do not offer playback before Android completes the download");
  }
  status.set(download.DONE);
  let recovered = offline.empty(offline.load(dir, dir));
  let ready = offline.apply(offline.check(recovered), disk);
  let restored = deck.with_downloads(deck.start(), offline.load(dir, dir));
  let s = sim.tap(simulator(restored), "Play Woodland Walk");
  if (s.shell.app.token.len() != 0 || !s.shell.app.on_phone || s.shell.app.job.is_some() || s.shell.app.phone.queue.len() != 1) {
    return test.fail("play the downloaded card after restart without a Yoto session or request");
  }
  let file = s.shell.app.phone.queue[0].url;
  if (!file.starts_with("file://" + dir + "/yoto-offline-") || !file.ends_with(".audio")) {
    return test.fail("open a local audio file in airplane mode");
  }
  if (s.shell.app.phone.queue[0].art != "https://example.com/fox.png") {
    return test.fail("preserve the track artwork address with the download");
  }
  let cleared = offline.apply(offline.remove(ready, card.id), disk);
  let clean = offline.apply(offline.check(cleared), disk);
  return test.assert_eq(removed.get() == 1 && clean.catalog.entries.len() == 0 && offline.load(dir, dir).entries.len() == 0, true);
}

function test_download_work_batches(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-batch") else {
    return test.fail("make an isolated download store");
  };
  let enqueued = cell_new(0);
  let queried = cell_new(0);
  let removed = cell_new(0);
  let disk = offline.Output {
    start: (address: string, name: string, title: string): i64 => {
      let id = enqueued.get() + 1;
      enqueued.set(id);
      return id as i64;
    },
    status: (id: i64): i32 => {
      queried.set(queried.get() + 1);
      return download.DONE;
    },
    remove: (ids: i64[]): boolean => {
      removed.set(removed.get() + ids.len());
      return ids.len() <= 8;
    },
    save: (entries: offline.Entry[], cleanup: i64[]): boolean => offline.save(dir, entries, cleanup),
  };
  let card = fixture_cards()[0];
  let tracks: api.DownloadTrack[] = [];
  for i in 0..52 {
    tracks = tracks.append(api.DownloadTrack { title: i.to_string(), chapter: "01", key: i.to_string(), url: "https://example.com/track", art: "" });
  }
  let plan = api.DownloadPlan { id: card.id, title: card.title, creator: card.creator, tracks: tracks };
  let state = offline.fetching(offline.empty(offline.load(dir, dir)), card);
  state = offline.apply(offline.received(state, state.revision, Ok(plan)), disk);
  if (enqueued.get() > 4 || state.catalog.entries.len() != 0 || offline.load(dir, dir).cleanup.len() != enqueued.get()) {
    return test.fail("enqueue only a few tracks per turn and record unfinished setup for cleanup");
  }
  for i in 0..53 {
    if (offline.saved(state, card.id).is_some()) {
      break;
    }
    let starts = enqueued.get();
    let checks = queried.get();
    state = offline.apply(offline.check(state), disk);
    if (enqueued.get() - starts > 4 || queried.get() - checks > 4) {
      return test.fail("keep every download turn bounded");
    }
  }
  if (offline.saved(state, card.id).is_none() || removed.get() != 0) {
    return test.fail("commit all 52 tracks before marking the card ready");
  }
  state = offline.apply(offline.remove(state, card.id), disk);
  if (removed.get() != 0 || offline.saved(state, card.id).is_some()) {
    return test.fail("remove the card from the UI before calling Android to delete tracks");
  }
  state = offline.empty(offline.load(dir, dir));
  for i in 0..8 {
    state = offline.apply(offline.check(state), disk);
  }
  return test.assert_eq(removed.get() == 52 && offline.load(dir, dir).cleanup.len() == 0, true);
}

function test_library_download_filter(): test.TestOutcome {
  let cards = fixture_cards();
  let card = cards[0];
  let file = offline.Track { id: 1i64, name: "yoto-offline-sample.audio", title: "Fox at dusk", chapter: "01", key: "03", art: "" };
  let entry = offline.Entry { id: card.id, title: card.title, creator: card.creator, tracks: [file], ready: true };
  let catalog = offline.Catalog { dir: "/media", entries: [entry], cleanup: [], note: "" };
  let state = deck.with_downloads(deck.Model { ...deck.start(), token: "test session" }, catalog);
  let m = deck.update(state, deck.LibraryLoaded(Ok(api.Library { players: [], cards: cards, groups: Ok([]), note: "" })));
  let s = sim.tap(simulator(m), "Library");
  s = sim.tap(s, "Download Sky Journal");
  let queued = s.shell.app.downloads.queue;
  if (queued.len() != 1 || queued[0].title != "Sky Journal" || s.shell.app.tab != 1) {
    return test.fail("queue just the chosen card and stay in the library");
  }
  s = sim.tap(s, "Downloaded only, not checked");
  if (!sim.says(s, "Play Woodland Walk") || sim.says(s, "Tracks for Sky Journal")) {
    return test.fail("show only cards with a complete download in the filtered grid");
  }
  s = sim.tap(s, "Play Woodland Walk");
  let played = s.shell.app;
  return test.assert_eq(played.job.is_none() && played.phone.queue.len() == 1 && played.phone.queue[0].url == "file:///media/yoto-offline-sample.audio", true);
}

function test_settings_choices(): test.TestOutcome {
  let s = sim.tap(library_sim(), "Settings for Bedroom");
  let panel = s.shell.app.config_panel;
  let device = panel.device.unwrap_or(api.Player { id: "", name: "", online: false });
  let reply = json.parse("{\"device\":{\"config\":{\"clockFace\":\"digital-sun\",\"locale\":\"en\",\"shutdownTimeout\":\"900\",\"dayYotoDaily\":\"3nC80/daily/<yyyymmdd>\",\"nightYotoDaily\":\"3nC80/radio-night/01\"}}}").unwrap_or(json.JNull);
  let Ok(config) = api.parse_config(reply, device) else {
    return test.fail("parse the player settings fixture");
  };
  s = sim.send(s, deck.ConfigLoaded(panel.revision, false, Ok(config)));
  if (!sim.shows(s, "15 minutes") || !sim.shows(s, "English") || sim.shows(s, "digital-sun")) {
    return test.fail("show readable player setting values");
  }
  s = sim.tap(s, "Choose power off after");
  s = sim.tap(s, "1 hour");
  s = sim.tap(s, "Choose night first press");
  s = sim.tap(s, "Yoto Radio");
  s = sim.tap(s, "Choose day first press");
  s = sim.tap(s, "Choose from library");
  s = sim.tap(s, "Woodland Walk");
  s = sim.tap(s, "Fox at dusk");
  let edited = s.shell.app.config_panel.draft;
  return test.assert_eq(
    edited.get("shutdownTimeout").unwrap_or("") == "3600"
      && edited.get("nightYotoDaily").unwrap_or("") == "3nC80/radio-day/01"
      && edited.get("dayYotoDaily").unwrap_or("") == "book/01/03",
    true,
  );
}

function test_light_picker(): test.TestOutcome {
  for value in ["#000000", "#ffffff", "#112233", "#ff7300", "#2244aa", "#a3279c"] {
    let Some(colour) = light_colour.parse(value) else {
      return test.fail("read the player backlight colour");
    };
    if (light_colour.hex(colour) != value) {
      return test.fail("keep the exact colour when opening the picker");
    }
  }
  let s = sim.tap(library_sim(), "Settings for Bedroom");
  let panel = s.shell.app.config_panel;
  let device = panel.device.unwrap_or(api.Player { id: "", name: "", online: false });
  let reply = json.parse("{\"device\":{\"config\":{\"ambientColour\":\"#ff0000\",\"nightAmbientColour\":\"#112233\"}}}").unwrap_or(json.JNull);
  let Ok(config) = api.parse_config(reply, device) else {
    return test.fail("parse the player backlight settings");
  };
  s = sim.send(s, deck.ConfigLoaded(panel.revision, false, Ok(config)));
  s = sim.tap(s, "Choose Morning light color");
  s = sim.slide(s, "Hue", 0.5);
  s = sim.tap(s, "Cancel");
  if (s.shell.app.config_panel.draft.len() != 0) {
    return test.fail("cancel the preview without editing settings");
  }
  s = sim.tap(s, "Choose Nightlight color");
  preview(s, "light-colour");
  s = sim.tap(s, "Turn light off");
  s = sim.tap(s, "Use colour");
  let draft = s.shell.app.config_panel.draft;
  let changes = settings.changes(config, draft).unwrap_or([]);
  return test.assert_eq(changes.len() == 1 && changes[0].0 == "nightAmbientColour" && json.encode(changes[0].1) == "\"#000000\"", true);
}

function test_playback_tools(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-trip") else {
    return test.fail("create an isolated playback store");
  };
  let saved_track = offline.Track { id: 1i64, name: "yoto-offline-ready.audio", title: "Fox at dusk", chapter: "01", key: "03", art: "" };
  let missing = offline.Track { ...saved_track, id: 2i64, name: "yoto-offline-missing.audio", key: "04" };
  let ready = offline.Entry { id: "book", title: "Woodland Walk", creator: "A. Writer", tracks: [saved_track], ready: true };
  let incomplete = offline.Entry { id: "pod", title: "Sky Journal", creator: "", tracks: [missing], ready: true };
  let catalog = offline.Catalog { dir: dir, entries: [ready, incomplete], cleanup: [], note: "" };
  let written = write_file_bytes(dir + "/" + saved_track.name, "RIFF    WAVEfmt                     data    ".bytes());
  let item = listening.Item { id: ready.id, title: ready.title };
  let queued = listening.Item { id: incomplete.id, title: incomplete.title };
  let report = listening.check_trip(catalog, [item, queued]);
  if (written.is_err() || report.len() != 2 || report[0].present != 1 || report[1].present != 0) {
    return test.fail("mark only readable saved audio as ready for the trip");
  }
  let pin = listening.Bookmark { item: item, chapter: "01", key: "03", position: 38257i64 };
  let marked = listening.pin(listening.Saved { queue: [queued], marks: [], pins: [] }, listening.Bookmark { ...pin, position: 1234i64 });
  let store = listening.remember(marked, pin);
  if (!listening.save(dir, store)) {
    return test.fail("save the bookmark and queue");
  }
  let first = deck.with_downloads(deck.start(), catalog);
  let restored = listening.load(dir);
  let m = deck.update(deck.with_listening(first, restored), deck.ResumeCard(item.id));
  if (m.phone.resume_ms != 38257i64 || m.phone.card != "book" || m.job.is_some() || restored.pins[0].position != 1234i64) {
    return test.fail("restore exact local track and position after restart");
  }
  let media = player.Player { obj: 1 as usize, listener: 1 as usize, slot: 0 };
  let playing = deck.Model { ...m, phone: phone.State { ...m.phone, media: Some(media), phase: phone.Playing } };
  let timed = deck.update(playing, deck.SetSleep(1));
  let left = deck.playback_tick(timed, timed.playback_tools.sleep_at);
  if (left.playback_tools.sleep_at != 0i64 || left.playback_tools.note != "Sleep timer ended." || left.phone.action.is_none()) {
    return test.fail("schedule a pause when the sleep timer ends");
  }
  let (ended, value) = player.posted(player.Completed, 0);
  let advanced = deck.update(timed, deck.PhoneEvent(ended, value));
  return test.assert_eq(advanced.phone.card == "pod" && advanced.playback_tools.saved.queue.len() == 0 && listening.mark(advanced.playback_tools.saved, item.id).is_none(), true);
}

function test_search_scope(): test.TestOutcome {
  let cards = fixture_cards();
  let chapters = search.find_in(cards, "forest", 1, search.CHAPTERS);
  let titles = search.find_in(cards, "forest", 1, search.TITLES);
  let tracks = search.find_in(cards, "fox", 1, search.TRACKS);
  return test.assert_eq(
    chapters.len() == 1 && cards[chapters[0].card].tracks[chapters[0].track].chapter == "Forest"
      && titles.len() == 0 && tracks.len() == 1 && cards[tracks[0].card].tracks[tracks[0].track].title == "Fox at dusk",
    true,
  );
}

function shows_art(s: sim.Sim[deck.Model, deck.Msg], address: string): boolean {
  return s.shell.host.lay.nodes.any((node: scene.Node): boolean => match (node.paint) {
    scene.Picture(key, _, _) => key == address,
    _ => false,
  });
}

function artwork_simulator(own model: deck.Model): sim.Sim[deck.Model, deck.Msg] {
  let real = deck.program((address: string): boolean => false, (data: u8[]): Option[draw.Image] => Some(draw.Image { width: 1, height: 1, pixels: data }), (saved: Option[api.Session]): boolean => true, no_audio(), no_downloads(), (state: listening.Saved): boolean => true);
  let dry = ui.program(deck.view, deck.update).with_theme_of(real.theme).with_visible(deck.visible_posters).with_effects(real.effects);
  return sim.start(model, dry, test_fonts(), 720, 1600, 2.0);
}

function test_track_artwork(): test.TestOutcome {
  let art = "https://example.com/fox.png";
  let chapter = "https://card-content.yotoplay.com/yoto/_WWpLHoOj6iqeREcGkJnGlsis2QSF6znM0UPFdXTjf8";
  let first = fixture_cards()[0].tracks[0];
  if (first.art != art || first.chapter_art != chapter) {
    return test.fail("read a track icon URL and a chapter icon reference");
  }
  let ready = deck.Model { ...deck.start(), token: "test session", tab: 1 };
  let library = api.Library { players: [], cards: fixture_cards(), groups: Ok([]), note: "" };
  let s = artwork_simulator(deck.update(ready, deck.LibraryLoaded(Ok(library))));
  let generation = s.shell.app.generation;
  s = sim.send(s, deck.CoverLoaded(generation, art, [175u8, 157u8, 250u8, 255u8]));
  s = sim.send(s, deck.CoverLoaded(generation, chapter, [59u8, 206u8, 148u8, 255u8]));
  s = sim.type_in(s, "library-search", "Forest");
  s = sim.tap(s, "Chapters");
  if (!shows_art(s, chapter) || shows_art(s, art)) {
    return test.fail("chapter results use the chapter icon");
  }
  s = sim.type_in(s, "library-search", "Fox at dusk");
  s = sim.tap(s, "Tracks");
  if (!shows_art(s, art)) {
    return test.fail("track results use the track icon");
  }
  s = sim.tap(s, "Tracks for Fox at dusk");
  if (!shows_art(s, art) || s.shell.app.shelf.last_art == 0) {
    return test.fail("visible track rows use track icons");
  }
  let track = api.Stream { title: first.title, chapter: first.chapter_key, key: first.track_key, url: "https://example.com/fox.mp3", art: art };
  let phone = phone.State { ...phone.empty(), card: "book", phase: phone.Paused, queue: [track] };
  let playing = artwork_simulator(deck.Model { ...deck.start(), tab: 3, on_phone: true, phone: phone });
  let revision = playing.shell.app.generation;
  playing = sim.send(playing, deck.CoverLoaded(revision, art, [175u8, 157u8, 250u8, 255u8]));
  return test.assert_eq(shows_art(playing, art) && sim.shows(playing, "Paused · Fox at dusk"), true);
}

function test_launcher_icon(): test.TestOutcome {
  let frame = draw.offscreen(launcher_icon.SIZE, launcher_icon.SIZE);
  defer draw.release(frame);
  launcher_icon.render(frame);
  if let Some(path) = env("STORY_DECK_ICON") {
    if (!testkit.save_png(frame, path)) {
      return test.fail("write the Story Deck launcher icon");
    }
  }
  let colors = launcher_icon.theme(true);
  return test.assert_eq(frame.pixel(0, 0) == 0 && frame.pixel(72, 76) == colors.primary && frame.pixel(89, 89) == colors.on_primary, true);
}

function test_library_collections(): test.TestOutcome {
  let payload = "["
    + "{\"id\":\"favourites\",\"name\":\"Favourites\",\"items\":[{\"contentId\":\"club\"},{\"contentId\":\"missing\"}]}"
    + "]";
  let Ok(groups) = api.parse_groups(json.parse(payload).unwrap_or(json.JNull)) else {
    return test.fail("read the family groups response");
  };
  let cards = "{\"cards\":["
    + "{\"cardId\":\"book\",\"lastPlayedAt\":\"2026-09-18T21:40:00.000Z\",\"card\":{\"title\":\"Zebra stories\"}},"
    + "{\"cardId\":\"club\",\"lastPlayedAt\":\"2026-04-01T00:00:00Z\",\"card\":{\"title\":\"A Bear Tale\",\"clubAvailability\":[{\"store\":\"uk\"}]}},"
    + "{\"cardId\":\"sleep\",\"card\":{\"title\":\"Rain at Night\",\"metadata\":{\"category\":\"sfx\",\"list\":[\"sleep-sounds\"]}}},"
    + "{\"cardId\":\"mix\",\"reason\":\"myo-content-add\",\"card\":{\"title\":\"Mix Tape\"}}"
    + "]}";
  let Ok(cards) = api.parse_cards(json.parse(cards).unwrap_or(json.JNull), false) else {
    return test.fail("read the family library response");
  };
  let library = api.Library { players: [], cards: cards, groups: Ok(groups), note: "" };
  let ready = deck.Model { ...deck.start(), token: "test session", tab: 1 };
  let s = simulator(deck.update(ready, deck.LibraryLoaded(Ok(library))));
  preview(s, "library-collections");
  if (s.shell.app.shelf.hits[0].card != 0 || search.find(cards, "", search.SLEEP)[0].card != 2
    || search.find(cards, "", search.CLUB)[0].card != 1 || search.find(cards, "", 2)[0].card != 3) {
    return test.fail("use the service metadata for collections and last-played order");
  }
  s = sim.tap(s, "Sort order · Last played");
  if (s.shell.app.shelf.hits[0].card != 1) {
    return test.fail("sort the library by title");
  }
  s = sim.tap(s, "Show groups");
  s = sim.tap(s, "Favourites");
  if (s.shell.app.shelf.hits.len() != 1 || s.shell.app.shelf.hits[0].card != 1) {
    return test.fail("filter the library to the selected group and skip unavailable cards");
  }
  s = sim.tap(s, "All groups");
  let scrollers = s.shell.host.lay.scrollers;
  let Some(strip) = scrollers.find((list: ui.Scroller): boolean => list.name == "library-collections") else {
    return test.fail("the collections must be in a horizontal list");
  };
  let y = strip.y + strip.h / 2;
  s = sim.settle(sim.drag(s, 610, y, 190, y, 450i64));
  s = sim.tap(s, "Club Collection");
  if (s.shell.app.shelf.filter != search.CLUB || s.shell.app.shelf.hits.len() != 1) {
    return test.fail("swipe the collection filters and choose the Club Collection");
  }
  s = sim.type_in(s, "library-search", "zebra");
  return test.assert_eq(s.shell.app.shelf.hits.len() == 0 && sim.shows(s, "No matches in the current index."), true);
}

function test_account_menu(): test.TestOutcome {
  let s = library_sim();
  if (!sim.says(s, "More options") || sim.says(s, "Refresh") || sim.says(s, "Sign out")) {
    return test.fail("show only the account menu icon when the menu is closed");
  }
  s = sim.tap(s, "More options");
  if (!sim.says(s, "Refresh") || !sim.says(s, "Sign out")) {
    return test.fail("show refresh and sign-out actions in the menu");
  }
  s = sim.tap(s, "Refresh");
  return test.assert_eq(s.shell.app.busy && !s.shell.app.menu_open, true);
}

function main(): i32 {
  let r = test.new("Story Deck");
  r = r.it("PKCE matches the standard example", test_pkce);
  r = r.it("the callback requires the correct path and state", test_callback_matches_state);
  r = r.it("parse lists of players and cards", test_service_responses);
  r = r.it("the player commands follow the API format", test_playback_requests);
  r = r.it("family and Make Your Own cards merge with cover data", test_family_library);
  r = r.it("search covers tracks, episodes, stations and card metadata", test_search);
  r = r.it("track playback addresses the exact chapter and track", test_exact_track);
  r = r.it("the search box opens a matching track's card", test_search_in_ui);
  r = r.it("cards can play on a selected online player", test_player_selection);
  r = r.it("save a rotated session before close and clear it on sign-out", test_saved_session);
  r = r.it("distinguish token rejection from a retryable error", test_token_errors);
  r = r.it("hold Backspace in search and stop on release", test_held_backspace);
  r = r.it("a search with matches keeps the sync error out of the results", test_successful_search_hides_sync_error);
  r = r.it("show the selected player's paused track", test_player_playback);
  r = r.it("scroll a library of large covers past the former page limit", test_continuous_posters);
  r = r.it("start a phone playlist at the exact authorized track", test_signed_streams);
  r = r.it("select the phone and advance, pause, resume, and stop its audio", test_phone_playback);
  r = r.it("load and save settings for the selected player", test_player_settings);
  r = r.it("save a family card and open it without a Yoto session after restart", test_offline_download);
  r = r.it("queue, check, and remove 52-track downloads in bounded turns", test_download_work_batches);
  r = r.it("download one library card, filter saved cards, and prefer local playback", test_library_download_filter);
  r = r.it("choose named player settings, services, and library tracks", test_settings_choices);
  r = r.it("preview and apply the selected day or night light colour", test_light_picker);
  r = r.it("check trip files, restore a bookmark, and advance the queue with a sleep timer", test_playback_tools);
  r = r.it("find the exact chapter or track with search filters", test_search_scope);
  r = r.it("use chapter and track icons in search, track lists, and phone playback", test_track_artwork);
  r = r.it("draw the Story Deck launcher icon", test_launcher_icon);
  r = r.it("filter the library by collection and family group", test_library_collections);
  r = r.it("show account actions only in the menu", test_account_menu);
  return r.finish();
}
