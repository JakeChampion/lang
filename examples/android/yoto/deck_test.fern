    [api.command_name(api.Volume(70)), api.command_body(api.Volume(70)), api.command_name(api.DeviceSleep(900)), api.command_body(api.DeviceSleep(900))],
    ["volume/set", "{\"volume\":70}", "sleep-timer/set", "{\"seconds\":900}"],
  );
}

function test_downloaded_search_and_retry(): test.TestOutcome {
  let Ok(dir) = temp_dir("story-deck-retry-track") else {
    return test.fail("make a download store");
  };
  let original = fixture_cards()[0];
  let tracks = [
    api.DownloadTrack { title: "Intro", chapter: "01", key: "01", url: "https://example.com/intro", art: "" },
    api.DownloadTrack { title: "Fox at dusk", chapter: "01", key: "03", url: "https://example.com/fox", art: "" },
  ];
  let plan = api.DownloadPlan { id: original.id, title: original.title, creator: original.creator, tracks: tracks, card: Some(original) };
  let count = cell_new(0i64);
  let removed = cell_new([] as i64[]);
  let out = offline.Output {
    start: (address: string, name: string, title: string): i64 => {
      count.set(count.get() + 1i64);
      return count.get();
    },
    status: (id: i64): i32 => if (id == 2i64) { download.FAILED } else { download.DONE },
    remove: (ids: i64[]): boolean => {
      removed.set(removed.get().concat(ids));
      return true;
    },
    save: (entries: offline.Entry[], cleanup: i64[]): boolean => offline.save(dir, entries, cleanup),
  };
  let state = offline.empty(offline.load(dir, dir));
  let pending = offline.fetching(offline.enqueue(state, [original]), original);
  let started = offline.apply(offline.received(pending, pending.revision, Ok(plan)), out);
  let failed = offline.apply(offline.check(started), out);
  if (failed.catalog.entries[0].failed_at != 1 || removed.get().len() != 0) {
    return test.fail("retain all tracks after one file fails");
  }
  let rebuilt = offline.empty(offline.load(dir, dir));
  let retry = offline.retry(rebuilt, original.id);
  let request = offline.fetching(retry, original);
  let replaced = offline.apply(offline.received(request, request.revision, Ok(plan)), out);
  let cleaned = offline.apply(offline.check(replaced), out);
  let ready = offline.apply(offline.check(cleaned), out);
  let Some(entry) = offline.saved(ready, original.id) else {
    return test.fail("make the card ready after the failed file is replaced");
  };
  if (removed.get() != [2i64] || entry.tracks[0].id != 1i64 || entry.tracks[1].id != 3i64 || count.get() != 3i64) {
    return test.fail("retry just the failed track");
  }
  let m = deck.with_downloads(deck.start(), offline.load(dir, dir));
  let s = sim.tap(simulator(m), "Library");
  s = sim.type_in(s, "library-search", "fox");
  return test.assert_eq(s.shell.app.token.len() == 0 && sim.says(s, "Tracks for Fox at dusk") && s.shell.app.cards[0].cover == original.cover, true);
}

function test_scan_and_shop(): test.TestOutcome {
