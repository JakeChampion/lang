  let m = deck.Model { ...deck.start(), tab: 3, on_phone: true, phone: playback };
  let s = sim.tap(simulator(m), "Open now playing");
  if (!s.shell.app.now_open || !sim.says(s, "Track position") || !sim.shows(s, "0:02 / 1:05")) {
