function test_now_playing_controls(): test.TestOutcome {
  let track = api.Stream { title: "Fox at dusk", url: "file:///sample.audio", chapter: "01", key: "03", art: "" };
  let audio = player.Player { obj: 1 as usize, listener: 1 as usize, slot: 0 };
