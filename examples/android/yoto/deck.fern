function empty_shelf(): Shelf {
  return Shelf {
    hits: [], query: "", filter: 0, group: "", groups: [], groups_open: false, groups_note: "", by_title: false, pinned: false, downloaded_only: false, search_scope: search.ALL, search_revision: 0i64, search_serial: 0i64, search_due: 0i64, search_busy: false,
    search_at: 0, search_matches: [], search_cache: map_new(8), background_search: false, search_keys: [], sections: [], personal: "", personal_open: false, opened: "", first_art: 0, last_art: 0, next: 0, paused: "", attempted: map_new(64), note: "", covers: map_new(48), cover_order: [], received: None,
  };
}

function panel(revision: i64): ConfigPanel {
  return ConfigPanel { revision: revision, device: None, config: None, draft: map_new(24), working: false, note: "", picker: None, query: "" };
}

function tools(saved: listening.Saved): PlaybackTools {
  return PlaybackTools { saved: saved, dirty: false, sample: false, bookmark_now: false, bookmark_name: "", naming_bookmark: false, sample_at: 0i64, sleep_at: 0i64, trip_running: false, history_open: false, history_filter: 0, profile_open: false, profile_name: "", profile_target: "", trip_focus: "", trip_test_until: 0i64, draft: None, trip: [], note: "" };
}

pub function start(): Model {
  let downloads = offline.empty(offline.Catalog { dir: "", entries: [], cleanup: [], note: "" });
  return Model { client: "", token: "", refresh: "", reconnect: false, auth: [], storage: None, session_note: "", load_after_auth: false, players: [], cards: [], shelf: empty_shelf(), generation: 0i64, background_busy: false, cover_busy: false, cover_active: "", cover_stop: -1, cover_pipe: (): (i32, i32) => (-1, -1), art_dir: "", warmed: map_new(64), trip_select: false, trip_cards: map_new(32), selected: "", on_phone: false, phone: phone.empty(), playback_tools: tools(listening.empty()), travel_panel: travel_panel(), now_playing: NowPlaying { revision: 0i64, requested: false, due: 0i64, running: false, playback: None, note: "" }, now_open: false, expanded_art: None, target_open: false, tools_page: panel_tools.empty(), audio_revision: 0i64, audio_editor: None, editing_group: None, device_status: None, device_note: "", volume: 50, config_panel: panel(0i64), downloads: downloads, offline_open: "", tab: 0, tab_history: [], menu_open: false, note: "", library_loaded: false, cache_dir: "", cache_available: false, changed_index: 0i64, stored_index: 0i64, index_saving: false, wifi: false, retry_download_at: 0i64, wifi_requeue: "", parent: closed_gate(), shortcut: "", launch_action: "", transfer_from: "", transfer_revision: 0i64, transfer_target: "", transfer_note: "", enrich_downloads: false, busy: false, open_login: false, flow: None, job: None };
}

function signed_out(m: Model, note: string): Model {
  let first = start();
  if (!m.tools_page.busy) {
    panel_tools.clear_audio(m.tools_page.draft);
  }
  return Model { ...first, client: m.client, generation: m.generation + 1i64, background_busy: m.background_busy, cover_busy: m.cover_busy, cover_active: m.cover_active, cover_stop: m.cover_stop, cover_pipe: m.cover_pipe, art_dir: m.art_dir, cache_dir: m.cache_dir, phone: phone.stop(m.phone), playback_tools: PlaybackTools { ...first.playback_tools, dirty: true }, now_playing: NowPlaying { ...first.now_playing, running: m.now_playing.running }, config_panel: panel(m.config_panel.revision + 1i64), tools_page: panel_tools.State { ...first.tools_page, import_id: m.tools_page.import_id }, downloads: offline.clear(m.downloads), note: note };
}

pub function with_downloads(m: Model, catalog: offline.Catalog): Model {
  let downloads = offline.empty(catalog);
  if (m.token.len() == 0) {
    let cards = offline.saved_cards(downloads);
    return found(Model { ...m, downloads: downloads, cards: cards, tab: if (catalog.entries.len() > 0) { 2 } else { m.tab } });
  }
  return Model { ...m, downloads: downloads };
}

pub function with_art(m: Model, dir: string): Model {
  return Model { ...m, art_dir: dir };
}

pub function with_cover_pipe(m: Model, open_pipe: () => (i32, i32)): Model {
  return Model { ...m, cover_pipe: open_pipe };
}

function close_pipe(fd: i32): void {
  if (fd >= 0) {
    unsafe {
      let closed = __fd_close(fd);
    }
  }
}

pub function with_listening(m: Model, saved: listening.Saved): Model {
  return Model { ...m, playback_tools: tools(saved), downloads: offline.restore_pending(offline.restore_held(m.downloads, saved.held_downloads), saved.downloads) };
}

pub function with_index(m: Model, dir: string, cards: api.Card[]): Model {
  return found(Model { ...m, cache_dir: dir, cache_available: cards.len() > 0, cards: api.merge_cards(cards, m.cards) });
}

pub function with_wifi(m: Model, ready: boolean): Model {
  return Model { ...m, wifi: ready, retry_download_at: if (ready && !m.wifi) { 0i64 } else { m.retry_download_at } };
}

pub function shortcut_received(m: Model, action: string): Model {
  if (action.starts_with("dev.fern.storydeck.")) {
    return Model { ...m, launch_action: action };
  }
  return m;
}

pub function shortcut_result_notice(m: Model, accepted: boolean): Model {
  let note = if (accepted) { "Confirm the shortcut on your home screen." } else { "This launcher could not add the shortcut." };
  return Model { ...m, shortcut: "", note: note, playback_tools: PlaybackTools { ...m.playback_tools, note: note } };
}

pub function restored(saved: Result[Option[api.Session], string]): Model {
  let m = start();
  match (saved) {
    Ok(Some(session)) => {
      return Model { ...m, client: session.client, refresh: session.refresh, reconnect: true, note: "Reconnecting to Yoto…" };
    },
    Err(note) => {
      return Model { ...m, note: note };
    },
    _ => {
      return m;
    }
  }
}

function forget(m: Model, note: string): Model {
  if (m.refresh.len() > 0) {
    return Model { ...m, reconnect: false, note: note, storage: Some(ClearSession) };
  }
  return signed_out(m, note);
}

function renew(m: Model): Model {
  let session = api.Session { client: m.client, refresh: m.refresh };
  let works = [worker.spawn((): Result[api.Tokens, api.Failure] => api.renew(session))];
  return Model { ...m, token: "", reconnect: false, auth: works, generation: m.generation + 1i64, busy: true, note: "Reconnecting to Yoto…" };
}

function accept_auth(m: Model, result: Result[api.Tokens, api.Failure]): Model {
  match (result) {
    Ok(tokens) => {
      let note = if (tokens.refresh.len() == 0) { "This Yoto sign-in is available for this session only." } else { "" };
      return Model { ...m, token: tokens.access, refresh: tokens.refresh, storage: Some(SaveSession), session_note: note, load_after_auth: true };
    },
    Err(err) => {
      if (err.expired) {
        return found(Model {
          ...m, token: "", refresh: "", busy: false, note: err.message, storage: Some(ClearAuth),
          selected: "", cards: offline.saved_cards(m.downloads), library_loaded: false, tab: 0, tab_history: [], cache_available: false,
        });
      }
      return Model { ...m, busy: false, note: err.message };
    }
  }
}

function poll_auth(own m: Model): Model {
  let next = Model { ...m, auth: [] };
  for work in m.auth {
    match (work.poll()) {
      worker.Running(again) => {
        return Model { ...next, auth: [again] };
      },
      worker.Finished(result) => {
        return accept_auth(next, result);
      }
    }
  }
  return next;
}

function save_session(m: Model, persist: (Option[api.Session]) => boolean): Model {
  let Some(action) = m.storage else {
    return m;
  };
  let next = Model { ...m, storage: None };
  if let ClearAuth = action {
    library_cache.clear(m.cache_dir);
    if (persist(None)) {
      return next;
    }
    return Model { ...next, session_note: "Could not clear the expired sign-in." };
  }
  if let ClearSession = action {
    if (persist(None)) {
      library_cache.clear(m.cache_dir);
      return signed_out(next, next.note);
    }
    return Model { ...next, note: "Could not clear the saved sign-in. Try signing out again." };
  }
  let remembered: Option[api.Session] = None;
  if (next.refresh.len() > 0) {
    remembered = Some(api.Session { client: next.client, refresh: next.refresh });
  }
  if (!persist(remembered)) {
    return Model { ...next, session_note: "Could not save this sign-in on your device." };
  }
  return next;
}

function close_app(own m: Model, persist: (Option[api.Session]) => boolean): Model {
  let clean = cancel(m);
  let next = Model { ...clean, auth: [] };
  for work in clean.auth {
    // A refresh token can rotate while Android closes the activity.
    let done = save_session(accept_auth(next, work.join()), persist);
    return Model { ...done, load_after_auth: false, busy: false };
  }
  return next;
}

pub function tools_update(m: Model, state: panel_tools.State): Model {
  return Model { ...m, tools_page: state };
}

function scan_card(own m: Model, raw: string): Model {
  let id = api.scan_code(raw);
  let scanner = m.tools_page;
  let action = if (scanner.scanning) { Some(panel_tools.ScanStop) } else { None };
  let next = panel_tools.State { ...scanner, scanning: false, action: action, scan_result: None };
  if (id.len() == 0) {
    return tools_update(m, panel_tools.State { ...next, note: "No Yoto card code found. Try scanning the card again." });
  }
  let source = if (raw.trim().starts_with("https://yoto.io/")) { raw.trim().to_owned() } else { id };
  if let Some(card) = m.cards.find((card: api.Card): boolean => card.id == id) {
    return tools_update(m, panel_tools.State { ...next, address: source, scan_result: Some(card), note: "" });
  }
  let entered = panel_tools.State { ...next, address: source };
  if (m.token.len() == 0) {
    return tools_update(m, panel_tools.State { ...entered, note: "Connect your account to look up this card." });
  }
  return Model { ...m, tools_page: panel_tools.State { ...entered, busy: true, note: "Looking up the card…" }, job: Some(LookUpCard(m.generation, m.token, id)) };
}

function change_chapter(s: panel_tools.State, index: i32, title: string): panel_tools.State {
  if (index < 0 || index >= s.draft.chapters.len()) {
    return s;
  }
  let parts = s.draft.chapters;
  return panel_tools.State { ...s, draft: api.Playlist { ...s.draft, chapters: parts.with(index, api.Chapter { ...parts[index], title: title }) } };
}

function move_chapter(s: panel_tools.State, from: i32, to: i32): panel_tools.State {
  return panel_tools.State { ...s, draft: api.Playlist { ...s.draft, chapters: array.moved(s.draft.chapters, from, to) } };
}

function save_draft(own m: Model): Model {
  let tool = m.tools_page;
  let name = tool.draft.title.trim().to_owned();
  if (m.token.len() == 0 || tool.busy || tool.recording || tool.importing || name.len() == 0 || tool.draft.chapters.len() == 0) {
    return m;
  }
  if (tool.draft.chapters.len() > api.MAX_PLAYLIST_CHAPTERS) {
    return tools_update(m, panel_tools.State { ...tool, note: "A playlist can have up to 100 chapters." });
  }
  let draft = api.Playlist { ...tool.draft, title: name };
  return Model { ...m, tools_page: panel_tools.State { ...tool, busy: true, note: "Saving your playlist to Yoto…" }, job: Some(WritePlaylist(m.generation, m.token, draft)) };
}

function open_group(m: Model, id: string): Model {
  if (m.token.len() == 0 || m.editing_group.is_some()) {
    return m;
  }
  let blank = GroupEdit { local: false, id: "", name: "", members: [], image: "", query: "", confirm: false, busy: false, note: "" };
  let editor = m.shelf.groups.find((g: api.Group): boolean => g.id == id).map((g: api.Group): GroupEdit => GroupEdit { ...blank, id: g.id, name: g.name, members: g.members, image: g.image }).unwrap_or(blank);
  return Model { ...m, editing_group: Some(editor) };
}

function personal_collection(m: Model, name: string): Option[listening.Collection] {
  return m.playback_tools.saved.collections.find((item: listening.Collection): boolean => item.name == name);
}

function use_personal(m: Model, name: string): Model {
  let shelf = Shelf { ...m.shelf, personal: name, group: "" };
  if (name.len() == 0) {
    shelf = Shelf { ...shelf, filter: 0, downloaded_only: false, search_scope: search.ALL };
  }
  if let Some(item) = personal_collection(m, name) {
    shelf = Shelf { ...shelf, downloaded_only: item.available, filter: item.category, search_scope: item.scope };
  }
  return found(Model { ...m, shelf: reset_grid(shelf), editing_group: None });
}

function edit_personal(m: Model, name: string): Model {
  let blank = GroupEdit { local: true, id: name, name: name, members: [], image: "", query: "", confirm: false, busy: false, note: "" };
  if let Some(item) = personal_collection(m, name) {
    blank = GroupEdit { ...blank, members: item.cards };
  }
  return Model { ...m, editing_group: Some(blank) };
}

function save_personal(m: Model, edit: GroupEdit): Model {
  let title = edit.name.trim().to_owned();
  if (title.len() == 0 || title.len() > 56) {
    return group_problem(m, "Enter a collection name of up to 56 characters.");
  }
  if (title != edit.id && personal_collection(m, title).is_some()) {
    return group_problem(m, "That name is already in use.");
  }
  let saved = m.playback_tools.saved;
  let keep = saved.collections.filter((item: listening.Collection): boolean => item.name != edit.id);
  let shelf = m.shelf;
  let collection = listening.Collection { name: title, cards: edit.members, available: shelf.downloaded_only, category: shelf.filter, scope: shelf.search_scope };
  return use_personal(set_saved(m, listening.Saved { ...saved, collections: keep.append(collection) }), title);
}

function changed_groups(m: Model, groups: api.Group[], selected: string): Model {
  return found(Model { ...m, editing_group: None, shelf: reset_grid(Shelf { ...m.shelf, groups: groups, group: selected }) });
}

function group_problem(m: Model, message: string): Model {
  if let Some(edit) = m.editing_group {
    return Model { ...m, editing_group: Some(GroupEdit { ...edit, busy: false, confirm: false, note: message }) };
  }
  return m;
}

function selected_group(shelf: Shelf): Option[api.Group] {
  if (shelf.group.len() > 0) {
    return shelf.groups.find((group: api.Group): boolean => group.id == shelf.group);
  }
  return None;
}

function reset_grid(shelf: Shelf): Shelf {
  return Shelf { ...shelf, search_revision: shelf.search_revision + 1i64, first_art: 0, last_art: 0 };
}

function search_work(m: Model, first: i32, last: i32): SearchWork {
  let shelf = m.shelf;
  let group = selected_group(shelf);
  let local = personal_collection(m, shelf.personal);
  let restricted = group.is_some() || local.is_some() || shelf.downloaded_only;
  let slice = array.slice(m.cards, first, last);
  let members: Map[string, boolean] = map_new(32);
  if let Some(collection) = local {
    for id in collection.cards {
      members = members.insert(id, true);
    }
  }
  let ready: Map[string, boolean] = map_new(32);
  if (shelf.downloaded_only) {
    for entry in m.downloads.catalog.entries {
      if (entry.ready) {
        ready = ready.insert(entry.id, true);
      }
    }
  }
  let allowed: Map[string, boolean] = map_new(32);
  if (restricted) {
    for card in slice {
      if (group.map((entry: api.Group): boolean => entry.cards.contains(card.id)).unwrap_or(true)
        && (local.map((entry: listening.Collection): boolean => entry.cards.len() == 0).unwrap_or(true) || members.contains(card.id)) && (!shelf.downloaded_only || ready.contains(card.id))) {
        allowed = allowed.insert(card.id, true);
      }
    }
  }
  return SearchWork {
    serial: shelf.search_serial, cards: slice, query: shelf.query, category: shelf.filter, scope: shelf.search_scope,
    restricted: restricted, allowed: allowed, first: first,
  };
}

function search_part(work: SearchWork): search.Hit[] {
  let hits = search.find_in(work.cards, work.query, work.category, work.scope);
  if (work.restricted) {
    hits = hits.filter((hit: search.Hit): boolean => work.allowed.contains(work.cards[hit.card].id));
  }
  if (work.first == 0) {
    return hits;
  }
  return hits.map((hit: search.Hit): search.Hit => search.Hit { card: hit.card + work.first, track: hit.track });
}

function make_matches(cards: api.Card[], hits: search.Hit[], title: boolean, grouped: boolean): Matches {
  let sections: i32[] = [];
  if (grouped) {
    let title_count = 0;
    let track_count = 0;
    let radio_count = 0;
    for hit in hits {
      match (search.section(hit, cards)) {
        0 => {
          title_count += 1;
        },
        1 => {
          track_count += 1;
        },
        _ => {
          radio_count += 1;
        }
      }
    }
    sections = [title_count, track_count, radio_count];
  }
  return Matches { hits: search.order(hits, cards, title, grouped), sections: sections };
}

function show_hits(m: Model, result: Matches): Model {
  return Model { ...m, shelf: Shelf { ...m.shelf, hits: result.hits, sections: result.sections, search_due: 0i64, search_at: 0, search_matches: [] } };
}

function edit_search(m: Model, query: string, clear_cache: boolean): Model {
  let shelf = m.shelf;
  let ready = Shelf {
    ...shelf, query: query, search_serial: shelf.search_serial + 1i64, search_at: 0, search_matches: [],
    search_cache: if (clear_cache) { map_new(8) } else { shelf.search_cache }, search_keys: if (clear_cache) { [] } else { shelf.search_keys },
  };
  let next = Model { ...m, shelf: ready };
  let key = query.trim().to_lower();
  if let Some(hits) = ready.search_cache.get(key) {
    return show_hits(next, hits);
  }
  if (key.len() > 0 && shelf.background_search) {
    let at = if (clear_cache && shelf.search_due > 0i64) { shelf.search_due } else { monotonic_ns() + 75000000i64 };
    return Model { ...next, shelf: Shelf { ...ready, hits: [], sections: [], search_due: at } };
  }
  let work = search_work(next, 0, m.cards.len());
  return show_hits(next, make_matches(m.cards, search_part(work), shelf.by_title, key.len() > 0));
}

function large_search(cards: api.Card[]): boolean {
  if (cards.len() >= 160) {
    return true;
  }
  let tracks = 0;
  for card in cards {
    tracks += card.tracks.len();
    if (tracks >= 3000) {
      return true;
    }
  }
  return false;
}

function found(m: Model): Model {
  let shelf = Shelf { ...m.shelf, background_search: large_search(m.cards) };
  return edit_search(Model { ...m, shelf: shelf }, shelf.query, true);
}

function collected_search(m: Model, serial: i64, next_at: i32, hits: search.Hit[]): Model {
  let shelf = Shelf { ...m.shelf, search_busy: false };
  if (serial != shelf.search_serial) {
    return Model { ...m, shelf: shelf };
  }
  return Model { ...m, shelf: Shelf { ...shelf, search_at: next_at, search_matches: shelf.search_matches.concat(hits), search_due: monotonic_ns() } };
}

function finished_search(m: Model, serial: i64, hits: Matches): Model {
  let shelf = Shelf { ...m.shelf, search_busy: false };
  if (serial != shelf.search_serial) {
    return Model { ...m, shelf: shelf };
  }
  let key = shelf.query.trim().to_lower();
  let keys = shelf.search_keys;
  let cache = shelf.search_cache;
  if (keys.len() >= 8) {
    cache = cache.remove(keys[0]);
    keys = keys.drop(1);
  }
  return show_hits(Model { ...m, shelf: Shelf { ...shelf, search_cache: cache.insert(key, hits), search_keys: keys.append(key) } }, hits);
}

function card_index(m: Model, id: string): i32 {
  if (id.len() > 0) {
    for i in 0..m.cards.len() {
      if (m.cards[i].id == id) {
        return i;
      }
    }
  }
  return -1;
}

function opened_index(m: Model): i32 {
  return card_index(m, m.shelf.opened);
}

function opened_card(m: Model): Option[api.Card] {
  let i = opened_index(m);
  if (i >= 0) {
    return Some(m.cards[i]);
  }
  return None;
}

function needs_tracks(shelf: Shelf, card: api.Card): boolean {
  return !card.indexed && !shelf.attempted.contains(card.id);
}

function load_tracks(m: Model, index: i32, next: i32): Model {
  let card = m.cards[index];
  let attempted = m.shelf.attempted.insert(card.id, true);
  return Model { ...m, background_busy: true, shelf: Shelf { ...m.shelf, next: next, attempted: attempted }, job: Some(Tracks(m.generation, index, m.token, card)) };
}

function artwork(shelf: Shelf, address: string, fallback: string): string {
  if (address.len() == 0) {
    return fallback;
  }
  if let Some(None()) = shelf.covers.get(address) {
    return fallback;
  }
  return address;
}

function thumbnail(m: Model, card: api.Card): string {
  if (m.token.len() == 0) {
    return card.cover;
  }
  return artwork(m.shelf, card.thumb, card.cover);
}

function hit_art(m: Model, hit: search.Hit): string {
  let card = m.cards[hit.card];
  let thumb = thumbnail(m, card);
  if (hit.track >= 0) {
    let track = card.tracks[hit.track];
    let address = if (m.shelf.search_scope == search.CHAPTERS) { track.chapter_art } else { track.art };
    return artwork(m.shelf, address, thumb);
  }
  return thumb;
}

function keyed_art(m: Model, id: string, chapter: string, key: string, address: string): string {
  let i = card_index(m, id);
  if (i < 0) {
    return address;
  }
  let card = m.cards[i];
  let preferred = address;
  if (preferred.len() == 0) {
    for track in card.tracks {
      if (track.chapter_key == chapter && track.track_key == key) {
        preferred = track.art;
        break;
      }
    }
  }
  return artwork(m.shelf, preferred, card.cover);
}

function phone_art(m: Model): string {
  let s = m.phone;
  if (s.at >= 0 && s.at < s.queue.len()) {
    let track = s.queue[s.at];
    return keyed_art(m, s.card, track.chapter, track.key, track.art);
  }
  let i = card_index(m, s.card);
  return if (i >= 0) { m.cards[i].cover } else { "" };
}

function player_art(m: Model, playback: player_status.Playback): string {
  let i = card_index(m, playback.card);
  if (i < 0) {
    return "";
  }
  let card = m.cards[i];
  for track in card.tracks {
    if ((playback.chapter.len() == 0 || track.chapter == playback.chapter) && track.title == playback.track) {
      return artwork(m.shelf, track.art, card.cover);
    }
  }
  return card.cover;
}

function needs_cover(shelf: Shelf, address: string): boolean {
  return address.len() > 0 && !shelf.covers.contains(address);
}

function playback_art(m: Model): string {
  if (m.on_phone) {
    return phone_art(m);
  }
  if (m.tab == 0 && m.config_panel.device.is_none()) {
    if let Some(playback) = m.now_playing.playback {
      if (playback.state == "playing" || playback.state == "paused") {
        return player_art(m, playback);
      }
    }
  }
  return "";
}

function phone_cover(m: Model): string {
  let id = m.phone.card;
  let i = card_index(m, id);
  if (i >= 0 && m.cards[i].cover.len() > 0) {
    return m.cards[i].cover;
  }
  return offline.saved(m.downloads, id).map((entry: offline.Entry): string => offline.card(entry).cover).unwrap_or("");
}

function playback_pictures(m: Model): string[] {
  let current = playback_art(m);
  if (m.on_phone && m.phone.card.len() > 0) {
    return [phone_cover(m), current];
  }
  return [current];
}

pub function media_artwork(m: Model): (string, Option[draw.Image]) {
  for address in [phone_cover(m), phone_art(m)] {
    if let Some(Some(art)) = m.shelf.covers.get(address) {
      return (address, Some(art.image));
    }
  }
  return ("", None);
}

function featured_art(shelf: Shelf, cover: string, detail: string): (string, string) {
  let poster = artwork(shelf, cover, "");
  if (detail.len() == 0 || detail == cover) {
    return (poster, "");
  }
  if let Some(Some(image)) = shelf.covers.get(detail) {
    if (image.source_size >= 128) {
      return (detail, "");
    }
  }
  return (poster, artwork(shelf, detail, ""));
}

function visible_covers(m: Model): string[] {
  let shelf = m.shelf;
  if (m.playback_tools.saved.kids) {
    let liked = m.playback_tools.saved.favourites;
    return array.slice(liked, shelf.first_art, shelf.last_art).map((item: listening.Item): string => {
      let at = card_index(m, item.id);
      return if (at >= 0) { m.cards[at].cover } else { "" };
    });
  }
  if (m.tab == 1) {
    if let Some(card) = opened_card(m) {
      let visible = array.slice(card.tracks, shelf.first_art, shelf.last_art);
      return [card.cover].concat(visible.map((track: api.Track): string => artwork(shelf, track.art, card.cover)));
    }
    let visible = array.slice(shelf.hits, shelf.first_art, shelf.last_art);
    let addresses: string[] = [];
    for hit in visible {
      if (hit.track >= 0) {
        addresses = addresses.append(thumbnail(m, m.cards[hit.card]));
      }
      addresses = addresses.append(hit_art(m, hit));
    }
    return addresses;
  }
  if (m.tab == 2) {
    if let Some(entry) = offline.saved(m.downloads, m.offline_open) {
      let visible = array.slice(entry.tracks, shelf.first_art, shelf.last_art);
      return visible.map((track: offline.Track): string => keyed_art(m, entry.id, track.chapter, track.key, track.art));
    }
  }
  return [];
}

function next_cover(m: Model): string {
  for address in playback_pictures(m) {
    if (needs_cover(m.shelf, address)) {
      return address;
    }
  }
  for address in visible_covers(m) {
    if (needs_cover(m.shelf, address)) {
      return address;
    }
  }
  return "";
}

function grid_name(shelf: Shelf): string {
  return "library:" + shelf.search_revision.to_string();
}

pub function visible_posters(m: Model, screen: ui.Screen, layout: ui.Layout, input: ui.Input): Option[Msg] {
  let name = "";
  let cols = 1;
  let grid = false;
  if (m.playback_tools.saved.kids) {
    name = "kids-favourites";
    cols = 2;
  } else if (m.tab == 1) {
    if (m.shelf.opened.len() > 0) {
      name = "tracks:" + m.shelf.opened;
    } else {
      name = grid_name(m.shelf);
      cols = poster_columns(m, screen);
      grid = true;
    }
  } else if (m.tab == 2 && m.offline_open.len() > 0) {
    name = "saved:" + m.offline_open;
  } else {
    return None;
  }
  for list in layout.scrollers {
    if (list.name == name && list.row > 0) {
      let (start, end) = list.visible_rows();
      let first = start * cols;
      let last = if (end > start) { (end + 1).min(list.count) * cols } else { first };
      if (grid) {
        let (from, _, _) = row_hits(m.shelf, start, cols);
        let (_, to, _) = row_hits(m.shelf, end.max(start + 1) - 1, cols);
        first = from;
        last = if (end > start) { to } else { from };
      }
      let pinned = if (grid) { list.pinned } else { m.shelf.pinned };
      if (first != m.shelf.first_art || last != m.shelf.last_art || pinned != m.shelf.pinned) {
        return Some(PostersVisible(first, last, pinned));
      }
    }
  }
  return None;
}

function warm_art(m: Model): string {
  if (m.token.len() == 0 || m.art_dir.len() == 0) {
    return "";
  }
  for entry in m.downloads.catalog.entries {
    let info = offline.card(entry);
    if (info.cover.len() > 0 && !m.warmed.contains(info.cover)) {
      return info.cover;
    }
    for track in info.tracks {
      for image in [track.art, track.chapter_art] {
        if (image.len() > 0 && !m.warmed.contains(image)) {
          return image;
        }
      }
    }
  }
  return "";
}

function needs_index_save(m: Model): boolean {
  if (!m.library_loaded || m.token.len() == 0 || m.cache_dir.len() == 0 || m.index_saving || m.changed_index <= m.stored_index) {
    return false;
  }
  return m.stored_index == 0i64 || m.changed_index - m.stored_index >= 50i64 || !m.background_busy && (m.shelf.next >= m.cards.len() || m.shelf.paused.len() > 0);
}

function prepare_background(own m: Model): Model {
  let shelf = m.shelf;
  if (m.busy) {
    return m;
  }
  if (needs_index_save(m)) {
    return Model { ...m, index_saving: true, job: Some(SaveIndex(m.generation, m.cards, m.changed_index)) };
  }
  if (!m.cover_busy) {
    let image = next_cover(m);
    if (image.len() > 0) {
      let (watch, stop) = m.cover_pipe();
      return Model { ...m, cover_busy: true, cover_active: image, cover_stop: stop, job: Some(Cover(m.generation, image, m.art_dir, m.token.len() > 0, watch)), warmed: m.warmed.insert(image, true) };
    }
  }
  if (!m.cover_busy) {
    let image = warm_art(m);
    if (image.len() > 0) {
      return Model { ...m, cover_busy: true, warmed: m.warmed.insert(image, true), job: Some(WarmArt(m.generation, image, m.art_dir)) };
    }
  }
  if (!m.library_loaded || m.background_busy || shelf.search_due > 0i64) {
    return m;
  }
  let opened = opened_index(m);
  if (m.tab == 1 && opened >= 0 && shelf.paused.len() == 0 && needs_tracks(shelf, m.cards[opened])) {
    return load_tracks(m, opened, shelf.next);
  }
  if (shelf.paused.len() > 0) {
    return m;
  }
  let i = shelf.next;
  while (i < m.cards.len() && !needs_tracks(shelf, m.cards[i])) {
    i += 1;
  }
  if (i == m.cards.len()) {
    return Model { ...m, shelf: Shelf { ...shelf, next: i } };
  }
  return load_tracks(m, i, i + 1);
}

function track_result(own m: Model, generation: i64, index: i32, result: Result[api.Card, api.Failure]): Model {
  let current = Model { ...m, background_busy: false };
  if (generation != current.generation) {
    return current;
  }
  match (result) {
    Ok(card) => {
      return found(Model { ...current, cards: current.cards.with(index, card), changed_index: current.changed_index + 1i64 });
    },
    Err(err) => {
      if (err.expired) {
        return failed(Model { ...current }, err);
      }
      if (err.pause_index) {
        return Model { ...current, shelf: Shelf { ...current.shelf, paused: err.message } };
      }
      return current;
    }
  }
}

function cover_result(own m: Model, generation: i64, address: string, data: u8[]): Model {
  close_pipe(m.cover_stop);
  let next = Model { ...m, cover_busy: false, cover_active: "", cover_stop: -1 };
  if (generation == next.generation && (!m.cover_busy || m.cover_active == address)) {
    return Model { ...next, shelf: Shelf { ...next.shelf, received: Some((address, data)) } };
  }
  return next;
}

function prepare_artwork(image: draw.Image): Artwork {
  let source_size = image.width.min(image.height);
  let edge = image.width.max(image.height);
  if (edge < 1 || source_size < 1 || edge > 32 || image.pixels.len() != image.width * image.height * 4) {
    return Artwork { image: image, source_size: source_size };
  }
  // Copy the pixels of a player icon at an integer scale before the UI scales it.
  let scale = (128 / edge).min(8);
  let width = image.width * scale;
  let height = image.height * scale;
  let pixels: u8[] = [];
  for y in 0..height {
    let row = y / scale * image.width;
    for x in 0..width {
      let at = (row + x / scale) * 4;
      pixels = pixels.append(image.pixels[at]).append(image.pixels[at + 1]).append(image.pixels[at + 2]).append(image.pixels[at + 3]);
    }
  }
  return Artwork { image: draw.Image { width: width, height: height, pixels: pixels }, source_size: source_size };
}

function enlarged_icon(image: draw.Image, side: i32): draw.Image {
  let crop = image.width.min(image.height);
  let left = (image.width - crop) / 2;
  let top = (image.height - crop) / 2;
  let pixels = buf_new(side * side * 4);
  for y in 0..side {
    let row = (top + y * crop / side) * image.width;
    for x in 0..side {
      let offset = (row + left + x * crop / side) * 4;
      buf_push_bytes_range(pixels, image.pixels, offset, offset + 4);
    }
  }
  let bytes = buf_take_bytes(pixels);
  buf_free(pixels);
  return draw.Image { width: side, height: side, pixels: bytes };
}

function visible_expansion(m: Model): Option[ExpandedArtwork] {
  if (m.on_phone) {
    if let Some(expanded) = m.expanded_art {
      if (expanded.address == phone_art(m)) {
        return Some(expanded);
      }
    }
  }
  return None;
}

function store_cover(m: Model, decode: (u8[], i32) => Option[draw.Image]): Model {
  let shelf = m.shelf;
  let Some((address, data)) = shelf.received else {
    return m;
  };
  let full = opened_card(m).map((card: api.Card): boolean => card.cover == address).unwrap_or(false) || m.now_open && playback_pictures(m).contains(address);
  let limit = if (full) { 448 } else { if (m.playback_tools.saved.compact) { 192 } else { 320 } };
  let cache = shelf.covers.insert(address, decode(data, limit).map(prepare_artwork));
  let order = shelf.cover_order.append(address);
  if (order.len() > 48) {
    cache = cache.remove(order[0]);
    order = order.drop(1);
  }
  return Model { ...m, shelf: Shelf { ...shelf, covers: cache, cover_order: order, received: None } };
}

function selected(m: Model): Option[api.Player] {
  if (m.on_phone) {
    return None;
  }
  for player in m.players {
    if (player.id == m.selected) {
      return Some(player);
    }
  }
  return None;
}

function request_playback(m: Model): Model {
  let now = m.now_playing;
  let Some(player) = selected(m) else {
    return Model { ...m, now_playing: NowPlaying { ...now, revision: now.revision + 1i64, requested: false, due: 0i64, playback: None, note: "" } };
  };
  let note = if (player.online) { "Checking playback…" } else { "" };
  return Model { ...m, now_playing: NowPlaying { ...now, revision: now.revision + 1i64, requested: player.online, due: 0i64, playback: None, note: note } };
}

function should_read_playback(m: Model): boolean {
  let now = m.now_playing;
  if (now.running || m.busy || m.token.len() == 0) {
    return false;
  }
  if (now.requested) {
    return true;
  }
  return now.due > 0i64 && monotonic_ns() >= now.due && selected(m).map((player: api.Player): boolean => player.online).unwrap_or(false);
}

function read_playback(m: Model): Model {
  let now = m.now_playing;
  if (!should_read_playback(m)) {
    return m;
  }
  return Model { ...m, now_playing: NowPlaying { ...now, requested: false, due: 0i64, running: true }, job: Some(ReadPlayback(m.generation, now.revision, m.token, m.selected)) };
}

function playback_result(m: Model, generation: i64, revision: i64, result: Result[player_status.Playback, string]): Model {
  let now = NowPlaying { ...m.now_playing, running: false };
  if (generation != m.generation || revision != now.revision) {
    return Model { ...m, now_playing: now };
  }
  let due = monotonic_ns() + 15000000000i64;
  match (result) {
    Ok(playback) => {
      return Model { ...m, now_playing: NowPlaying { ...now, due: due, playback: Some(playback), note: "" } };
    },
    Err(_) => {
      return Model { ...m, now_playing: NowPlaying { ...now, due: due, note: if (now.playback.is_none()) { "Playback status unavailable." } else { "" } } };
    }
  }
}

function can_control(m: Model): boolean {
  if (m.token.len() == 0 || m.busy) {
    return false;
  }
  if (m.on_phone) {
    return true;
  }
  if let Some(player) = selected(m) {
    return player.online && !m.busy;
  }
  return false;
}

function can_play_card(m: Model, id: string): boolean {
  return can_control(m) || (m.token.len() == 0 || m.on_phone || m.selected.len() == 0) && offline.saved(m.downloads, id).is_some();
}

function connect(own m: Model): Model {
  let client = m.client.trim().to_owned();
  if (client.len() == 0) {
    return Model { ...m, note: "Enter a public client ID from the Yoto developer dashboard." };
  }
  return Model { ...m, client: client, note: "Continue sign-in in your browser.", open_login: true, busy: true };
}

function cancel(own m: Model): Model {
  if let Some(flow) = m.flow {
    oauth.close(flow);
  }
  return Model { ...m, flow: None, open_login: false, busy: false, note: "" };
}

function poll_login(own m: Model): Model {
  let next = Model { ...m, flow: None };
  let Some(flow) = m.flow else {
    return next;
  };
  match (oauth.poll(flow, monotonic_ns() / 1000000i64)) {
    oauth.Waiting(waiting) => {
      return Model { ...next, flow: Some(waiting) };
    },
    oauth.Authorized(verifier, code) => {
      let client = next.client;
      let works = [worker.spawn((): Result[api.Tokens, api.Failure] => api.exchange(client, verifier, code))];
      return Model { ...next, auth: works, note: "Completing sign-in…" };
    },
    oauth.Failed(note) => {
      return Model { ...next, busy: false, note: note };
    }
  }
}

function failed(own m: Model, err: api.Failure): Model {
  if (err.expired) {
    if (m.refresh.len() == 0) {
      return signed_out(m, err.message);
    }
    if (m.library_loaded) {
      return renew(Model { ...m, library_loaded: false });
    }
    return Model { ...m, token: "", busy: false, note: "Yoto could not restore access to your library. Try again." };
  }
  return Model { ...m, busy: false, note: err.message };
}

function reload(own m: Model): Model {
  return Model { ...m, generation: m.generation + 1i64, busy: true, note: "Loading players and library…", job: Some(Load(m.token)) };
}

function loaded(own m: Model, result: Result[api.Library, api.Failure]): Model {
  match (result) {
    Ok(library) => {
      let shelf = Shelf { ...m.shelf, next: 0, paused: "", attempted: map_new(64), note: library.note, opened: "" };
      match (library.groups) {
        Ok(groups) => {
          shelf = Shelf { ...shelf, groups: groups, groups_note: "" };
          if (shelf.group.len() > 0 && selected_group(shelf).is_none()) {
            shelf = reset_grid(Shelf { ...shelf, group: "" });
          }
        },
        Err(err) => {
          shelf = Shelf { ...shelf, groups_note: err.message };
        }
      }
      let prior: Map[string, api.Card] = map_new(m.cards.len());
      for card in m.cards {
        if (card.tracks.len() > 0) {
          prior = prior.insert(card.id, card);
        }
      }
      let cards = library.cards.map((card: api.Card): api.Card => {
        if (!card.indexed) {
          if let Some(cached) = prior.get(card.id) {
            return api.Card { ...card, tracks: cached.tracks };
          }
        }
        return card;
      });
      let t = found(Model { ...m, players: library.players, cards: cards, shelf: shelf, library_loaded: true, cache_available: true, changed_index: m.changed_index + 1i64, enrich_downloads: true, busy: false, note: "" });
      if (!t.on_phone && selected(t).is_none()) {
        return request_playback(Model { ...t, selected: "" });
      }
      return request_playback(t);
    },
    Err(err) => {
      return failed(m, err);
    }
  }
}

function control(own m: Model, command: api.Command): Model {
  if (m.token.len() == 0 || m.on_phone || m.selected.len() == 0) {
    match (command) {
      api.Play(id) => {
        if (can_play_card(m, id)) {
          return stream_card(m, id, "", "");
        }
      },
      api.PlayTrack(id, chapter, track) => {
        if (can_play_card(m, id)) {
          return stream_card(m, id, chapter, track);
        }
      },
      _ => {
        return Model { ...m, phone: phone.control(m.phone, command), playback_tools: PlaybackTools { ...m.playback_tools, sample: true } };
      }
    }
    return m;
  }
  if (!can_control(m)) {
    return m;
  }
  return Model { ...m, busy: true, note: "Sending playback request…", job: Some(Send(m.generation, m.token, m.selected, command)) };
}

function stream_card(m: Model, id: string, chapter: string, track: string): Model {
  if (chapter.len() == 0) {
    if let Some(pin) = listening.mark(m.playback_tools.saved, id) {
      let resumed = stream_at(m, id, pin.chapter, pin.key, pin.position);
      if (resumed.phone.revision != m.phone.revision) {
        return resumed;
      }
    }
  }
  return stream_at(m, id, chapter, track, 0i64);
}

function stream_at(m: Model, id: string, chapter: string, track: string, position: i64): Model {
  let full = offline.saved(m.downloads, id);
  let saved = if (full.is_none() && chapter.len() > 0) { offline.saved(m.downloads, api.chapter_download_id(id, chapter)) } else { full };
  if let Some(entry) = saved {
    if (chapter.len() == 0) {
      return play_download_at(m, entry, 0, position);
    }
    for i in 0..entry.tracks.len() {
      let item = entry.tracks[i];
      if (item.chapter == chapter && (track.len() == 0 || item.key == track)) {
        return play_download_at(m, entry, i, position);
      }
    }
  }
  if (can_control(m)) {
    for card in m.cards {
      if (card.id == id) {
        let state = phone.loading(m.phone, card.id, card.title, position);
        return Model { ...m, phone: state, job: Some(Streams(state.revision, m.token, card, chapter, track)) };
      }
    }
  }
  return m;
}

function play_download(m: Model, entry: offline.Entry, from: i32): Model {
  return play_download_at(m, entry, from, 0i64);
}

function play_download_at(m: Model, entry: offline.Entry, from: i32, position: i64): Model {
  let tracks = offline.playlist(m.downloads, entry, from);
  if (tracks.len() == 0) {
    return m;
  }
  let state = phone.loading(m.phone, entry.id, entry.title, position);
  let ready = phone.received(state, state.revision, Ok(tracks));
  return request_playback(Model { ...m, selected: "", on_phone: true, phone: ready });
}

function phone_target(m: Model): Model {
  return Model { ...m, selected: "", on_phone: true };
}

function queue_item(m: Model, id: string): Option[listening.Item] {
  if let Some(entry) = offline.saved(m.downloads, id) {
    return Some(listening.Item { id: id, title: entry.title });
  }
  let index = card_index(m, id);
  if (index >= 0) {
    return Some(listening.Item { id: id, title: m.cards[index].title });
  }
  return None;
}

function play_queued(m: Model): Model {
  let tools = m.playback_tools;
  if (tools.saved.kids || tools.saved.queue.len() == 0) {
    return m;
  }
  let first = tools.saved.queue[0];
  let next = stream_card(phone_target(m), first.id, "", "");
  if (next.phone.revision == m.phone.revision) {
    return Model { ...m, playback_tools: PlaybackTools { ...tools, note: "Connect to play " + first.title + " or save it before the trip." } };
  }
  let saved = listening.Saved { ...tools.saved, queue: tools.saved.queue.drop(1) };
  return Model { ...next, playback_tools: PlaybackTools { ...tools, saved: saved, dirty: true, note: "" } };
}

function start_routine(m: Model): Model {
  let routine = travel.routine(m.playback_tools.saved);
  if (routine.story.id.len() == 0 || routine.sound.id.len() == 0) {
    return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, note: "Choose a story and a sleep sound first." } };
  }
  let next = stream_at(phone_target(m), routine.story.id, "", "", 0i64);
  if (next.phone.revision == m.phone.revision) {
    return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, note: "Save this story for offline use or connect to play it." } };
  }
  let panel = TravelPanel { ...next.travel_panel, bedtime_story: next.phone.card, bedtime_sound: Some(routine), bedtime_sleeping: "", single_listen: "" };
  return Model { ...next, travel_panel: panel, playback_tools: PlaybackTools { ...next.playback_tools, sleep_at: 0i64, note: "Bedtime routine started." }, phone: phone.chapter_timer(next.phone, false) };
}

function continue_bedtime(m: Model, stopped: phone.State, routine: listening.Routine): Model {
  let quiet = Model { ...m, phone: stopped, travel_panel: TravelPanel { ...m.travel_panel, bedtime_sound: None, bedtime_story: "" } };
  let next = stream_at(phone_target(quiet), routine.sound.id, "", "", 0i64);
  if (next.phone.revision == stopped.revision) {
    return Model { ...quiet, playback_tools: PlaybackTools { ...quiet.playback_tools, note: "Could not open the sleep sound." } };
  }
  let end = monotonic_ns() + routine.minutes as i64 * 60000000000i64;
  return Model { ...next, travel_panel: TravelPanel { ...next.travel_panel, bedtime_sleeping: next.phone.card }, playback_tools: PlaybackTools { ...next.playback_tools, sleep_at: end, note: "Sleep sounds are playing." } };
}

function finished_phone(m: Model, next: phone.State): Model {
  if (m.playback_tools.trip_test_until > 0i64 && m.phone.card.len() > 0 && next.card.len() == 0) {
    let note = if (next.note.len() > 0) { next.note } else { "Offline sample played." };
    return Model { ...m, phone: next, playback_tools: PlaybackTools { ...m.playback_tools, trip_test_until: 0i64, note: note } };
  }
  if (m.phone.card.len() > 0 && next.card.len() == 0 && next.note.len() == 0) {
    let tools = m.playback_tools;
    let item = listening.Item { id: m.phone.card, title: m.phone.title };
    let saved = listening.heard(listening.without(tools.saved, item.id), item, true, now_unix_ms());
    let ready = Model { ...m, phone: next, playback_tools: PlaybackTools { ...tools, saved: saved, dirty: true } };
    if (m.travel_panel.bedtime_story == m.phone.card) {
      if let Some(routine) = m.travel_panel.bedtime_sound {
        return continue_bedtime(ready, next, routine);
      }
    }
    if (m.travel_panel.bedtime_sleeping == m.phone.card) {
      if (tools.sleep_at > monotonic_ns()) {
        let again = stream_at(phone_target(ready), m.phone.card, "", "", 0i64);
        if (again.phone.revision != next.revision) {
          return again;
        }
      }
      return Model { ...ready, travel_panel: TravelPanel { ...ready.travel_panel, bedtime_sleeping: "" }, playback_tools: PlaybackTools { ...ready.playback_tools, sleep_at: 0i64, note: "Bedtime routine ended." } };
    }
    if (m.travel_panel.single_listen == m.phone.card) {
      return Model { ...ready, travel_panel: TravelPanel { ...ready.travel_panel, single_listen: "" } };
    }
    if (next.sleep_ended) {
      return Model { ...ready, playback_tools: PlaybackTools { ...ready.playback_tools, note: "Sleep timer ended." } };
    }
    return play_queued(ready);
  }
  if (next.sleep_ended && !m.phone.sleep_ended) {
    return Model { ...m, phone: next, playback_tools: PlaybackTools { ...m.playback_tools, note: "Sleep timer ended." } };
  }
  return Model { ...m, phone: next };
}

pub function playback_tick(m: Model, now: i64): Model {
  let tools = m.playback_tools;
  if (tools.trip_test_until > 0i64 && now >= tools.trip_test_until) {
    return Model { ...m, phone: phone.stop(m.phone), playback_tools: PlaybackTools { ...tools, trip_test_until: 0i64, note: "Offline sample ended." } };
  }
  if (tools.sleep_at > 0i64 && now >= tools.sleep_at) {
    let state = match (m.phone.phase) {
      phone.Playing => phone.control(m.phone, api.Pause),
      phone.Loading | phone.Preparing => phone.stop(m.phone),
      _ => m.phone,
    };
    let panel = TravelPanel { ...m.travel_panel, bedtime_sleeping: "" };
    return Model { ...m, phone: state, travel_panel: panel, playback_tools: PlaybackTools { ...tools, sleep_at: 0i64, sample: true, note: "Sleep timer ended." } };
  }
  if (now - tools.sample_at >= 2000000000i64) {
    if let phone.Playing = m.phone.phase {
      return Model { ...m, playback_tools: PlaybackTools { ...tools, sample: true, sample_at: now } };
    }
  }
  return m;
}

function set_saved(m: Model, saved: listening.Saved): Model {
  return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, saved: saved, dirty: true } };
}

function queue_check(m: Model, items: listening.Item[]): Model {
  let tools = m.playback_tools;
  if (tools.trip_running) {
    return m;
  }
  return Model { ...m, playback_tools: PlaybackTools { ...tools, trip_running: true, trip: [], note: "" }, job: Some(TripCheck(m.downloads.catalog, items)) };
}

function lineup_by_name(m: Model, title: string): Option[listening.Lineup] {
  return m.playback_tools.saved.lineups.find((item: listening.Lineup): boolean => item.name == title);
}

function save_lineup(m: Model, draft: TripDraft): Model {
  let tools = m.playback_tools;
  let title = draft.title.trim().to_owned();
  if (title.len() == 0 || draft.items.len() == 0) {
    return m;
  }
  if (draft.original != title && lineup_by_name(m, title).is_some()) {
    return Model { ...m, playback_tools: PlaybackTools { ...tools, note: "A trip already uses that name." } };
  }
  let saved = listening.keep_lineup(tools.saved, draft.original, title, draft.items);
  return Model { ...m, playback_tools: PlaybackTools { ...tools, saved: saved, draft: None, dirty: true, note: "Trip saved." } };
}

function start_lineup(m: Model, line: listening.Lineup): Model {
  let ready = set_saved(m, listening.Saved { ...m.playback_tools.saved, queue: line.cards });
  return play_queued(ready);
}

function prime_lineup(m: Model, line: listening.Lineup): Model {
  if (m.token.len() == 0) {
    return m;
  }
  let cards: api.Card[] = [];
  let downloads = m.downloads;
  let missing: (string, i32)[] = [];
  for item in line.cards {
    if let Some(result) = m.playback_tools.trip.find((report: listening.Trip): boolean => report.id == item.id && report.first_bad >= 0) {
      missing = missing.append((result.id, result.first_bad));
    }
    let at = card_index(m, item.id);
    if (at >= 0) {
      cards = cards.append(m.cards[at]);
      downloads = offline.retry(downloads, item.id);
      if (downloads.held.any((card: api.Card): boolean => card.id == item.id)) {
        downloads = offline.resume_card(downloads, item.id);
      }
    }
  }
  return Model { ...m, downloads: offline.repair(offline.enqueue(downloads, cards), missing) };
}

function kids_mode(m: Model, saved: listening.Saved): Model {
  let audio = if (listening.favourite(saved, m.phone.card)) { m.phone } else { phone.stop(m.phone) };
  let ready = set_saved(m, listening.Saved { ...saved, kids: true });
  return Model { ...ready, phone: audio, parent: closed_gate(), menu_open: false };
}

function parent_result(m: Model, key: string, accepted: boolean): Model {
  let saved = m.playback_tools.saved;
  let parent = m.parent;
  if (key.len() > 0 && saved.parent_key.len() == 0) {
    return kids_mode(m, listening.Saved { ...saved, parent_key: key });
  }
  if (accepted) {
    let ready = set_saved(m, listening.Saved { ...saved, kids: false, attempts: 0, retry_pin_at: 0i64 });
    return Model { ...ready, parent: closed_gate() };
  }
  let attempts = saved.attempts + 1;
  let pause = attempts >= 5;
  let ready = set_saved(m, listening.Saved { ...saved, attempts: if (pause) { 0 } else { attempts }, retry_pin_at: if (pause) { now_unix_ms() + 30000i64 } else { 0i64 } });
  let note = if (pause) { "Try again in 30 seconds." } else { "That PIN did not match." };
  return Model { ...ready, parent: ParentGate { ...parent, code: "", first: "", busy: false, note: note } };
}

function apply_shortcut(own m: Model, action: string): Model {
  let s = m.playback_tools.saved;
  if (action.starts_with("dev.fern.storydeck.CARD.")) {
    let id = action.drop("dev.fern.storydeck.CARD.".len());
    if (!s.kids || listening.favourite(s, id)) {
      return stream_card(phone_target(m), id, "", "");
    }
  }
  if (s.kids) {
    return m;
  }
  if (action == "dev.fern.storydeck.RESUME" && s.marks.len() > 0) {
    return stream_card(phone_target(m), s.marks[0].item.id, "", "");
  }
  if (action.starts_with("dev.fern.storydeck.TRIP.")) {
    let id = action.drop("dev.fern.storydeck.TRIP.".len());
    if let Some(line) = s.lineups.find((line: listening.Lineup): boolean => line.id == id) {
      return start_lineup(m, line);
    }
  }
  return m;
}

function send_transfer(m: Model, id: string, command: api.Command, to_player: boolean): Model {
  return Model { ...m, transfer_from: "", transfer_note: "Switching playback…", job: Some(TransferPlayback(m.generation, m.phone.revision, m.token, id, command, to_player)) };
}

function move_to_player(m: Model, id: string): Model {
  let phone = m.phone;
  if (!m.on_phone || m.token.len() == 0 || m.transfer_note == "Switching playback…" || phone.card.len() == 0 || phone.at >= phone.queue.len()) {
    return m;
  }
  let track = phone.queue[phone.at];
  if (track.chapter.len() == 0 || track.key.len() == 0 || !m.players.any((player: api.Player): boolean => player.id == id && player.online)) {
    return m;
  }
  return send_transfer(m, id, api.PlayAt(phone.card, track.chapter, track.key, (phone.elapsed / 1000i64) as i32), true);
}

function move_to_phone(m: Model): Model {
  let Some(playback) = m.now_playing.playback else {
    return m;
  };
  if (m.on_phone || m.token.len() == 0 || m.selected.len() == 0 || playback.position < 0 || playback.chapter_key.len() == 0 || playback.track_key.len() == 0) {
    return m;
  }
  let source = m.selected;
  let next = stream_at(phone_target(m), playback.card, playback.chapter_key, playback.track_key, playback.position as i64 * 1000i64);
  if (next.phone.revision == m.phone.revision) {
    return Model { ...m, transfer_note: "This title could not open on the phone." };
  }
  return Model { ...next, transfer_from: source, transfer_revision: next.phone.revision, transfer_note: "Opening on the phone…" };
}

function pending_download(m: Model): Option[api.Card] {
  if (!m.busy && m.token.len() > 0 && (!m.playback_tools.saved.wifi_only || m.wifi)) {
    return offline.next(m.downloads);
  }
  return None;
}

function show_settings(m: Model, player: api.Player): Model {
  if (m.token.len() == 0 || m.busy) {
    return m;
  }
  let p = panel(m.config_panel.revision + 1i64);
  return Model { ...m, config_panel: ConfigPanel { ...p, device: Some(player), working: true }, job: Some(ReadConfig(p.revision, m.token, player)) };
}

function save_settings(m: Model): Model {
  let p = m.config_panel;
  if (p.working || m.busy || m.token.len() == 0) {
    return m;
  }
  if let (Some(device), Some(config)) = (p.device, p.config) {
    match (settings.changes(config, p.draft)) {
      Ok(edits) => {
        if (edits.len() > 0) {
          let revision = p.revision + 1i64;
          return Model { ...m, config_panel: ConfigPanel { ...p, revision: revision, working: true, note: "" }, job: Some(WriteConfig(revision, m.token, device, config, edits)) };
        }
      },
      Err(note) => {
        return Model { ...m, config_panel: ConfigPanel { ...p, note: note } };
      }
    }
  }
  return m;
}

function config_result(own m: Model, revision: i64, saved: boolean, result: Result[api.PlayerConfig, api.Failure]): Model {
  let p = m.config_panel;
  let Some(device) = p.device else {
    return m;
  };
  if (revision != p.revision) {
    return m;
  }
  match (result) {
    Ok(config) => {
      let current = api.Player { ...device, name: config.name };
      let devices = m.players.map((player: api.Player): api.Player => if (player.id == device.id) { api.Player { ...player, name: config.name } } else { player });
      let note = if (saved) { "Settings saved." } else { "" };
      return Model { ...m, players: devices, config_panel: ConfigPanel { ...panel(revision), config: Some(config), device: Some(current), note: note } };
    },
    Err(error) => {
      let state = ConfigPanel { ...p, working: false, note: error.message };
      if (error.expired) {
        return failed(Model { ...m, config_panel: state }, error);
      }
      return Model { ...m, config_panel: state };
    }
  }
}

function picked_setting(m: Model, key: string, value: string): Model {
  let p = m.config_panel;
  return Model { ...m, config_panel: ConfigPanel { ...p, picker: None, query: "", working: false, draft: p.draft.insert(key, value), note: "" } };
}

function prepare_shortcut(m: Model, key: string, card: api.Card): Model {
  let p = m.config_panel;
  let revision = p.revision + 1i64;
  let state = ConfigPanel { ...p, revision: revision, picker: Some(ShortcutTracks(key, card.id)), working: !card.indexed, note: "" };
  if (card.indexed) {
    return Model { ...m, config_panel: state };
  }
  return Model { ...m, config_panel: state, job: Some(ReadShortcutTracks(revision, m.token, card)) };
}

function shortcut_result(own m: Model, revision: i64, result: Result[api.Card, api.Failure]): Model {
  let p = m.config_panel;
  let Some(ShortcutTracks(_, id)) = p.picker else {
    return m;
  };
  if (revision != p.revision) {
    return m;
  }
  let state = ConfigPanel { ...p, working: false };
  match (result) {
    Ok(card) => {
      let index = card_index(m, id);
      if (index >= 0 && card.id == id) {
        return found(Model { ...m, cards: m.cards.with(index, card), config_panel: state });
      }
      return Model { ...m, config_panel: state };
    },
    Err(err) => {
      return Model { ...m, config_panel: ConfigPanel { ...state, note: err.message } };
    }
  }
}

function back_from_picker(m: Model): Model {
  let p = m.config_panel;
  let picker: Option[ConfigPicker] = None;
  match (p.picker) {
    Some(ShortcutTracks(key, _)) => {
      picker = Some(ShortcutCards(key));
    },
    Some(ShortcutCards(key)) => {
      picker = Some(SettingChoices(key));
    },
    _ => {}
  }
  return Model { ...m, config_panel: ConfigPanel { ...p, picker: picker, working: false, note: "" } };
}

function switch_tab(m: Model, tab: i32, history: i32[]): Model {
  return Model { ...m, tab: tab, tab_history: history, menu_open: false, shelf: Shelf { ...m.shelf, first_art: 0, last_art: 0 } };
}

function select_tab(m: Model, tab: i32): Model {
  if (tab == m.tab) {
    return Model { ...m, menu_open: false };
  }
  let history = m.tab_history.filter((item: i32): boolean => item != tab).append(m.tab);
  return switch_tab(m, tab, history);
}

function library_request(m: Model, msg: Msg): Model {
  match (msg) {
    Search(query) => {
      return edit_search(Model { ...m, shelf: reset_grid(m.shelf) }, query, false);
    },
    SearchChunk(serial, next, hits) => {
      return collected_search(m, serial, next, hits);
    },
    SearchReady(serial, hits) => {
      return finished_search(m, serial, hits);
    },
    ToggleCompact => {
      let saved = m.playback_tools.saved;
      return set_saved(Model { ...m, shelf: reset_grid(m.shelf) }, listening.Saved { ...saved, compact: !saved.compact });
    },
    PlaybackTarget => {
      return Model { ...m, target_open: true };
    },
    CloseTarget => {
      return Model { ...m, target_open: false };
    },
    TogglePersonal => {
      return Model { ...m, shelf: Shelf { ...m.shelf, personal_open: !m.shelf.personal_open } };
    },
    UsePersonal(name) => {
      return use_personal(m, name);
    },
    EditPersonal(name) => {
      return edit_personal(m, name);
    },
    ShowProfiles => {
      let tools = m.playback_tools;
      return Model { ...m, menu_open: false, playback_tools: PlaybackTools { ...tools, profile_open: !tools.profile_open, profile_name: "" } };
    },
    ProfileName(name) => {
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, profile_name: name } };
    },
    SwitchProfile(name) => {
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, profile_target: name, profile_open: false } };
    },
    SaveProfile => {
      let tools = m.playback_tools;
      let name = tools.profile_name.trim().to_owned();
      if (name.len() == 0 || name.len() > 32 || name == tools.saved.profile || tools.saved.other_profiles.any((p: listening.Profile): boolean => p.name == name)) {
        return Model { ...m, playback_tools: PlaybackTools { ...tools, note: "Choose a unique profile name of up to 32 characters." } };
      }
      return Model { ...m, playback_tools: PlaybackTools { ...tools, profile_target: name, profile_open: false } };
    },
    _ => {
      return m;
    }
  }
}

function travel_request(m: Model, msg: Msg): Model {
  match (msg) {
    ToggleWifiOnly => {
      let saved = m.playback_tools.saved;
      let next = set_saved(m, listening.Saved { ...saved, wifi_only: !saved.wifi_only });
      if let Some(active) = offline.current(m.downloads) {
        return Model { ...next, downloads: offline.hold(m.downloads, active.id), wifi_requeue: active.id };
      }
      return next;
    },
    HoldDownload(id) => {
      return Model { ...m, downloads: offline.hold(m.downloads, id) };
    },
    ContinueDownload(id) => {
      return Model { ...m, downloads: offline.resume_card(m.downloads, id) };
    },
    FirstDownload(id) => {
      return Model { ...m, downloads: offline.move_first(m.downloads, id) };
    },
    OpenTripDashboard(name) => {
      let tools = m.playback_tools;
      if let Some(line) = lineup_by_name(m, name) {
        let next = Model { ...m, playback_tools: PlaybackTools { ...tools, trip_focus: name } };
        return queue_check(next, line.cards);
      }
      return Model { ...m, playback_tools: PlaybackTools { ...tools, trip_focus: "" } };
    },
    RepairTripCard(id, at) => {
      if (m.token.len() > 0) {
        return Model { ...m, downloads: offline.repair(m.downloads, [(id, at)]) };
      }
      return m;
    },
    TestTrip(name) => {
      if let Some(line) = lineup_by_name(m, name) {
        for item in line.cards {
          let passes = m.playback_tools.trip.any((row: listening.Trip): boolean => row.id == item.id && row.expected > 0 && row.present == row.expected);
          if (!passes) {
            continue;
          }
          if let Some(entry) = offline.saved(m.downloads, item.id) {
            if (entry.tracks.len() > 0 && stat(m.downloads.catalog.dir + "/" + entry.tracks[0].name).is_ok()) {
              let next = play_download(m, entry, 0);
              let tools = next.playback_tools;
              return Model { ...next, playback_tools: PlaybackTools { ...tools, trip_test_until: monotonic_ns() + 15000000000i64, note: "Playing a sample from the saved file." } };
            }
          }
        }
      }
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, note: "Download a card from this trip to test playback." } };
    },
    _ => {
      return m;
    }
  }
}

function travel_note(m: Model, text: string): Model {
  return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, note: text } };
}

function downloaded_items(m: Model): listening.Item[] {
  return m.downloads.catalog.entries.filter((entry: offline.Entry): boolean => entry.ready).map((entry: offline.Entry): listening.Item => listening.Item { id: entry.id, title: entry.title });
}

function scan_finished(m: Model): Model {
  let tool = m.tools_page;
  let action = if (tool.scanning) { Some(panel_tools.ScanStop) } else { None };
  return tools_update(m, panel_tools.State { ...tool, scanning: false, action: action });
}

function save_tag(m: Model, uid: string, card: listening.Item, routine: boolean): Model {
  let s = m.playback_tools.saved;
  let rest = s.tags.filter((link: listening.TagLink): boolean => link.uid != uid);
  let link = listening.TagLink { uid: uid, card: card, routine: routine, profile: s.profile };
  return set_saved(m, listening.Saved { ...s, tags: rest.append(link) });
}

function tag_playback(m: Model, id: string): Model {
  if (offline.saved(m.downloads, id).is_none()) {
    return travel_note(m, "Save this card offline before you use tap to play.");
  }
  return stream_card(phone_target(m), id, "", "");
}

function physical_tag(own m: Model, payload: string): Model {
  let fields = payload.split("|");
  let uid = if (fields.len() > 1) { fields[0] } else { "" };
  let address = if (fields.len() > 1) { fields[1] } else { payload };
  let panel = m.travel_panel;
  let now = monotonic_ns();
  if (!m.tools_page.scanning || uid.len() > 0 && uid == panel.last_tag && now - panel.last_tag_at < 1500000000i64) {
    return m;
  }
  if let Some(NfcTags()) = panel.page {
    if (uid.len() > 0 && (panel.selected_tag.len() > 0 || panel.nfc_routine)) {
      let item = queue_item(m, panel.selected_tag).unwrap_or(listening.Item { id: "", title: "" });
      let ready = save_tag(scan_finished(m), uid, item, panel.nfc_routine);
      return travel_note(Model { ...ready, travel_panel: TravelPanel { ...panel, selected_tag: "", nfc_routine: false } }, "Sticker linked.");
    }
  }
  if (panel.tap_to_play) {
    let saved = m.playback_tools.saved;
    let tapped = Model { ...m, travel_panel: TravelPanel { ...panel, last_tag: uid, last_tag_at: now } };
    if let Some(link) = saved.tags.find((tag: listening.TagLink): boolean => uid.len() > 0 && tag.uid == uid) {
      let ready = tapped;
      if (link.routine) {
        return if (link.profile == saved.profile) { start_routine(ready) } else { travel_note(ready, "Select the " + link.profile + " profile to start this routine.") };
      }
      return tag_playback(ready, link.card.id);
    }
    let id = api.scan_code(address);
    if (offline.saved(m.downloads, id).is_some()) {
      return tag_playback(tapped, id);
    }
  }
  if (address.len() == 0) {
    return travel_note(scan_finished(m), "This sticker is not linked. Select a card or routine first.");
  }
  let next = Model { ...m, travel_panel: TravelPanel { ...panel, scan_uid: if (panel.tap_to_play) { uid } else { "" } } };
  return scan_card(next, address);
}

function edit_routine(m: Model, routine: listening.Routine): Model {
  let s = m.playback_tools.saved;
  let rest = s.routines.filter((item: listening.Routine): boolean => item.profile != routine.profile);
  return set_saved(m, listening.Saved { ...s, routines: rest.append(routine) });
}

function view_chapters(m: Model, id: string): Model {
  return Model { ...m, travel_panel: TravelPanel { ...m.travel_panel, page: Some(ChapterDownloads), card: id } };
}

function update_travel(own m: Model, msg: Msg): Model {
  let panel = m.travel_panel;
  let saved = m.playback_tools.saved;
  match (msg) {
    OpenTravel(page) => {
      let next = travel_note(Model { ...m, menu_open: false, travel_panel: TravelPanel { ...panel, page: Some(page), choice: 0, storage_confirm: "", query: "", tap_to_play: if let NfcTags = page { true } else { panel.tap_to_play } } }, "");
      if let StorageBudget = page {
        return queue_check(next, downloaded_items(next));
      }
      return next;
    },
    CloseTravel => {
      let next = scan_finished(m);
      return Model { ...next, travel_panel: TravelPanel { ...panel, page: None, choice: 0, selected_tag: "", nfc_routine: false, storage_confirm: "", scan_uid: "" } };
    },
    PlayCarTrip(id) => {
      if let Some(line) = saved.lineups.find((item: listening.Lineup): boolean => item.id == id) {
        let ready = line.cards.filter((card: listening.Item): boolean => offline.saved(m.downloads, card.id).is_some());
        if (ready.len() == 0) {
          return travel_note(m, "Download a card from this trip first.");
        }
        let note = if (ready.len() < line.cards.len()) { "Playing the downloaded cards from this trip." } else { "" };
        let start = play_queued(set_saved(m, listening.Saved { ...saved, queue: ready }));
        return travel_note(start, note);
      }
      return m;
    },
    PickTime(minutes) => {
      return Model { ...m, travel_panel: TravelPanel { ...panel, duration: minutes } };
    },
    PlayFit(fit) => {
      if (offline.saved(m.downloads, fit.card.id).is_none()) {
        return m;
      }
      let next = if (fit.chapter.len() == 0) { stream_card(phone_target(m), fit.card.id, "", "") } else { stream_at(phone_target(m), fit.card.id, fit.chapter, fit.track, fit.position) };
      let state = next.phone;
      if (fit.chapter.len() > 0 && state.queue.len() > 0) {
        let queue = if (fit.track.len() > 0) { state.queue.take(1) } else { state.queue.filter((track: api.Stream): boolean => track.chapter == fit.chapter) };
        state = phone.State { ...state, queue: queue };
      }
      return Model { ...next, phone: state, travel_panel: TravelPanel { ...panel, page: None, single_listen: state.card }, now_open: true };
    },
    PickBudget(mb) => {
      return set_saved(m, listening.Saved { ...saved, budget_mb: mb.max(0) });
    },
    SuggestRemoval(id) => {
      return Model { ...m, travel_panel: TravelPanel { ...panel, storage_confirm: id } };
    },
    RemoveForBudget(id) => {
      if (panel.storage_confirm == id && !travel.protected(saved, id) && m.phone.card != id) {
        let tools = m.playback_tools;
        let report = tools.trip.filter((row: listening.Trip): boolean => row.id != id);
        return Model { ...m, downloads: offline.remove(m.downloads, id), travel_panel: TravelPanel { ...panel, storage_confirm: "" }, playback_tools: PlaybackTools { ...tools, trip: report } };
      }
      return m;
    },
    SurpriseKids => {
      if (saved.kids) {
        if let Some(item) = travel.surprise(saved, m.downloads.catalog, m.phone.card) {
          return stream_at(phone_target(m), item.id, "", "", 0i64);
        }
      }
      return m;
    },
    SetRoutineChoice(choice) => {
      return Model { ...m, travel_panel: TravelPanel { ...panel, choice: choice, query: "" } };
    },
    TravelQuery(query) => {
      return Model { ...m, travel_panel: TravelPanel { ...panel, query: query } };
    },
    SetRoutineCard(id) => {
      if let Some(item) = queue_item(m, id) {
        let old = travel.routine(saved);
        let changed = if (panel.choice == 1) { listening.Routine { ...old, story: item } } else { listening.Routine { ...old, sound: item } };
        return edit_routine(Model { ...m, travel_panel: TravelPanel { ...panel, choice: 0 } }, changed);
      }
      return m;
    },
    SetRoutineTime(minutes) => {
      return edit_routine(m, listening.Routine { ...travel.routine(saved), minutes: minutes });
    },
    StartRoutine => {
      return start_routine(m);
    },
    PlayTagCard(id) => {
      return Model { ...m, travel_panel: TravelPanel { ...panel, selected_tag: id, nfc_routine: false, choice: 0 } };
    },
    LinkRoutineTag => {
      return Model { ...m, travel_panel: TravelPanel { ...panel, selected_tag: "", nfc_routine: true } };
    },
    RemoveTag(uid) => {
      let tags = saved.tags.filter((link: listening.TagLink): boolean => link.uid != uid);
      return set_saved(m, listening.Saved { ...saved, tags: tags });
    },
    ReadPhysicalTag(payload) => {
      return physical_tag(m, payload);
    },
    SetTapToPlay => {
      return Model { ...m, travel_panel: TravelPanel { ...panel, tap_to_play: !panel.tap_to_play } };
    },
    OpenChapterDownloads(id) => {
      return view_chapters(m, id);
    },
    SaveChapter(id, chapter) => {
      let at = card_index(m, id);
      let (_, selected) = api.download_selection(id);
      if (selected.len() == 0 && at >= 0 && m.token.len() > 0 && offline.saved(m.downloads, id).is_none()) {
        let card = m.cards[at];
        if let Some(track) = card.tracks.find((track: api.Track): boolean => track.chapter_key == chapter) {
          let name = if (track.chapter.len() > 0) { track.chapter } else { track.title };
          return Model { ...m, downloads: offline.enqueue(m.downloads, [api.chapter_download(card, chapter, name)]) };
        }
      }
      return m;
    },
    PlayChapter(id) => {
      let next = tag_playback(m, id);
      if (next.phone.revision != m.phone.revision) {
        return Model { ...next, travel_panel: TravelPanel { ...next.travel_panel, single_listen: next.phone.card } };
      }
      return next;
    },
    ToggleSleepFade => {
      return set_saved(m, listening.Saved { ...saved, fade: !saved.fade });
    },
    _ => {
      return m;
    }
  }
}

function audio_editor_update(own m: Model, msg: Msg): Model {
  if let EditAudio(index) = msg {
    let chapters = m.tools_page.draft.chapters;
    if (index >= 0 && index < chapters.len() && !m.tools_page.recording && !m.tools_page.busy) {
      let part = chapters[index];
      if let Some(source) = part.audio {
        let revision = m.audio_revision + 1i64;
        let editor = AudioEditor {
          index: index, source: source, title: part.title, wave: None, working: true, note: "",
          marker: 0, edit: myo_audio.Edit { first: 0, last: 0, markers: [], match_volume: false },
        };
        return Model { ...m, audio_revision: revision, audio_editor: Some(editor), job: Some(AnalyzeAudio(revision, source)) };
      }
    }
    return m;
  }
  let Some(e) = m.audio_editor else {
    if let AudioRendered(_, Ok(parts)) = msg {
      myo_audio.discard(parts);
    }
    return m;
  };
  match (msg) {
    CloseAudioEditor => {
      return Model { ...m, audio_editor: None, audio_revision: m.audio_revision + 1i64 };
    },
    WaveReady(revision, result) => {
      if (revision == m.audio_revision) {
        match (result) {
          Ok(wave) => {
            let edit = myo_audio.Edit { ...e.edit, last: wave.duration };
            let ready = AudioEditor { ...e, wave: Some(wave), working: false, marker: wave.duration / 2, edit: edit };
            return Model { ...m, audio_editor: Some(ready) };
          },
          Err(note) => {
            return Model { ...m, audio_editor: Some(AudioEditor { ...e, working: false, note: note }) };
          }
        }
      }
    },
    AudioTrim(start, ms) => {
      if let Some(wave) = e.wave {
        let trim = if (start) { myo_audio.Edit { ...e.edit, first: ms.max(0).min(e.edit.last - 1) } } else { myo_audio.Edit { ...e.edit, last: ms.max(e.edit.first + 1).min(wave.duration) } };
        return Model { ...m, audio_editor: Some(AudioEditor { ...e, edit: trim }) };
      }
    },
    AudioMarker(ms) => {
      return Model { ...m, audio_editor: Some(AudioEditor { ...e, marker: ms }) };
    },
    AddAudioMarker => {
      let edit = e.edit;
      if (e.marker > edit.first && e.marker < edit.last && !edit.markers.contains(e.marker)) {
        let markers = myo_audio.Edit { ...edit, markers: edit.markers.append(e.marker) };
        return Model { ...m, audio_editor: Some(AudioEditor { ...e, edit: markers, note: "" }) };
      }
      return Model { ...m, audio_editor: Some(AudioEditor { ...e, note: "Choose a new marker inside the trim range." }) };
    },
    DropAudioMarker(ms) => {
      let edit = myo_audio.Edit { ...e.edit, markers: e.edit.markers.filter((item: i32): boolean => item != ms) };
      return Model { ...m, audio_editor: Some(AudioEditor { ...e, edit: edit }) };
    },
    ToggleMatchAudio => {
      let edit = myo_audio.Edit { ...e.edit, match_volume: !e.edit.match_volume };
      return Model { ...m, audio_editor: Some(AudioEditor { ...e, edit: edit }) };
    },
    RenderAudio => {
      if (!e.working && e.wave.is_some()) {
        let next = AudioEditor { ...e, working: true, note: "Applying audio edits…" };
        return Model { ...m, audio_editor: Some(next), job: Some(RenderEditedAudio(m.audio_revision, e.source, e.title, m.art_dir, e.edit)) };
      }
    },
    AudioRendered(revision, result) => {
      if (revision != m.audio_revision) {
        if let Ok(parts) = result {
          myo_audio.discard(parts);
        }
        return m;
      }
      match (result) {
        Err(note) => {
          return Model { ...m, audio_editor: Some(AudioEditor { ...e, working: false, note: note }) };
        },
        Ok(parts) => {
          let tool = m.tools_page;
          let draft = tool.draft;
          let chapters = draft.chapters;
          let new_parts = parts.map((audio: api.LocalAudio): api.Chapter => api.Chapter { title: audio.title, audio: Some(audio), prior: json.JNull });
          if (e.index >= chapters.len() || chapters.len() + parts.len() - 1 > api.MAX_PLAYLIST_CHAPTERS || !chapters[e.index].audio.map((audio: api.LocalAudio): boolean => audio.path == e.source.path).unwrap_or(false)) {
            myo_audio.discard(parts);
            return Model { ...m, audio_editor: Some(AudioEditor { ...e, working: false, note: "Apply the edits to a playlist with up to 100 chapters." }) };
          }
          let updated = chapters.take(e.index).concat(new_parts).concat(chapters.drop(e.index + 1));
          let ready = panel_tools.State { ...tool, draft: api.Playlist { ...draft, chapters: updated }, note: "Audio edits applied." };
          return tools_update(Model { ...m, audio_editor: None }, ready);
        }
      }
    },
    _ => {}
  }
  return m;
}

pub function update(own m: Model, msg: Msg): Model {
  match (msg) {
    EditAudio(_) | CloseAudioEditor | WaveReady(_, _) | AudioTrim(_, _) | AudioMarker(_) | AddAudioMarker | DropAudioMarker(_) | ToggleMatchAudio | RenderAudio | AudioRendered(_, _) => {
      return audio_editor_update(m, msg);
    },
    OpenTravel(_) | CloseTravel | PlayCarTrip(_) | PickTime(_) | PlayFit(_) | PickBudget(_) | SuggestRemoval(_) | RemoveForBudget(_) | SurpriseKids | SetRoutineChoice(_) | TravelQuery(_) | SetRoutineCard(_) | SetRoutineTime(_) | StartRoutine | PlayTagCard(_) | LinkRoutineTag | RemoveTag(_) | ReadPhysicalTag(_) | SetTapToPlay | OpenChapterDownloads(_) | SaveChapter(_, _) | PlayChapter(_) | ToggleSleepFade => {
      return update_travel(m, msg);
    },
    EditClient(text) => {
      if (!m.busy) {
        return Model { ...m, client: text, note: "" };
      }
      return m;
    },
    Connect => {
      if (!m.busy) {
        return connect(m);
      }
      return m;
    },
    Cancel => {
      if (m.flow.is_some()) {
        return cancel(m);
      }
      return m;
    },
    Tick => {
      let now = monotonic_ns();
      m = playback_tick(m, now);
      if (m.wifi && m.token.len() > 0 && now >= m.retry_download_at && (m.downloads.paused || !offline.busy(m.downloads))) {
        m = Model { ...m, retry_download_at: now + 60000000000i64, downloads: offline.retry_on_wifi(m.downloads) };
      }
      m = Model { ...m, downloads: offline.check(m.downloads) };
      if (m.flow.is_some()) {
        return poll_login(m);
      }
      if (m.auth.len() > 0) {
        return poll_auth(m);
      }
      if (m.reconnect) {
        return renew(m);
      }
      if (m.load_after_auth) {
        return reload(Model { ...m, load_after_auth: false });
      }
      if (!m.shelf.search_busy && m.shelf.search_due > 0i64 && now >= m.shelf.search_due) {
        let shelf = m.shelf;
        let job = if (shelf.search_at >= m.cards.len()) {
          SortMatches(shelf.search_serial, m.cards, shelf.search_matches, shelf.by_title)
        } else {
          Find(search_work(m, shelf.search_at, shelf.search_at + 96))
        };
        return Model { ...m, shelf: Shelf { ...shelf, search_busy: true }, job: Some(job) };
      }
      if let Some(card) = pending_download(m) {
        let state = offline.fetching(m.downloads, card);
        return Model { ...m, downloads: state, job: Some(GetDownload(state.revision, m.token, card)) };
      }
      if (m.launch_action.len() > 0 && (m.library_loaded || m.token.len() == 0 && !m.busy && m.auth.len() == 0)) {
        let action = m.launch_action;
        return apply_shortcut(Model { ...m, launch_action: "" }, action);
      }
      if (m.transfer_target.len() > 0) {
        let target = m.transfer_target;
        return move_to_player(Model { ...m, transfer_target: "" }, target);
      }
      if (m.transfer_from.len() > 0) {
        if (m.transfer_revision != m.phone.revision || m.phone.card.len() == 0) {
          m = Model { ...m, transfer_from: "", transfer_note: "Playback stayed on the Yoto player." };
        } else if let phone.Playing = m.phone.phase {
          return send_transfer(m, m.transfer_from, api.Pause, false);
        }
      }
      if (should_read_playback(m)) {
        return read_playback(m);
      }
      return prepare_background(m);
    },
    Search(_) | SearchChunk(_, _, _) | SearchReady(_, _) | ToggleCompact | PlaybackTarget | CloseTarget | TogglePersonal | UsePersonal(_) | EditPersonal(_) | ShowProfiles | ProfileName(_) | SwitchProfile(_) | SaveProfile => {
      return library_request(m, msg);
    },
    ToggleWifiOnly | HoldDownload(_) | ContinueDownload(_) | FirstDownload(_) | OpenTripDashboard(_) | RepairTripCard(_, _) | TestTrip(_) => {
      return travel_request(m, msg);
    },
    Filter(filter) => {
      return found(Model { ...m, shelf: reset_grid(Shelf { ...m.shelf, filter: filter }) });
    },
    ToggleGroups => {
      return Model { ...m, shelf: Shelf { ...m.shelf, groups_open: !m.shelf.groups_open } };
    },
    EditGroup(id) => {
      return open_group(m, id);
    },
    CloseGroup => {
      if let Some(edit) = m.editing_group {
        if (edit.confirm && !edit.busy) {
          return Model { ...m, editing_group: Some(GroupEdit { ...edit, confirm: false, note: "" }) };
        }
        if (!edit.busy) {
          return Model { ...m, editing_group: None };
        }
      }
      return m;
    },
    GroupName(name) => {
      if let Some(edit) = m.editing_group {
        return Model { ...m, editing_group: Some(GroupEdit { ...edit, name: name }) };
      }
      return m;
    },
    GroupQuery(query) => {
      if let Some(edit) = m.editing_group {
        return Model { ...m, editing_group: Some(GroupEdit { ...edit, query: query }) };
      }
      return m;
    },
    GroupMember(id) => {
      if let Some(edit) = m.editing_group {
        let members = if (edit.members.contains(id)) { edit.members.filter((member: string): boolean => member != id) } else { edit.members.append(id) };
        return Model { ...m, editing_group: Some(GroupEdit { ...edit, members: members }) };
      }
      return m;
    },
    SaveGroup => {
      if let Some(edit) = m.editing_group {
        if (edit.local) {
          return save_personal(m, edit);
        }
        let name = edit.name.trim().to_owned();
        if (!edit.busy && name.len() > 0 && m.token.len() > 0) {
          let saving = GroupEdit { ...edit, name: name, busy: true, note: "Saving group…" };
          return Model { ...m, editing_group: Some(saving), job: Some(WriteGroup(m.generation, m.token, saving)) };
        }
      }
      return m;
    },
    DeleteGroup => {
      if let Some(edit) = m.editing_group {
        if (edit.local) {
          if (!edit.confirm) {
            return Model { ...m, editing_group: Some(GroupEdit { ...edit, confirm: true }) };
          }
          let saved = m.playback_tools.saved;
          let keep = saved.collections.filter((item: listening.Collection): boolean => item.name != edit.id);
          return use_personal(set_saved(m, listening.Saved { ...saved, collections: keep }), "");
        }
        if (!edit.busy && edit.id.len() > 0 && m.token.len() > 0) {
          if (edit.confirm) {
            let deleting = GroupEdit { ...edit, busy: true, note: "Removing group…" };
            return Model { ...m, editing_group: Some(deleting), job: Some(RemoveGroup(m.generation, m.token, edit.id)) };
          }
          return Model { ...m, editing_group: Some(GroupEdit { ...edit, confirm: true, note: "Remove this group from the family library?" }) };
        }
      }
      return m;
    },
    GroupSaved(generation, result) => {
      if (generation != m.generation) {
        return m;
      }
      if let Ok(group) = result {
        let groups = m.shelf.groups.filter((item: api.Group): boolean => item.id != group.id).append(group);
        return changed_groups(m, groups, group.id);
      }
      if let Err(err) = result {
        return group_problem(m, err.message);
      }
      return m;
    },
    GroupDeleted(generation, id, result) => {
      if (generation != m.generation) {
        return m;
      }
      if let Err(err) = result {
        return group_problem(m, err.message);
      }
      let groups = m.shelf.groups.filter((item: api.Group): boolean => item.id != id);
      return changed_groups(m, groups, if (m.shelf.group == id) { "" } else { m.shelf.group });
    },
    FilterGroup(group) => {
      return found(Model { ...m, shelf: reset_grid(Shelf { ...m.shelf, group: group, personal: "" }) });
    },
    ToggleSort => {
      return found(Model { ...m, shelf: reset_grid(Shelf { ...m.shelf, by_title: !m.shelf.by_title }) });
    },
    DownloadedOnly => {
      return found(Model { ...m, shelf: reset_grid(Shelf { ...m.shelf, downloaded_only: !m.shelf.downloaded_only }) });
    },
    SearchScope(scope) => {
      return found(Model { ...m, shelf: reset_grid(Shelf { ...m.shelf, search_scope: scope }) });
    },
    PostersVisible(first, last, pinned) => {
      return Model { ...m, shelf: Shelf { ...m.shelf, first_art: first, last_art: last, pinned: pinned } };
    },
    OpenCard(id) => {
      return Model { ...m, menu_open: false, shelf: Shelf { ...m.shelf, opened: id, first_art: 0, last_art: 0 } };
    },
    CloseCard => {
      return Model { ...m, shelf: Shelf { ...m.shelf, opened: "", first_art: 0, last_art: 0 } };
    },
    TracksLoaded(generation, index, result) => {
      return track_result(m, generation, index, result);
    },
    CoverLoaded(generation, address, data) => {
      return cover_result(m, generation, address, data);
    },
    ArtWarmed(_) => {
      return Model { ...m, cover_busy: false };
    },
    ChooseDownloads => {
      return Model { ...m, trip_select: !m.trip_select };
    },
    PickDownload(id) => {
      let picked = !m.trip_cards.get(id).unwrap_or(false);
      return Model { ...m, trip_cards: m.trip_cards.insert(id, picked) };
    },
    DownloadSelected => {
      if (m.token.len() == 0) {
        return m;
      }
      let cards = m.cards.filter((card: api.Card): boolean => m.trip_cards.get(card.id).unwrap_or(false));
      return Model { ...m, trip_select: false, trip_cards: map_new(32), downloads: offline.enqueue(m.downloads, cards) };
    },
    RetryTrack(id) => {
      if (m.token.len() == 0) {
        return m;
      }
      return Model { ...m, downloads: offline.retry(m.downloads, id) };
    },
    PlaybackLoaded(generation, revision, result) => {
      return playback_result(m, generation, revision, result);
    },
    StreamsLoaded(revision, result) => {
      if (revision != m.phone.revision) {
        return m;
      }
      let next = Model { ...m, phone: phone.received(m.phone, revision, result) };
      if let Err(err) = result {
        if (err.expired) {
          return failed(next, err);
        }
      }
      return next;
    },
    PhoneEvent(tagged, arg) => {
      let audio = phone.event(m.phone, android.Posted(tagged, arg));
      let next = finished_phone(m, audio);
      if (m.transfer_from.len() > 0 && m.transfer_revision == m.phone.revision && audio.card == m.phone.card) {
        return Model { ...next, transfer_revision: audio.revision };
      }
      return next;
    },
    RetrySignIn => {
      if (!m.busy && m.refresh.len() > 0) {
        return renew(m);
      }
      return m;
    },
    LibraryLoaded(result) => {
      return loaded(m, result);
    },
    CommandSent(generation, result) => {
      if (generation != m.generation) {
        return m;
      }
      match (result) {
        Ok(_) => {
          return request_playback(Model { ...m, busy: false, note: "Playback request sent." });
        },
        Err(err) => {
          return failed(m, err);
        }
      }
    },
    ToggleMenu => {
      return Model { ...m, menu_open: !m.menu_open };
    },
    OpenTools(page) => {
      let state = m.tools_page;
      let tool = if (state.busy) { state } else { panel_tools.open_page(state, page) };
      return Model { ...m, tools_page: tool, menu_open: false };
    },
    CloseTools => {
      return tools_update(m, panel_tools.back(m.tools_page));
    },
    EnableEditing => {
      if (!m.busy && m.client.len() > 0) {
        return connect(Model { ...m, tools_page: panel_tools.State { ...m.tools_page, editing: true } });
      }
      return m;
    },
    StartScan => {
      let tool = m.tools_page;
      if (!tool.scanning && !tool.busy) {
        return tools_update(m, panel_tools.State { ...tool, action: Some(panel_tools.ScanStart), note: "" });
      }
      return m;
    },
    EditScan(value) => {
      return tools_update(m, panel_tools.State { ...m.tools_page, address: value, scan_result: None });
    },
    ReadScan(value) => {
      if (!m.tools_page.busy) {
        return scan_card(Model { ...m, travel_panel: TravelPanel { ...m.travel_panel, scan_uid: "" } }, value);
      }
      return m;
    },
    ScanResult(generation, result) => {
      if (m.generation != generation) {
        return m;
      }
      let tool = m.tools_page;
      if let Ok(card) = result {
        let ready = tools_update(m, panel_tools.State { ...tool, busy: false, scan_result: Some(card), note: "" });
        let uid = ready.travel_panel.scan_uid;
        let next = Model { ...ready, travel_panel: TravelPanel { ...ready.travel_panel, scan_uid: "" } };
        if (next.travel_panel.tap_to_play && offline.saved(next.downloads, card.id).is_some()) {
          let item = listening.Item { id: card.id, title: card.title };
          let linked = if (uid.len() > 0) { save_tag(next, uid, item, false) } else { next };
          return tag_playback(linked, card.id);
        }
        return next;
      }
      if let Err(err) = result {
        return tools_update(m, panel_tools.State { ...tool, busy: false, note: err.message });
      }
      return m;
    },
    OpenYoto => {
      return tools_update(m, panel_tools.State { ...m.tools_page, action: Some(panel_tools.LaunchOfficial) });
    },
    OpenLink(address) => {
      return tools_update(m, panel_tools.State { ...m.tools_page, action: Some(panel_tools.LaunchLink(address)) });
    },
    OpenScanned(id) => {
      if (card_index(m, id) >= 0) {
        let next = select_tab(m, 1);
        return Model { ...next, tools_page: panel_tools.close_tool(next.tools_page), shelf: Shelf { ...next.shelf, opened: id, first_art: 0, last_art: 0 } };
      }
      return m;
    },
    PlayPreview(card) => {
      if (card.preview.len() == 0 || m.token.len() == 0) {
        return m;
      }
      let playing = phone.loading(m.phone, "", card.title, 0i64);
      let track = api.Stream { title: card.title + " · Preview", url: card.preview, chapter: "", key: "", art: card.cover };
      return Model { ...m, on_phone: true, selected: "", phone: phone.received(playing, playing.revision, Ok([track])), tools_page: panel_tools.close_tool(m.tools_page) };
    },
    DiscoverFilter(filter) => {
      return tools_update(m, panel_tools.State { ...m.tools_page, discover_filter: filter.max(0).min(3) });
    },
    ShowShop => {
      let tool = m.tools_page;
      if (tool.busy) {
        return m;
      }
      if (tool.show_shop || tool.shop.len() > 0) {
        return tools_update(m, panel_tools.State { ...tool, show_shop: !tool.show_shop, note: "" });
      }
      return Model { ...m, tools_page: panel_tools.State { ...tool, show_shop: true, busy: true, note: "Loading shop titles…" }, job: Some(ReadShop(m.generation)) };
    },
    ShopLoaded(generation, result) => {
      if (generation != m.generation) {
        return m;
      }
      let tool = panel_tools.State { ...m.tools_page, busy: false, note: "" };
      match (result) {
        Ok(items) => {
          return tools_update(m, panel_tools.State { ...tool, shop: items });
        },
        Err(err) => {
          return tools_update(m, panel_tools.State { ...tool, show_shop: false, note: err.message });
        }
      }
    },
    EditPlaylist(id) => {
      let tool = m.tools_page;
      if (tool.busy || tool.recording || tool.importing) {
        return m;
      }
      if (id.len() == 0) {
        panel_tools.clear_audio(tool.draft);
        return tools_update(m, panel_tools.State { ...tool, draft: api.empty_playlist(), note: "" });
      }
      if let Some(card) = m.cards.find((card: api.Card): boolean => card.id == id && card.myo) {
        let editor = panel_tools.open_page(tool, panel_tools.Create);
        return Model { ...m, tools_page: panel_tools.State { ...editor, busy: true, note: "Loading playlist…" }, job: Some(ReadPlaylist(m.generation, m.token, card)) };
      }
      return m;
    },
    PlaylistLoaded(generation, result) => {
      if (generation != m.generation) {
        return m;
      }
      let tool = m.tools_page;
      if let Ok(draft) = result {
        panel_tools.clear_audio(tool.draft);
        return tools_update(m, panel_tools.State { ...tool, draft: draft, busy: false, note: "" });
      }
      if let Err(err) = result {
        return tools_update(m, panel_tools.State { ...tool, busy: false, note: err.message });
      }
      return m;
    },
    PlaylistSaved(generation, result) => {
      if (generation != m.generation) {
        return m;
      }
      let tool = m.tools_page;
      if let Ok(id) = result {
        let title = tool.draft.title;
        panel_tools.clear_audio(tool.draft);
        return reload(Model { ...m, tools_page: panel_tools.State { ...tool, draft: api.empty_playlist(), busy: false, note: "Saved " + title + "." } });
      }
      if let Err(err) = result {
        return tools_update(m, panel_tools.State { ...tool, busy: false, note: err.message });
      }
      return m;
    },
    DraftTitle(title) => {
      let tool = m.tools_page;
      return tools_update(m, panel_tools.State { ...tool, draft: api.Playlist { ...tool.draft, title: title } });
    },
    DraftCover(cover) => {
      let tool = m.tools_page;
      return tools_update(m, panel_tools.State { ...tool, choosing_cover: false, draft: api.Playlist { ...tool.draft, cover: cover } });
    },
    PickCover => {
      let tool = m.tools_page;
      return tools_update(m, panel_tools.State { ...tool, choosing_cover: !tool.choosing_cover });
    },
    ChapterTitle(index, title) => {
      return tools_update(m, change_chapter(m.tools_page, index, title));
    },
    MoveChapter(from, to) => {
      return tools_update(m, move_chapter(m.tools_page, from, to));
    },
    DropChapter(index) => {
      let tool = m.tools_page;
      let parts = tool.draft.chapters;
      if (index >= 0 && index < parts.len()) {
        if let Some(audio) = parts[index].audio {
          if (audio.temporary) {
            let removed = remove_file(audio.path);
          }
        }
        let chapters = array.slice(parts, 0, index).concat(array.slice(parts, index + 1, parts.len()));
        return tools_update(m, panel_tools.State { ...tool, draft: api.Playlist { ...tool.draft, chapters: chapters } });
      }
      return m;
    },
    SetRecorder => {
      let tool = m.tools_page;
      let action = if (tool.recording) { panel_tools.RecordStop } else { panel_tools.RecordStart };
      return tools_update(m, panel_tools.State { ...tool, action: Some(action) });
    },
    ImportAudio => {
      let tool = m.tools_page;
      let Some(panel_tools.Create) = tool.page else {
        return m;
      };
      if (tool.busy || tool.importing || tool.recording) {
        return m;
      }
      if (tool.draft.chapters.len() >= api.MAX_PLAYLIST_CHAPTERS) {
        return tools_update(m, panel_tools.State { ...tool, note: "A playlist can have up to 100 chapters." });
      }
      return tools_update(m, panel_tools.State { ...tool, action: Some(panel_tools.PickAudio), importing: true, import_id: tool.import_id + 1, note: "" });
    },
    AudioImportStarted(id) => {
      let tool = m.tools_page;
      if (tool.importing && tool.import_id == id) {
        return tools_update(m, panel_tools.State { ...tool, note: "Copying audio to this playlist…" });
      }
      return m;
    },
    AudioImported(id, files, note) => {
      let tool = m.tools_page;
      if (!tool.importing || tool.import_id != id) {
        myo_audio.discard(files);
        return m;
      }
      return tools_update(m, panel_tools.add_audio(tool, files, note));
    },
    SavePlaylist => {
      return save_draft(m);
    },
    Refresh => {
      if (!m.busy && m.token.len() > 0) {
        return reload(Model { ...m, menu_open: false, warmed: map_new(64) });
      }
      return m;
    },
    SignOut => {
      if (!m.busy) {
        return forget(Model { ...m, menu_open: false }, "");
      }
      return m;
    },
    SelectPlayer(id) => {
      let state = if (m.on_phone) { phone.stop(m.phone) } else { m.phone };
      return read_playback(request_playback(Model { ...m, target_open: false, selected: id, on_phone: false, phone: state, device_status: None, device_note: "" }));
    },
    SelectPhone => {
      return request_playback(Model { ...m, target_open: false, selected: "", on_phone: true });
    },
    OpenSettings(player) => {
      return show_settings(m, player);
    },
    CloseSettings => {
      return Model { ...m, config_panel: panel(m.config_panel.revision + 1i64) };
    },
    EditSetting(key, value) => {
      let p = m.config_panel;
      if (!p.working && p.config.is_some()) {
        return Model { ...m, config_panel: ConfigPanel { ...p, draft: p.draft.insert(key, value), note: "" } };
      }
      return m;
    },
    SaveSettings => {
      return save_settings(m);
    },
    EditAlarm(edit) => {
      let p = m.config_panel;
      if let Some(config) = p.config {
        if (!p.working) {
          match (settings.alarm_change(config, p.draft, edit)) {
            Ok(draft) => {
              return Model { ...m, config_panel: ConfigPanel { ...p, draft: draft, note: "" } };
            },
            Err(note) => {
              return Model { ...m, config_panel: ConfigPanel { ...p, note: note } };
            }
          }
        }
      }
      return m;
    },
    ChooseAlarmCard => {
      return Model { ...m, config_panel: ConfigPanel { ...m.config_panel, picker: Some(AlarmCards), query: "" } };
    },
    ChooseSetting(key) => {
      let p = m.config_panel;
      if (settings.light_key(key) && !p.working) {
        if let Some(config) = p.config {
          let value = settings.setting_value(config, p.draft, key);
          let colour = light_colour.parse(value).unwrap_or(light_colour.Hsv { hue: 0.1, saturation: 0.47, brightness: 1.0 });
          return Model { ...m, config_panel: ConfigPanel { ...p, picker: Some(LightColour(key, colour)), note: "" } };
        }
      }
      if (!p.working && p.config.is_some() && settings.choices(key).len() > 0) {
        return Model { ...m, config_panel: ConfigPanel { ...p, picker: Some(SettingChoices(key)), note: "" } };
      }
      return m;
    },
    ChooseSettingValue(value) => {
      let p = m.config_panel;
      if let Some(SettingChoices(key)) = p.picker {
        if (settings.choices(key).any((item: settings.Choice): boolean => item.value == value)) {
          return picked_setting(m, key, value);
        }
      }
      return m;
    },
    AdjustLightColour(colour) => {
      let p = m.config_panel;
      if let Some(LightColour(key, _)) = p.picker {
        return Model { ...m, config_panel: ConfigPanel { ...p, picker: Some(LightColour(key, colour)) } };
      }
      return m;
    },
    UseLightColour => {
      if let Some(LightColour(key, colour)) = m.config_panel.picker {
        return picked_setting(m, key, light_colour.hex(colour));
      }
      return m;
    },
    ChooseShortcutLibrary => {
      let p = m.config_panel;
      if let Some(SettingChoices(key)) = p.picker {
        if (settings.is_shortcut(key)) {
          return Model { ...m, config_panel: ConfigPanel { ...p, picker: Some(ShortcutCards(key)), query: "" } };
        }
      }
      return m;
    },
    FilterSettingCards(query) => {
      return Model { ...m, config_panel: ConfigPanel { ...m.config_panel, query: query } };
    },
    PickSettingCard(id) => {
      let index = card_index(m, id);
      if (index < 0) {
        return m;
      }
      let Some(picker) = m.config_panel.picker else {
        return m;
      };
      match (picker) {
        AlarmCards => {
          return picked_setting(m, "alarm-card", id);
        },
        ShortcutCards(key) | ShortcutTracks(key, _) => {
          return prepare_shortcut(m, key, m.cards[index]);
        },
        _ => {
          return m;
        }
      }
    },
    PickShortcutTrack(index) => {
      if let Some(ShortcutTracks(key, id)) = m.config_panel.picker {
        let at = card_index(m, id);
        if (at >= 0 && index >= 0 && index < m.cards[at].tracks.len()) {
          let card = m.cards[at];
          let track = card.tracks[index];
          if (settings.shortcut_track(track)) {
            return picked_setting(m, key, settings.shortcut_value(card, track));
          }
        }
      }
      return m;
    },
    ShortcutTracksLoaded(revision, result) => {
      return shortcut_result(m, revision, result);
    },
    BackToSettings => {
      return back_from_picker(m);
    },
    ConfigLoaded(revision, saved, result) => {
      return config_result(m, revision, saved, result);
    },
    Download(id) => {
      if (m.token.len() > 0) {
        let cards = m.cards.filter((card: api.Card): boolean => id.len() == 0 || card.id == id);
        return Model { ...m, downloads: offline.enqueue(m.downloads, cards) };
      }
      return m;
    },
    DownloadPrepared(revision, result) => {
      let state = offline.received(m.downloads, revision, result);
      if (m.downloads.revision == revision && m.downloads.fetching.is_some()) {
        if let Err(error) = result {
          if (error.expired) {
            return failed(Model { ...m, downloads: state }, error);
          }
        }
      }
      return Model { ...m, downloads: state };
    },
    CancelDownload => {
      return Model { ...m, downloads: offline.cancel(m.downloads) };
    },
    ResumeDownload => {
      return Model { ...m, downloads: offline.resume(m.downloads) };
    },
    RemoveDownload(id) => {
      let state = m.phone;
      if (state.card == id && state.at < state.queue.len() && state.queue[state.at].url.starts_with("file://")) {
        state = phone.stop(state);
      }
      return Model { ...m, downloads: offline.remove(m.downloads, id), phone: state, offline_open: "" };
    },
    OpenDownload(id) => {
      return Model { ...m, offline_open: id, shelf: Shelf { ...m.shelf, first_art: 0, last_art: 0 } };
    },
    PlayDownload(id, at) => {
      if let Some(entry) = offline.saved(m.downloads, id) {
        return play_download(m, entry, at);
      }
      return m;
    },
    QueueCard(id) => {
      if let Some(item) = queue_item(m, id) {
        let tools = m.playback_tools;
        let saved = listening.Saved { ...tools.saved, queue: [item].concat(tools.saved.queue) };
        return Model { ...m, playback_tools: PlaybackTools { ...tools, saved: saved, dirty: true, trip: [], note: item.title + " will play next." } };
      }
      return m;
    },
    DropQueued(index) => {
      let tools = m.playback_tools;
      if (index >= 0 && index < tools.saved.queue.len()) {
        let saved = listening.Saved { ...tools.saved, queue: tools.saved.queue.take(index).concat(tools.saved.queue.drop(index + 1)) };
        return Model { ...m, playback_tools: PlaybackTools { ...tools, saved: saved, dirty: true, trip: [], note: "" } };
      }
      return m;
    },
    StartQueue => {
      return play_queued(m);
    },
    ResumeCard(id) => {
      if (m.playback_tools.saved.kids && !listening.favourite(m.playback_tools.saved, id)) {
        return m;
      }
      return stream_card(phone_target(m), id, "", "");
    },
    BookmarkHere => {
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, naming_bookmark: true, bookmark_name: "" } };
    },
    BookmarkName(name) => {
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, bookmark_name: name } };
    },
    SaveBookmark => {
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, sample: true, bookmark_now: true, naming_bookmark: false } };
    },
    ShowHistory => {
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, history_open: !m.playback_tools.history_open } };
    },
    FilterHistory(filter) => {
      return Model { ...m, playback_tools: PlaybackTools { ...m.playback_tools, history_filter: filter } };
    },
    OpenLineup(name) => {
      let tools = m.playback_tools;
      let line = lineup_by_name(m, name).unwrap_or(listening.Lineup { id: "", name: "", cards: tools.saved.queue });
      let draft = TripDraft { original: line.name, title: line.name, items: line.cards, adding: false, query: "" };
      return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: Some(draft), note: "" } };
    },
    CloseLineup => {
      let tools = m.playback_tools;
      if let Some(draft) = tools.draft {
        let remaining = if (draft.adding) { Some(TripDraft { ...draft, adding: false }) } else { None };
        return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: remaining, note: "" } };
      }
      return m;
    },
    LineupTitle(name) => {
      let tools = m.playback_tools;
      return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: tools.draft.map((draft: TripDraft): TripDraft => TripDraft { ...draft, title: name }) } };
    },
    FindLineupCards(text) => {
      let tools = m.playback_tools;
      return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: tools.draft.map((draft: TripDraft): TripDraft => TripDraft { ...draft, query: text }) } };
    },
    PickLineupCards => {
      let tools = m.playback_tools;
      return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: tools.draft.map((draft: TripDraft): TripDraft => TripDraft { ...draft, adding: true }) } };
    },
    AddLineupCard(id) => {
      let tools = m.playback_tools;
      if let Some(item) = queue_item(m, id) {
        return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: tools.draft.map((draft: TripDraft): TripDraft => TripDraft { ...draft, items: draft.items.append(item) }) } };
      }
      return m;
    },
    MoveLineupCard(from, to) => {
      let tools = m.playback_tools;
      return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: tools.draft.map((draft: TripDraft): TripDraft => TripDraft { ...draft, items: array.moved(draft.items, from, to) }) } };
    },
    DropLineupCard(index) => {
      let tools = m.playback_tools;
      return Model { ...m, playback_tools: PlaybackTools { ...tools, draft: tools.draft.map((draft: TripDraft): TripDraft => TripDraft { ...draft, items: draft.items.take(index).concat(draft.items.drop(index + 1)) }) } };
    },
    SaveLineup => {
      if let Some(draft) = m.playback_tools.draft {
        return save_lineup(m, draft);
      }
      return m;
    },
    StartLineup(name) => {
      if let Some(line) = lineup_by_name(m, name) {
        return start_lineup(m, line);
      }
      return m;
    },
    PrimeLineup(name) => {
      if let Some(line) = lineup_by_name(m, name) {
        return prime_lineup(m, line);
      }
      return m;
    },
    CheckLineup(name) => {
      if let Some(line) = lineup_by_name(m, name) {
        return queue_check(m, line.cards);
      }
      return m;
    },
    ToggleFavourite(id) => {
      if let Some(item) = queue_item(m, id) {
        return set_saved(m, listening.toggle_favourite(m.playback_tools.saved, item));
      }
      return m;
    },
    EnterKids => {
      let saved = m.playback_tools.saved;
      if (saved.parent_key.len() == 0 || saved.kids) {
        return Model { ...m, parent: ParentGate { ...closed_gate(), open: true }, menu_open: false };
      }
      return kids_mode(m, saved);
    },
    ParentCode(digit) => {
      let parent = m.parent;
      if (digit < 0) {
        return Model { ...m, parent: ParentGate { ...parent, code: parent.code.take((parent.code.len() - 1).max(0)), note: "" } };
      }
      if (digit <= 9 && parent.code.len() < 8 && !parent.busy) {
        return Model { ...m, parent: ParentGate { ...parent, code: parent.code + digit.to_string(), note: "" } };
      }
      return m;
    },
    ParentSubmit => {
      let parent = m.parent;
      let saved = m.playback_tools.saved;
      if (parent.busy || !listening.valid_pin(parent.code) || now_unix_ms() < saved.retry_pin_at) {
        return m;
      }
      if (saved.parent_key.len() == 0 && parent.first.len() == 0) {
        return Model { ...m, parent: ParentGate { ...parent, first: parent.code, code: "", note: "" } };
      }
      if (saved.parent_key.len() == 0 && parent.first != parent.code) {
        return Model { ...m, parent: ParentGate { ...parent, first: "", code: "", note: "The PINs did not match." } };
      }
      return Model { ...m, parent: ParentGate { ...parent, busy: true, code: "", first: "", note: "" }, job: Some(PinWork(parent.code, saved.parent_key)) };
    },
    ParentResult(key, accepted) => {
      return parent_result(m, key, accepted);
    },
    CloseParent => {
      if (!m.parent.busy) {
        return Model { ...m, parent: closed_gate() };
      }
      return m;
    },
    PinCard(id) => {
      return Model { ...m, shortcut: "dev.fern.storydeck.CARD." + id };
    },
    PinResume => {
      return Model { ...m, shortcut: "dev.fern.storydeck.RESUME" };
    },
    PinLineup(name) => {
      if let Some(line) = lineup_by_name(m, name) {
        return Model { ...m, shortcut: "dev.fern.storydeck.TRIP." + line.id };
      }
      return m;
    },
    ShortcutAction(action) => {
      if (m.library_loaded) {
        return apply_shortcut(m, action);
      }
      return shortcut_received(m, action);
    },
    IndexSaved(generation, revision, data) => {
      if (generation != m.generation || m.token.len() == 0 || !m.library_loaded) {
        return Model { ...m, index_saving: false };
      }
      let saved = library_cache.save(m.cache_dir, data);
      let note = if (saved) { m.session_note } else { "Could not save the library index." };
      return Model { ...m, index_saving: false, stored_index: revision, session_note: note };
    },
    MoveToPlayer(id) => {
      return Model { ...m, transfer_target: id, playback_tools: PlaybackTools { ...m.playback_tools, sample: true } };
    },
    MoveToPhone => {
      return move_to_phone(m);
    },
    PlaybackMoved(generation, revision, id, to_player, result) => {
      if (generation != m.generation || revision != m.phone.revision) {
        return Model { ...m, transfer_note: "" };
      }
      if let Err(err) = result {
        return Model { ...m, transfer_note: err.message };
      }
      if (to_player) {
        return request_playback(Model { ...m, selected: id, on_phone: false, phone: phone.stop(m.phone), transfer_note: "" });
      }
      return Model { ...m, transfer_note: "" };
    },
    ChapterSleep => {
      let phone = phone.chapter_timer(m.phone, !m.phone.stop_at_chapter);
      return Model { ...m, phone: phone, playback_tools: PlaybackTools { ...m.playback_tools, sleep_at: 0i64 } };
    },
    ResumeBookmark(mark) => {
      return stream_at(phone_target(m), mark.item.id, mark.chapter, mark.key, mark.position);
    },
    RemoveBookmark(id, name) => {
      let tools = m.playback_tools;
      return Model { ...m, playback_tools: PlaybackTools { ...tools, saved: listening.unpin(tools.saved, id, name), dirty: true, note: "" } };
    },
    SetSleep(minutes) => {
      let end = if (minutes > 0) { monotonic_ns() + minutes as i64 * 60000000000i64 } else { 0i64 };
      return Model { ...m, phone: phone.chapter_timer(m.phone, false), playback_tools: PlaybackTools { ...m.playback_tools, sleep_at: end, note: "" } };
    },
    CheckTrip => {
      let tools = m.playback_tools;
      if (tools.trip_running) {
        return m;
      }
      let items = tools.saved.queue;
      if (m.tab == 2 || items.len() == 0) {
        items = m.downloads.catalog.entries.filter((e: offline.Entry): boolean => e.ready).map((e: offline.Entry): listening.Item => listening.Item { id: e.id, title: e.title });
      }
      return queue_check(m, items);
    },
    TripChecked(report) => {
      let tools = m.playback_tools;
      if (tools.trip_running) {
        return Model { ...m, playback_tools: PlaybackTools { ...tools, trip_running: false, trip: report, note: if (report.len() == 0) { "No cards to check." } else { "" } } };
      }
      return m;
    },
    PhoneNext => {
      if (m.phone.card.len() == 0) {
        return play_queued(m);
      }
      return finished_phone(m, phone.next(m.phone));
    },
    PhonePrevious => {
      return Model { ...m, phone: phone.previous(m.phone) };
    },
    MediaReady => {
      return m;
    },
    PhoneRewind => {
      return Model { ...m, phone: phone.seek(m.phone, (m.phone.elapsed - 15000i64).max(0i64)) };
    },
    PhoneSeek(ms) => {
      return Model { ...m, phone: phone.seek(m.phone, ms) };
    },
    PhoneRate(rate) => {
      return Model { ...m, phone: phone.set_rate(m.phone, rate) };
    },
    OpenNowPlaying => {
      let volume = m.now_playing.playback.map((state: player_status.Playback): i32 => state.volume).unwrap_or(-1);
      let view = Model { ...m, now_open: true, expanded_art: None, volume: if (!m.on_phone && volume >= 0) { volume } else { m.volume } };
      if (!m.on_phone && can_control(m)) {
        return Model { ...view, device_note: "Reading player status…", job: Some(ReadDeviceStatus(m.generation, m.token, m.selected)) };
      }
      return view;
    },
    CloseNowPlaying => {
      return Model { ...m, now_open: false, expanded_art: None };
    },
    EnlargeTrackArtwork(address, pixels) => {
      if (m.now_open && m.on_phone && address == phone_art(m)) {
        if let Some(Some(artwork)) = m.shelf.covers.get(address) {
          let image = artwork.image;
          if (image.width > 0 && image.height > 0 && image.pixels.len() == image.width * image.height * 4) {
            let expanded = ExpandedArtwork { address: address, image: enlarged_icon(image, pixels.max(1).min(960)) };
            return Model { ...m, expanded_art: Some(expanded) };
          }
        }
      }
      return m;
    },
    RestoreTrackArtwork => {
      return Model { ...m, expanded_art: None };
    },
    DeviceStatusLoaded(generation, id, result) => {
      if (generation != m.generation || id != m.selected) {
        return m;
      }
      match (result) {
        Ok(status) => {
          return Model { ...m, device_status: Some(status), volume: if (status.volume >= 0) { status.volume } else { m.volume }, device_note: "" };
        },
        Err(err) => {
          return Model { ...m, device_note: err.message };
        }
      }
    },
    DeviceVolume(volume) => {
      return Model { ...m, volume: volume.max(0).min(100) };
    },
    PhoneResume => {
      if let phone.Idle = m.phone.phase {
        return play_queued(m);
      }
      return Model { ...m, phone: phone.control(m.phone, api.Resume) };
    },
    PhoneControl(command) => {
      return Model { ...m, phone: phone.control(m.phone, command), playback_tools: PlaybackTools { ...m.playback_tools, sample: true } };
    },
    SelectTab(tab) => {
      return select_tab(m, tab);
    },
    BackTab => {
      let n = m.tab_history.len();
      if (n > 0) {
        return switch_tab(m, m.tab_history[n - 1], m.tab_history.take(n - 1));
      }
      return m;
    },
    Control(command) => {
      return control(m, command);
    }
  }
}

function start_job(m: Model, msg: Msg): own worker.Worker[Msg][] {
  let Some(job) = m.job else {
    return [];
  };
  return [worker.spawn((): Msg => {
    match (job) {
      Find(work) => {
        return SearchChunk(work.serial, work.first + work.cards.len(), search_part(work));
      },
      SortMatches(serial, cards, hits, title) => {
        return SearchReady(serial, make_matches(cards, hits, title, true));
      },
      Load(token) => {
        return LibraryLoaded(api.library(token));
      },
      Send(generation, token, player, command) => {
        return CommandSent(generation, api.send_command(token, player, command));
      },
      Tracks(generation, index, token, card) => {
        return TracksLoaded(generation, index, api.details(token, card));
      },
      Cover(generation, address, dir, online, watch) => {
        defer close_pipe(watch);
        return CoverLoaded(generation, address, offline.picture_until(dir, address, online, watch));
      },
      WarmArt(generation, address, dir) => {
        let data = offline.picture(dir, address, true);
        return ArtWarmed(generation);
      },
      ReadPlayback(generation, revision, token, id) => {
        return PlaybackLoaded(generation, revision, player_status.playback(token, id));
      },
      LookUpCard(generation, token, id) => {
        return ScanResult(generation, api.lookup_card(token, id));
      },
      ReadPlaylist(generation, token, card) => {
        return PlaylistLoaded(generation, api.edit_playlist(token, card));
      },
      AnalyzeAudio(revision, audio) => {
        return WaveReady(revision, myo_audio.analyze(audio));
      },
      RenderEditedAudio(revision, audio, title, dir, edit) => {
        return AudioRendered(revision, myo_audio.render(audio, title, dir, edit));
      },
      WritePlaylist(generation, token, draft) => {
        return PlaylistSaved(generation, api.save_playlist(token, draft));
      },
      ReadShop(generation) => {
        return ShopLoaded(generation, api.shop_titles());
      },
      WriteGroup(generation, token, edit) => {
        return GroupSaved(generation, api.save_group(token, edit.id, edit.name, edit.members, edit.image));
      },
      RemoveGroup(generation, token, id) => {
        return GroupDeleted(generation, id, api.delete_group(token, id));
      },
      ReadDeviceStatus(generation, token, id) => {
        return DeviceStatusLoaded(generation, id, player_status.device(token, id));
      },
      Streams(revision, token, card, chapter, track) => {
        return StreamsLoaded(revision, api.streams(token, card, chapter, track));
      },
      ReadConfig(revision, token, player) => {
        return ConfigLoaded(revision, false, api.player_config(token, player));
      },
      WriteConfig(revision, token, player, config, edits) => {
        return ConfigLoaded(revision, true, api.save_config(token, player, config, edits));
      },
      ReadShortcutTracks(revision, token, card) => {
        return ShortcutTracksLoaded(revision, api.details(token, card));
      },
      GetDownload(revision, token, card) => {
        return DownloadPrepared(revision, api.download_plan(token, card));
      },
      TripCheck(catalog, items) => {
        return TripChecked(listening.check_trip(catalog, items));
      },
      PinWork(code, key) => {
        if (key.len() == 0) {
          return ParentResult(listening.make_key(code), false);
        }
        return ParentResult("", listening.check_pin(code, key));
      },
      SaveIndex(generation, cards, revision) => {
        return IndexSaved(generation, revision, library_cache.encode(cards));
      },
      TransferPlayback(generation, revision, token, player, command, to_player) => {
        return PlaybackMoved(generation, revision, player, to_player, api.send_command(token, player, command));
      }
    }
  })];
}

function save_listening(m: Model, output: phone.Output, store: (listening.Saved) => boolean, force: boolean): Model {
  let state = m.playback_tools;
  let phone = m.phone;
  if (state.trip_test_until == 0i64 && (state.sample || force) && phone.card.len() > 0 && phone.at < phone.queue.len()) {
    if let Some(media) = phone.media {
      if let phone.Playing | phone.Paused = phone.phase {
        let track = phone.queue[phone.at];
        let ms = output.position(media).max(0i64);
        let before = listening.mark(state.saved, phone.card);
        let changed = before.is_none() || before.map((mark: listening.Bookmark): boolean => mark.chapter != track.chapter || mark.key != track.key || (mark.position - ms).abs() >= 5000i64).unwrap_or(false);
        if (force || state.bookmark_now || changed) {
          let item = listening.Item { id: phone.card, title: phone.title };
          let name = state.bookmark_name.trim().to_owned();
          let mark = listening.Bookmark { item: item, chapter: track.chapter, key: track.key, position: ms, name: if (name.len() > 0) { name } else { "Bookmark" } };
          let heard = listening.heard(listening.remember(state.saved, mark), item, false, now_unix_ms());
          let saved = if (state.bookmark_now) { listening.pin(heard, mark) } else { heard };
          state = PlaybackTools { ...state, dirty: true, saved: saved };
        }
      }
    }
  }
  let pending = offline.pending(m.downloads);
  let before = state.saved.downloads.map((card: api.Card): string => card.id);
  let held = m.downloads.held;
  if (before != pending.map((card: api.Card): string => card.id)
    || state.saved.held_downloads.map((card: api.Card): string => card.id) != held.map((card: api.Card): string => card.id)) {
    state = PlaybackTools { ...state, saved: listening.Saved { ...state.saved, downloads: pending, held_downloads: held }, dirty: true };
  }
  if (state.dirty && store(state.saved)) {
    let note = if (state.bookmark_now) { "Bookmark saved." } else { state.note };
    state = PlaybackTools { ...state, dirty: false, note: note };
  }
  return Model { ...m, playback_tools: PlaybackTools { ...state, sample: false, bookmark_now: false } };
}

function effects(m: Model, open_browser: (string) => boolean, decode: (u8[], i32) => Option[draw.Image], persist: (Option[api.Session]) => boolean, output: phone.Output, disk: offline.Output, store: (listening.Saved) => boolean): Model {
  let state = Model { ...m, job: None };
  if (m.cover_stop >= 0 && !playback_pictures(m).contains(m.cover_active) && !visible_covers(m).contains(m.cover_active)) {
    close_pipe(m.cover_stop);
    state = Model { ...state, cover_active: "", cover_stop: -1 };
  }
  let saved = save_session(store_cover(state, decode), persist);
  let target = saved.playback_tools.profile_target;
  if (target.len() > 0) {
    let old = save_listening(saved, output, store, true);
    let tools = old.playback_tools;
    let profile = listening.switch_profile(tools.saved, target);
    saved = Model { ...old, phone: phone.stop(old.phone), playback_tools: PlaybackTools { ...tools, saved: profile, profile_target: "", dirty: true, note: "" } };
  }
  let stepped = phone.apply(saved.phone, output);
  let was_playing = if let phone.Playing = saved.phone.phase { true } else { false };
  if (!was_playing && if let phone.Playing = stepped.phase { true } else { false }) {
    saved = Model { ...saved, playback_tools: PlaybackTools { ...saved.playback_tools, sample: true } };
  }
  let applied = if (saved.playback_tools.sample) { phone.prime(stepped, output) } else { stepped };
  let sampled = if (saved.playback_tools.sample) { phone.sample(applied, output) } else { applied };
  let gain = if let phone.Playing = sampled.phase {
    let end = saved.playback_tools.sleep_at;
    if (saved.playback_tools.saved.fade && end > 0i64) {
      (end - monotonic_ns()).max(0i64).min(5000000000i64) as f32 / 5000000000.0f32
    } else { 1.0f32 }
  } else { 1.0f32 };
  let audio = phone.link_gapless(phone.volume(sampled, gain, output), output);
  if (saved.playback_tools.saved.held_downloads.map((card: api.Card): string => card.id) != saved.downloads.held.map((card: api.Card): string => card.id)) {
    saved = save_listening(saved, output, store, false);
  }
  let downloads = offline.apply(saved.downloads, disk);
  if (saved.wifi_requeue.len() > 0) {
    downloads = offline.move_first(offline.resume_card(downloads, saved.wifi_requeue), saved.wifi_requeue);
  }
  let catalog = if (saved.enrich_downloads) { offline.enrich(downloads, saved.cards, disk) } else { downloads };
  let t = save_listening(Model { ...saved, phone: audio, downloads: catalog, wifi_requeue: "", enrich_downloads: false }, output, store, false);
  if (t.travel_panel.bedtime_sound.is_some() && t.travel_panel.bedtime_story != t.phone.card) {
    t = Model { ...t, travel_panel: TravelPanel { ...t.travel_panel, bedtime_sound: None, bedtime_story: "" } };
  }
  if (t.travel_panel.bedtime_sleeping.len() > 0 && t.travel_panel.bedtime_sleeping != t.phone.card) {
    t = Model { ...t, travel_panel: TravelPanel { ...t.travel_panel, bedtime_sleeping: "" }, playback_tools: PlaybackTools { ...t.playback_tools, sleep_at: 0i64 } };
  }
  if (t.travel_panel.single_listen.len() > 0 && t.travel_panel.single_listen != t.phone.card) {
    t = Model { ...t, travel_panel: TravelPanel { ...t.travel_panel, single_listen: "" } };
  }
  if (t.expanded_art.is_some() && visible_expansion(t).is_none()) {
    t = Model { ...t, expanded_art: None };
  }
  if (ready_downloads(saved.downloads) != ready_downloads(t.downloads)) {
    if (!t.library_loaded && !t.cache_available && t.token.len() == 0) {
      t = found(Model { ...t, cards: offline.saved_cards(t.downloads) });
    } else if (t.shelf.downloaded_only) {
      t = found(t);
    }
  }
  if (!t.open_login) {
    return t;
  }
  let ready = Model { ...t, open_login: false };
  match (oauth.begin(ready.client, monotonic_ns() / 1000000i64, ready.tools_page.editing)) {
    Ok((flow, address)) => {
      if (open_browser(address)) {
        return Model { ...ready, flow: Some(flow) };
      }
      oauth.close(flow);
      return Model { ...ready, busy: false, note: "Could not open your browser." };
    },
    Err(note) => {
      return Model { ...ready, busy: false, note: note };
    }
  }
}

function ready_downloads(s: offline.State): i32 {
  return s.catalog.entries.filter((entry: offline.Entry): boolean => entry.ready).len();
}

function sign_in(m: Model): ui.El[Msg] {
  if (m.refresh.len() > 0) {
    let actions: ui.El[Msg][] = [ui.text(m.note).colored(ui.MUTED)];
    if (!m.busy && !m.reconnect) {
      actions = actions.append(ui.button("Try again", RetrySignIn)).append(ui.text_button("Sign out", SignOut));
    }
    return ui.card(actions).spaced(12.0).wide();
  }
  let items: ui.El[Msg][] = [
    ui.text("Works with Yoto").sized(16.0).colored(ui.MUTED),
    ui.text("Connect your account to see your players and library.").sized(20.0).weighted(600),
  ];
  if (!m.busy) {
    items = items.append(ui.text("Public client ID").weighted(500));
    items = items.append(ui.field("client", m.client, "Yoto developer client ID").on_edit((text: string): Msg => EditClient(text)).on_submit(Msg.Connect));
    items = items.append(ui.button("Connect to Yoto", Msg.Connect));
  }
  if (m.flow.is_some()) {
    items = items.append(ui.outlined_button("Cancel sign-in", Cancel));
  }
  if (m.note.len() > 0) {
    items = items.append(ui.text(m.note).colored(ui.MUTED));
  }
  return ui.card(items).spaced(14.0).wide();
}

function player_row(player: api.Player, active: boolean): ui.El[Msg] {
  let state = "Offline";
  if (player.online) {
    state = "Online";
  }
  if (active) {
    state += " · Selected";
  }
  let label = ui.column[Msg]([
    ui.text(player.name).sized(17.0).weighted(600).clamped(1),
    ui.text(state).colored(ui.MUTED),
  ]).spaced(4.0).wide().on_tap(SelectPlayer(player.id)).described(player.name + ", " + state);
  let gear = ui.text_button("Settings", OpenSettings(player)).described("Settings for " + player.name);
  let row = ui.card([ui.row([label, gear]).aligned(ui.CENTER).spaced(8.0)]).wide();
  if (active) {
    row = row.border(ui.PRIMARY, 1.0);
  }
  return ui.column([row]).padding_xy(0.0, 4.0).wide();
}

function playing_info(m: Model): ui.El[Msg][] {
  let now = m.now_playing;
  if (now.note.len() > 0) {
    return [ui.text(now.note).colored(ui.MUTED)];
  }
  let Some(playback) = now.playback else {
    return [];
  };
  if (playback.state != "playing" && playback.state != "paused") {
    return [];
  }
  let state = if (playback.state == "paused") { "Paused" } else { "Playing" };
  let items: ui.El[Msg][] = [ui.text(state).colored(ui.PRIMARY).weighted(600)];
  let any_title = "";
  for card in m.cards {
    if (card.id == playback.card) {
      any_title = card.title;
      break;
    }
  }
  let detail = if (playback.track.len() > 0) { playback.track } else { playback.chapter };
  if (any_title.len() > 0) {
    items = items.append(ui.text(any_title).sized(17.0).weighted(600).clamped(2));
  }
  if (detail.len() > 0 && detail != any_title) {
    items = items.append(ui.text(detail).colored(ui.MUTED).clamped(2));
  }
  let details = ui.column(items).spaced(4.0).wide();
  let address = player_art(m, playback);
  if (address.len() > 0) {
    return [ui.card([ui.row([art(m.shelf, address, 52.0), details]).aligned(ui.CENTER).spaced(12.0)]).wide()];
  }
  return [ui.card([details]).wide()];
}

function player_list(m: Model): ui.El[Msg] {
  let picker = ui.space[Msg]();
  if (m.players.len() > 0) {
    let players = m.players;
    let id = m.selected;
    picker = ui.list("players", players.len(), 96.0, (i: i32): ui.El[Msg] => player_row(players[i], id == players[i].id));
  } else if (m.library_loaded) {
    picker = ui.text[Msg]("No players linked to this account.").colored(ui.MUTED);
  }
  let label = if (m.on_phone) { "This phone, selected" } else { "This phone" };
  let handset = ui.card[Msg]([ui.text("This phone").sized(17.0).weighted(600)]).wide().on_tap(SelectPhone).described(label);
  if (m.on_phone) {
    handset = handset.border(ui.PRIMARY, 1.0);
  }
  let items: ui.El[Msg][] = [ui.text[Msg]("Your players").sized(23.0).weighted(700), handset];
  if (!m.on_phone) {
    items = items.concat(playing_info(m));
  }
  if (m.selected.len() > 0 || m.on_phone) {
    items = items.append(ui.outlined_button("Now playing and player status", OpenNowPlaying));
  }
  if (!m.on_phone && can_control(m)) {
    items = items.append(ui.row([
      ui.text_button("Pause", Control(api.Pause)),
      ui.text_button("Resume", Control(api.Resume)),
      ui.text_button("Stop", Control(api.Stop)),
    ]).spaced(4.0));
  }
  return ui.column(items.append(picker)).spaced(10.0).wide().tall();
}

function settings_card_picker(m: Model, heading: string): ui.El[Msg] {
  let query = m.config_panel.query;
  let terms = query.trim().to_lower().to_owned();
  let cards = m.cards.filter((card: api.Card): boolean => card.search.contains(terms));
  let inputs: ui.El[Msg][] = [
    ui.text_button("Back", BackToSettings),
    ui.text[Msg](heading).sized(24.0).weighted(700),
    ui.field[Msg]("settings-card-search", query, "Search your library").on_edit((text: string): Msg => FilterSettingCards(text)),
    ui.list("settings-cards:" + heading + ":" + query, cards.len(), 60.0, (at: i32): ui.El[Msg] => {
      let card = cards[at];
      return ui.row([ui.text[Msg](card.title).clamped(2).wide()]).padding_xy(12.0, 8.0).wide().on_tap(PickSettingCard(card.id)).described(card.title);
    }),
  ];
  return ui.column(inputs).spaced(10.0).padding(16.0).wide().tall();
}

function setting_choices(m: Model, key: string): ui.El[Msg] {
  let p = m.config_panel;
  let current = "";
  if let Some(config) = p.config {
    current = settings.setting_value(config, p.draft, key);
  }
  let rows: ui.El[Msg][] = [ui.text_button("Back to settings", BackToSettings), ui.text[Msg](settings.label(key)).sized(24.0).weighted(700)];
  for item in settings.choices(key) {
    let action = ChooseSettingValue(item.value);
    let row = ui.card([ui.row([ui.radio(current == item.value, item.label, action), ui.text[Msg](item.label).wide()]).aligned(ui.CENTER)]).wide().on_tap(action).described(item.label);
    rows = rows.append(row);
  }
  if (settings.is_shortcut(key)) {
    rows = rows.append(ui.outlined_button("Choose from library", ChooseShortcutLibrary));
  }
  return ui.column(rows).spaced(10.0).padding(16.0).wide().tall().scroll("setting-choices:" + key);
}

function shortcut_tracks(m: Model, id: string): ui.El[Msg] {
  let p = m.config_panel;
  let rows: ui.El[Msg][] = [ui.text_button("Back to cards", BackToSettings)];
  let index = card_index(m, id);
  if (index >= 0) {
    let card = m.cards[index];
    rows = rows.append(ui.text[Msg](card.title).sized(24.0).weighted(700).clamped(2));
    let tracks: i32[] = [];
    for i in 0..card.tracks.len() {
      if (settings.shortcut_track(card.tracks[i])) {
        tracks = tracks.append(i);
      }
    }
    if (tracks.len() > 0) {
      rows = rows.append(ui.text[Msg]("Choose where the shortcut starts").colored(ui.MUTED));
      rows = rows.append(ui.list("shortcut-tracks:" + id, tracks.len(), 64.0, (at: i32): ui.El[Msg] => {
        let i = tracks[at];
        let track = card.tracks[i];
        let labels: ui.El[Msg][] = [ui.text[Msg](track.title).clamped(2).weighted(600)];
        if (track.chapter.len() > 0 && track.chapter != track.title) {
          labels = labels.append(ui.text[Msg](track.chapter).clamped(1).colored(ui.MUTED));
        }
        return ui.column(labels).padding_xy(12.0, 6.0).wide().on_tap(PickShortcutTrack(i)).described(track.title);
      }));
    } else if (p.working) {
      rows = rows.append(ui.text[Msg]("Loading tracks…").colored(ui.MUTED));
    } else if (p.note.len() > 0) {
      rows = rows.append(ui.text[Msg](p.note).colored(ui.MUTED)).append(ui.text_button("Try again", PickSettingCard(id)));
    } else {
      rows = rows.append(ui.text[Msg]("Yoto did not provide tracks for a shortcut on this card.").colored(ui.MUTED));
    }
  }
  return ui.column(rows).spaced(10.0).padding(16.0).wide().tall();
}

function alarm_card_title(m: Model, id: string): string {
  for card in m.cards {
    if (card.id == id) {
      return card.title;
    }
  }
  return id;
}

function alarm_controls(m: Model, config: api.PlayerConfig): ui.El[Msg][] {
  let d = m.config_panel.draft;
  let Some(alarms) = settings.alarms(config, d) else {
    return [];
  };
  let rows: ui.El[Msg][] = [ui.text[Msg]("Alarms").sized(18.0).weighted(650)];
  for i in 0..alarms.len() {
    let name = "Alarm " + (i + 1).to_string();
    let controls: ui.El[Msg][] = [];
    let caption = name;
    if let json.JString(wire) = alarms[i] {
      let parts = wire.split(",");
      if (parts.len() == 7) {
        caption = parts[1] + " · " + alarm_card_title(m, parts[2]);
        controls = controls.append(ui.toggle(parts[6] == "1", name, EditAlarm(settings.Toggle(i))));
      }
    }
    let remove = ui.text_button("Remove", EditAlarm(settings.Remove(i))).described("Remove " + name.to_lower());
    rows = rows.append(ui.row([ui.text[Msg](caption).wide().clamped(2)].concat(controls).append(remove)).aligned(ui.CENTER).spaced(6.0));
  }
  if (alarms.len() < 10) {
    let days = d.get("alarm-days").unwrap_or("1111111");
    let card = alarm_card_title(m, d.get("alarm-card").unwrap_or(""));
    let choose = if (card.len() > 0) { card } else { "Choose a card" };
    rows = rows.concat([
      ui.text[Msg]("New alarm").weighted(600),
      ui.field[Msg]("alarm-time", d.get("alarm-time").unwrap_or("07:00"), "Alarm time (HH:MM)").on_edit((value: string): Msg => EditSetting("alarm-time", value)),
      ui.field[Msg]("alarm-volume", d.get("alarm-volume").unwrap_or("5"), "Volume (0–8)").on_edit((value: string): Msg => EditSetting("alarm-volume", value)),
      ui.tabs[Msg](["Every day", "Weekdays", "Weekend"], if (days == "1111100") { 1 } else if (days == "0000011") { 2 } else { 0 }, (at: i32): Msg => EditSetting("alarm-days", ["1111111", "1111100", "0000011"][at])),
      ui.row([ui.text_button(choose, ChooseAlarmCard).wide(), ui.text_button("Add alarm", EditAlarm(settings.Add))]).spaced(6.0),
    ]);
  }
  return [ui.card(rows).spaced(8.0).wide()];
}

function settings_panel(m: Model, player: api.Player, screen: ui.Screen): ui.El[Msg] {
  let p = m.config_panel;
  if let Some(picker) = p.picker {
    match (picker) {
      AlarmCards => {
        return settings_card_picker(m, "Choose an alarm card");
      },
      SettingChoices(key) => {
        return setting_choices(m, key);
      },
      ShortcutCards(_) => {
        return settings_card_picker(m, "Choose a shortcut card");
      },
      ShortcutTracks(_, id) => {
        return shortcut_tracks(m, id);
      },
      LightColour(key, colour) => {
        let controls = [
          ui.row([ui.text_button("Cancel", BackToSettings), ui.button("Use colour", UseLightColour)]).spaced(8.0),
          ui.text[Msg](settings.label(key)).sized(24.0).weighted(700),
        ].concat(light_colour.controls(colour, (colour: light_colour.Hsv): Msg => AdjustLightColour(colour), screen.d));
        return ui.column(controls).spaced(8.0).padding(16.0).wide().tall().scroll("light-colour");
      }
    }
  }
  let actions = [ui.text_button("Back to players", CloseSettings)];
  if (!p.working && !m.busy && p.config.is_some() && p.draft.len() > 0) {
    actions = actions.append(ui.button("Save", SaveSettings));
  }
  let items = [
    ui.row(actions).aligned(ui.CENTER).spaced(8.0),
    ui.text[Msg](player.name + " settings").sized(26.0).weighted(700).clamped(2),
  ];
  if (p.working) {
    let working = if (p.config.is_some()) { "Saving settings…" } else { "Loading settings…" };
    items = items.append(ui.text(working).colored(ui.MUTED));
  }
  if (m.note.len() > 0 && m.busy) {
    items = items.append(ui.text(m.note).colored(ui.MUTED));
  }
  if (p.note.len() > 0) {
    items = items.append(ui.text(p.note).colored(ui.MUTED));
    if (p.note.starts_with("Yoto denied access") && !m.busy) {
      items = items.append(ui.text("Enable player management for your public client, then reconnect.").colored(ui.MUTED));
      items = items.append(ui.text_button("Reconnect", Msg.Connect));
    } else if (p.note.starts_with("Alarms changed") && !m.busy) {
      items = items.append(ui.text_button("Reload settings", OpenSettings(player)));
    }
  }
  if (m.flow.is_some()) {
    items = items.append(ui.text_button("Cancel sign-in", Cancel));
  }
  if let Some(config) = p.config {
    let controls = settings.controls(config, p.draft, m.cards, (key: string, value: string): Msg => EditSetting(key, value), (key: string): Msg => ChooseSetting(key)).concat(alarm_controls(m, config));
    items = items.append(ui.column(controls).spaced(12.0).wide().tall().scroll("settings:" + player.id));
  } else if (!p.working && !m.busy) {
    items = items.append(ui.text_button("Reload settings", OpenSettings(player)));
  }
  return ui.column(items).spaced(10.0).padding(16.0).wide().tall();
}

function phone_controls(m: Model): ui.El[Msg][] {
  let s = m.phone;
  if (s.note.len() > 0) {
    return [ui.text(s.note).colored(ui.MUTED)];
  }
  if let phone.Idle = s.phase {
    return [];
  }
  let title = s.title;
  if (s.queue.len() > 0 && s.queue[s.at].title.len() > 0) {
    title = s.queue[s.at].title;
  }
  let state = "Loading";
  let buttons: ui.El[Msg][] = [];
  if let phone.Playing = s.phase {
    state = "Playing";
    buttons = [ui.outlined_button("Pause", Control(api.Pause)).height(48.0)];
  } else if let phone.Paused = s.phase {
    state = "Paused";
    buttons = [ui.outlined_button("Resume", Control(api.Resume)).height(48.0)];
  }
  let label = ui.text[Msg](state + " · " + title).clamped(2).wide();
  let address = phone_art(m);
  let link = ui.column([
    label.on_tap(OpenNowPlaying).described("Open now playing"),
    target_button(m),
  ]).wide();
  let leading = if (address.len() > 0) { [art(m.shelf, address, 44.0).on_tap(OpenNowPlaying).described("Artwork for " + title), link] } else { [link] };
  return [ui.row(leading.concat(buttons)).aligned(ui.CENTER).spaced(6.0)];
}

function playback_bar(m: Model): ui.El[Msg][] {
  if (m.on_phone) {
    return phone_controls(m).map((row: ui.El[Msg]): ui.El[Msg] => ui.card([row]).wide());
  }
  let Some(state) = m.now_playing.playback else {
    return [];
  };
  if (m.tab == 0 || state.state != "playing" && state.state != "paused") {
    return [];
  }
  let paused = state.state == "paused";
  let label = if (state.track.len() > 0) { state.track } else { state.chapter };
  let title = if (label.len() > 0) { label } else { if (paused) { "Paused" } else { "Playing" } };
  return [ui.card([ui.row([
    ui.column([ui.text[Msg](title).wide().clamped(2).on_tap(OpenNowPlaying).described("Open now playing"), target_button(m)]).wide(),
    ui.outlined_button(if (paused) { "Resume" } else { "Pause" }, Control(if (paused) { api.Resume } else { api.Pause })).height(48.0),
  ]).spaced(8.0).aligned(ui.CENTER)]).wide()];
}

function playback_time(ms: i64): string {
  let seconds = (ms / 1000i64).max(0i64);
  return (seconds / 60i64).to_string() + ":" + (seconds % 60i64).to_string().pad_start(2, '0');
}

function phone_now_playing(m: Model, screen: ui.Screen): ui.El[Msg][] {
  let s = m.phone;
  if (s.queue.len() == 0) {
    return [ui.text[Msg](if (s.note.len() > 0) { s.note } else { "Choose a card to play on this phone." }).colored(ui.MUTED)];
  }
  let track = s.queue[s.at];
  let size = (screen.width() * 0.60).min(240.0);
  let (cover, icon) = featured_art(m.shelf, phone_cover(m), phone_art(m));
  let rows: ui.El[Msg][] = [];
  let expanded = visible_expansion(m);
  if let Some(large) = expanded {
    let picture = ui.picture[Msg](large.address, large.image).width(size).height(size).rounded(8.0);
    let action = if (cover.len() > 0) { "Show card cover" } else { "Show small track icon" };
    rows = rows.append(ui.column([
      picture,
      ui.text[Msg](action).colored(ui.PRIMARY),
    ]).spaced(6.0).centered().wide().on_tap(RestoreTrackArtwork).described(action));
  } else if (cover.len() > 0) {
    rows = rows.append(ui.row([art(m.shelf, cover, size)]).centered().wide());
  }
  let labels: ui.El[Msg][] = [
    ui.text[Msg](s.title).sized(16.0).colored(ui.MUTED),
    ui.text[Msg](track.title).sized(23.0).weighted(650),
  ];
  if (expanded.is_none() && icon.len() > 0) {
    let ready = if let Some(Some(_)) = m.shelf.covers.get(icon) { true } else { false };
    if (ready) {
      labels = labels.append(ui.text("Enlarge track artwork").sized(13.0).colored(ui.PRIMARY));
    }
    let title = ui.row([art(m.shelf, icon, 44.0), ui.column(labels).spaced(4.0).wide()]).aligned(ui.CENTER).spaced(12.0).wide();
    if (ready) {
      let pixels = (size * screen.d).round() as i32;
      title = title.on_tap(EnlargeTrackArtwork(icon, pixels)).described("Enlarge track artwork");
    }
    rows = rows.append(title);
  } else {
    rows = rows.append(ui.column(labels).spaced(4.0).wide());
  }
  if (s.duration > 0i64) {
    let duration = s.duration;
    rows = rows.append(ui.slider(s.elapsed as f64 / (duration as f64), (at: f64): Msg => PhoneSeek((at * (duration as f64)) as i64)).described("Track position"));
    rows = rows.append(ui.text(playback_time(s.elapsed) + " / " + playback_time(duration)).colored(ui.MUTED));
  }
  let paused = match (s.phase) { phone.Paused => true, _ => false };
  let play = ui.button(if (paused) { "Resume" } else { "Pause" }, PhoneControl(if (paused) { api.Resume } else { api.Pause }));
  rows = rows.append(ui.row([ui.text_button("Previous", PhonePrevious), play, ui.text_button("Next", PhoneNext)]).spaced(6.0).centered().wide());
  rows = rows.append(ui.text_button("Stop", PhoneControl(api.Stop)));
  if (m.token.len() > 0 && s.card.len() > 0 && track.chapter.len() > 0 && track.key.len() > 0) {
    for player in m.players {
      if (player.online) {
        rows = rows.append(ui.outlined_button("Continue on " + player.name, MoveToPlayer(player.id)));
      }
    }
  }
  let index = [75, 100, 125, 150, 200].position((rate: i32): boolean => rate == s.rate).unwrap_or(1);
  rows = rows.append(ui.text[Msg]("Playback speed").colored(ui.MUTED));
  return rows.append(ui.tabs(["0.75×", "1×", "1.25×", "1.5×", "2×"], index, (i: i32): Msg => PhoneRate([75, 100, 125, 150, 200][i])));
}

function device_transport(m: Model, state: player_status.Playback, play: ui.El[Msg]): ui.El[Msg][] {
  if (state.position < 0 || state.chapter_key.len() == 0 || state.track_key.len() == 0 || state.card.len() == 0) {
    return [ui.row([play]).centered().wide()];
  }
  let rewind = api.PlayAt(state.card, state.chapter_key, state.track_key, (state.position - 15).max(0));
  let forward = api.PlayAt(state.card, state.chapter_key, state.track_key, (state.position + 30).min(state.duration.max(state.position)));
  let tracks = [play];
  let i = card_index(m, state.card);
  if (i >= 0) {
    let all = m.cards[i].tracks;
    let at = all.position((item: api.Track): boolean => item.chapter_key == state.chapter_key && item.track_key == state.track_key).unwrap_or(-1);
    if (at > 0) {
      let previous = all[at - 1];
      tracks = [ui.text_button("Previous", Control(api.PlayTrack(state.card, previous.chapter_key, previous.track_key)))].concat(tracks);
    }
    if (at >= 0 && at + 1 < all.len()) {
      let next = all[at + 1];
      tracks = tracks.append(ui.text_button("Next", Control(api.PlayTrack(state.card, next.chapter_key, next.track_key))));
    }
  }
  return [
    ui.text[Msg](playback_time(state.position as i64 * 1000i64) + " / " + playback_time(state.duration as i64 * 1000i64)).colored(ui.MUTED),
    ui.row(tracks).spaced(6.0).centered().wide(),
    ui.row([ui.text_button("Back 15 s", Control(rewind)), ui.text_button("Forward 30 s", Control(forward))]).spaced(6.0).centered().wide(),
  ];
}

function device_controls(m: Model): ui.El[Msg][] {
  let rows = playing_info(m);
  if let Some(status) = m.device_status {
    if (status.battery >= 0) {
      rows = rows.append(ui.text("Battery " + status.battery.to_string() + "%").colored(ui.MUTED));
    }
    if (status.free_bytes >= 0i64) {
      rows = rows.append(ui.text((status.free_bytes / 1048576i64).to_string() + " MB free on this player").colored(ui.MUTED));
    }
    if let Some(syncing) = status.syncing {
      rows = rows.append(ui.text(if (syncing) { "Player downloads in progress" } else { "No player downloads in progress" }).colored(ui.MUTED));
    }
  }
  if (m.device_note.len() > 0) {
    rows = rows.append(ui.text(m.device_note).colored(ui.MUTED));
  }
  if (!can_control(m)) {
    return rows;
  }
  if let Some(state) = m.now_playing.playback {
    let label = if (state.state == "paused") { "Resume" } else { "Pause" };
    let action = if (state.state == "paused") { api.Resume } else { api.Pause };
    rows = rows.concat(device_transport(m, state, ui.button(label, Control(action))));
    rows = rows.append(ui.text_button("Stop", Control(api.Stop)));
    if (state.position >= 0 && state.chapter_key.len() > 0 && state.track_key.len() > 0 && card_index(m, state.card) >= 0) {
      rows = rows.append(ui.outlined_button("Continue on this phone", MoveToPhone));
    }
    if (state.sleep > 0) {
      rows = rows.append(ui.text("Player timer · " + playback_time(state.sleep as i64 * 1000i64) + " left").colored(ui.MUTED));
    }
  }
  let volume = ui.slider(m.volume as f64 / 100.0, (at: f64): Msg => DeviceVolume((at * 100.0).round() as i32)).described("Player volume");
  return rows.concat([
    ui.row([ui.text[Msg]("Volume " + m.volume.to_string() + "%").wide(), ui.text_button("Apply", Control(api.Volume(m.volume)))]).aligned(ui.CENTER),
    volume,
    ui.text[Msg]("Player sleep timer").weighted(600),
    ui.row([ui.text_button("15 min", Control(api.DeviceSleep(900))), ui.text_button("30 min", Control(api.DeviceSleep(1800))), ui.text_button("60 min", Control(api.DeviceSleep(3600))), ui.text_button("Off", Control(api.DeviceSleep(0)))]).wide(),
    ui.text_button("Refresh player status", OpenNowPlaying),
  ]);
}

function now_playing_screen(m: Model, screen: ui.Screen): ui.El[Msg] {
  let heading = if (m.on_phone) { "Now playing" } else { selected(m).map((player: api.Player): string => player.name).unwrap_or("Now playing") };
  let controls = if (m.on_phone) { phone_now_playing(m, screen) } else { device_controls(m) };
  let rows = [ui.text_button("Back", CloseNowPlaying), ui.text[Msg](heading).weighted(700).sized(26.0)];
  if (m.transfer_note.len() > 0) {
    rows = rows.append(ui.text(m.transfer_note).colored(ui.MUTED));
  }
  return ui.column(rows.concat(controls)).spaced(12.0).padding(16.0).wide().tall().scroll("now-playing");
}

function art(shelf: Shelf, address: string, size: f64): ui.El[Msg] {
  if let Some(Some(image)) = shelf.covers.get(address) {
    return ui.picture(address, image.image).width(size).height(size).rounded(8.0);
  }
  return ui.box[Msg]().width(size).height(size).rounded(8.0).background(ui.TRACK);
}

function play_button(title: string, command: api.Command): ui.El[Msg] {
  return ui.text_button("Play", Control(command)).described("Play " + title);
}

function poster_columns(m: Model, screen: ui.Screen): i32 {
  if (m.playback_tools.saved.compact && screen.font < 1.4) {
    return (((screen.width() - 32.0) / 104.0) as i32).max(3).min(7);
  }
  return (((screen.width() - 32.0) / (170.0 * screen.font.max(1.0))) as i32).max(2).min(6);
}

function grid_rows(shelf: Shelf, cols: i32): i32 {
  if (shelf.sections.len() == 0) {
    return (shelf.hits.len() + cols - 1) / cols;
  }
  let count = 0;
  for items in shelf.sections {
    count += (items + cols - 1) / cols;
  }
  return count;
}

function row_hits(shelf: Shelf, row: i32, cols: i32): (i32, i32, string) {
  if (shelf.sections.len() == 0) {
    return (row * cols, ((row + 1) * cols).min(shelf.hits.len()), "");
  }
  let names = ["Cards and podcasts", "Tracks and episodes", "Radio stations"];
  let start = 0;
  let current = row;
  for i in 0..shelf.sections.len() {
    let count = shelf.sections[i];
    let rows = (count + cols - 1) / cols;
    if (current < rows) {
      let first = start + current * cols;
      return (first, (first + cols).min(start + count), if (current == 0) { names[i] } else { "" });
    }
    current -= rows;
    start += count;
  }
  return (start, start, "");
}

function target_name(m: Model): string {
  if (m.on_phone) {
    return "This phone";
  }
  return selected(m).map((p: api.Player): string => p.name).unwrap_or("This phone");
}

function target_button(m: Model): ui.El[Msg] {
  let name = target_name(m);
  return ui.text_button(name, PlaybackTarget).described("Playback device · " + name);
}

function poster(m: Model, hit: search.Hit, size: f64, caption_height: f64): ui.El[Msg] {
  let card = m.cards[hit.card];
  let title = card.title;
  let subtitle = card.creator;
  let chapter = "";
  let metadata = card.search;
  let command = Some(api.Play(card.id));
  if (hit.track >= 0) {
    let track = card.tracks[hit.track];
    title = if (m.shelf.search_scope == search.CHAPTERS) { track.chapter } else { track.title };
    subtitle = card.title;
    if (track.chapter != title) {
      chapter = track.chapter;
    }
    metadata = track.search + " " + card.search;
    command = track_command(card.id, track);
  }
  let thumb = thumbnail(m, card);
  let (address, icon) = featured_art(m.shelf, thumb, hit_art(m, hit));
  let caption: ui.El[Msg][] = [ui.text(title).sized(16.0).weighted(600).clamped(2)];
  if (subtitle.len() > 0) {
    let text = ui.text[Msg](subtitle).colored(ui.MUTED).clamped(1);
    if (hit.track >= 0 && thumb.len() > 0 && address != thumb) {
      let mini = art(m.shelf, thumb, 21.0).described("Cover for " + card.title);
      caption = caption.append(ui.row([mini, text.wide()]).aligned(ui.CENTER).spaced(4.0));
    } else {
      caption = caption.append(text);
    }
  }
  if (chapter.len() > 0) {
    caption = caption.append(ui.text(chapter).colored(ui.MUTED).clamped(1));
  }
  let excerpt = search.highlight(m.shelf.query, title + " " + subtitle + " " + chapter, metadata);
  if (excerpt.len() > 0) {
    caption = caption.append(ui.text("“" + excerpt + "”").colored(ui.PRIMARY).weighted(650).clamped(1));
  }
  let status = offline.label(m.downloads, card.id);
  let cover = art(m.shelf, address, size);
  let layers = [cover];
  if (icon.len() > 0) {
    let badge_size = (size * 0.29).min(44.0);
    let badge = art(m.shelf, icon, badge_size);
    if (address.len() > 0) {
      layers = layers.append(ui.column([ui.row([ui.space(), badge]).padding(4.0).wide()]).wide().tall());
    } else {
      layers = layers.append(ui.column([badge]).centered().wide().tall());
    }
  }
  if (status.len() > 0) {
    let badge = ui.text[Msg](status).sized(12.0).weighted(650).colored(ui.INK).padding_xy(6.0, 3.0).rounded(6.0).background(ui.SURFACE).clamped(1);
    layers = layers.append(ui.column([ui.space(), ui.row([badge]).padding(4.0)]).wide().tall());
  }
  if (layers.len() > 1) {
    cover = ui.stack(layers).width(size).height(size);
  }
  let items = [
    ui.column([cover, ui.column(caption).height(caption_height).spaced(2.0).padding_xy(6.0, 6.0).wide()]).wide().on_tap(OpenCard(card.id)).described("Tracks for " + title),
  ];
  let actions: ui.El[Msg][] = [];
  if (can_play_card(m, card.id)) {
    if let Some(play) = command {
      actions = actions.append(play_button(title, play).padding_xy(8.0, 0.0));
    }
  }
  if (status.len() == 0 && m.token.len() > 0 && m.downloads.catalog.dir.len() > 0 && size >= 144.0) {
    actions = actions.append(ui.text_button("Download", Download(card.id)).described("Download " + card.title));
  }
  if (actions.len() > 0) {
    items = items.append(ui.row(actions).aligned(ui.CENTER).spaced(2.0).wide());
  }
  return ui.column(items).width(size).background(ui.SURFACE).rounded(10.0);
}

function poster_grid(m: Model, screen: ui.Screen, before: ui.El[Msg], pinned: ui.El[Msg], after: ui.El[Msg]): ui.El[Msg] {
  let cols = poster_columns(m, screen);
  let gap = 12.0;
  let size = ((screen.width() - 32.0 - (cols - 1) as f64 * gap) / (cols as f64)).floor().max(1.0);
  let lines = if (m.shelf.query.trim().len() > 0) { 96.0 } else { 59.0 };
  let caption = 12.0 + lines * screen.font.max(1.0);
  let actions = if (can_control(m) || m.downloads.catalog.dir.len() > 0) { 48.0 * screen.font.max(1.0) } else { 0.0 };
  let searching = m.shelf.sections.len() > 0;
  let heading = if (searching) { 30.0 * screen.font.max(1.0) } else { 0.0 };
  return ui.list(grid_name(m.shelf), grid_rows(m.shelf, cols), size + caption + actions + gap + heading, (i: i32): ui.El[Msg] => {
    let (first, last, label) = row_hits(m.shelf, i, cols);
    let tiles: ui.El[Msg][] = [];
    for j in first..last {
      tiles = tiles.append(poster(m, m.shelf.hits[j], size, caption));
    }
    let row = ui.row(tiles).spaced(gap).wide();
    if (label.len() > 0) {
      return ui.column([ui.text[Msg](label).sized(17.0).weighted(700).height(heading).clamped(1), row]).wide();
    }
    return row;
  }).sticky_header(before, pinned, after, m.shelf.pinned);
}

function track_command(id: string, track: api.Track): Option[api.Command] {
  if (track.chapter_key.len() > 0) {
    return Some(api.PlayTrack(id, track.chapter_key, track.track_key));
  }
  return None;
}

function track_row(shelf: Shelf, card: api.Card, track: api.Track, ready: boolean): ui.El[Msg] {
  let items: ui.El[Msg][] = [art(shelf, artwork(shelf, track.art, card.cover), 44.0), ui.text(track.title).clamped(2).wide()];
  if (ready) {
    if let Some(command) = track_command(card.id, track) {
      items = items.append(play_button(track.title, command));
    }
  }
  return ui.row(items).padding_xy(8.0, 2.0).aligned(ui.CENTER).spaced(10.0);
}

function card_details(m: Model, card: api.Card, screen: ui.Screen): ui.El[Msg] {
  let items: ui.El[Msg][] = [ui.text_button("Back to library", CloseCard)];
  let (_, section) = api.download_selection(card.id);
  if (section.len() == 0 && card.tracks.any((track: api.Track): boolean => track.chapter_key.len() > 0)) {
    items = items.append(ui.text_button("Chapter downloads", OpenChapterDownloads(card.id)));
  }
  let liked = listening.favourite(m.playback_tools.saved, card.id);
  items = items.append(ui.row([
    ui.text_button(if (liked) { "Remove favourite" } else { "Add to favourites" }, ToggleFavourite(card.id)),
    ui.text_button("Pin to home screen", PinCard(card.id)),
  ]).spaced(8.0));
  if (card.myo && m.token.len() > 0) {
    items = items.append(ui.text_button("Edit playlist", EditPlaylist(card.id)));
  }
  let header = [ui.text[Msg](card.title).sized(22.0).weighted(700).clamped(3).wide()];
  if (can_play_card(m, card.id)) {
    let controls = [play_button(card.title, api.Play(card.id)), target_button(m)];
    header = header.append(if (screen.font >= 1.4) { ui.column(controls).wide() } else { ui.row(controls).aligned(ui.CENTER).wide() });
  }
  header = header.append(ui.text_button("Play next", QueueCard(card.id)));
  if (offline.saved(m.downloads, card.id).is_some()) {
    header = header.append(ui.text_button("Saved offline", SelectTab(2)));
  } else if (offline.contains(m.downloads, card.id)) {
    header = header.append(ui.text[Msg]("Download queued").colored(ui.MUTED));
  } else if (m.downloads.catalog.dir.len() > 0) {
    header = header.append(ui.text_button("Download to phone", Download(card.id)));
  }
  let size = (screen.width() * 0.4).min(screen.height() * 0.23).min(180.0);
  items = items.append(ui.row([art(m.shelf, card.cover, size), ui.column(header).spaced(4.0).wide()]).aligned(ui.CENTER).spaced(12.0));
  let count = card.tracks.len();
  if (count == 0) {
    let note = if (card.indexed) { "Yoto returned no tracks for this title." } else { "Track information is unavailable or still loading." };
    return ui.column(items.append(ui.text(note).colored(ui.MUTED))).spaced(12.0).wide().tall();
  }
  let tracks = card.tracks;
  let ready = can_play_card(m, card.id);
  let id = card.id;
  let shelf = m.shelf;
  let list = ui.list("tracks:" + id, tracks.len(), 56.0, (i: i32): ui.El[Msg] => track_row(shelf, card, tracks[i], ready));
  return ui.column(items.append(list)).spaced(12.0).wide().tall();
}

function download_row(m: Model, entry: offline.Entry): ui.El[Msg] {
  let label: ui.El[Msg][] = [ui.text[Msg](entry.title).sized(17.0).weighted(600).clamped(2)];
  if (entry.creator.len() > 0) {
    label = label.append(ui.text(entry.creator).colored(ui.MUTED).clamped(1));
  }
  if let Some(size) = m.playback_tools.trip.find((item: listening.Trip): boolean => item.id == entry.id && item.bytes > 0i64) {
    label = label.append(ui.text(size_text(size.bytes)).colored(ui.MUTED));
  }
  let title = ui.column(label).wide().on_tap(OpenDownload(entry.id)).described("Tracks for " + entry.title);
  let play = ui.text_button("Play", ResumeCard(entry.id)).described("Play " + entry.title);
  return ui.column([ui.card([ui.row([title, play]).aligned(ui.CENTER).spaced(8.0)]).wide()]).padding_xy(0.0, 4.0).wide();
}

function batch_downloads(m: Model): ui.El[Msg] {
  let cards = m.cards.filter((card: api.Card): boolean => !offline.contains(m.downloads, card.id));
  let picked = cards.filter((card: api.Card): boolean => m.trip_cards.get(card.id).unwrap_or(false));
  let seconds = 0i64;
  let bytes = 0i64;
  let unknown = 0;
  for card in picked {
    seconds += card.seconds;
    bytes += card.bytes;
    if (card.seconds <= 0i64 || card.bytes <= 0i64) {
      unknown += 1;
    }
  }
  let estimate = picked.len().to_string() + " selected · " + (seconds / 3600i64).to_string() + " h "
    + (seconds % 3600i64 / 60i64).to_string() + " min · " + (bytes / 1048576i64).to_string() + " MB";
  let actions = [ui.text_button("Back to downloads", ChooseDownloads)];
  if (picked.len() > 0) {
    actions = actions.append(ui.button("Download selected", DownloadSelected));
  }
  let intro: ui.El[Msg][] = [ui.row(actions).spaced(8.0), ui.text[Msg]("Choose cards").sized(24.0).weighted(650), ui.text(estimate).colored(ui.MUTED)];
  if (unknown > 0) {
    intro = intro.append(ui.text(unknown.to_string() + " titles have incomplete size or duration data.").colored(ui.MUTED));
  }
  let rows = ui.list("download-selection", cards.len(), 52.0, (at: i32): ui.El[Msg] => {
    let card = cards[at];
    let selected = m.trip_cards.get(card.id).unwrap_or(false);
    return ui.row([ui.checkbox(selected, card.title, PickDownload(card.id)), ui.text[Msg](card.title).clamped(2).wide().on_tap(PickDownload(card.id))]).aligned(ui.CENTER);
  });
  return ui.column(intro.append(rows)).spaced(8.0).wide().tall();
}

function download_controls(m: Model): ui.El[Msg][] {
  let state = m.downloads;
  let limited = m.playback_tools.saved.wifi_only;
  let rows: ui.El[Msg][] = [ui.row([
    ui.checkbox(limited, "Wi-Fi only", ToggleWifiOnly),
    ui.text[Msg]("Wi-Fi only").on_tap(ToggleWifiOnly),
  ]).aligned(ui.CENTER)];
  if (limited && !m.wifi && state.queue.len() > 0) {
    rows = rows.append(ui.text("Waiting for Wi-Fi.").colored(ui.MUTED));
  }
  if let Some(item) = offline.current(state) {
    rows = rows.append(ui.row([ui.text[Msg](item.title).clamped(2).wide(), ui.text_button("Pause", HoldDownload(item.id)).described("Pause download for " + item.title)]).aligned(ui.CENTER));
  }
  for item in state.held {
    rows = rows.append(ui.row([
      ui.text[Msg](item.title + " · Paused").clamped(2).wide(),
      ui.text_button("Resume", ContinueDownload(item.id)).described("Resume download for " + item.title),
      ui.text_button("Remove", RemoveDownload(item.id)).described("Remove " + item.title + " from downloads"),
    ]).aligned(ui.CENTER));
  }
  return rows;
}

function pending_downloads(m: Model): ui.El[Msg] {
  let queue = m.downloads.queue;
  return ui.list("download-queue", queue.len(), 60.0, (i: i32): ui.El[Msg] => {
    let item = queue[i];
    let actions = [
      ui.text[Msg](item.title).clamped(2).wide(),
      ui.text_button("Pause", HoldDownload(item.id)).described("Pause download for " + item.title),
    ];
    if (i > 0) {
      actions = actions.append(ui.text_button("Move first", FirstDownload(item.id)).described("Move " + item.title + " to the front of the downloads"));
    }
    return ui.row(actions).aligned(ui.CENTER).wide();
  });
}

function download_list(m: Model): ui.El[Msg] {
  if (m.trip_select && m.token.len() > 0) {
    return batch_downloads(m);
  }
  let fields: ui.El[Msg][] = [];
  if (m.offline_open.len() == 0) {
    fields = fields.append(ui.text_button("Storage budget", OpenTravel(StorageBudget)));
  }
  let note = offline.message(m.downloads);
  if (note.len() > 0) {
    fields = fields.append(ui.text(note).colored(ui.MUTED));
  }
  if let Some(entry) = offline.saved(m.downloads, m.offline_open) {
    let tools = ui.row([ui.text_button("Back to downloads", OpenDownload("")), ui.text_button("Remove download", RemoveDownload(entry.id))]).spaced(6.0);
    let title = ui.text[Msg](entry.title).sized(22.0).weighted(650).clamped(3);
    let tracks = ui.list("saved:" + entry.id, entry.tracks.len(), 56.0, (at: i32): ui.El[Msg] => {
      let track = entry.tracks[at];
      let address = keyed_art(m, entry.id, track.chapter, track.key, track.art);
      let play = ui.text_button("Play", PlayDownload(entry.id, at)).described("Play " + track.title);
      return ui.row([art(m.shelf, address, 44.0), ui.text[Msg](track.title).clamped(2).wide(), play]).aligned(ui.CENTER).spaced(10.0);
    });
    return ui.column([tools, title, ui.text_button("Play next", QueueCard(entry.id))].concat(fields).append(tracks)).spaced(8.0).wide().tall();
  }
  fields = fields.concat(download_controls(m));
  if (m.downloads.queue.len() > 0) {
    fields = fields.append(pending_downloads(m).height((m.downloads.queue.len() as f64 * 60.0).min(144.0)));
  }
  if (offline.busy(m.downloads)) {
    let controls: ui.El[Msg][] = [ui.text_button("Cancel downloads", CancelDownload)];
    if (m.downloads.paused && m.token.len() > 0) {
      controls = controls.append(ui.text_button("Resume downloads", ResumeDownload));
    }
    fields = fields.append(ui.row(controls).spaced(4.0));
  } else if (m.token.len() > 0 && !m.busy && m.cards.any((card: api.Card): boolean => offline.saved(m.downloads, card.id).is_none())) {
    fields = fields.append(ui.text_button("Download all cards", Download("")));
  }
  if (m.token.len() > 0 && m.cards.any((card: api.Card): boolean => !offline.contains(m.downloads, card.id))) {
    fields = fields.append(ui.outlined_button("Choose cards to download", ChooseDownloads));
  }
  let failed = m.downloads.catalog.entries.filter((entry: offline.Entry): boolean => entry.failed_at >= 0 && entry.failed_at < entry.tracks.len());
  for entry in failed {
    let actions = [ui.text_button("Remove", RemoveDownload(entry.id))];
    if (m.token.len() > 0) {
      actions = actions.append(ui.text_button("Retry track", RetryTrack(entry.id)));
    }
    if (offline.label(m.downloads, entry.id) == "Paused") {
      continue;
    }
    fields = fields.append(ui.card([ui.text[Msg](entry.title).weighted(600), ui.text(entry.tracks[entry.failed_at].title).colored(ui.MUTED), ui.row(actions)]).wide());
  }
  let entries = m.downloads.catalog.entries.filter((entry: offline.Entry): boolean => entry.ready);
  if (entries.len() == 0 && !offline.busy(m.downloads)) {
    fields = fields.append(ui.text("Download cards while online. They will appear here when ready.").colored(ui.MUTED));
  }
  if (entries.len() > 0) {
    fields = fields.append(ui.text_button("Check saved files and storage", CheckTrip));
    fields = fields.append(ui.list("downloads", entries.len(), 110.0, (at: i32): ui.El[Msg] => download_row(m, entries[at])));
  }
  return ui.column(fields).spaced(8.0).wide().tall();
}

function playback_queue(m: Model): ui.El[Msg] {
  let tools = m.playback_tools;
  let rows: ui.El[Msg][] = [];
  rows = rows.append(ui.row([ui.text_button("Car Mode", OpenTravel(CarMode)), ui.text_button("Find by time", OpenTravel(ListenTime))]).spaced(8.0));
  rows = rows.append(ui.row([ui.text_button("Bedtime routine", OpenTravel(Bedtime)), ui.text_button("NFC shortcuts", OpenTravel(NfcTags))]).spaced(8.0));
  if let phone.Playing | phone.Paused = m.phone.phase {
    rows = rows.append(ui.text_button("Bookmark this spot", BookmarkHere));
    if (tools.naming_bookmark) {
      rows = rows.append(ui.row([
        ui.field[Msg]("bookmark-name", tools.bookmark_name, "Bookmark name").on_edit((name: string): Msg => BookmarkName(name)),
        ui.button("Save bookmark", SaveBookmark),
      ]).aligned(ui.CENTER).spaced(6.0));
    }
  }
  rows = rows.append(ui.row([ui.text_button("New trip playlist", OpenLineup("")), ui.text_button("Listening history", ShowHistory)]).spaced(6.0));
  for line in tools.saved.lineups {
    let buttons = [ui.text_button("Edit", OpenLineup(line.name)), ui.text_button("Play", StartLineup(line.name)), ui.text_button("Trip dashboard", OpenTripDashboard(line.name))];
    if (m.token.len() > 0) {
      buttons = buttons.append(ui.text_button("Download missing", PrimeLineup(line.name)));
    }
    rows = rows.append(ui.card([
      ui.text[Msg](line.name).sized(18.0).weighted(650),
      ui.text[Msg](lineup_summary(m, line.cards)).colored(ui.MUTED),
      ui.row(buttons).spaced(4.0).scroll("trip-actions:" + line.name).wide(),
    ]).wide());
  }
  let minutes = ((tools.sleep_at - monotonic_ns()).max(0i64) + 59999999999i64) / 60000000000i64;
  let timer = if (minutes > 0i64) { "Phone sleep timer · " + minutes.to_string() + " min left" } else { "Phone sleep timer" };
  rows = rows.append(ui.card([
    ui.text[Msg](timer).sized(18.0).weighted(650),
    ui.row([ui.text_button("15 min", SetSleep(15)), ui.text_button("30 min", SetSleep(30)), ui.text_button("60 min", SetSleep(60)), ui.text_button("Off", SetSleep(0))]),
    ui.checkbox(tools.saved.fade, "Fade out at the end", ToggleSleepFade),
    ui.text_button(if (m.phone.stop_at_chapter) { "Cancel end of chapter timer" } else { "Stop at end of chapter" }, ChapterSleep),
  ]).wide());
  if (tools.saved.marks.len() > 0) {
    rows = rows.append(ui.row([ui.text[Msg]("Continue listening").sized(18.0).weighted(650).wide(), ui.text_button("Pin resume", PinResume)]).aligned(ui.CENTER));
    for mark in tools.saved.marks.take(4) {
      rows = rows.append(ui.text_button(mark.item.title, ResumeCard(mark.item.id)).described("Resume " + mark.item.title));
    }
  }
  if (tools.saved.pins.len() > 0) {
    rows = rows.append(ui.text[Msg]("Bookmarks").sized(18.0).weighted(650));
    for mark in tools.saved.pins {
      let resume = ui.text_button(mark.name + " · " + mark.item.title, ResumeBookmark(mark)).wide().described("Play bookmark " + mark.name + " for " + mark.item.title);
      let remove = ui.text_button("Remove", RemoveBookmark(mark.item.id, mark.name)).described("Remove bookmark " + mark.name);
      rows = rows.append(ui.row([resume, remove]).aligned(ui.CENTER));
    }
  }
  rows = rows.append(ui.text[Msg]("Up next").sized(18.0).weighted(650));
  if (tools.saved.queue.len() == 0) {
    rows = rows.append(ui.text[Msg]("Use Play next on a card to add it here.").colored(ui.MUTED));
  } else {
    rows = rows.append(ui.button("Play queue", StartQueue));
    for i in 0..tools.saved.queue.len() {
      let item = tools.saved.queue[i];
      let remove = ui.text_button("Remove", DropQueued(i)).described("Remove " + item.title + " from queue");
      rows = rows.append(ui.row([ui.text[Msg](item.title).clamped(2).wide(), remove]).aligned(ui.CENTER));
    }
  }
  rows = rows.append(ui.text[Msg]("Ready for the trip").sized(18.0).weighted(650));
  if (tools.trip_running) {
    rows = rows.append(ui.text[Msg]("Checking saved tracks…").colored(ui.MUTED));
  } else {
    let check = if (tools.saved.queue.len() > 0) { "Check queued cards" } else { "Check downloaded cards" };
    rows = rows.append(ui.outlined_button(check, CheckTrip));
  }
  for item in tools.trip {
    let status = "No complete download";
    if (item.expected > 0) {
      status = if (item.present == item.expected) { "Ready offline" } else { item.present.to_string() + "/" + item.expected.to_string() + " audio files found" };
    }
    rows = rows.append(ui.row([ui.text[Msg](item.title).wide().clamped(2), ui.text[Msg](status).colored(ui.MUTED).clamped(2)]).aligned(ui.CENTER).spaced(8.0));
  }
  if (tools.note.len() > 0) {
    rows = rows.append(ui.text[Msg](tools.note).colored(ui.MUTED));
  }
  return ui.column(rows).spaced(10.0).wide().tall().scroll("playback-queue");
}

function library_status(m: Model, has_matches: boolean): string {
  if (!m.library_loaded) {
    return "";
  }
  let ready = m.cards.filter((c: api.Card): boolean => c.indexed).len();
  let total = m.cards.len();
  if (m.shelf.paused.len() > 0) {
    if (has_matches) {
      return "";
    }
    return "Track search is incomplete. " + m.shelf.paused;
  }
  if (m.shelf.next < total || m.background_busy && ready < total) {
    return "Track search: " + ready.to_string() + " of " + total.to_string() + " titles indexed";
  }
  if (ready < total && !has_matches) {
    return "Track information is unavailable for " + (total - ready).to_string() + " titles.";
  }
  return "";
}

function menu_icon(color: i32): (draw.Frame, i32, i32, i32, i32) => void {
  return (f: draw.Frame, x: i32, y: i32, w: i32, h: i32): void => {
    let gap = h / 7;
    for i in -1..2 {
      f.disc(x + w / 2, y + h / 2 + i * gap, (w / 23).max(1), color);
    }
  };
}

function section_header(m: Model, name: string): ui.El[Msg] {
  let title = ui.text[Msg](name).sized(27.0).weighted(700).wide();
  let top = [title];
  if (!m.busy && m.token.len() > 0) {
    top = top.append(ui.tinted("account-menu", ui.INK, menu_icon).width(48.0).height(48.0).background(ui.SURFACE).rounded(14.0).on_tap(ToggleMenu).described("More options"));
  }
  let items = [ui.row(top).aligned(ui.CENTER).wide()];
  if (m.menu_open && !m.busy) {
    let menu = ui.menu(["Refresh", "Sign out", "Library tools", "Listening profiles", "Kids mode"], (at: i32): Msg => [Refresh, SignOut, OpenTools(panel_tools.Hub), ShowProfiles, EnterKids][at]).width(196.0);
    items = items.append(ui.row([ui.space(), menu]).wide());
  }
  for note in [m.note, m.session_note] {
    if (note.len() > 0) {
      items = items.append(ui.text(note).colored(ui.MUTED));
    }
  }
  return ui.column(items).spaced(8.0).wide();
}

function collection_chip(label: string, selected: boolean, message: Msg): ui.El[Msg] {
  let color = if (selected) { ui.ON_PRIMARY } else { ui.INK };
  let text = ui.text[Msg](label).sized(13.0).weighted(600).colored(color).clamped(1);
  let chip = ui.row([text]).centered().height(40.0).padding_xy(12.0, 0.0).rounded(20.0).on_tap(message).described(label);
  if (selected) {
    return chip.background(ui.PRIMARY);
  }
  return chip.border(ui.OUTLINE, 1.0);
}

function collection_filters(shelf: Shelf): ui.El[Msg] {
  let choices = [("All", 0), ("My Cards", 1), ("Playlists", 2), ("Club Collection", search.CLUB), ("Sleep Sounds", search.SLEEP), ("Podcasts", 3), ("Radio", 4)];
  let chips = choices.map((choice: (string, i32)): ui.El[Msg] => collection_chip(choice.0, shelf.filter == choice.1, Filter(choice.1)));
  return ui.row(chips).spaced(8.0).wide().scroll("library-collections");
}

function group_filters(shelf: Shelf, online: boolean): ui.El[Msg] {
  let title = "Groups";
  if let Some(group) = selected_group(shelf) {
    title += " · " + group.name;
  }
  let action = if (shelf.groups_open) { "Hide groups" } else { "Show groups" };
  let items = [ui.row([ui.text[Msg](title).sized(15.0).weighted(600).clamped(1).wide(), ui.text_button(action, ToggleGroups)]).aligned(ui.CENTER)];
  if (shelf.groups_open) {
    if (online) {
      let actions = [ui.text_button("New group", EditGroup(""))];
      if let Some(group) = selected_group(shelf) {
        actions = actions.append(ui.text_button("Edit group", EditGroup(group.id)));
      }
      items = items.append(ui.row(actions).spaced(6.0));
    }
    if (shelf.groups_note.len() > 0) {
      items = items.append(ui.text(shelf.groups_note).colored(ui.MUTED));
    }
    if (shelf.groups.len() > 0) {
      let chips = [collection_chip("All groups", shelf.group.len() == 0, FilterGroup(""))];
      for group in shelf.groups {
        chips = chips.append(collection_chip(group.name, shelf.group == group.id, FilterGroup(group.id)));
      }
      items = items.append(ui.row(chips).spaced(8.0).wide().scroll("library-groups"));
    } else if (shelf.groups_note.len() == 0) {
      items = items.append(ui.text("No family groups.").colored(ui.MUTED));
    }
  }
  return ui.column(items).spaced(6.0).wide();
}

function library_destination(m: Model): ui.El[Msg] {
  let target = "Choose playback device";
  if (m.on_phone) {
    target = "Play on this phone";
  }
  if let Some(player) = selected(m) {
    target = if (player.online) { "Play on " + player.name } else { player.name + " is offline." };
  }
  return ui.text_button(target, PlaybackTarget).described("Playback device · " + target);
}

function library_controls(m: Model): ui.El[Msg] {
  let shelf = m.shelf;
  let downloaded = ui.row([
    ui.checkbox(shelf.downloaded_only, "Downloaded only", DownloadedOnly),
    ui.text[Msg]("Downloaded only").on_tap(DownloadedOnly),
  ]).aligned(ui.CENTER);
  let searching = shelf.query.trim().len() > 0;
  let fields: ui.El[Msg][] = [];
  if (searching) {
    fields = fields.append(ui.tabs(["Matches", "Titles", "Chapters", "Tracks"], shelf.search_scope, (at: i32): Msg => SearchScope(at)));
  }
  fields = fields.append(downloaded);
  let has_matches = searching && shelf.hits.len() > 0;
  let status = if (searching) { library_status(m, has_matches) } else { "" };
  if (shelf.note.len() > 0 && !has_matches) {
    fields = fields.append(ui.text(shelf.note).colored(ui.MUTED));
  }
  if (status.len() > 0) {
    fields = fields.append(ui.text(status).colored(ui.MUTED));
  }
  if (shelf.hits.len() == 0 && m.library_loaded) {
    let hint = if (shelf.downloaded_only) { "No downloaded cards in this view." } else if (searching) { if (shelf.search_due > 0i64) { "Searching…" } else { "No matches in the current index." } } else { "No titles in this view." };
    fields = fields.append(ui.text(hint).colored(ui.MUTED));
  }
  return ui.column(fields).spaced(8.0).padding_xy(0.0, 8.0).wide();
}

function personal_filters(m: Model): ui.El[Msg] {
  let shelf = m.shelf;
  let action = if (shelf.personal_open) { "Hide collections" } else { "My collections" };
  let rows = [ui.row([ui.text_button(action, TogglePersonal), ui.space(), ui.text_button(if (m.playback_tools.saved.compact) { "Large covers" } else { "Compact covers" }, ToggleCompact)]).wide()];
  if (shelf.personal_open) {
    let controls = [ui.text_button("New collection", EditPersonal(""))];
    if (shelf.personal.len() > 0) {
      controls = controls.append(ui.text_button("Edit collection", EditPersonal(shelf.personal)));
    }
    rows = rows.append(ui.row(controls).spaced(6.0));
    let chips = [collection_chip("All titles", shelf.personal.len() == 0, UsePersonal(""))];
    for item in m.playback_tools.saved.collections {
      chips = chips.append(collection_chip(item.name, item.name == shelf.personal, UsePersonal(item.name)));
    }
    rows = rows.append(ui.row(chips).spaced(8.0).wide().scroll("personal-collections"));
  }
  return ui.column(rows).spaced(6.0).wide();
}

function card_list(m: Model, screen: ui.Screen): ui.El[Msg] {
  let before = ui.column([section_header(m, "Library"), group_filters(m.shelf, m.token.len() > 0), personal_filters(m), collection_filters(m.shelf)]).spaced(8.0).padding_xy(0.0, 8.0).wide();
  let field = ui.field[Msg]("library-search", m.shelf.query, "Search library").rounded(12.0).on_edit((text: string): Msg => Search(text));
  let label = if (m.shelf.by_title) { "A–Z" } else { "Last played" };
  let sort = ui.text_button(label, ToggleSort).described("Sort order · " + label);
  let search_row = ui.row([field, sort]).aligned(ui.CENTER).spaced(4.0).wide();
  let pinned = ui.column([search_row, library_destination(m)]).padding_xy(0.0, 4.0).background(ui.BACKGROUND).wide();
  return poster_grid(m, screen, before, pinned, library_controls(m));
}

function group_editor(m: Model, edit: GroupEdit): ui.El[Msg] {
  let title = if (edit.local) { if (edit.id.len() > 0) { "Edit collection" } else { "New collection" } } else { if (edit.id.len() > 0) { "Edit group" } else { "New group" } };
  let rows: ui.El[Msg][] = [ui.text_button("Back to library", CloseGroup), ui.text[Msg](title).weighted(700).sized(25.0)];
  if (edit.local) {
    rows = rows.append(ui.text("Choose cards to include. With no cards selected, the collection saves only your Library filters.").colored(ui.MUTED));
  }
  if (edit.note.len() > 0) {
    rows = rows.append(ui.text(edit.note).colored(ui.MUTED));
  }
  if (edit.busy) {
    return ui.column(rows).spaced(10.0).padding(16.0).wide().tall();
  }
  let actions: ui.El[Msg][] = [];
  if (edit.name.trim().len() > 0) {
    actions = actions.append(ui.button(if (edit.local) { "Save collection" } else { "Save group" }, SaveGroup));
  }
  if (edit.id.len() > 0) {
    actions = actions.append(ui.text_button(if (edit.confirm) { "Confirm removal" } else { if (edit.local) { "Remove collection" } else { "Remove group" } }, DeleteGroup));
  }
  rows = rows.concat([
    ui.field[Msg]("group-name", edit.name, "Group name").on_edit((name: string): Msg => GroupName(name)),
    ui.row(actions).spaced(6.0),
    ui.field[Msg]("group-search", edit.query, "Find cards to add").on_edit((query: string): Msg => GroupQuery(query)),
  ]);
  let query = edit.query.trim().to_lower();
  let cards = m.cards.filter((card: api.Card): boolean => card.search.contains(query));
  let list = ui.list("group-editor:" + query, cards.len(), 56.0, (i: i32): ui.El[Msg] => {
    let card = cards[i];
    let tap = GroupMember(card.id);
    return ui.row([ui.checkbox(edit.members.contains(card.id), card.title, tap), ui.text[Msg](card.title).wide().clamped(2).on_tap(tap)]).aligned(ui.CENTER);
  });
  return ui.column(rows.append(list)).spaced(8.0).padding(16.0).wide().tall();
}

function scan_view(m: Model): ui.El[Msg][] {
  let tool = m.tools_page;
  let rows: ui.El[Msg][] = [
    ui.text[Msg]("Hold a Yoto card against the back of your phone.").colored(ui.MUTED),
    ui.button(if (tool.scanning) { "Ready to scan" } else { "Start NFC scan" }, StartScan),
    ui.field[Msg]("scan-code", tool.address, "Yoto card link or code").on_edit((value: string): Msg => EditScan(value)),
    ui.text_button("Look up card", ReadScan(tool.address)),
  ];
  if let Some(card) = tool.scan_result {
    rows = rows.append(ui.text[Msg](card.title).weighted(650).sized(20.0));
    if (card_index(m, card.id) >= 0) {
      rows = rows.append(ui.text_button("Open card", OpenScanned(card.id)));
    }
    if (card.preview.len() > 0) {
      rows = rows.append(ui.text_button("Play preview", PlayPreview(card)));
    }
  }
  if (api.scan_code(tool.address).len() > 0) {
    rows = rows.append(ui.text_button("Add or open in Yoto", OpenLink(if (tool.address.starts_with("https://yoto.io/")) { tool.address } else { "https://yoto.io/" + api.scan_code(tool.address) })));
  }
  return rows;
}

function create_chapter(part: api.Chapter, n: i32, count: i32): ui.El[Msg] {
  let actions: ui.El[Msg][] = [ui.text_button("Remove", DropChapter(n))];
  if (n > 0) {
    actions = [ui.text_button("Move up", MoveChapter(n, n - 1))].concat(actions);
  }
  if (n < count - 1) {
    actions = [ui.text_button("Move down", MoveChapter(n, n + 1))].concat(actions);
  }
  if (part.audio.is_some()) {
    actions = [ui.text_button("Edit audio", EditAudio(n))].concat(actions);
  }
  return ui.card([
    ui.field[Msg]("chapter-title-" + n.to_string(), part.title, "Chapter title").on_edit((name: string): Msg => ChapterTitle(n, name)),
    ui.row(actions).spaced(6.0),
  ]).wide();
}

function audio_editor_view(e: AudioEditor): ui.El[Msg][] {
  let rows = [ui.text_button("Back to playlist", CloseAudioEditor), ui.text[Msg](e.title).sized(23.0).weighted(650)];
  if (e.note.len() > 0) {
    rows = rows.append(ui.text(e.note).colored(ui.MUTED));
  }
  if (e.working) {
    return rows.append(ui.text("Working on audio…").colored(ui.MUTED));
  }
  let Some(wave) = e.wave else {
    return rows;
  };
  let length = wave.duration.max(1);
  let edit = e.edit;
  let bars: ui.El[Msg][] = [];
  for i in 0..wave.peaks.len() {
    let at = i * length / wave.peaks.len();
    let kept = at >= edit.first && at < edit.last;
    let color = if (kept) { ui.PRIMARY } else { ui.TRACK };
    bars = bars.append(ui.box[Msg]().wide().height(4.0 + wave.peaks[i] * 62.0).background(color).rounded(2.0));
  }
  let scale = length as f64;
  rows = rows.concat([
    ui.row(bars).spaced(2.0).height(72.0).aligned(ui.CENTER).wide().described("Audio waveform"),
    ui.text[Msg]("Trim start · " + playback_time(edit.first as i64)),
    ui.slider(edit.first as f64 / scale, (part: f64): Msg => AudioTrim(true, (part * scale) as i32)).described("Trim start"),
    ui.text[Msg]("Trim end · " + playback_time(edit.last as i64)),
    ui.slider(edit.last as f64 / scale, (part: f64): Msg => AudioTrim(false, (part * scale) as i32)).described("Trim end"),
    ui.text[Msg]("Chapter marker · " + playback_time(e.marker as i64)),
    ui.slider(e.marker as f64 / scale, (part: f64): Msg => AudioMarker((part * scale) as i32)).described("Chapter marker position"),
    ui.text_button("Add chapter marker", AddAudioMarker),
  ]);
  for time in edit.markers {
    rows = rows.append(ui.row([
      ui.text[Msg](playback_time(time as i64)).wide(),
      ui.text_button("Remove marker", DropAudioMarker(time)),
    ]).aligned(ui.CENTER));
  }
  return rows.concat([
    ui.checkbox(edit.match_volume, "Match chapter volume", ToggleMatchAudio),
    ui.button("Use audio edits", RenderAudio),
  ]);
}

function create_view(m: Model): ui.El[Msg][] {
  if let Some(editor) = m.audio_editor {
    return audio_editor_view(editor);
  }
  let tool = m.tools_page;
  if (tool.busy || tool.importing) {
    return [];
  }
  if (tool.choosing_cover) {
    let cards = m.cards.filter((card: api.Card): boolean => card.cover.len() > 0);
    let rows: ui.El[Msg][] = [ui.text_button("Back to playlist", PickCover)];
    if (cards.len() == 0) {
      return rows.append(ui.text("No covers are available in your library yet.").colored(ui.MUTED));
    }
    return rows.append(ui.list("playlist-covers", cards.len(), 52.0, (i: i32): ui.El[Msg] => {
      let card = cards[i];
      return ui.text_button(card.title, DraftCover(card.cover)).wide();
    }).height((cards.len() * 52).min(572) as f64));
  }
  let draft = tool.draft;
  let audio = [ui.button(if (tool.recording) { "Stop recording" } else { "Record" }, SetRecorder)];
  if (!tool.recording) {
    audio = audio.append(ui.text_button("Import audio", ImportAudio));
  }
  let rows: ui.El[Msg][] = [
    ui.field[Msg]("playlist-name", draft.title, "Playlist title").on_edit((value: string): Msg => DraftTitle(value)),
    ui.field[Msg]("playlist-cover", draft.cover, "Cover image HTTPS address").on_edit((value: string): Msg => DraftCover(value)),
    ui.text_button("Choose a library cover", PickCover),
    ui.row(audio).spaced(8.0),
  ];
  if (!tool.recording && draft.title.trim().len() > 0 && draft.chapters.len() > 0 && m.token.len() > 0) {
    rows = rows.append(ui.button("Save playlist", SavePlaylist));
  }
  for i in 0..draft.chapters.len() {
    rows = rows.append(create_chapter(draft.chapters[i], i, draft.chapters.len()));
  }
  rows = rows.append(ui.text_button("Link a Make Your Own card in Yoto", OpenYoto));
  return rows;
}

function discover_view(m: Model): ui.El[Msg][] {
  let tool = m.tools_page;
  if (tool.show_shop) {
    let rows: ui.El[Msg][] = [ui.text_button("Back to collections", ShowShop)];
    if (tool.shop.len() == 0) {
      return rows;
    }
    let titles = tool.shop;
    return rows.append(ui.list("store-cards", titles.len(), 56.0, (i: i32): ui.El[Msg] => {
      let title = titles[i];
      return ui.text_button(title.title, OpenLink(title.address)).wide();
    }).height((titles.len() * 56).min(672) as f64));
  }
  let filters = [search.CLUB, 3, 4, search.SLEEP];
  let group = filters[tool.discover_filter];
  let result = search.find(m.cards, "", group).map((hit: search.Hit): api.Card => m.cards[hit.card]);
  let rows: ui.El[Msg][] = [
    ui.tabs(["Club", "Podcasts", "Radio", "Sleep"], tool.discover_filter, (at: i32): Msg => DiscoverFilter(at)),
    ui.text_button("Browse new cards in the Yoto shop", ShowShop),
    ui.text_button("Open the full catalogue in Yoto", OpenYoto),
  ];
  if (group == search.CLUB) {
    rows = rows.append(ui.text_button("Browse Yoto Club online", OpenLink("https://uk.yotoplay.com/yoto-club")));
  } else if (group == 4) {
    rows = rows.append(ui.text_button("Explore Yoto Radio", OpenLink("https://uk.yotoplay.com/radio")));
  }
  if (result.len() == 0) {
    return rows.append(ui.text("No titles in this collection in your library.").colored(ui.MUTED));
  }
  return rows.append(ui.list("discover:" + group.to_string(), result.len(), 72.0, (i: i32): ui.El[Msg] => {
    let card = result[i];
    let title = ui.text[Msg](card.title).wide().clamped(2).on_tap(OpenScanned(card.id)).described(card.title);
    let items = [art(m.shelf, card.cover, 40.0), title];
    if (card.preview.len() > 0) {
      items = items.append(ui.text_button("Preview", PlayPreview(card)));
    }
    return ui.row(items).aligned(ui.CENTER).spaced(8.0);
  }).height((result.len() * 72).min(648) as f64));
}

function tools_view(m: Model, page: panel_tools.Page): ui.El[Msg] {
  let title = match (page) {
    panel_tools.Hub => "Library tools",
    panel_tools.Scan => "Scan a card",
    panel_tools.Create => "Create a playlist",
    panel_tools.Discover => "Discover",
    panel_tools.Setup => "Player and family setup",
  };
  let rows: ui.El[Msg][] = [ui.text_button("Back", CloseTools), ui.text[Msg](title).sized(26.0).weighted(700)];
  for note in [m.tools_page.note, m.note] {
    if (note.len() > 0) {
      rows = rows.append(ui.text(note).colored(ui.MUTED));
    }
  }
  let body: ui.El[Msg][] = match (page) {
    panel_tools.Hub => [
      ui.outlined_button("Scan a card", OpenTools(panel_tools.Scan)),
      ui.outlined_button("Create a playlist", OpenTools(panel_tools.Create)),
      ui.outlined_button("Discover", OpenTools(panel_tools.Discover)),
      ui.outlined_button("Player and family setup", OpenTools(panel_tools.Setup)),
      ui.text_button("Authorize library editing", EnableEditing),
    ],
    panel_tools.Scan => scan_view(m),
    panel_tools.Create => create_view(m),
    panel_tools.Discover => discover_view(m),
    panel_tools.Setup => [
      ui.text[Msg]("Use Yoto to pair a new player, reconnect a player to Wi-Fi, or accept a family invitation. Return here and refresh after setup.").colored(ui.MUTED),
      ui.button("Open Yoto for setup", OpenYoto),
      ui.text_button("Player setup instructions", OpenLink("https://support.yotoplay.com/en_gb/how-to-set-up-your-yoto-player-or-mini-ryCTOYjmMl")),
      ui.text_button("Family account instructions", OpenLink("https://support.yotoplay.com/en_gb/how-to-add-users-to-your-family-account-HJo2dtsQGg")),
      ui.text_button("Refresh connected players", Refresh),
    ],
  };
  return ui.column(rows.concat(body)).spaced(10.0).padding(16.0).wide().tall().scroll("tools:" + title);
}

function size_text(bytes: i64): string {
  return if (bytes >= 1048576i64) { (bytes / 1048576i64).to_string() + " MB" } else { ((bytes + 1023i64) / 1024i64).to_string() + " KB" };
}

function lineup_summary(m: Model, cards: listening.Item[]): string {
  let seconds = 0i64;
  let unknown = 0;
  for item in cards {
    let index = card_index(m, item.id);
    if (index >= 0 && m.cards[index].seconds > 0i64) {
      seconds += m.cards[index].seconds;
    } else {
      unknown += 1;
    }
  }
  let count = cards.len().to_string() + (if (cards.len() == 1) { " card" } else { " cards" });
  if (seconds == 0i64) {
    return count + (if (unknown > 0) { " · Duration unavailable" } else { "" });
  }
  let minutes = ((seconds + 59i64) / 60i64).to_string() + " min";
  let time = if (seconds >= 3600i64) { (seconds / 3600i64).to_string() + " h " + (seconds / 60i64 % 60i64).to_string() + " min" } else { minutes };
  let suffix = if (unknown > 0) { " · " + unknown.to_string() + " with unknown duration" } else { "" };
  return count + " · " + time + suffix;
}

function trip_editor(m: Model, draft: TripDraft): ui.El[Msg] {
  if (draft.adding) {
    let query = draft.query.trim().to_lower();
    let cards = m.cards.filter((c: api.Card): boolean => c.search.contains(query));
    let list = ui.list("trip-card-picker:" + query, cards.len(), 52.0, (i: i32): ui.El[Msg] => {
      let card = cards[i];
      return ui.text_button(card.title, AddLineupCard(card.id)).described("Add " + card.title).wide();
    });
    return ui.column([
      ui.text_button("Done", CloseLineup),
      ui.field[Msg]("find-trip-cards", draft.query, "Find cards").on_edit((text: string): Msg => FindLineupCards(text)),
      ui.text[Msg](lineup_summary(m, draft.items)).colored(ui.MUTED),
      list,
    ]).spaced(8.0).padding(16.0).wide().tall();
  }
  let rows: ui.El[Msg][] = [
    ui.row([ui.text_button("Back to queue", CloseLineup), ui.button("Save trip", SaveLineup)]).spaced(6.0),
    ui.field[Msg]("trip-title", draft.title, "Trip name").on_edit((text: string): Msg => LineupTitle(text)),
    ui.text[Msg](lineup_summary(m, draft.items)).colored(ui.MUTED),
    ui.text_button("Add cards", PickLineupCards),
  ];
  if (m.playback_tools.note.len() > 0) {
    rows = rows.append(ui.text(m.playback_tools.note).colored(ui.MUTED));
  }
  if (draft.original.len() > 0) {
    rows = rows.append(ui.text_button("Pin trip to home screen", PinLineup(draft.original)));
  }
  if (draft.items.len() > 1) {
    rows = rows.append(ui.text[Msg]("Hold and drag a card to move it.").colored(ui.MUTED));
  }
  let list = ui.list("trip-order", draft.items.len(), 56.0, (i: i32): ui.El[Msg] => ui.row([
    ui.text[Msg](draft.items[i].title).clamped(2).wide(),
    ui.text_button("Remove", DropLineupCard(i)),
  ]).aligned(ui.CENTER).wide()).on_move((from: i32, to: i32): Msg => MoveLineupCard(from, to));
  return ui.column(rows.append(list)).spaced(8.0).padding(16.0).wide().tall();
}

function history_view(m: Model): ui.El[Msg] {
  let tools = m.playback_tools;
  let filter = tools.history_filter;
  let history = tools.saved.history.filter((item: listening.Heard): boolean => filter == 0 || item.done == (filter == 2));
  let rows = [
    ui.text_button("Back to queue", ShowHistory),
    ui.text[Msg]("Listening history").sized(24.0).weighted(650),
    ui.tabs(["Recent", "In progress", "Finished"], filter, (at: i32): Msg => FilterHistory(at)),
  ];
  if (history.len() == 0) {
    let note = if (filter == 0) { "Cards you play on this phone appear here." } else { "No cards in this view." };
    rows = rows.append(ui.text(note).colored(ui.MUTED));
  }
  let list = ui.list("history:" + filter.to_string(), history.len(), 62.0, (i: i32): ui.El[Msg] => {
    let item = history[i];
    let label = if (item.done) { "Finished" } else { "In progress" };
    return ui.row([
      ui.column([ui.text[Msg](item.card.title).clamped(1), ui.text(label).colored(ui.MUTED)]).wide(),
      ui.text_button(if (item.done) { "Play again" } else { "Resume" }, ResumeCard(item.card.id)),
    ]).aligned(ui.CENTER).wide();
  });
  return ui.column(rows.append(list)).spaced(8.0).padding(16.0).wide().tall();
}

function pin_key(digit: i32, height: f64): ui.El[Msg] {
  let label = ui.text[Msg](digit.to_string()).sized(20.0).weighted(600);
  return ui.row([label]).centered().background(ui.SURFACE).rounded(16.0).wide().height(height).on_tap(ParentCode(digit)).described(digit.to_string());
}

function parent_view(m: Model, screen: ui.Screen): ui.El[Msg] {
  let gate = m.parent;
  let saved = m.playback_tools.saved;
  let setup = saved.parent_key.len() == 0;
  let confirming = setup && gate.first.len() > 0;
  let title = if (confirming) { "Confirm parent PIN" } else { if (setup) { "Create parent PIN" } else { "Enter parent PIN" } };
  let rows: ui.El[Msg][] = [ui.text_button("Back", CloseParent), ui.text[Msg](title).sized(25.0).weighted(700)];
  if (gate.busy || saved.retry_pin_at > now_unix_ms()) {
    let status = if (gate.busy) { "Checking PIN…" } else { "Wait 30 seconds before you try again." };
    rows = rows.append(ui.text(status).colored(ui.MUTED));
  } else {
    if (setup) {
      let hint = if (confirming) { "Enter the same PIN again." } else { "Choose 4 to 8 digits." };
      rows = rows.append(ui.text(hint).colored(ui.MUTED));
    }
    if (gate.note.len() > 0) {
      rows = rows.append(ui.text(gate.note).colored(ui.MUTED));
    }
    let count = gate.code.len();
    let marks = "●".repeat(count) + "○".repeat((4 - count).max(0));
    let mask = ui.text[Msg](marks).sized(20.0).described(count.to_string() + " digits entered");
    rows = rows.append(ui.row([mask]).centered().wide());
    let height = 54.0 * (screen.font / 1.4).max(1.0);
    for n in 0..3 {
      rows = rows.append(ui.row([pin_key(n * 3 + 1, height), pin_key(n * 3 + 2, height), pin_key(n * 3 + 3, height)]).spaced(8.0).wide());
    }
    rows = rows.append(ui.row([
      ui.box[Msg]().wide().height(height),
      pin_key(0, height),
      ui.text_button("Delete", ParentCode(-1)).padding_xy(4.0, 0.0).wide().height(height).described("Delete last digit"),
    ]).spaced(8.0).wide());
    let submit = if (listening.valid_pin(gate.code)) {
      ui.button("Continue", ParentSubmit)
    } else {
      ui.row([ui.text[Msg]("Continue").weighted(500).colored(ui.MUTED)]).centered().background(ui.SURFACE).rounded(20.0)
    };
    rows = rows.append(submit.wide().height(height));
  }
  let width = (screen.width() - 36.0).min(360.0).max(1.0);
  return ui.column([ui.column(rows).spaced(10.0).width(width)]).aligned(ui.CENTER).padding(18.0).wide().tall().scroll("parent-pin");
}

function kids_view(m: Model, screen: ui.Screen): ui.El[Msg] {
  let favourites = m.playback_tools.saved.favourites;
  let rows: ui.El[Msg][] = [ui.row([ui.text[Msg]("Favourites").sized(25.0).weighted(700).wide(), ui.text_button("Grown-ups", EnterKids)]).aligned(ui.CENTER)];
  if (travel.surprise(m.playback_tools.saved, m.downloads.catalog, m.phone.card).is_some()) {
    rows = rows.append(ui.button("Surprise me", SurpriseKids).height(52.0));
  }
  if (m.on_phone && m.phone.queue.len() > 0) {
    let paused = match (m.phone.phase) { phone.Paused => true, _ => false };
    let tap = PhoneControl(if (paused) { api.Resume } else { api.Pause });
    rows = rows.append(ui.row([
      ui.text[Msg](m.phone.queue[m.phone.at].title).clamped(2).wide(),
      ui.button(if (paused) { "Play" } else { "Pause" }, tap),
    ]).aligned(ui.CENTER));
  }
  if (favourites.len() == 0) {
    rows = rows.append(ui.text("Ask a grown-up to add a favourite from Library.").colored(ui.MUTED));
  }
  let width = ((screen.width() - 42.0) / 2.0).max(1.0);
  let tiles = ui.list("kids-favourites", (favourites.len() + 1) / 2, width + 72.0, (row: i32): ui.El[Msg] => {
    let cards: ui.El[Msg][] = [];
    for i in row * 2..(row * 2 + 2).min(favourites.len()) {
      let item = favourites[i];
      let at = card_index(m, item.id);
      let address = if (at >= 0) { m.cards[at].cover } else { "" };
      let tile = ui.column([art(m.shelf, address, width), ui.text[Msg](item.title).sized(17.0).clamped(2)]).spaced(6.0).width(width);
      let ready = at >= 0 && (m.token.len() > 0 || offline.saved(m.downloads, item.id).is_some());
      cards = cards.append(if (ready) { tile.on_tap(ResumeCard(item.id)).described("Play " + item.title) } else { tile });
    }
    return ui.row(cards).spaced(10.0).wide();
  });
  return ui.column(rows.append(tiles)).spaced(8.0).padding(16.0).wide().tall();
}

function destination_view(m: Model): ui.El[Msg] {
  let rows = [
    ui.text_button("Back", CloseTarget),
    ui.text[Msg]("Playback device").sized(24.0).weighted(700),
    ui.outlined_button("This phone", SelectPhone).height(52.0).wide(),
  ];
  for device in m.players {
    let name = if (device.online) { device.name } else { device.name + " · Offline" };
    if (device.online) {
      rows = rows.append(ui.outlined_button(name, SelectPlayer(device.id)).height(52.0).wide());
    } else {
      rows = rows.append(ui.text(name).colored(ui.MUTED).clamped(2));
    }
  }
  return ui.column(rows).spaced(8.0).padding(16.0).wide().tall().scroll("playback-target");
}

function profile_view(m: Model): ui.El[Msg] {
  let tools = m.playback_tools;
  let rows = [
    ui.text_button("Back", ShowProfiles),
    ui.text[Msg]("Listening profiles").sized(24.0).weighted(700),
    ui.text[Msg]("Current profile · " + tools.saved.profile).colored(ui.MUTED),
  ];
  for profile in tools.saved.other_profiles {
    rows = rows.append(ui.outlined_button(profile.name, SwitchProfile(profile.name)).wide());
  }
  rows = rows.append(ui.field[Msg]("profile-name", tools.profile_name, "New profile name").on_edit((name: string): Msg => ProfileName(name)));
  rows = rows.append(ui.button("Create profile", SaveProfile));
  if (tools.note.len() > 0) {
    rows = rows.append(ui.text(tools.note).colored(ui.MUTED));
  }
  return ui.column(rows).spaced(10.0).padding(16.0).wide().tall().scroll("profiles");
}

function trip_dashboard(m: Model, line: listening.Lineup): ui.El[Msg] {
  let tools = m.playback_tools;
  let rows = [
    ui.text_button("Back to queue", OpenTripDashboard("")),
    ui.text[Msg](line.name).sized(24.0).weighted(700),
    ui.text[Msg](lineup_summary(m, line.cards)).colored(ui.MUTED),
  ];
  let ready = 0;
  let bytes = 0i64;
  let unknown = 0;
  let checklist: ui.El[Msg][] = [];
  for item in line.cards {
    let report = tools.trip.find((result: listening.Trip): boolean => result.id == item.id);
    let complete = report.map((result: listening.Trip): boolean => result.expected > 0 && result.present == result.expected).unwrap_or(false);
    let state = offline.label(m.downloads, item.id);
    let label = if (tools.trip_running) { "Checking…" } else { if (complete) { "Ready offline" } else { if (state.len() > 0 && state != "Saved") { state } else { "Audio missing" } } };
    let controls = [ui.text[Msg](item.title).clamped(2).wide(), ui.text[Msg](label).colored(ui.MUTED).clamped(2)];
    if (complete) {
      ready += 1;
    } else {
      let at = card_index(m, item.id);
      if (at >= 0 && m.cards[at].bytes > 0i64) {
        bytes += (m.cards[at].bytes - report.map((result: listening.Trip): i64 => result.bytes).unwrap_or(0i64)).max(0i64);
      } else {
        unknown += 1;
      }
    }
    let failed = report.map((result: listening.Trip): i32 => result.first_bad).unwrap_or(-1);
    if (state == "Saved" && failed >= 0 && m.token.len() > 0) {
      controls = controls.append(ui.text_button("Repair", RepairTripCard(item.id, failed)));
    } else if (state == "Needs attention" && m.token.len() > 0) {
      controls = controls.append(ui.text_button("Retry", RetryTrack(item.id)));
    } else if (state == "Paused") {
      controls = controls.append(ui.text_button("Resume", ContinueDownload(item.id)));
    }
    checklist = checklist.append(ui.row(controls).spaced(6.0).aligned(ui.CENTER));
  }
  if (!tools.trip_running) {
    rows = rows.append(ui.text[Msg](ready.to_string() + " of " + line.cards.len().to_string() + " ready offline").weighted(700));
    if (ready < line.cards.len()) {
      let known = if (bytes > 0i64) { size_text(bytes) + " known remaining" } else { "Remaining size unavailable" };
      let extra = if (unknown > 0) { " · " + unknown.to_string() + " without a size estimate" } else { "" };
      rows = rows.append(ui.text(known + extra).colored(ui.MUTED));
    }
    rows = rows.append(ui.text_button("Check again", CheckLineup(line.name)));
  }
  if (m.token.len() > 0 && ready < line.cards.len()) {
    rows = rows.append(ui.button("Download missing", PrimeLineup(line.name)));
  }
  if (ready > 0) {
    rows = rows.append(ui.outlined_button("Test offline playback", TestTrip(line.name)));
  }
  if (tools.note.len() > 0) {
    rows = rows.append(ui.text(tools.note).colored(ui.MUTED));
  }
  return ui.column(rows.concat(checklist).concat(playback_bar(m))).spaced(10.0).padding(16.0).wide().tall().scroll("trip-dashboard:" + line.id);
}

function car_view(m: Model): ui.El[Msg][] {
  let s = m.phone;
  let paused = match (s.phase) { phone.Paused => true, _ => false };
  let playing = match (s.phase) { phone.Playing => true, _ => false };
  let rows: ui.El[Msg][] = [];
  if (s.at < s.queue.len()) {
    rows = rows.append(ui.text[Msg](s.title).colored(ui.MUTED));
    rows = rows.append(ui.text(s.queue[s.at].title).sized(25.0).weighted(700));
  } else {
    rows = rows.append(ui.text[Msg]("Choose a downloaded trip below.").colored(ui.MUTED));
  }
  if (playing || paused) {
    rows = rows.append(ui.button(if (paused) { "Resume" } else { "Pause" }, PhoneControl(if (paused) { api.Resume } else { api.Pause })).height(76.0).wide());
    rows = rows.append(ui.row([
      ui.outlined_button("Back 15 s", PhoneRewind).wide().height(68.0),
      ui.outlined_button("Next", PhoneNext).wide().height(68.0),
    ]).spaced(10.0).wide());
  }
  let trips = m.playback_tools.saved.lineups;
  for line in trips {
    let count = line.cards.filter((item: listening.Item): boolean => offline.saved(m.downloads, item.id).is_some()).len();
    if (count > 0) {
      rows = rows.append(ui.outlined_button(line.name + " · " + count.to_string() + " saved", PlayCarTrip(line.id)).height(60.0).wide());
    }
  }
  return rows;
}

function time_view(m: Model): ui.El[Msg][] {
  let choices = [10, 20, 45];
  let limit = m.travel_panel.duration;
  let selected = choices.position((minutes: i32): boolean => minutes == limit).unwrap_or(1);
  let results = travel.fit(m.cards, m.downloads.catalog, m.playback_tools.saved, limit);
  let rows = [ui.tabs(["10 min", "20 min", "45 min"], selected, (i: i32): Msg => PickTime(choices[i]))];
  if (results.len() == 0) {
    return rows.append(ui.text("No saved stories or episodes with a known duration fit this time.").colored(ui.MUTED));
  }
  for item in results {
    let label = item.card.title;
    let time = if (item.seconds < 60i64) { item.seconds.to_string() + " s" } else { ((item.seconds + 59i64) / 60i64).to_string() + " min" };
    rows = rows.append(ui.card([ui.row([ui.text[Msg](label).wide().clamped(2), ui.text(time).colored(ui.MUTED), ui.text_button("Play", PlayFit(item)).described("Play " + label)]).spaced(8.0).aligned(ui.CENTER)]).wide());
  }
  return rows;
}

function storage_view(m: Model): ui.El[Msg][] {
  let s = m.playback_tools.saved;
  let panel = m.travel_panel;
  let report = m.playback_tools.trip.filter((row: listening.Trip): boolean => offline.saved(m.downloads, row.id).is_some());
  let bytes = 0i64;
  for row in report {
    bytes += row.bytes;
  }
  let choices = [0, 1024, 2048, 4096, 8192];
  let selected = choices.position((mb: i32): boolean => mb == s.budget_mb).unwrap_or(0);
  let rows = [
    ui.tabs(["Off", "1 GB", "2 GB", "4 GB", "8 GB"], selected, (i: i32): Msg => PickBudget(choices[i])),
    ui.text_button("Check storage", OpenTravel(StorageBudget)),
  ];
  if (m.playback_tools.trip_running) {
    return rows.append(ui.text("Checking downloaded audio…").colored(ui.MUTED));
  }
  let over = if (s.budget_mb > 0) { (bytes - s.budget_mb as i64 * 1048576i64).max(0i64) } else { 0i64 };
  let label = "Saved audio uses " + size_text(bytes);
  rows = rows.append(ui.text(label).weighted(650));
  if (over > 0i64) {
    rows = rows.append(ui.text(size_text(over) + " above your budget").colored(ui.MUTED));
  }
  rows = rows.append(ui.text[Msg]("Favourites, trip cards, and bedtime audio are protected.").colored(ui.MUTED));
  for item in travel.largest(s, report).take(12) {
    if (item.id != m.phone.card) {
      let action = if (panel.storage_confirm == item.id) { ui.button("Confirm removal", RemoveForBudget(item.id)) } else { ui.text_button("Remove", SuggestRemoval(item.id)) };
      rows = rows.append(ui.row([ui.text[Msg](item.title).wide().clamped(2), ui.text(size_text(item.bytes)).colored(ui.MUTED), action]).aligned(ui.CENTER).spaced(6.0));
    }
  }
  return rows;
}

function card_picker_for_travel(m: Model, choice: i32): ui.El[Msg][] {
  let query = m.travel_panel.query.to_lower().trim();
  let selected = m.cards.filter((card: api.Card): boolean => {
    if (!card.search.contains(query)) {
      return false;
    }
    if (choice == 3) {
      return offline.saved(m.downloads, card.id).is_some();
    }
    let sound = card.sleep_sounds || search.category(card.kind) == 4;
    return sound == (choice == 2) && (m.token.len() > 0 || offline.saved(m.downloads, card.id).is_some());
  });
  let field = ui.field[Msg]("travel-search", m.travel_panel.query, "Find cards").on_edit((text: string): Msg => TravelQuery(text));
  let list = ui.list("travel-card-results:" + choice.to_string() + ":" + m.travel_panel.query, selected.len(), 56.0, (i: i32): ui.El[Msg] => {
    let item = selected[i];
    let action = if (choice == 3) { PlayTagCard(item.id) } else { SetRoutineCard(item.id) };
    return ui.text_button(item.title, action).wide().height(52.0);
  }).height((selected.len() * 56).min(560) as f64);
  return [ui.text_button("Back to choices", SetRoutineChoice(0)), field, list];
}

function bedtime_view(m: Model): ui.El[Msg][] {
  let s = m.playback_tools.saved;
  let r = travel.routine(s);
  if (m.travel_panel.choice > 0) {
    return card_picker_for_travel(m, m.travel_panel.choice);
  }
  let story = if (r.story.id.len() > 0) { r.story.title } else { "Choose story" };
  let sound = if (r.sound.id.len() > 0) { r.sound.title } else { "Choose sleep sound" };
  let choices = [15, 30, 60];
  let index = choices.position((minutes: i32): boolean => minutes == r.minutes).unwrap_or(1);
  return [
    ui.text[Msg](s.profile).colored(ui.MUTED),
    ui.row([ui.text[Msg]("Story").wide(), ui.text_button(story, SetRoutineChoice(1))]).aligned(ui.CENTER),
    ui.row([ui.text[Msg]("Sleep sound").wide(), ui.text_button(sound, SetRoutineChoice(2))]).aligned(ui.CENTER),
    ui.text[Msg]("Play sleep sounds for").colored(ui.MUTED),
    ui.tabs(["15 min", "30 min", "60 min"], index, (i: i32): Msg => SetRoutineTime(choices[i])),
    ui.checkbox(s.fade, "Fade out at the end", ToggleSleepFade),
    ui.button("Start bedtime", StartRoutine),
  ];
}

function tag_view(m: Model): ui.El[Msg][] {
  let panel = m.travel_panel;
  if (panel.choice == 3) {
    return card_picker_for_travel(m, panel.choice);
  }
  let s = m.playback_tools.saved;
  let rows: ui.El[Msg][] = [
    ui.checkbox(panel.tap_to_play, "Tap to play saved cards", SetTapToPlay),
    ui.text_button("Link a saved card", SetRoutineChoice(3)),
    ui.text_button("Link this profile's bedtime routine", LinkRoutineTag),
  ];
  if (panel.selected_tag.len() > 0 || panel.nfc_routine) {
    let title = if (panel.nfc_routine) { "Bedtime routine" } else { queue_item(m, panel.selected_tag).map((item: listening.Item): string => item.title).unwrap_or("") };
    rows = rows.append(ui.text[Msg]("Hold an NFC sticker near the phone to link " + title + ".").colored(ui.MUTED));
  }
  rows = rows.append(ui.button(if (m.tools_page.scanning) { "Ready to scan" } else { "Start NFC scan" }, StartScan));
  if (m.tools_page.note.len() > 0) {
    rows = rows.append(ui.text(m.tools_page.note).colored(ui.MUTED));
  }
  for link in s.tags {
    let title = if (link.routine) { link.profile + " · Bedtime routine" } else { link.card.title };
    rows = rows.append(ui.row([ui.text[Msg](title).wide().clamped(2), ui.text_button("Unlink", RemoveTag(link.uid))]).aligned(ui.CENTER));
  }
  return rows;
}

function chapter_download_view(m: Model): ui.El[Msg][] {
  let id = m.travel_panel.card;
  let at = card_index(m, id);
  if (at < 0) {
    return [];
  }
  let card = m.cards[at];
  let rows: ui.El[Msg][] = [ui.text[Msg](card.title).sized(21.0).weighted(650)];
  let seen: Map[string, boolean] = map_new(32);
  for track in card.tracks {
    if (track.chapter_key.len() == 0 || seen.contains(track.chapter_key)) {
      continue;
    }
    seen = seen.insert(track.chapter_key, true);
    let local = api.chapter_download_id(id, track.chapter_key);
    let full = offline.saved(m.downloads, id).is_some();
    let name = if (track.chapter.len() > 0) { track.chapter } else { track.title };
    let detail = offline.label(m.downloads, local);
    let actions = [
      ui.text[Msg](name).clamped(2).wide(),
    ];
    if (full) {
      let fit = travel.Fit { card: listening.Item { id: id, title: name }, chapter: track.chapter_key, track: "", position: 0i64, seconds: 0i64 };
      actions = actions.append(ui.text_button("Play saved", PlayFit(fit)));
    } else if (detail == "Saved") {
      actions = actions.append(ui.text_button("Play saved", PlayChapter(local)));
    } else if (detail == "Needs attention" && m.token.len() > 0) {
      actions = actions.append(ui.text_button("Retry", RetryTrack(local)));
    } else if (detail.len() > 0) {
      actions = actions.append(ui.text(detail).colored(ui.MUTED));
    } else if (m.token.len() > 0) {
      actions = actions.append(ui.text_button("Download", SaveChapter(id, track.chapter_key)).described("Download " + name));
    }
    rows = rows.append(ui.row(actions).aligned(ui.CENTER).spaced(8.0).wide());
  }
  return rows;
}

function travel_view(m: Model, page: TravelPage): ui.El[Msg] {
  let (title, body) = match (page) {
    CarMode => ("Car Mode", car_view(m)),
    ListenTime => ("Find a story by time", time_view(m)),
    StorageBudget => ("Download storage budget", storage_view(m)),
    Bedtime => ("Bedtime routine", bedtime_view(m)),
    NfcTags => ("NFC cards and stickers", tag_view(m)),
    ChapterDownloads => ("Chapter downloads", chapter_download_view(m)),
  };
  let rows = [ui.text_button("Back", CloseTravel), ui.text[Msg](title).sized(27.0).weighted(700)];
  let note = m.playback_tools.note;
  if (note.len() > 0) {
    rows = rows.append(ui.text(note).colored(ui.MUTED));
  }
  return ui.column(rows.concat(body)).spaced(12.0).padding(16.0).wide().tall().scroll("travel:" + title);
}

pub function view(m: Model, screen: ui.Screen): ui.El[Msg] {
  if (m.parent.open) {
    return parent_view(m, screen);
  }
  if (m.playback_tools.saved.kids) {
    return kids_view(m, screen);
  }
  if let Some(page) = m.travel_panel.page {
    return travel_view(m, page);
  }
  if (m.target_open) {
    return destination_view(m);
  }
  if (m.playback_tools.profile_open) {
    return profile_view(m);
  }
  if let Some(line) = lineup_by_name(m, m.playback_tools.trip_focus) {
    return trip_dashboard(m, line);
  }
  if let Some(draft) = m.playback_tools.draft {
    return trip_editor(m, draft);
  }
  if (m.playback_tools.history_open) {
    return history_view(m);
  }
  if let Some(page) = m.tools_page.page {
    return tools_view(m, page);
  }
  if let Some(edit) = m.editing_group {
    return group_editor(m, edit);
  }
  if (m.now_open) {
    return now_playing_screen(m, screen);
  }
  let title = ui.text[Msg]("Story Deck").sized(30.0).weighted(700).wide();
  if (m.token.len() == 0) {
    if (m.tab > 0 && (m.tab != 1 || m.cache_available || m.downloads.catalog.entries.len() > 0)) {
      let tabs = ui.tabs(["Sign in", "Library", "Downloads", "Queue"], m.tab, (at: i32): Msg => SelectTab(at));
      let body = if (m.tab == 3) { playback_queue(m) } else { download_list(m) };
      if (m.tab == 1) {
        body = if let Some(card) = opened_card(m) { card_details(m, card, screen) } else { card_list(m, screen) };
      }
      return ui.column([body].concat(playback_bar(m)).append(tabs)).padding_xy(16.0, 0.0).wide().tall();
    }
    let items = [title, sign_in(m), ui.text_button("Player and family setup", OpenTools(panel_tools.Setup))];
    if (m.cache_available || m.downloads.catalog.entries.len() > 0) {
      items = items.append(ui.text_button("Listening profiles", ShowProfiles));
    }
    if (m.cache_available || m.downloads.catalog.entries.len() > 0) {
      items = items.append(ui.text_button("Offline library", SelectTab(1)));
    }
    if (m.downloads.catalog.entries.len() > 0) {
      items = items.append(ui.text_button("Downloads", SelectTab(2)));
    }
    if (m.playback_tools.saved.favourites.len() > 0) {
      items = items.append(ui.text_button("Kids mode", EnterKids));
    }
    if (m.playback_tools.saved.queue.len() > 0 || m.playback_tools.saved.marks.len() > 0 || m.playback_tools.saved.pins.len() > 0 || m.playback_tools.saved.lineups.len() > 0 || m.playback_tools.saved.history.len() > 0) {
      items = items.append(ui.text_button("Queue", SelectTab(3)));
    }
    return ui.column(items).spaced(20.0).padding(20.0).wide().tall().scroll("connection");
  }
  if let Some(player) = m.config_panel.device {
    return settings_panel(m, player, screen);
  }
  let tabs = ui.tabs(["Players", "Library", "Downloads", "Queue"], m.tab, (tab: i32): Msg => SelectTab(tab));
  let body = player_list(m);
  let name = "Players";
  if (m.tab == 1) {
    if let Some(card) = opened_card(m) {
      body = card_details(m, card, screen);
      name = "Library";
    } else {
      return ui.column([card_list(m, screen)].concat(playback_bar(m)).append(tabs)).padding_xy(16.0, 0.0).wide().tall();
    }
  } else if (m.tab == 2) {
    body = download_list(m);
    name = "Downloads";
  } else if (m.tab == 3) {
    body = playback_queue(m);
    name = "Queue";
  }
  return ui.column([section_header(m, name), body].concat(playback_bar(m)).append(tabs)).spaced(12.0).padding_xy(16.0, 8.0).wide().tall();
}

function wait(m: Model): i32 {
  if (!m.shelf.search_busy && m.shelf.search_due > 0i64) {
    return (((m.shelf.search_due - monotonic_ns()) / 1000000i64) as i32).max(0);
  }
  if (m.reconnect || m.load_after_auth || m.transfer_target.len() > 0 || should_read_playback(m) || pending_download(m).is_some() || needs_index_save(m) || m.launch_action.len() > 0 && (m.library_loaded || !m.busy && m.token.len() == 0)) {
    return 0;
  }
  if (m.auth.len() > 0) {
    return 100;
  }
  if (m.flow.is_some()) {
    return 150;
  }
  if (!m.busy && !m.cover_busy && (next_cover(m).len() > 0 || warm_art(m).len() > 0)) {
    return 120;
  }
  if (m.library_loaded && !m.busy && !m.background_busy && m.shelf.paused.len() == 0 && m.shelf.next < m.cards.len()) {
    return 400;
  }
  let offline_wait = offline.work_interval(m.downloads);
  if (offline_wait >= 0) {
    return offline_wait;
  }
  if (m.playback_tools.sleep_at > 0i64 || m.playback_tools.trip_test_until > 0i64) {
    if (m.playback_tools.saved.fade && m.playback_tools.sleep_at > 0i64 && m.playback_tools.sleep_at - monotonic_ns() <= 5000000000i64) {
      return 150;
    }
    return 500;
  }
  if (m.playback_tools.saved.wifi_only && m.downloads.queue.len() > 0 || m.downloads.paused || offline.has_failed(m.downloads) || m.parent.open && m.playback_tools.saved.retry_pin_at > now_unix_ms()) {
    return 1000;
  }
  if let phone.Playing = m.phone.phase {
    return 1000;
  }
  if (m.selected.len() > 0 && m.token.len() > 0 && !m.on_phone && m.now_playing.due > 0i64) {
    return 1000;
  }
  return -1;
}

function system(event: android.Event): Option[Msg] {
  let android.Posted(tagged, arg) = event else {
    return None;
  };
  match (player.event(event)) {
    Some(player.Prepared) | Some(player.Completed) | Some(player.Failed(_, _)) | Some(player.Seeked) => {
      return Some(PhoneEvent(tagged, arg));
    },
    _ => {
      return None;
    }
  }
}

function back_message(m: Model): Option[Msg] {
  if (m.parent.open) {
    return Some(CloseParent);
  }
  if (m.playback_tools.saved.kids) {
    return None;
  }
  if (m.travel_panel.page.is_some()) {
    return Some(CloseTravel);
  }
  if (m.target_open) {
    return Some(CloseTarget);
  }
  if (m.playback_tools.profile_open) {
    return Some(ShowProfiles);
  }
  if (m.playback_tools.trip_focus.len() > 0) {
    return Some(OpenTripDashboard(""));
  }
  if (m.playback_tools.draft.is_some()) {
    return Some(CloseLineup);
  }
  if (m.playback_tools.history_open) {
    return Some(ShowHistory);
  }
  if (m.flow.is_some()) {
    return Some(Cancel);
  }
  if (m.audio_editor.is_some()) {
    return Some(CloseAudioEditor);
  }
  if (m.tools_page.page.is_some()) {
    return Some(CloseTools);
  }
  if (m.editing_group.is_some()) {
    return Some(CloseGroup);
  }
  if (m.now_open) {
    return if (visible_expansion(m).is_some()) { Some(RestoreTrackArtwork) } else { Some(CloseNowPlaying) };
  }
  if (m.config_panel.device.is_some()) {
    return if (m.config_panel.picker.is_some()) { Some(BackToSettings) } else { Some(CloseSettings) };
  }
  if (m.menu_open) {
    return Some(ToggleMenu);
  }
  if (m.tab == 2 && m.trip_select && m.token.len() > 0) {
    return Some(ChooseDownloads);
  }
  if (m.tab == 2 && m.offline_open.len() > 0) {
    return Some(OpenDownload(""));
  }
  if (m.tab == 1 && m.shelf.opened.len() > 0) {
    return Some(CloseCard);
  }
  if (m.tab_history.len() > 0) {
    return Some(BackTab);
  }
  return None;
}

pub function program(open_browser: (string) => boolean, decode: (u8[], i32) => Option[draw.Image], persist: (Option[api.Session]) => boolean, output: phone.Output, disk: offline.Output, store: (listening.Saved) => boolean): ui.Program[Model, Msg] {
  return ui.program(view, update).with_visible(visible_posters).with_system(system).with_effects((m: Model): Model => effects(m, open_browser, decode, persist, output, disk, store)).with_jobs(start_job).with_tick(wait, Msg.Tick).with_back(back_message).with_close((own m: Model): own Model => {
    close_pipe(m.cover_stop);
    if (!m.tools_page.busy) {
      panel_tools.clear_audio(m.tools_page.draft);
    }
    let saved = save_listening(m, output, store, true);
    phone.close(saved.phone, output);
    return close_app(Model { ...saved }, persist);
  }).with_state(
    (m: Model, k: kv.Store): kv.Store => k.set("client_id", m.client),
    (own m: Model, k: kv.Store): own Model => Model { ...m, client: if (m.refresh.len() > 0) { m.client } else { k.get("client_id").unwrap_or(m.client) } },
  ).with_theme(launcher_icon.theme);
}
