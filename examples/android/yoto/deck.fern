enum Job {
  Load(string),
  Find(SearchWork),
  SortMatches(i64, api.Card[], search.Hit[], boolean),
  Send(i64, string, string, api.Command),
  Tracks(i64, i32, string, api.Card),
  Cover(i64, string, string, boolean, i32),
  WarmArt(i64, string, string),
  ReadPlayback(i64, i64, string, string),
  ReadDeviceStatus(i64, string, string),
  WriteGroup(i64, string, GroupEdit),
  RemoveGroup(i64, string, string),
  LookUpCard(i64, string, string),
  ReadPlaylist(i64, string, api.Card),
  WritePlaylist(i64, string, api.Playlist),
  AnalyzeAudio(i64, api.LocalAudio),
  RenderEditedAudio(i64, api.LocalAudio, string, string, myo_audio.Edit),
  ReadShop(i64),
  Streams(i64, string, api.Card, string, string),
  ReadConfig(i64, string, api.Player),
  WriteConfig(i64, string, api.Player, api.PlayerConfig, (string, json.JsonValue)[]),
  ReadShortcutTracks(i64, string, api.Card),
  GetDownload(i64, string, api.Card),
  TripCheck(offline.Catalog, listening.Item[]),
  PinWork(string, string),
  SaveIndex(i64, api.Card[], i64),
  TransferPlayback(i64, i64, string, string, api.Command, boolean),
}

enum Storage { SaveSession, ClearSession, ClearAuth }

