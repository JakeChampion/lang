enum Job {
  Load(string),
  Send(i64, string, string, api.Command),
  Tracks(i64, i32, string, api.Card),
  Cover(i64, string, string, boolean),
  WarmArt(i64, string, string),
  ReadPlayback(i64, i64, string, string),
  ReadDeviceStatus(i64, string, string),
  WriteGroup(i64, string, GroupEdit),
  RemoveGroup(i64, string, string),
  LookUpCard(i64, string, string),
  ReadPlaylist(i64, string, api.Card),
  WritePlaylist(i64, string, api.Playlist),
  ReadShop(i64),
  Streams(i64, string, api.Card, string, string),
  ReadConfig(i64, string, api.Player),
  WriteConfig(i64, string, api.Player, api.PlayerConfig, (string, json.JsonValue)[]),
  ReadShortcutTracks(i64, string, api.Card),
  GetDownload(i64, string, api.Card),
  TripCheck(offline.Catalog, listening.Item[]),
}

enum Storage { SaveSession, ClearSession, ClearAuth }

struct Shelf {
  hits: search.Hit[],
  query: string,
  filter: i32,
  group: string,
  groups: api.Group[],
  groups_open: boolean,
  groups_note: string,
  by_title: boolean,
  pinned: boolean,
  downloaded_only: boolean,
  search_scope: i32,
  search_revision: i64,
  opened: string,
  first_art: i32,
  last_art: i32,
  next: i32,
  paused: string,
  attempted: Map[string, boolean],
  note: string,
  covers: Map[string, Option[draw.Image]],
  cover_order: string[],
  received: Option[(string, u8[])],
}

struct GroupEdit { id: string, name: string, members: string[], image: string, query: string, confirm: boolean, busy: boolean, note: string }

struct NowPlaying {
  revision: i64,
  requested: boolean,
  due: i64,
  running: boolean,
  playback: Option[player_status.Playback],
  note: string,
}

enum ConfigPicker { AlarmCards, SettingChoices(string), ShortcutCards(string), ShortcutTracks(string, string), LightColour(string, light_colour.Hsv) }

struct ConfigPanel {
  revision: i64,
  device: Option[api.Player],
  config: Option[api.PlayerConfig],
  draft: Map[string, string],
  working: boolean,
  note: string,
  picker: Option[ConfigPicker],
  query: string,
}

struct PlaybackTools {
  saved: listening.Saved,
  dirty: boolean,
  sample: boolean,
  bookmark_now: boolean,
  sample_at: i64,
  sleep_at: i64,
  trip_running: boolean,
  trip: listening.Trip[],
  note: string,
}

pub struct Model {
  client: string,
  token: string,
  refresh: string,
  reconnect: boolean,
  auth: worker.Worker[Result[api.Tokens, api.Failure]][],
  storage: Option[Storage],
  session_note: string,
  load_after_auth: boolean,
  players: api.Player[],
  cards: api.Card[],
  shelf: Shelf,
  generation: i64,
  background_busy: boolean,
  cover_busy: boolean,
  art_dir: string,
  warmed: Map[string, boolean],
  trip_select: boolean,
  trip_cards: Map[string, boolean],
  selected: string,
  on_phone: boolean,
  phone: phone.State,
  playback_tools: PlaybackTools,
  now_playing: NowPlaying,
  now_open: boolean,
  tools_page: panel_tools.State,
  editing_group: Option[GroupEdit],
  device_status: Option[api.DeviceStatus],
  device_note: string,
  volume: i32,
  config_panel: ConfigPanel,
  downloads: offline.State,
  offline_open: string,
  tab: i32,
  tab_history: i32[],
  menu_open: boolean,
  note: string,
  library_loaded: boolean,
  enrich_downloads: boolean,
  busy: boolean,
  open_login: boolean,
  flow: Option[oauth.Flow],
  job: Option[Job],
}

