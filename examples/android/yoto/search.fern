import "std/string";
import "./api";

pub struct Hit { card: i32, track: i32 }

pub const ALL: i32 = 0;

pub const TITLES: i32 = 1;

pub const CHAPTERS: i32 = 2;

pub const TRACKS: i32 = 3;

pub function category(kind: api.Kind): i32 {
  match (kind) {
    api.Standard => {
      return 1;
    },
    api.Myo => {
      return 2;
    },
    api.Podcast => {
      return 3;
    },
    api.Radio => {
      return 4;
    }
  }
}

function matches(terms: string[], card: string, track: string): boolean {
  for term in terms {
    if (!card.contains(term) && !track.contains(term)) {
      return false;
    }
  }
  return true;
}

function track_matches(terms: string[], card: string, track: string): boolean {
  for term in terms {
    if (track.contains(term)) {
      return matches(terms, card, track);
    }
  }
  return false;
}

pub function find(cards: api.Card[], query: string, filter: i32): Hit[] {
  return find_in(cards, query, filter, ALL);
}

pub function find_in(cards: api.Card[], query: string, filter: i32, scope: i32): Hit[] {
  let terms = query.to_lower().replace("\t", " ").replace("\n", " ").split(" ").filter((word: string): boolean => word.len() > 0);
  let titles: Hit[] = [];
  let tracks: Hit[] = [];
  for i in 0..cards.len() {
    let card = cards[i];
    if (filter != 0 && category(card.kind) != filter) {
      continue;
    }
    if ((terms.len() == 0 || scope == ALL || scope == TITLES) && matches(terms, card.search, "")) {
      titles = titles.append(Hit { card: i, track: -1 });
    }
    if (terms.len() > 0 && scope != TITLES) {
      let chapters: Map[string, boolean] = map_new(16);
      for j in 0..card.tracks.len() {
        let track = card.tracks[j];
        if (scope == CHAPTERS) {
          let key = if (track.chapter_key.len() > 0) { track.chapter_key } else { track.chapter };
          if (track.chapter.len() > 0 && !chapters.contains(key) && track_matches(terms, card.search, track.chapter.to_lower())) {
            chapters = chapters.insert(key, true);
            tracks = tracks.append(Hit { card: i, track: j });
          }
        } else if (track_matches(terms, card.search, track.search)) {
          tracks = tracks.append(Hit { card: i, track: j });
        }
      }
    }
  }
  return titles.concat(tracks);
}
