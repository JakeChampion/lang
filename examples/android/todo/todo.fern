// A list of things to do: its state, its screen and its messages. It has no
// Android code, so todo_test.fern runs it on the host.
import "std/android/ui";

pub struct Item { text: string, done: boolean }

pub struct Model { items: Item[], draft: string }

// What a person can do on the screen. `Done` and `Remove` have the number
// of the item.
pub enum Msg { Draft(string), Add, Done(i32), Remove(i32) }

pub function start(): Model {
  return Model { items: [], draft: "" };
}

// How many items are not done.
pub function left(m: Model): i32 {
  let n = 0;
  for it in m.items {
    if (!it.done) {
      n += 1;
    }
  }
  return n;
}

function summary(m: Model): string {
  if (m.items.len() == 0) {
    return "Nothing to do";
  }
  return left(m).to_string() + " of " + m.items.len().to_string() + " left";
}

// One item: a switch for done, its text, and a button that removes it.
function row(m: Model, i: i32): ui.El[Msg] {
  let it = m.items[i];
  let color = ui.INK;
  if (it.done) {
    color = ui.MUTED;
  }
  return ui.row([ui.toggle(it.done, it.text, Done(i)), ui.text(it.text).sized(16.0).colored(color).clamped(1).wide(), ui.text_button("Remove", Remove(i))]).spaced(12.0).aligned(ui.CENTER).padding_xy(16.0, 0.0);
}

pub function view(m: Model, s: ui.Screen): ui.El[Msg] {
  return ui.column(
    [
      ui.column([ui.text("To do").sized(28.0).weighted(700), ui.text(summary(m)).colored(ui.MUTED)]).spaced(4.0).padding_xy(16.0, 0.0),
      ui.row([ui.field("draft", m.draft, "What is next?").on_edit((text: string): Msg => Draft(text)).on_submit(Add), ui.button("Add", Add)]).spaced(12.0).aligned(ui.CENTER).padding_xy(16.0, 0.0),
      ui.divider(),
      ui.list("items", m.items.len(), 56.0, (i: i32): ui.El[Msg] => row(m, i)),
    ],
  ).spaced(16.0).padding_xy(0.0, 16.0).aligned(ui.STRETCH);
}

function added(m: Model): Model {
  let text = m.draft.trim().to_owned();
  if (text.len() == 0) {
    return m;
  }
  return Model { items: m.items.append(Item { text: text, done: false }), draft: "" };
}

function toggled(m: Model, i: i32): Model {
  if (i < 0 || i >= m.items.len()) {
    return m;
  }
  let it = m.items[i];
  return Model { ...m, items: m.items.with(i, Item { ...it, done: !it.done }) };
}

function removed(m: Model, i: i32): Model {
  let rest: Item[] = [];
  for k in 0..m.items.len() {
    if (k != i) {
      rest = rest.append(m.items[k]);
    }
  }
  return Model { ...m, items: rest };
}

pub function update(own m: Model, msg: Msg): Model {
  match (msg) {
    Draft(text) => {
      return Model { ...m, draft: text };
    },
    Add => {
      return added(m);
    },
    Done(i) => {
      return toggled(m, i);
    },
    Remove(i) => {
      return removed(m, i);
    }
  }
}

pub function program(): ui.Program[Model, Msg] {
  return ui.program(view, update);
}
