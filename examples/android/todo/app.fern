// A list of things to do, with no Java code of its own. NativeActivity
// loads this library and calls ANativeActivity_onCreate, and
// std/android/ui/app runs the program of todo.fern.
import "std/android";
import "std/android/ui/app";
import "std/log";
import "./todo";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last = app.run(ctx, todo.start(), todo.program());
  let texts: string[] = [];
  for it in last.items {
    texts = texts.append(it.text);
  }
  log.info("todo: closed with " + last.items.len().to_string() + " items, " + todo.left(last).to_string() + " left: " + texts.join(" | "));
  return 0 as usize;
}
