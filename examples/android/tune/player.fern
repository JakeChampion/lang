// What the player does on the device for the state of tune.fern: it reads
// the file of a track, and gives its samples to a stream of sound. The
// device is a set of functions, so a test gives one that plays nothing.
import "std/array";
import "core/cmp";
import "std/android/draw";
import "std/android/ui";
import "std/i32";
import "std/i64";
import "std/audio/eq";
import "std/audio/spectrum";
import "std/audio/tags";
import "std/audio/wire";
import "std/option";
import "std/result";
import "std/utf8";
import "./engine";
import "./library";
import "./tune";

// `grant` asks the person for the permission to read the music of the
// phone. `roots` has the directories of the music of the phone. `names`
// gives the names in a directory, and `is_dir` tells that a path is a
// directory. `demo` makes the tunes of the player and gives their paths.
// `now` is the time in ns. `dirs` gives the names of the directories in a directory, and
// `keep` keeps the folder of the library for the next start. `decode` gives an
// image from the bytes of a JPEG or a PNG file, at a size. `save` keeps
// the text of the library for the next start, and `keep_lists` keeps the
// text of the playlists. `keep_prefs` keeps the text of the settings, and `keep_place` keeps the text of the place of the player. `write_bytes` writes a file, and tells that it did. `ask_write` asks the person to let the app change a file, and tells that the question shows. `to_back` puts the app behind the other apps. `write_text` writes a text file, and tells that it
// did. `kept` gives the bytes
// that `put` kept under a name, or no bytes. `show` tells
// Android the track that plays and its state. `wake` keeps the phone
// awake until `sleep`. `quit` gives back what the app holds of Android,
// while the activity is valid, and gets the name of the last track. `size` gives the number of bytes of a
// file, `part` gives at most a number of its bytes from an offset, and
// `read` gives each byte of it, or no bytes. `open` gives a stream at
// a rate with a number of channels. `write` gives the stream samples, and
// tells how many it took.
pub struct Device {
  grant: () => void,
  roots: string[],
  names: (string) => string[],
  is_dir: (string) => boolean,
  demo: () => string[],
  now: () => i64,
  dirs: (string) => string[],
  keep: (string) => void,
  decode: (u8[], i32, i32) => Option[draw.Image],
  save: (string) => void,
  keep_lists: (string) => void,
  keep_prefs: (string) => void,
  keep_place: (string) => void,
  write_bytes: (string, u8[]) => boolean,
  ask_write: (string) => boolean,
  to_back: () => void,
  write_text: (string, string) => boolean,
  kept: (string) => u8[],
  put: (string, u8[]) => void,
  show: (tune.Now) => void,
  quit: (string) => void,
  wake: () => tune.Awake,
  sleep: (tune.Awake) => void,
  size: (string) => i64,
  part: (string, i64, i32) => u8[],
  read: (string) => u8[],
  open: (i32, i32) => tune.Sound,
  start: (tune.Sound) => void,
  pause: (tune.Sound) => void,
  flush: (tune.Sound) => void,
  close: (tune.Sound) => void,
  write: (tune.Sound, [i32]) => i32,
}

// The samples that the player keeps ready, as a part of a second.
const READY_PARTS: i32 = 5;

// The player on a device: the state of tune.fern, the deck that reads the
// file of the track that plays, and the next track while the end of this
// one fades into it. Only one owner uses a deck, so it is not in the state.
pub struct Player { model: tune.Model, deck: Option[engine.Voice], incoming: Option[Incoming] }

// The next track of a crossfade: its number, its deck, the samples of its
// deck that the sound did not take yet, and what the player shows for it.
// `voice` is None when the track cannot fade in, for example at another
// rate.
pub struct Incoming { track: i32, voice: Option[engine.Voice], pending: i32[], gain: tune.Gain, art: Option[draw.Image], lyrics: tune.Line[], length_ms: i64 }

// A player with the state `model` and no deck.
pub function wrap(own model: tune.Model): Player {
  return Player { model: model, deck: None, incoming: None };
}

// A file of a track that the player opened, with what it shows for it.
struct Opened { deck: engine.Deck, art: Option[draw.Image], lyrics: tune.Line[], gain: tune.Gain }

// The track `i` opened, or None when the player cannot play its file.
function opened(dev: Device, m: tune.Model, i: i32): Option[Opened] {
  let path = m.tracks[i].path;
  let Some(deck) = engine.open_file(dev.size(path), (at: i64, n: i32): u8[] => dev.part(path, at, n), engine.WINDOW) else {
    return None;
  };
  let picture = tags.picture(deck.bytes);
  if (picture.len() == 0) {
    picture = folder_picture(dev, m, path);
  }
  let art: Option[draw.Image] = None;
  if (picture.len() > 0) {
    art = dev.decode(picture, ART, ART);
  }
  let told = tags.read(deck.bytes);
  return Some(Opened { deck: deck, art: art, lyrics: lyrics(dev, path, told.lyrics), gain: tune.Gain { track: told.gain, album: told.album_gain } });
}

// The file of the track `i` with the tags of the draft of `m`, written. It
// is false for a format that the player does not write, and for a file
// that the phone does not let the app write.
function wrote_tags(dev: Device, m: tune.Model, i: i32): boolean {
  if (i < 0 || i >= m.tracks.len()) {
    return false;
  }
  let t = tune.retitled(m.tracks[i], m.draft);
  let path = m.tracks[i].path;
  let Some(out) = tags.retagged(dev.read(path), tags.Tags { ...tags.none(), title: t.title, artist: t.artist, album: t.album, album_artist: t.by, track: t.number, year: t.year, genre: t.genre }) else {
    return false;
  };
  return dev.write_bytes(path, out);
}

// The lyrics of the track at `path`: those of the LRC file with its name,
// or those of the tags of its file.
function lyrics(dev: Device, path: string, words: string): tune.Line[] {
  let cut = path.len();
  for k in 0..path.len() {
    if (path[k] == b'.') {
      cut = k;
    }
  }
  if let Ok(text) = utf8.from_bytes(dev.read(path.take(cut).to_owned() + ".lrc")) {
    if (text.len() > 0) {
      return library.lrc(text);
    }
  }
  return library.lrc(words);
}

// The player with the track `i` open. With `follow`, the track goes on in
// the stream of sound that the player has, when the stream has its rate
// and its channels: the sound that the stream holds plays to its end.
// The deck reads a window of the file at a time, so a long file does not
// fill the memory or hold up the screen when it starts. Its first bytes
// are the start of the file, with the tags.
function loaded(dev: Device, own m: tune.Model, i: i32, follow: boolean): Player {
  let Some(o) = opened(dev, m, i) else {
    dev.close(m.sound);
    return wrap(tune.update(tune.Model { ...m, sound: tune.no_sound(), pending: [] }, tune.Failed("Tune cannot play " + m.tracks[i].title)));
  };
  let Opened { deck, art, lyrics: words, gain } = o;
  let sound = m.sound;
  if (!follow || sound.ptr == 0 as usize || sound.rate != deck.rate || sound.channels != deck.channels) {
    dev.close(m.sound);
    sound = dev.open(deck.rate, deck.channels);
    if (sound.ptr == 0 as usize) {
      return wrap(tune.update(tune.Model { ...m, sound: sound, pending: [] }, tune.Failed("The phone gave no sound")));
    }
    dev.start(sound);
  }
  let length = deck.duration_ms();
  return Player { model: tune.Model { ...m, sound: sound, pending: [], at_ms: 0i64, length_ms: length, art: art, lyrics: words, gain: gain }, deck: Some(engine.voice(deck)), incoming: None };
}

// The player on the track `i` that follows the one that ended. The track
// that faded in goes on from where it is, with its samples, and needs no
// new stream. Each other track opens as `loaded` opens it.
function followed(dev: Device, own m: tune.Model, own incoming: Option[Incoming], i: i32): Player {
  let Some(inc) = incoming else {
    return loaded(dev, m, i, true);
  };
  let Incoming { track, voice, pending, gain, art, lyrics: words, length_ms } = inc;
  let Some(v) = voice else {
    return loaded(dev, m, i, true);
  };
  if (track != i) {
    return loaded(dev, m, i, true);
  }
  let at = v.deck.position_ms();
  return Player { model: tune.Model { ...m, pending: pending, at_ms: at, length_ms: length_ms, art: art, lyrics: words, gain: gain }, deck: Some(v), incoming: None };
}

function sought(dev: Device, own m: tune.Model, own deck: Option[engine.Voice], part: f64): Player {
  let Some(d) = deck else {
    return wrap(m);
  };
  dev.pause(m.sound);
  dev.flush(m.sound);
  if (m.playing) {
    dev.start(m.sound);
  }
  let moved = d.seek(part);
  let at = moved.deck.position_ms();
  return Player { model: tune.Model { ...m, pending: [], at_ms: at, told: "" }, deck: Some(moved), incoming: None };
}

// fern-lint: allow cyclomatic-complexity
// One arm for each thing that the state can want.
// The player after the device did `want`.
function done(dev: Device, own p: Player, want: tune.Want): Player {
  let Player { model: m, deck, incoming } = p;
  match (want) {
    tune.Load(i) => {
      return loaded(dev, m, i, false);
    },
    tune.Follow(i) => {
      return followed(dev, m, incoming, i);
    },
    tune.Resume => {
      dev.start(m.sound);
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.Hold => {
      dev.pause(m.sound);
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.Seek(part) => {
      return sought(dev, m, deck, part);
    },
    tune.Scan => {
      if (m.folder.len() > 0) {
        let folder = [m.folder];
        return Player { model: tune.update(m, tune.Walk(folder)), deck: deck, incoming: incoming };
      }
      return Player { model: tune.update(m, tune.Walk(dev.roots)), deck: deck, incoming: incoming };
    },
    tune.List(dir) => {
      return Player { model: tune.update(m, tune.Dirs(dir, dev.dirs(dir))), deck: deck, incoming: incoming };
    },
    tune.Keep(folder) => {
      dev.keep(folder);
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.Grant => {
      dev.grant();
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.WriteTags(i) => {
      let ok = wrote_tags(dev, m, i);
      if (!ok && m.asking != i && i >= 0 && i < m.tracks.len() && dev.ask_write(m.tracks[i].path)) {
        return Player { model: tune.update(m, tune.Asking(i)), deck: deck, incoming: incoming };
      }
      return Player { model: tune.update(m, tune.Retagged(i, ok)), deck: deck, incoming: incoming };
    },
    tune.ToBack => {
      dev.to_back();
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.KeepPlace => {
      dev.keep_place(library.place_text(tune.place(m)));
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.KeepPrefs => {
      dev.keep_prefs(library.prefs_text(tune.prefs(m)));
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.KeepLists => {
      dev.keep_lists(library.lists_text(m.playlists));
      return Player { model: m, deck: deck, incoming: incoming };
    },
    tune.WriteList(name) => {
      let told = exported(dev, m, name);
      return Player { model: tune.update(m, tune.Exported(told)), deck: deck, incoming: incoming };
    },
    tune.Quit => {
      return wrap(closed(dev, m));
    }
  }
}

// The side in pixels of the picture of an album in a list, and of the
// picture of the track that plays.
const THUMB: i32 = 112;

const ART: i32 = 720;

// The bytes of the image file of the directory of `path`, or no bytes.
function folder_picture(dev: Device, m: tune.Model, path: string): u8[] {
  let dir = tune.dir_of(path);
  for p in m.pictures {
    if (tune.dir_of(p) == dir) {
      return dev.read(p);
    }
  }
  return [];
}

// The name that the device keeps the picture of the album of the key
// `key` under: 16 hexadecimal digits of a hash of the key.
function cover_name(key: string): string {
  let h = -3750763034362895579i64;
  for i in 0..key.len() {
    h = (h ^ key[i] as i64) * 1099511628211i64;
  }
  let digits = "0123456789abcdef";
  let out = "";
  for k in 0..16 {
    let d = (h >> (60 - 4 * k) as i64 & 15i64) as i32;
    out += digits.drop(d).take(1);
  }
  return out;
}

// The bytes of a picture that the device keeps: the width and the height
// in 4 bytes each, and then the pixels. A picture with no pixel tells that
// the album has no picture.
function cover_bytes(image: Option[draw.Image]): u8[] {
  let Some(img) = image else {
    return wire.put_le(wire.put_le([], 0u64, 4), 0u64, 4);
  };
  let out = wire.put_le(wire.put_le([], img.width as u64, 4), img.height as u64, 4);
  for b in img.pixels {
    out = out.append(b);
  }
  return out;
}

// A width and a height that a picture of a row can have.
function sized(w: i32, h: i32): boolean {
  return w > 0 && h > 0 && w <= 4096 && h <= 4096;
}

// The picture of bytes of `cover_bytes`: None for bytes that are not one,
// and Some(None) for an album that has no picture.
function cover_image(bytes: u8[]): Option[Option[draw.Image]] {
  if (bytes.len() < 8) {
    return None;
  }
  let w = wire.le(bytes, 0, 4) as i32;
  let h = wire.le(bytes, 4, 4) as i32;
  if (w == 0 && h == 0 && bytes.len() == 8) {
    return Some(None);
  }
  if (!sized(w, h) || bytes.len() != 8 + w * h * 4) {
    return None;
  }
  let pixels: u8[] = [];
  for i in 8..bytes.len() {
    pixels = pixels.append(bytes[i]);
  }
  return Some(Some(draw.Image { width: w, height: h, pixels: pixels }));
}

// The picture of the album of the file `path`, from that file or from an
// image file of its directory, at the size of a row.
function cover_from(dev: Device, m: tune.Model, path: string): Option[draw.Image] {
  let bytes = library.picture(dev.size(path), (at: i64, n: i32): u8[] => dev.part(path, at, n));
  if (bytes.len() == 0) {
    bytes = folder_picture(dev, m, path);
  }
  if (bytes.len() == 0) {
    return None;
  }
  return dev.decode(bytes, THUMB, THUMB);
}

// The player with the picture of the album of the first path of `wanted`.
// The device keeps each picture, so an album gets its picture from its
// files one time.
function covered(dev: Device, own m: tune.Model): tune.Model {
  let path = m.wanted[0];
  let left: string[] = [];
  for i in 1..m.wanted.len() {
    left = left.append(m.wanted[i]);
  }
  let next = tune.Model { ...m, wanted: left };
  let key = "";
  for t in next.tracks {
    if (t.path == path) {
      key = tune.album_key(t.by, t.album);
    }
  }
  if (key.len() == 0 || tune.knows_cover(next, key)) {
    return next;
  }
  let name = cover_name(key);
  if let Some(image) = cover_image(dev.kept(name)) {
    return tune.with_cover(next, key, image);
  }
  let image = cover_from(dev, next, path);
  dev.put(name, cover_bytes(image));
  return tune.with_cover(next, key, image);
}

// Reads the next path of the library. A file of sound is a track, and its
// album gets its picture. A directory gives its entries to the scan. Each
// other path adds nothing.
function scanned(dev: Device, own m: tune.Model): tune.Model {
  let path = m.scan[0];
  let left: string[] = [];
  for i in 1..m.scan.len() {
    left = left.append(m.scan[i]);
  }
  let roots = dev.roots;
  if (m.folder.len() > 0) {
    roots = [m.folder];
  }
  let next = tune.Model { ...m, scan: left };
  if (library.format_of(path).len() > 0) {
    if let Some(t) = library.track(roots, path, dev.size(path), (at: i64, n: i32): u8[] => dev.part(path, at, n)) {
      return tune.update(next, tune.Found(t));
    }
    return next;
  }
  if (library.other_file(path) || path.len() > 1024 || !dev.is_dir(path)) {
    return next;
  }
  return listed(dev, next, path);
}

// Writes the playlist `name` as an M3U file in the folder of the library,
// or in the first directory of the music of the phone that takes it. It
// gives the words that tell the person the result.
function exported(dev: Device, m: tune.Model, name: string): string {
  let Some(list) = tune.playlist(m, name) else {
    return "";
  };
  let dirs = dev.roots.drop(1).concat(dev.roots.take(1));
  if (m.folder.len() > 0) {
    dirs = [m.folder];
  }
  for dir in dirs {
    let path = dir + "/" + name.replace("/", "-") + ".m3u";
    if (dev.write_text(path, library.m3u_text(dir, list.paths))) {
      return "Tune wrote " + path;
    }
  }
  return "Tune cannot write " + name + ".m3u";
}

// The player with the playlist of the M3U file `name` of the directory
// `dir`, under the name of the file. A playlist that the player has stays
// as it is.
function imported(dev: Device, own m: tune.Model, dir: string, name: string): tune.Model {
  let stem = name.take(name.len() - (if (name.to_lower().ends_with(".m3u8")) { 5 } else { 4 })).to_owned();
  if (tune.playlist(m, stem).is_some()) {
    return m;
  }
  let Ok(text) = utf8.from_bytes(dev.read(dir + "/" + name)) else {
    return m;
  };
  return tune.update(m, tune.Imported(stem, library.m3u_paths(dir, text)));
}

// The player with the entries of the directory `path` in its scan. An
// image file with the name of a picture of an album goes to `pictures`,
// an M3U file gives a playlist, and an entry whose name starts with a dot
// goes nowhere.
function listed(dev: Device, own m: tune.Model, path: string): tune.Model {
  let below: string[] = [];
  let pictures = m.pictures;
  let lists: string[] = [];
  for name in cmp.sort(dev.names(path)) {
    if (library.picture_name(name)) {
      pictures = pictures.append(path + "/" + name);
    } else if (library.playlist_name(name)) {
      lists = lists.append(name);
    } else if (!name.starts_with(".")) {
      below = below.append(path + "/" + name);
    }
  }
  let state = tune.update(tune.Model { ...m, pictures: pictures }, tune.Listed(path, below));
  for name in lists {
    state = imported(dev, state, path, name);
  }
  return state;
}

// The milliseconds of one step that the scan can use.
const SCAN_MS: i64 = 8i64;

// Reads paths of the library until the time `until`, in ns: one or more.
// A library with no file of sound gets the tunes of the player one time.
function scanned_until(dev: Device, own m: tune.Model, until: i64): tune.Model {
  let state = scanned(dev, m);
  while (state.scan.len() > 0 && dev.now() < until) {
    state = scanned(dev, state);
  }
  if (state.scan.len() > 0) {
    return state;
  }
  if (state.tracks.len() == 0 && state.folder.len() == 0 && !state.made) {
    let made = dev.demo();
    return tune.update(tune.Model { ...state, made: true }, tune.Files(made));
  }
  // The walk is at its end: the library loses the tracks whose files are
  // not there, and the device keeps the library when it is new.
  let whole = state;
  if (whole.walking) {
    whole = tune.pruned(whole);
  }
  if (whole.dirty) {
    dev.save(library.to_text(whole.tracks));
    return tune.Model { ...whole, dirty: false };
  }
  return whole;
}

// Gets the pictures of albums until the time `until`, in ns: one or more.
function covered_until(dev: Device, own m: tune.Model, until: i64): tune.Model {
  let state = covered(dev, m);
  while (state.wanted.len() > 0 && dev.now() < until) {
    state = covered(dev, state);
  }
  return state;
}

// The samples of `all` from the sample `from`.
function rest(all: i32[], from: i32): i32[] {
  if (from <= 0) {
    return all;
  }
  let out: i32[] = [];
  for i in from..all.len() {
    out = out.append(all[i]);
  }
  return out;
}

// The deck after it gave parts until `ready` has `enough` samples or the
// file ends, and those samples.
function filled(own deck: engine.Voice, ready: i32[], enough: i32, speed: f64, pitch: i32, gain: f64): (engine.Voice, i32[]) {
  let d = deck;
  let out = ready;
  // The factor of a gain in dB: 2 for each 6.02 dB.
  let factor = (gain / 6.020599913279624).exp2();
  while (out.len() < enough && !d.deck.done) {
    let (next, part) = d.pull(speed, pitch);
    d = next;
    for v in part {
      if (gain == 0.0) {
        out = out.append(v);
      } else {
        out = out.append(((v as f64 * factor) as i32).max(-32768).min(32767));
      }
    }
  }
  return (d, out);
}

// The samples `a` of the end of a track and `b` of the start of the next
// one, over the same time, mixed with equal power. The part of the fade
// goes from `t0` at the first frame to `t1` at the last one: 0 is `a`
// alone and 1 is `b` alone. A sample of `a` with no sample of `b` fades
// alone.
pub function crossed(a: [i32], b: [i32], t0: f64, t1: f64, channels: i32): i32[] {
  let c = channels.max(1);
  let frames = (a.len() / c).max(1);
  let out: i32[] = [];
  for k in 0..a.len() {
    let t = (t0 + (t1 - t0) * ((k / c) as f64 / (frames as f64))).max(0.0).min(1.0);
    let angle = t * 1.5707963267948966;
    let mine = a[k] as f64 * angle.cos();
    let theirs = if (k < b.len()) { b[k] as f64 * angle.sin() } else { 0.0 };
    out = out.append(((mine + theirs).round() as i32).max(-32768).min(32767));
  }
  return out;
}

// The part of the fade at `left_ms` before the end of a track, for a fade
// of `fade_ms`.
function fade_part(left_ms: i64, fade_ms: i64): f64 {
  if (fade_ms <= 0i64) {
    return 0.0;
  }
  return (1.0 - left_ms as f64 / (fade_ms as f64)).max(0.0).min(1.0);
}

// The next track opened to fade in, when the track that plays is in its
// last `fade_ms` and the next one plays at the rate of the sound.
function fading_in(dev: Device, m: tune.Model, left_ms: i64, fade_ms: i64, own incoming: Option[Incoming]): Option[Incoming] {
  if (incoming.is_some() || fade_ms <= 0i64 || left_ms > fade_ms) {
    return incoming;
  }
  let next = tune.following(m);
  if (next < 0) {
    return None;
  }
  let none: Option[engine.Voice] = None;
  let Some(o) = opened(dev, m, next) else {
    return Some(Incoming { track: next, voice: none, pending: [], gain: tune.no_gain(), art: None, lyrics: [], length_ms: 0i64 });
  };
  let Opened { deck, art, lyrics: words, gain } = o;
  let length = deck.duration_ms();
  if (deck.rate != m.sound.rate || deck.channels != m.sound.channels) {
    return Some(Incoming { track: next, voice: none, pending: [], gain: gain, art: art, lyrics: words, length_ms: length });
  }
  return Some(Incoming { track: next, voice: Some(engine.voice(deck)), pending: [], gain: gain, art: art, lyrics: words, length_ms: length });
}

// The samples `ready` of the end of the track that plays, with the next
// track faded in over the samples from `from` on, and that next track
// after it gave them. The samples before `from` were mixed before. The
// samples of the next track past the end of `ready` wait in its pending.
function mixed(own inc: Incoming, ready: i32[], from: i32, t0: f64, t1: f64, m: tune.Model): (Incoming, i32[]) {
  let Incoming { track, voice, pending, gain, art, lyrics: words, length_ms } = inc;
  let Some(v) = voice else {
    return (Incoming { track: track, voice: None, pending: pending, gain: gain, art: art, lyrics: words, length_ms: length_ms }, ready);
  };
  let n = ready.len() - from;
  let (moved, theirs) = filled(v, pending, n, m.speed as f64 / 100.0, m.pitch, tune.leveled(m, gain));
  let take = n.min(theirs.len());
  let out = array.slice(ready, 0, from).concat(crossed(array.slice(ready, from, ready.len()), array.slice(theirs, 0, take), t0, t1, m.sound.channels));
  return (Incoming { track: track, voice: Some(moved), pending: array.slice(theirs, take, theirs.len()), gain: gain, art: art, lyrics: words, length_ms: length_ms }, out);
}

// The samples `ready`, with the next track faded in over its new samples
// from `fresh` on when a next track fades in.
function faded(own incoming: Option[Incoming], ready: i32[], fresh: i32, t0: f64, t1: f64, m: tune.Model): (Option[Incoming], i32[]) {
  let Some(inc) = incoming else {
    return (None, ready);
  };
  if (ready.len() <= fresh) {
    return (Some(inc), ready);
  }
  let (next, out) = mixed(inc, ready, fresh, t0, t1, m);
  return (Some(next), out);
}

// The equalizer `filters` for the sound `sound` with the gains `tone`. A
// new rate or a new number of channels gives a new equalizer.
pub function tuned(filters: eq.Equalizer, sound: tune.Sound, tone: i32[]): eq.Equalizer {
  let bands = tune.tone_bands(tone);
  if (filters.rate() != sound.rate || filters.channels() != sound.channels.max(1)) {
    return eq.new(sound.rate, sound.channels, bands);
  }
  let old = filters.bands();
  let same = old.len() == bands.len();
  for i in 0..bands.len().min(old.len()) {
    same = same && old[i].db == bands[i].db;
  }
  if (same) {
    return filters;
  }
  return filters.retuned(bands);
}

// The samples `ready` with those from `from` on through the equalizer.
pub function equalized(filters: eq.Equalizer, own ready: i32[], from: i32): (eq.Equalizer, i32[]) {
  if (filters.flat() || from >= ready.len()) {
    return (filters, ready);
  }
  let (after, done) = filters.run(array.slice(ready, from, ready.len()));
  return (after, array.slice(ready, 0, from).concat(done));
}

// While a track plays: reads the file until the player has enough samples
// ready, gives the sound what it takes, and tells the time of the track.
// In the last seconds of a crossfade, the next track fades in over it.
function pumped(dev: Device, own m: tune.Model, own deck: Option[engine.Voice], own incoming: Option[Incoming]): Player {
  if (!m.playing) {
    return Player { model: m, deck: deck, incoming: incoming };
  }
  let Some(first) = deck else {
    return wrap(m);
  };
  let sound = m.sound;
  let fresh = m.pending.len();
  let (d, ready) = filled(first, m.pending, sound.rate * sound.channels / READY_PARTS, m.speed as f64 / 100.0, m.pitch, tune.leveled(m, m.gain));
  let fade_ms = m.fade_s as i64 * 1000i64;
  let left = d.deck.duration_ms() - d.deck.position_ms();
  let each_ms = (ready.len() - fresh) as i64 * 1000i64 / ((sound.rate * sound.channels).max(1) as i64) * (m.speed as i64) / 100i64;
  let (inc, out) = faded(fading_in(dev, m, left, fade_ms, incoming), ready, fresh, fade_part(left + each_ms, fade_ms), fade_part(left, fade_ms), m);
  let (filters, heard) = equalized(tuned(m.filters, sound, m.tone), out, fresh);
  ready = heard;
  let bars = if (m.open) { tune.fallen(m.bars, spectrum.levels(ready, sound.channels, sound.rate, tune.BARS)) } else { m.bars };
  let wrote = dev.write(sound, ready);
  let kept = rest(ready, wrote);
  let each = (sound.rate * sound.channels).max(1) as i64;
  let waiting = kept.len() as i64 * (m.speed as i64) * 10i64 / each;
  let at = (d.deck.position_ms() - waiting).max(0i64);
  let length = d.deck.duration_ms();
  let ended = d.deck.done && kept.len() == 0;
  let after = tune.Model { ...m, pending: kept, at_ms: at, length_ms: length, filters: filters, bars: bars };
  if (after.sleep_us > 0i64) {
    after = tune.update(after, tune.Slept(wrote as i64 * 1000000i64 / each));
  }
  if (ended) {
    return Player { model: tune.update(after, tune.Finished), deck: Some(d), incoming: inc };
  }
  return Player { model: after, deck: Some(d), incoming: inc };
}

// The player after it read paths of the library until the time `until`,
// and after the sound got its next samples.
function settled(dev: Device, own p: Player, until: i64): Player {
  let Player { model, deck, incoming } = p;
  let m = model;
  if (m.scan.len() > 0) {
    m = scanned_until(dev, m, until);
  } else if (m.wanted.len() > 0) {
    m = covered_until(dev, m, until);
  }
  return pumped(dev, m, deck, incoming);
}

// The state after the player gave back the sound, the locks that keep the
// phone awake, and what it holds of Android. The app closes it so when it
// closes, and when its loop ends with no window. A state with no sound is
// closed already.
pub function closed(dev: Device, own m: tune.Model): tune.Model {
  if (m.sound.ptr == 0 as usize && m.awake.wake == 0 as usize) {
    return m;
  }
  dev.close(m.sound);
  if (m.awake.wake != 0 as usize) {
    dev.sleep(m.awake);
  }
  dev.quit(tune.now_title(m));
  return tune.Model { ...m, sound: tune.no_sound(), pending: [], awake: tune.Awake { wake: 0 as usize, wifi: 0 as usize } };
}

// The player after the device did each thing that the state wants.
function turn(dev: Device, own p: Player, until: i64): Player {
  let Player { model: asked, deck: held, incoming } = p;
  let wants = asked.wants;
  let state = Player { model: tune.Model { ...asked, wants: [] }, deck: held, incoming: incoming };
  for want in wants {
    state = done(dev, state, want);
  }
  return settled(dev, state, until);
}

// The player after the device did what the state wants. A thing that the
// device did can make the state want one more thing.
function run(dev: Device, own p: Player): Player {
  let until = dev.now() + SCAN_MS * 1000000i64;
  let state = turn(dev, p, until);
  let turns = 1;
  while (turns < 4 && state.model.wants.len() > 0) {
    state = turn(dev, state, until);
    turns += 1;
  }
  return state;
}

// Tells Android the track and the state of the player when one of them is
// new, and keeps the phone awake while a track plays.
function shown(dev: Device, own m: tune.Model): tune.Model {
  let key = m.current.to_string() + "|" + m.playing.to_string();
  if (key == m.told || m.current < 0) {
    return m;
  }
  let t = m.tracks[m.current];
  dev.show(tune.Now { title: t.title, artist: t.artist, album: t.album, length_ms: m.length_ms, at_ms: m.at_ms, playing: m.playing, art: m.art });
  let awake = m.awake;
  if (m.playing && awake.wake == 0 as usize) {
    awake = dev.wake();
  } else if (!m.playing && awake.wake != 0 as usize) {
    dev.sleep(awake);
    awake = tune.Awake { wake: 0 as usize, wifi: 0 as usize };
  }
  return tune.Model { ...m, told: key, awake: awake };
}

// The player after the message `msg`: `tune.update` gives the next state,
// and then the device does what that state wants.
function stepped(dev: Device, own p: Player, msg: tune.Msg): Player {
  let Player { model, deck, incoming } = p;
  let Player { model: after, deck: held, incoming: next } = run(dev, Player { model: tune.update(model, msg), deck: deck, incoming: incoming });
  return Player { model: shown(dev, after), deck: held, incoming: next };
}

pub function program(dev: Device): ui.Program[Player, tune.Msg] {
  return ui.program((p: Player, s: ui.Screen): ui.El[tune.Msg] => tune.view(p.model, s), (own p: Player, msg: tune.Msg): Player => stepped(dev, p, msg)).with_tick((p: Player): i32 => tune.beat(p.model), tune.Beat).with_back((p: Player): Option[tune.Msg] => tune.back(p.model)).with_theme_of((p: Player, dark: boolean): ui.Theme => tune.theme(p.model, dark));
}
