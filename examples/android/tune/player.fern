// What the player does on the device for the state of tune.fern: it reads
// the file of a track, and gives its samples to a stream of sound. The
// device is a set of functions, so a test gives one that plays nothing.
import "core/cmp";
import "std/android/draw";
import "std/android/ui";
import "std/i32";
import "std/i64";
import "std/audio/tags";
import "std/option";
import "./engine";
import "./library";
import "./tune";

// `grant` asks the person for the permission to read the music of the
// phone. `roots` has the directories of the music of the phone. `names`
// gives the names in a directory, and `is_dir` tells that a path is a
// directory. `demo` makes the tunes of the player and gives their paths.
// `now` is the time in ns. `dirs` gives the names of the directories in a directory, and
// `keep` keeps the folder of the library for the next start. `decode` gives an
// image from the bytes of a JPEG or a PNG file, at a size. `show` tells
// Android the track that plays and its state. `wake` keeps the phone
// awake until `sleep`. `size` gives the number of bytes of a
// file, `part` gives at most a number of its bytes from an offset, and
// `read` gives each byte of it, or no bytes. `open` gives a stream at
// a rate with a number of channels. `write` gives the stream samples, and
// tells how many it took.
pub struct Device {
  grant: () => void,
  roots: string[],
  names: (string) => string[],
  is_dir: (string) => boolean,
  demo: () => string[],
  now: () => i64,
  dirs: (string) => string[],
  keep: (string) => void,
  decode: (u8[], i32, i32) => Option[draw.Image],
  show: (tune.Now) => void,
  wake: () => tune.Awake,
  sleep: (tune.Awake) => void,
  size: (string) => i64,
  part: (string, i64, i32) => u8[],
  read: (string) => u8[],
  open: (i32, i32) => tune.Sound,
  start: (tune.Sound) => void,
  pause: (tune.Sound) => void,
  flush: (tune.Sound) => void,
  close: (tune.Sound) => void,
  write: (tune.Sound, [i32]) => i32,
}

// The samples that the player keeps ready, as a part of a second.
const READY_PARTS: i32 = 5;

// The player on a device: the state of tune.fern, and the deck that reads
// the file of the track that plays. Only one owner uses a deck, so it is
// not in the state.
pub struct Player { model: tune.Model, deck: Option[engine.Deck] }

// A player with the state `model` and no deck.
pub function wrap(own model: tune.Model): Player {
  return Player { model: model, deck: None };
}

function loaded(dev: Device, own m: tune.Model, i: i32): Player {
  dev.close(m.sound);
  let file = dev.read(m.tracks[i].path);
  let picture = tags.picture(file);
  if (picture.len() == 0) {
    picture = folder_picture(dev, m, m.tracks[i].path);
  }
  let art: Option[draw.Image] = None;
  if (picture.len() > 0) {
    art = dev.decode(picture, ART, ART);
  }
  let Some(deck) = engine.open(file) else {
    return wrap(tune.update(tune.Model { ...m, sound: tune.no_sound(), pending: [] }, tune.Failed("Tune cannot play " + m.tracks[i].title)));
  };
  let sound = dev.open(deck.rate, deck.channels);
  if (sound.ptr == 0 as usize) {
    return wrap(tune.update(tune.Model { ...m, sound: sound, pending: [] }, tune.Failed("The phone gave no sound")));
  }
  dev.start(sound);
  let length = deck.duration_ms();
  return Player { model: tune.Model { ...m, sound: sound, pending: [], at_ms: 0i64, length_ms: length, art: art }, deck: Some(deck) };
}

function sought(dev: Device, own m: tune.Model, own deck: Option[engine.Deck], part: f64): Player {
  let Some(d) = deck else {
    return wrap(m);
  };
  dev.pause(m.sound);
  dev.flush(m.sound);
  if (m.playing) {
    dev.start(m.sound);
  }
  let moved = d.seek(part);
  let at = moved.position_ms();
  return Player { model: tune.Model { ...m, pending: [], at_ms: at, told: "" }, deck: Some(moved) };
}

// The player after the device did `want`.
function done(dev: Device, own p: Player, want: tune.Want): Player {
  let Player { model: m, deck } = p;
  match (want) {
    tune.Load(i) => {
      return loaded(dev, m, i);
    },
    tune.Resume => {
      dev.start(m.sound);
      return Player { model: m, deck: deck };
    },
    tune.Hold => {
      dev.pause(m.sound);
      return Player { model: m, deck: deck };
    },
    tune.Seek(part) => {
      return sought(dev, m, deck, part);
    },
    tune.Scan => {
      if (m.folder.len() > 0) {
        let folder = [m.folder];
        return Player { model: tune.update(m, tune.Files(folder)), deck: deck };
      }
      return Player { model: tune.update(m, tune.Files(dev.roots)), deck: deck };
    },
    tune.List(dir) => {
      return Player { model: tune.update(m, tune.Dirs(dir, dev.dirs(dir))), deck: deck };
    },
    tune.Keep(folder) => {
      dev.keep(folder);
      return Player { model: m, deck: deck };
    },
    tune.Grant => {
      dev.grant();
      return Player { model: m, deck: deck };
    }
  }
}

// The side in pixels of the picture of an album in a list, and of the
// picture of the track that plays.
const THUMB: i32 = 112;

const ART: i32 = 720;

// The directory of a path.
function dir_of(path: string): string {
  let cut = path.len();
  for i in 0..path.len() {
    if (path[i] == b'/') {
      cut = i;
    }
  }
  return path.take(cut).to_owned();
}

// The bytes of the image file of the directory of `path`, or no bytes.
function folder_picture(dev: Device, m: tune.Model, path: string): u8[] {
  let dir = dir_of(path);
  for p in m.pictures {
    if (dir_of(p) == dir) {
      return dev.read(p);
    }
  }
  return [];
}

// The player with the picture of the album of the key `key`, from the
// file `path` of that album or from an image file of its directory. An
// album gets its picture one time.
function covered(dev: Device, own m: tune.Model, key: string, path: string): tune.Model {
  if (tune.knows_cover(m, key)) {
    return m;
  }
  let bytes = library.picture(dev.size(path), (at: i64, n: i32): u8[] => dev.part(path, at, n));
  if (bytes.len() == 0) {
    bytes = folder_picture(dev, m, path);
  }
  if (bytes.len() == 0) {
    return tune.with_cover(m, key, None);
  }
  return tune.with_cover(m, key, dev.decode(bytes, THUMB, THUMB));
}

// Reads the next path of the library. A file of sound is a track, and its
// album gets its picture. A directory gives its entries to the scan. Each
// other path adds nothing.
function scanned(dev: Device, own m: tune.Model): tune.Model {
  let path = m.scan[0];
  let left: string[] = [];
  for i in 1..m.scan.len() {
    left = left.append(m.scan[i]);
  }
  let roots = dev.roots;
  if (m.folder.len() > 0) {
    roots = [m.folder];
  }
  let next = tune.Model { ...m, scan: left };
  if (library.format_of(path).len() > 0) {
    if let Some(t) = library.track(roots, path, dev.size(path), (at: i64, n: i32): u8[] => dev.part(path, at, n)) {
      return covered(dev, tune.update(next, tune.Found(t)), tune.album_key(t.by, t.album), path);
    }
    return next;
  }
  if (library.other_file(path) || path.len() > 1024 || !dev.is_dir(path)) {
    return next;
  }
  return listed(dev, next, path);
}

// The player with the entries of the directory `path` in its scan. An
// image file with the name of a picture of an album goes to `pictures`,
// and an entry whose name starts with a dot goes nowhere.
function listed(dev: Device, own m: tune.Model, path: string): tune.Model {
  let below: string[] = [];
  let pictures = m.pictures;
  for name in cmp.sort(dev.names(path)) {
    if (library.picture_name(name)) {
      pictures = pictures.append(path + "/" + name);
    } else if (!name.starts_with(".")) {
      below = below.append(path + "/" + name);
    }
  }
  return tune.update(tune.Model { ...m, pictures: pictures }, tune.Files(below));
}

// The milliseconds of one step that the scan can use.
const SCAN_MS: i64 = 8i64;

// Reads paths of the library until the time `until`, in ns: one or more.
// A library with no file of sound gets the tunes of the player one time.
function scanned_until(dev: Device, own m: tune.Model, until: i64): tune.Model {
  let state = scanned(dev, m);
  while (state.scan.len() > 0 && dev.now() < until) {
    state = scanned(dev, state);
  }
  if (state.scan.len() == 0 && state.tracks.len() == 0 && state.folder.len() == 0 && !state.made) {
    let made = dev.demo();
    return tune.update(tune.Model { ...state, made: true }, tune.Files(made));
  }
  return state;
}

// The samples of `all` from the sample `from`.
function rest(all: i32[], from: i32): i32[] {
  if (from <= 0) {
    return all;
  }
  let out: i32[] = [];
  for i in from..all.len() {
    out = out.append(all[i]);
  }
  return out;
}

// The deck after it gave parts until `ready` has `enough` samples or the
// file ends, and those samples.
function filled(own deck: engine.Deck, ready: i32[], enough: i32): (engine.Deck, i32[]) {
  let d = deck;
  let out = ready;
  while (out.len() < enough && !d.done) {
    let (next, part) = d.pull();
    d = next;
    for v in part {
      out = out.append(v);
    }
  }
  return (d, out);
}

// While a track plays: reads the file until the player has enough samples
// ready, gives the sound what it takes, and tells the time of the track.
function pumped(dev: Device, own m: tune.Model, own deck: Option[engine.Deck]): Player {
  if (!m.playing) {
    return Player { model: m, deck: deck };
  }
  let Some(first) = deck else {
    return wrap(m);
  };
  let sound = m.sound;
  let (d, ready) = filled(first, m.pending, sound.rate * sound.channels / READY_PARTS);
  let kept = rest(ready, dev.write(sound, ready));
  let waiting = kept.len() as i64 * 1000i64 / ((sound.rate * sound.channels).max(1) as i64);
  let at = (d.position_ms() - waiting).max(0i64);
  let length = d.duration_ms();
  let ended = d.done && kept.len() == 0;
  let after = tune.Model { ...m, pending: kept, at_ms: at, length_ms: length };
  if (ended) {
    return Player { model: tune.update(after, tune.Finished), deck: Some(d) };
  }
  return Player { model: after, deck: Some(d) };
}

// The player after it read paths of the library until the time `until`,
// and after the sound got its next samples.
function settled(dev: Device, own p: Player, until: i64): Player {
  let Player { model, deck } = p;
  let m = model;
  if (m.scan.len() > 0) {
    m = scanned_until(dev, m, until);
  }
  return pumped(dev, m, deck);
}

// The player after the device did each thing that the state wants.
function turn(dev: Device, own p: Player, until: i64): Player {
  let Player { model: asked, deck: held } = p;
  let wants = asked.wants;
  let state = Player { model: tune.Model { ...asked, wants: [] }, deck: held };
  for want in wants {
    state = done(dev, state, want);
  }
  return settled(dev, state, until);
}

// The player after the device did what the state wants. A thing that the
// device did can make the state want one more thing.
function run(dev: Device, own p: Player): Player {
  let until = dev.now() + SCAN_MS * 1000000i64;
  let state = turn(dev, p, until);
  let turns = 1;
  while (turns < 4 && state.model.wants.len() > 0) {
    state = turn(dev, state, until);
    turns += 1;
  }
  return state;
}

// Tells Android the track and the state of the player when one of them is
// new, and keeps the phone awake while a track plays.
function shown(dev: Device, own m: tune.Model): tune.Model {
  let key = m.current.to_string() + "|" + m.playing.to_string();
  if (key == m.told || m.current < 0) {
    return m;
  }
  let t = m.tracks[m.current];
  dev.show(tune.Now { title: t.title, artist: t.artist, album: t.album, length_ms: m.length_ms, at_ms: m.at_ms, playing: m.playing });
  let awake = m.awake;
  if (m.playing && awake.wake == 0 as usize) {
    awake = dev.wake();
  } else if (!m.playing && awake.wake != 0 as usize) {
    dev.sleep(awake);
    awake = tune.Awake { wake: 0 as usize, wifi: 0 as usize };
  }
  return tune.Model { ...m, told: key, awake: awake };
}

// The player after the message `msg`: `tune.update` gives the next state,
// and then the device does what that state wants.
function stepped(dev: Device, own p: Player, msg: tune.Msg): Player {
  let Player { model, deck } = p;
  let Player { model: after, deck: held } = run(dev, Player { model: tune.update(model, msg), deck: deck });
  return Player { model: shown(dev, after), deck: held };
}

pub function program(dev: Device): ui.Program[Player, tune.Msg] {
  return ui.program((p: Player, s: ui.Screen): ui.El[tune.Msg] => tune.view(p.model, s), (own p: Player, msg: tune.Msg): Player => stepped(dev, p, msg)).with_tick((p: Player): i32 => tune.beat(p.model), tune.Beat).with_back((p: Player): Option[tune.Msg] => tune.back(p.model));
}
