// The decoder of the player: it reads a WAV, a FLAC, an MP3, an M4A, an Ogg
// Vorbis or an Opus file that is
// in memory, and gives its sound a part at a time as 16-bit samples. It has
// no Android code, so engine_test.fern runs it on the host.
import "std/audio/aac";
import "std/audio/aac/config" as aac_config;
import "std/audio/flac";
import "std/audio/linear";
import "std/audio/mp3";
import "std/audio/mp4";
import "std/audio/mp4/tables";
import "std/audio/opusfile";
import "std/audio/pcm";
import "std/audio/tempo";
import "std/audio/vorbisfile";
import "std/audio/vorbisfile/seek" as vorbis_seek;
import "std/audio/wav";
import "std/f64";
import "std/i32";
import "std/i64";
import "std/option";
import "std/result";

pub const WAV: i32 = 0;

pub const FLAC: i32 = 1;

pub const MP3: i32 = 2;

pub const M4A: i32 = 3;

pub const VORBIS: i32 = 4;

pub const OPUS: i32 = 5;

// The frames of one part of a WAV file.
const WAV_PART: i32 = 4096;

// A file that plays. `at` is the frame that the next part starts at, and
// `total` is the number of frames of samples, or 0 when the file does not
// tell. `bytes` is a window of the file from the byte `base`, of at most
// `window` bytes, and `source` reads more of the file, which has `size`
// bytes. A WAV file has its samples from the byte `data`, in `pcm`.
// `offset` is the byte that the next FLAC or MP3 frame starts at, between
// `first` and `last`. `done` tells that the file has no more sound. `codec`
// is the decoder of an M4A, an Ogg Vorbis or an Opus file.
pub struct Deck {
  kind: i32,
  bytes: u8[],
  base: i32,
  size: i32,
  window: i32,
  source: (i64, i32) => u8[],
  data: i32,
  pcm: linear.Format,
  rate: i32,
  channels: i32,
  bits: i32,
  total: i64,
  at: i64,
  offset: i32,
  first: i32,
  last: i32,
  block: i32,
  stream: Option[flac.Header],
  layer3: mp3.Decoder,
  done: boolean,
  codec: Codec,
}

// The decoder of an M4A file: its AAC decoder, the configuration that
// makes a new one, and the place of each packet in the file.
pub struct Aac { decoder: aac.Decoder, config: aac_config.Config, packets: tables.Packet[] }

// The decoder that a deck owns, for a format whose decoder only one owner
// can use.
pub enum Codec { Plain, Packets(Aac), Vorbis(vorbis_seek.Cursor), Opus(opusfile.SeekCursor) }

// The frames of samples of one AAC packet.
const AAC_FRAMES: i64 = 1024i64;

function limits(): pcm.Limits {
  return pcm.Limits { max_input_bytes: 1073741824, max_samples: 1048576 };
}

function starts_with(bytes: [u8], tag: string): boolean {
  if (bytes.len() < tag.len()) {
    return false;
  }
  for i in 0..tag.len() {
    if (bytes[i] != tag[i]) {
      return false;
    }
  }
  return true;
}

// The bytes of the window of a deck when the program gives no size.
pub const WINDOW: i32 = 524288;

// The bytes that the start of a file has at first: the tags and the
// headers grow it when they are longer.
const HEAD: i32 = 262144;

// A source that reads the bytes `bytes`.
function source_of(bytes: u8[]): (i64, i32) => u8[] {
  return (at: i64, n: i32): u8[] => {
    let out: u8[] = [];
    let from = at as i32;
    for i in from..(from + n).min(bytes.len()) {
      out = out.append(bytes[i]);
    }
    return out;
  };
}

function blank(kind: i32, bytes: u8[]): Deck {
  let n = bytes.len();
  return Deck { kind: kind, bytes: bytes, base: 0, size: n, window: n, source: source_of([]), data: 0, pcm: linear.Format { sample_rate: 0, channels: 0, bits: 0, storage_bits: 0, little_endian: true, kind: linear.Signed }, rate: 0, channels: 0, bits: 16, total: 0i64, at: 0i64, offset: 0, first: 0, last: 0, block: 0, stream: None, layer3: mp3.decoder(), done: false, codec: Plain };
}

// The deck of a WAV file of `size` bytes whose start is `head`.
function open_wav(head: u8[], size: i32): Option[Deck] {
  let Ok(l) = wav.inspect_start(head, size as i64, limits()) else {
    return None;
  };
  let stride = l.format.channels * (l.format.storage_bits / 8);
  if (stride <= 0 || l.format.kind == linear.Float) {
    return None;
  }
  return Some(Deck { ...blank(WAV, head), size: size, rate: l.format.sample_rate, channels: l.format.channels, bits: l.format.bits, total: (l.data_bytes / stride) as i64, data: l.data_offset, pcm: l.format });
}

function open_flac(head: u8[], size: i32): Option[Deck] {
  let Ok(h) = flac.inspect(head, limits()) else {
    return None;
  };
  return Some(Deck { ...blank(FLAC, head), size: size, rate: h.format.sample_rate, channels: h.format.channels, bits: h.format.bits_per_sample, total: h.frames as i64, offset: h.data_offset, first: h.data_offset, last: size, block: h.min_block, stream: Some(h) });
}

// The deck of an MP3 file of `size` bytes whose start is `head`. The sound
// ends at the byte `end`, or where the head ends when `end` is -1.
function open_mp3(head: u8[], size: i32, end: i32): Option[Deck] {
  let Ok(t) = mp3.inspect_track(head, limits()) else {
    return None;
  };
  let Ok(h) = mp3.inspect(head, t.data_offset, limits()) else {
    return None;
  };
  let last = t.data_end;
  if (end >= 0) {
    last = end;
  }
  return Some(Deck { ...blank(MP3, head), size: size, rate: t.sample_rate, channels: t.channels, total: t.declared_frames as i64 * (h.frames as i64), offset: t.data_offset, first: t.data_offset, last: last });
}

function open_m4a(bytes: u8[]): Option[Deck] {
  let Ok(index) = mp4.inspect(bytes, mp4.default_limits()) else {
    return None;
  };
  for track in index.tracks {
    if (track.enabled && track.configurations.len() > 0 && track.packets.len() > 0) {
      let config = track.configurations[0];
      let Ok(decoder) = aac.create(config, limits()) else {
        return None;
      };
      let total = track.packets.len() as i64 * AAC_FRAMES;
      return Some(Deck { ...blank(M4A, bytes), rate: config.sample_rate, channels: config.channels, total: total, codec: Packets(Aac { decoder: decoder, config: config, packets: track.packets }) });
    }
  }
  return None;
}

// The bytes of one file that an index of an Ogg file can have.
const OGG_BYTES: i32 = 1073741824;

function open_vorbis(bytes: u8[]): Option[Deck] {
  let Ok(index) = vorbis_seek.inspect(bytes, vorbis_seek.Limits { ...vorbis_seek.default_limits(), max_input_bytes: OGG_BYTES }) else {
    return None;
  };
  if (index.links().len() == 0) {
    return None;
  }
  let link = index.links()[0];
  let info = link.info.audio;
  return Some(Deck { ...blank(VORBIS, bytes), rate: info.sample_rate, channels: info.channels, total: link.frames, codec: Vorbis(vorbis_seek.cursor(index)) });
}

function open_opus(bytes: u8[]): Option[Deck] {
  let Ok(index) = opusfile.inspect_seek(bytes, opusfile.SeekLimits { ...opusfile.default_seek_limits(), max_input_bytes: OGG_BYTES }) else {
    return None;
  };
  if (index.tracks.len() == 0) {
    return None;
  }
  let track = index.tracks[0];
  return Some(Deck { ...blank(OPUS, bytes), rate: 48000, channels: track.info.header.channels, total: track.frames, codec: Opus(opusfile.seek_reader(index)) });
}

// An Ogg file has Vorbis sound or Opus sound: its first packet starts at
// the byte 28 with the name of its codec.
function open_ogg(bytes: u8[]): Option[Deck] {
  if (bytes.len() > 36 && bytes[28] == 79u8 && bytes[29] == 112u8 && bytes[30] == 117u8 && bytes[31] == 115u8) {
    return open_opus(bytes);
  }
  return open_vorbis(bytes);
}

// The deck of the format that the first bytes of the file show. A file
// that starts as no other format is an MP3 file.
function opened(bytes: u8[]): Option[Deck] {
  let n = bytes.len();
  if (starts_with(bytes, "RIFF")) {
    return open_wav(bytes, n);
  }
  if (starts_with(bytes, "fLaC")) {
    return open_flac(bytes, n);
  }
  if (starts_with(bytes, "OggS")) {
    return open_ogg(bytes);
  }
  if (whole_file(bytes)) {
    return open_m4a(bytes);
  }
  return open_mp3(bytes, n, -1);
}

// An M4A file: its index needs the whole file, as that of an Ogg file does.
function whole_file(head: [u8]): boolean {
  return head.len() >= 12 && head[4] == b'f' && head[5] == b't' && head[6] == b'y' && head[7] == b'p' || starts_with(head, "OggS");
}

// The deck, when it has a rate and one or two channels.
function checked(deck: Option[Deck]): Option[Deck] {
  if let Some(d) = deck {
    if (d.rate > 0 && d.channels >= 1 && d.channels <= 2) {
      return Some(d);
    }
  }
  return None;
}

// A deck for the file `bytes`, or None when it is not a file that the
// player reads. A deck has one or two channels.
pub function open(bytes: u8[]): Option[Deck] {
  return checked(opened(bytes));
}

// The start of a file of `size` bytes from `source`, grown four times at a
// time until `parses` takes it or it is the whole file.
function grown(head: u8[], size: i32, source: (i64, i32) => u8[], parses: (u8[]) => boolean): u8[] {
  let h = head;
  while (!parses(h) && h.len() < size) {
    h = source(0i64, (h.len() * 4).max(HEAD).min(size));
  }
  return h;
}

// The sound ends before an ID3v1 tag: the last 128 bytes, from `TAG`.
function mp3_end(size: i32, source: (i64, i32) => u8[]): i32 {
  if (size >= 128 && starts_with(source((size - 128) as i64, 3), "TAG")) {
    return size - 128;
  }
  return size;
}

// The deck of a WAV, a FLAC or an MP3 file whose start is `head`.
function streamed(head: u8[], n: i32, source: (i64, i32) => u8[]): Option[Deck] {
  if (starts_with(head, "RIFF")) {
    return open_wav(grown(head, n, source, (h: u8[]): boolean => wav.inspect_start(h, n as i64, limits()).is_ok()), n);
  }
  if (starts_with(head, "fLaC")) {
    return open_flac(grown(head, n, source, (h: u8[]): boolean => flac.inspect(h, limits()).is_ok()), n);
  }
  return open_mp3(grown(head, n, source, (h: u8[]): boolean => mp3.inspect_track(h, limits()).is_ok()), n, mp3_end(n, source));
}

// A deck for a file of `size` bytes that `source` reads a part at a time,
// at most `window` bytes at a time. A WAV, a FLAC or an MP3 file plays
// from a window of the file. An M4A or an Ogg file is read whole. The
// bytes of the deck are the start of the file when it opens.
pub function open_file(size: i64, source: (i64, i32) => u8[], window: i32): Option[Deck] {
  if (size <= 0i64 || size > 2147483647i64 || window < 4096) {
    return None;
  }
  let n = size as i32;
  let head = source(0i64, HEAD.min(n));
  if (whole_file(head)) {
    return open(source(0i64, n));
  }
  let Some(d) = checked(streamed(head, n, source)) else {
    return None;
  };
  return Some(Deck { ...d, source: source, window: window });
}

// The deck with the bytes of the file from `at` to `at + need` in its
// window, or with the rest of the file when the file ends before. A start
// of the file that is longer than a window, for long tags, goes at the
// first read.
function windowed(own d: Deck, at: i32, need: i32): Deck {
  let end = d.base + d.bytes.len();
  if (at >= d.base && d.bytes.len() <= d.window && (at + need <= end || end >= d.size)) {
    return d;
  }
  let read = d.source;
  let bytes = read(at as i64, d.window.max(need).min(d.size - at).max(0));
  return Deck { ...d, bytes: bytes, base: at };
}

// The samples at 16 bits, from samples of `bits` bits.
function to_16(samples: i32[], bits: i32): i32[] {
  if (bits == 16) {
    return samples;
  }
  let out: i32[] = [];
  for v in samples {
    if (bits > 16) {
      out = out.append(v >> bits - 16);
    } else {
      out = out.append(v << 16 - bits);
    }
  }
  return out;
}

function from_floats(samples: f32[]): i32[] {
  let out: i32[] = [];
  for v in samples {
    out = out.append(((v as f64).max(-1.0).min(1.0) * 32767.0) as i32);
  }
  return out;
}

function ended(own d: Deck): (Deck, i32[]) {
  return (Deck { ...d, done: true }, []);
}

function pull_wav(own d: Deck): (Deck, i32[]) {
  let left = d.total - d.at;
  if (left <= 0i64) {
    return ended(d);
  }
  let stride = d.pcm.channels * (d.pcm.storage_bits / 8);
  let frames = WAV_PART.min(left as i32);
  let from = d.data + d.at as i32 * stride;
  let w = windowed(d, from, frames * stride);
  let rel = from - w.base;
  let have = ((w.bytes.len() - rel) / stride).min(frames);
  if (have <= 0) {
    return ended(w);
  }
  let part = w.bytes[rel:rel + have * stride];
  let Ok(index) = linear.create(part, 0, have * stride, w.pcm, limits()) else {
    return ended(w);
  };
  let Ok(block) = index.read_integer(part, 0, have, limits()) else {
    return ended(w);
  };
  let bits = w.bits;
  let at = w.at + have as i64;
  return (Deck { ...w, at: at }, to_16(block.samples, bits));
}

function pull_flac(own d: Deck): (Deck, i32[]) {
  let Some(h) = d.stream else {
    return ended(d);
  };
  if (d.offset >= d.last) {
    return ended(d);
  }
  let (offset0, need) = (d.offset, d.window / 2);
  let w = windowed(d, offset0, need);
  let Ok(frame) = flac.decode_frame(w.bytes, w.offset - w.base, h, limits()) else {
    return ended(w);
  };
  let bits = w.bits;
  let offset = w.offset + frame.bytes_read;
  let at = w.at + frame.frames as i64;
  return (Deck { ...w, at: at, offset: offset }, to_16(frame.samples, bits));
}

// The byte at or after `from` that an MP3 frame starts at, with a frame
// after it too, or -1.
function next_mp3(bytes: [u8], from: i32, last: i32): i32 {
  let i = from;
  while (i + 4 <= last && i < from + 65536) {
    if (bytes[i] == 255u8) {
      if let Ok(h) = mp3.inspect(bytes, i, limits()) {
        if (i + h.bytes + 4 > last || mp3.inspect(bytes, i + h.bytes, limits()).is_ok()) {
          return i;
        }
      }
    }
    i += 1;
  }
  return -1;
}

// The bytes after the place of a search where `next_mp3` stops.
const MP3_SEARCH: i32 = 65540;

function pull_mp3(own d: Deck): (Deck, i32[]) {
  let (offset0, need) = (d.offset, d.window / 2);
  let w = windowed(d, offset0, need);
  let end = w.last.min(w.base + w.bytes.len());
  let rel = next_mp3(w.bytes, w.offset - w.base, end - w.base);
  if (rel < 0) {
    // The window ends before the search does: the search goes on in the
    // next window.
    if (end < w.last && end - w.offset < MP3_SEARCH) {
      let o = (end - 4).max(w.offset + 1);
      return (Deck { ...w, offset: o }, []);
    }
    return ended(w);
  }
  let start = rel + w.base;
  let (layer3, got) = mp3.Decoder { ...w.layer3 }.decode_frame(w.bytes, rel, limits());
  let Ok(frame) = got else {
    return (Deck { ...w, layer3: layer3, offset: start + 1 }, []);
  };
  let at = w.at + frame.frames as i64;
  return (Deck { ...w, layer3: layer3, at: at, offset: start + frame.bytes_read }, from_floats(frame.samples));
}

// The deck with no decoder, and the decoder that it had.
function parted(own d: Deck): (Deck, Codec) {
  let Deck { kind, bytes, base, size, window, source, data, pcm, rate, channels, bits, total, at, offset, first, last, block, stream, layer3, done, codec } = d;
  return (Deck { kind: kind, bytes: bytes, base: base, size: size, window: window, source: source, data: data, pcm: pcm, rate: rate, channels: channels, bits: bits, total: total, at: at, offset: offset, first: first, last: last, block: block, stream: stream, layer3: layer3, done: done, codec: Plain }, codec);
}

// The next packet of an M4A file: 1024 frames of samples.
function pull_m4a(own d: Deck): (Deck, i32[]) {
  let (rest, codec) = parted(d);
  let Packets(a) = codec else {
    return ended(rest);
  };
  let Aac { decoder, config, packets } = a;
  let n = (rest.at / AAC_FRAMES) as i32;
  if (n >= packets.len()) {
    return ended(rest);
  }
  let from = packets[n].offset as i32;
  let Ok((next, frame)) = decoder.decode_packet(rest.bytes[from:from + packets[n].bytes], limits()) else {
    return ended(rest);
  };
  let at = (n + 1) as i64 * AAC_FRAMES;
  return (Deck { ...rest, at: at, codec: Packets(Aac { decoder: next, config: config, packets: packets }) }, from_floats(frame.samples));
}

// The deck at the packet of an M4A file that has `part` of the file, with
// a new decoder: a decoder keeps a part of the packet before.
function seek_m4a(own d: Deck, part: f64): Deck {
  let (rest, codec) = parted(d);
  let Packets(a) = codec else {
    return rest;
  };
  let Aac { decoder: _, config, packets } = a;
  let Ok(fresh) = aac.create(config, limits()) else {
    return Deck { ...rest, done: true };
  };
  let n = (part * (packets.len() as f64)) as i32;
  return Deck { ...rest, at: n as i64 * AAC_FRAMES, done: false, codec: Packets(Aac { decoder: fresh, config: config, packets: packets }) };
}

// The next packet of an Ogg file with Vorbis or Opus sound.
function pull_ogg(own d: Deck): (Deck, i32[]) {
  let (rest, codec) = parted(d);
  match (codec) {
    Vorbis(cursor) => {
      let Ok((next, Some(audio))) = cursor.next(rest.bytes) else {
        return ended(rest);
      };
      return (Deck { ...rest, at: audio.position + audio.frames as i64, codec: Vorbis(next) }, from_floats(audio.samples));
    },
    Opus(cursor) => {
      let Ok((next, Some(audio))) = cursor.next(rest.bytes) else {
        return ended(rest);
      };
      return (Deck { ...rest, at: audio.position + audio.frames as i64, codec: Opus(next) }, from_floats(audio.samples));
    },
    _ => {
      return ended(rest);
    }
  }
}

// The deck at `part` of an Ogg file. A deck that cannot go there is done.
function seek_ogg(own d: Deck, part: f64): Deck {
  let (rest, codec) = parted(d);
  let to = (part * (rest.total as f64)) as i64;
  match (codec) {
    Vorbis(cursor) => {
      let Ok(next) = cursor.seek(0, to) else {
        return Deck { ...rest, done: true };
      };
      return Deck { ...rest, at: to, done: false, codec: Vorbis(next) };
    },
    Opus(cursor) => {
      let Ok(next) = cursor.seek(0, to) else {
        return Deck { ...rest, done: true };
      };
      return Deck { ...rest, at: to, done: false, codec: Opus(next) };
    },
    _ => {
      return rest;
    }
  }
}

// The deck after its next part, and the samples of that part: the samples
// of a frame are one after the other. At the end of the file, the deck is
// done and the part is empty. A part of an MP3 file can be empty before the
// end.
pub function (own d: Deck) pull(): (Deck, i32[]) {
  if (d.done) {
    return (d, []);
  }
  if (d.kind == WAV) {
    return pull_wav(d);
  }
  if (d.kind == FLAC) {
    return pull_flac(d);
  }
  if (d.kind == M4A) {
    return pull_m4a(d);
  }
  if (d.kind == VORBIS || d.kind == OPUS) {
    return pull_ogg(d);
  }
  return pull_mp3(d);
}

// The frame that a FLAC frame at byte `i` starts at, or -1 when no frame
// starts there.
function flac_frame_at(d: Deck, h: flac.Header, i: i32): i64 {
  let rel = i - d.base;
  if (rel < 0 || rel + 1 >= d.bytes.len() || d.bytes[rel] != 255u8 || (d.bytes[rel + 1] & 254u8) != 248u8) {
    return -1i64;
  }
  let Ok(frame) = flac.decode_frame(d.bytes, rel, h, limits()) else {
    return -1i64;
  };
  if (frame.variable) {
    return frame.number as i64;
  }
  return frame.number as i64 * (d.block as i64);
}

// The deck at the first FLAC frame at or after the byte `i`. It reads one
// window at a time, and a frame starts before the last half of a window.
function flac_found(own d: Deck, h: flac.Header, i: i32): Deck {
  let need = d.window / 2;
  let w = windowed(d, i, need);
  let limit = w.last;
  if (w.base + w.bytes.len() < w.size) {
    limit = w.base + w.bytes.len() - need;
  }
  let j = i;
  while (j + 2 <= w.last && j < limit) {
    let at = flac_frame_at(w, h, j);
    if (at >= 0i64) {
      return Deck { ...w, at: at, offset: j, done: false };
    }
    j += 1;
  }
  if (j + 2 > w.last) {
    return Deck { ...w, done: true };
  }
  return flac_found(w, h, j);
}

function seek_flac(own d: Deck, part: f64): Deck {
  let Some(h) = d.stream else {
    return d;
  };
  let i = d.first + (part * ((d.last - d.first) as f64)) as i32;
  return flac_found(d, h, i);
}

function seek_mp3(own d: Deck, part: f64): Deck {
  let from = d.first + (part * ((d.last - d.first) as f64)) as i32;
  let at = (part * (d.total as f64)) as i64;
  return Deck { ...d, layer3: mp3.decoder(), at: at, offset: from, done: false };
}

// The deck at `part` of the file, from 0 to 1. A FLAC or an MP3 file
// starts at the frame that is nearest after that part.
pub function (own d: Deck) seek(part: f64): Deck {
  let to = part.max(0.0).min(1.0);
  if (d.kind == WAV) {
    let at = (to * (d.total as f64)) as i64;
    return Deck { ...d, at: at, done: false };
  }
  if (d.kind == FLAC) {
    return seek_flac(d, to);
  }
  if (d.kind == M4A) {
    return seek_m4a(d, to);
  }
  if (d.kind == VORBIS || d.kind == OPUS) {
    return seek_ogg(d, to);
  }
  return seek_mp3(d, to);
}

// The time of the next part, in ms.
pub function (d: Deck) position_ms(): i64 {
  return d.at * 1000i64 / (d.rate as i64);
}

// The length of the file in ms. An MP3 file that does not tell its length
// gives the length that its bytes so far imply, or 0 at its start.
pub function (d: Deck) duration_ms(): i64 {
  if (d.total > 0i64) {
    return d.total * 1000i64 / (d.rate as i64);
  }
  if (d.offset <= d.first) {
    return 0i64;
  }
  return d.position_ms() * ((d.last - d.first) as i64) / ((d.offset - d.first) as i64);
}

// A deck with the speed and the pitch that its sound plays at.
pub struct Voice { deck: Deck, tempo: tempo.Tempo, reader: tempo.Resampler }

pub function voice(own d: Deck): Voice {
  let (rate, channels) = (d.rate, d.channels);
  return Voice { deck: d, tempo: tempo.new(rate, channels), reader: tempo.resampler(channels) };
}

// The next part of the sound at the speed `speed`, where 1 is the speed of
// the file, `pitch` semitones above the pitch of the file.
pub function (own v: Voice) pull(speed: f64, pitch: i32): (Voice, i32[]) {
  let Voice { deck, tempo: stretch, reader } = v;
  let (d, raw) = deck.pull();
  let step = (pitch as f64 / 12.0).exp2();
  let (s, part) = stretch.at(speed / step).push(raw);
  let out = part;
  let after = s;
  if (d.done) {
    let (flushed, tail) = after.flush();
    after = flushed;
    for x in tail {
      out = out.append(x);
    }
  }
  if (pitch == 0) {
    return (Voice { deck: d, tempo: after, reader: reader }, out);
  }
  let (r, read) = reader.push(out, step);
  return (Voice { deck: d, tempo: after, reader: r }, read);
}

// The voice at the part `part` of its file, from 0 to 1.
pub function (own v: Voice) seek(part: f64): Voice {
  let Voice { deck, tempo: stretch, reader } = v;
  let (cleared, dropped) = stretch.flush();
  let channels = deck.channels;
  return Voice { deck: deck.seek(part), tempo: cleared, reader: tempo.resampler(channels) };
}
