// A music player with no Java code of its own. NativeActivity loads this
// library and calls ANativeActivity_onCreate. std/android/ui/app runs the
// program of tune.fern, and player.fern plays its tracks through
// std/android/audio.
import "std/android";
import "std/android/audio";
import "std/android/ui/app";
import "std/log";
import "std/result";
import "./library";
import "./player";
import "./tune";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function read(path: string): u8[] {
  return read_file_bytes(path).unwrap_or([]);
}

function stream(s: tune.Sound): audio.Music {
  return audio.Music { ptr: s.ptr, rate: s.rate, channels: s.channels };
}

function open(rate: i32, channels: i32): tune.Sound {
  let m = audio.music(rate, channels);
  if (m.ptr != 0 as usize && m.rate != rate) {
    // The engine gives samples at the rate of the file only.
    m.close();
    return tune.no_sound();
  }
  return tune.Sound { ptr: m.ptr, rate: m.rate, channels: m.channels };
}

function device(): player.Device {
  return player.Device {
    read: (path: string): u8[] => read(path),
    open: (rate: i32, channels: i32): tune.Sound => open(rate, channels),
    start: (s: tune.Sound): void => { let started = stream(s).start(); },
    pause: (s: tune.Sound): void => stream(s).pause(),
    flush: (s: tune.Sound): void => stream(s).flush(),
    close: (s: tune.Sound): void => stream(s).close(),
    write: (s: tune.Sound, samples: [i32]): i32 => stream(s).write(samples, 0),
  };
}

// The tracks of the directory of the app. The player makes its three tunes
// there when the directory has no track.
function library_of(dir: string): tune.Track[] {
  let made = create_dir_all(dir);
  let found = library.tracks(dir, read_dir(dir).unwrap_or([]), read);
  if (found.len() > 0) {
    return found;
  }
  for which in 0..3 {
    if let Ok(file) = library.demo_file(which) {
      let written = write_file_bytes(dir + "/" + library.demo_name(which), file);
    }
  }
  return library.tracks(dir, read_dir(dir).unwrap_or([]), read);
}

function app_main(ctx: usize): usize {
  let tracks = library_of(android.data_dir(ctx) + "/music");
  log.info("tune: " + tracks.len().to_string() + " tracks");
  let last = app.run(ctx, tune.start(tracks), player.program(device()));
  device().close(last.sound);
  log.info("tune: closed at track " + last.current.to_string() + ", " + tune.clock(last.at_ms) + " of " + tune.clock(last.length_ms) + ", playing " + last.playing.to_string());
  return 0 as usize;
}
