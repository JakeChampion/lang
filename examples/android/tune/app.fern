// A music player with no Java code of its own. NativeActivity loads this
// library and calls ANativeActivity_onCreate. std/android/ui/app runs the
// program of tune.fern, and player.fern plays its tracks through
// std/android/audio.
import "core/cmp";
import "std/android";
import "std/android/audio";
import "std/android/service";
import "std/android/session";
import "std/android/ui/app";
import "std/log";
import "std/result";
import "./library";
import "./player";
import "./tune";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

// The callback of the media session: each media button of Android gives
// the loop a command.
@jni("dev.fern.tune.Controls extends android.media.session.MediaSession$Callback", "void onPlay()")
pub function controls_play(env: usize, thiz: usize): void {
  session.play(env);
}

@jni("dev.fern.tune.Controls", "void onPause()")
pub function controls_pause(env: usize, thiz: usize): void {
  session.pause(env);
}

@jni("dev.fern.tune.Controls", "void onSkipToNext()")
pub function controls_next(env: usize, thiz: usize): void {
  session.next(env);
}

@jni("dev.fern.tune.Controls", "void onSkipToPrevious()")
pub function controls_previous(env: usize, thiz: usize): void {
  session.previous(env);
}

@jni("dev.fern.tune.Controls", "void onStop()")
pub function controls_stop(env: usize, thiz: usize): void {
  session.stop(env);
}

@jni("dev.fern.tune.Controls", "void onSeekTo(long)")
pub function controls_seek(env: usize, thiz: usize, ms: i64): void {
  session.seek_to(env, ms);
}

// The foreground service that keeps the player at work while its window
// is away.
@jni("dev.fern.tune.Playing extends android.app.Service", "android.os.IBinder onBind(android.content.Intent)")
pub function playing_bind(env: usize, thiz: usize, intent: usize): usize {
  return 0 as usize;
}

@jni("dev.fern.tune.Playing", "int onStartCommand(android.content.Intent, int, int)")
pub function playing_command(env: usize, thiz: usize, intent: usize, flags: i32, id: i32): i32 {
  return service.command(env, thiz, intent, service.Notice { channel: "tune", channel_name: "Music", title: "Fern Tune", text: "Music plays.", action: "", stop: "", unlock: false });
}

const SERVICE: string = "dev.fern.tune.Playing";

// The session of the player and its token, or 0 when Android gave none.
struct Media { session: Option[session.Session], token: usize }

// Tells Android the track and the state of the player. A track that plays
// starts the foreground service with the media controls.
function show(ctx: usize, media: Media, now: tune.Now): void {
  let Some(s) = media.session else {
    return;
  };
  session.set_track(ctx, s, now.title, now.artist, now.album, now.length_ms);
  session.set_state(ctx, s, now.playing, now.at_ms);
  if (now.playing && !service.start_media(ctx, SERVICE, media.token)) {
    log.info("tune: Android gave no foreground service");
  }
}

function wake(ctx: usize): tune.Awake {
  let a = service.stay_awake(ctx, "fern:tune");
  return tune.Awake { wake: a.wake, wifi: a.wifi };
}

function read(path: string): u8[] {
  return read_file_bytes(path).unwrap_or([]);
}

function size(path: string): i64 {
  match (stat(path)) {
    Ok(s) => {
      return s.size as i64;
    },
    Err(_) => {
      return 0i64;
    }
  }
}

// At most `n` bytes of the file from the offset `at`.
function part(path: string, at: i64, n: i32): u8[] {
  let Ok(reader) = open_reader(path) else {
    return [];
  };
  let out: u8[] = [];
  if let Ok(_) = reader.seek(at, 0) {
    while (out.len() < n) {
      let Ok(chunk) = reader.read_chunk_bytes(n - out.len()) else {
        break;
      };
      if (chunk.len() == 0) {
        break;
      }
      for b in chunk {
        out = out.append(b);
      }
    }
  }
  let closed = reader.close();
  return out;
}

function stream(s: tune.Sound): audio.Music {
  return audio.Music { ptr: s.ptr, rate: s.rate, channels: s.channels };
}

function open(rate: i32, channels: i32): tune.Sound {
  let m = audio.music(rate, channels);
  if (m.ptr != 0 as usize && m.rate != rate) {
    // The engine gives samples at the rate of the file only.
    m.close();
    return tune.no_sound();
  }
  return tune.Sound { ptr: m.ptr, rate: m.rate, channels: m.channels };
}

function names(dir: string): string[] {
  return read_dir(dir).unwrap_or([]);
}

function is_dir(path: string): boolean {
  match (stat(path)) {
    Ok(s) => {
      return s.is_dir;
    },
    Err(_) => {
      return false;
    }
  }
}

// The files of sound of each directory of the library.
function files(roots: string[]): string[] {
  let out: string[] = [];
  for root in roots {
    for f in library.files(root, 6, names, is_dir) {
      out = out.append(f);
    }
  }
  return out;
}

function device(ctx: usize, dir: string, roots: string[], media: Media): player.Device {
  return player.Device {
    grant: (): void => grant(ctx),
    files: (folder: string): string[] => found(dir, roots, folder),
    roots: roots,
    dirs: (at: string): string[] => dirs(at),
    keep: (folder: string): void => { let kept = write_file(dir + "/../folder.txt", folder); },
    show: (now: tune.Now): void => show(ctx, media, now),
    wake: (): tune.Awake => wake(ctx),
    sleep: (a: tune.Awake): void => service.release_awake(ctx, service.Awake { wake: a.wake, wifi: a.wifi }),
    size: (path: string): i64 => size(path),
    part: (path: string, at: i64, n: i32): u8[] => part(path, at, n),
    read: (path: string): u8[] => read(path),
    open: (rate: i32, channels: i32): tune.Sound => open(rate, channels),
    start: (s: tune.Sound): void => { let started = stream(s).start(); },
    pause: (s: tune.Sound): void => stream(s).pause(),
    flush: (s: tune.Sound): void => stream(s).flush(),
    close: (s: tune.Sound): void => stream(s).close(),
    write: (s: tune.Sound, samples: [i32]): i32 => stream(s).write(samples, 0),
  };
}

// Asks the person for the permission to read the music of the phone, when
// the app does not have it.
function grant(ctx: usize): void {
  if (!android.has_permission(ctx, "android.permission.READ_MEDIA_AUDIO") && !android.has_permission(ctx, "android.permission.READ_EXTERNAL_STORAGE")) {
    log.info("tune: asks for the permission to read the music");
    android.request_permissions(ctx, ["android.permission.READ_MEDIA_AUDIO", "android.permission.READ_EXTERNAL_STORAGE"]);
  }
}

// The names of the directories in `at`, in their order, with no name that
// starts with a dot.
function dirs(at: string): string[] {
  let out: string[] = [];
  for name in cmp.sort(names(at)) {
    if (!name.starts_with(".") && is_dir(at + "/" + name)) {
      out = out.append(name);
    }
  }
  return out;
}

// The files of the library: those of `folder`, or those of `roots` for "".
// The player makes its three tunes in `dir` when no directory of `roots`
// has a file of sound.
function found(dir: string, roots: string[], folder: string): string[] {
  if (folder.len() > 0) {
    let chosen = library.files(folder, 8, names, is_dir);
    log.info("tune: found " + chosen.len().to_string() + " files in the folder");
    return chosen;
  }
  let have = files(roots);
  log.info("tune: found " + have.len().to_string() + " files");
  if (have.len() > 0) {
    return have;
  }
  for which in 0..3 {
    if let Ok(file) = library.demo_file(which) {
      let path = dir + "/" + library.demo_name(which);
      let made = create_dir_all(path.take(path.len() - path.split("/").last().unwrap_or("").len() - 1));
      let written = write_file_bytes(path, file);
    }
  }
  log.info("tune: made its tunes");
  return files(roots);
}

// The message of a media button of Android.
function of_command(c: session.Command): tune.Msg {
  match (c) {
    session.Play => {
      return tune.Play(true);
    },
    session.Next => {
      return tune.Next;
    },
    session.Previous => {
      return tune.Previous;
    },
    session.SeekTo(ms) => {
      return tune.SeekMs(ms);
    },
    _ => {
      return tune.Play(false);
    }
  }
}

// The message of an event of Android: the player looks for its files
// again when the app shows again, because the person can give it the
// permission to read the music of the phone while it is away.
function system(e: android.Event): Option[tune.Msg] {
  if let Some(command) = session.event(e) {
    return Some(of_command(command));
  }
  match (e) {
    android.Resume => {
      return Some(tune.Returned);
    },
    _ => {
      return None;
    }
  }
}

function app_main(ctx: usize): usize {
  let own_music = android.data_dir(ctx) + "/music";
  let made = create_dir_all(own_music);
  let roots = [own_music, "/sdcard/Music", "/sdcard/Download"];
  let media = Media { session: session.new(ctx, "dev.fern.tune.Controls", "Fern Tune"), token: 0 as usize };
  if let Some(s) = media.session {
    media = Media { session: media.session, token: session.token(ctx, s) };
  } else {
    log.info("tune: Android gave no media session");
  }
  let dev = device(ctx, own_music, roots, media);
  log.info("tune: starts");
  // The player looks for its files after the screen shows, and asks for
  // the permission only when the person taps Scan.
  let folder = read_file(android.data_dir(ctx) + "/folder.txt").unwrap_or("");
  let last = app.run(ctx, tune.start_in("/storage/emulated/0", folder), player.program(dev).with_system(system));
  dev.close(last.sound);
  if (last.awake.wake != 0 as usize) {
    dev.sleep(last.awake);
  }
  service.stop(ctx, SERVICE);
  if let Some(s) = media.session {
    session.close(ctx, s);
  }
  log.info("tune: closed with " + last.tracks.len().to_string() + " tracks at track " + last.current.to_string() + ", " + tune.clock(last.at_ms) + " of " + tune.clock(last.length_ms) + ", playing " + last.playing.to_string());
  return 0 as usize;
}
