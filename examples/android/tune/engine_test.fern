// Tests of the decoder of the player on the host: it reads the tunes that
// demo.fern makes, as WAV and as FLAC, and the files of fixture.fern.
import "std/audio/flac";
import "std/audio/pcm";
import "std/audio/wav";
import "std/result";
import "std/test";
import "./demo";
import "./engine";
import "./fixture";

function limits(): pcm.Limits {
  return pcm.Limits { max_input_bytes: 1073741824, max_samples: 4194304 };
}

function stereo(): pcm.Format {
  return pcm.Format { sample_rate: demo.RATE, channels: 2, bits_per_sample: 16 };
}

// One second of sound: four notes at 240 beats a minute.
function tune(): i32[] {
  return demo.render([demo.Note { pitch: 3, beats: 1.0 }, demo.Note { pitch: 7, beats: 1.0 }, demo.Note { pitch: 10, beats: 1.0 }, demo.Note { pitch: 15, beats: 1.0 }], 240);
}

// Each sample of the deck, and the number of its parts.
function drained(own d: engine.Deck): (i32[], i32, engine.Deck) {
  let all: i32[] = [];
  let parts = 0;
  let deck = d;
  while (!deck.done && parts < 100000) {
    let (next, part) = deck.pull();
    deck = next;
    for v in part {
      all = all.append(v);
    }
    parts += 1;
  }
  return (all, parts, deck);
}

function same(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

function test_wav_plays_each_sample(): test.TestOutcome {
  let samples = tune();
  let Ok(file) = wav.encode(samples, stereo(), limits()) else {
    return test.fail("the WAV encoder gave no file");
  };
  let Some(d) = engine.open(file) else {
    return test.fail("the engine did not open the WAV file");
  };
  let head = d.kind.to_string() + " " + d.rate.to_string() + " " + d.channels.to_string() + " " + d.duration_ms().to_string();
  let (all, parts, end) = drained(d);
  return test.assert_eq(head + " " + same(all, samples).to_string() + " " + (parts > 2).to_string() + " " + end.position_ms().to_string(), "0 44100 2 1000 true true 1000");
}

function test_flac_plays_each_sample(): test.TestOutcome {
  let samples = tune();
  let Ok(file) = flac.encode(samples, stereo(), limits()) else {
    return test.fail("the FLAC encoder gave no file");
  };
  let Some(d) = engine.open(file) else {
    return test.fail("the engine did not open the FLAC file");
  };
  let head = d.kind.to_string() + " " + d.duration_ms().to_string() + " " + (file.len() < samples.len() * 2).to_string();
  let (all, parts, end) = drained(d);
  return test.assert_eq(head + " " + same(all, samples).to_string() + " " + (parts > 2).to_string(), "1 1000 true true true");
}

function test_seek(): test.TestOutcome {
  let samples = tune();
  let Ok(wave) = wav.encode(samples, stereo(), limits()) else {
    return test.fail("the WAV encoder gave no file");
  };
  let Ok(lossless) = flac.encode(samples, stereo(), limits()) else {
    return test.fail("the FLAC encoder gave no file");
  };
  let got = "";
  for file in [wave, lossless] {
    let Some(d) = engine.open(file) else {
      return test.fail("the engine did not open a file");
    };
    let half = d.seek(0.5);
    let at = half.at;
    let (next, part) = half.pull();
    // The part is the sound of the file from the frame that the deck is at.
    let right = part.len() > 0;
    for i in 0..part.len() {
      if (part[i] != samples[at as i32 * 2 + i]) {
        right = false;
      }
    }
    let ended = next.seek(1.0).pull();
    got = got + (at >= 22050i64 && at < 22050i64 + 8192i64).to_string() + " " + right.to_string() + " " + ended.0.done.to_string() + " ";
  }
  return test.assert_eq(got.trim(), "true true true true true true");
}

// The samples of a deck that reads `file` a window at a time, the most
// bytes that its window held after its first part, and the frame and the
// first samples after a seek to the half.
struct Streamed { samples: i32[], most: i32, half: i64, after: i32[] }

function streamed(file: u8[], window: i32): Option[Streamed] {
  let bytes = file;
  let source = (at: i64, n: i32): u8[] => {
    let out: u8[] = [];
    for i in at as i32..(at as i32 + n).min(bytes.len()) {
      out = out.append(bytes[i]);
    }
    return out;
  };
  let Some(d) = engine.open_file(file.len() as i64, source, window) else {
    return None;
  };
  let all: i32[] = [];
  let most = 0;
  let deck = d;
  let parts = 0;
  while (!deck.done && parts < 100000) {
    let (next, part) = deck.pull();
    deck = next;
    most = most.max(deck.bytes.len());
    for v in part {
      all = all.append(v);
    }
    parts += 1;
  }
  let (seeked, after) = deck.seek(0.5).pull();
  return Some(Streamed { samples: all, most: most, half: seeked.at - (after.len() / seeked.channels.max(1)) as i64, after: after });
}

// The bytes of `b` from `from` to `to`.
function range(b: u8[], from: i32, to: i32): u8[] {
  let out: u8[] = [];
  for i in from..to {
    out = out.append(b[i]);
  }
  return out;
}

// A deck that reads a WAV, a FLAC or an MP3 file a window at a time gives
// the samples that the deck of the whole file gives, seeks to the same
// frame, and holds no more than its window. A tag longer than a window
// makes the start that it reads longer.
function test_a_file_plays_from_a_window(): test.TestOutcome {
  let samples = tune();
  let Ok(wave) = wav.encode(samples, stereo(), limits()) else {
    return test.fail("the WAV encoder gave no file");
  };
  let Ok(lossless) = flac.encode(samples, stereo(), limits()) else {
    return test.fail("the FLAC encoder gave no file");
  };
  // A padding block of 300000 bytes after the stream info of the FLAC
  // file: the stream info is not the last block, and the padding is.
  let padded = fixture.joined(range(lossless, 0, 4), [0u8, 0u8, 0u8, 34u8]);
  padded = fixture.joined(padded, range(lossless, 8, 42));
  padded = fixture.joined(padded, [129u8, 4u8, 147u8, 224u8]);
  for i in 0..300000 {
    padded = padded.append(0u8);
  }
  padded = fixture.joined(padded, range(lossless, 42, lossless.len()));
  let tagged = fixture.joined(fixture.id3v2_picture("Tagged", 300000), fixture.tone_mp3());
  let got: string[] = [];
  for file in [wave, lossless, padded, fixture.tone_mp3(), tagged] {
    let Some(whole) = streamed(file, file.len() + 4096) else {
      return test.fail("the whole file did not open");
    };
    let Some(part) = streamed(file, 32768) else {
      return test.fail("the file did not open from a window");
    };
    got = got.append([same(part.samples, whole.samples) && part.samples.len() > 40000, part.most <= 32768, part.half == whole.half && same(part.after, whole.after)].map((b: boolean): string => b.to_string()).join(","));
  }
  return test.assert_eq(got.join(" "), "true,true,true true,true,true true,true,true true,true,true true,true,true");
}

// An M4A file with AAC or ALAC sound plays from a window as it plays
// whole: the index comes from its boxes, and each packet from the window.
// The window holds a packet that is longer than the window, but never the
// whole file.
function test_an_m4a_file_plays_from_a_window(): test.TestOutcome {
  let got: string[] = [];
  for file in [fixture.m4a(), fixture.alac16(), fixture.alac24()] {
    let Some(whole) = streamed(file, file.len() + 4096) else {
      return test.fail("the whole file did not open");
    };
    let Some(part) = streamed(file, 4096) else {
      return test.fail("the file did not open from a window");
    };
    got = got.append([same(part.samples, whole.samples) && part.samples.len() >= 4000, part.most < file.len(), part.half == whole.half && same(part.after, whole.after)].map((b: boolean): string => b.to_string()).join(","));
  }
  return test.assert_eq(got.join(" "), "true,true,true true,true,true true,true,true");
}

function test_other_bytes_do_not_open(): test.TestOutcome {
  let text: u8[] = [104u8, 101u8, 108u8, 108u8, 111u8, 32u8, 102u8, 101u8, 114u8, 110u8];
  let empty: u8[] = [];
  return test.assert_eq(engine.open(text).is_none().to_string() + " " + engine.open(empty).is_none().to_string(), "true true");
}

// 100 frames of 1152 samples at 44100 Hz: the deck tells 2612 ms, and
// plays 115200 frames of two samples.
function test_mp3_length(): test.TestOutcome {
  let Some(deck) = engine.open(fixture.silent_mp3(100, true)) else {
    return test.fail("the MP3 file did not open");
  };
  let length = deck.duration_ms();
  let (all, parts, last) = drained(deck);
  return test.assert_eq(length.to_string() + " " + all.len().to_string() + " " + last.position_ms().to_string(), "2612 230400 2612");
}

// A file of one second: the deck tells its rate and its length, plays its
// sound from the start, and plays the last part from the half.
function played(file: u8[]): string {
  let Some(deck) = engine.open(file) else {
    return "none";
  };
  let head = deck.rate.to_string() + " " + deck.channels.to_string() + " " + near(deck.duration_ms(), 1000i64, 120i64).to_string();
  let (all, parts, end) = drained(deck);
  let loud = 0;
  for v in all {
    if (v > 1000 || v < -1000) {
      loud += 1;
    }
  }
  let Some(again) = engine.open(file) else {
    return "none";
  };
  let (half, n, last) = drained(again.seek(0.5));
  return head + " " + near((all.len() / end.channels) as i64 * 1000i64 / (end.rate as i64), 1000i64, 120i64).to_string() + " " + (loud > all.len() / 4).to_string() + " " + near((half.len() / last.channels) as i64 * 1000i64 / (last.rate as i64), 500i64, 120i64).to_string();
}

function near(got: i64, want: i64, by: i64): boolean {
  return got >= want - by && got <= want + by;
}

function test_m4a_ogg_and_opus_play(): test.TestOutcome {
  return test.assert_eq(played(fixture.m4a()) + " | " + played(fixture.ogg()) + " | " + played(fixture.opus()), "22050 1 true true true true | 22050 1 true true true true | 48000 1 true true true true");
}

// An M4A file with ALAC sound plays as one with AAC sound does. A 24-bit
// file plays as 16-bit samples.
function test_alac_plays(): test.TestOutcome {
  let Some(deck) = engine.open(fixture.alac24()) else {
    return test.fail("the 24-bit file does not open");
  };
  let head = deck.rate.to_string() + " " + deck.channels.to_string() + " " + (deck.kind == engine.ALAC).to_string();
  let (all, parts, end) = drained(deck);
  let most = 0;
  for v in all {
    most = most.max(v).max(-v);
  }
  let wide = (most > 8000 && most < 32768).to_string() + " " + near((all.len() / 2) as i64 * 1000i64 / 8000i64, 250i64, 40i64).to_string();
  return test.assert_eq(played(fixture.alac16()) + " | " + head + " " + wide, "8000 1 true true true true | 8000 2 true true true");
}

function main(): i32 {
  let r = test.new("examples/android/tune engine");
  r = r.it("a WAV file plays each sample", test_wav_plays_each_sample);
  r = r.it("a FLAC file plays each sample", test_flac_plays_each_sample);
  r = r.it("a deck starts at a part of its file", test_seek);
  r = r.it("bytes that are not sound do not open", test_other_bytes_do_not_open);
  r = r.it("an MP3 file tells its length in frames of samples", test_mp3_length);
  r = r.it("an M4A, an Ogg Vorbis and an Opus file play", test_m4a_ogg_and_opus_play);
  r = r.it("an M4A file with AAC or ALAC sound plays from a window", test_an_m4a_file_plays_from_a_window);
  r = r.it("an M4A file with ALAC sound plays", test_alac_plays);
  r = r.it("a file plays from a window of it", test_a_file_plays_from_a_window);
  return r.finish();
}
