// The music player: its state, its screens and its messages. It has no
// Android code. `update` puts what the device must do in `wants`, and
// player.fern does it. So tune_test.fern runs the player on the host.
import "std/android/draw";
import "std/android/ui";
import "std/i32";
import "std/i64";
import "std/option";
import "std/unicode";
import "./engine";

// A file of the library: its title, its artist, its album and its number
// on the album, from its tags or from its path. `by` is the artist that
// the album is under. `format` is the kind of the file, and `ms` is its
// length.
pub struct Track { path: string, title: string, artist: string, album: string, by: string, number: i32, year: i32, format: string, ms: i64 }

// A track with a title only, by no artist and on no album.
pub function plain(path: string, title: string, format: string, ms: i64): Track {
  return Track { path: path, title: title, artist: UNKNOWN_ARTIST, album: UNKNOWN_ALBUM, by: UNKNOWN_ARTIST, number: 0, year: 0, format: format, ms: ms };
}

pub const UNKNOWN_ARTIST: string = "Unknown artist";

pub const UNKNOWN_ALBUM: string = "Unknown album";

// The lists of the library.
pub const SONGS: i32 = 0;

pub const ARTISTS: i32 = 1;

pub const ALBUMS: i32 = 2;

// An artist or an album: its name, the artist that an album is under, the
// number of its songs and of its albums, and the year of an album.
pub struct Group { name: string, by: string, songs: i32, albums: i32, year: i32 }

// A stream of sound of the device. `ptr` is 0 when the player has none.
pub struct Sound { ptr: usize, rate: i32, channels: i32 }

pub function no_sound(): Sound {
  return Sound { ptr: 0 as usize, rate: 0, channels: 0 };
}

// What the device must do: load the track of a number and play it, play
// on, stop the sound, go to a part of the track from 0 to 1, or look for
// the files of the library again.
pub enum Want { Load(i32), Resume, Hold, Seek(f64), Scan }

// `tracks` is in the order of the artists, the albums and the numbers.
// `scan` has the files that the player did not read yet. `tab` is the
// list that shows. `artist` is the artist whose albums show, and `album`
// is the album whose songs show, or "". `open` tells that the screen of the
// track shows. `current` is the number of the track that plays, or -1.
// `deck` reads its file, `sound` plays it, and `pending` has the samples
// that the sound did not take yet.
pub struct Model {
  tracks: Track[],
  scan: string[],
  tab: i32,
  artist: string,
  album: string,
  query: string,
  open: boolean,
  current: i32,
  playing: boolean,
  at_ms: i64,
  length_ms: i64,
  shuffle: boolean,
  repeat: boolean,
  error: string,
  wants: Want[],
  deck: Option[engine.Deck],
  sound: Sound,
  pending: i32[],
}

// A player with no track yet, which reads the files `scan`.
pub function start(scan: string[]): Model {
  return Model { tracks: [], scan: scan, tab: SONGS, artist: "", album: "", query: "", open: false, current: -1, playing: false, at_ms: 0i64, length_ms: 0i64, shuffle: false, repeat: false, error: "", wants: [], deck: None, sound: no_sound(), pending: [] };
}

// What a person can do, and what the player tells: `Beat` comes many times
// a second while a track plays, `Finished` comes at the end of a track,
// and `Failed` comes for a file that the player cannot read.
// `Found` comes for each file of sound that the player read, and `Files`
// comes with the files of the library.
pub enum Msg { Search(string), Pick(i32), Toggle, Next, Previous, Sought(i32), Opened, Closed, Shuffled, Repeated, Beat, Finished, Failed(string), Tab(i32), Artist(string), Album(string, string), Up, Found(Track), Files(string[]), Rescan }

// A time in ms as minutes and seconds.
pub function clock(ms: i64): string {
  let s = (ms / 1000i64) as i32;
  let rest = (s % 60).to_string();
  if (rest.len() < 2) {
    rest = "0" + rest;
  }
  return (s / 60).to_string() + ":" + rest;
}

function has(text: string, want: string): boolean {
  return want.len() == 0 || text.to_lower().contains(want);
}

function wanted(m: Model): string {
  return m.query.trim().to_lower();
}

// The track is on the album that shows, or by the artist that shows.
function in_view(m: Model, t: Track): boolean {
  if (m.album.len() > 0) {
    return t.album == m.album && t.by == m.artist;
  }
  return m.artist.len() == 0 || t.by == m.artist;
}

// The numbers of the tracks that show: those of the album or of the artist
// that shows, whose title, artist or album has the text of the search.
pub function songs(m: Model): i32[] {
  let want = wanted(m);
  let out: i32[] = [];
  for i in 0..m.tracks.len() {
    let t = m.tracks[i];
    if (in_view(m, t) && (has(t.title, want) || has(t.artist, want) || has(t.album, want))) {
      out = out.append(i);
    }
  }
  return out;
}

// The artists whose name has the text of the search, each with the number
// of its albums and of its songs. The tracks of an artist are one after
// the other.
pub function artists(m: Model): Group[] {
  let want = wanted(m);
  let out: Group[] = [];
  let album = "";
  for t in m.tracks {
    let n = out.len();
    if (n > 0 && out[n - 1].name == t.by) {
      let g = out[n - 1];
      let albums = g.albums;
      if (t.album != album) {
        albums += 1;
      }
      out = out.with(n - 1, Group { ...g, songs: g.songs + 1, albums: albums });
    } else if (has(t.by, want)) {
      out = out.append(Group { name: t.by, by: t.by, songs: 1, albums: 1, year: 0 });
    }
    album = t.album;
  }
  return out;
}

// The albums of the artist that shows, or each album, whose name has the
// text of the search. The tracks of an album are one after the other.
pub function albums(m: Model): Group[] {
  let want = wanted(m);
  let out: Group[] = [];
  for t in m.tracks {
    let n = out.len();
    if (n > 0 && out[n - 1].name == t.album && out[n - 1].by == t.by) {
      let g = out[n - 1];
      out = out.with(n - 1, Group { ...g, songs: g.songs + 1, year: g.year.max(t.year) });
    } else if ((m.artist.len() == 0 || t.by == m.artist) && has(t.album, want)) {
      out = out.append(Group { name: t.album, by: t.by, songs: 1, albums: 1, year: t.year });
    }
  }
  return out;
}

// `a` comes before `b` in the library: by the artist, then the album, then
// the number, then the title.
function before(a: Track, b: Track): boolean {
  let (x, y) = (a.by.to_lower(), b.by.to_lower());
  if (x != y) {
    return x < y;
  }
  let (p, q) = (a.album.to_lower(), b.album.to_lower());
  if (p != q) {
    return p < q;
  }
  if (a.number != b.number) {
    return a.number < b.number;
  }
  return a.title.to_lower() < b.title.to_lower();
}

// The player with the track `t` at its place in the library. A file that
// the library has already adds nothing.
function with_track(m: Model, t: Track): Model {
  let at = m.tracks.len();
  for i in 0..m.tracks.len() {
    if (m.tracks[i].path == t.path) {
      return m;
    }
    if (at == m.tracks.len() && before(t, m.tracks[i])) {
      at = i;
    }
  }
  let all: Track[] = [];
  for i in 0..m.tracks.len() {
    if (i == at) {
      all = all.append(t);
    }
    all = all.append(m.tracks[i]);
  }
  if (at == m.tracks.len()) {
    all = all.append(t);
  }
  let current = m.current;
  if (current >= at) {
    current += 1;
  }
  return Model { ...m, tracks: all, current: current };
}

// The player with the files that it did not read yet.
function with_files(m: Model, files: string[]): Model {
  let scan = m.scan;
  for f in files {
    let known = scan.contains(f);
    for t in m.tracks {
      if (t.path == f) {
        known = true;
      }
    }
    if (!known) {
      scan = scan.append(f);
    }
  }
  return Model { ...m, scan: scan };
}

// The part of the track that played, from 0 to 1.
pub function part(m: Model): f64 {
  if (m.length_ms <= 0i64) {
    return 0.0;
  }
  return (m.at_ms as f64 / (m.length_ms as f64)).max(0.0).min(1.0);
}

function title(m: Model): string {
  if (m.current < 0 || m.current >= m.tracks.len()) {
    return "";
  }
  return m.tracks[m.current].title;
}

function play_label(m: Model): string {
  if (m.playing) {
    return "Pause";
  }
  return "Play";
}

// Two lines of a list: a name, and a detail below it.
function lines(name: string, detail: string, color: i32): ui.El[Msg] {
  return ui.column([ui.text(name).sized(16.0).colored(color).clamped(1), ui.text(detail).sized(13.0).colored(ui.MUTED).clamped(1)]).spaced(2.0).justified(ui.CENTER).padding_xy(16.0, 0.0).wide().tall();
}

function track_row(m: Model, i: i32): ui.El[Msg] {
  let t = m.tracks[i];
  let color = ui.INK;
  if (i == m.current) {
    color = ui.PRIMARY;
  }
  let name = t.title;
  let detail = t.artist + " · " + t.album;
  if (m.album.len() > 0) {
    // On the screen of an album, a track has its number and its length.
    detail = clock(t.ms) + " · " + t.format;
    if (t.number > 0) {
      name = t.number.to_string() + ". " + t.title;
    }
  }
  return lines(name, detail, color).on_tap(Pick(i));
}

function count(n: i32, one: string): string {
  if (n == 1) {
    return "1 " + one;
  }
  return n.to_string() + " " + one + "s";
}

function artist_row(g: Group): ui.El[Msg] {
  return lines(g.name, count(g.albums, "album") + " · " + count(g.songs, "song"), ui.INK).on_tap(Artist(g.name));
}

function album_row(g: Group): ui.El[Msg] {
  let detail = g.by + " · " + count(g.songs, "song");
  if (g.year > 0) {
    detail = detail + " · " + g.year.to_string();
  }
  return lines(g.name, detail, ui.INK).on_tap(Album(g.by, g.name));
}

function tab(m: Model, name: string, which: i32): ui.El[Msg] {
  if (m.tab == which) {
    return ui.button(name, Tab(which));
  }
  return ui.text_button(name, Tab(which));
}

// The title of the library, or the artist or the album that shows with a
// button that goes up from it.
function heading(m: Model, summary: string): ui.El[Msg] {
  let name = "Tune";
  if (m.album.len() > 0) {
    name = m.album;
  } else if (m.artist.len() > 0) {
    name = m.artist;
  }
  let top: ui.El[Msg][] = [ui.text(name).sized(28.0).weighted(700).clamped(1), ui.text(summary).colored(ui.MUTED).clamped(1)];
  if (m.artist.len() > 0) {
    return ui.row([ui.column(top).spaced(4.0).wide(), ui.text_button("Up", Up)]).spaced(8.0).aligned(ui.CENTER).padding_xy(16.0, 0.0);
  }
  return ui.row([ui.column(top).spaced(4.0).wide(), ui.text_button("Scan", Rescan)]).spaced(8.0).aligned(ui.CENTER).padding_xy(16.0, 0.0);
}

// The list of the tab that shows. An artist that shows has its albums, and
// an album that shows has its songs.
function listing(m: Model): (ui.El[Msg], string) {
  if (m.album.len() == 0 && (m.tab == ALBUMS || m.artist.len() > 0)) {
    let groups = albums(m);
    return (ui.list("albums", groups.len(), 64.0, (row: i32): ui.El[Msg] => album_row(groups[row])), count(groups.len(), "album"));
  }
  if (m.album.len() == 0 && m.tab == ARTISTS) {
    let groups = artists(m);
    return (ui.list("artists", groups.len(), 64.0, (row: i32): ui.El[Msg] => artist_row(groups[row])), count(groups.len(), "artist"));
  }
  let shown = songs(m);
  return (ui.list("tracks", shown.len(), 64.0, (row: i32): ui.El[Msg] => track_row(m, shown[row])), count(shown.len(), "song"));
}

// The bar at the foot of the library, for the track that plays.
function mini(m: Model): ui.El[Msg] {
  return ui.column([ui.progress(part(m)), ui.row([ui.column([ui.text(title(m)).weighted(500).clamped(1), ui.text(clock(m.at_ms) + " / " + clock(m.length_ms)).sized(12.0).colored(ui.MUTED)]).spaced(2.0).wide(), ui.text_button(play_label(m), Toggle)]).spaced(12.0).aligned(ui.CENTER).padding_xy(16.0, 8.0)]).background(ui.SURFACE).on_tap(Opened).described("Now playing, " + title(m));
}

function library(m: Model): ui.El[Msg] {
  let (list, summary) = listing(m);
  if (m.error.len() > 0) {
    summary = m.error;
  } else if (m.scan.len() > 0) {
    summary = summary + " · reading " + count(m.scan.len(), "file");
  }
  let kids: ui.El[Msg][] = [heading(m, summary), ui.row([ui.field("search", m.query, "Search the library").on_edit((text: string): Msg => Search(text))]).padding_xy(16.0, 0.0)];
  if (m.artist.len() == 0) {
    kids = kids.append(ui.row([tab(m, "Songs", SONGS), tab(m, "Artists", ARTISTS), tab(m, "Albums", ALBUMS)]).spaced(8.0).padding_xy(16.0, 0.0));
  }
  kids = kids.append(list);
  if (m.current >= 0) {
    kids = kids.append(mini(m));
  }
  return ui.column(kids).spaced(12.0).padding_xy(0.0, 16.0).aligned(ui.STRETCH);
}

// A picture for a track, from the letters of its title: rings in two
// colors.
function art(name: string): (draw.Frame, i32, i32, i32, i32) => void {
  let seed = 7;
  for i in 0..name.len() {
    seed = (seed * 31 + name[i] as i32) % 65521;
  }
  let a = draw.rgb(60 + seed % 120, 90 + seed / 7 % 120, 120 + seed / 49 % 120);
  let b = draw.rgb(200 - seed % 90, 120 + seed / 11 % 100, 90 + seed / 5 % 80);
  return (f: draw.Frame, x: i32, y: i32, w: i32, h: i32): void => {
    let r = w.min(h) / 2;
    let rings = 5;
    for k in 0..rings {
      let color = a;
      if (k % 2 == 1) {
        color = b;
      }
      f.disc(x + w / 2, y + h / 2, r * (rings - k) / rings, color);
    }
  };
}

function toggle_label(name: string, on: boolean): string {
  if (on) {
    return name + " on";
  }
  return name + " off";
}

function now_playing(m: Model): ui.El[Msg] {
  let name = title(m);
  let format = "";
  if (m.current >= 0) {
    let t = m.tracks[m.current];
    format = t.artist + " · " + t.album;
  }
  return ui.column(
    [
      ui.row([ui.text_button("Library", Closed)]),
      ui.column([ui.canvas("art:" + name, art(name)).width(240.0).height(240.0)]).centered().grow(1.0),
      ui.column([ui.text(name).sized(22.0).weighted(700).clamped(2), ui.text(format).colored(ui.MUTED).clamped(1)]).spaced(4.0),
      ui.column([ui.slider(part(m), (at: f64): Msg => Sought((at * 1000.0 + 0.5) as i32)).described("Position"), ui.row([ui.text(clock(m.at_ms)).sized(12.0).colored(ui.MUTED), ui.space(), ui.text(clock(m.length_ms)).sized(12.0).colored(ui.MUTED)])]),
      ui.row([ui.text_button("Previous", Previous), ui.button(play_label(m), Toggle), ui.text_button("Next", Next)]).spaced(8.0).justified(ui.CENTER).aligned(ui.CENTER),
      ui.row([ui.text_button(toggle_label("Shuffle", m.shuffle), Shuffled), ui.text_button(toggle_label("Repeat", m.repeat), Repeated)]).spaced(8.0).justified(ui.CENTER),
    ],
  ).spaced(16.0).padding(16.0).aligned(ui.STRETCH);
}

pub function view(m: Model, s: ui.Screen): ui.El[Msg] {
  if (m.open && m.current >= 0) {
    return now_playing(m);
  }
  return library(m);
}

function picked(m: Model, i: i32): Model {
  if (i < 0 || i >= m.tracks.len()) {
    return m;
  }
  return Model { ...m, current: i, playing: true, at_ms: 0i64, length_ms: m.tracks[i].ms, error: "", wants: m.wants.append(Load(i)) };
}

// The number of the track after `current`. With shuffle, the numbers go in
// an order that reaches each track.
function after(m: Model): i32 {
  let n = m.tracks.len();
  if (n == 0) {
    return -1;
  }
  if (m.shuffle && n > 2) {
    return (m.current + n / 2 + 1) % n;
  }
  return (m.current + 1) % n;
}

function toggled(m: Model): Model {
  if (m.current < 0) {
    return picked(m, 0);
  }
  if (m.playing) {
    return Model { ...m, playing: false, wants: m.wants.append(Hold) };
  }
  return Model { ...m, playing: true, wants: m.wants.append(Resume) };
}

// The start of the track again, or the track before it in the first 3
// seconds.
function went_back(m: Model): Model {
  if (m.current < 0) {
    return m;
  }
  if (m.at_ms > 3000i64) {
    return Model { ...m, at_ms: 0i64, wants: m.wants.append(Seek(0.0)) };
  }
  return picked(m, (m.current + m.tracks.len() - 1) % m.tracks.len());
}

function finished(m: Model): Model {
  if (m.repeat) {
    return picked(m, m.current);
  }
  if (!m.shuffle && m.current == m.tracks.len() - 1) {
    return Model { ...m, playing: false, at_ms: 0i64, wants: m.wants.append(Hold).append(Seek(0.0)) };
  }
  return picked(m, after(m));
}

// The list above the album or the artist that shows: an album of the
// Albums tab goes to that tab, and each other album goes to its artist.
function went_up(m: Model): Model {
  if (m.album.len() > 0 && m.tab != ALBUMS) {
    return Model { ...m, album: "" };
  }
  return Model { ...m, artist: "", album: "" };
}

// fern-lint: allow cyclomatic-complexity
// One arm for each message.
pub function update(own m: Model, msg: Msg): Model {
  match (msg) {
    Search(text) => {
      return Model { ...m, query: text };
    },
    Pick(i) => {
      return picked(m, i);
    },
    Toggle => {
      return toggled(m);
    },
    Next => {
      return picked(m, after(m));
    },
    Previous => {
      return went_back(m);
    },
    Sought(permille) => {
      let to = permille as f64 / 1000.0;
      return Model { ...m, at_ms: (m.length_ms as f64 * to) as i64, wants: m.wants.append(Seek(to)) };
    },
    Opened => {
      return Model { ...m, open: true };
    },
    Closed => {
      return Model { ...m, open: false };
    },
    Shuffled => {
      return Model { ...m, shuffle: !m.shuffle };
    },
    Repeated => {
      return Model { ...m, repeat: !m.repeat };
    },
    Beat => {
      return m;
    },
    Finished => {
      return finished(m);
    },
    Failed(why) => {
      return Model { ...m, playing: false, error: why };
    },
    Tab(which) => {
      return Model { ...m, tab: which, artist: "", album: "" };
    },
    Artist(name) => {
      return Model { ...m, artist: name, album: "", query: "" };
    },
    Album(by, name) => {
      return Model { ...m, artist: by, album: name, query: "" };
    },
    Up => {
      return went_up(m);
    },
    Found(t) => {
      return with_track(m, t);
    },
    Files(files) => {
      return with_files(m, files);
    },
    Rescan => {
      return Model { ...m, error: "", wants: m.wants.append(Scan) };
    }
  }
}

// The milliseconds to the next Beat: the player reads one file of the
// library at each one, and gives the sound its samples.
function beat(m: Model): i32 {
  if (m.scan.len() > 0) {
    return 1;
  }
  if (m.playing) {
    return 20;
  }
  return -1;
}

function back(m: Model): Option[Msg] {
  if (m.open) {
    return Some(Closed);
  }
  if (m.artist.len() > 0) {
    return Some(Up);
  }
  return None;
}

// The program with no device: `update` only puts what it wants in the
// state.
pub function program(): ui.Program[Model, Msg] {
  return ui.program(view, update).with_tick(beat, Beat).with_back(back);
}
