// Files that the tests of the player make by hand.

// The bytes of one MP3 frame of 417 bytes with no sound: MPEG-1 Layer III,
// 128 kbit/s, 44100 Hz, two channels.
function frame(): u8[] {
  let out: u8[] = [255u8, 251u8, 144u8, 0u8];
  while (out.len() < 417) {
    out = out.append(0u8);
  }
  return out;
}

// An MP3 file of `frames` frames with no sound. With `told`, a frame
// before them tells their number.
pub function silent_mp3(frames: i32, told: boolean): u8[] {
  let out: u8[] = [];
  if (told) {
    let first = frame();
    let info = [73u8, 110u8, 102u8, 111u8, 0u8, 0u8, 0u8, 1u8, (frames >> 24) as u8, (frames >> 16 & 255) as u8, (frames >> 8 & 255) as u8, (frames & 255) as u8];
    for i in 0..info.len() {
      first = first.with(36 + i, info[i]);
    }
    out = first;
  }
  let one = frame();
  for i in 0..frames {
    for b in one {
      out = out.append(b);
    }
  }
  return out;
}

// An ID3v2.3 tag with the title `title`, and `padding` bytes of zero
// after it.
pub function id3v2(title: string, padding: i32): u8[] {
  let size = 10 + 1 + title.len() + padding;
  let out: u8[] = [73u8, 68u8, 51u8, 3u8, 0u8, 0u8, (size >> 21 & 127) as u8, (size >> 14 & 127) as u8, (size >> 7 & 127) as u8, (size & 127) as u8];
  for b in [84u8, 73u8, 84u8, 50u8, 0u8, 0u8, 0u8, (title.len() + 1) as u8, 0u8, 0u8, 0u8] {
    out = out.append(b);
  }
  for i in 0..title.len() {
    out = out.append(title[i]);
  }
  for i in 0..padding {
    out = out.append(0u8);
  }
  return out;
}

// An ID3v1 tag with the title `title`.
pub function id3v1(title: string): u8[] {
  let out: u8[] = [84u8, 65u8, 71u8];
  for i in 0..title.len() {
    out = out.append(title[i]);
  }
  while (out.len() < 128) {
    out = out.append(0u8);
  }
  return out;
}

pub function joined(a: u8[], b: u8[]): u8[] {
  let out = a;
  for v in b {
    out = out.append(v);
  }
  return out;
}
