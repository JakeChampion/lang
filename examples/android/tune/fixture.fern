// Files that the tests of the player make by hand, and three small files
// that ffmpeg made.
import "std/base64";
import "std/result";

// The bytes of one MP3 frame of 417 bytes with no sound: MPEG-1 Layer III,
// 128 kbit/s, 44100 Hz, two channels.
function frame(): u8[] {
  let out: u8[] = [255u8, 251u8, 144u8, 0u8];
  while (out.len() < 417) {
    out = out.append(0u8);
  }
  return out;
}

// An MP3 file of `frames` frames with no sound. With `told`, a frame
// before them tells their number.
pub function silent_mp3(frames: i32, told: boolean): u8[] {
  let out: u8[] = [];
  if (told) {
    let first = frame();
    let info = [73u8, 110u8, 102u8, 111u8, 0u8, 0u8, 0u8, 1u8, (frames >> 24) as u8, (frames >> 16 & 255) as u8, (frames >> 8 & 255) as u8, (frames & 255) as u8];
    for i in 0..info.len() {
      first = first.with(36 + i, info[i]);
    }
    out = first;
  }
  let one = frame();
  for i in 0..frames {
    for b in one {
      out = out.append(b);
    }
  }
  return out;
}

// An ID3v2.3 tag with the title `title`, and `padding` bytes of zero
// after it.
pub function id3v2(title: string, padding: i32): u8[] {
  let size = 10 + 1 + title.len() + padding;
  let out: u8[] = [73u8, 68u8, 51u8, 3u8, 0u8, 0u8, (size >> 21 & 127) as u8, (size >> 14 & 127) as u8, (size >> 7 & 127) as u8, (size & 127) as u8];
  for b in [84u8, 73u8, 84u8, 50u8, 0u8, 0u8, 0u8, (title.len() + 1) as u8, 0u8, 0u8, 0u8] {
    out = out.append(b);
  }
  for i in 0..title.len() {
    out = out.append(title[i]);
  }
  for i in 0..padding {
    out = out.append(0u8);
  }
  return out;
}

// An ID3v2.3 tag with a picture frame before its title: the image has
// `size` bytes and starts as a JPEG file.
pub function id3v2_picture(title: string, size: i32): u8[] {
  let image: u8[] = [255u8, 216u8, 255u8, 224u8];
  while (image.len() < size) {
    image = image.append(7u8);
  }
  // The encoding, "image/jpeg", the type 3 of a front cover, and no
  // description.
  let body: u8[] = [0u8, 105u8, 109u8, 97u8, 103u8, 101u8, 47u8, 106u8, 112u8, 101u8, 103u8, 0u8, 3u8, 0u8];
  for b in image {
    body = body.append(b);
  }
  let n = body.len();
  let frames: u8[] = [65u8, 80u8, 73u8, 67u8, (n >> 24) as u8, (n >> 16 & 255) as u8, (n >> 8 & 255) as u8, (n & 255) as u8, 0u8, 0u8];
  for b in body {
    frames = frames.append(b);
  }
  for b in [84u8, 73u8, 84u8, 50u8, 0u8, 0u8, 0u8, (title.len() + 1) as u8, 0u8, 0u8, 0u8] {
    frames = frames.append(b);
  }
  for i in 0..title.len() {
    frames = frames.append(title[i]);
  }
  let total = frames.len();
  let out: u8[] = [73u8, 68u8, 51u8, 3u8, 0u8, 0u8, (total >> 21 & 127) as u8, (total >> 14 & 127) as u8, (total >> 7 & 127) as u8, (total & 127) as u8];
  for b in frames {
    out = out.append(b);
  }
  return out;
}

// An ID3v1 tag with the title `title`.
pub function id3v1(title: string): u8[] {
  let out: u8[] = [84u8, 65u8, 71u8];
  for i in 0..title.len() {
    out = out.append(title[i]);
  }
  while (out.len() < 128) {
    out = out.append(0u8);
  }
  return out;
}

pub function joined(a: u8[], b: u8[]): u8[] {
  let out = a;
  for v in b {
    out = out.append(v);
  }
  return out;
}

// One second of a tone of 440 Hz in one channel, with the tags of the title
// "Short m4a", the artist "Fixture", the album "Formats" and the track 2.
// ffmpeg made each file: AAC at 22050 Hz in an M4A file, Vorbis at 22050
// Hz in an Ogg file, and Opus in an Ogg file.
function file(text: string): u8[] {
  return base64.decode(text).unwrap_or([]);
}

pub function m4a(): u8[] {
  return file("");
}

// An M4A file with ALAC sound: one second of a sine at 440 Hz, 16-bit
// mono at 8 kHz, from ffmpeg.
pub function alac16(): u8[] {
  return file("");
}

// An M4A file with ALAC sound and tags: a quarter of a second of a sine at
// 330 Hz, 24-bit stereo at 8 kHz, from ffmpeg.
pub function alac24(): u8[] {
  return file("");
}

pub function ogg(): u8[] {
  return file("");
}

// A tone of 440 Hz in two channels at 44100 Hz for 1.5 seconds, at 48 kbit/s
// with an Info frame and no tag. ffmpeg made it with libmp3lame.
pub function tone_mp3(): u8[] {
  return file("");
}

pub function opus(): u8[] {
  return file("");
}

// Two seconds of a 440 Hz tone in an Opus file of 8021 bytes, longer than
// the smallest window of a deck.
pub function long_opus(): u8[] {
  return file("");
}
