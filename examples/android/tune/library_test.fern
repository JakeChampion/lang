// Tests of the library of the player on the host: the names that the
// scan does not ask about, and the track of a file from its tags or from
// its path.
import "std/result";
import "std/test";
import "./fixture";
import "./library";
import "./tune";

// The scan asks the device about a name only when it can be a directory.
function test_other_files(): test.TestOutcome {
  let got = "";
  for name in ["cover.JPG", "notes.txt", "film.mp4", "Mr. Bungle", "Vol. 2", "First Light", "a.wav"] {
    got = got + library.other_file(name).to_string() + " ";
  }
  return test.assert_eq(got.trim(), "true true true false false false false");
}

function test_numbered(): test.TestOutcome {
  let got = "";
  for name in ["03 Song", "7. Song", "12-Song", "1999", "Song 2", "100 Years", "1234 Song"] {
    let (n, rest) = library.numbered(name);
    got = got + n.to_string() + ":" + rest + " ";
  }
  return test.assert_eq(got.trim(), "3:Song 7:Song 12:Song 0:1999 0:Song 2 100:Years 0:1234 Song");
}

function show(t: Option[tune.Track]): string {
  if let Some(k) = t {
    return k.title + "," + k.artist + "," + k.album + "," + k.by + "," + k.number.to_string() + "," + k.format;
  }
  return "none";
}

function test_a_file_with_no_tags_takes_its_path(): test.TestOutcome {
  let file = library.demo_file(1).unwrap_or([]);
  let roots = ["/data/music", "/sdcard/Music"];
  let deep = show(library.track(roots, "/sdcard/Music/Fern/First Light/02 Slow_Water.wav", file.len() as i64, library.parts_of(file)));
  let album = show(library.track(roots, "/sdcard/Music/Mixes/Slow Water.wav", file.len() as i64, library.parts_of(file)));
  let loose = show(library.track(roots, "/data/music/Slow Water.wav", file.len() as i64, library.parts_of(file)));
  let other = show(library.track(roots, "/sdcard/Music/notes.txt", file.len() as i64, library.parts_of(file))) + " " + show(library.track(roots, "/sdcard/Music/empty.wav", 0i64, library.parts_of([])));
  return test.assert_eq(deep + " | " + album + " | " + loose + " | " + other, "Slow Water,Fern,First Light,Fern,2,WAV | Slow Water,Unknown artist,Mixes,Unknown artist,0,WAV | Slow Water,Unknown artist,Unknown album,Unknown artist,0,WAV | none none");
}

function of(name: string, file: u8[]): string {
  if let Some(t) = library.track(["m"], "m/" + name, file.len() as i64, library.parts_of(file)) {
    return t.title + " " + t.ms.to_string();
  }
  return "none";
}

// 100 frames of 1152 samples at 44100 Hz are 2612 ms. The bytes of 100
// frames at 128 kbit/s are 2606 ms.
function test_the_length_of_an_mp3_file(): test.TestOutcome {
  let told = of("told.mp3", fixture.silent_mp3(100, true));
  let rate = of("rate.mp3", fixture.silent_mp3(100, false));
  let old = of("old.mp3", fixture.joined(fixture.silent_mp3(100, false), fixture.id3v1("Old Tag")));
  let long = of("long.mp3", fixture.joined(fixture.id3v2("Long Tag", 300000), fixture.silent_mp3(100, true)));
  return test.assert_eq(told + " | " + rate + " | " + old + " | " + long, "told 2612 | rate 2606 | Old Tag 2614 | Long Tag 2612");
}

// A function that gives 131072 bytes of a file at most, as the device
// does for a scan.
function small_parts(file: u8[]): (i64, i32) => u8[] {
  let all = library.parts_of(file);
  return (at: i64, n: i32): u8[] => {
    if (n > 131072) {
      return [];
    }
    return all(at, n);
  };
}

function test_a_scan_reads_parts_of_a_file(): test.TestOutcome {
  let got = "";
  for which in 0..3 {
    let file = library.demo_file(which).unwrap_or([]);
    let path = "m/" + library.demo_name(which);
    let Some(whole) = library.track(["m"], path, file.len() as i64, library.parts_of(file)) else {
      return test.fail("the whole file gave no track");
    };
    let Some(part) = library.track(["m"], path, file.len() as i64, small_parts(file)) else {
      return test.fail("the parts of the file gave no track");
    };
    got = got + (file.len() > 262144).to_string() + " " + (whole.ms == part.ms && whole.ms > 1000i64).to_string() + " ";
  }
  return test.assert_eq(got.trim(), "true true true true true true");
}

function tagged(name: string, file: u8[]): string {
  if let Some(t) = library.track(["m"], "m/" + name, file.len() as i64, library.parts_of(file)) {
    return t.format + " " + t.title + "," + t.artist + "," + t.album + "," + t.number.to_string() + " " + (t.ms >= 940i64 && t.ms <= 1060i64).to_string();
  }
  return "none";
}

function test_m4a_ogg_and_opus_files(): test.TestOutcome {
  return test.assert_eq(tagged("a.m4a", fixture.m4a()) + " | " + tagged("b.ogg", fixture.ogg()) + " | " + tagged("c.opus", fixture.opus()), "M4A Short m4a,Fixture,Formats,2 true | OGG Short ogg,Fixture,Formats,2 true | OPUS Short opus,Fixture,Formats,2 true");
}

// A picture of 200 KB is before the title of the tag: the scan reads the
// title and the picture from more than the first 128 KB of the file.
function test_a_picture_in_a_tag(): test.TestOutcome {
  let file = fixture.joined(fixture.id3v2_picture("Painted", 200000), fixture.silent_mp3(100, true));
  let small = fixture.joined(fixture.id3v2_picture("Small", 500), fixture.silent_mp3(100, true));
  let bare = fixture.silent_mp3(100, true);
  let got = of("p.mp3", file) + " " + library.picture(file.len() as i64, library.parts_of(file)).len().to_string() + " " + library.picture(small.len() as i64, library.parts_of(small)).len().to_string() + " " + library.picture(bare.len() as i64, library.parts_of(bare)).len().to_string();
  let names = library.picture_name("Cover.JPG").to_string() + " " + library.picture_name("folder.png").to_string() + " " + library.picture_name("back.jpg").to_string();
  return test.assert_eq(got + " | " + names, "Painted 2612 200000 500 0 | true true false");
}

function test_the_text_of_a_library(): test.TestOutcome {
  let tracks = [tune.Track { path: "/m/a b/01 x.mp3", title: "A\ttab", artist: "Ar; Second / Third feat. Ar", album: "Al", by: "By", number: 3, year: 1999, format: "MP3", ms: 123456i64, genre: "Field Recording", artists: [] }, tune.plain("/m/y.wav", "Y", "WAV", 0i64)];
  let text = library.to_text(tracks);
  let back = library.from_text(text + "\nnot a line\n");
  let got = back.len().to_string() + " " + back[0].path + "|" + back[0].title + "|" + back[0].by + "|" + back[0].number.to_string() + "|" + back[0].year.to_string() + "|" + back[0].ms.to_string() + "|" + back[0].genre + "|" + back[0].artists.join(",") + " " + back[1].title + "|" + back[1].artist + "|" + back[1].genre.len().to_string() + " " + library.from_text("").len().to_string();
  return test.assert_eq(got, "2 /m/a b/01 x.mp3|A tab|By|3|1999|123456|Field Recording|Ar,Second,Third Y|Unknown artist|0 0");
}

function test_playlist_texts(): test.TestOutcome {
  let lists = [tune.Playlist { name: "Road", paths: ["/m/a.mp3", "/m/b c.flac"] }, tune.Playlist { name: "Empty", paths: [] }];
  let back = library.lists_from(library.lists_text(lists));
  let got = back.len().to_string() + " " + back[0].name + ":" + back[0].paths.join(",") + " " + back[1].name + ":" + back[1].paths.len().to_string();
  let m3u = library.m3u_paths("/m/Fern", "#EXTM3U\r\n#EXTINF:1,x\r\nFirst Light/01 a.flac\r\n../b.mp3\n/abs/c.wav\nwin\\\\d.mp3\n\n").join("|");
  let paths = ["/m/Fern/x/a.flac", "/other/b.mp3"];
  let text = library.m3u_text("/m/Fern", paths);
  let again = library.m3u_paths("/m/Fern", text).join("|");
  return test.assert_eq(got + " / " + m3u + " / " + library.playlist_name("Mix.M3U8").to_string() + library.playlist_name("a.mp3").to_string() + " / " + text.replace("\n", ";") + " " + again, "2 Road:/m/a.mp3,/m/b c.flac Empty:0 / /m/Fern/First Light/01 a.flac|/m/b.mp3|/abs/c.wav|/m/Fern/win/d.mp3 / truefalse / #EXTM3U;x/a.flac;/other/b.mp3; /m/Fern/x/a.flac|/other/b.mp3");
}

function test_the_lines_of_lyrics(): test.TestOutcome {
  let show = (lines: tune.Line[]): string => lines.map((l: tune.Line): string => l.ms.to_string() + "=" + l.text).join("|");
  let timed = library.lrc("[ar:Fern]\r\n[00:12.50]Second line\r\n[00:01]First\n[01:02.345][00:20.5] Twice \nno time\n\n");
  let plain = library.lrc("One\n\n  Two  \n[x] not a tag\n");
  return test.assert_eq(show(timed) + " / " + show(plain) + " / " + library.lrc("").len().to_string() + " " + tune.line_at(timed, 12499i64).to_string() + tune.line_at(timed, 12500i64).to_string() + tune.line_at(timed, 0i64).to_string(), "1000=First|12500=Second line|20500=Twice|62345=Twice / -1=One|-1=Two|-1=[x] not a tag / 0 01-1");
}

// The place of the player is a text: its queue keeps the order of the
// paths, and a path keeps its spaces.
function test_the_text_of_the_place(): test.TestOutcome {
  let p = tune.Place { paths: ["/m/b c.flac", "/m/a.mp3"], spot: 1, at_ms: 61234i64, shuffle: true, repeat: tune.REPEAT_ALL };
  let back = library.place_from(library.place_text(p) + "\nnot a line\ntrack \n");
  let none = library.place_from("");
  let got = [back.paths.join("|"), back.spot.to_string(), back.at_ms.to_string(), back.shuffle.to_string(), back.repeat.to_string(), none.paths.len().to_string() + " " + none.spot.to_string()];
  return test.assert_eq(got.join(" / "), "/m/b c.flac|/m/a.mp3 / 1 / 61234 / true / " + tune.REPEAT_ALL.to_string() + " / 0 -1");
}

function test_the_text_of_the_settings(): test.TestOutcome {
  let p = tune.Prefs { look: tune.LOOK_DARK, sort: tune.BY_YEAR, hidden: ["/m/a b", "/m/c"], off: [tune.GENRES, tune.FOLDERS], level: tune.LEVEL_ALBUM, tint: false, fade: 6, tone: [-3, 0, 12, 0, 5] };
  let back = library.prefs_from(library.prefs_text(p) + "\nnot a line\nhidden \n");
  let none = library.prefs_from("");
  let got = [back.look.to_string(), back.sort.to_string(), back.hidden.join(","), back.off.map((t: i32): string => t.to_string()).join(","), none.look.to_string() + none.sort.to_string() + none.hidden.len().to_string() + none.off.len().to_string() + back.level.to_string() + none.level.to_string() + back.tint.to_string() + none.tint.to_string(), back.fade.to_string() + none.fade.to_string(), back.tone.map((db: i32): string => db.to_string()).join(",") + " " + none.tone.len().to_string()];
  return test.assert_eq(got.join(" | "), "2 | 2 | /m/a b,/m/c | 4,5 | 000021falsetrue | 60 | -3,0,12,0,5 5");
}

function main(): i32 {
  let r = test.new("examples/android/tune library");
  r = r.it("a name that ends as a file that is not sound", test_other_files);
  r = r.it("a file name starts with a number", test_numbered);
  r = r.it("a file with no tags takes its artist and its album from its path", test_a_file_with_no_tags_takes_its_path);
  r = r.it("an MP3 file tells its length, or its bytes and its bit rate do", test_the_length_of_an_mp3_file);
  r = r.it("a scan reads parts of a file", test_a_scan_reads_parts_of_a_file);
  r = r.it("an M4A, an Ogg Vorbis and an Opus file give their tags and their length", test_m4a_ogg_and_opus_files);
  r = r.it("a tag gives the picture of its album", test_a_picture_in_a_tag);
  r = r.it("the library is a text that the player reads back", test_the_text_of_a_library);
  r = r.it("the playlists are a text, and an M3U file gives paths", test_playlist_texts);
  r = r.it("lyrics are lines with times or with none", test_the_lines_of_lyrics);
  r = r.it("the settings are a text", test_the_text_of_the_settings);
  r = r.it("the place of the player is a text", test_the_text_of_the_place);
  return r.finish();
}
