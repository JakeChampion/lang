// Runs the music player on the simulator of std/android/ui/sim, on the
// host, with a device that plays nothing. The device takes the samples of
// 20 ms at each write, as a stream of sound does in the time between two
// writes. With TUNE_UI_PNG set to a directory, the test writes the screens
// there as PNG files.
import "std/android/draw";
import "std/android/fonts";
import "std/android/testkit";
import "std/android/text";
import "std/android/ui/sim";
import "std/audio/wire";
import "std/i32";
import "std/i64";
import "std/result";
import "std/test";
import "./library";
import "./player";
import "./tune";

function font_dir(): string {
  if let Ok(_) = read_file_bytes("examples/android/paper/testfonts/Roboto-Regular.ttf") {
    return "examples/android/paper/testfonts";
  }
  return "../paper/testfonts";
}

function test_fonts(): text.Fonts {
  let ws = [400, 500, 700];
  let found: Option[fonts.Found][] = [];
  for w in ws {
    found = found.append(fonts.find_in(font_dir(), "Roboto", w));
  }
  return text.load(found, ws, (path: string): u8[] => read_file_bytes(path).unwrap_or([]));
}

// A WAV file with a LIST chunk of the type INFO after its sound.
function tagged(file: u8[], title: string, artist: string, album: string, number: string, year: string): u8[] {
  let info: u8[] = [73u8, 78u8, 70u8, 79u8];
  for pair in [("INAM", title), ("IART", artist), ("IPRD", album), ("ITRK", number), ("ICRD", year)] {
    let (id, text) = pair;
    for i in 0..4 {
      info = info.append(id[i]);
    }
    info = wire.put_le(info, text.len() as u64, 4);
    for i in 0..text.len() {
      info = info.append(text[i]);
    }
    if (text.len() % 2 == 1) {
      info = info.append(0u8);
    }
  }
  let out: u8[] = [82u8, 73u8, 70u8, 70u8];
  out = wire.put_le(out, (file.len() - 8 + 8 + info.len()) as u64, 4);
  for i in 8..file.len() {
    out = out.append(file[i]);
  }
  for b in [76u8, 73u8, 83u8, 84u8] {
    out = out.append(b);
  }
  out = wire.put_le(out, info.len() as u64, 4);
  for b in info {
    out = out.append(b);
  }
  return out;
}

// The files of the test: the three tunes of the player in the directories
// of their artist and their albums, one file with tags, and one file that
// is not sound.
function read(path: string): u8[] {
  for which in 0..3 {
    if (path.ends_with(library.demo_name(which))) {
      return library.demo_file(which).unwrap_or([]);
    }
  }
  if (path.ends_with("x1.wav")) {
    return tagged(library.demo_file(2).unwrap_or([]), "Tagged Song", "Ada", "Numbers", "2", "2020");
  }
  return [110u8, 111u8, 116u8, 32u8, 115u8, 111u8, 117u8, 110u8, 100u8];
}

function paths(): string[] {
  return ["music/" + library.demo_name(2), "music/loose/x1.wav", "music/" + library.demo_name(0), "music/" + library.demo_name(1), "music/Fern/cover.mp3"];
}

function device(): player.Device {
  return player.Device {
    files: (): string[] => paths(),
    roots: ["music"],
    read: (path: string): u8[] => read(path),
    open: (rate: i32, channels: i32): tune.Sound => tune.Sound { ptr: 1 as usize, rate: rate, channels: channels },
    start: (s: tune.Sound): void => {},
    pause: (s: tune.Sound): void => {},
    flush: (s: tune.Sound): void => {},
    close: (s: tune.Sound): void => {},
    write: (s: tune.Sound, samples: [i32]): i32 => samples.len().min(s.rate * s.channels / 50),
  };
}

// A phone of 1080 by 2400 pixels at 2.75 pixels to the dp, after the
// player read its files. The library is in this order: Tagged Song by Ada,
// then Morning Fern and Slow Water on First Light, then Quick Light on
// Second Light.
function started_from(own m: tune.Model): sim.Sim[tune.Model, tune.Msg] {
  return sim.after(sim.start(m, player.program(device()), test_fonts(), 1080, 2400, 2.75), 50i64);
}

function started(): sim.Sim[tune.Model, tune.Msg] {
  return started_from(tune.start(paths()));
}

function saved(s: sim.Sim[tune.Model, tune.Msg], name: string): void {
  if let Some(out) = env("TUNE_UI_PNG") {
    let fr = sim.picture(s);
    let ok = testkit.save_png(fr, out + "/" + name + ".png");
    draw.release(fr);
  }
}

function near(got: i64, want: i64, by: i64): boolean {
  return got >= want - by && got <= want + by;
}

function titles(m: tune.Model): string {
  let out: string[] = [];
  for t in m.tracks {
    out = out.append(t.title);
  }
  return out.join("|");
}

function test_scan_reads_tags_and_paths(): test.TestOutcome {
  let before = sim.start(tune.start(paths()), player.program(device()), test_fonts(), 1080, 2400, 2.75);
  let reading = sim.shows(before, "0 songs · reading 5 files") || sim.shows(before, "1 song · reading 4 files");
  let s = started();
  let m = s.shell.app;
  let ada = m.tracks[0];
  let fern = m.tracks[2];
  let got = reading.to_string() + " " + titles(m) + " " + m.scan.len().to_string() + " / " + ada.artist + "," + ada.album + "," + ada.number.to_string() + "," + ada.year.to_string() + " / " + fern.artist + "," + fern.album + "," + fern.number.to_string() + "," + fern.format;
  return test.assert_eq(got, "true Tagged Song|Morning Fern|Slow Water|Quick Light 0 / Ada,Numbers,2,2020 / Fern,First Light,2,WAV");
}

function test_songs_and_search(): test.TestOutcome {
  let s = started();
  let all = sim.shows(s, "4 songs").to_string() + " " + sim.shows(s, "Morning Fern").to_string() + " " + sim.shows(s, "Fern · First Light").to_string();
  s = sim.type_in(s, "search", "slow");
  let one = sim.shows(s, "1 song").to_string() + " " + sim.shows(s, "Slow Water").to_string() + " " + sim.shows(s, "Morning Fern").to_string();
  // The search looks at the artist and the album too.
  s = sim.type_in(s, "search", "numbers");
  return test.assert_eq(all + " " + one + " " + sim.shows(s, "Tagged Song").to_string(), "true true true true true false true");
}

function test_artists_and_albums(): test.TestOutcome {
  let s = sim.tap(started(), "Artists");
  let artists = sim.shows(s, "2 artists").to_string() + " " + sim.shows(s, "1 album · 1 song").to_string() + " " + sim.shows(s, "2 albums · 3 songs").to_string();
  s = sim.tap(s, "Fern");
  saved(s, "tune-artist");
  let albums = sim.shows(s, "2 albums").to_string() + " " + sim.shows(s, "Fern · 2 songs").to_string() + " " + sim.shows(s, "Second Light").to_string() + " " + sim.shows(s, "Numbers").to_string();
  s = sim.tap(s, "First Light");
  saved(s, "tune-album");
  let songs = sim.shows(s, "1. Morning Fern").to_string() + " " + sim.shows(s, "2. Slow Water").to_string() + " " + sim.shows(s, "Quick Light").to_string();
  // The back key goes up to the artist, then to the list of the artists.
  s = sim.back(s);
  let up = s.shell.app.artist + "," + s.shell.app.album;
  s = sim.back(s);
  let top = sim.shows(s, "2 artists").to_string() + " " + sim.finished(s).to_string();
  s = sim.tap(s, "Albums");
  let all = sim.shows(s, "3 albums").to_string() + " " + sim.shows(s, "Ada · 1 song · 2020").to_string();
  return test.assert_eq(artists + " / " + albums + " / " + songs + " / " + up + " / " + top + " / " + all, "true true true / true true true false / true true false / Fern, / true false / true true");
}

function test_a_tap_plays_a_track(): test.TestOutcome {
  let s = sim.tap(started(), "Quick Light");
  let m = s.shell.app;
  let first = m.current.to_string() + " " + m.playing.to_string() + " " + m.sound.rate.to_string() + " " + m.sound.channels.to_string() + " " + (m.length_ms > 1500i64).to_string();
  s = sim.after(s, 1000i64);
  saved(s, "tune-library");
  let at = s.shell.app.at_ms;
  return test.assert_eq(first + " " + near(at, 1000i64, 250i64).to_string() + " " + sim.shows(s, "Pause").to_string(), "3 true 44100 2 true true true");
}

function test_pause_and_seek(): test.TestOutcome {
  let s = sim.after(sim.tap(started(), "Slow Water"), 500i64);
  s = sim.tap(s, "Pause");
  let held = s.shell.app.at_ms;
  s = sim.after(s, 500i64);
  let still = s.shell.app.at_ms == held && !s.shell.app.playing;
  s = sim.tap(s, "Now playing, Slow Water");
  let length = s.shell.app.length_ms;
  s = sim.slide(s, "Position", 0.5);
  saved(s, "tune-now-playing");
  let sought = near(s.shell.app.at_ms, length / 2i64, 300i64);
  s = sim.after(sim.tap(s, "Play"), 400i64);
  let after = near(s.shell.app.at_ms, length / 2i64 + 400i64, 300i64);
  return test.assert_eq(still.to_string() + " " + sim.shows(s, "Fern · First Light").to_string() + " " + sought.to_string() + " " + after.to_string(), "true true true true");
}

function test_the_next_track_plays_at_the_end(): test.TestOutcome {
  // The library has one more track, whose file is not sound. It is by no
  // artist, so it is the last one.
  let with_gone = tune.update(tune.start(paths()), tune.Found(tune.plain("music/Gone.mp3", "Gone", "MP3", 0i64)));
  let s = sim.tap(started_from(with_gone), "Slow Water");
  let length = s.shell.app.length_ms;
  s = sim.after(s, length + 300i64);
  let next = s.shell.app.current.to_string() + " " + s.shell.app.playing.to_string();
  let quick = s.shell.app.length_ms;
  s = sim.after(s, quick + 300i64);
  // The player tells that it cannot play the file, and stops.
  return test.assert_eq(next + " " + s.shell.app.current.to_string() + " " + s.shell.app.playing.to_string() + " " + sim.shows(s, "Tune cannot play Gone").to_string(), "3 true 4 false true");
}

function test_repeat_and_previous(): test.TestOutcome {
  let s = sim.tap(sim.tap(started(), "Quick Light"), "Now playing, Quick Light");
  s = sim.tap(s, "Repeat off");
  let length = s.shell.app.length_ms;
  s = sim.after(s, length + 300i64);
  let repeated = s.shell.app.current.to_string() + " " + near(s.shell.app.at_ms, 300i64, 250i64).to_string();
  s = sim.tap(s, "Previous");
  let before = s.shell.app.current;
  s = sim.tap(sim.after(s, 3500i64), "Previous");
  return test.assert_eq(repeated + " " + before.to_string() + " " + s.shell.app.current.to_string() + " " + near(s.shell.app.at_ms, 0i64, 100i64).to_string(), "3 true 2 2 true");
}

function test_back_closes_the_track_then_the_app(): test.TestOutcome {
  let s = sim.tap(sim.tap(started(), "Slow Water"), "Now playing, Slow Water");
  let open = s.shell.app.open;
  s = sim.back(s);
  let closed = !s.shell.app.open && !sim.finished(s);
  return test.assert_eq(open.to_string() + " " + closed.to_string() + " " + sim.finished(sim.back(s)).to_string(), "true true true");
}

function test_a_player_with_no_files_looks_for_them(): test.TestOutcome {
  // The app starts the player with no file. The first frame shows an empty
  // library, and the player asks the device for its files after it.
  let s = sim.start(tune.start([]), player.program(device()), test_fonts(), 1080, 2400, 2.75);
  let first = sim.shows(s, "0 songs").to_string() + " " + s.shell.app.tracks.len().to_string();
  s = sim.after(s, 200i64);
  return test.assert_eq(first + " " + s.shell.app.tracks.len().to_string() + " " + sim.shows(s, "4 songs").to_string(), "true 0 4 true");
}

function test_a_scan_adds_no_track_two_times(): test.TestOutcome {
  // The track that plays keeps its place when the player reads the files
  // again.
  let s = sim.tap(started(), "Slow Water");
  s = sim.after(sim.tap(s, "Scan"), 50i64);
  return test.assert_eq(s.shell.app.tracks.len().to_string() + " " + s.shell.app.scan.len().to_string() + " " + s.shell.app.current.to_string() + " " + s.shell.app.playing.to_string(), "4 0 2 true");
}

function main(): i32 {
  let r = test.new("examples/android/tune");
  r = r.it("the scan reads the tags and the paths of its files", test_scan_reads_tags_and_paths);
  r = r.it("the songs show, and the search finds a title or an album", test_songs_and_search);
  r = r.it("an artist has its albums, and an album has its songs", test_artists_and_albums);
  r = r.it("a tap plays a track in time", test_a_tap_plays_a_track);
  r = r.it("a track stops, and goes to a part of its length", test_pause_and_seek);
  r = r.it("the next track plays at the end, and a bad file stops the player", test_the_next_track_plays_at_the_end);
  r = r.it("a track plays again, and the track before it plays", test_repeat_and_previous);
  r = r.it("the back key closes the track, then the app", test_back_closes_the_track_then_the_app);
  r = r.it("a player with no files shows its screen, then looks for them", test_a_player_with_no_files_looks_for_them);
  r = r.it("a scan adds no track two times", test_a_scan_adds_no_track_two_times);
  return r.finish();
}
