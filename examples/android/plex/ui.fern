// The look of Fern for Plex, in the dot-matrix style of ../look.fern: a
// black screen, white and grey dots, and red only for what is live. The
// labels of the app are in the dot font of ../matrix.fern, and the text of
// the server is in the text font. `nodes` lays out a screen as a list of
// nodes of std/android/ui/scene: a rectangle, what it shows, and the action
// that a tap on it starts. The drawing and the touches use that one layout.
// Every function is pure: a paint writes only into the frame that it gets.
import "core/map";
import "std/android/draw";
import "std/android/ui/scene";
import "std/i18n";
import "std/kv";
import "std/string";
import "std/textwrap";
import "../look";
import "../matrix";
import "./plex";

pub const LOGIN: i32 = 0;

pub const SERVERS: i32 = 1;

pub const HOME: i32 = 2;

pub const SECTIONS: i32 = 3;

pub const LIBRARY: i32 = 4;

pub const DETAIL: i32 = 5;

pub const SEARCH: i32 = 6;

pub const SETTINGS: i32 = 7;

pub const PLAYER: i32 = 8;

pub const USERS: i32 = 9;

// The list of the downloads of the app.
pub const DOWNLOADS: i32 = 10;

// The tabs of the bar at the bottom, and the screen of each.
pub function tab_names(): string[] {
  return ["Home", "Libraries", "Search", "Settings"];
}

pub function tab_screens(): i32[] {
  return [HOME, SECTIONS, SEARCH, SETTINGS];
}

// --- what a screen shows

// `over_video` is true when the controls draw over the video as it plays.
// `skip` is the words of the skip button of an intro or credits, or "".
// `up_next` is the title of the next item and `up_next_secs` the seconds
// before it plays, or -1 with no card.
// `sheet` is true when the sheet of the sound and subtitle tracks shows,
// with `choice` marked. `scrub_ms` is the time under a finger on the seek
// bar, or -1, and `thumb` the preview thumbnail of that time, by
// `thumb_key`.
pub struct PlayerView { title: string, subtitle: string, position_ms: i64, duration_ms: i64, paused: boolean, buffering: boolean, overlay: boolean, over_video: boolean, skip: string, up_next: string, up_next_secs: i32, badge: string, sheet: boolean, sounds: plex.Track[], subtitles: plex.Track[], choice: plex.Choice, speed: string, shuffle: boolean, repeat: string, sleep: string, has_next: boolean, caption: string, scrub_ms: i64, thumb: Option[draw.Image], thumb_key: string, art: string, audio: boolean, status: string }

pub function no_player(): PlayerView {
  return PlayerView { title: "", subtitle: "", position_ms: 0i64, duration_ms: 0i64, paused: false, buffering: false, overlay: false, over_video: false, skip: "", up_next: "", up_next_secs: -1, badge: "", sheet: false, sounds: [], subtitles: [], choice: plex.no_choice(), speed: "1x", shuffle: false, repeat: "", sleep: "", has_next: false, caption: "", scrub_ms: -1i64, thumb: None, thumb_key: "", art: "", audio: false, status: "" };
}

pub struct View {
  w: i32,
  h: i32,
  // The heights of the status bar at the top and of the navigation bar at
  // the bottom, which cover the window.
  top: i32,
  bottom: i32,
  screen: i32,
  tab: i32,
  title: string,
  scroll: i32,
  rows: i32[],
  hubs: plex.Hub[],
  sections: plex.Section[],
  items: plex.Item[],
  total: i32,
  sort: i32,
  unwatched: boolean,
  letters: plex.Letter[],
  // The item of the menu of a held poster, or no_item, and the part of its
  // download that came in percent, or -1 when it has none.
  menu: plex.Item,
  menu_download: i32,
  // The rows of the screen of the downloads.
  saved: SavedRow[],
  users: plex.HomeUser[],
  pin_for: string,
  pin_digits: string,
  item: plex.Item,
  children: plex.Item[],
  pin_code: string,
  status: string,
  error: string,
  // True on the home screen with no server, where only the downloads show.
  offline: boolean,
  servers: plex.Server[],
  server_states: string[],
  query: string,
  typing: boolean,
  account: string,
  server_name: string,
  quality: string,
  player: PlayerView,
  base: plex.Base,
  loading: boolean,
  // The images that the app has, by their keys.
  cache: Map[string, draw.Image],
  // The texts of the language of the person.
  texts: i18n.Strings,
}

// The texts in English: each key is its own text.
pub function english(): i18n.Strings {
  return i18n.strings("en", kv.empty("en.kv"), kv.empty("en.kv"));
}

pub function empty_view(w: i32, h: i32): View {
  return View { w: w, h: h, top: 0, bottom: 0, screen: LOGIN, tab: 0, title: "", scroll: 0, rows: [], hubs: [], sections: [], items: [], total: 0, sort: 0, unwatched: false, letters: [], menu: plex.no_item(), menu_download: -1, saved: [], users: [], pin_for: "", pin_digits: "", item: plex.no_item(), children: [], pin_code: "", status: "", error: "", offline: false, servers: [], server_states: [], query: "", typing: false, account: "", server_name: "", quality: "", player: no_player(), base: plex.Base { uri: "", token: "" }, loading: false, cache: map_new(16), texts: english() };
}

// --- metrics

// `u` is the size of a density-independent pixel, and `ts` the scale of the
// text, for a window of w by h. The system bars cover `top` pixels at the
// top of the window and `bottom` pixels at its bottom.
pub struct Metrics { w: i32, h: i32, top: i32, bottom: i32, u: i32, ts: i32, cw: i32, th: i32, texts: i18n.Strings }

pub function metrics(w: i32, h: i32, top: i32, bottom: i32): Metrics {
  let short = w;
  if (h < short) {
    short = h;
  }
  let u = short / 360;
  if (u < 2) {
    u = 2;
  }
  let ts = (u + 1) / 3;
  if (ts < 1) {
    ts = 1;
  }
  return Metrics { w: w, h: h, top: top, bottom: bottom, u: u, ts: ts, cw: draw.text_width("x", ts), th: draw.text_height(ts), texts: english() };
}

// The pixels from dot to dot of the small dot-matrix words, such as the
// tabs and the headings of the rows, and of the title of a screen.
pub function small_pitch(m: Metrics): i32 {
  return m.u * 3 / 2;
}

pub function title_pitch(m: Metrics): i32 {
  return 2 * m.u;
}

pub function top_height(m: Metrics): i32 {
  return m.top + 56 * m.u;
}

pub function bottom_height(m: Metrics): i32 {
  return 64 * m.u + m.bottom;
}

pub function has_tabs(screen: i32): boolean {
  return screen != LOGIN && screen != SERVERS && screen != PLAYER;
}

// A card of a poster: the width of the image, and the height of the image
// and its two lines of text.
pub function card_width(m: Metrics): i32 {
  return 112 * m.u;
}

pub function card_height(m: Metrics, w: i32): i32 {
  return w * 3 / 2 + 2 * m.th + 10 * m.u;
}

// --- nodes

// The start of the key of the paint of an image that the app does not
// have yet.
const WANTED: string = "wanted|";

function mk(x: i32, y: i32, w: i32, h: i32, paint: scene.Paint, act: string, group: string): scene.Node {
  return scene.Node { ...scene.node(x, y, w, h, paint), tap: scene.Action { name: act, arg: 0 }, group: group };
}

function fill(x: i32, y: i32, w: i32, h: i32, color: i32, r: i32): scene.Node {
  return scene.node(x, y, w, h, scene.Fill(color, r));
}

// Text in the dot font of std/android/draw, at `scale` pixels to the dot.
function label(m: Metrics, x: i32, y: i32, s: string, scale: i32, color: i32): scene.Node {
  let key = "text|" + scale.to_string() + "|" + color.to_string() + "|" + s;
  let n = scene.node(x, y, draw.text_width(s, scale), draw.text_height(scale), scene.Custom(key, 0, (f: draw.Frame, bx: i32, by: i32, bw: i32, bh: i32): void => f.text(bx, by, s, scale, color)));
  return scene.Node { ...n, say: s };
}

function tap(n: scene.Node, act: string): scene.Node {
  return scene.Node { ...n, tap: scene.Action { name: act, arg: 0 } };
}

// Words in the dot-matrix font, `pitch` pixels from dot to dot.
function dots(x: i32, y: i32, s: string, pitch: i32, color: i32): scene.Node {
  let key = "dots|" + pitch.to_string() + "|" + color.to_string() + "|" + s;
  let n = scene.node(x, y, matrix.width(s, pitch), matrix.height(pitch), scene.Custom(key, 0, (f: draw.Frame, bx: i32, by: i32, bw: i32, bh: i32): void => matrix.text(f, bx, by, s, pitch, color)));
  return scene.Node { ...n, say: s };
}

// `s` cut to `w` pixels of dots at `pitch`, with "..." when it is longer.
pub function fit_dots(s: string, w: i32, pitch: i32): string {
  if (matrix.width(s, pitch) <= w) {
    return s;
  }
  let cells = (w / pitch + 1) / (matrix.COLS + 1) - 3;
  if (cells <= 0) {
    return "";
  }
  return s.take(cells).trim() + "...";
}

// A heading of at most `w` pixels: dot-matrix words when the dot font has
// each character of `s`, else the text font.
function heading(m: Metrics, x: i32, y: i32, w: i32, s: string, pitch: i32, color: i32): scene.Node {
  if (matrix.covers(s)) {
    return scene.Node { ...dots(x, y, fit_dots(s, w, pitch), pitch, color), say: s };
  }
  return label(m, x, y + (matrix.height(pitch) - m.th) / 2, fit(s, w / m.cw), m.ts, color);
}

// The text of `key` in the language of the person.
function tr(m: Metrics, key: string): string {
  return m.texts.text(key);
}

// A rounded card of the surface colour.
function panel(m: Metrics, x: i32, y: i32, w: i32, h: i32): scene.Node {
  return fill(x, y, w, h, look.surface(), 14 * m.u);
}

// A red dot with its centre at x and y: the sign of what is live.
function live_dot(m: Metrics, x: i32, y: i32): scene.Node {
  return fill(x - 3 * m.u, y - 3 * m.u, 6 * m.u, 6 * m.u, look.red(), 3 * m.u);
}

// The image with `key` and round corners of `r`. Until the app has the
// image, the node shows the surface colour.
function img(v: View, x: i32, y: i32, w: i32, h: i32, key: string, r: i32, act: string, group: string): scene.Node {
  if let Some(image) = v.cache.get(key) {
    return mk(x, y, w, h, scene.Picture(key, image, r), act, group);
  }
  return mk(x, y, w, h, scene.Custom(WANTED + key, 0, (f: draw.Frame, bx: i32, by: i32, bw: i32, bh: i32): void => f.round_rect(bx, by, bw, bh, r, look.surface())), act, group);
}

// A bar of the colour `back`, with its first `permille` thousandths in
// the colour `fg`.
function progress_bar(x: i32, y: i32, w: i32, h: i32, permille: i32, fg: i32, back: i32): scene.Node[] {
  return [fill(x, y, w, h, back, 0), fill(x, y, w * permille / 1000, h, fg, 0)];
}

// `s` cut to `cells` cells, with an ellipsis when it is longer.
pub function fit(s: string, cells: i32): string {
  if (cells <= 0) {
    return "";
  }
  if (draw.text_cells(s) <= cells) {
    return s;
  }
  let out = "";
  let n = 0;
  for c in s.chars() {
    if (n >= cells - 1) {
      break;
    }
    out += c.to_string();
    n += 1;
  }
  return out.trim() + "…";
}

pub function button_height(m: Metrics): i32 {
  return 44 * m.u;
}

// A button: a pill with dot-matrix words. The primary button is white with
// black dots, and the others are a white outline.
function button(m: Metrics, x: i32, y: i32, text: string, primary: boolean, act: string): scene.Node[] {
  let p = small_pitch(m);
  let ts = m.ts;
  let key = "button|" + p.to_string() + "|" + ts.to_string() + "|" + primary.to_string() + "|" + text;
  let n = scene.node(x, y, button_width(m, text), button_height(m), scene.Custom(key, 0, (f: draw.Frame, bx: i32, by: i32, bw: i32, bh: i32): void => paint_button(f, look.Rect { x: bx, y: by, w: bw, h: bh }, text, p, ts, primary)));
  return [scene.Node { ...tap(n, act), say: text }];
}

// The words of a button are dot-matrix words when the dot font has each
// character of them, else the text font.
function paint_button(f: draw.Frame, r: look.Rect, text: string, pitch: i32, ts: i32, primary: boolean): void {
  let color = look.ink();
  if (primary) {
    f.round_rect(r.x, r.y, r.w, r.h, r.h / 2, look.ink());
    color = look.bg();
  } else {
    let t = r.h / 24 + 1;
    f.round_rect(r.x, r.y, r.w, r.h, r.h / 2, look.ink());
    f.round_rect(r.x + t, r.y + t, r.w - 2 * t, r.h - 2 * t, r.h / 2 - t, look.bg());
  }
  if (matrix.covers(text)) {
    matrix.text(f, look.center_x(r, matrix.width(text, pitch)), r.y + (r.h - matrix.height(pitch)) / 2, text, pitch, color);
    return;
  }
  f.text(look.center_x(r, draw.text_width(text, ts)), r.y + (r.h - draw.text_height(ts)) / 2, text, ts, color);
}

function button_width(m: Metrics, text: string): i32 {
  if (matrix.covers(text)) {
    return matrix.width(text, small_pitch(m)) + 32 * m.u;
  }
  return draw.text_width(text, m.ts) + 32 * m.u;
}

// The size in pixels at which a card asks the server for its image.
pub function image_key(base: plex.Base, path: string, w: i32, h: i32): string {
  if (path.len() == 0 || base.uri.len() == 0) {
    return "";
  }
  return plex.image_url(base, path, w, h);
}

// A card of an item: the poster, its progress, a mark when watched, and two
// lines of text.
function card(m: Metrics, v: View, x: i32, y: i32, w: i32, it: plex.Item, act: string, group: string): scene.Node[] {
  let ih = w * 3 / 2;
  let r = 10 * m.u;
  let out: scene.Node[] = [img(v, x, y, w, ih, image_key(v.base, plex.poster(it), w, ih), r, act, group)];
  let p = plex.progress(it);
  if (p > 0) {
    out = util_append(out, progress_bar(x + 8 * m.u, y + ih - 10 * m.u, w - 16 * m.u, 3 * m.u, p, look.red(), draw.rgba(0, 0, 0, 170)));
  } else if (plex.watched(it)) {
    out = out.append(fill(x + w - 18 * m.u, y + 8 * m.u, 10 * m.u, 10 * m.u, look.ink(), 5 * m.u));
  }
  let cells = w / m.cw;
  out = out.append(label(m, x, y + ih + 6 * m.u, fit(plex.card_title(it), cells), m.ts, look.ink()));
  out = out.append(label(m, x, y + ih + 6 * m.u + m.th, fit(plex.card_subtitle(it), cells), m.ts, look.muted()));
  return out;
}

function top_bar(m: Metrics, v: View, back: boolean): scene.Node[] {
  let h = top_height(m);
  let p = title_pitch(m);
  let ty = m.top + (h - m.top - matrix.height(p)) / 2;
  let out: scene.Node[] = [fill(0, 0, m.w, h, look.bg(), 0)];
  let x = 16 * m.u;
  if (back) {
    out = out.append(tap(fill(0, 0, 48 * m.u, h, look.bg(), 0), "back"));
    out = out.append(dots(16 * m.u, ty, "<", p, look.ink()));
    x = 48 * m.u;
  }
  out = out.append(heading(m, x, ty, m.w - x - 40 * m.u, v.title, p, look.ink()));
  if (v.loading) {
    out = out.append(live_dot(m, m.w - 20 * m.u, (m.top + h) / 2));
  }
  return out;
}

function bottom_bar(m: Metrics, v: View): scene.Node[] {
  let h = bottom_height(m);
  let y = m.h - h;
  let line = m.u / 2;
  if (line < 1) {
    line = 1;
  }
  let out: scene.Node[] = [fill(0, y, m.w, h, look.bg(), 0), fill(0, y, m.w, line, look.outline(), 0)];
  let names = tab_names().map((n: string): string => tr(m, n));
  let cell = m.w / names.len();
  let p = small_pitch(m);
  for name in names {
    p = matrix.fit_pitch(name, cell - 8 * m.u, p);
  }
  let ty = y + (h - m.bottom - matrix.height(p)) / 2 + 6 * m.u;
  for i in 0..names.len() {
    out = out.append(tap(fill(i * cell, y, cell, h - m.bottom, look.bg(), 0), "tab:" + i.to_string()));
    let color = look.muted();
    if (i == v.tab) {
      color = look.ink();
      out = out.append(live_dot(m, i * cell + cell / 2, ty - 10 * m.u));
    }
    out = out.append(dots(i * cell + (cell - matrix.width(names[i], p)) / 2, ty, names[i], p, color));
  }
  return out;
}

// The top of the content of a screen, and its bottom.
pub function content_top(m: Metrics): i32 {
  return top_height(m);
}

pub function content_bottom(m: Metrics, screen: i32): i32 {
  if (has_tabs(screen)) {
    return m.h - bottom_height(m);
  }
  return m.h - m.bottom;
}

// --- the screens

function login(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let title = "FERN FOR PLEX";
  let big = matrix.fit_pitch(title, m.w - 48 * m.u, 4 * m.u);
  let cy = m.h / 3;
  out = out.append(dots((m.w - matrix.width(title, big)) / 2, cy, title, big, look.ink()));
  let sub = tr(m, "Your Plex libraries, in Fern");
  out = out.append(label(m, (m.w - draw.text_width(sub, m.ts)) / 2, cy + matrix.height(big) + 12 * m.u, sub, m.ts, look.muted()));
  let y = cy + matrix.height(big) + m.th + 48 * m.u;
  if (v.pin_code.len() == 0) {
    let text = tr(m, "Sign in with Plex");
    out = util_append(out, button(m, (m.w - button_width(m, text)) / 2, y, text, true, "signin"));
  } else {
    let hint = m.texts.format("Go to {0} and enter", [plex.LINK_PAGE]);
    out = out.append(label(m, (m.w - draw.text_width(hint, m.ts)) / 2, y, hint, m.ts, look.ink()));
    let code = spaced(v.pin_code);
    let cp = matrix.fit_pitch(code, m.w - 48 * m.u, 8 * m.u);
    out = out.append(dots((m.w - matrix.width(code, cp)) / 2, y + m.th + 20 * m.u, code, cp, look.ink()));
    let wait = tr(m, "WAITING FOR PLEX.TV");
    let sp = small_pitch(m);
    let ww = matrix.width(wait, sp);
    let wy = y + m.th + 40 * m.u + matrix.height(cp);
    out = out.append(live_dot(m, (m.w - ww) / 2 - 10 * m.u, wy + matrix.height(sp) / 2));
    out = out.append(dots((m.w - ww) / 2, wy, wait, sp, look.muted()));
    out = util_append(out, button(m, (m.w - button_width(m, tr(m, "Cancel"))) / 2, wy + matrix.height(sp) + 28 * m.u, tr(m, "Cancel"), false, "cancel"));
  }
  if (v.error.len() > 0) {
    out = util_append(out, wrapped(m, 24 * m.u, m.h - m.bottom - 120 * m.u, m.w - 48 * m.u, v.error, look.red()));
  }
  return out;
}

function spaced(code: string): string {
  let parts: string[] = [];
  for c in code.chars() {
    parts = parts.append(c.to_string());
  }
  return parts.join(" ");
}

function util_append(a: scene.Node[], b: scene.Node[]): scene.Node[] {
  let out = a;
  for n in b {
    out = out.append(n);
  }
  return out;
}

// The lines of `text` wrapped to `w` pixels, from y down.
function wrapped(m: Metrics, x: i32, y: i32, w: i32, text: string, color: i32): scene.Node[] {
  let out: scene.Node[] = [];
  let cells = w / m.cw;
  let at = y;
  for line in textwrap.word_wrap(text, cells).split("\n") {
    out = out.append(label(m, x, at, fit(line, cells), m.ts, color));
    at += m.th + 2 * m.u;
  }
  return out;
}

pub function wrapped_height(m: Metrics, w: i32, text: string): i32 {
  if (text.len() == 0) {
    return 0;
  }
  return textwrap.word_wrap(text, w / m.cw).split("\n").len() * (m.th + 2 * m.u);
}

// A short message of the app in small grey dots, such as "Loading".
function note(m: Metrics, y: i32, s: string): scene.Node {
  return heading(m, 16 * m.u, y, m.w - 32 * m.u, s, small_pitch(m), look.muted());
}

function servers(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let y = top_height(m) + 8 * m.u - v.scroll;
  let row = 72 * m.u;
  let i = 0;
  while (i < v.servers.len()) {
    let s = v.servers[i];
    out = out.append(tap(panel(m, 16 * m.u, y, m.w - 32 * m.u, row - 8 * m.u), "server:" + i.to_string()));
    out = out.append(label(m, 32 * m.u, y + 12 * m.u, fit(s.name, (m.w - 64 * m.u) / m.cw), m.ts, look.ink()));
    let state = "";
    if (i < v.server_states.len()) {
      state = v.server_states[i];
    }
    if (!s.owned) {
      state = "shared · " + state;
    }
    out = out.append(label(m, 32 * m.u, y + 16 * m.u + m.th, state, m.ts, look.muted()));
    y += row;
    i += 1;
  }
  if (v.servers.len() == 0 && !v.loading) {
    out = out.append(note(m, y, tr(m, "No servers on this account")));
    y += m.th + 16 * m.u;
  }
  out = util_append(out, button(m, 16 * m.u, y + 8 * m.u, tr(m, "Refresh"), false, "refresh"));
  if (v.error.len() > 0) {
    out = util_append(out, wrapped(m, 16 * m.u, y + 64 * m.u, m.w - 32 * m.u, v.error, look.red()));
  }
  return util_append(out, top_bar(m, View { ...v, title: tr(m, "Choose a server") }, false));
}

// The height of one row of hub cards, with its title.
pub function hub_row_height(m: Metrics): i32 {
  return matrix.height(small_pitch(m)) + 12 * m.u + card_height(m, card_width(m)) + 16 * m.u;
}

// The width of all the cards of a hub, for the limit of its scroll.
pub function hub_row_width(m: Metrics, n: i32): i32 {
  return 32 * m.u + n * (card_width(m) + 10 * m.u) - 10 * m.u;
}

function hubs(m: Metrics, v: View, top: i32): scene.Node[] {
  let out: scene.Node[] = [];
  let row_h = hub_row_height(m);
  let cw = card_width(m);
  let bottom = content_bottom(m, v.screen);
  let i = 0;
  while (i < v.hubs.len()) {
    let y0 = top + i * row_h - v.scroll;
    if (y0 + row_h >= content_top(m) && y0 < bottom) {
      let hub = v.hubs[i];
      out = out.append(heading(m, 16 * m.u, y0, m.w - 32 * m.u, hub.title, small_pitch(m), look.muted()));
      let dx = 0;
      if (i < v.rows.len()) {
        dx = v.rows[i];
      }
      let group = "row:" + i.to_string();
      let cy = y0 + matrix.height(small_pitch(m)) + 12 * m.u;
      out = out.append(mk(0, cy, m.w, card_height(m, cw), scene.Blank, "", group));
      let j = 0;
      while (j < hub.items.len()) {
        let x = 16 * m.u + j * (cw + 10 * m.u) - dx;
        if (x + cw > 0 && x < m.w) {
          out = util_append(out, card(m, v, x, cy, cw, hub.items[j], "hub:" + i.to_string() + ":" + j.to_string(), group));
        }
        j += 1;
      }
    }
    i += 1;
  }
  return out;
}

pub function home_height(m: Metrics, v: View): i32 {
  return v.hubs.len() * hub_row_height(m) + 16 * m.u;
}

function home(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  out = util_append(out, hubs(m, v, top_height(m) + 12 * m.u));
  if (v.hubs.len() == 0) {
    let msg = tr(m, "Nothing here yet");
    if (v.loading) {
      msg = tr(m, "Loading");
    }
    out = out.append(note(m, top_height(m) + 24 * m.u, msg));
  }
  if (v.error.len() > 0) {
    out = util_append(out, wrapped(m, 16 * m.u, content_bottom(m, v.screen) - 80 * m.u, m.w - 32 * m.u, v.error, look.red()));
  }
  if (v.offline) {
    out = out.append(note(m, content_bottom(m, v.screen) - 48 * m.u, tr(m, "Offline: the downloads play with no server")));
  }
  return out;
}

function sections(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let y = top_height(m) + 8 * m.u - v.scroll;
  let row = 64 * m.u;
  let sp = small_pitch(m);
  let i = 0;
  while (i < v.sections.len()) {
    let s = v.sections[i];
    let mid = y + (row - 8 * m.u) / 2;
    out = out.append(tap(panel(m, 16 * m.u, y, m.w - 32 * m.u, row - 8 * m.u), "section:" + i.to_string()));
    let kind = tr(m, kind_word(s.kind));
    let kw = matrix.width(kind, sp);
    out = out.append(dots(m.w - 32 * m.u - kw, mid - matrix.height(sp) / 2, kind, sp, look.muted()));
    out = out.append(label(m, 32 * m.u, mid - m.th / 2, fit(s.title, (m.w - 80 * m.u - kw) / m.cw), m.ts, look.ink()));
    y += row;
    i += 1;
  }
  if (v.sections.len() == 0) {
    let msg = tr(m, "No libraries");
    if (v.loading) {
      msg = tr(m, "Loading");
    }
    out = out.append(note(m, y, msg));
  }
  return out;
}

// The kind of a library, in the words of its card.
function kind_word(kind: string): string {
  if (kind == "movie") {
    return "MOVIES";
  }
  if (kind == "show") {
    return "SHOWS";
  }
  if (kind == "artist") {
    return "MUSIC";
  }
  if (kind == "photo") {
    return "PHOTOS";
  }
  return "";
}

// The columns of a grid of cards, and the width of each card.
pub function grid(m: Metrics): (i32, i32) {
  let cols = (m.w - 32 * m.u + 10 * m.u) / (card_width(m) + 10 * m.u);
  if (cols < 3) {
    cols = 3;
  }
  let w = (m.w - 32 * m.u - (cols - 1) * 10 * m.u) / cols;
  return (cols, w);
}

pub function grid_height(m: Metrics, n: i32): i32 {
  let (cols, w) = grid(m);
  let rows = (n + cols - 1) / cols;
  return rows * (card_height(m, w) + 12 * m.u) + 16 * m.u;
}

function grid_nodes(m: Metrics, v: View, items: plex.Item[], top: i32, prefix: string): scene.Node[] {
  let out: scene.Node[] = [];
  let (cols, w) = grid(m);
  let ch = card_height(m, w) + 12 * m.u;
  let bottom = content_bottom(m, v.screen);
  let i = 0;
  while (i < items.len()) {
    let x = 16 * m.u + i % cols * (w + 10 * m.u);
    let y = top + i / cols * ch - v.scroll;
    if (y + ch >= content_top(m) && y < bottom) {
      out = util_append(out, card(m, v, x, y, w, items[i], prefix + i.to_string(), ""));
    }
    i += 1;
  }
  return out;
}

// The height of the row of chips under the top bar of a library.
pub function chips_height(m: Metrics): i32 {
  return button_height(m) + 16 * m.u;
}

// A library: the chip of its order, which a tap moves to the next order,
// the chip of the filter of the items not watched, the grid of posters,
// and in the title order a strip of the first letters at the right.
function library(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let top = top_height(m) + chips_height(m);
  out = util_append(out, grid_nodes(m, v, v.items, top, "grid:"));
  if (v.items.len() == 0) {
    let msg = tr(m, "This library is empty");
    if (v.loading) {
      msg = tr(m, "Loading");
    }
    out = out.append(note(m, top + 12 * m.u, msg));
  }
  out = out.append(scene.Node { ...fill(0, top_height(m), m.w, chips_height(m), look.bg(), 0), barrier: true });
  let sorts = plex.sorts();
  let k = v.sort.max(0).min(sorts.len() - 1);
  let first = m.texts.format("BY {0}", [tr(m, sorts[k].name)]);
  let y = top_height(m) + 8 * m.u;
  out = util_append(out, button(m, 16 * m.u, y, first, false, "sort:" + ((k + 1) % sorts.len()).to_string()));
  out = util_append(out, button(m, 16 * m.u + button_width(m, first) + 10 * m.u, y, tr(m, "UNWATCHED"), v.unwatched, "unwatched:" + (if (v.unwatched) { "0" } else { "1" })));
  if (k == 0 && v.letters.len() > 1) {
    out = util_append(out, letter_strip(m, v.letters, top, content_bottom(m, v.screen)));
  }
  return out;
}

// The first letters of the titles, from `top` to `bottom` at the right
// edge. Each is a node of group "az": a tap or a drag along them jumps.
function letter_strip(m: Metrics, letters: plex.Letter[], top: i32, bottom: i32): scene.Node[] {
  let w = 16 * m.u;
  let x = m.w - w;
  let cell = ((bottom - top - 16 * m.u) / letters.len()).min(22 * m.u).max(1);
  let y0 = top + 8 * m.u;
  let p = m.u;
  let out: scene.Node[] = [scene.Node { ...fill(x, y0, w, cell * letters.len(), draw.rgba(0, 0, 0, 140), w / 2), barrier: true }];
  for i in 0..letters.len() {
    let key = letters[i].key.take(1).to_ascii_upper();
    out = out.append(mk(x, y0 + i * cell, w, cell, scene.Blank, "letter:" + i.to_string(), "az"));
    if (cell >= matrix.height(p)) {
      out = out.append(dots(x + (w - matrix.width(key, p)) / 2, y0 + i * cell + (cell - matrix.height(p)) / 2, key, p, look.muted()));
    }
  }
  return out;
}

// The height of the backdrop of the detail screen.
pub function backdrop_height(m: Metrics): i32 {
  let h = m.w * 9 / 16;
  if (h > m.h * 2 / 5) {
    h = m.h * 2 / 5;
  }
  return h;
}

// The label of the play button of an item.
pub function play_label(m: Metrics, it: plex.Item): string {
  if (it.offset_ms > 0i64 && plex.playable_kind(it.kind)) {
    return m.texts.format("Resume {0}", [plex.clock_text(it.offset_ms)]);
  }
  return tr(m, "Play");
}

function detail(m: Metrics, v: View): scene.Node[] {
  let it = v.item;
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let s = v.scroll;
  let bh = backdrop_height(m);
  let art = it.art;
  if (art.len() == 0) {
    art = plex.poster(it);
  }
  out = out.append(img(v, 0, top_height(m) - s, m.w, bh, image_key(v.base, art, m.w, bh), 0, "", ""));
  out = out.append(fill(0, top_height(m) - s + bh / 2, m.w, bh / 2, draw.rgba(0, 0, 0, 150), 0));
  let pw = 100 * m.u;
  let ph = pw * 3 / 2;
  let py = top_height(m) - s + bh - ph / 2;
  out = out.append(img(v, 16 * m.u, py, pw, ph, image_key(v.base, plex.poster(it), pw, ph), 10 * m.u, "", ""));
  let tx = 16 * m.u + pw + 16 * m.u;
  let tcells = (m.w - tx - 16 * m.u) / m.cw;
  let ty = top_height(m) - s + bh + 8 * m.u;
  let title = it.title;
  if (it.kind == "episode" && it.grandparent.len() > 0) {
    out = out.append(label(m, tx, ty, fit(it.grandparent, tcells), m.ts, look.muted()));
    ty += m.th + 2 * m.u;
  }
  let big = m.ts * 2;
  if (draw.text_width(title, big) > m.w - tx - 16 * m.u) {
    big = m.ts;
  }
  out = out.append(label(m, tx, ty, fit(title, (m.w - tx - 16 * m.u) / draw.text_width("x", big)), big, look.ink()));
  ty += draw.text_height(big) + 4 * m.u;
  out = out.append(label(m, tx, ty, fit(plex.facts(it), tcells), m.ts, look.muted()));
  ty += m.th + 2 * m.u;
  if (it.genres.len() > 0) {
    out = out.append(label(m, tx, ty, fit(it.genres.join(", "), tcells), m.ts, look.muted()));
  }
  let y = top_height(m) - s + bh + ph / 2 + 20 * m.u;
  let play = play_label(m, it);
  if (plex.playable_kind(it.kind) || v.children.len() > 0) {
    out = util_append(out, button(m, 16 * m.u, y, play, true, "play"));
  }
  let mark = mark_label(m, it);
  if (buttons_stack(m, it)) {
    y += button_height(m) + 12 * m.u;
    out = util_append(out, button(m, 16 * m.u, y, mark, false, "watched"));
  } else {
    out = util_append(out, button(m, 16 * m.u + button_width(m, play) + 12 * m.u, y, mark, false, "watched"));
  }
  y += 64 * m.u;
  if (it.summary.len() > 0) {
    out = util_append(out, wrapped(m, 16 * m.u, y, m.w - 32 * m.u, it.summary, look.ink()));
    y += wrapped_height(m, m.w - 32 * m.u, it.summary) + 16 * m.u;
  }
  if (v.children.len() > 0) {
    if (it.kind == "show" || it.kind == "artist") {
      let heading = tr(m, "SEASONS");
      if (it.kind == "artist") {
        heading = tr(m, "ALBUMS");
      }
      out = out.append(dots(16 * m.u, y, heading, small_pitch(m), look.muted()));
      out = util_append(out, grid_nodes(m, View { ...v, scroll: 0 }, v.children, y + matrix.height(small_pitch(m)) + 12 * m.u, "child:"));
    } else {
      out = util_append(out, episode_rows(m, v, y));
    }
  }
  return out;
}

pub function mark_label(m: Metrics, it: plex.Item): string {
  if (plex.watched(it)) {
    return tr(m, "Mark unwatched");
  }
  return tr(m, "Mark watched");
}

// True when the two buttons of the detail screen do not fit on one row, so
// the second goes below the first.
pub function buttons_stack(m: Metrics, it: plex.Item): boolean {
  return button_width(m, play_label(m, it)) + 12 * m.u + button_width(m, mark_label(m, it)) > m.w - 32 * m.u;
}

// The height of the content of the detail screen, for the limit of its
// scroll.
pub function detail_height(m: Metrics, v: View): i32 {
  let bh = backdrop_height(m);
  let ph = 150 * m.u;
  let h = bh + ph / 2 + 84 * m.u + wrapped_height(m, m.w - 32 * m.u, v.item.summary) + 16 * m.u;
  if (buttons_stack(m, v.item)) {
    h += button_height(m) + 12 * m.u;
  }
  if (v.item.kind == "show" || v.item.kind == "artist") {
    return h + matrix.height(small_pitch(m)) + 12 * m.u + grid_height(m, v.children.len());
  }
  return h + v.children.len() * episode_row_height(m) + 16 * m.u;
}

pub function episode_row_height(m: Metrics): i32 {
  return 84 * m.u;
}

function episode_rows(m: Metrics, v: View, top: i32): scene.Node[] {
  let out: scene.Node[] = [];
  let rh = episode_row_height(m);
  let tw = 128 * m.u;
  let th = tw * 9 / 16;
  let i = 0;
  while (i < v.children.len()) {
    let e = v.children[i];
    let y = top + i * rh;
    if (y + rh >= 0 && y < m.h) {
      out = out.append(tap(panel(m, 16 * m.u, y, m.w - 32 * m.u, rh - 8 * m.u), "child:" + i.to_string()));
      let thumb = e.thumb;
      if (e.kind == "track") {
        thumb = "";
      }
      if (thumb.len() > 0) {
        out = out.append(img(v, 16 * m.u, y, tw, th, image_key(v.base, thumb, tw, th), 14 * m.u, "", ""));
      }
      let x = 16 * m.u + 12 * m.u;
      if (thumb.len() > 0) {
        x = 16 * m.u + tw + 12 * m.u;
      }
      let cells = (m.w - x - 24 * m.u) / m.cw;
      let name = e.title;
      if (e.kind == "episode") {
        name = e.index.to_string() + ". " + e.title;
      } else if (e.kind == "track" && e.index > 0) {
        name = e.index.to_string() + ". " + e.title;
      }
      out = out.append(label(m, x, y + 10 * m.u, fit(name, cells), m.ts, look.ink()));
      let line = plex.duration_text(e.duration_ms);
      if (plex.watched(e)) {
        line += " · watched";
      }
      out = out.append(label(m, x, y + 14 * m.u + m.th, fit(line, cells), m.ts, look.muted()));
      let p = plex.progress(e);
      if (p > 0) {
        out = util_append(out, progress_bar(x, y + rh - 18 * m.u, m.w - x - 32 * m.u, 3 * m.u, p, look.red(), look.outline()));
      }
    }
    i += 1;
  }
  return out;
}

function search(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let fy = top_height(m) + 8 * m.u;
  let fh = 48 * m.u;
  let border = look.outline();
  if (v.typing) {
    border = look.ink();
  }
  let line = m.u / 2;
  if (line < 1) {
    line = 1;
  }
  out = out.append(tap(scene.node(16 * m.u, fy, m.w - 32 * m.u, fh, scene.Outline(border, fh / 2, line)), "type"));
  let cells = (m.w - 64 * m.u) / m.cw;
  if (v.query.len() == 0) {
    let sp = small_pitch(m);
    out = out.append(heading(m, 32 * m.u, fy + (fh - matrix.height(sp)) / 2, m.w - 64 * m.u, tr(m, "Search movies, shows and music"), sp, look.muted()));
  } else {
    let shown = v.query;
    if (draw.text_cells(shown) > cells - 1) {
      shown = "…" + tail(shown, cells - 2);
    }
    if (v.typing) {
      shown += "|";
    }
    out = out.append(label(m, 32 * m.u, fy + (fh - m.th) / 2, shown, m.ts, look.ink()));
  }
  out = util_append(out, hubs(m, v, fy + fh + 16 * m.u));
  if (v.hubs.len() == 0 && v.query.len() > 0 && !v.loading && !v.typing) {
    out = out.append(note(m, fy + fh + 24 * m.u, tr(m, "No results")));
  }
  return out;
}

function tail(s: string, cells: i32): string {
  let cs: string[] = [];
  for c in s.chars() {
    cs = cs.append(c.to_string());
  }
  let from = cs.len() - cells;
  if (from < 0) {
    from = 0;
  }
  let out = "";
  for i in from..cs.len() {
    out += cs[i];
  }
  return out;
}

function settings(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let y = top_height(m) + 8 * m.u - v.scroll;
  let p = title_pitch(m);
  let rows: (string, string, string)[] = [
    (tr(m, "User"), v.account, "users"),
    (tr(m, "Server"), v.server_name, "servers"),
    (tr(m, "Quality"), v.quality, "quality"),
    (tr(m, "Downloads"), m.texts.format("{0} of {1} done", [v.saved.filter((r: SavedRow): boolean => r.done).len().to_string(), v.saved.len().to_string()]), "downloads"),
    (tr(m, "Sign out"), "", "signout"),
  ];
  let row = 72 * m.u;
  for r in rows {
    let n = panel(m, 16 * m.u, y, m.w - 32 * m.u, row - 8 * m.u);
    if (r.2.len() > 0) {
      n = tap(n, r.2);
    }
    out = out.append(n);
    let color = look.ink();
    if (r.2 == "signout") {
      color = look.red();
    }
    let ty = y + 12 * m.u;
    if (r.1.len() == 0) {
      ty = y + (row - 8 * m.u - matrix.height(p)) / 2;
    }
    out = out.append(dots(32 * m.u, ty, r.0, p, color));
    if (r.1.len() > 0) {
      out = out.append(label(m, 32 * m.u, ty + matrix.height(p) + 8 * m.u, fit(r.1, (m.w - 64 * m.u) / m.cw), m.ts, look.muted()));
    }
    y += row;
  }
  let about = plex.PRODUCT + " " + plex.VERSION + ". A Plex client written in Fern, with no Java code: the screens, the network, TLS and JSON are Fern, and the video plays through the media player of Android.";
  out = util_append(out, wrapped(m, 16 * m.u, y + 16 * m.u, m.w - 32 * m.u, about, look.muted()));
  return out;
}

// A download on the screen of the downloads: the title of its item, its
// state, such as "42%", and whether it is done.
pub struct SavedRow { title: string, state: string, done: boolean }

// The downloads, one panel each: the title and the state, and a button
// that stops the download or removes its file. A tap on a done download
// plays it.
function downloads(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let y = top_height(m) + 8 * m.u - v.scroll;
  if (v.saved.len() == 0) {
    return out.append(note(m, y + 16 * m.u, tr(m, "No downloads")));
  }
  let row = 72 * m.u;
  let k = 0;
  for r in v.saved {
    let n = panel(m, 16 * m.u, y, m.w - 32 * m.u, row - 8 * m.u);
    if (r.done) {
      n = tap(n, "saved:" + k.to_string());
    }
    out = out.append(n);
    let words = if (r.done) { tr(m, "REMOVE") } else { tr(m, "STOP") };
    let bw = button_width(m, words);
    let bx = m.w - 32 * m.u - bw;
    let cells = (bx - 48 * m.u) / m.cw;
    out = out.append(label(m, 32 * m.u, y + 10 * m.u, fit(r.title, cells), m.ts, look.ink()));
    out = out.append(label(m, 32 * m.u, y + 14 * m.u + m.th, fit(r.state, cells), m.ts, look.muted()));
    out = util_append(out, button(m, bx, y + (row - 8 * m.u - button_height(m)) / 2, words, false, "unsave:" + k.to_string()));
    y += row;
    k += 1;
  }
  return out;
}

// The users of the Plex Home, one panel each: the name, and "PIN" for a
// user with a PIN. The keypad shows over them while it asks for a PIN.
function users(m: Metrics, v: View): scene.Node[] {
  let out: scene.Node[] = [fill(0, 0, m.w, m.h, look.bg(), 0)];
  let y = top_height(m) + 8 * m.u - v.scroll;
  let p = title_pitch(m);
  let sp = small_pitch(m);
  let row = 72 * m.u;
  if (v.users.len() == 0) {
    out = out.append(note(m, y + 16 * m.u, tr(m, "Loading")));
  }
  for i in 0..v.users.len() {
    let u = v.users[i];
    out = out.append(tap(panel(m, 16 * m.u, y, m.w - 32 * m.u, row - 8 * m.u), "user:" + i.to_string()));
    let ty = y + (row - 8 * m.u - matrix.height(p)) / 2;
    out = out.append(heading(m, 32 * m.u, ty, m.w - 160 * m.u, u.title, p, look.ink()));
    let mark = "";
    if (u.protected) {
      mark = tr(m, "PIN");
    } else if (u.admin) {
      mark = tr(m, "ADMIN");
    }
    if (mark.len() > 0) {
      out = out.append(dots(m.w - 32 * m.u - matrix.width(mark, sp), y + (row - 8 * m.u - matrix.height(sp)) / 2, mark, sp, look.muted()));
    }
    y += row;
  }
  if (v.error.len() > 0) {
    out = out.append(label(m, 16 * m.u, y + 8 * m.u, fit(v.error, (m.w - 32 * m.u) / m.cw), m.ts, look.red()));
  }
  if (v.pin_for.len() > 0) {
    out = util_append(out, pin_pad(m, v.pin_digits));
  }
  return out;
}

// The keypad of a PIN: four dots that fill as the digits come, the digits,
// a key that deletes the last digit, and Cancel.
function pin_pad(m: Metrics, digits: string): scene.Node[] {
  let key = 72 * m.u;
  let w = 3 * key + 4 * 12 * m.u;
  let h = 72 * m.u + 4 * (key + 12 * m.u) + 12 * m.u;
  let x = (m.w - w) / 2;
  let y = (m.h - h) / 2;
  let out: scene.Node[] = [scene.Node { ...fill(0, 0, m.w, m.h, draw.rgba(0, 0, 0, 200), 0), barrier: true }, panel(m, x, y, w, h)];
  let r = 8 * m.u;
  for k in 0..4 {
    let cx = m.w / 2 + (k * 2 - 3) * 3 * r;
    let color = look.outline();
    if (k < digits.len()) {
      color = look.ink();
    }
    out = out.append(fill(cx - r, y + 32 * m.u, 2 * r, 2 * r, color, r));
  }
  let keys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "cancel", "0", "del"];
  let p = title_pitch(m);
  let sp = small_pitch(m);
  for k in 0..keys.len() {
    let kx = x + 12 * m.u + k % 3 * (key + 12 * m.u);
    let ky = y + 72 * m.u + k / 3 * (key + 12 * m.u);
    let text = keys[k];
    let pitch = p;
    if (text == "cancel") {
      text = tr(m, "CANCEL");
      pitch = sp;
    } else if (text == "del") {
      text = "<";
    }
    out = out.append(tap(fill(kx, ky, key, key, look.bg(), key / 2), "pinkey:" + keys[k]));
    out = out.append(dots(kx + (key - matrix.width(text, pitch)) / 2, ky + (key - matrix.height(pitch)) / 2, text, pitch, look.ink()));
  }
  return out;
}

// The progress bar of the player, as a node whose tap seeks. The buttons
// of music go under it, so it goes up by their height.
pub function seek_bar(m: Metrics, p: PlayerView): scene.Node {
  return mk(24 * m.u, m.h - m.bottom - 72 * m.u - music_height(m, p), m.w - 48 * m.u, 24 * m.u, scene.Blank, "seek", "seek");
}

// The size of a preview thumbnail over the seek bar.
pub function thumb_size(m: Metrics): (i32, i32) {
  let w = 128 * m.u;
  return (w, w * 9 / 16);
}

function player(m: Metrics, v: View): scene.Node[] {
  let p = v.player;
  if (!p.overlay) {
    return util_append(util_append(util_append(util_append([mk(0, 0, m.w, m.h, scene.Blank, "overlay", "")], caption(m, p, m.h - m.bottom - 24 * m.u)), skip_button(m, p)), up_next_card(m, p)), badge(m, p));
  }
  // Over the video, a dark veil keeps the controls readable, and a tap
  // outside them hides them. Over the art, such a tap plays.
  let out: scene.Node[] = [];
  let outside = "toggle";
  if (p.over_video) {
    out = [fill(0, 0, m.w, m.h, draw.rgba(0, 0, 0, 110), 0)];
    outside = "hide";
  } else {
    out = [fill(0, 0, m.w, m.h, look.bg(), 0)];
    if (p.art.len() > 0) {
      out = out.append(img(v, 0, 0, m.w, m.h, image_key(v.base, p.art, m.w, m.h), 0, "", ""));
      out = out.append(fill(0, 0, m.w, m.h, draw.rgba(0, 0, 0, 170), 0));
    }
  }
  out = out.append(mk(0, 0, m.w, m.h, scene.Blank, outside, ""));
  let tp = title_pitch(m);
  let top = m.top + 16 * m.u;
  out = out.append(tap(fill(0, 0, 64 * m.u, m.top + 56 * m.u, draw.rgba(0, 0, 0, 0), 0), "back"));
  out = out.append(dots(16 * m.u, top + (m.th - matrix.height(tp)) / 2, "<", tp, look.ink()));
  let cells = (m.w - 64 * m.u) / m.cw;
  out = out.append(label(m, 48 * m.u, top, fit(p.title, cells), m.ts, look.ink()));
  if (p.subtitle.len() > 0) {
    out = out.append(label(m, 48 * m.u, top + 4 * m.u + m.th, fit(p.subtitle, cells), m.ts, look.muted()));
  }
  let cy = m.h / 2;
  let r = 36 * m.u;
  let small = 26 * m.u;
  let gap = 96 * m.u;
  let sp = small_pitch(m);
  let line = m.u / 2;
  if (line < 1) {
    line = 1;
  }
  out = out.append(tap(scene.node(m.w / 2 - gap - small, cy - small, 2 * small, 2 * small, scene.Outline(look.outline(), small, line)), "rew"));
  out = out.append(dots(m.w / 2 - gap - matrix.width("-10", sp) / 2, cy - matrix.height(sp) / 2, "-10", sp, look.ink()));
  out = out.append(tap(fill(m.w / 2 - r, cy - r, 2 * r, 2 * r, look.red(), r), "toggle"));
  let gp = 3 * m.u;
  let key = "glyph|" + gp.to_string() + "|" + p.paused.to_string();
  out = out.append(scene.node(m.w / 2 - 4 * gp, cy - 4 * gp, 8 * gp, 8 * gp, scene.Custom(key, 0, (f: draw.Frame, bx: i32, by: i32, bw: i32, bh: i32): void => play_glyph(f, bx + bw / 2, by + bh / 2, gp, p.paused))));
  out = out.append(tap(scene.node(m.w / 2 + gap - small, cy - small, 2 * small, 2 * small, scene.Outline(look.outline(), small, line)), "ffw"));
  out = out.append(dots(m.w / 2 + gap - matrix.width("+30", sp) / 2, cy - matrix.height(sp) / 2, "+30", sp, look.ink()));
  if (p.status.len() > 0) {
    out = out.append(label(m, (m.w - draw.text_width(p.status, m.ts)) / 2, cy + r + 16 * m.u, fit(p.status, m.w / m.cw), m.ts, look.muted()));
  }
  let bar = seek_bar(m, p);
  let shown_ms = p.position_ms;
  if (p.scrub_ms >= 0i64) {
    shown_ms = p.scrub_ms;
  }
  let permille = 0;
  if (p.duration_ms > 0i64) {
    permille = (shown_ms * 1000i64 / p.duration_ms) as i32;
  }
  if (p.scrub_ms >= 0i64) {
    if let Some(image) = p.thumb {
      let (tw, th) = thumb_size(m);
      let cx = bar.x + bar.w * permille / 1000;
      let tx = (cx - tw / 2).min(m.w - 8 * m.u - tw).max(8 * m.u);
      let ty = bar.y - th - 16 * m.u;
      out = out.append(fill(tx - 2 * m.u, ty - 2 * m.u, tw + 4 * m.u, th + 4 * m.u, look.ink(), 10 * m.u));
      out = out.append(scene.node(tx, ty, tw, th, scene.Picture(p.thumb_key, image, 8 * m.u)));
    }
  }
  out = out.append(bar);
  let dot = m.u;
  let bkey = "seek|" + dot.to_string() + "|" + permille.to_string();
  out = out.append(scene.node(bar.x, bar.y, bar.w, bar.h, scene.Custom(bkey, 0, (f: draw.Frame, bx: i32, by: i32, bw: i32, bh: i32): void => seek_dots(f, look.Rect { x: bx, y: by, w: bw, h: bh }, permille, dot))));
  let at = plex.clock_text(shown_ms);
  out = out.append(dots(bar.x, bar.y + bar.h + 6 * m.u, at, sp, look.ink()));
  let total = plex.clock_text(p.duration_ms);
  out = out.append(dots(bar.x + bar.w - matrix.width(total, sp), bar.y + bar.h + 6 * m.u, total, sp, look.muted()));
  if (p.audio) {
    out = util_append(out, music_row(m, p, bar.y + bar.h + matrix.height(sp) + 24 * m.u));
  }
  out = util_append(util_append(util_append(util_append(out, caption(m, p, bar.y - 64 * m.u)), skip_button(m, p)), up_next_card(m, p)), badge(m, p));
  let right = m.w - 16 * m.u;
  if (p.sounds.len() > 1 || p.subtitles.len() > 0) {
    right -= button_width(m, tr(m, "Tracks"));
    out = util_append(out, button(m, right, m.top + 12 * m.u, tr(m, "Tracks"), false, "tracks"));
    right -= 8 * m.u;
  }
  out = util_append(out, button(m, right - button_width(m, p.speed), m.top + 12 * m.u, p.speed, false, "speed"));
  if (p.sheet) {
    out = util_append(out, track_sheet(m, p));
  }
  return out;
}

// The buttons of music under the seek bar: shuffle, repeat, the sleep
// timer and the next track. None for a video.
function music_words(m: Metrics, p: PlayerView): (string, boolean, string)[] {
  if (!p.audio) {
    return [];
  }
  let words: (string, boolean, string)[] = [(tr(m, "SHUFFLE"), p.shuffle, "shuffle"), (p.repeat, false, "repeat"), (p.sleep, false, "sleep")];
  if (p.has_next) {
    words = words.append((tr(m, "NEXT"), false, "next_track"));
  }
  return words;
}

// The buttons of music from `y` down, in rows that fit the width.
function music_row(m: Metrics, p: PlayerView, y: i32): scene.Node[] {
  let out: scene.Node[] = [];
  let x = 16 * m.u;
  let gap = 10 * m.u;
  for word in music_words(m, p) {
    let (text, on, act) = word;
    let w = button_width(m, text);
    if (x > 16 * m.u && x + w > m.w - 16 * m.u) {
      x = 16 * m.u;
      y += button_height(m) + gap;
    }
    out = util_append(out, button(m, x, y, text, on, act));
    x += w + gap;
  }
  return out;
}

// The height of the rows of the buttons of music, with the gap under each.
function music_height(m: Metrics, p: PlayerView): i32 {
  let words = music_words(m, p);
  if (words.len() == 0) {
    return 0;
  }
  let rows = 1;
  let x = 16 * m.u;
  let gap = 10 * m.u;
  for word in words {
    let w = button_width(m, word.0);
    if (x > 16 * m.u && x + w > m.w - 16 * m.u) {
      x = 16 * m.u;
      rows += 1;
    }
    x += w + gap;
  }
  return rows * (button_height(m) + gap);
}

// The lines of the subtitle that shows, in the middle above `bottom`, in a
// dark panel. It takes no tap.
function caption(m: Metrics, p: PlayerView, bottom: i32): scene.Node[] {
  if (p.caption.len() == 0) {
    return [];
  }
  let lines = p.caption.split("\n");
  let line_h = m.th + 4 * m.u;
  let top = bottom - lines.len() * line_h - 8 * m.u;
  let out: scene.Node[] = [];
  let k = 0;
  for line in lines {
    let text = fit(line, (m.w - 48 * m.u) / m.cw);
    let w = draw.text_width(text, m.ts);
    let x = (m.w - w) / 2;
    let y = top + 4 * m.u + k * line_h;
    out = out.append(fill(x - 8 * m.u, y - 2 * m.u, w + 16 * m.u, line_h, draw.rgba(0, 0, 0, 170), 6 * m.u));
    out = out.append(label(m, x, y, text, m.ts, look.ink()));
    k += 1;
  }
  return out;
}

// The button that skips an intro or credits, at the right above the seek
// bar, over the video or over the controls.
function skip_button(m: Metrics, p: PlayerView): scene.Node[] {
  if (p.skip.len() == 0) {
    return [];
  }
  let bar = seek_bar(m, p);
  return button(m, m.w - 16 * m.u - button_width(m, p.skip), bar.y - button_height(m) - 64 * m.u, p.skip, true, "skip");
}

// The note of a gesture, such as "+10" or "VOLUME 7", in a dark panel at
// the top third of the video. It takes no tap.
function badge(m: Metrics, p: PlayerView): scene.Node[] {
  if (p.badge.len() == 0) {
    return [];
  }
  let sp = small_pitch(m);
  let pad = 16 * m.u;
  let w = matrix.width(p.badge, sp) + 2 * pad;
  let h = matrix.height(sp) + 2 * pad;
  let x = (m.w - w) / 2;
  let y = m.h / 3 - h / 2;
  return [fill(x, y, w, h, draw.rgba(0, 0, 0, 170), 12 * m.u), dots(x + pad, y + pad, p.badge, sp, look.ink())];
}

// The card of the next item at the bottom right: its title, the seconds
// before it plays, and Play and Cancel.
function up_next_card(m: Metrics, p: PlayerView): scene.Node[] {
  if (p.up_next_secs < 0 || p.up_next.len() == 0) {
    return [];
  }
  let w = (m.w - 32 * m.u).min(320 * m.u);
  let h = 132 * m.u;
  let x = m.w - 16 * m.u - w;
  let y = seek_bar(m, p).y - h - 16 * m.u;
  let sp = small_pitch(m);
  let pad = 16 * m.u;
  let words = m.texts.format("UP NEXT IN {0}", [p.up_next_secs.to_string()]);
  let out: scene.Node[] = [panel(m, x, y, w, h), dots(x + pad, y + pad, words, sp, look.muted())];
  out = out.append(label(m, x + pad, y + pad + matrix.height(sp) + 8 * m.u, fit(p.up_next, (w - 2 * pad) / m.cw), m.ts, look.ink()));
  let by = y + h - pad - button_height(m);
  out = util_append(out, button(m, x + pad, by, tr(m, "Play"), true, "next_now"));
  out = util_append(out, button(m, x + pad + button_width(m, tr(m, "Play")) + 12 * m.u, by, tr(m, "Cancel"), false, "next_cancel"));
  return out;
}

// The sheet of tracks over the controls: the sound tracks, then "Off" and
// the subtitle tracks, each a row that chooses it. The track that plays
// has a red dot. A tap outside the sheet closes it.
function track_sheet(m: Metrics, p: PlayerView): scene.Node[] {
  let row = 44 * m.u;
  let head = 32 * m.u;
  let rows = p.sounds.len() + 1 + p.subtitles.len();
  let h = 2 * head + rows * row + 16 * m.u;
  let x = 16 * m.u;
  let w = m.w - 32 * m.u;
  let y = (m.h - m.bottom - h - 16 * m.u).max(m.top + 16 * m.u);
  let sp = small_pitch(m);
  let out: scene.Node[] = [mk(0, 0, m.w, m.h, scene.Blank, "tracks_close", ""), panel(m, x, y, w, h)];
  let at = y + 8 * m.u;
  out = out.append(dots(x + 16 * m.u, at + (head - matrix.height(sp)) / 2, tr(m, "SOUND"), sp, look.muted()));
  at += head;
  let first = true;
  for t in p.sounds {
    let on = t.id == p.choice.audio || p.choice.audio.len() == 0 && first;
    out = util_append(out, track_row(m, x, at, w, row, t.title, on, "audio:" + t.id));
    at += row;
    first = false;
  }
  out = out.append(dots(x + 16 * m.u, at + (head - matrix.height(sp)) / 2, tr(m, "SUBTITLES"), sp, look.muted()));
  at += head;
  out = util_append(out, track_row(m, x, at, w, row, tr(m, "Off"), p.choice.subtitle.len() == 0, "sub:"));
  at += row;
  for t in p.subtitles {
    out = util_append(out, track_row(m, x, at, w, row, t.title, t.id == p.choice.subtitle, "sub:" + t.id));
    at += row;
  }
  return out;
}

function track_row(m: Metrics, x: i32, y: i32, w: i32, h: i32, title: string, on: boolean, act: string): scene.Node[] {
  let color = look.muted();
  let out: scene.Node[] = [tap(fill(x, y, w, h, look.surface(), 0), act)];
  if (on) {
    color = look.ink();
    out = out.append(live_dot(m, x + 20 * m.u, y + h / 2));
  }
  let tx = x + 36 * m.u;
  out = out.append(label(m, tx, y + (h - m.th) / 2, fit(title, (w - tx + x - 16 * m.u) / m.cw), m.ts, color));
  return out;
}

// The play or pause sign in white dots, `pitch` pixels from dot to dot,
// with its centre at cx and cy. Play is a triangle of four columns, and
// pause is two columns.
function play_glyph(f: draw.Frame, cx: i32, cy: i32, pitch: i32, paused: boolean): void {
  let d = pitch * 45 / 100;
  if (d < 1) {
    d = 1;
  }
  if (paused) {
    for c in 0..4 {
      for row in c..7 - c {
        f.disc(cx + (c - 1) * pitch, cy + (row - 3) * pitch, d, look.ink());
      }
    }
    return;
  }
  for c in [-1, 1] {
    for row in 0..7 {
      f.disc(cx + c * pitch, cy + (row - 3) * pitch, d, look.ink());
    }
  }
}

// The seek bar as a row of dots: white up to the position, a red dot at
// it, and grey after it.
function seek_dots(f: draw.Frame, r: look.Rect, permille: i32, dot: i32): void {
  let step = 4 * dot;
  let n = r.w / step + 1;
  if (n < 2) {
    n = 2;
  }
  let at = permille * (n - 1) / 1000;
  let cy = r.y + r.h / 2;
  for i in 0..n {
    let x = r.x + i * (r.w - 1) / (n - 1);
    if (i == at) {
      f.disc(x, cy, 2 * dot, look.red());
    } else if (i < at) {
      f.disc(x, cy, dot, look.ink());
    } else {
      f.disc(x, cy, dot, look.outline());
    }
  }
}

// The nodes of the screen of `v`, in the order to draw them.
pub function nodes(v: View): scene.Node[] {
  let m = Metrics { ...metrics(v.w, v.h, v.top, v.bottom), texts: v.texts };
  if (v.screen == LOGIN) {
    return login(m, v);
  }
  if (v.screen == SERVERS) {
    return servers(m, v);
  }
  if (v.screen == PLAYER) {
    return player(m, v);
  }
  let body: scene.Node[] = [];
  if (v.screen == HOME) {
    body = home(m, v);
  } else if (v.screen == SECTIONS) {
    body = sections(m, v);
  } else if (v.screen == LIBRARY) {
    body = library(m, v);
  } else if (v.screen == DETAIL) {
    body = detail(m, v);
  } else if (v.screen == SEARCH) {
    body = search(m, v);
  } else if (v.screen == USERS) {
    body = users(m, v);
  } else if (v.screen == DOWNLOADS) {
    body = downloads(m, v);
  } else {
    body = settings(m, v);
  }
  let back = v.screen == LIBRARY || v.screen == DETAIL || v.screen == USERS || v.screen == DOWNLOADS;
  let out = util_append(util_append(body, top_bar(m, v, back)), bottom_bar(m, v));
  if (v.menu.key.len() > 0) {
    out = util_append(out, poster_menu(m, v.menu, v.menu_download));
  }
  return out;
}

// The menu of a held poster, at the bottom over a dark veil: its title,
// Play, its download, Download all for a group of items, Mark watched or
// Mark unwatched, Go to show for an episode, and Cancel. `download` is the percent of its download that came,
// or -1. A tap on the veil closes it.
function poster_menu(m: Metrics, it: plex.Item, download: i32): scene.Node[] {
  let rows: (string, string)[] = [];
  if (plex.playable_kind(it.kind)) {
    rows = rows.append((tr(m, "Play"), "menu:play"));
    let words = tr(m, "Download");
    if (download >= 100) {
      words = tr(m, "Remove download");
    } else if (download >= 0) {
      words = m.texts.format("Stop download ({0}%)", [download.to_string()]);
    }
    rows = rows.append((words, "menu:download"));
  }
  if (["show", "season", "artist", "album"].contains(it.kind)) {
    rows = rows.append((tr(m, "Download all"), "menu:download_all"));
  }
  if (plex.watched(it)) {
    rows = rows.append((tr(m, "Mark unwatched"), "menu:mark"));
  } else {
    rows = rows.append((tr(m, "Mark watched"), "menu:mark"));
  }
  if (it.kind == "episode" && it.grandparent_key.len() > 0) {
    rows = rows.append((tr(m, "Go to show"), "menu:show"));
  }
  rows = rows.append((tr(m, "Cancel"), "menu:close"));
  let row = 52 * m.u;
  let head = 48 * m.u;
  let x = 16 * m.u;
  let w = m.w - 32 * m.u;
  let h = head + rows.len() * row + 16 * m.u;
  let y = m.h - m.bottom - h - 16 * m.u;
  let out: scene.Node[] = [scene.Node { ...mk(0, 0, m.w, m.h, scene.Fill(draw.rgba(0, 0, 0, 160), 0), "menu:close", ""), barrier: true }, panel(m, x, y, w, h)];
  let cells = (w - 32 * m.u) / m.cw;
  out = out.append(label(m, x + 16 * m.u, y + (head - m.th) / 2, fit(plex.card_title(it), cells), m.ts, look.muted()));
  let at = y + head;
  for r in rows {
    let (text, act) = r;
    out = out.append(mk(x, at, w, row, scene.Blank, act, ""));
    out = out.append(label(m, x + 16 * m.u, at + (row - m.th) / 2, text, m.ts, look.ink()));
    at += row;
  }
  return out;
}

// The key of the image that the node `n` shows, or "".
function image_of(n: scene.Node): string {
  match (n.paint) {
    scene.Picture(key, _, _) => {
      return key;
    },
    scene.Custom(key, _, _) => {
      if (key.starts_with(WANTED)) {
        return key.drop(WANTED.len()).to_owned();
      }
      return "";
    },
    _ => {
      return "";
    }
  }
}

// The keys of the images that the nodes show, each once.
pub function images(ns: scene.Node[]): string[] {
  let out: string[] = [];
  for n in ns {
    let key = image_of(n);
    if (key.len() > 0 && !out.contains(key)) {
      out = out.append(key);
    }
  }
  return out;
}

// The size of the image that a node with `key` shows.
pub function image_size(ns: scene.Node[], key: string): (i32, i32) {
  for n in ns {
    if (image_of(n) == key) {
      return (n.w, n.h);
    }
  }
  return (0, 0);
}
