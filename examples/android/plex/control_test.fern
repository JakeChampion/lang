// The behaviour of Fern for Plex on sequences of events, on the host. A fake
// device answers each request from a table in the shape that plex.tv and a
// server send, records each request and each call of the player, and gives a
// frame in memory. Its workers run on the inline scheduler, so each poll
// finds the reply. With PLEX_CONTROL_PNG set to a directory, the test writes
// the last frame of each case there as a PNG file.
import "std/android";
import "std/android/download";
import "std/android/draw";
import "std/android/player";
import "std/android/ui/scene";
import "std/png";
import "std/test";
import "std/worker";
import "../matrix";
import "./control";
import "./plex";
import "./ui";

const W: i32 = 540;

const H: i32 = 1200;

function frame(): draw.Frame {
  unsafe {
    let bits = __alloc(W * H * 4);
    return draw.Frame { window: 0 as usize, buffer: 0 as usize, bits: bits, width: W, height: H, stride: W };
  }
}

function free_frame(own f: draw.Frame): void {
  unsafe {
    __free(f.bits, f.stride * f.height * 4);
  }
}

const RESOURCES: string = "[{\"name\":\"Den\",\"provides\":\"server\",\"clientIdentifier\":\"abc\",\"accessToken\":\"srv\",\"owned\":true,\"connections\":[{\"uri\":\"https://down.example:32400\",\"local\":true,\"relay\":false},{\"uri\":\"https://up.example:32400\",\"local\":false,\"relay\":false}]}]";

const HUBS: string = "{\"MediaContainer\":{\"Hub\":[{\"title\":\"Continue Watching\",\"hubIdentifier\":\"home.continue\",\"Metadata\":[{\"ratingKey\":\"77\",\"type\":\"episode\",\"title\":\"Pilot\",\"grandparentTitle\":\"Lost\",\"grandparentRatingKey\":\"70\",\"grandparentThumb\":\"/library/metadata/70/thumb\",\"index\":1,\"parentIndex\":1,\"duration\":2500000,\"viewOffset\":100000}]},{\"title\":\"Recently Added Movies\",\"hubIdentifier\":\"home.movies.recent\",\"Metadata\":[{\"ratingKey\":\"501\",\"type\":\"movie\",\"title\":\"Inception\",\"year\":2010,\"thumb\":\"/library/metadata/501/thumb\"},{\"ratingKey\":\"502\",\"type\":\"movie\",\"title\":\"Amélie\",\"year\":2001,\"thumb\":\"/library/metadata/502/thumb\"}]}]}}";

const SECTIONS: string = "{\"MediaContainer\":{\"Directory\":[{\"key\":\"1\",\"type\":\"movie\",\"title\":\"Movies\"},{\"key\":\"2\",\"type\":\"show\",\"title\":\"TV Shows\"}]}}";

const MOVIE: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"501\",\"type\":\"movie\",\"title\":\"Inception\",\"year\":2010,\"summary\":\"A thief who steals corporate secrets through the use of dream-sharing technology.\",\"thumb\":\"/library/metadata/501/thumb\",\"art\":\"/library/metadata/501/art\",\"duration\":8880000,\"viewOffset\":60000,\"Media\":[{\"container\":\"mp4\",\"videoCodec\":\"h264\",\"audioCodec\":\"aac\",\"videoResolution\":\"1080\",\"Part\":[{\"id\":11,\"key\":\"/library/parts/11/file.mp4\",\"indexes\":\"sd\",\"Stream\":[{\"id\":20,\"streamType\":1,\"codec\":\"h264\"},{\"id\":21,\"streamType\":2,\"codec\":\"aac\",\"displayTitle\":\"English (AAC Stereo)\",\"selected\":true},{\"id\":22,\"streamType\":2,\"codec\":\"aac\",\"displayTitle\":\"Commentary (AAC Stereo)\"},{\"id\":31,\"streamType\":3,\"codec\":\"pgs\",\"displayTitle\":\"English (PGS)\"},{\"id\":33,\"streamType\":3,\"codec\":\"srt\",\"displayTitle\":\"English (SRT External)\",\"key\":\"/library/streams/33\"}]}]}]}]}}";

// A track of an album, with its artist.
const SONG: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"601\",\"type\":\"track\",\"title\":\"Song\",\"parentTitle\":\"Album\",\"grandparentTitle\":\"Band\",\"duration\":200000,\"Media\":[{\"container\":\"mp4\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":61,\"key\":\"/library/parts/61/file.m4a\"}]}]}]}}";

// Album 701 and its three tracks, with the parts 71, 72 and 73.
const ALBUM: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"701\",\"type\":\"album\",\"title\":\"Album\",\"parentTitle\":\"Band\"}]}}";

const ALBUM_TRACKS: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"711\",\"type\":\"track\",\"title\":\"One\",\"parentTitle\":\"Album\",\"grandparentTitle\":\"Band\",\"duration\":200000,\"Media\":[{\"container\":\"mp4\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":71,\"key\":\"/library/parts/71/file.m4a\"}]}]},{\"ratingKey\":\"712\",\"type\":\"track\",\"title\":\"Two\",\"parentTitle\":\"Album\",\"grandparentTitle\":\"Band\",\"duration\":200000,\"Media\":[{\"container\":\"mp4\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":72,\"key\":\"/library/parts/72/file.m4a\"}]}]},{\"ratingKey\":\"713\",\"type\":\"track\",\"title\":\"Three\",\"parentTitle\":\"Album\",\"grandparentTitle\":\"Band\",\"duration\":200000,\"Media\":[{\"container\":\"mp4\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":73,\"key\":\"/library/parts/73/file.m4a\"}]}]}]}}";

// Episode 503, with credits from 100 s, and the episodes of its season:
// 503, then the movie 501, which the test plays as the next item.
const CREDITS: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"503\",\"type\":\"episode\",\"title\":\"Pilot\",\"index\":1,\"parentIndex\":1,\"duration\":2500000,\"Marker\":[{\"type\":\"credits\",\"startTimeOffset\":100000,\"endTimeOffset\":200000}],\"Media\":[{\"container\":\"mp4\",\"videoCodec\":\"h264\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":13,\"key\":\"/library/parts/13/file.mp4\"}]}]}]}}";

const EPISODES: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"503\",\"type\":\"episode\",\"title\":\"Pilot\",\"index\":1,\"parentIndex\":1,\"duration\":2500000,\"Media\":[{\"container\":\"mp4\",\"videoCodec\":\"h264\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":13,\"key\":\"/library/parts/13/file.mp4\"}]}]},{\"ratingKey\":\"501\",\"type\":\"episode\",\"title\":\"Second\",\"index\":2,\"parentIndex\":1,\"duration\":2500000,\"Media\":[{\"container\":\"mp4\",\"videoCodec\":\"h264\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":11,\"key\":\"/library/parts/11/file.mp4\"}]}]}]}}";

// The movie of the second poster: the movie above, with an intro marker.
const INTRO: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"502\",\"type\":\"movie\",\"title\":\"Inception\",\"year\":2010,\"summary\":\"A thief who steals corporate secrets through the use of dream-sharing technology.\",\"thumb\":\"/library/metadata/501/thumb\",\"art\":\"/library/metadata/501/art\",\"duration\":8880000,\"viewOffset\":60000,\"Marker\":[{\"type\":\"intro\",\"startTimeOffset\":50000,\"endTimeOffset\":130000}],\"Media\":[{\"container\":\"mp4\",\"videoCodec\":\"h264\",\"audioCodec\":\"aac\",\"videoResolution\":\"1080\",\"Part\":[{\"id\":11,\"key\":\"/library/parts/11/file.mp4\",\"indexes\":\"sd\",\"Stream\":[{\"id\":20,\"streamType\":1,\"codec\":\"h264\"},{\"id\":21,\"streamType\":2,\"codec\":\"aac\",\"displayTitle\":\"English (AAC Stereo)\",\"selected\":true},{\"id\":22,\"streamType\":2,\"codec\":\"aac\",\"displayTitle\":\"Commentary (AAC Stereo)\"},{\"id\":31,\"streamType\":3,\"codec\":\"pgs\",\"displayTitle\":\"English (PGS)\"},{\"id\":33,\"streamType\":3,\"codec\":\"srt\",\"displayTitle\":\"English (SRT External)\",\"key\":\"/library/streams/33\"}]}]}]}]}}";

// A page of a library of 63 movies from `start`.
// A page of the movie library of 400 items, from `start`.
function page(start: i32): string {
  let n = 60.min(400 - start).max(0);
  let items: string[] = [];
  for i in 0..n {
    let k = (1000 + start + i).to_string();
    items = items.append("{\"ratingKey\":\"" + k + "\",\"type\":\"movie\",\"title\":\"Movie " + k + "\",\"year\":1999}");
  }
  return "{\"MediaContainer\":{\"size\":" + n.to_string() + ",\"totalSize\":400,\"Metadata\":[" + items.join(",") + "]}}";
}

function ok(body: string): plex.Reply {
  return plex.Reply { status: 200, body: body.bytes(), error: "" };
}

function query_value(u: string, key: string): string {
  for part in u.split("?") {
    for pair in part.split("&") {
      if (pair.starts_with(key + "=")) {
        return pair.split_at(key.len() + 1).1;
      }
    }
  }
  return "";
}

// The reply of the fake plex.tv and of the fake server. Its first address
// does not answer, so the app tries the second.
function reply_to(r: plex.Request): plex.Reply {
  let u = r.url;
  if (u.starts_with("https://down.example")) {
    return plex.Reply { status: 0, body: [], error: "connect: refused" };
  }
  if (u.contains("/api/v2/pins/")) {
    return ok("{\"id\":7,\"code\":\"ABCD\",\"authToken\":\"tok-1\"}");
  }
  if (u.contains("/api/v2/pins")) {
    return ok("{\"id\":7,\"code\":\"ABCD\",\"authToken\":null}");
  }
  if (r.method == "POST" && u.contains("/api/v2/home/users/kid/switch")) {
    if (u.ends_with("?pin=1234")) {
      return ok("{\"authToken\":\"kid-tok\"}");
    }
    return plex.Reply { status: 403, body: [], error: "" };
  }
  if (r.method == "POST" && u.contains("/api/v2/home/users/guest/switch")) {
    return ok("{\"authToken\":\"guest-tok\"}");
  }
  if (u.contains("/api/v2/home/users")) {
    return ok("{\"id\":1,\"users\":[{\"uuid\":\"ada\",\"title\":\"Ada\",\"admin\":true},{\"uuid\":\"kid\",\"title\":\"Kid\",\"protected\":true},{\"uuid\":\"guest\",\"title\":\"Guest\"}]}");
  }
  if (u.contains("/api/v2/user")) {
    return ok("{\"friendlyName\":\"Ada\"}");
  }
  if (u.contains("/api/v2/resources")) {
    return ok(RESOURCES);
  }
  if (u.contains("/identity")) {
    return ok("{\"MediaContainer\":{\"machineIdentifier\":\"abc\"}}");
  }
  if (u.contains("/hubs/search")) {
    return ok(HUBS);
  }
  if (u.contains("/hubs")) {
    return ok(HUBS);
  }
  if (u.contains("/library/sections/1/firstCharacter")) {
    return ok("{\"MediaContainer\":{\"Directory\":[{\"size\":100,\"key\":\"A\",\"title\":\"A\"},{\"size\":50,\"key\":\"B\",\"title\":\"B\"},{\"size\":250,\"key\":\"C\",\"title\":\"C\"}]}}");
  }
  if (u.contains("/library/sections/1/all")) {
    return ok(page(control.num(query_value(u, "X-Plex-Container-Start"))));
  }
  if (u.contains("/library/sections")) {
    return ok(SECTIONS);
  }
  if (u.contains("/library/streams/33")) {
    return ok("1\n00:01:59,000 --> 00:02:01,000\n<b>Hello</b> from SRT\n");
  }
  if (u.contains("/library/metadata/601")) {
    return ok(SONG);
  }
  if (u.contains("/library/metadata/600/allLeaves")) {
    return ok(EPISODES);
  }
  if (u.contains("/library/metadata/702/allLeaves")) {
    return ok(ALBUM_TRACKS);
  }
  if (u.contains("/library/metadata/702/children")) {
    return ok("{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"701\",\"type\":\"album\",\"title\":\"Album\",\"parentTitle\":\"Band\"}]}}");
  }
  if (u.contains("/library/metadata/702")) {
    return ok("{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"702\",\"type\":\"artist\",\"title\":\"Band\"}]}}");
  }
  if (u.contains("/library/metadata/701/children")) {
    return ok(ALBUM_TRACKS);
  }
  if (u.contains("/library/metadata/701")) {
    return ok(ALBUM);
  }
  if (u.contains("/library/metadata/503")) {
    return ok(CREDITS);
  }
  if (u.contains("/library/metadata/502")) {
    return ok(INTRO);
  }
  if (u.contains("/library/metadata/501")) {
    return ok(MOVIE);
  }
  if (r.method == "PUT" && u.contains("/library/parts/11?")) {
    return ok("");
  }
  if (u.contains("/library/parts/11/indexes/sd")) {
    return plex.Reply { status: 200, body: bif_bytes(), error: "" };
  }
  if (u.contains("/photo/:/transcode")) {
    return ok("img");
  }
  if (u.contains("/:/timeline") || u.contains("/:/scrobble") || u.contains("/transcode/universal/stop") || u.contains("/transcode/universal/ping")) {
    return ok("");
  }
  return plex.Reply { status: 404, body: [], error: "" };
}

function le32(v: i64): u8[] {
  return [(v & 255i64) as u8, (v >> 8i64 & 255i64) as u8, (v >> 16i64 & 255i64) as u8, (v >> 24i64 & 255i64) as u8];
}

// A BIF file of three thumbnails, one each hour.
function bif_bytes(): u8[] {
  let out: u8[] = [137u8, 66u8, 73u8, 70u8, 13u8, 10u8, 26u8, 10u8];
  for part in [le32(0i64), le32(3i64), le32(0i64)] {
    for x in part {
      out = out.append(x);
    }
  }
  while (out.len() < 64) {
    out = out.append(0u8);
  }
  let data = 64 + 4 * 8;
  for v in [0i64, data as i64, 3600i64, (data + 3) as i64, 7200i64, (data + 5) as i64, 4294967295i64, (data + 6) as i64] {
    for x in le32(v) {
      out = out.append(x);
    }
  }
  for c in "AAABBC".as_bytes() {
    out = out.append(c);
  }
  return out;
}

function reply_all(rs: plex.Request[]): plex.Reply[] {
  let out: plex.Reply[] = [];
  for r in rs {
    out = out.append(reply_to(r));
  }
  return out;
}

// What the fake device saw: the requests, the calls of the player and the
// files.
// The requests, the calls of the player and the files of the fake device,
// and the decoders that it has.
struct Log { urls: Cell[string[]], calls: Cell[string[]], files: Cell[string[]], decoders: Cell[string[]], sound: Cell[boolean], gpu: Cell[boolean], languages: Cell[string[]], pip: Cell[boolean], access: Cell[android.AccessItem[]], progress: Cell[download.Progress], ids: Cell[i64], focus: Cell[boolean] }

function none_access(): android.AccessItem[] {
  let out: android.AccessItem[] = [];
  return out;
}

function new_log(): Log {
  let none: string[] = [];
  return Log { urls: cell_new(none), calls: cell_new(none), files: cell_new(none), decoders: cell_new(["video/avc", "audio/mp4a-latm"]), sound: cell_new(true), gpu: cell_new(false), languages: cell_new(["en-US"]), pip: cell_new(false), access: cell_new(none_access()), progress: cell_new(download.Progress { status: download.PENDING, done: 0i64, total: -1i64 }), ids: cell_new(42i64), focus: cell_new(true) };
}

function note(c: Cell[string[]], s: string): void {
  c.set(c.get().append(s));
}

function fetch(log: Log, rs: plex.Request[]): worker.Worker[plex.Reply[]] {
  for r in rs {
    note(log.urls, r.method + " " + r.url);
  }
  return worker.spawn_on(worker.inline(), (): plex.Reply[] => reply_all(rs));
}

function fake_image(w: i32, h: i32): Option[draw.Image] {
  let px: u8[] = [];
  for i in 0..w * h {
    px = px.append(200u8).append(60u8).append(40u8).append(255u8);
  }
  return Some(draw.Image { width: w, height: h, pixels: px });
}

function file_of(log: Log, path: string): string {
  let prefix = path + "=";
  let found = "";
  for f in log.files.get() {
    if (f.starts_with(prefix)) {
      found = f.split_at(prefix.len()).1;
    }
  }
  return found;
}

// A device at monotonic time `now` that draws on `f`.
function fake(log: Log, now: i64, f: draw.Frame): control.Device {
  return control.Device {
    mono_ms: (): i64 => now,
    read: (path: string): string => file_of(log, path),
    write: (path: string, text: string): void => note(log.files, path + "=" + text),
    remove: (path: string): void => note(log.files, path + "="),
    size: (window: usize): (i32, i32) => (W, H),
    lock: (window: usize): draw.Frame => f,
    post: (g: draw.Frame): void => {},
    finish: (): void => note(log.calls, "finish"),
    keep_screen_on: (on: boolean): void => {},
    immersive: (on: boolean): void => {},
    show_field: (q: string): void => note(log.calls, "field show [" + q + "]"),
    set_field: (q: string): void => note(log.calls, "field set [" + q + "]"),
    hide_field: (): void => note(log.calls, "field hide"),
    fetch: (rs: plex.Request[]): worker.Worker[plex.Reply[]] => fetch(log, rs),
    fetch_images: (rs: plex.Request[]): worker.Worker[plex.Reply[]] => fetch(log, rs),
    decode: (bytes: u8[], w: i32, h: i32): Option[draw.Image] => fake_image(w, h),
    play: (uri: string): boolean => {
      note(log.calls, "play " + uri);
      return true;
    },
    show_video: (window: usize): boolean => {
      note(log.calls, "show");
      return true;
    },
    attach: (window: usize): boolean => log.gpu.get(),
    detach: (): void => note(log.calls, "detach"),
    present: (window: usize, nodes: scene.Node[], video: boolean): boolean => {
      if (!video) {
        note(log.calls, "present screen");
      } else if (nodes.len() == 0) {
        note(log.calls, "draw video");
      } else {
        note(log.calls, "draw video with controls");
      }
      return true;
    },
    hide_video: (): void => note(log.calls, "hide"),
    pause_video: (): void => note(log.calls, "pause video"),
    request_frame: (): void => note(log.calls, "frame"),
    start: (): void => note(log.calls, "start"),
    pause: (): void => note(log.calls, "pause"),
    seek: (ms: i64): void => note(log.calls, "seek " + ms.to_string()),
    position: (): i64 => 120000i64,
    duration: (): i64 => 8880000i64,
    stop: (): void => note(log.calls, "stop"),
    has_audio: (): boolean => log.sound.get(),
    audio_tracks: (): i32[] => [1, 2],
    select_track: (i: i32): boolean => {
      note(log.calls, "track " + i.to_string());
      return true;
    },
    set_speed: (rate: i32): void => note(log.calls, "speed " + rate.to_string()),
    pip: (on: boolean): void => note(log.calls, "pip " + on.to_string()),
    in_pip: (): boolean => log.pip.get(),
    watch_next: (key: string, title: string, kind: i32, at: i64, length: i64, poster: string): void => note(log.calls, "watch next " + key + " " + title + " kind=" + kind.to_string() + " at=" + at.to_string() + " poster=" + poster),
    watch_next_drop: (key: string): void => note(log.calls, "watch next drop " + key),
    channel: (cards: control.Card[]): void => note(log.calls, "channel " + cards.map((c: control.Card): string => c.key + ":" + c.kind + ":" + c.title + ":" + c.poster).join(" ")),
    access: (items: android.AccessItem[]): void => log.access.set(items),
    download: (r: plex.Request, name: string, title: string): i64 => {
      note(log.calls, "download " + r.url + " " + name + " " + title);
      let id = log.ids.get();
      log.ids.set(id + 1i64);
      return id;
    },
    download_progress: (id: i64): download.Progress => log.progress.get(),
    download_remove: (id: i64): void => note(log.calls, "download remove " + id.to_string()),
    downloads_dir: "/sdcard/files",
    queue_next: (uri: string): boolean => {
      note(log.calls, "next " + uri);
      return true;
    },
    chain: (on: boolean): void => note(log.calls, "chain " + on.to_string()),
    swap: (): void => note(log.calls, "swap"),
    from_next: (e: android.Event): boolean => player.Player { obj: 0 as usize, listener: 0 as usize, slot: 1 }.sent(e),
    brightness: (level: f32): void => note(log.calls, "light " + ((level * 1000.0f32) as i32).to_string()),
    system_brightness: (): f32 => 0.5f32,
    volume: (): (i32, i32) => (7, 15),
    set_volume: (level: i32): void => note(log.calls, "volume " + level.to_string()),
    now_playing: (title: string, artist: string, album: string, length_ms: i64, playing: boolean, at_ms: i64): void => note(log.calls, "media " + title + " by " + artist + " on " + album + " playing=" + playing.to_string()),
    media_end: (): void => note(log.calls, "media end"),
    take_focus: (): boolean => {
      note(log.calls, "focus");
      return log.focus.get();
    },
    drop_focus: (): void => note(log.calls, "focus off"),
    ask_notifications: (): void => note(log.calls, "ask notifications"),
    random: (): i32 => 5,
    decoders: log.decoders.get(),
    languages: log.languages.get(),
  };
}

// The app after event `e` at monotonic time `now`.
function at(own s: control.App, log: Log, now: i64, f: draw.Frame, e: android.Event): control.App {
  return control.step(control.App { ...s, dev: fake(log, now, f) }, e);
}

// Ticks until no request waits, from `now`.
function settle(own s: control.App, log: Log, now: i64, f: draw.Frame): control.App {
  let t = s;
  for i in 0..30 {
    t = at(t, log, now, f, android.Tick);
  }
  return t;
}

// The app after its window shows at time 0, with no files and no extras.
function shown(log: Log, f: draw.Frame, server: string, token: string): control.App {
  let s = at(control.new(fake(log, 0i64, f), "/data", server, token, ""), log, 0i64, f, android.Start);
  return settle(at(s, log, 0i64, f, android.WindowCreated(android.Window { ptr: 1 as usize })), log, 0i64, f);
}

function centre(n: scene.Node): (i32, i32) {
  return (n.x + n.w / 2, n.y + n.h / 2);
}

function node(s: control.App, act: string): Option[scene.Node] {
  for n in s.nodes {
    if (n.tap.name == act) {
      return Some(n);
    }
  }
  return None;
}

// A tap on the node with action `act`, then ticks.
function tap(own s: control.App, log: Log, now: i64, f: draw.Frame, act: string): control.App {
  let Some(n) = node(s, act) else {
    return s;
  };
  let (x, y) = centre(n);
  let t = at(s, log, now, f, android.Touch(0, x as f32, y as f32));
  return settle(at(t, log, now + 50i64, f, android.Touch(1, x as f32, y as f32)), log, now + 50i64, f);
}

function has_url(log: Log, part: string): boolean {
  for u in log.urls.get() {
    if (u.contains(part)) {
      return true;
    }
  }
  return false;
}

function has_call(log: Log, part: string): boolean {
  for c in log.calls.get() {
    if (c.contains(part)) {
      return true;
    }
  }
  return false;
}

function save_png(f: draw.Frame, name: string): void {
  let Some(dir) = env("PLEX_CONTROL_PNG") else {
    return;
  };
  let rgb: u8[] = [];
  for y in 0..f.height {
    for x in 0..f.width {
      let p = f.pixel(x, y);
      rgb = rgb.append((p & 255) as u8).append((p >> 8 & 255) as u8).append((p >> 16 & 255) as u8);
    }
  }
  if let Ok(bytes) = png.encode_rgb8(f.width, f.height, rgb) {
    let written = write_file_bytes(dir + "/" + name + ".png", bytes);
  }
}

// Signs in with a PIN, finds the one server, tries its connections and opens
// the home screen.
function signed_in(log: Log, f: draw.Frame): control.App {
  let s = shown(log, f, "", "");
  let t = tap(s, log, 100i64, f, "signin");
  return settle(at(t, log, 2200i64, f, android.Tick), log, 2200i64, f);
}

function test_sign_in_reaches_home(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let first = shown(log, f, "", "");
  if (node(first, "signin").is_none()) {
    return test.fail("no sign-in button");
  }
  let waiting = tap(first, log, 100i64, f, "signin");
  if (!has_url(log, "POST https://plex.tv/api/v2/pins") || node(waiting, "cancel").is_none()) {
    return test.fail("no PIN on the screen");
  }
  let s = settle(at(waiting, log, 2200i64, f, android.Tick), log, 2200i64, f);
  save_png(f, "home");
  if (!has_url(log, "https://plex.tv/api/v2/pins/7") || !has_url(log, "https://clients.plex.tv/api/v2/resources")) {
    return test.fail("no check of the PIN or no server list");
  }
  if (!has_url(log, "https://down.example:32400/identity") || !has_url(log, "https://up.example:32400/identity")) {
    return test.fail("the connections were not tried in turn");
  }
  if (!has_url(log, "https://up.example:32400/hubs") || node(s, "hub:1:1").is_none()) {
    return test.fail("no hubs on the home screen");
  }
  if (!has_url(log, "/photo/:/transcode?width=")) {
    return test.fail("no posters asked for");
  }
  let settings = file_of(log, "/data/settings");
  if (control.setting(settings, "token") != "tok-1" || control.setting(settings, "server_uri") != "https://up.example:32400") {
    return test.fail("settings: " + settings);
  }
  return test.assert_eq(control.setting(settings, "account"), "Ada");
}

function test_saved_server_opens_home(): test.TestOutcome {
  let log = new_log();
  note(log.files, "/data/settings=id=abc\ntoken=tok-1\nserver_name=Den\nserver_uri=https://up.example:32400\nserver_token=srv\n");
  let f = frame();
  defer free_frame(f);
  let s = shown(log, f, "", "");
  if (has_url(log, "plex.tv")) {
    return test.fail("a saved server went to plex.tv");
  }
  return test.assert_eq((node(s, "hub:0:0").is_some() && node(s, "tab:3").is_some()).to_string(), "true");
}

// A saved address that this network cannot reach: the app opens the home
// screen at once, races the connections of the server again, and changes
// to the address that answers.
function test_saved_server_moves_to_working_address(): test.TestOutcome {
  let log = new_log();
  note(log.files, "/data/settings=id=abc\ntoken=tok-1\nserver_name=Den\nserver_id=abc\nserver_uri=https://down.example:32400\nserver_token=srv\n");
  let f = frame();
  defer free_frame(f);
  let s = settle(shown(log, f, "", ""), log, 100i64, f);
  if (!has_url(log, "/api/v2/resources") || !has_url(log, "https://up.example:32400/identity")) {
    return test.fail("no race of the connections: " + log.urls.get().join(" | "));
  }
  if (!has_url(log, "https://up.example:32400/library/sections") || s.error.len() > 0 || node(s, "hub:0:0").is_none()) {
    return test.fail("the home screen did not load from the address that answered: " + s.error);
  }
  return test.assert_eq(file_of(log, "/data/settings").contains("server_uri=https://up.example:32400").to_string(), "true");
}

// A saved address that works: the race again keeps the home screen, and
// asks for it once.
function test_saved_server_recheck_is_quiet(): test.TestOutcome {
  let log = new_log();
  note(log.files, "/data/settings=id=abc\ntoken=tok-1\nserver_name=Den\nserver_id=abc\nserver_uri=https://up.example:32400\nserver_token=srv\n");
  let f = frame();
  defer free_frame(f);
  let s = settle(shown(log, f, "", ""), log, 100i64, f);
  let sections = log.urls.get().filter((u: string): boolean => u.contains("/library/sections")).len();
  if (!has_url(log, "/api/v2/resources") || sections != 1) {
    return test.fail("the race again loaded the home screen " + sections.to_string() + " times");
  }
  return test.assert_eq((node(s, "hub:0:0").is_some() && s.base.uri == "https://up.example:32400").to_string(), "true");
}

// A finger that rests on a poster for half a second opens its menu, and
// its lift opens nothing. Mark watched tells the server and changes the
// poster. Go to show opens the show of an episode. A drag opens no menu.
function test_poster_menu(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let Some(p) = node(home, "hub:0:0") else {
    return test.fail("no poster");
  };
  let (x, y) = centre(p);
  let down = at(home, log, 1000i64, f, android.Touch(0, x as f32, y as f32));
  if (control.timeout(down, 1000i64) > 500) {
    return test.fail("no wake-up for the hold");
  }
  let early = at(down, log, 1300i64, f, android.Tick);
  if (node(early, "menu:mark").is_some()) {
    return test.fail("the menu opened before the hold ended");
  }
  let held = at(early, log, 1550i64, f, android.Tick);
  if (node(held, "menu:play").is_none() || node(held, "menu:mark").is_none() || node(held, "menu:show").is_none() || node(held, "menu:close").is_none()) {
    return test.fail("no menu after the hold");
  }
  save_png(f, "menu");
  let lifted = settle(at(held, log, 1600i64, f, android.Touch(1, x as f32, y as f32)), log, 1600i64, f);
  if (lifted.screen != ui.HOME || node(lifted, "menu:mark").is_none() || has_url(log, "/library/metadata/77")) {
    return test.fail("the lift of the finger opened the poster");
  }
  let marked = tap(lifted, log, 1700i64, f, "menu:mark");
  if (!has_url(log, "/:/scrobble?identifier=com.plexapp.plugins.library&key=77") || node(marked, "menu:mark").is_some() || !plex.watched(marked.hubs[0].items[0])) {
    return test.fail("mark watched did not reach the server and the poster: " + log.urls.get().join(" | "));
  }
  let again = at(at(marked, log, 2000i64, f, android.Touch(0, x as f32, y as f32)), log, 2550i64, f, android.Tick);
  let show = tap(settle(at(again, log, 2600i64, f, android.Touch(1, x as f32, y as f32)), log, 2600i64, f), log, 2700i64, f, "menu:show");
  if (show.screen != ui.DETAIL || show.item.key != "70") {
    return test.fail("go to show did not open the show");
  }
  let back = tap(show, log, 2800i64, f, "back");
  let drag = at(at(back, log, 3000i64, f, android.Touch(0, x as f32, y as f32)), log, 3050i64, f, android.Touch(2, x as f32 + 60.0, y as f32));
  let after = at(drag, log, 3600i64, f, android.Tick);
  return test.assert_eq(node(after, "menu:close").is_none().to_string(), "true");
}

// The User row of the settings lists the users of the Plex Home. A user
// with a PIN gets the keypad: a wrong PIN shows an error, and the right one
// switches. The app then uses the token of that user, and connects again.
function test_switch_home_user(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = signed_in(log, f);
  let list = tap(tap(home, log, 3000i64, f, "tab:3"), log, 3100i64, f, "users");
  if (list.screen != ui.USERS || node(list, "user:1").is_none()) {
    return test.fail("no list of the users: " + log.urls.get().join(" | "));
  }
  let pad = tap(list, log, 3200i64, f, "user:1");
  if (node(pad, "pinkey:5").is_none()) {
    return test.fail("no keypad for a user with a PIN");
  }
  save_png(f, "pin");
  let wrong = pad;
  for d in ["1", "1", "1", "1"] {
    wrong = tap(wrong, log, 3300i64, f, "pinkey:" + d);
  }
  if (wrong.error != "Wrong PIN" || wrong.client.token != "tok-1" || node(wrong, "pinkey:5").is_none()) {
    return test.fail("a wrong PIN did not show its error: " + wrong.error);
  }
  let right = wrong;
  for d in ["1", "2", "3", "del", "3", "4"] {
    right = tap(right, log, 3400i64, f, "pinkey:" + d);
  }
  let done = settle(right, log, 6000i64, f);
  if (done.client.token != "kid-tok" || done.account != "Kid" || done.screen != ui.HOME) {
    return test.fail("the right PIN did not switch: " + done.client.token + " " + done.account + " " + done.screen.to_string());
  }
  return test.assert_eq(file_of(log, "/data/settings").contains("token=kid-tok").to_string(), "true");
}

// A track plays on when the app goes away, and the media controls of
// Android pause it, play it and stop it. Each change reaches them. The
// first track asks once for the permission to post notifications.
function test_music_media_controls(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let s = at(control.new(fake(log, 0i64, f), "/data", "https://up.example:32400", "srv", "601"), log, 0i64, f, android.Start);
  let t = settle(at(s, log, 0i64, f, android.WindowCreated(android.Window { ptr: 1 as usize })), log, 0i64, f);
  let ready = settle(at(t, log, 100i64, f, android.Posted(19, 0 as usize)), log, 100i64, f);
  if (!has_call(log, "play https://up.example:32400/library/parts/61/file.m4a") || !has_call(log, "media Song by Band on Album playing=true")) {
    return test.fail("the track did not reach the media controls: " + log.calls.get().join(" | "));
  }
  let away = settle(at(ready, log, 200i64, f, android.Pause), log, 200i64, f);
  if (has_call(log, "pause")) {
    return test.fail("the track paused when the app went away");
  }
  let held = settle(at(away, log, 300i64, f, android.Posted(29, 0 as usize)), log, 300i64, f);
  if (!has_call(log, "pause") || !has_call(log, "media Song by Band on Album playing=false")) {
    return test.fail("the pause of the media controls did not pause: " + log.calls.get().join(" | "));
  }
  let starts = count_calls(log, "start");
  let again = settle(at(held, log, 400i64, f, android.Posted(28, 0 as usize)), log, 400i64, f);
  if (count_calls(log, "start") != starts + 1) {
    return test.fail("the play of the media controls did not play");
  }
  let ended = settle(at(again, log, 500i64, f, android.Posted(32, 0 as usize)), log, 500i64, f);
  if (count_calls(log, "ask notifications") != 1) {
    return test.fail("the app did not ask once for the permission of notifications");
  }
  return test.assert_eq((has_call(log, "stop") && has_call(log, "media end") && !ended.play.active).to_string(), "true");
}

// A key that goes down and up at time `now`, then ticks.
function press(own s: control.App, log: Log, now: i64, f: draw.Frame, code: i32): control.App {
  return settle(at(at(s, log, now, f, android.Key(code, 0)), log, now, f, android.Key(code, 1)), log, now, f);
}

function ringed(s: control.App): boolean {
  let last = s.nodes[s.nodes.len() - 1];
  return match (last.paint) {
    scene.Outline(_, _, _) => s.focus.len() > 0,
    _ => false,
  };
}

// The D-pad of a TV remote: the first key focuses the poster at the top
// left, down moves to the row below, the centre opens the focused poster,
// and a touch hides the focus.
function test_remote_moves_focus(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let first = press(home, log, 100i64, f, 20);
  if (first.focus != "hub:0:0" || !ringed(first)) {
    return test.fail("the first key did not focus the first poster: " + first.focus);
  }
  let below = press(first, log, 200i64, f, 20);
  if (below.focus != "hub:1:0") {
    return test.fail("down did not move to the row below: " + below.focus);
  }
  let right = press(below, log, 300i64, f, 22);
  if (right.focus != "hub:1:1") {
    return test.fail("right did not move along the row: " + right.focus);
  }
  let left = press(right, log, 400i64, f, 21);
  let opened = press(left, log, 500i64, f, 23);
  if (opened.screen != ui.DETAIL || !has_url(log, "/library/metadata/501")) {
    return test.fail("the centre did not open the poster");
  }
  let touched = at(opened, log, 600i64, f, android.Touch(0, 10.0, 600.0));
  let cleared = touched.focus == "";
  let lifted = draw_now(touched, log, f);
  return test.assert_eq((cleared && !ringed(lifted)).to_string(), "true");
}

function draw_now(own s: control.App, log: Log, f: draw.Frame): control.App {
  return at(s, log, 700i64, f, android.Touch(1, 10.0, 600.0));
}

// On the video, left and right seek as the buttons do, the centre shows
// the controls with the focus on play, and the centre then pauses. The
// play and pause key of a remote plays again.
function test_remote_on_the_video(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let drawn = settle(video_drawn(log, f), log, 900i64, f);
  let ahead = press(drawn, log, 1000i64, f, 22);
  let back = press(ahead, log, 1100i64, f, 21);
  if (!has_call(log, "seek 150000") || !has_call(log, "seek 110000")) {
    return test.fail("left and right did not seek: " + log.calls.get().join(" | "));
  }
  let shown = press(back, log, 1200i64, f, 23);
  if (shown.focus != "toggle" || node(shown, "toggle").is_none() || has_call(log, "pause")) {
    return test.fail("the centre did not show the controls with the focus on play");
  }
  let paused = press(shown, log, 1300i64, f, 23);
  if (!has_call(log, "pause") || !paused.play.paused) {
    return test.fail("the centre on play did not pause");
  }
  let starts = count_calls(log, "start");
  let again = press(paused, log, 1400i64, f, 85);
  return test.assert_eq((count_calls(log, "start") == starts + 1 && !again.play.paused).to_string(), "true");
}

function count_calls(log: Log, call: string): i32 {
  return log.calls.get().filter((c: string): boolean => c == call).len();
}

function draws(log: Log): i32 {
  return count_calls(log, "draw video");
}

function frames(log: Log): i32 {
  return count_calls(log, "frame");
}

function test_play_pause_and_stop(): test.TestOutcome {
  let log = new_log();
  log.gpu.set(true);
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let detail = tap(home, log, 100i64, f, "hub:1:0");
  if (node(detail, "play").is_none() || !has_url(log, "GET https://up.example:32400/library/metadata/501")) {
    return test.fail("no detail screen");
  }
  save_png(f, "detail");
  let playing = tap(detail, log, 200i64, f, "play");
  if (!has_call(log, "play https://up.example:32400/library/parts/11/file.mp4?X-Plex-Session-Identifier=") || !has_call(log, "&X-Plex-Token=srv")) {
    return test.fail("the file did not play as it is: " + log.calls.get().join(" | "));
  }
  let ready = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  if (!has_call(log, "seek 60000") || !has_call(log, "show") || !has_call(log, "start") || !has_url(log, "state=playing")) {
    return test.fail("no resume at the offset: " + log.calls.get().join(" | "));
  }
  let asked = frames(log);
  let drawn = settle(at(ready, log, 350i64, f, android.Vsync(0i64)), log, 350i64, f);
  if (draws(log) != 1 || frames(log) <= asked) {
    return test.fail("a vsync of the video did not draw it and ask for the next frame: " + log.calls.get().join(" | "));
  }
  // A tap shows the controls over the video, which plays on.
  let shown = tap(drawn, log, 400i64, f, "overlay");
  if (has_call(log, "pause") || node(shown, "toggle").is_none() || node(shown, "hide").is_none()) {
    return test.fail("a tap on the video paused it or showed no controls: " + log.calls.get().join(" | "));
  }
  let over = settle(at(shown, log, 420i64, f, android.Vsync(0i64)), log, 420i64, f);
  if (count_calls(log, "draw video with controls") != 1) {
    return test.fail("the controls did not draw over the video: " + log.calls.get().join(" | "));
  }
  // With no tap, the controls go after a while.
  let gone = settle(over, log, 4500i64, f);
  if (node(gone, "hide").is_some() || node(gone, "overlay").is_none()) {
    return test.fail("the controls stayed over the video");
  }
  // The play button pauses.
  let again = tap(gone, log, 4600i64, f, "overlay");
  let paused = tap(again, log, 4700i64, f, "toggle");
  save_png(f, "paused");
  if (!has_call(log, "pause") || !has_call(log, "pause video") || !has_url(log, "state=paused") || node(paused, "toggle").is_none()) {
    return test.fail("the play button did not pause");
  }
  let drew = count_calls(log, "draw video") + count_calls(log, "draw video with controls");
  let still = settle(at(paused, log, 4750i64, f, android.Vsync(0i64)), log, 4750i64, f);
  if (count_calls(log, "draw video") + count_calls(log, "draw video with controls") != drew) {
    return test.fail("a vsync drew the video while it was paused");
  }
  let back = tap(still, log, 5000i64, f, "back");
  if (!has_call(log, "stop") || !has_url(log, "state=stopped") || node(back, "play").is_none()) {
    return test.fail("no stop and return");
  }
  return test.assert_eq(has_url(log, "/:/scrobble").to_string(), "false");
}

// A phone with no AAC decoder gets a transcode of the whole item. The
// resume and each seek stay in that stream, and a pause keeps it alive.
function test_transcode_seeks_in_its_stream(): test.TestOutcome {
  let log = new_log();
  log.decoders.set(["video/avc"]);
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let playing = tap(tap(home, log, 100i64, f, "hub:1:0"), log, 200i64, f, "play");
  if (!has_call(log, "play https://up.example:32400/video/:/transcode/universal/start.m3u8?") || has_call(log, "offset=")) {
    return test.fail("no transcode of the whole item: " + log.calls.get().join(" | "));
  }
  let ready = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  if (!has_call(log, "seek 60000")) {
    return test.fail("the resume did not seek in the stream: " + log.calls.get().join(" | "));
  }
  let paused = tap(ready, log, 400i64, f, "overlay");
  let ahead = tap(paused, log, 500i64, f, "ffw");
  if (!has_call(log, "seek 150000") || log.calls.get().filter((c: string): boolean => c.starts_with("play ")).len() != 1) {
    return test.fail("a seek started a new transcode: " + log.calls.get().join(" | "));
  }
  let later = settle(ahead, log, 10500i64, f);
  return test.assert_eq(has_url(log, "/video/:/transcode/universal/ping?session=").to_string(), "true");
}

// A file that plays as it is with no sound plays again as a transcode
// that converts the sound, from the same place: once when the player
// selected no sound track, and once when the sound decoder stopped.
function test_lost_sound_transcodes(): test.TestOutcome {
  let log = new_log();
  log.sound.set(false);
  let f = frame();
  defer free_frame(f);
  let playing = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "hub:1:0"), log, 200i64, f, "play");
  let retried = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  if (!has_call(log, "stop") || !has_call(log, "play https://up.example:32400/video/:/transcode/universal/start.m3u8?")) {
    return test.fail("no transcode after no sound track: " + log.calls.get().join(" | "));
  }
  if (!retried.play.stream.transcode || retried.play.stream.offset_ms != 60000i64) {
    return test.fail("the transcode does not start where the file was");
  }
  let log2 = new_log();
  let playing2 = tap(tap(shown(log2, f, "https://up.example:32400", "srv"), log2, 100i64, f, "hub:1:0"), log2, 200i64, f, "play");
  let ready = settle(at(playing2, log2, 300i64, f, android.Posted(19, 0 as usize)), log2, 300i64, f);
  if (ready.play.stream.transcode) {
    return test.fail("a file with its sound transcoded");
  }
  let lost = settle(at(ready, log2, 400i64, f, android.Posted(22, 804 as usize)), log2, 400i64, f);
  if (!lost.play.stream.transcode || lost.play.stream.offset_ms != 120000i64) {
    return test.fail("no transcode after the sound decoder stopped: " + log2.calls.get().join(" | "));
  }
  return test.assert_eq(has_call(log2, "play https://up.example:32400/video/:/transcode/universal/start.m3u8?").to_string(), "true");
}

// A drag along the seek bar shows the time and the thumbnail under the
// finger, seeks at most every 200 ms on the way, and seeks to the end of
// the drag when the finger leaves.
function test_drag_scrubs_with_thumbnails(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let playing = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "hub:1:0"), log, 200i64, f, "play");
  if (!has_url(log, "/library/parts/11/indexes/sd")) {
    return test.fail("no request of the thumbnails: " + log.urls.get().join(" | "));
  }
  let ready = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  let paused = tap(ready, log, 400i64, f, "overlay");
  let Some(bar) = node(paused, "seek") else {
    return test.fail("no seek bar");
  };
  let y = (bar.y + bar.h / 2) as f32;
  let x1 = (bar.x + bar.w / 2) as f32;
  let x2 = (bar.x + bar.w * 3 / 4) as f32;
  let seeks = count_seeks(log);
  let down = at(paused, log, 1000i64, f, android.Touch(0, x1, y));
  let near = at(down, log, 1050i64, f, android.Touch(2, x1 + 4.0, y));
  if (count_seeks(log) != seeks + 1) {
    return test.fail("the drag did not seek once in its first 200 ms: " + log.calls.get().join(" | "));
  }
  let thumbs = near.nodes.filter((n: scene.Node): boolean => match (n.paint) {
    scene.Picture(key, _, _) => key.starts_with("bif|"),
    _ => false,
  });
  if (thumbs.len() != 1) {
    return test.fail("no thumbnail over the seek bar");
  }
  let far = at(near, log, 1300i64, f, android.Touch(2, x2, y));
  if (count_seeks(log) != seeks + 2) {
    return test.fail("the drag did not seek again after 200 ms");
  }
  let up = settle(at(far, log, 1310i64, f, android.Touch(1, x2, y)), log, 1310i64, f);
  if (count_seeks(log) != seeks + 3 || !has_call(log, "seek 6660000")) {
    return test.fail("no seek to the end of the drag: " + log.calls.get().join(" | "));
  }
  let left = up.nodes.filter((n: scene.Node): boolean => match (n.paint) {
    scene.Picture(key, _, _) => key.starts_with("bif|"),
    _ => false,
  });
  return test.assert_eq(left.len().to_string(), "0");
}

// A video that plays on the GPU, with its first frame drawn.
function video_drawn(log: Log, f: draw.Frame): control.App {
  log.gpu.set(true);
  let playing = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "hub:1:0"), log, 200i64, f, "play");
  let ready = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  return settle(at(ready, log, 350i64, f, android.Vsync(0i64)), log, 350i64, f);
}

// The channel row of Android TV gets the items of the rows that the server
// names "recent", with their posters, and not the items to go on with.
function test_channel_row(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let sent = log.calls.get().filter((c: string): boolean => c.starts_with("channel "));
  if (sent.len() != 1 || !sent[0].starts_with("channel 501:movie:Inception:https://up.example:32400/photo/:/transcode?") || !sent[0].contains(" 502:movie:Amélie:") || sent[0].contains("77:")) {
    return test.fail("the channel did not get the recent items: " + sent.join(" | "));
  }
  return test.pass();
}

// The Search key of a remote opens the search with the keyboard, so the
// microphone of the keyboard can take the words. On the player it does
// nothing.
function test_search_key(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let searching = settle(at(at(home, log, 1000i64, f, android.Key(84, 0)), log, 1000i64, f, android.Key(84, 1)), log, 1000i64, f);
  if (searching.screen != ui.SEARCH || !searching.typing || !has_call(log, "field show")) {
    return test.fail("the Search key did not open the search with the keyboard: " + log.calls.get().join(" | "));
  }
  return test.pass();
}

// The play takes the audio focus, so another app stops. When a call or
// another app takes it, the play pauses, and it goes on when the focus
// comes back. A play that the person paused stays paused. While Android
// refuses the focus, the play does not start. The stop lets it go.
function test_audio_focus(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let playing = video_drawn(log, f);
  let starts = count_calls(log, "start");
  if (count_calls(log, "focus") != 1 || starts != 1) {
    return test.fail("the play did not take the focus: " + log.calls.get().join(" | "));
  }
  let lost = settle(at(playing, log, 2000i64, f, android.Posted(18, 2 as usize)), log, 2000i64, f);
  if (!lost.play.paused || count_calls(log, "pause") != 1) {
    return test.fail("a loss of the focus did not pause");
  }
  let back = settle(at(lost, log, 2100i64, f, android.Posted(18, 1 as usize)), log, 2100i64, f);
  if (back.play.paused || count_calls(log, "start") != starts + 1) {
    return test.fail("the focus came back, and the play did not go on");
  }
  let mine = tap(tap(back, log, 2200i64, f, "overlay"), log, 2300i64, f, "toggle");
  let again = settle(at(at(mine, log, 2400i64, f, android.Posted(18, 2 as usize)), log, 2500i64, f, android.Posted(18, 1 as usize)), log, 2500i64, f);
  if (!again.play.paused || count_calls(log, "start") != starts + 1) {
    return test.fail("the focus started a play that the person paused");
  }
  log.focus.set(false);
  let refused = tap(again, log, 2600i64, f, "toggle");
  if (!refused.play.paused || count_calls(log, "start") != starts + 1) {
    return test.fail("the play started with no focus");
  }
  let stopped = tap(refused, log, 2700i64, f, "back");
  return test.assert_eq(has_call(log, "focus off").to_string(), "true");
}

// A tap at (x, y) at time `now`, then ticks.
function tap_at(own s: control.App, log: Log, now: i64, f: draw.Frame, x: f32, y: f32): control.App {
  let t = at(s, log, now, f, android.Touch(0, x, y));
  return settle(at(t, log, now + 30i64, f, android.Touch(1, x, y)), log, now + 30i64, f);
}

function says(s: control.App, text: string): boolean {
  return s.nodes.filter((n: scene.Node): boolean => n.say == text).len() > 0;
}

// A second tap soon after the first at the left of the video seeks back 10
// seconds, and at the right forward 10 seconds. The controls stay as they
// were before the first tap. Two taps in the middle, or far apart, do not
// seek.
function test_double_tap_seeks(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let drawn = settle(video_drawn(log, f), log, 900i64, f);
  if (node(drawn, "overlay").is_none()) {
    return test.fail("the controls showed before the taps");
  }
  let y = (H / 2) as f32;
  let seeks = count_seeks(log);
  let back = tap_at(tap_at(drawn, log, 1000i64, f, (W / 5) as f32, y), log, 1200i64, f, (W / 5) as f32, y);
  if (count_seeks(log) != seeks + 1 || !has_call(log, "seek 110000") || !says(back, "-10")) {
    return test.fail("a double tap at the left did not seek back: " + log.calls.get().join(" | "));
  }
  if (node(back, "overlay").is_none() || node(back, "toggle").is_some()) {
    return test.fail("the controls of the first tap stayed");
  }
  let ahead = tap_at(tap_at(back, log, 2000i64, f, (W * 4 / 5) as f32, y), log, 2200i64, f, (W * 4 / 5) as f32, y);
  if (count_seeks(log) != seeks + 2 || !has_call(log, "seek 130000") || !says(ahead, "+10")) {
    return test.fail("a double tap at the right did not seek forward: " + log.calls.get().join(" | "));
  }
  let gone = settle(ahead, log, 3100i64, f);
  if (says(gone, "+10")) {
    return test.fail("the badge stayed");
  }
  // Above the buttons, so that a second tap that is not a double tap hits
  // no control.
  let high = (H / 4) as f32;
  let middle = tap_at(tap_at(gone, log, 4000i64, f, (W / 2) as f32, high), log, 4200i64, f, (W / 2) as f32, high);
  let slow = tap_at(tap_at(middle, log, 9000i64, f, (W / 5) as f32, high), log, 9600i64, f, (W / 5) as f32, high);
  return test.assert_eq((count_seeks(log) - seeks).to_string(), "2");
}

// A drag up the left half of the video makes the window brighter, and a
// drag down the right half makes the sound quieter. Each shows its level,
// and the brightness of the system comes back when the video stops.
// A drag from the top or the bottom edge opens the notifications or the
// navigation of Android, so it does not set the volume.
function test_drag_sets_light_and_volume(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let drawn = video_drawn(log, f);
  let x = (W / 5) as f32;
  let y0 = (H / 2) as f32;
  let down = at(drawn, log, 1000i64, f, android.Touch(0, x, y0));
  let up = at(down, log, 1050i64, f, android.Touch(2, x, y0 - (H * 3 / 10) as f32));
  if (!has_call(log, "light 1000") || !says(up, "LIGHT 100%")) {
    return test.fail("the drag did not set the brightness: " + log.calls.get().join(" | "));
  }
  let lifted = settle(at(up, log, 1100i64, f, android.Touch(1, x, y0 - (H * 3 / 10) as f32)), log, 1100i64, f);
  if (has_call(log, "pause") || node(lifted, "toggle").is_some()) {
    return test.fail("the drag counted as a tap");
  }
  let rx = (W * 4 / 5) as f32;
  let press = at(lifted, log, 2000i64, f, android.Touch(0, rx, y0));
  let lower = at(press, log, 2050i64, f, android.Touch(2, rx, y0 + (H / 5) as f32));
  if (!has_call(log, "volume 2") || !says(lower, "VOLUME 2")) {
    return test.fail("the drag did not set the volume: " + log.calls.get().join(" | "));
  }
  let done = settle(at(lower, log, 2100i64, f, android.Touch(1, rx, y0 + (H / 5) as f32)), log, 2100i64, f);
  let volumes = log.calls.get().filter((c: string): boolean => c.starts_with("volume ")).len();
  let pulled = done;
  for y in [2.0f32, (H - 2) as f32] {
    let to = if (y < 10.0f32) { y + (H / 4) as f32 } else { y - (H / 4) as f32 };
    pulled = at(at(at(pulled, log, 2200i64, f, android.Touch(0, rx, y)), log, 2250i64, f, android.Touch(2, rx, to)), log, 2300i64, f, android.Touch(1, rx, to));
    if (log.calls.get().filter((c: string): boolean => c.starts_with("volume ")).len() != volumes) {
      return test.fail("a drag from the edge of the screen set the volume: " + log.calls.get().join(" | "));
    }
  }
  let shown = tap(pulled, log, 3000i64, f, "overlay");
  let back = tap(shown, log, 3100i64, f, "back");
  return test.assert_eq(has_call(log, "light -1000").to_string(), "true");
}

function count_seeks(log: Log): i32 {
  return log.calls.get().filter((c: string): boolean => c.starts_with("seek ")).len();
}

// The sheet of tracks: a second sound track of a file that plays as it is
// changes in place, and the server remembers it. A subtitle starts the
// stream again as a transcode that burns it.
function test_tracks_sheet(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let playing = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "hub:1:0"), log, 200i64, f, "play");
  let ready = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  if (!has_call(log, "track 1")) {
    return test.fail("the remembered sound did not play: " + log.calls.get().join(" | "));
  }
  let sheet = tap(tap(ready, log, 400i64, f, "overlay"), log, 500i64, f, "tracks");
  if (node(sheet, "audio:22").is_none() || node(sheet, "sub:31").is_none() || node(sheet, "sub:").is_none()) {
    return test.fail("no sheet of tracks");
  }
  let plays = count_plays(log);
  let commentary = tap(sheet, log, 600i64, f, "audio:22");
  if (!has_url(log, "PUT https://up.example:32400/library/parts/11?audioStreamID=22&subtitleStreamID=0&allParts=1") || !has_call(log, "track 2") || count_plays(log) != plays) {
    return test.fail("the commentary did not play in place: " + log.calls.get().join(" | "));
  }
  let subs = tap(tap(commentary, log, 700i64, f, "tracks"), log, 800i64, f, "sub:31");
  if (count_plays(log) != plays + 1 || !has_call(log, "subtitles=burn") || !has_call(log, "audioStreamID=22")) {
    return test.fail("the subtitle did not burn in a new transcode: " + log.calls.get().join(" | "));
  }
  return test.assert_eq(has_url(log, "PUT https://up.example:32400/library/parts/11?audioStreamID=22&subtitleStreamID=31&allParts=1").to_string(), "true");
}

// The speed button gives the next rate. The player takes it at once while
// it plays. A paused player takes it at the next start, because a rate
// starts a paused player. The rate stays in the settings.
function test_speed_button(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let playing = tap(video_drawn(log, f), log, 400i64, f, "overlay");
  let faster = tap(playing, log, 500i64, f, "speed");
  if (!has_call(log, "speed 125") || !says(faster, "SPEED 1.25x") || !file_of(log, "/data/settings").contains("speed=125")) {
    return test.fail("the speed button did not set 1.25x: " + log.calls.get().join(" | "));
  }
  let paused = tap(faster, log, 600i64, f, "toggle");
  let quiet = tap(paused, log, 700i64, f, "speed");
  if (has_call(log, "speed 150")) {
    return test.fail("a paused player took a rate, which starts it: " + log.calls.get().join(" | "));
  }
  let resumed = tap(quiet, log, 800i64, f, "toggle");
  let calls = log.calls.get();
  let start = calls.len() - 1;
  while (start >= 0 && calls[start] != "start") {
    start -= 1;
  }
  if (start < 0 || start + 1 >= calls.len() || calls[start + 1] != "speed 150") {
    return test.fail("the start after the pause did not take the rate: " + calls.join(" | "));
  }
  let again = control.new(fake(log, 900i64, f), "/data", "https://up.example:32400", "srv", "");
  return test.assert_eq(again.speed.to_string(), "150");
}

// With Auto, a play starts at Original. One stall changes nothing, and a
// second stall in a minute plays the next lower quality as a transcode from
// where the stream is. A stall more than a minute after the last does not
// count.
function test_auto_quality_steps_down(): test.TestOutcome {
  let log = new_log();
  note(log.files, "/data/settings=id=abc\ntoken=tok-1\nserver_name=Den\nserver_uri=https://up.example:32400\nserver_token=srv\nquality=" + plex.auto_quality().to_string() + "\n");
  let f = frame();
  defer free_frame(f);
  let playing = tap(tap(shown(log, f, "", ""), log, 100i64, f, "hub:1:0"), log, 200i64, f, "play");
  let ready = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  if (!has_call(log, "play https://up.example:32400/library/parts/11/file.mp4")) {
    return test.fail("Auto did not start with the file as it is: " + log.calls.get().join(" | "));
  }
  let plays = count_plays(log);
  let once = settle(at(ready, log, 1000i64, f, android.Posted(22, 701 as usize)), log, 1000i64, f);
  let late = settle(at(once, log, 70000i64, f, android.Posted(22, 701 as usize)), log, 70000i64, f);
  if (count_plays(log) != plays) {
    return test.fail("stalls more than a minute apart lowered the quality: " + log.calls.get().join(" | "));
  }
  let twice = settle(at(late, log, 75000i64, f, android.Posted(22, 701 as usize)), log, 75000i64, f);
  if (count_plays(log) != plays + 1 || !has_call(log, "videoResolution=1920x1080")) {
    return test.fail("two stalls in a minute did not lower the quality: " + log.calls.get().join(" | "));
  }
  return test.assert_eq(twice.play.level.to_string(), "1");
}

// The app takes the first language of the person that it has texts for.
// A language with no texts, and a text with no translation, show English.
function test_texts_in_the_language_of_the_person(): test.TestOutcome {
  let log = new_log();
  log.languages.set(["ja-JP", "de-AT", "fr"]);
  let f = frame();
  defer free_frame(f);
  let german = shown(log, f, "", "");
  if (!says(german, "Mit Plex anmelden") || !says(german, "Deine Plex-Mediatheken, in Fern")) {
    return test.fail("the sign-in screen is not in German: " + german.nodes.map((n: scene.Node): string => n.say).join(" | "));
  }
  let home = shown(log, f, "https://up.example:32400", "srv");
  if (!says(home, "Mediatheken") || !says(home, "Einstellungen")) {
    return test.fail("the tabs are not in German: " + home.nodes.map((n: scene.Node): string => n.say).join(" | "));
  }
  let other = new_log();
  other.languages.set(["ja-JP"]);
  let english = shown(other, f, "", "");
  return test.assert_eq(says(english, "Sign in with Plex").to_string(), "true");
}

// The last track that the player took, by its part.
function last_part(log: Log): string {
  let found = "";
  for c in log.calls.get() {
    if (c.starts_with("play https://up.example:32400/library/parts/")) {
      found = c.split_at("play https://up.example:32400/library/parts/".len()).1.split_at(2).0;
    }
  }
  return found;
}

// An album plays its tracks in order, and Next goes to the next one. Repeat
// all starts the album again after its last track, and repeat one plays the
// track again. Shuffle stays in the settings. The sleep timer pauses the
// music at its time, and "at the end" plays no next track.
// Play on an artist plays all of the tracks of the artist, from the first
// one: the children of an artist are albums, which do not play.
function test_artist_plays_all(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let s = at(control.new(fake(log, 0i64, f), "/data", "https://up.example:32400", "srv", "702"), log, 0i64, f, android.Start);
  let artist = settle(at(s, log, 0i64, f, android.WindowCreated(android.Window { ptr: 1 as usize })), log, 0i64, f);
  if (!has_url(log, "/library/metadata/702/allLeaves") || last_part(log) != "71" || artist.play.queue.len() != 2 || artist.error != "") {
    return test.fail("the artist did not play all of its tracks: " + artist.error + " " + log.calls.get().join(" | "));
  }
  return test.pass();
}

// Back on the player of music shows the screen before, and the music plays
// on. A bar above the tabs pauses and plays it, and opens the player
// again. A new play stops the music first.
function test_back_keeps_music(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let s = at(control.new(fake(log, 0i64, f), "/data", "https://up.example:32400", "srv", "701"), log, 0i64, f, android.Start);
  let album = settle(at(s, log, 0i64, f, android.WindowCreated(android.Window { ptr: 1 as usize })), log, 0i64, f);
  let one = settle(at(tap(album, log, 100i64, f, "play"), log, 150i64, f, android.Posted(19, 0 as usize)), log, 150i64, f);
  let stops = count_calls(log, "stop");
  let away = settle(at(at(one, log, 200i64, f, android.Key(4, 0)), log, 200i64, f, android.Key(4, 1)), log, 200i64, f);
  if (away.screen == ui.PLAYER || !away.play.active || count_calls(log, "stop") != stops || !says(away, "One · Band")) {
    return test.fail("Back stopped the music, or no bar shows it: " + log.calls.get().join(" | "));
  }
  let paused = tap(away, log, 300i64, f, "now:toggle");
  let was_paused = paused.play.paused;
  let played = tap(paused, log, 400i64, f, "now:toggle");
  if (!was_paused || played.play.paused || count_calls(log, "pause") != 1) {
    return test.fail("the button of the bar did not pause and play");
  }
  let opened = tap(played, log, 500i64, f, "now:open");
  if (opened.screen != ui.PLAYER || node(opened, "now:open").is_some()) {
    return test.fail("the bar did not open the player");
  }
  let detail = settle(at(at(opened, log, 600i64, f, android.Key(4, 0)), log, 600i64, f, android.Key(4, 1)), log, 600i64, f);
  let again = tap(detail, log, 700i64, f, "play");
  if (count_calls(log, "stop") != stops + 1 || again.screen != ui.PLAYER || !again.play.active) {
    return test.fail("a new play did not stop the music first: " + log.calls.get().join(" | "));
  }
  return test.pass();
}

function test_album_queue_repeat_and_sleep(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let s = at(control.new(fake(log, 0i64, f), "/data", "https://up.example:32400", "srv", "701"), log, 0i64, f, android.Start);
  let album = settle(at(s, log, 0i64, f, android.WindowCreated(android.Window { ptr: 1 as usize })), log, 0i64, f);
  let one = settle(at(tap(album, log, 100i64, f, "play"), log, 150i64, f, android.Posted(19, 0 as usize)), log, 150i64, f);
  if (last_part(log) != "71" || one.play.queue.len() != 2) {
    return test.fail("the album did not start at its first track: " + log.calls.get().join(" | "));
  }
  let two = settle(at(tap(one, log, 200i64, f, "next_track"), log, 250i64, f, android.Posted(19, 0 as usize)), log, 250i64, f);
  let three = settle(at(settle(at(two, log, 300i64, f, android.Posted(20, 0 as usize)), log, 300i64, f), log, 350i64, f, android.Posted(19, 0 as usize)), log, 350i64, f);
  if (last_part(log) != "73" || three.play.queue.len() != 0) {
    return test.fail("Next and the end of a track did not go through the album: " + log.calls.get().join(" | "));
  }
  let all = tap(three, log, 400i64, f, "repeat");
  let again = settle(at(settle(at(all, log, 450i64, f, android.Posted(20, 0 as usize)), log, 450i64, f), log, 500i64, f, android.Posted(19, 0 as usize)), log, 500i64, f);
  if (last_part(log) != "71" || again.play.queue.len() != 2) {
    return test.fail("repeat all did not start the album again: " + log.calls.get().join(" | "));
  }
  let single = tap(again, log, 550i64, f, "repeat");
  let same = settle(at(settle(at(single, log, 600i64, f, android.Posted(20, 0 as usize)), log, 600i64, f), log, 650i64, f, android.Posted(19, 0 as usize)), log, 650i64, f);
  if (last_part(log) != "71" || !file_of(log, "/data/settings").contains("repeat=2")) {
    return test.fail("repeat one did not play the track again: " + log.calls.get().join(" | "));
  }
  let mixed = tap(tap(same, log, 700i64, f, "repeat"), log, 710i64, f, "shuffle");
  if (!file_of(log, "/data/settings").contains("shuffle=1") || mixed.play.queue.len() != 2) {
    return test.fail("shuffle did not keep the tracks that wait");
  }
  if (node(mixed, "sleep").is_none()) {
    return test.fail("no sleep button");
  }
  let timed = tap(mixed, log, 800i64, f, "sleep");
  if (timed.sleep_at == 0i64) {
    return test.fail("the sleep button set no time");
  }
  let pauses = count_calls(log, "pause");
  let sleep_at = timed.sleep_at;
  if (sleep_at < 800i64 + 15i64 * 60000i64) {
    return test.fail("the sleep timer is set for less than 15 minutes");
  }
  let slept = settle(timed, log, sleep_at + 1i64, f);
  if (count_calls(log, "pause") != pauses + 1 || !slept.play.paused) {
    return test.fail("the sleep timer did not pause the music: " + log.calls.get().join(" | "));
  }
  let woke = tap(slept, log, 1000000i64, f, "toggle");
  let at_end = tap(tap(tap(tap(woke, log, 1000100i64, f, "sleep"), log, 1000200i64, f, "sleep"), log, 1000300i64, f, "sleep"), log, 1000400i64, f, "sleep");
  let plays = count_plays(log);
  let ended = settle(at(at_end, log, 1000500i64, f, android.Posted(20, 0 as usize)), log, 1000500i64, f);
  if (count_plays(log) != plays || ended.play.active) {
    return test.fail("the sleep timer at the end played a next track: " + log.calls.get().join(" | "));
  }
  return test.pass();
}

// A video that plays lets Android show it in a picture-in-picture window,
// and a pause stops that. When the app goes away into that window, the
// video plays on. When it goes away with no such window, the video pauses.
function test_picture_in_picture(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let playing = video_drawn(log, f);
  if (!has_call(log, "pip true")) {
    return test.fail("a video that plays did not allow picture-in-picture: " + log.calls.get().join(" | "));
  }
  log.pip.set(true);
  let small = settle(at(playing, log, 400i64, f, android.Pause), log, 400i64, f);
  if (small.play.paused) {
    return test.fail("the video paused in the picture-in-picture window");
  }
  log.pip.set(false);
  let away = settle(at(small, log, 500i64, f, android.Pause), log, 500i64, f);
  if (!away.play.paused || !has_call(log, "pip false")) {
    return test.fail("the video did not pause when the app went away: " + log.calls.get().join(" | "));
  }
  return test.pass();
}

// A video that stops part of the way goes on the Watch Next row of Android
// TV, at its place and with its poster. A video that plays to its end goes
// off the row.
function test_watch_next(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let playing = video_drawn(log, f);
  let back = tap(tap(playing, log, 400i64, f, "overlay"), log, 500i64, f, "back");
  if (!has_call(log, "watch next 501 Inception kind=0 at=") || !has_call(log, "poster=https://up.example:32400/photo/:/transcode?")) {
    return test.fail("a video that stopped part of the way is not on Watch Next: " + log.calls.get().join(" | "));
  }
  let again = settle(at(tap(back, log, 600i64, f, "play"), log, 700i64, f, android.Posted(19, 0 as usize)), log, 700i64, f);
  let ended = settle(at(again, log, 800i64, f, android.Posted(20, 0 as usize)), log, 800i64, f);
  return test.assert_eq(has_call(log, "watch next drop 501").to_string(), "true");
}

// A SubRip file beside the video plays with the file as it is: the app
// asks for the file and draws the line of the time over the video, with no
// new stream.
function test_drawn_subtitles(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let playing = video_drawn(log, f);
  let plays = count_plays(log);
  let chosen = tap(tap(tap(playing, log, 400i64, f, "overlay"), log, 500i64, f, "tracks"), log, 600i64, f, "sub:33");
  if (count_plays(log) != plays || has_call(log, "subtitles=burn")) {
    return test.fail("a subtitle file beside the video started a new stream: " + log.calls.get().join(" | "));
  }
  if (!has_url(log, "https://up.example:32400/library/streams/33")) {
    return test.fail("the app did not ask for the subtitle file: " + log.urls.get().join(" | "));
  }
  let shown = settle(chosen, log, 800i64, f);
  return test.assert_eq(says(shown, "Hello from SRT").to_string(), "true");
}

// The home screen gives TalkBack each poster by its title, with a click
// and a long click, and the words of each button. A double tap on a poster
// opens it, and a double tap and hold opens its menu.
function test_accessibility(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let items = log.access.get();
  let poster = -1;
  for it in items {
    if (it.text == "Inception" && (it.actions & android.ACCESS_LONG_CLICK) != 0 && (it.actions & android.ACCESS_CLICK) != 0) {
      poster = it.id;
    }
  }
  if (poster < 0) {
    return test.fail("no poster for TalkBack: " + items.map((i: android.AccessItem): string => i.text).join(" | "));
  }
  if (items.filter((i: android.AccessItem): boolean => i.text == "Libraries").len() == 0) {
    return test.fail("no tab for TalkBack");
  }
  let menu = at(home, log, 100i64, f, android.Access(poster, android.ACCESS_LONG_CLICK));
  if (menu.menu.key.len() == 0) {
    return test.fail("a double tap and hold did not open the menu of the poster");
  }
  let again = shown(log, f, "https://up.example:32400", "srv");
  let detail = settle(at(again, log, 200i64, f, android.Access(poster, android.ACCESS_CLICK)), log, 200i64, f);
  return test.assert_eq((detail.screen == ui.DETAIL).to_string(), "true");
}

// The tap name of the poster of the item `key` on the screen.
function poster_of(s: control.App, key: string): string {
  for n in s.nodes {
    if (n.tap.name.starts_with("hub:") && n.say.len() == 0) {
      let parts = n.tap.name.split(":");
      if (parts.len() == 3) {
        let hubs = control.view(s).hubs;
        let i = control.num(parts[1]);
        let j = control.num(parts[2]);
        if (i < hubs.len() && j < hubs[i].items.len() && hubs[i].items[j].key == key) {
          return n.tap.name;
        }
      }
    }
  }
  return "";
}

// A finger that rests on the poster `act` from `now` opens its menu.
function hold(own s: control.App, log: Log, now: i64, f: draw.Frame, act: string): control.App {
  let Some(n) = node(s, act) else {
    return s;
  };
  let (x, y) = centre(n);
  let held = at(at(s, log, now, f, android.Touch(0, x as f32, y as f32)), log, now + 550i64, f, android.Tick);
  return settle(at(held, log, now + 600i64, f, android.Touch(1, x as f32, y as f32)), log, now + 600i64, f);
}

// Download in the menu of a poster asks for the metadata of the item and
// gives Android the file of its part, and the app keeps the list in its
// files. The menu shows the progress, and a done download shows in a row
// of the home screen. After a new start with no server, the row is still
// there, and Play reads the file. The place where that play stopped waits
// in a file until a server answers, and then the server hears it. Remove
// download deletes the download. An item that
// the phone does not play as it is downloads as one Matroska file that the
// server transcodes.
function test_downloads(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let film = poster_of(home, "501");
  let menu = hold(home, log, 1000i64, f, film);
  if (!says(menu, "Download")) {
    return test.fail("no Download in the menu");
  }
  let asked = tap(menu, log, 1700i64, f, "menu:download");
  if (!has_call(log, "download https://up.example:32400/library/parts/11/file.mp4?download=1 501.mp4 Inception")) {
    return test.fail("no download of the part: " + log.calls.get().join(" | "));
  }
  if (!file_of(log, "/data/downloads").starts_with("42\t501\t501.mp4\t1\t") || file_of(log, "/data/download-501.json").len() == 0) {
    return test.fail("the list of downloads: " + file_of(log, "/data/downloads"));
  }
  if (control.timeout(asked, 1700i64) > 1000) {
    return test.fail("no wake-up for the progress");
  }
  log.progress.set(download.Progress { status: download.RUNNING, done: 500i64, total: 1000i64 });
  let running = hold(at(asked, log, 3000i64, f, android.Tick), log, 3100i64, f, film);
  if (!says(running, "Stop download (50%)")) {
    return test.fail("no progress in the menu");
  }
  log.progress.set(download.Progress { status: download.DONE, done: 1000i64, total: 1000i64 });
  let done = at(tap(running, log, 3800i64, f, "menu:close"), log, 5000i64, f, android.Tick);
  let rows = control.view(done).hubs;
  let last = rows[rows.len() - 1];
  if (last.title != "Downloads" || last.items.len() != 1 || last.items[0].key != "501" || !file_of(log, "/data/downloads").starts_with("42\t501\t501.mp4\t8\t")) {
    return test.fail("no row of downloads");
  }
  let off = shown(log, f, "https://down.example:32400", "srv");
  let rows_off = control.view(off).hubs;
  if (!off.offline || rows_off.len() != 1 || rows_off[0].title != "Downloads" || control.view(off).error != "" || !says(off, "Offline: the downloads play with no server")) {
    return test.fail("with no server, the home screen is not the row of the downloads alone: " + off.error);
  }
  let row = poster_of(off, "501");
  let parts = row.split(":");
  if (row.len() == 0 || control.num(parts[1]) != control.view(off).hubs.len() - 1) {
    return test.fail("the downloads are not the last row after a new start");
  }
  let played = tap(hold(off, log, 1000i64, f, row), log, 1700i64, f, "menu:play");
  if (!has_call(log, "play file:///sdcard/files/501.mp4") || played.play.stream.transcode) {
    return test.fail("Play did not read the file: " + log.calls.get().join(" | "));
  }
  let ready = settle(at(played, log, 1800i64, f, android.Posted(19, 0 as usize)), log, 1800i64, f);
  let stopped = settle(at(at(ready, log, 2000i64, f, android.Key(4, 0)), log, 2000i64, f, android.Key(4, 1)), log, 2000i64, f);
  if (!file_of(log, "/data/downloads").starts_with("42\t501\t501.mp4\t8\t120000")) {
    return test.fail("the place of the download: " + file_of(log, "/data/downloads"));
  }
  if (file_of(log, "/data/pending") != "501\t0\t120000\t8880000\n") {
    return test.fail("the app did not keep the stop that no server heard: " + file_of(log, "/data/pending"));
  }
  let kept = poster_of(stopped, "501");
  let removed = tap(hold(stopped, log, 3000i64, f, kept), log, 3700i64, f, "menu:download");
  if (!has_call(log, "download remove 42") || file_of(log, "/data/downloads") != "\n" || control.view(removed).hubs.len() != 0) {
    return test.fail("Remove download kept the file");
  }
  log.decoders.set(["video/hevc", "audio/mp4a-latm"]);
  let online = shown(log, f, "https://up.example:32400", "srv");
  if (online.offline) {
    return test.fail("a reply of the server did not end the offline state");
  }
  let heard = log.urls.get().filter((u: string): boolean => u.starts_with("GET https://up.example:32400/:/timeline?") && u.contains("ratingKey=501") && u.contains("state=stopped") && u.contains("&time=120000&duration=8880000"));
  if (heard.len() != 1 || file_of(log, "/data/pending") != "\n") {
    return test.fail("the server did not hear the stop of the offline play: " + file_of(log, "/data/pending"));
  }
  let other = poster_of(online, "502");
  let converted = tap(hold(online, log, 4000i64, f, other), log, 4700i64, f, "menu:download");
  let conversions = log.calls.get().filter((c: string): boolean => c.starts_with("download https://up.example:32400/video/:/transcode/universal/start?"));
  if (conversions.len() != 1 || !conversions[0].contains("protocol=http&") || !conversions[0].contains("container%3Dmkv") || !conversions[0].ends_with(" 502.transcode.mkv Inception") || converted.error != "") {
    return test.fail("a file that needs a transcode did not download as one: " + log.calls.get().join(" | "));
  }
  return test.assert_eq((converted.downloads.len() == 1 && converted.downloads[0].file == "502.transcode.mkv").to_string(), "true");
}

// The sheet of tracks of a download lists the tracks of its file, and a
// choice plays on in the file. A file as it is changes its sound in place.
// A transcode lists only the sound that it played. The text of a subtitle
// came with the download, so the app reads it from the phone.
function test_downloaded_tracks(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let home_poster = poster_of(home, "501");
  let asked = tap(hold(home, log, 1000i64, f, home_poster), log, 1700i64, f, "menu:download");
  let saved = settle(asked, log, 1800i64, f);
  if (file_of(log, "/data/download-501-33.sub").len() == 0) {
    return test.fail("the download did not keep the text of its subtitle");
  }
  log.progress.set(download.Progress { status: download.DONE, done: 1000i64, total: 1000i64 });
  let done = at(saved, log, 5000i64, f, android.Tick);
  let done_poster = poster_of(done, "501");
  let played = tap(hold(done, log, 5100i64, f, done_poster), log, 5800i64, f, "menu:play");
  let ready = settle(at(played, log, 5900i64, f, android.Posted(19, 0 as usize)), log, 5900i64, f);
  let plays = count_plays(log);
  let fetched = log.urls.get().filter((u: string): boolean => u.contains("/library/streams/33")).len();
  let sheet = tap(tap(ready, log, 6000i64, f, "overlay"), log, 6100i64, f, "tracks");
  let listed = node(sheet, "audio:22").is_some() && node(sheet, "sub:33").is_some() && node(sheet, "sub:31").is_none();
  let commentary = tap(sheet, log, 6200i64, f, "audio:22");
  if (!listed || !has_call(log, "track 2") || count_plays(log) != plays || !commentary.play.stream.url.starts_with("file://")) {
    return test.fail("the sound of the file did not change in place: " + log.calls.get().join(" | "));
  }
  let subs = tap(tap(commentary, log, 6300i64, f, "tracks"), log, 6400i64, f, "sub:33");
  let again = log.urls.get().filter((u: string): boolean => u.contains("/library/streams/33")).len();
  if (subs.play.cues.len() == 0 || again != fetched || count_plays(log) != plays) {
    return test.fail("the subtitle of the file did not come from the phone");
  }
  log.decoders.set(["video/hevc", "audio/mp4a-latm"]);
  let other = shown(log, f, "https://up.example:32400", "srv");
  let other_poster = poster_of(other, "502");
  let copied = settle(tap(hold(other, log, 7000i64, f, other_poster), log, 7700i64, f, "menu:download"), log, 7800i64, f);
  let copy = at(copied, log, 9000i64, f, android.Tick);
  let copy_poster = poster_of(copy, "502");
  let opened = tap(hold(copy, log, 9100i64, f, copy_poster), log, 9800i64, f, "menu:play");
  if (!has_call(log, "play file:///sdcard/files/502.transcode.mkv")) {
    return test.fail("the transcode did not play from the phone: " + log.calls.get().join(" | "));
  }
  let up = settle(at(opened, log, 9900i64, f, android.Posted(19, 0 as usize)), log, 9900i64, f);
  let at_start = count_plays(log);
  let tracks = tap(tap(up, log, 10000i64, f, "overlay"), log, 10100i64, f, "tracks");
  let one_sound = node(tracks, "audio:21").is_some() && node(tracks, "audio:22").is_none() && node(tracks, "sub:31").is_none();
  let shown_sub = tap(tracks, log, 10200i64, f, "sub:33");
  if (!one_sound || count_plays(log) != at_start || shown_sub.play.cues.len() == 0) {
    return test.fail("the transcode did not list its own tracks, or left its file: " + log.calls.get().join(" | "));
  }
  return test.assert_eq(shown_sub.play.stream.url, "file:///sdcard/files/502.transcode.mkv");
}

// Download all in the menu of a season downloads each of its episodes. The
// screen of the downloads, from the settings, shows each one with its
// state. A tap on a done download plays its file, and Remove deletes it.
function test_download_all_and_the_screen(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let season = plex.Item { ...plex.no_item(), key: "600", kind: "season", title: "Season 1" };
  let menu = settle(control.App { ...home, menu: season, dirty: true }, log, 100i64, f);
  if (!says(menu, "Download all") || node(menu, "menu:download").is_some()) {
    return test.fail("no Download all in the menu of a season");
  }
  let asked = settle(tap(menu, log, 200i64, f, "menu:download_all"), log, 300i64, f);
  let starts = log.calls.get().filter((c: string): boolean => c.starts_with("download http"));
  if (!has_url(log, "/library/metadata/600/allLeaves") || starts.len() != 2 || asked.downloads.len() != 2) {
    return test.fail("the season did not download each episode: " + log.calls.get().join(" | "));
  }
  let settings = tap(asked, log, 400i64, f, "tab:3");
  if (!says(settings, "0 of 2 done")) {
    return test.fail("the settings do not count the downloads");
  }
  let list = tap(settings, log, 500i64, f, "downloads");
  if (list.screen != ui.DOWNLOADS || !says(list, "Waiting") || node(list, "saved:0").is_some() || node(list, "unsave:1").is_none()) {
    return test.fail("the screen of the downloads");
  }
  log.progress.set(download.Progress { status: download.DONE, done: 1000i64, total: 1000i64 });
  let done = at(list, log, 5000i64, f, android.Tick);
  if (!says(done, "Done") || node(done, "saved:0").is_none()) {
    return test.fail("a done download does not show as done");
  }
  let removed = tap(done, log, 5100i64, f, "unsave:1");
  if (!has_call(log, "download remove 43") || removed.downloads.len() != 1) {
    return test.fail("Remove did not delete the download: " + log.calls.get().join(" | "));
  }
  let plays = count_plays(log);
  let played = tap(removed, log, 5200i64, f, "saved:0");
  return test.assert_eq((count_plays(log) == plays + 1 && has_call(log, "play file:///sdcard/files/") && played.screen == ui.PLAYER).to_string(), "true");
}

// While a track of an album plays, the second player prepares the next
// one, and once it is ready it follows with no gap: at the end of the
// track the players swap, and nothing opens a stream. A change of the
// plan, such as shuffle, takes the waiting track away for a new one. When
// the waiting track fails, the end of the track starts the next one as
// before.
function test_gapless_album(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let s = at(control.new(fake(log, 0i64, f), "/data", "https://up.example:32400", "srv", "701"), log, 0i64, f, android.Start);
  let album = settle(at(s, log, 0i64, f, android.WindowCreated(android.Window { ptr: 1 as usize })), log, 0i64, f);
  let one = settle(at(tap(album, log, 100i64, f, "play"), log, 150i64, f, android.Posted(19, 0 as usize)), log, 150i64, f);
  if (log.calls.get().filter((c: string): boolean => c.starts_with("next ") && c.contains("/library/parts/72/")).len() != 1 || one.play.next.key != "712") {
    return test.fail("the second player did not prepare the next track: " + log.calls.get().join(" | "));
  }
  let ready = settle(at(one, log, 200i64, f, android.Posted(19 | 1 << 8, 0 as usize)), log, 200i64, f);
  if (!has_call(log, "chain true") || !ready.play.next_ready) {
    return test.fail("the prepared track was not chained");
  }
  let plays = count_plays(log);
  let stops = count_calls(log, "stop");
  let two = settle(at(ready, log, 300i64, f, android.Posted(20, 0 as usize)), log, 300i64, f);
  if (!has_call(log, "swap") || two.play.item.key != "712" || !two.play.prepared || count_plays(log) != plays || count_calls(log, "stop") != stops) {
    return test.fail("the end of the track did not swap the players: " + log.calls.get().join(" | "));
  }
  if (!has_url(log, "/:/scrobble?identifier=com.plexapp.plugins.library&key=711") || !has_call(log, "media Two by Band on Album playing=true")) {
    return test.fail("the server and the media session did not hear of the next track: " + log.calls.get().join(" | "));
  }
  if (two.play.next.key != "713" || two.play.queue.len() != 1) {
    return test.fail("the track after did not line up: " + two.play.next.key);
  }
  let chains = count_calls(log, "chain false");
  let mixed = tap(two, log, 400i64, f, "shuffle");
  if (count_calls(log, "chain false") != chains + 1 || mixed.play.next_ready) {
    return test.fail("shuffle did not take the waiting track away");
  }
  let failed = settle(at(mixed, log, 500i64, f, android.Posted(21 | 1 << 8, (1u64 << 32u64 | 4294966292u64) as usize)), log, 500i64, f);
  if (failed.play.next.key.len() != 0 || !failed.play.active) {
    return test.fail("a failed next track stopped the music");
  }
  let three = settle(at(failed, log, 600i64, f, android.Posted(20, 0 as usize)), log, 600i64, f);
  if (count_plays(log) != plays + 1 || last_part(log) != "73") {
    return test.fail("the end of the track after a failed next track did not play on: " + log.calls.get().join(" | "));
  }
  return test.pass();
}

function count_plays(log: Log): i32 {
  return log.calls.get().filter((c: string): boolean => c.starts_with("play ")).len();
}

// The first connection that answered wins, unless a better one still
// waits and the wait is not over. A failed connection does not hold up a
// worse one that answered.
function test_connection_race(): test.TestOutcome {
  let got = [control.winner([0, 1], false), control.winner([0, 1], true), control.winner([2, 1], false), control.winner([1, 0], false), control.winner([2, 2], false), control.winner([0, 0], true)];
  return test.assert_eq(got.map((k: i32): string => k.to_string()).join(" "), "-1 1 1 0 -1 -1");
}

// In an intro, a Skip intro button shows over the video with no controls,
// and a tap on it seeks to the end of the intro.
function test_skip_intro(): test.TestOutcome {
  let log = new_log();
  log.gpu.set(true);
  let f = frame();
  defer free_frame(f);
  let playing = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "hub:1:1"), log, 200i64, f, "play");
  if (!has_url(log, "/library/metadata/502?includeMarkers=1")) {
    return test.fail("no metadata of the item that plays");
  }
  let ready = settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
  let ticked = settle(ready, log, 1000i64, f);
  if (node(ticked, "skip").is_none() || node(ticked, "overlay").is_none()) {
    return test.fail("no skip button over the video");
  }
  let drawn = at(ticked, log, 1010i64, f, android.Vsync(1000000000i64));
  if (count_calls(log, "draw video with controls") == 0) {
    return test.fail("the skip button did not draw over the video");
  }
  let skipped = tap(drawn, log, 1100i64, f, "skip");
  return test.assert_eq(has_call(log, "seek 130000").to_string(), "true");
}

// The detail screen of a season that plays its first episode, with the
// rest as the next items.
function season_playing(log: Log, f: draw.Frame): control.App {
  let home = shown(log, f, "https://up.example:32400", "srv");
  let season = plex.Item { ...plex.no_item(), key: "600", kind: "season", title: "Season 1" };
  let detail = settle(control.App { ...home, screen: ui.DETAIL, item: season, children: plex.parse_items(EPISODES).items, dirty: true }, log, 100i64, f);
  let playing = tap(detail, log, 200i64, f, "play");
  return settle(at(playing, log, 300i64, f, android.Posted(19, 0 as usize)), log, 300i64, f);
}

// In the credits, a card shows the next episode and counts down from 10
// seconds, and then the next episode plays. The app reports the episode
// that ended as stopped at its end.
function test_up_next_plays(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let ready = season_playing(log, f);
  let carded = settle(ready, log, 1000i64, f);
  if (node(carded, "next_now").is_none() || node(carded, "next_cancel").is_none()) {
    return test.fail("no card of the next item: " + log.calls.get().join(" | "));
  }
  let plays = count_plays(log);
  let next = settle(carded, log, 11500i64, f);
  if (count_plays(log) != plays + 1 || !has_call(log, "play https://up.example:32400/library/parts/11/file.mp4")) {
    return test.fail("the next episode did not play after the countdown: " + log.calls.get().join(" | "));
  }
  let reported = settle(next, log, 12000i64, f);
  let stops = log.urls.get().filter((u: string): boolean => u.contains("ratingKey=503") && u.contains("state=stopped"));
  return test.assert_eq((stops.len() == 1 && stops[0].contains("&time=8880000&duration=8880000")).to_string(), "true");
}

// While the card shows, the second player prepares the next episode. At
// the end of the countdown, it plays at once in place of the episode that
// ends, and the first player does not open it again.
function test_up_next_prepares_early(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let ready = season_playing(log, f);
  if (has_call(log, "next https://")) {
    return test.fail("the second player prepared the next episode before the card");
  }
  let carded = settle(ready, log, 1000i64, f);
  if (!has_call(log, "next https://up.example:32400/library/parts/11/file.mp4") || carded.play.next.key != "501") {
    return test.fail("the second player did not prepare the next episode: " + log.calls.get().join(" | "));
  }
  let prepared = settle(at(carded, log, 1100i64, f, android.Posted(19 | 1 << 8, 0 as usize)), log, 1100i64, f);
  if (!prepared.play.next_ready || has_call(log, "chain true")) {
    return test.fail("the prepared episode is not ready, or it was chained as a track");
  }
  let plays = count_plays(log);
  let shows = count_calls(log, "show");
  let starts = count_calls(log, "start");
  let next = settle(prepared, log, 11500i64, f);
  if (count_calls(log, "swap") != 1 || count_plays(log) != plays || next.play.item.key != "501" || !next.play.prepared) {
    return test.fail("the second player did not take over: " + log.calls.get().join(" | "));
  }
  if (count_calls(log, "show") != shows + 1 || count_calls(log, "start") != starts + 1 || next.screen != ui.PLAYER) {
    return test.fail("the next episode is not on the screen: " + log.calls.get().join(" | "));
  }
  if (!has_url(log, "/library/metadata/501?includeMarkers=1")) {
    return test.fail("no metadata of the next episode");
  }
  let stops = log.urls.get().filter((u: string): boolean => u.contains("ratingKey=503") && u.contains("state=stopped"));
  return test.assert_eq((stops.len() == 1 && stops[0].contains("&time=8880000&duration=8880000")).to_string(), "true");
}

// Cancel on the card hides it, the second player lets the next episode go,
// and the next episode does not play.
function test_up_next_cancel(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let carded = settle(season_playing(log, f), log, 1000i64, f);
  let plays = count_plays(log);
  let off = tap(carded, log, 1100i64, f, "next_cancel");
  if (node(off, "next_now").is_some()) {
    return test.fail("the card stayed");
  }
  if (count_calls(log, "chain false") != 1 || off.play.next.key.len() != 0) {
    return test.fail("the second player kept the next episode: " + log.calls.get().join(" | "));
  }
  let later = settle(off, log, 20000i64, f);
  return test.assert_eq((count_plays(log) - plays).to_string(), "0");
}

function test_library_pages(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let sections = tap(home, log, 100i64, f, "tab:1");
  let lib = tap(sections, log, 200i64, f, "section:0");
  if (node(lib, "grid:0").is_none() || !has_url(log, "/library/sections/1/all?X-Plex-Container-Start=0&X-Plex-Container-Size=60")) {
    return test.fail("no first page");
  }
  save_png(f, "library");
  if (has_url(log, "X-Plex-Container-Start=60&")) {
    return test.fail("a page far below the screen came at once");
  }
  // Drag up five screens.
  let t = at(lib, log, 300i64, f, android.Touch(0, 270.0, 1000.0));
  let i = 0;
  while (i < 40) {
    t = at(t, log, 300i64 + i as i64, f, android.Touch(2, 270.0, 1000.0 - (i * 120) as f32));
    i += 1;
  }
  t = settle(at(t, log, 400i64, f, android.Touch(1, 270.0, -3680.0)), log, 400i64, f);
  return test.assert_eq((has_url(log, "X-Plex-Container-Start=60&") && !has_url(log, "X-Plex-Container-Start=180&")).to_string(), "true");
}

// The title order shows a strip of the first letters. A drag along it and
// a tap on a letter scroll to the first item of the letter, and ask for its
// page with no page before it.
function test_library_letters(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let lib = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "tab:1"), log, 200i64, f, "section:0");
  let (Some(a), Some(b)) = (node(lib, "letter:0"), node(lib, "letter:1")) else {
    return test.fail("no letter strip: " + log.urls.get().join(" | "));
  };
  save_png(f, "letters");
  let (ax, ay) = centre(a);
  let (bx, by) = centre(b);
  let down = at(lib, log, 300i64, f, android.Touch(0, ax as f32, ay as f32));
  let slid = settle(at(at(down, log, 320i64, f, android.Touch(2, ax as f32, by as f32)), log, 340i64, f, android.Touch(1, ax as f32, by as f32)), log, 340i64, f);
  if (!has_url(log, "X-Plex-Container-Start=60&") || has_url(log, "X-Plex-Container-Start=120&") || node(slid, "grid:100").is_none()) {
    return test.fail("the drag to B did not show its first item: " + log.urls.get().join(" | "));
  }
  let c = tap(slid, log, 400i64, f, "letter:2");
  return test.assert_eq((has_url(log, "X-Plex-Container-Start=120&") && node(c, "grid:150").is_some() && !has_url(log, "X-Plex-Container-Start=240&")).to_string(), "true");
}

// The chip of the order moves to the next order and loads the library again
// in it. The year order has no letter strip. The filter chip asks for the
// items not watched.
function test_library_sort_and_filter(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let lib = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "tab:1"), log, 200i64, f, "section:0");
  let year = tap(lib, log, 300i64, f, "sort:1");
  if (!has_url(log, "sort=year%3Adesc") || node(year, "letter:0").is_some() || node(year, "grid:0").is_none()) {
    return test.fail("no library in the year order: " + log.urls.get().join(" | "));
  }
  let fresh = tap(year, log, 400i64, f, "unwatched:1");
  if (!has_url(log, "sort=year%3Adesc&includeGuids=0&unwatched=1") || node(fresh, "unwatched:0").is_none()) {
    return test.fail("no filter of the items not watched: " + log.urls.get().join(" | "));
  }
  return test.assert_eq(node(fresh, "sort:2").is_some().to_string(), "true");
}

// A quick swipe up the library lets the grid move on after the finger
// leaves, slower and slower, until it stops. A touch stops it at once.
function test_fling_moves_the_library(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let lib = tap(tap(shown(log, f, "https://up.example:32400", "srv"), log, 100i64, f, "tab:1"), log, 200i64, f, "section:0");
  let t = at(lib, log, 300i64, f, android.Touch(0, 270.0, 900.0));
  for i in 1..6 {
    t = at(t, log, 300i64 + (i * 10) as i64, f, android.Touch(2, 270.0, 900.0 - (i * 40) as f32));
  }
  t = at(t, log, 360i64, f, android.Touch(1, 270.0, 700.0));
  let left = t.scroll;
  let a = at(t, log, 370i64, f, android.Vsync(1000000000i64));
  let b = at(a, log, 400i64, f, android.Vsync(1100000000i64));
  let at_b = b.scroll;
  if (at_b <= left || !has_call(log, "frame")) {
    return test.fail("the grid did not move on after the finger left: " + left.to_string() + " " + at_b.to_string());
  }
  let c = at(b, log, 500i64, f, android.Vsync(1200000000i64));
  if (c.scroll <= at_b) {
    return test.fail("the fling stopped too soon");
  }
  let held = at(c, log, 510i64, f, android.Touch(0, 270.0, 500.0));
  let at_held = held.scroll;
  let d = at(held, log, 520i64, f, android.Vsync(1300000000i64));
  let at_d = d.scroll;
  if (at_d != at_held) {
    return test.fail("a touch did not stop the fling");
  }
  let e = at(at(d, log, 530i64, f, android.Touch(1, 270.0, 500.0)), log, 540i64, f, android.Vsync(9000000000i64));
  return test.assert_eq(e.scroll.to_string(), at_d.to_string());
}

// With a GPU, the screen draws at the vsync after it changed, and not at
// the event that changed it.
function test_gpu_draws_at_the_vsync(): test.TestOutcome {
  let log = new_log();
  log.gpu.set(true);
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let before = count_calls(log, "present screen");
  let sections = tap(home, log, 100i64, f, "tab:1");
  if (count_calls(log, "present screen") != before || node(sections, "section:0").is_none()) {
    return test.fail("the screen drew before the vsync");
  }
  let drawn = at(sections, log, 200i64, f, android.Vsync(1000000000i64));
  let again = at(drawn, log, 210i64, f, android.Vsync(1016000000i64));
  return test.assert_eq((count_calls(log, "present screen") - before).to_string(), "1");
}

function test_search_types_and_asks(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let search = tap(tap(home, log, 100i64, f, "tab:2"), log, 200i64, f, "type");
  if (!has_call(log, "field show []")) {
    return test.fail("no keyboard");
  }
  let t = search;
  for c in [105, 110, 99, 233] {
    t = at(t, log, 300i64, f, android.Char(c));
  }
  t = at(t, log, 300i64, f, android.Key(67, 0));
  t = at(t, log, 300i64, f, android.Key(67, 1));
  if (!has_call(log, "field set [inc]")) {
    return test.fail("the field does not have the typed text: " + log.calls.get().join(" | "));
  }
  if (has_url(log, "/hubs/search")) {
    return test.fail("a search before the pause in typing");
  }
  t = settle(at(t, log, 1100i64, f, android.Tick), log, 1100i64, f);
  save_png(f, "search");
  if (!has_url(log, "/hubs/search?query=inc&")) {
    return test.fail("no search for inc: " + log.urls.get().join(" | "));
  }
  return test.assert_eq(node(t, "hub:0:0").is_some().to_string(), "true");
}

// The keyboard of the system types through the text field, and its action
// key searches at once.
function test_search_from_text_field(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let home = shown(log, f, "https://up.example:32400", "srv");
  let t = tap(tap(home, log, 100i64, f, "tab:2"), log, 200i64, f, "type");
  t = at(t, log, 300i64, f, android.Text("Incep"));
  t = settle(at(t, log, 300i64, f, android.TextAction(android.ACTION_SEARCH)), log, 300i64, f);
  if (!has_url(log, "/hubs/search?query=Incep&")) {
    return test.fail("no search for Incep: " + log.urls.get().join(" | "));
  }
  return test.assert_eq(has_call(log, "field hide").to_string() + " " + has_call(log, "field set").to_string(), "true false");
}

function test_back_and_sign_out(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let s = signed_in(log, f);
  let settings = tap(s, log, 3000i64, f, "tab:3");
  save_png(f, "settings");
  let out = tap(settings, log, 3100i64, f, "signout");
  if (node(out, "signin").is_none()) {
    return test.fail("no sign-in screen after the sign-out");
  }
  if (control.setting(file_of(log, "/data/settings"), "token").len() != 0) {
    return test.fail("the token stayed");
  }
  let gone = at(at(out, log, 3200i64, f, android.Key(4, 0)), log, 3200i64, f, android.Key(4, 1));
  return test.assert_eq(has_call(log, "finish").to_string(), "true");
}

// The back key of Android does what the close or back control of the screen
// does: it closes the menu of a poster, the keypad of a PIN, the sheet of
// tracks and the code of a sign-in, and goes back from a page. Only the home
// screen closes the app.
function test_system_back_is_the_app_back(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let signin = tap(shown(log, f, "", ""), log, 100i64, f, "signin");
  let unsigned = press(signin, log, 200i64, f, 4);
  if (node(unsigned, "cancel").is_some() || node(unsigned, "signin").is_none() || has_call(log, "finish")) {
    return test.fail("back did not cancel the sign-in code");
  }
  let home = shown(log, f, "https://up.example:32400", "srv");
  let Some(p) = node(home, "hub:0:0") else {
    return test.fail("no poster");
  };
  let (x, y) = centre(p);
  let held = at(at(home, log, 1000i64, f, android.Touch(0, x as f32, y as f32)), log, 1550i64, f, android.Tick);
  let menu = settle(at(held, log, 1600i64, f, android.Touch(1, x as f32, y as f32)), log, 1600i64, f);
  let opened = node(menu, "menu:close").is_some();
  let closed = press(menu, log, 1700i64, f, 4);
  if (!opened || node(closed, "menu:close").is_some() || closed.screen != ui.HOME || has_call(log, "finish")) {
    return test.fail("back did not close the menu of the poster");
  }
  let detail = tap(closed, log, 1800i64, f, "hub:1:0");
  let on_page = detail.screen == ui.DETAIL && node(detail, "back").is_some();
  let returned = press(detail, log, 1900i64, f, 4);
  if (!on_page || returned.screen != ui.HOME) {
    return test.fail("back from a page did not go to the screen before, as the back arrow does");
  }
  let playing = tap(tap(returned, log, 2000i64, f, "hub:1:0"), log, 2100i64, f, "play");
  let ready = settle(at(playing, log, 2200i64, f, android.Posted(19, 0 as usize)), log, 2200i64, f);
  let sheet = tap(tap(ready, log, 2300i64, f, "overlay"), log, 2400i64, f, "tracks");
  let listed = node(sheet, "audio:22").is_some();
  let shut = press(sheet, log, 2500i64, f, 4);
  if (!listed || node(shut, "audio:22").is_some() || shut.screen != ui.PLAYER || has_call(log, "stop")) {
    return test.fail("back did not close the sheet of tracks: " + log.calls.get().join(" | "));
  }
  let left = press(shut, log, 2600i64, f, 4);
  if (left.screen == ui.PLAYER || !has_call(log, "stop")) {
    return test.fail("back did not leave the player");
  }
  let users = tap(tap(signed_in(log, f), log, 3000i64, f, "tab:3"), log, 3100i64, f, "users");
  let pad = tap(users, log, 3200i64, f, "user:1");
  let keyed = node(pad, "pinkey:5").is_some();
  let no_pad = press(pad, log, 3300i64, f, 4);
  if (!keyed || node(no_pad, "pinkey:5").is_some() || no_pad.screen != ui.USERS) {
    return test.fail("back did not close the keypad of the PIN");
  }
  let settings = press(no_pad, log, 3400i64, f, 4);
  if (settings.screen == ui.USERS || has_call(log, "finish")) {
    return test.fail("back did not go back from the list of the users");
  }
  let out = press(press(settings, log, 3500i64, f, 4), log, 3600i64, f, 4);
  return test.assert_eq(has_call(log, "finish").to_string(), "true");
}

function test_link_plays_an_item(): test.TestOutcome {
  let log = new_log();
  let f = frame();
  defer free_frame(f);
  let s = at(control.new(fake(log, 0i64, f), "/data", "https://up.example:32400", "srv", "501"), log, 0i64, f, android.Start);
  let t = settle(at(s, log, 0i64, f, android.WindowCreated(android.Window { ptr: 1 as usize })), log, 0i64, f);
  if (!has_call(log, "play https://up.example:32400/library/parts/11/file.mp4")) {
    return test.fail("the link did not play the item: " + log.calls.get().join(" | "));
  }
  let back = settle(at(at(t, log, 100i64, f, android.Key(4, 0)), log, 100i64, f, android.Key(4, 1)), log, 100i64, f);
  return test.assert_eq(node(back, "play").is_some().to_string(), "true");
}

function find(ns: scene.Node[], act: string): Option[scene.Node] {
  for n in ns {
    if (n.tap.name == act) {
      return Some(n);
    }
  }
  return None;
}

function inside(n: scene.Node, box: scene.Node): boolean {
  return n.x >= box.x && n.y >= box.y && n.x + n.w <= box.x + box.w && n.y + n.h <= box.y + box.h;
}

// The buttons of the detail screen and the words of the tabs on a window
// `w` wide. Returns "" when each is in the window, or what is not.
function layout_fault(w: i32, h: i32, one_row: boolean): string {
  let it = plex.Item { ...plex.no_item(), key: "/library/metadata/1", kind: "movie", title: "Long", duration_ms: 7200000i64, offset_ms: 3723000i64 };
  let ns = ui.nodes(ui.View { ...ui.empty_view(w, h), screen: ui.DETAIL, item: it });
  let window = scene.node(0, 0, w, h, scene.Blank);
  let Some(play) = find(ns, "play") else {
    return "no play button";
  };
  let Some(mark) = find(ns, "watched") else {
    return "no watched button";
  };
  if (!inside(play, window) || !inside(mark, window)) {
    return "a button is outside the window";
  }
  if (play.y == mark.y != one_row) {
    return "the buttons are on the wrong rows";
  }
  if (play.y == mark.y && play.x + play.w > mark.x) {
    return "the buttons overlap";
  }
  let names = ui.tab_names();
  for i in 0..names.len() {
    let Some(tab) = find(ns, "tab:" + i.to_string()) else {
      return "no tab " + names[i];
    };
    let words = ns.filter((n: scene.Node): boolean => n.say == names[i] && inside(n, tab));
    if (words.len() != 1) {
      return "the words of the tab " + names[i] + " are not in it";
    }
  }
  return "";
}

// The tabs end above the navigation bar, and the title starts below the
// status bar.
function test_system_bars_leave_the_content_free(): test.TestOutcome {
  let log = new_log();
  note(log.files, "/data/settings=id=abc\ntoken=tok-1\nserver_name=Den\nserver_uri=https://up.example:32400\nserver_token=srv\n");
  let f = frame();
  defer free_frame(f);
  let s = settle(at(shown(log, f, "", ""), log, 0i64, f, android.ContentRect(0, 80, W, H - 100)), log, 0i64, f);
  let low = 0;
  for n in s.nodes {
    if (n.tap.name.starts_with("tab:")) {
      low = low.max(n.y + n.h);
    }
  }
  save_png(f, "insets");
  let title = s.nodes.filter((n: scene.Node): boolean => n.say == "Den");
  if (title.len() != 1) {
    return test.fail("no title");
  }
  return test.assert_eq((low == H - 100).to_string() + " " + (title[0].y >= 80).to_string(), "true true");
}

function test_layout_fits_the_window(): test.TestOutcome {
  return test.assert_eq(layout_fault(W, H, false) + "|" + layout_fault(1080, 2400, true) + "|" + music_fault(W, H) + "|" + music_fault(1080, 2400), "|||");
}

// The buttons of music and the seek bar end above the navigation bar, and
// the buttons are under the seek bar.
function music_fault(w: i32, h: i32): string {
  let bottom = h / 20;
  let pv = ui.PlayerView { ...ui.no_player(), title: "Song", overlay: true, audio: true, has_next: true, repeat: "REPEAT OFF", sleep: "SLEEP OFF", duration_ms: 300000i64 };
  let ns = ui.nodes(ui.View { ...ui.empty_view(w, h), bottom: bottom, screen: ui.PLAYER, player: pv });
  let free = scene.node(0, 0, w, h - bottom, scene.Blank);
  let Some(bar) = find(ns, "seek") else {
    return "no seek bar";
  };
  for name in ["shuffle", "repeat", "sleep", "next_track"] {
    let Some(b) = find(ns, name) else {
      return "no button " + name;
    };
    if (!inside(b, free) || b.y < bar.y + bar.h) {
      return "the button " + name + " is not between the seek bar and the navigation bar";
    }
  }
  return "";
}

function test_dot_font_has_the_signs(): test.TestOutcome {
  let got = [matrix.covers("+30 -10 < > | & # %"), matrix.covers("Amélie"), matrix.lit(43u8, 2, 3), matrix.lit(43u8, 0, 0)];
  return test.assert_eq(got.map((b: boolean): string => b.to_string()).join(" "), "true false true false");
}

function main(): i32 {
  let r = test.new("plex control");
  r = r.it("a sign-in with a PIN reaches the home screen", test_sign_in_reaches_home);
  r = r.it("a saved server opens the home screen", test_saved_server_opens_home);
  r = r.it("a saved address that fails moves to one that answers", test_saved_server_moves_to_working_address);
