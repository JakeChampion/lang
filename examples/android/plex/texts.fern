// The texts of `lang`, or none for English.
function store(lang: string): kv.Store {
  let col = 0;
  if (lang == "de") {
    col = 1;
  } else if (lang == "fr") {
    col = 2;
  } else if (lang == "es") {
    col = 3;
  }
  let out = kv.empty(lang + ".kv");
  if (col == 0) {
    return out;
  }
  for row in table() {
    out = out.set(row[0], row[col]);
  }
  return out;
}
