    ["Server", "Server", "Serveur", "Servidor"],
    ["Quality", "Qualität", "Qualité", "Calidad"],
    ["Sign out", "Abmelden", "Se déconnecter", "Cerrar sesión"],
    ["PIN", "PIN", "PIN", "PIN"],
    ["ADMIN", "ADMIN", "ADMIN", "ADMIN"],
    ["Tracks", "Spuren", "Pistes", "Pistas"],
    ["UP NEXT IN {0}", "ALS NAECHSTES IN {0}", "ENSUITE DANS {0}", "SIGUIENTE EN {0}"],
    ["SOUND", "TON", "SON", "SONIDO"],
    ["SUBTITLES", "UNTERTITEL", "SOUS-TITRES", "SUBTITULOS"],
    ["Off", "Aus", "Désactivés", "Desactivados"],
    ["Go to show", "Zur Serie", "Aller à la série", "Ir a la serie"],
