    ["This library is empty", "Diese Mediathek ist leer", "Cette bibliothèque est vide", "Esta biblioteca está vacía"],
    ["BY {0}", "NACH {0}", "PAR {0}", "POR {0}"],
    ["TITLE", "TITEL", "TITRE", "TITULO"],
    ["YEAR", "JAHR", "ANNEE", "AÑO"],
    ["ADDED", "NEU", "AJOUT", "AÑADIDO"],
    ["RATING", "WERTUNG", "NOTE", "NOTA"],
    ["UNWATCHED", "UNGESEHEN", "NON VUS", "SIN VER"],
    ["Resume {0}", "Weiter bei {0}", "Reprendre à {0}", "Seguir en {0}"],
    ["Play", "Abspielen", "Lire", "Reproducir"],
    ["SEASONS", "STAFFELN", "SAISONS", "TEMPORADAS"],
    ["ALBUMS", "ALBEN", "ALBUMS", "ALBUMES"],
    ["Mark unwatched", "Als ungesehen markieren", "Marquer comme non vu", "Marcar como no visto"],
    ["Mark watched", "Als gesehen markieren", "Marquer comme vu", "Marcar como visto"],
    ["Search movies, shows and music", "Filme, Serien und Musik suchen", "Chercher des films, des séries et de la musique", "Buscar películas, series y música"],
    ["No results", "Keine Treffer", "Aucun résultat", "Sin resultados"],
