  return [
    ["Home", "Start", "Accueil", "Inicio"],
    ["Libraries", "Mediatheken", "Bibliotheques", "Bibliotecas"],
    ["Search", "Suche", "Recherche", "Buscar"],
    ["Settings", "Einstellungen", "Reglages", "Ajustes"],
    ["Your Plex libraries, in Fern", "Deine Plex-Mediatheken, in Fern", "Vos bibliothèques Plex, dans Fern", "Tus bibliotecas de Plex, en Fern"],
    ["Sign in with Plex", "Mit Plex anmelden", "Se connecter avec Plex", "Iniciar sesión con Plex"],
    ["Go to {0} and enter", "Öffne {0} und gib ein", "Allez sur {0} et saisissez", "Ve a {0} e introduce"],
    ["WAITING FOR PLEX.TV", "WARTE AUF PLEX.TV", "ATTENTE DE PLEX.TV", "ESPERANDO A PLEX.TV"],
    ["Cancel", "Abbrechen", "Annuler", "Cancelar"],
