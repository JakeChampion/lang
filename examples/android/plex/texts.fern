// The texts of the app in German, French and Spanish. The English text is
// the key of each text, so a text with no translation shows in English. A
// key in capitals shows in the dot-matrix font, which has only the capitals
// of ASCII, so its translation has no accents.
import "std/i18n";
import "std/kv";

// The languages that the app has texts for, the first one the default.
pub function languages(): string[] {
  return ["en", "de", "fr", "es"];
}

// The texts for the first of `wanted` that the app has, or English.
pub function for_languages(wanted: string[]): i18n.Strings {
  let lang = i18n.lookup(languages(), wanted, "en");
  return i18n.strings(lang, store(lang), kv.empty("en.kv"));
}

// Each text as a pair of the key and its German, French and Spanish texts.
