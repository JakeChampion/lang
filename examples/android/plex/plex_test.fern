// The tests for plex.fern: the requests that it builds and the records that
// it reads from replies in the shape that plex.tv and a server send.
import "std/test";
import "./plex";

function client(): plex.Client {
  return plex.Client { id: "dev-1", device: "Pixel", token: "" };
}

function base(): plex.Base {
  return plex.Base { uri: "https://10-0-0-5.abc.plex.direct:32400", token: "srv" };
}

function header(r: plex.Request, name: string): string {
  for h in r.headers {
    if (h.0 == name) {
      return h.1;
    }
  }
  return "";
}

function test_headers_name_the_client(): test.TestOutcome {
  let r = plex.pin_request(client());
  if (r.method != "POST" || header(r, "X-Plex-Client-Identifier") != "dev-1" || header(r, "Accept") != "application/json") {
    return test.fail("pin request headers");
  }
  if (header(r, "X-Plex-Token").len() != 0) {
    return test.fail("a token on a request with none");
  }
  return test.assert_eq(header(plex.sections(client(), base()), "X-Plex-Token"), "srv");
}

function test_pin_parse(): test.TestOutcome {
  let waiting = plex.parse_pin("{\"id\":2918,\"code\":\"7XKP\",\"product\":\"Fern for Plex\",\"trusted\":false,\"authToken\":null,\"expiresIn\":900}");
  let Some(p) = waiting else {
    return test.fail("no pin");
  };
  if (p.id != 2918i64 || p.code != "7XKP" || p.token.len() != 0) {
    return test.fail("waiting pin " + p.code + " " + p.token);
  }
  let Some(done) = plex.parse_pin("{\"id\":2918,\"code\":\"7XKP\",\"authToken\":\"tok-123\"}") else {
    return test.fail("no linked pin");
  };
  if (plex.parse_pin("{\"errors\":[]}").is_some()) {
    return test.fail("an error as a pin");
  }
  return test.assert_eq(done.token, "tok-123");
}

const RESOURCES: string = "[{\"name\":\"Den\",\"product\":\"Plex Media Server\",\"provides\":\"server\",\"clientIdentifier\":\"abc\",\"accessToken\":\"srv\",\"owned\":true,\"connections\":[{\"protocol\":\"https\",\"address\":\"1.2.3.4\",\"port\":32400,\"uri\":\"https://1-2-3-4.abc.plex.direct:32400\",\"local\":false,\"relay\":false},{\"uri\":\"https://relay.plex.direct:8443\",\"local\":false,\"relay\":true},{\"uri\":\"https://10-0-0-5.abc.plex.direct:32400\",\"local\":true,\"relay\":false}]},{\"name\":\"Phone\",\"provides\":\"client,player\",\"connections\":[]}]";

function test_servers_and_connection_order(): test.TestOutcome {
  let servers = plex.parse_servers(RESOURCES);
  if (servers.len() != 1 || servers[0].name != "Den" || servers[0].token != "srv" || !servers[0].owned) {
    return test.fail("servers " + servers.len().to_string());
  }
  let order = plex.connection_order(servers[0]);
  return test.assert_eq(order.join(" "), "https://10-0-0-5.abc.plex.direct:32400 https://1-2-3-4.abc.plex.direct:32400 https://relay.plex.direct:8443");
}

// A server on a home network that a phone reaches through Tailscale: its
// LAN and Tailscale addresses are local, with plex.direct names, and its
// public address is remote. Each private local address also gets a plain
// HTTP address, after the local HTTPS ones and before the remote one.
const TAILNET: string = "[{\"name\":\"Synology\",\"provides\":\"server\",\"clientIdentifier\":\"syn\",\"accessToken\":\"srv\",\"connections\":[{\"protocol\":\"https\",\"address\":\"fd7a:115c:a1e0::1\",\"port\":32400,\"uri\":\"https://fd7a-115c-a1e0--1.syn.plex.direct:32400\",\"local\":true,\"relay\":false,\"IPv6\":true},{\"protocol\":\"https\",\"address\":\"192.168.1.20\",\"port\":32400,\"uri\":\"https://192-168-1-20.syn.plex.direct:32400\",\"local\":true,\"relay\":false},{\"protocol\":\"https\",\"address\":\"100.101.102.103\",\"port\":32400,\"uri\":\"https://100-101-102-103.syn.plex.direct:32400\",\"local\":true,\"relay\":false},{\"protocol\":\"https\",\"address\":\"81.2.3.4\",\"port\":32400,\"uri\":\"https://81-2-3-4.syn.plex.direct:32400\",\"local\":true,\"relay\":false},{\"protocol\":\"https\",\"address\":\"81.2.3.4\",\"port\":12345,\"uri\":\"https://81-2-3-4.syn.plex.direct:12345\",\"local\":false,\"relay\":false}]}]";

function test_private_connections_get_http(): test.TestOutcome {
  let servers = plex.parse_servers(TAILNET);
  if (servers.len() != 1) {
    return test.fail("servers " + servers.len().to_string());
  }
  let want = [
    "https://192-168-1-20.syn.plex.direct:32400",
    "https://100-101-102-103.syn.plex.direct:32400",
    "https://81-2-3-4.syn.plex.direct:32400",
    "https://fd7a-115c-a1e0--1.syn.plex.direct:32400",
    "http://192.168.1.20:32400",
    "http://100.101.102.103:32400",
    "http://[fd7a:115c:a1e0::1]:32400",
    "https://81-2-3-4.syn.plex.direct:12345",
  ];
  return test.assert_eq(plex.connection_order(servers[0]).join(" "), want.join(" "));
}

function test_private_hosts(): test.TestOutcome {
  let hosts = ["10.0.0.1", "172.16.0.1", "172.32.0.1", "192.168.0.1", "100.64.0.1", "100.128.0.1", "127.0.0.1", "169.254.1.1", "8.8.8.8", "fd7a:115c:a1e0::1", "2001:db8::1", "nas.local", "nas.tail1234.ts.net", "nas", "plex.tv", "300.1.1.1"];
  return test.assert_eq(hosts.map((h: string): string => plex.private_host(h).to_string()).join(" "), "true true false true true false true true false true false true true true false false");
}

function test_library_requests(): test.TestOutcome {
  let c = plex.Client { id: "id", device: "Android", token: "t" };
  let b = plex.Base { uri: "https://s:32400", token: "srv" };
  let items = plex.section_items(c, b, "3", 120, 60, "year:desc", true);
  let letters = plex.first_letters(c, b, "3", false);
  let got = plex.parse_letters("{\"MediaContainer\":{\"Directory\":[{\"size\":4,\"key\":\"%23\",\"title\":\"#\"},{\"size\":0,\"title\":\"A\"},{\"size\":7,\"title\":\"B\"}]}}");
  let words = [items.url, letters.url, got.map((l: plex.Letter): string => l.key + "=" + l.size.to_string()).join(","), plex.letter_offset(got, 1).to_string()];
  return test.assert_eq(words.join(" "), "https://s:32400/library/sections/3/all?X-Plex-Container-Start=120&X-Plex-Container-Size=60&sort=year%3Adesc&includeGuids=0&unwatched=1 https://s:32400/library/sections/3/firstCharacter #=4,B=7 4");
}

function test_home_users(): test.TestOutcome {
  let c = plex.Client { id: "id", device: "Android", token: "t" };
  let users = plex.parse_home_users("{\"id\":1,\"users\":[{\"uuid\":\"a1\",\"title\":\"Ada\",\"admin\":true},{\"uuid\":\"k2\",\"title\":\"Kid\",\"protected\":true},{\"title\":\"No id\"}]}");
  let words = users.map((u: plex.HomeUser): string => u.title + "/" + u.protected.to_string() + "/" + u.admin.to_string()).join(",");
  let open = plex.switch_user(c, "a1", "");
  let pin = plex.switch_user(c, "k2", "0042");
  return test.assert_eq(words + " " + open.method + " " + open.url + " " + pin.url + " " + plex.parse_switch("{\"authToken\":\"x9\"}"), "Ada/false/true,Kid/true/false POST https://clients.plex.tv/api/v2/home/users/a1/switch https://clients.plex.tv/api/v2/home/users/k2/switch?pin=0042 x9");
}

function test_manual_server(): test.TestOutcome {
  let s = plex.manual_server("http://192.168.1.4:32400/", "t");
  return test.assert_eq(plex.connection_order(s).join(" ") + " " + s.token, "http://192.168.1.4:32400 t");
}

function test_sections_keep_video_and_music(): test.TestOutcome {
  let got = plex.parse_sections("{\"MediaContainer\":{\"size\":3,\"Directory\":[{\"key\":\"1\",\"type\":\"movie\",\"title\":\"Movies\"},{\"key\":\"2\",\"type\":\"show\",\"title\":\"TV Shows\"},{\"key\":\"3\",\"type\":\"photo\",\"title\":\"Photos\"},{\"key\":\"4\",\"type\":\"artist\",\"title\":\"Music\"}]}}");
  let names: string[] = [];
  for s in got {
    names = names.append(s.key + "=" + s.title);
  }
  return test.assert_eq(names.join(","), "1=Movies,2=TV Shows,4=Music");
}

const MOVIE: string = "{\"MediaContainer\":{\"size\":1,\"Metadata\":[{\"ratingKey\":\"501\",\"type\":\"movie\",\"title\":\"Inception\",\"year\":2010,\"summary\":\"A thief.\",\"thumb\":\"/library/metadata/501/thumb/1\",\"art\":\"/library/metadata/501/art/1\",\"duration\":8880000,\"viewOffset\":4440000,\"contentRating\":\"PG-13\",\"audienceRating\":8.7,\"Genre\":[{\"tag\":\"Action\"},{\"tag\":\"Sci-Fi\"}],\"Media\":[{\"id\":9,\"container\":\"mkv\",\"videoCodec\":\"h264\",\"audioCodec\":\"dca\",\"videoResolution\":\"1080\",\"bitrate\":9000,\"Part\":[{\"id\":11,\"key\":\"/library/parts/11/1/file.mkv\",\"container\":\"mkv\",\"size\":1234567}]}]}]}}";

function test_item_fields(): test.TestOutcome {
  let Some(it) = plex.parse_item(MOVIE) else {
    return test.fail("no item");
  };
  if (it.key != "501" || it.year != 2010 || it.duration_ms != 8880000i64 || it.offset_ms != 4440000i64 || it.genres.join("/") != "Action/Sci-Fi") {
    return test.fail("fields of " + it.title);
  }
  if (it.media.len() != 1 || it.media[0].parts[0].key != "/library/parts/11/1/file.mkv" || it.media[0].audio != "dca") {
    return test.fail("media");
  }
  if (plex.progress(it) != 500) {
    return test.fail("progress " + plex.progress(it).to_string());
  }
  return test.assert_eq(plex.facts(it), "2010 · 2h 28m · PG-13 · 8.7 · 1080p");
}

function test_stream_choice(): test.TestOutcome {
  let Some(it) = plex.parse_item(MOVIE) else {
    return test.fail("no item");
  };
  let original = plex.qualities()[0];
  let phone = ["video/avc", "audio/mp4a-latm", "audio/eac3"];
  // The phone has no DTS decoder, so the server converts the sound and
  // copies the video, with no limit of the bitrate.
  let s = plex.stream_for(client(), base(), it, original, 60000i64, "s1", phone, plex.no_choice());
  if (!s.transcode || s.offset_ms != 60000i64 || !s.url.contains("/video/:/transcode/universal/start.m3u8?") || s.url.contains("offset=") || !s.url.contains("session=s1") || !s.url.contains("directStream=1") || !s.url.contains("X-Plex-Platform=Generic") || s.url.contains("add-limitation")) {
    return test.fail("transcode " + s.url);
  }
  if (!s.url.contains("X-Plex-Client-Profile-Extra=add-settings%28DirectPlayStreamSelection%3Dtrue%29%2Badd-transcode-target%28type%3DvideoProfile%26context%3Dstreaming%26protocol%3Dhls%26container%3Dmpegts%26videoCodec%3Dh264%26audioCodec%3Daac%29")) {
    return test.fail("profile " + s.url);
  }
  let eac3 = plex.Item { ...it, media: [plex.Media { ...it.media[0], audio: "eac3" }] };
  if (!plex.direct_playable(eac3, phone) || plex.direct_playable(eac3, ["video/avc", "audio/mp4a-latm"]) || plex.direct_playable(eac3, [])) {
    return test.fail("an E-AC-3 decoder decides direct play");
  }
  let hevc = plex.Item { ...it, media: [plex.Media { ...it.media[0], video: "hevc" }] };
  let full = plex.stream_for(client(), base(), hevc, original, 0i64, "s3", phone, plex.no_choice());
  if (!full.url.contains("name%3Dvideo.bitrate%26value%3D8000") || !full.url.contains("directStream=0") || !full.url.contains("videoQuality=60")) {
    return test.fail("no HEVC decoder, so the server converts the video too: " + full.url);
  }
  let aac = plex.Item { ...it, media: [plex.Media { ...it.media[0], audio: "aac" }] };
  let d = plex.stream_for(client(), base(), aac, original, 60000i64, "s1", phone, plex.no_choice());
  if (d.transcode || d.offset_ms != 60000i64) {
    return test.fail("direct " + d.url);
  }
  let low = plex.stream_for(client(), base(), aac, plex.qualities()[3], 0i64, "s2", phone, plex.no_choice());
  if (!low.url.contains("value%3D4000") || !low.url.contains("videoResolution=1280x720") || !low.url.contains("videoQuality=100")) {
    return test.fail("720p " + low.url);
  }
  return test.assert_eq(d.url, "https://10-0-0-5.abc.plex.direct:32400/library/parts/11/1/file.mkv?X-Plex-Session-Identifier=s1&X-Plex-Token=srv");
}

const HUBS: string = "{\"MediaContainer\":{\"size\":2,\"Hub\":[{\"title\":\"Continue Watching\",\"hubIdentifier\":\"home.continue\",\"size\":1,\"Metadata\":[{\"ratingKey\":\"77\",\"type\":\"episode\",\"title\":\"Pilot\",\"grandparentTitle\":\"Lost\",\"grandparentThumb\":\"/library/metadata/70/thumb/2\",\"thumb\":\"/library/metadata/77/thumb/3\",\"index\":1,\"parentIndex\":1,\"duration\":2500000,\"viewOffset\":100000}]},{\"title\":\"Empty\",\"hubIdentifier\":\"x\",\"size\":0},{\"title\":\"Recently Added Movies\",\"hubIdentifier\":\"home.movies.recent\",\"Metadata\":[{\"ratingKey\":\"501\",\"type\":\"movie\",\"title\":\"Inception\",\"year\":2010},{\"ratingKey\":\"9\",\"type\":\"photo\",\"title\":\"Beach\"}]}]}}";

function test_hubs(): test.TestOutcome {
  let hubs = plex.parse_hubs(HUBS);
  if (hubs.len() != 2 || hubs[1].items.len() != 1) {
    return test.fail("hubs " + hubs.len().to_string());
  }
  let ep = hubs[0].items[0];
  return test.assert_eq(plex.card_title(ep) + "|" + plex.card_subtitle(ep) + "|" + plex.poster(ep), "Lost|S1 E1|/library/metadata/70/thumb/2");
}

function test_page_total(): test.TestOutcome {
  let page = plex.parse_items("{\"MediaContainer\":{\"size\":2,\"totalSize\":340,\"offset\":0,\"Metadata\":[{\"ratingKey\":\"1\",\"type\":\"show\",\"title\":\"A\",\"leafCount\":10,\"viewedLeafCount\":10},{\"ratingKey\":\"2\",\"type\":\"show\",\"title\":\"B\",\"leafCount\":10,\"viewedLeafCount\":3}]}}");
  if (page.total != 340 || page.items.len() != 2) {
    return test.fail("page " + page.total.to_string());
  }
  if (!plex.watched(page.items[0]) || plex.watched(page.items[1])) {
    return test.fail("watched");
  }
  return test.assert_eq(plex.parse_items("not json").items.len().to_string(), "0");
}

function test_text(): test.TestOutcome {
  let parts = [plex.clock_text(0i64), plex.clock_text(62000i64), plex.clock_text(3723000i64), plex.duration_text(2880000i64), plex.duration_text(7200000i64)];
  return test.assert_eq(parts.join(" "), "0:00 1:02 1:02:03 48m 2h");
}

function test_urls(): test.TestOutcome {
  let img = plex.image_url(base(), "/library/metadata/501/thumb/1", 240, 360);
  if (!img.starts_with("https://10-0-0-5.abc.plex.direct:32400/photo/:/transcode?width=240&height=360") || !img.contains("url=%2Flibrary%2Fmetadata%2F501%2Fthumb%2F1")) {
    return test.fail(img);
  }
  if (!img.contains("upscale=0")) {
    return test.fail("an image grows past its source: " + img);
  }
  let tr = plex.timeline(client(), base(), "501", "paused", 1000i64, 9000i64, "s1");
  if (!tr.url.contains("/:/timeline?ratingKey=501&key=%2Flibrary%2Fmetadata%2F501&state=paused&time=1000&duration=9000") || !tr.headers.contains(("X-Plex-Session-Identifier", "s1"))) {
    return test.fail(tr.url);
  }
  let ping = plex.ping_transcode(client(), base(), "s1").url;
  if (ping != "https://10-0-0-5.abc.plex.direct:32400/video/:/transcode/universal/ping?session=s1") {
    return test.fail(ping);
  }
  let q = plex.search(client(), base(), "star wars").url;
  return test.assert_eq(q, "https://10-0-0-5.abc.plex.direct:32400/hubs/search?query=star+wars&limit=20&includeCollections=0");
}

function test_next_episode(): test.TestOutcome {
  let a = plex.Item { ...plex.no_item(), key: "1" };
  let b = plex.Item { ...plex.no_item(), key: "2" };
  let eps = [a, b];
  let next = match (plex.next_episode(eps, "1")) {
    Some(it) => it.key,
    None => "none",
  };
  let last = match (plex.next_episode(eps, "2")) {
    Some(it) => it.key,
    None => "none",
  };
  return test.assert_eq(next + " " + last, "2 none");
}

function le32(v: i64): u8[] {
  return [(v & 255i64) as u8, (v >> 8i64 & 255i64) as u8, (v >> 16i64 & 255i64) as u8, (v >> 24i64 & 255i64) as u8];
}

// A BIF file of three frames, 10 units of 1000 ms apart, holding "AAA",
// "BB" and "C".
function bif_bytes(): u8[] {
  let out: u8[] = [137u8, 66u8, 73u8, 70u8, 13u8, 10u8, 26u8, 10u8];
  for part in [le32(0i64), le32(3i64), le32(0i64)] {
    for x in part {
      out = out.append(x);
    }
  }
  while (out.len() < 64) {
    out = out.append(0u8);
  }
  let data = 64 + 4 * 8;
  let entries: i64[] = [0i64, data as i64, 10i64, (data + 3) as i64, 20i64, (data + 5) as i64, 4294967295i64, (data + 6) as i64];
  for v in entries {
    for x in le32(v) {
      out = out.append(x);
    }
  }
  for c in "AAABBC".as_bytes() {
    out = out.append(c);
  }
  return out;
}

function test_bif(): test.TestOutcome {
  let Some(f) = plex.parse_bif(bif_bytes()) else {
    return test.fail("no BIF");
  };
  if (f.times_ms != [0i64, 10000i64, 20000i64]) {
    return test.fail("times");
  }
  let frames = [plex.bif_frame(f, -1i64), plex.bif_frame(f, 0i64), plex.bif_frame(f, 15000i64), plex.bif_frame(f, 99000i64)];
  if (frames != [-1, 0, 1, 2]) {
    return test.fail("frames");
  }
  let bad = bif_bytes().with(0, 0u8);
  let short = bif_bytes().take(70);
  if (plex.parse_bif(bad).is_some() || plex.parse_bif(short).is_some()) {
    return test.fail("a file that is no BIF parsed");
  }
  return test.assert_eq(plex.bif_jpeg(f, 1).len().to_string() + " " + plex.bif_jpeg(f, 2)[0].to_string(), "2 67");
}

function test_thumbnail_part(): test.TestOutcome {
  let Some(it) = plex.parse_item(MOVIE) else {
    return test.fail("no item");
  };
  if (plex.thumbnail_part(it).is_some()) {
    return test.fail("a part with no indexes has thumbnails");
  }
  let marked = plex.Item { ...it, media: [plex.Media { ...it.media[0], parts: [plex.Part { ...it.media[0].parts[0], indexes: "sd" }] }] };
  let Some(part) = plex.thumbnail_part(marked) else {
    return test.fail("no part with thumbnails");
  };
  return test.assert_eq(part.id + " " + plex.bif_request(client(), base(), part.id).url, "11 https://10-0-0-5.abc.plex.direct:32400/library/parts/11/indexes/sd");
}

const TRACKED: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"7\",\"type\":\"movie\",\"title\":\"Two Tracks\",\"Media\":[{\"container\":\"mkv\",\"videoCodec\":\"h264\",\"audioCodec\":\"eac3\",\"Part\":[{\"id\":11,\"key\":\"/library/parts/11/1/file.mkv\",\"Stream\":[{\"id\":20,\"streamType\":1,\"codec\":\"h264\"},{\"id\":21,\"streamType\":2,\"codec\":\"eac3\",\"displayTitle\":\"English (EAC3 5.1)\",\"languageCode\":\"eng\",\"selected\":true},{\"id\":22,\"streamType\":2,\"codec\":\"aac\",\"displayTitle\":\"Commentary (AAC Stereo)\",\"languageCode\":\"eng\"},{\"id\":31,\"streamType\":3,\"codec\":\"srt\",\"displayTitle\":\"English (SRT External)\",\"key\":\"/library/streams/31\",\"selected\":true},{\"id\":32,\"streamType\":3,\"codec\":\"pgs\",\"displayTitle\":\"English (PGS)\"}]}]}]}]}}";

// A file with E-AC-3 and AAC sound, an external SubRip subtitle and a PGS
// subtitle: the server remembers the first sound and the SubRip one. With
// no E-AC-3 decoder, the AAC track plays as it is. The SubRip subtitle
// plays with the file as it is, because the app draws it, and the PGS
// subtitle burns in a transcode.
function test_tracks(): test.TestOutcome {
  let Some(it) = plex.parse_item(TRACKED) else {
    return test.fail("no item");
  };
  let sounds = plex.audio_tracks(it);
  let subs = plex.subtitle_tracks(it);
  if (sounds.len() != 2 || subs.len() != 2 || sounds[1].title != "Commentary (AAC Stereo)" || !subs[0].external || subs[0].key != "/library/streams/31") {
    return test.fail("tracks");
  }
  let kept = plex.remembered(it);
  if (kept.audio != "21" || kept.subtitle != "31") {
    return test.fail("remembered " + kept.audio + " " + kept.subtitle);
  }
  let put = plex.select_tracks(client(), base(), "11", plex.Choice { audio: "22", subtitle: "" });
  if (put.method != "PUT" || put.url != "https://10-0-0-5.abc.plex.direct:32400/library/parts/11?audioStreamID=22&subtitleStreamID=0&allParts=1") {
    return test.fail(put.method + " " + put.url);
  }
  let phone = ["video/avc", "audio/mp4a-latm"];
  let original = plex.qualities()[0];
  // The media player plays the default sound of a file, so the second
  // sound plays as a transcode that copies the video.
  let commentary = plex.stream_for(client(), base(), it, original, 0i64, "s1", phone, plex.Choice { audio: "22", subtitle: "" });
  if (!commentary.transcode || !commentary.url.contains("audioStreamID=22") || !commentary.url.contains("directStream=1")) {
    return test.fail("the second sound did not play as a copy of the video with that sound: " + commentary.url);
  }
  let Some(marked) = plex.parse_item(TRACKED.replace("\"Commentary (AAC Stereo)\"", "\"Commentary (AAC Stereo)\",\"default\":true")) else {
    return test.fail("no item with a default sound");
  };
  let own_default = plex.stream_for(client(), base(), marked, original, 0i64, "s1", phone, plex.Choice { audio: "22", subtitle: "" });
  if (own_default.transcode || plex.played_sound(marked) != "22" || plex.played_sound(it) != "21") {
    return test.fail("the default sound of the file did not play as it is: " + own_default.url);
  }
  let main = plex.stream_for(client(), base(), it, original, 0i64, "s1", phone, plex.Choice { audio: "21", subtitle: "" });
  if (!main.transcode || !main.url.contains("audioStreamID=21") || !main.url.contains("subtitles=none")) {
    return test.fail("the E-AC-3 track did not convert: " + main.url);
  }
  let drawn = plex.stream_for(client(), base(), marked, original, 0i64, "s1", phone, plex.Choice { audio: "22", subtitle: "31" });
  if (drawn.transcode || plex.text_subtitle(marked, plex.Choice { audio: "22", subtitle: "31" }).is_none()) {
    return test.fail("the SubRip subtitle did not play with the file as it is: " + drawn.url);
  }
  let in_transcode = plex.stream_for(client(), base(), it, original, 0i64, "s1", phone, plex.Choice { audio: "21", subtitle: "31" });
  if (!in_transcode.url.contains("subtitles=none")) {
    return test.fail("a transcode burned the subtitle that the app draws: " + in_transcode.url);
  }
  let burn = plex.stream_for(client(), base(), it, original, 0i64, "s1", phone, plex.Choice { audio: "22", subtitle: "32" });
  return test.assert_eq((burn.transcode && burn.url.contains("subtitles=burn") && burn.url.contains("audioStreamID=22")).to_string(), "true");
}

const EMBEDDED: string = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"8\",\"type\":\"movie\",\"title\":\"Inside\",\"Media\":[{\"container\":\"mkv\",\"videoCodec\":\"h264\",\"audioCodec\":\"aac\",\"Part\":[{\"id\":12,\"key\":\"/library/parts/12/1/file.mkv\",\"Stream\":[{\"id\":40,\"streamType\":1,\"codec\":\"h264\"},{\"id\":41,\"streamType\":2,\"codec\":\"aac\",\"selected\":true},{\"id\":42,\"streamType\":3,\"codec\":\"srt\",\"displayTitle\":\"English (SRT)\"},{\"id\":43,\"streamType\":3,\"codec\":\"ass\",\"displayTitle\":\"English (ASS)\"},{\"id\":44,\"streamType\":3,\"codec\":\"pgs\",\"displayTitle\":\"English (PGS)\"}]}]}]}]}}";

// The SubRip and ASS subtitles inside a file play with the file as it is,
// because the app draws them. The app asks the server for the text of each
// one at the address of its stream. A PGS subtitle inside the file still
// burns in a transcode.
function test_embedded_subtitles(): test.TestOutcome {
  let Some(it) = plex.parse_item(EMBEDDED) else {
    return test.fail("no item");
  };
  let phone = ["video/avc", "audio/mp4a-latm"];
  let original = plex.qualities()[0];
  for id in ["42", "43"] {
    let choice = plex.Choice { audio: "41", subtitle: id };
    let Some(track) = plex.text_subtitle(it, choice) else {
      return test.fail("the app does not draw the subtitle " + id);
    };
    let stream = plex.stream_for(client(), base(), it, original, 0i64, "s1", phone, choice);
    if (stream.transcode) {
      return test.fail("the subtitle " + id + " burned in a transcode: " + stream.url);
    }
    let r = plex.subtitle_request(client(), base(), track);
    if (r.url != "https://10-0-0-5.abc.plex.direct:32400/library/streams/" + id) {
      return test.fail("the text of the subtitle " + id + " is not asked for at its stream: " + r.url);
    }
  }
  let burn = plex.stream_for(client(), base(), it, original, 0i64, "s1", phone, plex.Choice { audio: "41", subtitle: "44" });
  return test.assert_eq((burn.transcode && burn.url.contains("subtitles=burn")).to_string(), "true");
}

// A file with E-AC-3 sound does not play as it is on a phone with no
// E-AC-3 decoder, so it downloads as one Matroska file over HTTP. At
// A download holds the tracks of its file. A transcode holds the sound
// that it played, and a file gives no image subtitle. A transcode that was
// named before its name said so is a .mkv of an item that is not MKV.
function test_file_item(): test.TestOutcome {
  let Some(it) = plex.parse_item(TRACKED) else {
    return test.fail("no item");
  };
  let ids = (ts: plex.Track[]): string => ts.map((t: plex.Track): string => t.id).join(",");
  let whole = plex.file_item(it, false);
  let copy = plex.file_item(it, true);
  if (ids(plex.audio_tracks(whole)) != "21,22" || ids(plex.subtitle_tracks(whole)) != "31") {
    return test.fail("the tracks of the file as it is: " + ids(plex.audio_tracks(whole)) + " " + ids(plex.subtitle_tracks(whole)));
  }
  if (ids(plex.audio_tracks(copy)) != "21" || ids(plex.subtitle_tracks(copy)) != "31" || plex.remembered(copy).audio != "21") {
    return test.fail("the tracks of the transcode: " + ids(plex.audio_tracks(copy)) + " " + ids(plex.subtitle_tracks(copy)));
  }
  let mp4 = plex.Item { ...it, media: [plex.Media { ...it.media[0], container: "mp4" }] };
  return test.assert_eq([plex.transcoded_file(it, "7.transcode.mkv"), plex.transcoded_file(it, "7.mkv"), plex.transcoded_file(mp4, "7.mkv"), plex.transcoded_file(mp4, "7.mp4")].map((b: boolean): string => b.to_string()).join(","), "true,false,true,false");
}

// Original, the transcode copies the H.264 video. A stream of the same
// file is HLS, which seeks fast.
function test_download_transcode(): test.TestOutcome {
  let Some(it) = plex.parse_item(TRACKED) else {
    return test.fail("no item");
  };
  let phone = ["video/avc", "audio/mp4a-latm"];
  if (plex.direct_playable(it, phone) || plex.download_name(it, true) != "7.transcode.mkv" || plex.download_name(it, false) != "7.mkv") {
    return test.fail("the name of the download");
  }
  let r = plex.download_transcode_request(client(), base(), it, plex.qualities()[0], "s1", phone, plex.remembered(it));
  if (!r.url.starts_with("https://10-0-0-5.abc.plex.direct:32400/video/:/transcode/universal/start?") || !r.url.contains("&protocol=http&") || !r.url.contains("&directStream=1&") || !r.url.contains("container%3Dmkv") || r.url.contains("fastSeek")) {
    return test.fail("the download of a transcode: " + r.url);
  }
  let hls = plex.hls_url(client(), base(), it, plex.qualities()[0], "s1", plex.remembered(it));
  return test.assert_eq((hls.contains("/start.m3u8?") && hls.contains("&protocol=hls&") && hls.contains("container%3Dmpegts") && hls.contains("&fastSeek=1&X-Plex-Incomplete-Segments=1")).to_string(), "true");
}

// SubRip and WebVTT cues: their times with a comma or a dot and with or
// without hours, lines up to a blank line, and no tags. A cue shows from
// its start until its end.
function test_cues(): test.TestOutcome {
  let srt = "1\r\n00:00:01,500 --> 00:00:03,000\r\n<i>Hello</i>\r\nthere\r\n\r\n2\r\n01:02:03,004 --> 01:02:04,000\r\n{\\an8}Top\r\n";
  let cues = plex.parse_cues(srt);
  if (cues.len() != 2 || cues[0].start_ms != 1500i64 || cues[0].end_ms != 3000i64 || cues[0].text != "Hello\nthere" || cues[1].start_ms != 3723004i64 || cues[1].text != "Top") {
    return test.fail("SubRip cues");
  }
  let vtt = "WEBVTT\n\n00:05.250 --> 00:07.000 align:start\nShort time\n\nnote\n00:00:08.000 --> 00:00:09.5\nLast\n";
  let v = plex.parse_cues(vtt);
  if (v.len() != 2 || v[0].start_ms != 5250i64 || v[0].end_ms != 7000i64 || v[0].text != "Short time" || v[1].end_ms != 9500i64) {
    return test.fail("WebVTT cues");
  }
  if (plex.cue_at(cues, 1499i64) != "" || plex.cue_at(cues, 1500i64) != "Hello\nthere" || plex.cue_at(cues, 3000i64) != "") {
    return test.fail("the cue at a time");
  }
  let ass = "[Script Info]\nTitle: x\n\n[V4+ Styles]\nFormat: Name, Fontname, Fontsize\nStyle: Default,Arial,20\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\nDialogue: 0,0:00:01.50,0:00:03.00,Default,,0,0,0,,{\\i1}Yes,{\\i0} and\\Nno\nComment: 0,0:00:04.00,0:00:05.00,Default,,0,0,0,,Hidden\nDialogue: 0,1:02:03.04,1:02:04.00,Default,,0,0,0,,Top\\hline\nDialogue: 0,0:00:09.00,0:00:08.00,Default,,0,0,0,,Backwards\n";
  let a = plex.parse_cues(ass);
  if (a.len() != 2 || a[0].start_ms != 1500i64 || a[0].end_ms != 3000i64 || a[0].text != "Yes, and\nno" || a[1].start_ms != 3723040i64 || a[1].text != "Top line") {
    return test.fail("ASS cues: " + a.map((c: plex.Cue): string => c.start_ms.to_string() + "-" + c.end_ms.to_string() + " " + c.text).join(" | "));
  }
  let ssa = "[Events]\nFormat: Marked, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\nDialogue: Marked=0,0:00:02.00,0:00:04.00,Default,NTP,0000,0000,0000,!Effect,Old style\n";
  let o = plex.parse_cues(ssa);
  if (o.len() != 1 || o[0].start_ms != 2000i64 || o[0].text != "Old style") {
    return test.fail("SSA cues");
  }
  return test.pass();
}

// The name of a kept image does not change with the token, and it changes
// with the image.
function test_cache_name(): test.TestOutcome {
  let a = plex.image_url(base(), "/library/metadata/501/thumb/1", 240, 360);
  let b = plex.image_url(plex.Base { ...base(), token: "other" }, "/library/metadata/501/thumb/1", 240, 360);
  let c = plex.image_url(base(), "/library/metadata/502/thumb/1", 240, 360);
  if (plex.cache_name(a) != plex.cache_name(b) || plex.cache_name(a) == plex.cache_name(c) || plex.cache_name(a).contains("/")) {
    return test.fail(plex.cache_name(a) + " " + plex.cache_name(b) + " " + plex.cache_name(c));
  }
  return test.assert_eq(plex.cache_name(a).ends_with(".img").to_string(), "true");
}

function test_markers(): test.TestOutcome {
  let body = "{\"MediaContainer\":{\"Metadata\":[{\"ratingKey\":\"77\",\"type\":\"episode\",\"title\":\"Pilot\",\"Marker\":[{\"type\":\"intro\",\"startTimeOffset\":5000,\"endTimeOffset\":65000},{\"type\":\"bookmark\",\"startTimeOffset\":70000,\"endTimeOffset\":71000},{\"type\":\"credits\",\"startTimeOffset\":2400000,\"endTimeOffset\":2500000}]}]}}";
  let Some(it) = plex.parse_item(body) else {
    return test.fail("no item");
  };
  if (it.markers.len() != 2) {
    return test.fail("markers " + it.markers.len().to_string());
  }
  let at = (ms: i64): string => match (plex.marker_at(it, ms)) {
    Some(m) => m.kind,
    None => "-",
  };
  if (plex.metadata(client(), base(), "77").url != "https://10-0-0-5.abc.plex.direct:32400/library/metadata/77?includeMarkers=1") {
    return test.fail("no markers asked for");
  }
  return test.assert_eq([at(0i64), at(5000i64), at(64999i64), at(65000i64), at(70500i64), at(2450000i64)].join(" "), "- intro intro - - credits");
}

function main(): i32 {
  let r = test.new("plex");
  r = r.it("each request names the client", test_headers_name_the_client);
  r = r.it("a PIN is read waiting and linked", test_pin_parse);
  r = r.it("servers are read and their connections ordered", test_servers_and_connection_order);
  r = r.it("a private local connection gets a plain HTTP address", test_private_connections_get_http);
  r = r.it("private hosts are told from public ones", test_private_hosts);
  r = r.it("a library page asks in its order and filter, and the letters count", test_library_requests);
  r = r.it("the users of a Plex Home are read, and a switch asks with the PIN", test_home_users);
  r = r.it("a typed server has one connection", test_manual_server);
  r = r.it("the libraries of video and music are kept", test_sections_keep_video_and_music);
  r = r.it("an item is read with its media", test_item_fields);
  r = r.it("a stream plays the file or a transcode", test_stream_choice);
  r = r.it("the hubs of the home screen", test_hubs);
  r = r.it("a page has the count of its library", test_page_total);
  r = r.it("times and durations", test_text);
  r = r.it("the addresses of images, timelines and searches", test_urls);
  r = r.it("the next episode", test_next_episode);
  r = r.it("the preview thumbnails of a BIF file", test_bif);
  r = r.it("the sound and subtitle tracks of a file", test_tracks);
  r = r.it("SubRip, WebVTT, ASS and SSA cues", test_cues);
  r = r.it("subtitles inside the file that the app draws", test_embedded_subtitles);
  r = r.it("a file that needs a transcode downloads as one", test_download_transcode);
  r = r.it("a download holds the tracks of its file", test_file_item);
  r = r.it("the name of a kept image", test_cache_name);
  r = r.it("the intro and credits markers of an item", test_markers);
  r = r.it("a part with preview thumbnails", test_thumbnail_part);
  return r.finish();
}
