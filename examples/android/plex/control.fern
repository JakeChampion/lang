// The behaviour of Fern for Plex on its events. plex.fern holds the model and
// ui.fern the look. Each input and output goes through a Device: app.fern
// gives the device of the phone, and control_test.fern gives one with a
// fake server.
//
// The app sends at most one request to the API at a time, one batch of
// images, and one report of playback. Each runs in a worker of std/worker,
// so the loop thread never waits for the network. The loop polls the
// workers on its timeouts.
import "std/android";
import "std/android/draw";
import "std/android/motion";
import "std/android/player";
import "std/android/text";
import "std/android/ui/scene";
import "std/log";
import "std/string";
import "std/utf8";
import "std/worker";
import "./plex";
import "./ui";

// The input and output of the app. `read` gives "" for a file that does not
// exist. `fetch` starts a worker that sends the requests in turn. The player
// functions drive the one media player of the app.
pub struct Device {
  mono_ms: () => i64,
  read: (string) => string,
  write: (string, string) => void,
  size: (usize) => (i32, i32),
  lock: (usize) => draw.Frame,
  post: (draw.Frame) => void,
  finish: () => void,
  keep_screen_on: (boolean) => void,
  immersive: (boolean) => void,
  show_field: (string) => void,
  set_field: (string) => void,
  hide_field: () => void,
  fetch: (plex.Request[]) => worker.Worker[plex.Reply[]],
  // As fetch, for images: an image that the phone keeps comes from its
  // storage, and a new one goes there.
  fetch_images: (plex.Request[]) => worker.Worker[plex.Reply[]],
  decode: (u8[], i32, i32) => Option[draw.Image],
  play: (string) => boolean,
  // Puts the video on the window, and false when it cannot.
  show_video: (usize) => boolean,
  // Puts the GPU painter on the window, and false when the phone has none:
  // then the app draws with `lock` and `post`.
  attach: (usize) => boolean,
  // Takes the painter off the window, before the window goes.
  detach: () => void,
  // Draws the nodes on the window with the GPU, over the newest frame of
  // the video when the bool is true. False when it cannot.
  present: (usize, scene.Node[], boolean) => boolean,
  hide_video: () => void,
  // Asks for a Vsync event at the next frame of the display.
  request_frame: () => void,
  start: () => void,
  pause: () => void,
  seek: (i64) => void,
  position: () => i64,
  duration: () => i64,
  stop: () => void,
  // The index of each sound track of the prepared player, and the track
  // that plays.
  audio_tracks: () => i32[],
  select_track: (i32) => boolean,
  // True when the prepared player selected a sound track.
  has_audio: () => boolean,
  random: () => i32,
  // The MIME types that the decoders of the phone take.
  decoders: string[],
}

// A request to the API that waits for its turn. `purpose` says what to do
// with the reply.
struct Ask { purpose: string, req: plex.Request }

// The request to the API that a worker sends now.
struct Call { purpose: string, w: worker.Worker[plex.Reply[]] }

// The batch of images that a worker fetches now.
struct Batch { keys: string[], w: worker.Worker[plex.Reply[]] }

// A screen on the back stack, as the user left it.
struct Page { screen: i32, title: string, scroll: i32, rows: i32[], items: plex.Item[], total: i32, section: plex.Section, item: plex.Item, children: plex.Item[] }

// A finger on the screen. `axis` is 0 until it moves, 1 when it moves a
// row across and 2 when it moves the screen up or down. `xs` and `ys` are
// its recent positions, for the speed of a fling. `caught` is true when the
// finger stopped a fling, and then it is no tap.
struct Press { active: boolean, x0: f32, y0: f32, x: f32, y: f32, axis: i32, group: string, scroll0: i32, row0: i32, xs: motion.Sample[], ys: motion.Sample[], caught: boolean }

// A list that moves on after the finger leaves: "list" for the screen, or
// the group of a row of posters. The group is "" when nothing moves.
struct Fling { group: string, f: motion.Fling }

function no_fling(): Fling {
  return Fling { group: "", f: motion.no_fling() };
}

// The playback of an item. `video` is true while the video is on the
// window, and then the app does not lock the window. `drawn` is true when
// the app draws the video itself, so its controls can show over it until
// `controls_until`.
struct Play {
  active: boolean,
  item: plex.Item,
  stream: plex.Stream,
  session: string,
  prepared: boolean,
  paused: boolean,
  video: boolean,
  overlay: boolean,
  drawn: boolean,
  controls_until: i64,
  buffering: boolean,
  position: i64,
  duration: i64,
  reported_at: i64,
  updated_at: i64,
  retried: boolean,
  status: string,
  queue: plex.Item[],
  // The preview thumbnails of the item, while the finger drags the seek bar
  // the time under it, or -1, the time of the last seek of the drag, and
  // the thumbnail that shows.
  bif: Option[plex.Bif],
  scrub_ms: i64,
  scrub_seek_at: i64,
  thumb_index: i32,
  thumb: Option[draw.Image],
  // The sound and the subtitles that play, and whether the sheet of the
  // tracks shows.
  choice: plex.Choice,
  sheet: boolean,
  // The time that the card of the next item came, or 0, and whether the
  // user turned the next item off.
  up_next_at: i64,
  next_off: boolean,
}

pub struct App {
  dev: Device,
  dir: string,
  window: usize,
  w: i32,
  h: i32,
  // The pixels that the status bar and the navigation bar cover.
  top: i32,
  bottom: i32,
  shown: boolean,
  client: plex.Client,
  server: plex.Server,
  base: plex.Base,
  servers: plex.Server[],
  states: string[],
  // The server whose connections the app probes, or -1, the state of each
  // connection (0 waits, 1 answered, 2 failed), the time the probes
  // started, the workers that run with the connection of each, and the
  // workers of a race that ended.
  probing: i32,
  probe_states: i32[],
  probe_at: i64,
  probes: worker.Worker[plex.Reply[]][],
  probe_conns: i32[],
  left: worker.Worker[plex.Reply[]][],
  pin: plex.Pin,
  pin_at: i64,
  account: string,
  quality: i32,
  screen: i32,
  tab: i32,
  title: string,
  scroll: i32,
  rows: i32[],
  stack: Page[],
  hubs: plex.Hub[],
  results: plex.Hub[],
  sections: plex.Section[],
  section: plex.Section,
  items: plex.Item[],
  total: i32,
  item: plex.Item,
  children: plex.Item[],
  query: string,
  typing: boolean,
  search_at: i64,
  error: string,
  api: Option[Call],
  asks: Ask[],
  img: Option[Batch],
  cache: Map[string, draw.Image],
  cached: string[],
  failed: string[],
  report: Option[Call],
  reports: plex.Request[],
  play: Play,
  press: Press,
  nodes: scene.Node[],
  dirty: boolean,
  // The painter draws on the window, and `paint` is true when the nodes
  // wait for the next vsync.
  gpu: boolean,
  paint: boolean,
  fling: Fling,
}

// The images that the app keeps decoded, and the most that one batch fetches.
const CACHE_SIZE: i32 = 160;

const BATCH: i32 = 6;

const PAGE_SIZE: i32 = 60;

// The time between two checks of a PIN, and between two reports of the
// position of the playback.
const PIN_MS: i64 = 2000i64;

const REPORT_MS: i64 = 10000i64;

// The time after the last key before a search starts.
const SEARCH_MS: i64 = 700i64;

// --- settings

function no_section(): plex.Section {
  return plex.Section { key: "", kind: "", title: "" };
}

function no_server(): plex.Server {
  return plex.Server { name: "", id: "", token: "", owned: false, connections: [] };
}

function no_play(): Play {
  return Play { active: false, item: plex.no_item(), stream: plex.Stream { url: "", transcode: false, offset_ms: 0i64 }, session: "", prepared: false, paused: false, video: false, overlay: false, drawn: false, controls_until: 0i64, buffering: false, position: 0i64, duration: 0i64, reported_at: 0i64, updated_at: 0i64, retried: false, status: "", queue: [], bif: None, scrub_ms: -1i64, scrub_seek_at: 0i64, thumb_index: -1, thumb: None, choice: plex.no_choice(), sheet: false, up_next_at: 0i64, next_off: false };
}

function no_press(): Press {
  return Press { active: false, x0: 0.0, y0: 0.0, x: 0.0, y: 0.0, axis: 0, group: "", scroll0: 0, row0: 0, xs: [], ys: [], caught: false };
}

// The value of `key` in the lines of `key=value` of `text`, or "".
pub function setting(text: string, key: string): string {
  for line in text.split("\n") {
    if (line.starts_with(key + "=")) {
      return line.split_at(key.len() + 1).1;
    }
  }
  return "";
}

pub function num(s: string): i32 {
  let v = 0;
  for c in s.bytes() {
    if (c < 48u8 || c > 57u8) {
      return v;
    }
    v = v * 10 + (c - 48u8) as i32;
  }
  return v;
}

function hex_id(dev: Device): string {
  let digits = "0123456789abcdef";
  let out = "";
  for i in 0..32 {
    let d = dev.random() % 16;
    out += digits.split_at(d).1.split_at(1).0;
  }
  return out;
}

function settings_path(s: App): string {
  return s.dir + "/settings";
}

function save(s: App): void {
  if (s.dir.len() == 0) {
    return;
  }
  let lines = [
    "id=" + s.client.id,
    "token=" + s.client.token,
    "account=" + s.account,
    "server_name=" + s.server.name,
    "server_id=" + s.server.id,
    "server_token=" + s.base.token,
    "server_uri=" + s.base.uri,
    "quality=" + s.quality.to_string(),
  ];
  s.dev.write(settings_path(s), lines.join("\n") + "\n");
}

// The app before its first event, with its files in `dir`. `server` and
// `token` name a server to use with no sign-in at plex.tv, or are "".
// `play` is the key of an item to open and play at once, or "", as a link
// into the app gives it.
pub function new(dev: Device, dir: string, server: string, token: string, play: string): App {
  let s = first_screen(dev, dir, server, token);
  if (play.len() == 0 || s.screen == ui.LOGIN || s.screen == ui.SERVERS) {
    return s;
  }
  return ask(s, "autoplay:" + play, Meta(play));
}

function first_screen(dev: Device, dir: string, server: string, token: string): App {
  let text = "";
  if (dir.len() > 0) {
    text = dev.read(dir + "/settings");
  }
  let id = setting(text, "id");
  if (id.len() == 0) {
    id = hex_id(dev);
  }
  let none: plex.Hub[] = [];
  let s = App {
    dev: dev, dir: dir, window: 0 as usize, w: 0, h: 0, top: 0, bottom: 0, shown: false,
    client: plex.Client { id: id, device: "Android", token: setting(text, "token") },
    server: no_server(), base: plex.Base { uri: setting(text, "server_uri"), token: setting(text, "server_token") },
    servers: [], states: [], probing: -1, probe_states: [], probe_at: 0i64, probes: [], probe_conns: [], left: [], pin: plex.Pin { id: 0i64, code: "", token: "" }, pin_at: 0i64,
    account: setting(text, "account"), quality: num(setting(text, "quality")),
    screen: ui.LOGIN, tab: 0, title: "", scroll: 0, rows: [], stack: [],
    hubs: none, results: none, sections: [], section: no_section(), items: [], total: 0, item: plex.no_item(), children: [],
    query: "", typing: false, search_at: 0i64, error: "",
    api: None, asks: [], img: None, cache: map_new(64), cached: [], failed: [], report: None, reports: [],
    play: no_play(), press: no_press(), nodes: [], dirty: true, gpu: false, paint: false, fling: no_fling(),
  };
  s = App { ...s, server: plex.Server { ...no_server(), name: setting(text, "server_name"), id: setting(text, "server_id"), token: s.base.token } };
  if (s.quality < 0 || s.quality >= plex.qualities().len()) {
    s = App { ...s, quality: 0 };
  }
  if (server.len() > 0) {
    let manual = plex.manual_server(server, token);
    s = App { ...s, server: manual, base: plex.Base { uri: plex.connection_order(manual)[0], token: token } };
    save(s);
    return open_home(s);
  }
  save(s);
  if (s.base.uri.len() > 0) {
    return open_home(s);
  }
  if (s.client.token.len() > 0) {
    return open_servers(s);
  }
  return s;
}

// --- requests

// A request that the app asks for. `ask` makes it from the client and the
// server of the state, so a caller gives a value that borrows nothing.
enum Want {
  NewPin,
  CheckPin(i64),
  User,
  Resources,
  Sections,
  Hubs,
  Items(string, i32),
  Meta(string),
  Children(string),
  Leaves(string),
  Bif(string),
  SelectTracks(string, plex.Choice),
  Search(string),
  Scrobble(string, boolean),
  Timeline(string, string, i64, i64, string),
  PingTranscode(string),
  StopTranscode(string),
}

function request_of(c: plex.Client, b: plex.Base, w: Want): plex.Request {
  match (w) {
    NewPin => {
      return plex.pin_request(c);
    },
    CheckPin(id) => {
      return plex.pin_check(c, id);
    },
    User => {
      return plex.user_request(c);
    },
    Resources => {
      return plex.resources_request(c);
    },
    Sections => {
      return plex.sections(c, b);
    },
    Hubs => {
      return plex.hubs(c, b);
    },
    Items(key, start) => {
      return plex.section_items(c, b, key, start, PAGE_SIZE, "titleSort");
    },
    Meta(key) => {
      return plex.metadata(c, b, key);
    },
    Children(key) => {
      return plex.children(c, b, key);
    },
    SelectTracks(part, choice) => {
      return plex.select_tracks(c, b, part, choice);
    },
    Bif(id) => {
      return plex.bif_request(c, b, id);
    },
    Leaves(key) => {
      return plex.Request { ...plex.children(c, b, key), url: b.uri + "/library/metadata/" + key + "/allLeaves" };
    },
    Search(q) => {
      return plex.search(c, b, q);
    },
    Scrobble(key, seen) => {
      return plex.scrobble(c, b, key, seen);
    },
    Timeline(key, state, at, total, session) => {
      return plex.timeline(c, b, key, state, at, total, session);
    },
    PingTranscode(session) => {
      return plex.ping_transcode(c, b, session);
    },
    StopTranscode(session) => {
      return plex.stop_transcode(c, b, session);
    }
  }
}

function ask(own s: App, purpose: string, w: Want): App {
  let req = request_of(s.client, s.base, w);
  return App { ...s, asks: s.asks.append(Ask { purpose: purpose, req: req }) };
}

// Starts the next request when no worker sends one.
function start_call(own c: Option[Call], dev: Device, next: Ask): (Option[Call], boolean) {
  match (c) {
    Some(call) => {
      return (Some(call), false);
    },
    None => {
      return (Some(Call { purpose: next.purpose, w: dev.fetch([next.req]) }), true);
    }
  }
}

function start_api(own s: App): App {
  if (s.asks.len() == 0) {
    return s;
  }
  let (api, started) = start_call(s.api, s.dev, s.asks[0]);
  if (!started) {
    return App { ...s, api: api };
  }
  return App { ...s, api: api, asks: s.asks.drop(1) };
}

struct Done { purpose: string, reply: plex.Reply }

function first_reply(rs: plex.Reply[]): plex.Reply {
  if (rs.len() == 0) {
    return plex.Reply { status: 0, body: [], error: "no reply" };
  }
  return rs[0];
}

function poll_call(own c: Option[Call]): (Option[Call], Option[Done]) {
  match (c) {
    Some(call) => {
      let Call { purpose, w } = call;
      match (w.poll()) {
        worker.Finished(rs) => {
          return (None, Some(Done { purpose: purpose, reply: first_reply(rs) }));
        },
        worker.Running(again) => {
          return (Some(Call { purpose: purpose, w: again }), None);
        }
      }
    },
    None => {
      return (None, None);
    }
  }
}

function poll_api(own s: App): App {
  let (api, done) = poll_call(s.api);
  let next = App { ...s, api: api };
  if let Some(d) = done {
    return start_api(answer(next, d.purpose, d.reply));
  }
  return start_api(next);
}

// Reports of playback go in a line of their own, so a slow report does not
// hold up the screens.
function report(own s: App, w: Want): App {
  let req = request_of(s.client, s.base, w);
  return start_report(App { ...s, reports: s.reports.append(req) });
}

function start_report(own s: App): App {
  if (s.reports.len() == 0) {
    return s;
  }
  let (r, started) = start_call(s.report, s.dev, Ask { purpose: "report", req: s.reports[0] });
  if (!started) {
    return App { ...s, report: r };
  }
  return App { ...s, report: r, reports: s.reports.drop(1) };
}

function poll_report(own s: App): App {
  let (r, done) = poll_call(s.report);
  let next = App { ...s, report: r };
  if let Some(d) = done {
    if (!d.reply.ok()) {
      log.warn("plex: a report failed: " + d.reply.problem());
    }
  }
  return start_report(next);
}

// --- images

function image_request(key: string): plex.Request {
  return plex.Request { method: "GET", url: key, headers: [("Accept", "image/jpeg, image/png, image/webp")], body: "" };
}

function in_flight(b: Option[Batch], key: string): boolean {
  match (b) {
    Some(batch) => {
      return batch.keys.contains(key);
    },
    None => {
      return false;
    }
  }
}

// Starts a batch of the images that the screen shows and the cache lacks.
function start_batch(own b: Option[Batch], dev: Device, keys: string[]): Option[Batch] {
  match (b) {
    Some(batch) => {
      return Some(batch);
    },
    None => {
      if (keys.len() == 0) {
        return None;
      }
      let reqs: plex.Request[] = [];
      for k in keys {
        reqs = reqs.append(image_request(k));
      }
      return Some(Batch { keys: keys, w: dev.fetch_images(reqs) });
    }
  }
}

function wanted(s: App): string[] {
  let out: string[] = [];
  for k in ui.images(s.nodes) {
    if (out.len() < BATCH && !s.cache.contains(k) && !s.failed.contains(k)) {
      out = out.append(k);
    }
  }
  return out;
}

function start_images(own s: App): App {
  let keys = wanted(s);
  return App { ...s, img: start_batch(s.img, s.dev, keys) };
}

struct Fetched { keys: string[], replies: plex.Reply[] }

function poll_batch(own b: Option[Batch]): (Option[Batch], Option[Fetched]) {
  match (b) {
    Some(batch) => {
      let Batch { keys, w } = batch;
      match (w.poll()) {
        worker.Finished(rs) => {
          return (None, Some(Fetched { keys: keys, replies: rs }));
        },
        worker.Running(again) => {
          return (Some(Batch { keys: keys, w: again }), None);
        }
      }
    },
    None => {
      return (None, None);
    }
  }
}

// Keeps a decoded image, and drops the oldest when the cache is full.
function remember(own s: App, key: string, img: draw.Image): App {
  let cache = s.cache.insert(key, img);
  let order = s.cached.append(key);
  while (order.len() > CACHE_SIZE) {
    cache = cache.remove(order[0]);
    order = order.drop(1);
  }
  return App { ...s, cache: cache, cached: order };
}

function poll_images(own s: App): App {
  let (b, done) = poll_batch(s.img);
  let next = App { ...s, img: b };
  let Some(f) = done else {
    return next;
  };
  let i = 0;
  while (i < f.keys.len()) {
    let key = f.keys[i];
    let got: Option[draw.Image] = None;
    if (i < f.replies.len() && f.replies[i].ok()) {
      let (w, h) = ui.image_size(next.nodes, key);
      if (w > 0 && h > 0) {
        got = next.dev.decode(f.replies[i].body, w, h);
      }
    }
    match (got) {
      Some(img) => {
        next = remember(next, key, img);
      },
      None => {
        next = App { ...next, failed: next.failed.append(key) };
      }
    }
    i += 1;
  }
  return App { ...next, dirty: true };
}

// --- replies

function failed(own s: App, what: string, r: plex.Reply): App {
  log.warn("plex: " + what + " failed: " + r.problem());
  return App { ...s, error: what + ": " + r.problem(), dirty: true };
}

// Handles the reply to a request with `purpose`: the word before the first
// colon says what the request was, and the rest names its item.
function answer(own s: App, purpose: string, r: plex.Reply): App {
  let (verb, rest) = split_purpose(purpose);
  let t = App { ...s, dirty: true };
  if (verb == "pin") {
    return got_pin(t, r);
  }
  if (verb == "pincheck") {
    return got_pin_check(t, r);
  }
  if (verb == "user") {
    if (r.ok()) {
      let a = plex.parse_account(r.text());
      let u = App { ...t, account: a.name };
      save(u);
      return u;
    }
    return t;
  }
  if (verb == "resources") {
    return got_servers(t, r);
  }
  if (verb == "bif") {
    return got_bif(t, rest, r);
  }
  if (r.status == 401 && t.client.token.len() > 0 && t.screen != ui.SERVERS) {
    return open_servers(App { ...t, error: "The server refused the sign-in. Choose a server again." });
  }
  if (!r.ok()) {
    return failed(t, verb, r);
  }
  return got_media(t, verb, rest, r);
}

function got_media(own t: App, verb: string, rest: string, r: plex.Reply): App {
  if (verb == "sections") {
    return App { ...t, sections: plex.parse_sections(r.text()), error: "" };
  }
  if (verb == "hubs") {
    return App { ...t, hubs: plex.parse_hubs(r.text()), error: "" };
  }
  if (verb == "items") {
    return got_items(t, rest, r);
  }
  if (verb == "playmeta") {
    return got_play_meta(t, rest, r);
  }
  if (verb == "meta") {
    if (t.screen == ui.DETAIL && t.item.key == rest) {
      if let Some(it) = plex.parse_item(r.text()) {
        return App { ...t, item: it };
      }
    }
    return t;
  }
  if (verb == "children") {
    if (t.screen == ui.DETAIL && t.item.key == rest) {
      return App { ...t, children: plex.parse_items(r.text()).items };
    }
    return t;
  }
  if (verb == "autoplay") {
    if let Some(it) = plex.parse_item(r.text()) {
      return play_detail(open_item(t, it));
    }
    return t;
  }
  if (verb == "leaves") {
    return play_first(t, plex.parse_items(r.text()).items);
  }
  if (verb == "search") {
    if (rest == t.query) {
      return App { ...t, results: plex.parse_hubs(r.text()), rows: [], error: "" };
    }
    return t;
  }
  return t;
}

function split_purpose(p: string): (string, string) {
  if let Some(i) = p.index_of(":") {
    return (p.split_at(i).0, p.split_at(i + 1).1);
  }
  return (p, "");
}

function got_items(own t: App, rest: string, r: plex.Reply): App {
  if (t.screen != ui.LIBRARY || !rest.starts_with(t.section.key + ":")) {
    return t;
  }
  let page = plex.parse_items(r.text());
  let items = t.items;
  for it in page.items {
    items = items.append(it);
  }
  return App { ...t, items: items, total: page.total };
}

// --- sign-in and servers

function got_pin(own t: App, r: plex.Reply): App {
  if (!r.ok()) {
    return failed(t, "sign-in", r);
  }
  let Some(pin) = plex.parse_pin(r.text()) else {
    return App { ...t, error: "plex.tv sent no PIN" };
  };
  return App { ...t, pin: pin, pin_at: t.dev.mono_ms() + PIN_MS, error: "" };
}

function got_pin_check(own t: App, r: plex.Reply): App {
  if (t.pin.id == 0i64) {
    return t;
  }
  if (!r.ok()) {
    if (r.status == 404) {
      return App { ...t, pin: plex.Pin { id: 0i64, code: "", token: "" }, error: "The code ran out. Sign in again." };
    }
    return App { ...t, pin_at: t.dev.mono_ms() + PIN_MS };
  }
  let Some(pin) = plex.parse_pin(r.text()) else {
    return App { ...t, pin_at: t.dev.mono_ms() + PIN_MS };
  };
  if (pin.token.len() == 0) {
    return App { ...t, pin_at: t.dev.mono_ms() + PIN_MS };
  }
  let client = t.client.with_token(pin.token);
  let u = App { ...t, client: client, pin: plex.Pin { id: 0i64, code: "", token: "" }, error: "" };
  save(u);
  log.info("plex: signed in");
  return ask(open_servers(u), "user", User);
}

function open_servers(own s: App): App {
  let t = App { ...s, screen: ui.SERVERS, title: "Choose a server", scroll: 0, stack: [], dirty: true };
  return ask(t, "resources", Resources);
}

function got_servers(own t: App, r: plex.Reply): App {
  if (!r.ok()) {
    return failed(t, "the server list", r);
  }
  let list = plex.parse_servers(r.text());
  let states: string[] = [];
  for sv in list {
    states = states.append("");
  }
  let u = App { ...t, servers: list, states: states };
  if (list.len() == 1) {
    return connect(u, 0);
  }
  return u;
}

// How long a connection that answered waits for a better one of the same
// server, which comes before it in connection_order.
const PROBE_MS: i64 = 2000i64;

// Probes all the connections of server `i` at once. The first in
// connection_order that answers wins: a local one, then a remote one, then
// the relay of plex.tv. A connection that answered waits PROBE_MS at most
// for a better one.
function connect(own s: App, i: i32): App {
  if (i < 0 || i >= s.servers.len()) {
    return s;
  }
  let sv = s.servers[i];
  let order = plex.connection_order(sv);
  let left = s.left;
  for w in s.probes {
    left = left.append(w);
  }
  let probes: worker.Worker[plex.Reply[]][] = [];
  let conns: i32[] = [];
  let states: i32[] = [];
  for k in 0..order.len() {
    probes = probes.append(s.dev.fetch([plex.identity(s.client, plex.Base { uri: order[k], token: sv.token })]));
    conns = conns.append(k);
    states = states.append(0);
  }
  let t = App { ...s, probing: i, probe_states: states, probe_at: s.dev.mono_ms(), probes: probes, probe_conns: conns, left: left, states: s.states.with(i, "connecting"), dirty: true };
  if (order.len() == 0) {
    return App { ...t, probing: -1, states: t.states.with(i, "unreachable") };
  }
  return t;
}

// The probes that still run with the connection of each, and the state
// of each connection.
function poll_probe_list(own ws: worker.Worker[plex.Reply[]][], conns: i32[], states: i32[]): (worker.Worker[plex.Reply[]][], i32[], i32[]) {
  let running: worker.Worker[plex.Reply[]][] = [];
  let still: i32[] = [];
  let out = states;
  let k = 0;
  for w in ws {
    let conn = conns[k];
    k += 1;
    let polled = w.poll();
    match (polled) {
      worker.Finished(rs) => {
        if (first_reply(rs).ok()) {
          out = out.with(conn, 1);
        } else {
          out = out.with(conn, 2);
        }
      },
      worker.Running(again) => {
        running = running.append(again);
        still = still.append(conn);
      }
    }
  }
  return (running, still, out);
}

// The workers of a race that ended, less those that finished.
function poll_left(own ws: worker.Worker[plex.Reply[]][]): worker.Worker[plex.Reply[]][] {
  let out: worker.Worker[plex.Reply[]][] = [];
  for w in ws {
    let polled = w.poll();
    match (polled) {
      worker.Finished(rs) => {},
      worker.Running(again) => {
        out = out.append(again);
      }
    }
  }
  return out;
}

// The connection that wins: the first that answered with no better one
// that still waits, or -1. After PROBE_MS, a probe that waits counts as
// failed.
pub function winner(states: i32[], expired: boolean): i32 {
  for k in 0..states.len() {
    if (states[k] == 1) {
      return k;
    }
    if (states[k] == 0 && !expired) {
      return -1;
    }
  }
  return -1;
}

function poll_probes(own s: App): App {
  let left = poll_left(s.left);
  let (probes, conns, states) = poll_probe_list(s.probes, s.probe_conns, s.probe_states);
  let i = s.probing;
  if (i < 0 || i >= s.servers.len()) {
    return App { ...s, probes: probes, probe_conns: conns, probe_states: states, left: left };
  }
  let expired = s.dev.mono_ms() - s.probe_at >= PROBE_MS;
  let k = winner(states, expired);
  if (k < 0 && probes.len() == 0) {
    log.info("plex: no answer from " + s.servers[i].name);
    return App { ...s, probes: probes, probe_conns: conns, probe_states: states, left: left, probing: -1, states: s.states.with(i, "unreachable"), dirty: true };
  }
  if (k < 0) {
    return App { ...s, probes: probes, probe_conns: conns, probe_states: states, left: left };
  }
  let sv = s.servers[i];
  let order = plex.connection_order(sv);
  let rest = left;
  for w in probes {
    rest = rest.append(w);
  }
  let u = App { ...s, probing: -1, probes: [], probe_conns: [], probe_states: states, left: rest, server: sv, base: plex.Base { uri: order[k], token: sv.token }, states: s.states.with(i, "connected"), error: "" };
  save(u);
  log.info("plex: connected to " + sv.name + " at connection " + k.to_string());
  return open_home(u);
}

// --- navigation

function open_home(own s: App): App {
  let title = s.server.name;
  let t = App { ...s, screen: ui.HOME, tab: 0, title: title, scroll: 0, rows: [], stack: [], items: [], children: [], dirty: true };
  return ask(ask(t, "hubs", Hubs), "sections", Sections);
}

function page_of(s: App): Page {
  return Page { screen: s.screen, title: s.title, scroll: s.scroll, rows: s.rows, items: s.items, total: s.total, section: s.section, item: s.item, children: s.children };
}

function push(own s: App): App {
  let stack = s.stack.append(page_of(s));
  return App { ...s, stack: stack };
}

function restore(own s: App, p: Page): App {
  return App { ...s, screen: p.screen, title: p.title, scroll: p.scroll, rows: p.rows, items: p.items, total: p.total, section: p.section, item: p.item, children: p.children, dirty: true };
}

function pop(own s: App): App {
  if (s.stack.len() == 0) {
    return s;
  }
  let p = s.stack[s.stack.len() - 1];
  let stack = s.stack.take(s.stack.len() - 1);
  return restore(App { ...s, stack: stack }, p);
}

function open_tab(own s: App, tab: i32): App {
  if (tab < 0 || tab >= ui.tab_screens().len()) {
    return s;
  }
  let screen = ui.tab_screens()[tab];
  s.dev.hide_field();
  let title = [s.server.name, "Libraries", "Search", "Settings"][tab];
  let need_hubs = screen == ui.HOME && s.hubs.len() == 0;
  let need_sections = screen == ui.SECTIONS && s.sections.len() == 0;
  let t = App { ...s, screen: screen, tab: tab, title: title, scroll: 0, rows: [], stack: [], typing: false, dirty: true };
  if (need_hubs) {
    return ask(t, "hubs", Hubs);
  }
  if (need_sections) {
    return ask(t, "sections", Sections);
  }
  return t;
}

function open_section(own s: App, i: i32): App {
  if (i < 0 || i >= s.sections.len()) {
    return s;
  }
  let sec = s.sections[i];
  return more_items(App { ...push(s), screen: ui.LIBRARY, title: sec.title, section: sec, items: [], total: 0, scroll: 0, dirty: true });
}

// Asks for the next page of the library when the screen nears its end.
function more_items(own s: App): App {
  if (s.screen != ui.LIBRARY || s.total > 0 && s.items.len() >= s.total) {
    return s;
  }
  let purpose = "items:" + s.section.key + ":" + s.items.len().to_string();
  for a in s.asks {
    if (a.purpose == purpose) {
      return s;
    }
  }
  if (has_call(s.api, purpose)) {
    return s;
  }
  let key = s.section.key;
  let start = s.items.len();
  return ask(s, purpose, Items(key, start));
}

function has_call(c: Option[Call], purpose: string): boolean {
  match (c) {
    Some(call) => {
      return call.purpose == purpose;
    },
    None => {
      return false;
    }
  }
}

function open_item(own s: App, it: plex.Item): App {
  if (it.key.len() == 0) {
    return s;
  }
  let u = ask(App { ...push(s), screen: ui.DETAIL, title: plex.card_title(it), item: it, children: [], scroll: 0, dirty: true }, "meta:" + it.key, Meta(it.key));
  if (it.kind == "show" || it.kind == "season" || it.kind == "artist" || it.kind == "album") {
    return ask(u, "children:" + it.key, Children(it.key));
  }
  return u;
}

function item_at(s: App, act: string): Option[plex.Item] {
  let parts = act.split(":");
  if (parts[0] == "hub" && parts.len() == 3) {
    let hubs = s.hubs;
    if (s.screen == ui.SEARCH) {
      hubs = s.results;
    }
    let i = num(parts[1]);
    let j = num(parts[2]);
    if (i < hubs.len() && j < hubs[i].items.len()) {
      return Some(hubs[i].items[j]);
    }
  }
  if (parts[0] == "grid" && parts.len() == 2 && num(parts[1]) < s.items.len()) {
    return Some(s.items[num(parts[1])]);
  }
  if (parts[0] == "child" && parts.len() == 2 && num(parts[1]) < s.children.len()) {
    return Some(s.children[num(parts[1])]);
  }
  return None;
}

// Plays the item of the detail screen: the item itself, the first episode
// of a season that the user has not seen, or that of a show.
function play_detail(own s: App): App {
  let it = s.item;
  if (plex.playable_kind(it.kind)) {
    return start_play(s, it, []);
  }
  if (it.kind == "show") {
    return ask(s, "leaves:" + it.key, Leaves(it.key));
  }
  let children = s.children;
  return play_first(s, children);
}

function play_first(own s: App, items: plex.Item[]): App {
  let i = 0;
  while (i < items.len()) {
    if (plex.playable_kind(items[i].kind) && !plex.watched(items[i])) {
      return start_play(s, items[i], items.drop(i + 1));
    }
    i += 1;
  }
  if (items.len() > 0 && plex.playable_kind(items[0].kind)) {
    return start_play(s, items[0], items.drop(1));
  }
  return App { ...s, error: "Nothing to play" };
}

function toggle_watched(own s: App): App {
  let it = s.item;
  let now = !plex.watched(it);
  let views = 0;
  let offset = it.offset_ms;
  let seen = 0;
  if (now) {
    views = 1;
    offset = 0i64;
    seen = it.leaves;
  }
  let changed = plex.Item { ...it, views: views, offset_ms: offset, viewed_leaves: seen };
  return ask(App { ...s, item: changed, dirty: true }, "scrobble", Scrobble(it.key, now));
}

function sign_out(own s: App): App {
  let client = s.client.with_token("");
  let t = App { ...s, client: client, account: "", server: no_server(), base: plex.Base { uri: "", token: "" }, servers: [], hubs: [], sections: [], results: [], screen: ui.LOGIN, stack: [], dirty: true };
  save(t);
  return t;
}

function cycle_quality(own s: App): App {
  let quality = (s.quality + 1) % plex.qualities().len();
  let t = App { ...s, quality: quality, dirty: true };
  save(t);
  return t;
}

// --- playback

function start_play(own s: App, it: plex.Item, queue: plex.Item[]): App {
  let session = hex_id(s.dev);
  let q = plex.qualities()[s.quality];
  let choice = plex.remembered(it);
  let stream = plex.stream_for(s.client, s.base, it, q, it.offset_ms, session, s.dev.decoders, choice);
  let p = Play { ...no_play(), active: true, item: it, stream: stream, session: session, overlay: true, status: "Loading", queue: queue, position: it.offset_ms, duration: it.duration_ms, choice: choice };
  let t = App { ...push(s), screen: ui.PLAYER, play: p, dirty: true };
  if let Some(part) = plex.thumbnail_part(it) {
    t = ask(t, "bif:" + part.id, Bif(part.id));
  }
  // An item from a list has no markers and no tracks, so the app asks for
  // all of its metadata.
  if (!audio(t.play)) {
    t = ask(t, "playmeta:" + it.key, Meta(it.key));
  }
  log.info("plex: play " + it.key + " transcode=" + stream.transcode.to_string());
  if (!t.dev.play(stream.url)) {
    return App { ...t, play: Play { ...t.play, status: "The player refused the stream" } };
  }
  return t;
}

function art_of(it: plex.Item): string {
  if (it.art.len() > 0) {
    return it.art;
  }
  return plex.poster(it);
}

function audio(p: Play): boolean {
  return p.item.kind == "track";
}

function timeline(own s: App, state: string): App {
  let p = s.play;
  return report(s, Timeline(p.item.key, state, p.position, p.duration, p.session));
}

function prepared(own s: App): App {
  log.info("plex: prepared " + s.play.item.key);
  let d = s.dev.duration();
  let p = Play { ...s.play, prepared: true, status: "" };
  if (d > 0i64) {
    p = Play { ...p, duration: d };
  }
  let silent = !p.stream.transcode && !audio(p) && has_sound(p.item) && !s.dev.has_audio();
  if (!silent && p.stream.offset_ms > 0i64) {
    s.dev.seek(p.stream.offset_ms);
  }
  if (!silent && !p.stream.transcode) {
    pick_sound(s.dev, p);
  }
  let t = App { ...s, play: p, dirty: true };
  if (silent) {
    return transcode_sound(t, "the player selected no sound track", p.stream.offset_ms);
  } else {
    return resume(t);
  }
}

// Plays the chosen sound track of a file that plays as it is. The sound
// tracks of the server and of the player are both in the order of the file.
function pick_sound(dev: Device, p: Play): void {
  if (p.choice.audio.len() == 0) {
    return;
  }
  let sounds = plex.audio_tracks(p.item);
  let k = 0;
  while (k < sounds.len() && sounds[k].id != p.choice.audio) {
    k += 1;
  }
  let tracks = dev.audio_tracks();
  if (k < sounds.len() && k < tracks.len()) {
    let ok = dev.select_track(tracks[k]);
  }
}

// Plays the item with a new choice of tracks, and makes the server
// remember it. A file that plays as it is changes its sound in place.
// Otherwise the stream starts again where it is.
function choose(own s: App, choice: plex.Choice): App {
  let p = s.play;
  let t = s;
  if (p.item.media.len() > 0 && p.item.media[0].parts.len() > 0) {
    t = report(t, SelectTracks(p.item.media[0].parts[0].id, choice));
  }
  let q = plex.qualities()[t.quality];
  let session = hex_id(t.dev);
  let pos = p.position;
  if (p.prepared) {
    pos = t.dev.position();
  }
  let stream = plex.stream_for(t.client, t.base, p.item, q, pos, session, t.dev.decoders, choice);
  let next = Play { ...p, choice: choice, sheet: false };
  if (!stream.transcode && !p.stream.transcode) {
    pick_sound(t.dev, next);
    return App { ...t, play: next, dirty: true };
  }
  log.info("plex: new tracks, so the stream starts again");
  t.dev.stop();
  if (p.video) {
    t.dev.hide_video();
  }
  let ok = t.dev.play(stream.url);
  return App { ...t, play: Play { ...next, stream: stream, session: session, prepared: false, video: false, overlay: true, position: pos, status: "Loading" }, dirty: true };
}

// True when the first version of the item has a sound track.
function has_sound(it: plex.Item): boolean {
  return it.media.len() > 0 && it.media[0].audio.len() > 0;
}

// Plays the item again from `pos`, as a transcode in which the server
// converts the sound: the file played as it is, with no sound.
function transcode_sound(own s: App, why: string, pos: i64): App {
  let p = s.play;
  if (p.stream.transcode || p.retried) {
    return s;
  }
  log.warn("plex: no sound in direct play, " + why + ", so the server converts it");
  s.dev.stop();
  if (p.video) {
    s.dev.hide_video();
  }
  let session = hex_id(s.dev);
  let stream = plex.transcode_for(s.client, s.base, p.item, plex.qualities()[s.quality], pos, session, s.dev.decoders, p.choice);
  let ok = s.dev.play(stream.url);
  return App { ...s, play: Play { ...p, stream: stream, session: session, retried: true, prepared: false, video: false, overlay: true, position: pos, status: "Converting the sound" }, dirty: true };
}

// Shows the video on the window and plays.
function resume(own s: App): App {
  let p = s.play;
  if (!p.prepared) {
    return s;
  }
  let video = p.video;
  if (!audio(p) && !video && s.window != 0 as usize) {
    video = s.dev.show_video(s.window);
    if (video) {
      log.info("plex: video on the window");
    }
  }
  s.dev.start();
  s.dev.keep_screen_on(true);
  if (video) {
    s.dev.immersive(true);
    s.dev.request_frame();
  }
  let at = s.dev.mono_ms();
  return timeline(App { ...s, play: Play { ...p, paused: false, video: video, overlay: !video, reported_at: at }, dirty: true }, "playing");
}

// Pauses and takes the video off the window, so the overlay can show.
function pause_play(own s: App): App {
  let p = s.play;
  s.dev.pause();
  if (p.video) {
    s.dev.hide_video();
  }
  s.dev.keep_screen_on(false);
  s.dev.immersive(false);
  let pos = s.dev.position();
  log.info("plex: paused at " + pos.to_string());
  let at = s.dev.mono_ms();
  let t = App { ...s, play: Play { ...p, paused: true, video: false, overlay: true, position: pos, reported_at: at }, dirty: true };
  return timeline(t, "paused");
}

function seek_by(own s: App, delta: i64): App {
  let target = s.dev.position() + delta;
  if (target < 0i64) {
    target = 0i64;
  }
  if (s.play.duration > 0i64 && target > s.play.duration) {
    target = s.play.duration - 1000i64;
  }
  return seek_to(s, target);
}

// A seek in a transcode stays in its stream: the server starts the segments
// at the seek.
function seek_to(own s: App, ms: i64): App {
  s.dev.seek(ms);
  return App { ...s, play: Play { ...s.play, position: ms }, dirty: true };
}

// Ends the playback and goes back. A watched item is marked so.
function stop_play(own s: App, completed: boolean): App {
  let p = s.play;
  let pos = p.position;
  if (p.prepared) {
    pos = s.dev.position();
  }
  s.dev.stop();
  s.dev.keep_screen_on(false);
  s.dev.immersive(false);
  if (completed) {
    pos = p.duration;
  }
  let t = timeline(App { ...s, play: Play { ...p, position: pos } }, "stopped");
  if (p.stream.transcode) {
    t = report(t, StopTranscode(p.session));
  }
  if (completed || p.duration > 0i64 && pos * 10i64 >= p.duration * 9i64) {
    t = report(t, Scrobble(p.item.key, true));
  }
  return refresh_detail(pop(App { ...t, play: no_play() }));
}

// Asks the server again for the item of a detail screen, for its new
// position and its watched state.
function refresh_detail(own s: App): App {
  if (s.screen != ui.DETAIL) {
    return s;
  }
  let key = s.item.key;
  return ask(s, "meta:" + key, Meta(key));
}

function completed(own s: App): App {
  let queue = s.play.queue;
  let off = s.play.next_off;
  let t = stop_play(s, true);
  if (queue.len() > 0 && !off) {
    return start_play(t, queue[0], queue.drop(1));
  }
  return t;
}

function play_failed(own s: App, what: i32, extra: i32): App {
  let p = s.play;
  log.warn("plex: playback failed: " + what.to_string() + " " + extra.to_string());
  if (!p.stream.transcode && !p.retried) {
    // The file did not play as it is, so the server transcodes it.
    s.dev.stop();
    let q = plex.qualities()[2];
    let session = hex_id(s.dev);
    let it = plex.Item { ...p.item, offset_ms: p.position };
    let stream = plex.stream_for(s.client, s.base, it, q, p.position, session, s.dev.decoders, p.choice);
    let ok = s.dev.play(stream.url);
    return App { ...s, play: Play { ...p, stream: stream, session: session, retried: true, prepared: false, video: false, overlay: true, status: "Transcoding" }, dirty: true };
  }
  if (p.video) {
    s.dev.hide_video();
  }
  return App { ...s, play: Play { ...p, video: false, overlay: true, paused: true, status: "This item does not play (" + what.to_string() + ", " + extra.to_string() + ")" }, dirty: true };
}

function player_event(own s: App, c: player.Change): App {
  if (!s.play.active) {
    return s;
  }
  match (c) {
    player.Prepared => {
      return prepared(s);
    },
    player.Completed => {
      return completed(s);
    },
    player.Failed(what, extra) => {
      return play_failed(s, what, extra);
    },
    player.AudioNotPlaying => {
      let pos = s.dev.position();
      return transcode_sound(s, "the sound decoder stopped", pos);
    },
    player.VideoNotPlaying => {
      return play_failed(s, 805, 0);
    },
    player.Buffering(on) => {
      let status = "";
      if (on) {
        status = "Buffering";
      }
      return App { ...s, play: Play { ...s.play, buffering: on, status: status }, dirty: true };
    },
    player.Rendering => {
      return s;
    },
    player.Seeked => {
      return App { ...s, play: Play { ...s.play, position: s.dev.position() }, dirty: true };
    }
  }
}

// Keeps the position on the overlay and the server up to date. While the
// player is paused, the app still reports, and keeps its transcode alive.
function play_tick(own s: App, now: i64): App {
  let p = s.play;
  if (!p.active || !p.prepared) {
    return s;
  }
  if (p.paused) {
    if (now - p.reported_at < REPORT_MS) {
      return s;
    }
    let t = timeline(App { ...s, play: Play { ...p, reported_at: now } }, "paused");
    if (p.stream.transcode) {
      t = report(t, PingTranscode(p.session));
    }
    return t;
  }
  let t = s;
  if (p.video && p.overlay && now >= p.controls_until && t.press.group != "seek") {
    t = App { ...t, play: Play { ...t.play, overlay: false }, dirty: true };
  }
  if (now - p.updated_at >= 500i64) {
    let before = skip_label(t.play) + "|" + up_next_secs(t.play, now - 500i64).to_string();
    let moved = Play { ...t.play, position: t.dev.position(), updated_at: now };
    let from = up_next_from(moved);
    if (moved.up_next_at == 0i64 && from >= 0i64 && moved.position >= from) {
      moved = Play { ...moved, up_next_at: now };
    }
    let after = skip_label(moved) + "|" + up_next_secs(moved, now).to_string();
    t = App { ...t, play: moved, dirty: t.dirty || t.play.overlay || before != after };
    if (moved.up_next_at > 0i64 && now - moved.up_next_at >= UP_NEXT_MS) {
      return play_next(t);
    }
  }
  if (now - t.play.reported_at >= REPORT_MS) {
    t = App { ...t, play: Play { ...t.play, reported_at: now } };
    t = timeline(t, "playing");
  }
  return t;
}

// How long the controls show over the video after a tap.
const CONTROLS_MS: i64 = 4000i64;

// The markers and the media of the item that plays, from all of its
// metadata. The thumbnails come now when the item of the list had none.
function got_play_meta(own t: App, key: string, r: plex.Reply): App {
  if (!t.play.active || t.play.item.key != key) {
    return t;
  }
  let Some(full) = plex.parse_item(r.text()) else {
    return t;
  };
  let had = plex.thumbnail_part(t.play.item).is_some();
  let item = plex.Item { ...t.play.item, markers: full.markers, media: full.media };
  let u = App { ...t, play: Play { ...t.play, item: item } };
  if (!had) {
    if let Some(part) = plex.thumbnail_part(item) {
      return ask(u, "bif:" + part.id, Bif(part.id));
    }
  }
  return u;
}

// How long the card of the next item counts down, and how long before the
// end it comes when the video has no credits marker.
const UP_NEXT_MS: i64 = 10000i64;

const UP_NEXT_LEAD_MS: i64 = 20000i64;

// The time of the video where the card of the next item comes: the start
// of the credits, else UP_NEXT_LEAD_MS before the end. -1 when there is no
// next item.
function up_next_from(p: Play): i64 {
  if (p.queue.len() == 0 || p.next_off || audio(p) || p.duration <= 0i64) {
    return -1i64;
  }
  for m in p.item.markers {
    if (m.kind == "credits") {
      return m.start_ms;
    }
  }
  return p.duration - UP_NEXT_LEAD_MS;
}

// The seconds that the card of the next item shows, or -1 with no card.
function up_next_secs(p: Play, now: i64): i32 {
  if (p.up_next_at == 0i64) {
    return -1;
  }
  let left = UP_NEXT_MS - (now - p.up_next_at);
  if (left < 0i64) {
    return 0;
  }
  return ((left + 999i64) / 1000i64) as i32;
}

// Plays the next item now. The item that plays counts as watched.
function play_next(own s: App): App {
  let queue = s.play.queue;
  let t = stop_play(s, true);
  return start_play(t, queue[0], queue.drop(1));
}

// The words of the skip button at the place of the playback, or "".
function skip_label(p: Play): string {
  if (!p.active || !p.prepared || audio(p)) {
    return "";
  }
  let Some(m) = plex.marker_at(p.item, p.position) else {
    return "";
  };
  if (m.kind == "credits") {
    return "Skip credits";
  }
  return "Skip intro";
}

// The preview thumbnails of the part `id`, when the item that plays has
// that part. A server with no thumbnails answers 404, and then the drag
// shows only the time.
function got_bif(own t: App, id: string, r: plex.Reply): App {
  let Some(part) = plex.thumbnail_part(t.play.item) else {
    return t;
  };
  if (!t.play.active || part.id != id || !r.ok()) {
    return t;
  }
  return App { ...t, play: Play { ...t.play, bif: plex.parse_bif(r.body) } };
}

// The seek bar among the nodes.
function seek_bar_of(ns: scene.Node[]): Option[scene.Node] {
  for n in ns {
    if (n.group == "seek") {
      return Some(n);
    }
  }
  return None;
}

// How long the player waits between two seeks while the finger drags.
const SCRUB_SEEK_MS: i64 = 200i64;

// The finger on the seek bar at `x`: the time under it shows with its
// thumbnail, and the player seeks there at most every SCRUB_SEEK_MS. When
// the finger leaves, the player seeks there at once.
function scrub(own s: App, x: i32, done: boolean): App {
  let p = s.play;
  let Some(n) = seek_bar_of(s.nodes) else {
    return s;
  };
  if (p.duration <= 0i64 || n.w <= 0) {
    return s;
  }
  let along = clamp(x - n.x, 0, n.w);
  let ms = p.duration * (along as i64) / (n.w as i64);
  if (done) {
    return seek_to(App { ...s, play: Play { ...p, scrub_ms: -1i64, thumb_index: -1, thumb: None } }, ms);
  }
  let now = s.dev.mono_ms();
  let at = p.scrub_seek_at;
  if (now - at >= SCRUB_SEEK_MS) {
    s.dev.seek(ms);
    at = now;
  }
  let index = p.thumb_index;
  let thumb = p.thumb;
  if let Some(f) = p.bif {
    let i = plex.bif_frame(f, ms);
    if (i >= 0 && i != index) {
      let m = ui.metrics(s.w, s.h, s.top, s.bottom);
      let (tw, th) = ui.thumb_size(m);
      index = i;
      thumb = s.dev.decode(plex.bif_jpeg(f, i), tw, th);
    }
  }
  return App { ...s, play: Play { ...p, scrub_ms: ms, scrub_seek_at: at, thumb_index: index, thumb: thumb, controls_until: now + CONTROLS_MS }, dirty: true };
}

function player_act(own s: App, act: string, n: scene.Node, x: i32): App {
  let p = s.play;
  if (act == "overlay") {
    if (!p.drawn) {
      // The player draws on the window itself, so nothing can show over the
      // video: the controls show with the video paused.
      return pause_play(s);
    }
    log.info("plex: controls over the video");
    let until = s.dev.mono_ms() + CONTROLS_MS;
    return App { ...s, play: Play { ...p, overlay: true, controls_until: until }, dirty: true };
  }
  if (act == "hide") {
    return App { ...s, play: Play { ...p, overlay: false }, dirty: true };
  }
  if (p.video && p.overlay) {
    // A control keeps the controls up for a while longer.
    let until = s.dev.mono_ms() + CONTROLS_MS;
    return player_control(App { ...s, play: Play { ...p, controls_until: until } }, act, n, x);
  }
  return player_control(s, act, n, x);
}

function player_control(own s: App, act: string, n: scene.Node, x: i32): App {
  let p = s.play;
  if (act == "toggle") {
    if (p.paused || !p.prepared) {
      return resume(s);
    }
    return pause_play(s);
  }
  if (act == "next_now" && p.queue.len() > 0) {
    return play_next(s);
  }
  if (act == "next_cancel") {
    return App { ...s, play: Play { ...p, next_off: true, up_next_at: 0i64 }, dirty: true };
  }
  if (act == "skip") {
    if let Some(m) = plex.marker_at(p.item, p.position) {
      log.info("plex: skip the " + m.kind);
      return seek_to(s, m.end_ms);
    }
    return s;
  }
  if (act == "tracks") {
    return App { ...s, play: Play { ...p, sheet: true }, dirty: true };
  }
  if (act == "tracks_close") {
    return App { ...s, play: Play { ...p, sheet: false }, dirty: true };
  }
  if (act.starts_with("audio:")) {
    return choose(s, plex.Choice { ...p.choice, audio: act.drop(6).to_owned() });
  }
  if (act.starts_with("sub:")) {
    return choose(s, plex.Choice { ...p.choice, subtitle: act.drop(4).to_owned() });
  }
  if (act == "rew") {
    return seek_by(s, -10000i64);
  }
  if (act == "ffw") {
    return seek_by(s, 30000i64);
  }
  if (act == "back") {
    return stop_play(s, false);
  }
  return s;
}

// --- touches and keys

function scroll_limit(s: App, m: ui.Metrics): i32 {
  let v = view(s);
  let visible = ui.content_bottom(m, s.screen) - ui.content_top(m);
  let h = 0;
  if (s.screen == ui.HOME) {
    h = ui.home_height(m, v);
  } else if (s.screen == ui.SEARCH) {
    h = ui.home_height(m, v) + 72 * m.u;
  } else if (s.screen == ui.LIBRARY) {
    h = ui.grid_height(m, s.items.len());
  } else if (s.screen == ui.DETAIL) {
    h = ui.detail_height(m, v);
  } else if (s.screen == ui.SECTIONS) {
    h = s.sections.len() * 64 * m.u + 16 * m.u;
  } else if (s.screen == ui.SERVERS) {
    h = s.servers.len() * 72 * m.u + 160 * m.u;
  }
  if (h <= visible) {
    return 0;
  }
  return h - visible;
}

function clamp(v: i32, lo: i32, hi: i32): i32 {
  if (v < lo) {
    return lo;
  }
  if (v > hi) {
    return hi;
  }
  return v;
}

function row_index(group: string): i32 {
  if (group.starts_with("row:")) {
    return num(group.split_at(4).1);
  }
  return -1;
}

function row_offset(rows: i32[], i: i32): i32 {
  if (i >= 0 && i < rows.len()) {
    return rows[i];
  }
  return 0;
}

function set_row(rows: i32[], i: i32, v: i32): i32[] {
  let out = rows;
  while (out.len() <= i) {
    out = out.append(0);
  }
  return out.with(i, v);
}

function row_items(s: App, i: i32): i32 {
  let hubs = s.hubs;
  if (s.screen == ui.SEARCH) {
    hubs = s.results;
  }
  if (i >= 0 && i < hubs.len()) {
    return hubs[i].items.len();
  }
  return 0;
}

function touch(own s: App, action: i32, x: f32, y: f32): App {
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let slop = (8 * m.u) as f32;
  let p = s.press;
  let t_ns = s.dev.mono_ms() * 1000000i64;
  if (action == 0) {
    let group = scene.group_at(s.nodes, x as i32, y as i32);
    let xs = [motion.Sample { t: t_ns, y: x as f64 }];
    let ys = [motion.Sample { t: t_ns, y: y as f64 }];
    let caught = s.fling.group.len() > 0;
    let pressed = Press { active: true, x0: x, y0: y, x: x, y: y, axis: 0, group: group, scroll0: s.scroll, row0: row_offset(s.rows, row_index(group)), xs: xs, ys: ys, caught: caught };
    if (group == "seek" && s.screen == ui.PLAYER) {
      return scrub(App { ...s, fling: no_fling(), press: pressed }, x as i32, false);
    }
    return App { ...s, fling: no_fling(), press: pressed };
  }
  if (p.active && p.group == "seek") {
    if (action == 2) {
      return scrub(s, x as i32, false);
    }
    return scrub(App { ...s, press: no_press() }, x as i32, action == 1);
  }
  if (!p.active) {
    return s;
  }
  p = Press { ...p, xs: motion.track(p.xs, motion.Sample { t: t_ns, y: x as f64 }), ys: motion.track(p.ys, motion.Sample { t: t_ns, y: y as f64 }) };
  if (action == 2) {
    let dx = x - p.x0;
    let dy = y - p.y0;
    let axis = p.axis;
    if (axis == 0 && (abs_f(dx) > slop || abs_f(dy) > slop)) {
      axis = 2;
      if (p.group.len() > 0 && abs_f(dx) > abs_f(dy)) {
        axis = 1;
      }
    }
    s = App { ...s, press: Press { ...p, x: x, y: y, axis: axis } };
    if (axis == 1) {
      let i = row_index(p.group);
      let max = ui.hub_row_width(m, row_items(s, i)) - m.w;
      if (max < 0) {
        max = 0;
      }
      return App { ...s, rows: set_row(s.rows, i, clamp(p.row0 - dx as i32, 0, max)), dirty: true };
    }
    if (axis == 2) {
      let next = clamp(p.scroll0 - dy as i32, 0, scroll_limit(s, m));
      return more_items(App { ...s, scroll: next, dirty: true });
    }
    return s;
  }
  let t = App { ...s, press: no_press() };
  if (action == 1 && p.axis == 0 && !p.caught) {
    return tapped(t, x as i32, y as i32);
  }
  if (action == 1 && p.axis != 0) {
    return flung(t, p, m);
  }
  return t;
}

// Starts a fling of the list that the finger moved, at the speed of the
// finger when it left.
function flung(own s: App, p: Press, m: ui.Metrics): App {
  let group = "list";
  let start = s.scroll;
  let v = motion.velocity(p.ys);
  if (p.axis == 1) {
    group = p.group;
    start = row_offset(s.rows, row_index(group));
    v = motion.velocity(p.xs);
  }
  let f = motion.fling(start, 0.0 - v, m.u as f64, 0i64);
  if (!motion.moving(f)) {
    return s;
  }
  s.dev.request_frame();
  return App { ...s, fling: Fling { group: group, f: f } };
}

// Moves a flung list to its place at the frame time `ns`. The fling starts
// at the first frame after the finger leaves, and stops at an end.
function fling_frame(own s: App, ns: i64): App {
  let fl = s.fling;
  if (fl.group.len() == 0) {
    return s;
  }
  let f = fl.f;
  if (f.t0 == 0i64) {
    f = motion.Fling { ...f, t0: ns };
  }
  let (pos, done) = motion.position(f, ns);
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let at = pos as i32;
  let max = 0;
  if (fl.group == "list") {
    max = scroll_limit(s, m);
  } else {
    max = ui.hub_row_width(m, row_items(s, row_index(fl.group))) - m.w;
  }
  if (max < 0) {
    max = 0;
  }
  let next = clamp(at, 0, max);
  let edge = next != at;
  let t = if (fl.group == "list") {
    more_items(App { ...s, scroll: next, dirty: true })
  } else {
    App { ...s, rows: set_row(s.rows, row_index(fl.group), next), dirty: true }
  };
  if (done || edge) {
    return App { ...t, fling: no_fling() };
  }
  return App { ...t, fling: Fling { group: fl.group, f: f } };
}

function abs_f(v: f32): f32 {
  if (v < 0.0) {
    return 0.0 - v;
  }
  return v;
}

function tapped(own s: App, x: i32, y: i32): App {
  let Some(n) = scene.hit(s.nodes, x, y) else {
    if (s.typing) {
      s.dev.hide_field();
      return App { ...s, typing: false, dirty: true };
    }
    return s;
  };
  return act(s, n.tap.name, n, x);
}

// Runs the action of a tapped node.
pub function act(own s: App, a: string, n: scene.Node, x: i32): App {
  if (s.screen == ui.PLAYER) {
    return player_act(s, a, n, x);
  }
  let t = App { ...s, error: "" };
  if (a == "signin") {
    return ask(t, "pin", NewPin);
  }
  if (a == "cancel") {
    return App { ...t, pin: plex.Pin { id: 0i64, code: "", token: "" }, dirty: true };
  }
  if (a == "refresh") {
    return open_servers(t);
  }
  if (a.starts_with("server:")) {
    return connect(t, num(a.split_at(7).1));
  }
  if (a.starts_with("tab:")) {
    return open_tab(t, num(a.split_at(4).1));
  }
  if (a.starts_with("section:")) {
    return open_section(t, num(a.split_at(8).1));
  }
  if (a == "back") {
    return pop(t);
  }
  if (a == "play") {
    return play_detail(t);
  }
  if (a == "watched") {
    return toggle_watched(t);
  }
  if (a == "type") {
    t.dev.show_field(t.query);
    return App { ...t, typing: true, dirty: true };
  }
  if (a == "servers") {
    return open_servers(push(t));
  }
  if (a == "quality") {
    return cycle_quality(t);
  }
  if (a == "signout") {
    return sign_out(t);
  }
  if let Some(it) = item_at(t, a) {
    return open_item(t, it);
  }
  return t;
}

const KEY_BACK: i32 = 4;

const KEY_ENTER: i32 = 66;

const KEY_DEL: i32 = 67;

function back(own s: App): App {
  if (s.typing) {
    s.dev.hide_field();
    return App { ...s, typing: false, dirty: true };
  }
  if (s.screen == ui.PLAYER) {
    return stop_play(s, false);
  }
  if (s.stack.len() > 0) {
    return pop(s);
  }
  if (s.screen != ui.HOME && s.screen != ui.LOGIN && s.screen != ui.SERVERS) {
    return open_tab(s, 0);
  }
  s.dev.finish();
  return s;
}

function key(own s: App, code: i32, action: i32): App {
  if (action != 1) {
    return s;
  }
  if (code == KEY_BACK) {
    return back(s);
  }
  if (!s.typing) {
    return s;
  }
  if (code == KEY_DEL && s.query.len() > 0) {
    let q = drop_last(s.query);
    return keyed(s, q);
  }
  if (code == KEY_ENTER) {
    return search_now(s);
  }
  return s;
}

function drop_last(q: string): string {
  let cs: string[] = [];
  for c in q.chars() {
    cs = cs.append(c.to_string());
  }
  return cs.take(cs.len() - 1).join("");
}

function typed(own s: App, c: i32): App {
  if (!s.typing || c < 32 || c == 127) {
    return s;
  }
  let q = s.query + char_string(c);
  return keyed(s, q);
}

// A key of a hardware keyboard changes the query, so the field of the
// keyboard of the system gets the same text.
function keyed(own s: App, q: string): App {
  s.dev.set_field(q);
  return query_changed(s, q);
}

// The typing ends and the search starts at once.
function search_now(own s: App): App {
  s.dev.hide_field();
  return App { ...s, typing: false, search_at: s.dev.mono_ms(), dirty: true };
}

function char_string(c: i32): string {
  return utf8.encode(c as char);
}

function query_changed(own s: App, q: string): App {
  return App { ...s, query: q, search_at: s.dev.mono_ms() + SEARCH_MS, dirty: true };
}

function search_tick(own s: App, now: i64): App {
  if (s.search_at == 0i64 || now < s.search_at) {
    return s;
  }
  let q = s.query;
  if (q.trim().len() == 0) {
    return App { ...s, search_at: 0i64, results: [], dirty: true };
  }
  return ask(App { ...s, search_at: 0i64 }, "search:" + q, Search(q));
}

function pin_tick(own s: App, now: i64): App {
  if (s.pin.id == 0i64 || now < s.pin_at || s.screen != ui.LOGIN) {
    return s;
  }
  for a in s.asks {
    if (a.purpose == "pincheck") {
      return s;
    }
  }
  if (has_call(s.api, "pincheck")) {
    return s;
  }
  return ask(App { ...s, pin_at: now + PIN_MS }, "pincheck", CheckPin(s.pin.id));
}

// --- the loop

pub function view(s: App): ui.View {
  let hubs = s.hubs;
  if (s.screen == ui.SEARCH) {
    hubs = s.results;
  }
  let p = s.play;
  let pv = ui.PlayerView { title: p.item.title, subtitle: player_subtitle(p.item) + mode_text(p), position_ms: p.position, duration_ms: p.duration, paused: p.paused, buffering: p.buffering, overlay: p.overlay || s.screen == ui.PLAYER && !p.video, over_video: p.video && p.overlay, skip: skip_label(p), up_next: next_title(p), up_next_secs: up_next_secs(p, s.dev.mono_ms()), sheet: p.sheet, sounds: plex.audio_tracks(p.item), subtitles: plex.subtitle_tracks(p.item), choice: p.choice, scrub_ms: p.scrub_ms, thumb: p.thumb, thumb_key: "bif|" + p.item.key + "|" + p.thumb_index.to_string(), art: art_of(p.item), audio: audio(p), status: p.status };
  return ui.View {
    ...ui.empty_view(s.w, s.h),
    top: s.top, bottom: s.bottom,
    screen: s.screen, tab: s.tab, title: s.title, scroll: s.scroll, rows: s.rows, hubs: hubs,
    sections: s.sections, items: s.items, total: s.total, item: s.item, children: s.children,
    pin_code: s.pin.code, error: s.error, servers: s.servers, server_states: s.states,
    query: s.query, typing: s.typing, account: s.account, server_name: s.server.name,
    quality: plex.qualities()[s.quality].name, player: pv, base: s.base,
    loading: busy(s), cache: s.cache,
  };
}

// How the stream reaches the player, after the subtitle.
function mode_text(p: Play): string {
  if (!p.active || p.stream.url.len() == 0) {
    return "";
  }
  if (p.stream.transcode) {
    return " · Transcode";
  }
  return " · Direct play";
}

// The words of the next item on its card, or "".
function next_title(p: Play): string {
  if (p.queue.len() == 0) {
    return "";
  }
  let it = p.queue[0];
  if (it.kind == "episode") {
    return plex.episode_code(it) + " · " + it.title;
  }
  return it.title;
}

function player_subtitle(it: plex.Item): string {
  if (it.kind == "episode") {
    return it.grandparent + " · " + plex.episode_code(it);
  }
  if (it.kind == "track") {
    return it.grandparent;
  }
  if (it.year > 0) {
    return it.year.to_string();
  }
  return "";
}

function busy(s: App): boolean {
  return s.asks.len() > 0 || is_some_call(s.api);
}

function is_some_call(c: Option[Call]): boolean {
  match (c) {
    Some(_) => {
      return true;
    },
    None => {
      return false;
    }
  }
}

function is_some_batch(b: Option[Batch]): boolean {
  match (b) {
    Some(_) => {
      return true;
    },
    None => {
      return false;
    }
  }
}

// The milliseconds to wait for the next event before a Tick.
pub function timeout(s: App, now: i64): i32 {
  if (is_some_call(s.api) || is_some_batch(s.img) || is_some_call(s.report) || s.asks.len() > 0 || s.reports.len() > 0 || s.probes.len() > 0 || s.left.len() > 0) {
    return 30;
  }
  if (s.play.active && s.play.prepared) {
    if (s.play.paused) {
      return clamp((s.play.reported_at + REPORT_MS - now) as i32, 1, REPORT_MS as i32);
    }
    return 500;
  }
  if (s.search_at > 0i64) {
    return clamp((s.search_at - now) as i32, 1, 1000);
  }
  if (s.pin.id != 0i64) {
    return clamp((s.pin_at - now) as i32, 1, 2000);
  }
  return -1;
}

function event(own s: App, e: android.Event): App {
  if let Some(c) = player.event(e) {
    return player_event(s, c);
  }
  match (e) {
    android.Start => {
      return App { ...s, shown: true, dirty: true };
    },
    android.Stop => {
      return App { ...s, shown: false };
    },
    android.Pause => {
      if (s.play.active && s.play.prepared && !s.play.paused) {
        return pause_play(s);
      }
      return s;
    },
    android.WindowCreated(w) => {
      let (ww, wh) = s.dev.size(w.ptr);
      let gpu = s.dev.attach(w.ptr);
      return App { ...s, window: w.ptr, w: ww, h: wh, gpu: gpu, dirty: true };
    },
    android.WindowResized(w) => {
      let (ww, wh) = s.dev.size(w.ptr);
      let gpu = s.gpu;
      if (w.ptr != s.window) {
        gpu = s.dev.attach(w.ptr);
      }
      return App { ...s, window: w.ptr, w: ww, h: wh, gpu: gpu, dirty: true };
    },
    android.WindowRedraw(w) => {
      return App { ...s, window: w.ptr, dirty: true };
    },
    android.ContentRect(_, top, _, bottom) => {
      let b = s.h - bottom;
      if (b < 0 || s.h == 0) {
        b = 0;
      }
      return App { ...s, top: top, bottom: b, dirty: true };
    },
    android.WindowDestroyed(_) => {
      let t = s;
      if (t.play.video) {
        t = pause_play(t);
      }
      t.dev.detach();
      return App { ...t, window: 0 as usize, gpu: false, fling: no_fling() };
    },
    android.Vsync(ns) => {
      return frame(s, ns);
    },
    android.Touch(action, x, y) => {
      return touch(s, action, x, y);
    },
    android.Key(code, action) => {
      return key(s, code, action);
    },
    android.Char(c) => {
      return typed(s, c);
    },
    android.Text(q) => {
      if (!s.typing) {
        return s;
      }
      return query_changed(s, q);
    },
    android.TextAction(_) => {
      if (!s.typing) {
        return s;
      }
      return search_now(s);
    },
    _ => {
      return s;
    }
  }
}

// Makes the nodes of the screen when it changed. With the GPU, they draw
// at the next vsync. With the CPU, they draw at once, unless the player
// has the window.
function draw_screen(own s: App): App {
  if (!s.dirty || s.window == 0 as usize || s.w == 0) {
    return s;
  }
  let t = App { ...s, nodes: ui.nodes(view(s)), dirty: false };
  if (t.gpu) {
    t.dev.request_frame();
    return App { ...t, paint: true };
  }
  if (!t.play.video) {
    let f = t.dev.lock(t.window);
    if (f.width > 0) {
      let c = scene.render(f, text.Fonts { faces: [], weights: [] }, text.new_cache(), t.nodes);
    }
    t.dev.post(f);
  }
  return t;
}

// The frame at the vsync `ns`: a fling moves to that time, and the GPU
// draws the screen when it changed, and each frame of a video with its
// controls over it.
function frame(own s: App, ns: i64): App {
  let t = draw_screen(fling_frame(s, ns));
  let more = t.fling.group.len() > 0;
  if (t.gpu && t.window != 0 as usize) {
    if (t.play.video) {
      let over: scene.Node[] = [];
      if (t.play.overlay || skip_label(t.play).len() > 0 || t.play.up_next_at > 0i64) {
        over = t.nodes;
      }
      if (t.dev.present(t.window, over, true)) {
        more = true;
        if (!t.play.drawn) {
          t = App { ...t, play: Play { ...t.play, drawn: true } };
        }
      }
    } else if (t.paint) {
      let shown = t.dev.present(t.window, t.nodes, false);
    }
    t = App { ...t, paint: false };
  }
  if (more) {
    t.dev.request_frame();
  }
  return t;
}

// The state after event `e`: the app handles it, polls its workers, starts
// the next requests and draws the screen when it changed.
pub function step(own s: App, e: android.Event): App {
  let now = s.dev.mono_ms();
  let t = search_tick(pin_tick(play_tick(event(s, e), now), now), now);
  t = poll_probes(poll_report(poll_images(poll_api(t))));
  t = start_report(start_api(t));
  t = draw_screen(t);
  return start_images(t);
}

// Joins the workers that still run, and stops the player.
pub function close(own s: App): void {
  if (s.play.active) {
    s.dev.stop();
  }
  for w in s.probes {
    let rs = w.join();
  }
  for w in s.left {
    let rs = w.join();
  }
  if let Some(c) = s.api {
    let rs = c.w.join();
  }
  if let Some(b) = s.img {
    let rs = b.w.join();
  }
  if let Some(r) = s.report {
    let rs = r.w.join();
  }
}
