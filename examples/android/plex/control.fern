// The behaviour of Fern for Plex on its events. plex.fern holds the model and
// ui.fern the look. Each input and output goes through a Device: app.fern
// gives the device of the phone, and control_test.fern gives one with a
// fake server.
//
// The app sends at most one request to the API at a time, one batch of
// images, and one report of playback. Each runs in a worker of std/worker,
// so the loop thread never waits for the network. The loop polls the
// workers on its timeouts.
import "std/android";
import "std/android/browse";
import "std/android/download";
import "std/android/draw";
import "std/android/focus";
import "std/android/motion";
import "std/android/player";
import "std/android/session";
import "std/android/text";
import "std/android/ui/scene";
import "std/i18n";
import "std/log";
import "std/string";
import "std/utf8";
import "std/worker";
import "./plex";
import "./texts";
import "./ui";

// The input and output of the app. `read` gives "" for a file that does not
// exist. `fetch` starts a worker that sends the requests in turn. The player
// functions drive the player of the item that plays.
pub struct Device {
  mono_ms: () => i64,
  read: (string) => string,
  write: (string, string) => void,
  // Deletes the file at the path.
  remove: (string) => void,
  size: (usize) => (i32, i32),
  lock: (usize) => draw.Frame,
  post: (draw.Frame) => void,
  finish: () => void,
  keep_screen_on: (boolean) => void,
  immersive: (boolean) => void,
  // Turns the screen to the wide side of the video, or gives the turn back
  // to the device.
  turn: (boolean) => void,
  show_field: (string) => void,
  set_field: (string) => void,
  hide_field: () => void,
  fetch: (plex.Request[]) => worker.Worker[plex.Reply[]],
  // As fetch, for images: an image that the phone keeps comes from its
  // storage, and a new one goes there.
  fetch_images: (plex.Request[]) => worker.Worker[plex.Reply[]],
  decode: (u8[], i32, i32) => Option[draw.Image],
  play: (string) => boolean,
  // Puts the video on the window, and false when it cannot.
  show_video: (usize) => boolean,
  // Asks the display of the window to show it at a frame rate, or takes the
  // request away with 0.
  frame_rate: (usize, f32) => void,
  // Shows the subtitle track of the file with an index among its subtitle
  // tracks, or none with -1. The player draws the subtitles of images.
  select_text: (i32) => boolean,
  // The subtitles of images that show now, with no keys.
  image_cues: () => ui.Picture[],
  // The width and the height of the video in pixels, or (0, 0).
  video_size: () => (i32, i32),
  // Puts the GPU painter on the window, and false when the phone has none:
  // then the app draws with `lock` and `post`.
  attach: (usize) => boolean,
  // Takes the painter off the window, before the window goes.
  detach: () => void,
  // Draws the nodes on the window with the GPU, over the newest frame of
  // the video when the bool is true. False when it cannot.
  present: (usize, scene.Node[], boolean) => boolean,
  hide_video: () => void,
  // Takes the video off the window for a pause. The next show_video goes on
  // from the same place.
  pause_video: () => void,
  // Asks for a Vsync event at the next frame of the display.
  request_frame: () => void,
  start: () => void,
  pause: () => void,
  seek: (i64) => void,
  position: () => i64,
  duration: () => i64,
  stop: () => void,
  // The index of each sound track of the prepared player, and the track
  // that plays.
  audio_tracks: () => i32[],
  select_track: (i32) => boolean,
  // Plays at a rate in hundredths: 100 is the normal speed. A rate also
  // starts a paused player, so the app sets it only while the player plays.
  set_speed: (i32) => void,
  // True when the prepared player selected a sound track.
  has_audio: () => boolean,
  // Sets the brightness of the window from 0.0 to 1.0, or that of the
  // system for a negative level, and gives the brightness of the system.
  brightness: (f32) => void,
  system_brightness: () => f32,
  // The volume of the music and its greatest value, and a new volume.
  volume: () => (i32, i32),
  set_volume: (i32) => void,
  // Tells the media controls of Android the track that plays: its title,
  // artist and album, its length, whether it plays, and where. The system
  // then keeps the app at work while its window is away.
  now_playing: (string, string, string, i64, boolean, i64) => void,
  // Ends the media controls, and lets the app stop with its window.
  media_end: () => void,
  // Asks Android for the audio focus, so another app that plays stops.
  // False when Android refuses it, as during a call. And lets it go.
  take_focus: () => boolean,
  drop_focus: () => void,
  // Asks for the permission to post notifications, where Android needs it
  // and the app has not got it, so the media controls can show.
  ask_notifications: () => void,
  // Lets Android show the video in a picture-in-picture window when the
  // user leaves the app, or stops that. True while the app shows in one.
  pip: (boolean) => void,
  in_pip: () => boolean,
  // Puts a video on the Watch Next row of Android TV: its key, title, kind
  // (watchnext.MOVIE or EPISODE), place, length and poster address. And
  // takes the video of a key off the row.
  watch_next: (string, string, i32, i64, i64, string) => void,
  watch_next_drop: (string) => void,
  // Gives the channel row of the app on Android TV its items. A phone has
  // no such row, and this changes nothing.
  channel: (Card[]) => void,
  // Gives Android a download of the request to the file `name` in
  // `downloads_dir`, with the title of its notification. The ID of the
  // download, or -1.
  download: (plex.Request, string, string) => i64,
  download_progress: (i64) => download.Progress,
  // Stops a download and deletes its file.
  download_remove: (i64) => void,
  downloads_dir: string,
  // Prepares `uri` on the second player, to follow the track that plays.
  queue_next: (string) => boolean,
  // Gives the prepared second player to the one that plays, so it starts
  // with no gap at the end of the track. False takes it away and stops it.
  chain: (boolean) => void,
  // The second player took over at the end of the track, and plays now.
  swap: () => void,
  // Whether the second player sent the event.
  from_next: (android.Event) => boolean,
  // Gives an accessibility service, such as TalkBack, the items that the
  // screen shows.
  access: (android.AccessItem[]) => void,
  random: () => i32,
  // The MIME types that the decoders of the phone take.
  decoders: string[],
  // Gives the media browser of the app the token of its media session,
  // so Android Auto shows the app.
  browse_connect: (browse.Service) => void,
  // The id of the parent of a request of a media browser, the answer to
  // it, and the id of an item to play.
  browse_parent: (browse.Request) => string,
  browse_answer: (browse.Request, browse.Item[]) => boolean,
  media_id: (browse.MediaId) => string,
  // The languages of the person, the first one the best.
  languages: string[],
}

// A request to the API that waits for its turn. `purpose` says what to do
// with the reply.
struct Ask { purpose: string, req: plex.Request }

// What the server must hear about the item `key` when it answers again.
struct Pending { key: string, seen: boolean, at: i64, total: i64 }

// The request to the API that a worker sends now.
struct Call { purpose: string, w: worker.Worker[plex.Reply[]] }

// The batch of images that a worker fetches now.
struct Batch { keys: string[], w: worker.Worker[plex.Reply[]] }

// A screen on the back stack, as the user left it.
struct Page { screen: i32, title: string, scroll: i32, rows: i32[], items: plex.Item[], total: i32, section: plex.Section, item: plex.Item, children: plex.Item[], local: boolean }

// A finger on the screen. `axis` is 0 until it moves, 1 when it moves a
// row across and 2 when it moves the screen up or down. `xs` and `ys` are
// its recent positions, for the speed of a fling. `caught` is true when the
// finger stopped a fling, and then it is no tap.
struct Press { active: boolean, x0: f32, y0: f32, x: f32, y: f32, axis: i32, group: string, scroll0: i32, row0: i32, xs: motion.Sample[], ys: motion.Sample[], caught: boolean }

// A list that moves on after the finger leaves: "list" for the screen, or
// the group of a row of posters. The group is "" when nothing moves.
struct Fling { group: string, f: motion.Fling }

function no_fling(): Fling {
  return Fling { group: "", f: motion.no_fling() };
}

// The playback of an item. `video` is true while the video is on the
// window, and then the app does not lock the window. `drawn` is true when
// the app draws the video itself, so its controls can show over it until
// `controls_until`.
struct Play {
  active: boolean,
  item: plex.Item,
  stream: plex.Stream,
  session: string,
  prepared: boolean,
  paused: boolean,
  video: boolean,
  overlay: boolean,
  drawn: boolean,
  controls_until: i64,
  buffering: boolean,
  position: i64,
  duration: i64,
  reported_at: i64,
  updated_at: i64,
  retried: boolean,
  status: string,
  queue: plex.Item[],
  // The items of the album or the list that the play started from, in
  // their order, for repeat and for an end of shuffle.
  album: plex.Item[],
  // The preview thumbnails of the item, while the finger drags the seek bar
  // the time under it, or -1, the time of the last seek of the drag, and
  // the thumbnail that shows.
  bif: Option[plex.Bif],
  scrub_ms: i64,
  scrub_seek_at: i64,
  thumb_index: i32,
  thumb: Option[draw.Image],
  // The index in `plex.qualities()` of the quality that plays, and with
  // Auto the times of the recent stalls of the stream.
  level: i32,
  stalls: i64[],
  // The sound and the subtitles that play, and whether the sheet of the
  // tracks shows. `cues` are the lines of a subtitle file that the app
  // draws over the video.
  choice: plex.Choice,
  cues: plex.Cue[],
  sheet: boolean,
  // The subtitles of images that the player shows now, and the delay of
  // the text subtitles: a positive delay shows each line later.
  images: ui.Picture[],
  delay_ms: i64,
  // The time that the card of the next item came, or 0, and whether the
  // user turned the next item off.
  up_next_at: i64,
  next_off: boolean,
  // The time and the place of the last tap on the video, and whether the
  // controls showed before it. A second tap at the side soon after seeks.
  tap_at: i64,
  tap_x: i32,
  tap_overlay: boolean,
  // A short note over the video, such as "+10", and when it goes.
  badge: string,
  badge_until: i64,
  // The level that a vertical drag on the video sets: 0 none, 1 the
  // brightness and 2 the volume. Its level at the start, the level that it
  // set last, its greatest level, and the brightness that the app set in
  // thousandths, or -1.
  gesture: i32,
  gesture_from: i32,
  gesture_level: i32,
  gesture_max: i32,
  light: i32,
  // The track that the second player prepares to follow this one, or
  // no_item, with its queue, its stream and its session. `next_ready` is
  // true once the second player is chained. `next_plan` is the plan that
  // chose it, and `next_tried` a plan that gave no next track.
  next: plex.Item,
  next_queue: plex.Item[],
  next_stream: plex.Stream,
  next_session: string,
  next_ready: boolean,
  next_plan: string,
  next_tried: string,
  // True when the play paused because another app or a call took the
  // audio focus, so it goes on when the focus comes back.
  focus_paused: boolean,
  // True when the new stream waits until the server remembers the tracks
  // of a choice.
  held: boolean,
}

pub struct App {
  dev: Device,
  dir: string,
  window: usize,
  w: i32,
  h: i32,
  // The pixels that the status bar and the navigation bar cover.
  top: i32,
  bottom: i32,
  shown: boolean,
  client: plex.Client,
  server: plex.Server,
  base: plex.Base,
  servers: plex.Server[],
  states: string[],
  // The server whose connections the app probes, or -1, the state of each
  // connection (0 waits, 1 answered, 2 failed), the time the probes
  // started, the probes that run, and the workers of a race that ended.
  probing: i32,
  probe_states: i32[],
  probe_at: i64,
  probes: Probe[],
  // True while the app races the connections of the server that it uses
  // again, and the time that it last asked for that.
  rechecking: boolean,
  recheck_at: i64,
  left: worker.Worker[plex.Reply[]][],
  pin: plex.Pin,
  pin_at: i64,
  account: string,
  quality: i32,
  // The rate of the playback in hundredths, one of `speeds()`.
  speed: i32,
  // The language of the tracks, a two-letter code, or "" for the one of
  // the account or the phone. The mode of the subtitles is one of
  // plex.SUBS_*, or -1 for the one of the account.
  lang: string,
  subs: i32,
  // The language and the mode of the subtitles of the plex.tv account, ""
  // and -1 when it gives none.
  account_lang: string,
  account_subs: i32,
  // The items and the shows whose tracks the person chose. They keep the
  // tracks that the server remembers.
  picked: string[],
  // The size of the text subtitles, an index of `caption_sizes()`, and
  // whether a dark panel is behind them, else a shadow.
  caption_size: i32,
  caption_box: boolean,
  // The shows whose next episodes that are not watched stay downloaded, the
  // number of them as an index of `smart_counts()`, and the time of the
  // last check.
  smart: string[],
  smart_count: i32,
  smart_at: i64,
  // The requests of a media browser that wait for the server, and the
  // tracks of the album that it showed last.
  browsing: Browsing[],
  browsed: plex.Item[],
  // The texts in the language of the person.
  texts: i18n.Strings,
  // Whether a list plays in a random order, and its repeat: 0 none, 1 the
  // list, 2 the item. `sleep` is the index in `sleeps()` of the sleep timer,
  // and `sleep_at` the time that the music stops, or 0.
  shuffle: boolean,
  repeat: i32,
  sleep: i32,
  sleep_at: i64,
  // True while the screen keeps the shape of the video.
  turned: boolean,
  // True while the detail screen shows downloads: its items play from the
  // phone, and its second button removes them.
  local: boolean,
  screen: i32,
  tab: i32,
  title: string,
  scroll: i32,
  rows: i32[],
  stack: Page[],
  hubs: plex.Hub[],
  results: plex.Hub[],
  sections: plex.Section[],
  section: plex.Section,
  // The items of the library in order, with no_item in each place that no
  // page has filled yet, and the number of items on the server.
  items: plex.Item[],
  total: i32,
  // The order of the libraries as an index of plex.sorts, whether they
  // show only the items not watched, and the first letters of the titles
  // of the library that shows.
  sort: i32,
  unwatched: boolean,
  letters: plex.Letter[],
  item: plex.Item,
  children: plex.Item[],
  query: string,
  typing: boolean,
  search_at: i64,
  error: string,
  api: Option[Call],
  asks: Ask[],
  img: Option[Batch],
  cache: Map[string, draw.Image],
  cached: string[],
  failed: string[],
  report: Option[Call],
  reports: Ask[],
  // What the server did not hear because no server answered: per item,
  // that it was watched, or the place where its play stopped.
  pending: Pending[],
  play: Play,
  press: Press,
  // The item of the menu that a held finger on a poster opened, or no_item.
  menu: plex.Item,
  // The action of the node that the D-pad of a TV remote has focused, or
  // "" while the app takes touches.
  focus: string,
  // True once the app asked for the permission to post notifications.
  asked_notifications: boolean,
  // The users of the Plex Home of the account, the user whose PIN the
  // keypad asks for, or "", and the digits typed so far.
  users: plex.HomeUser[],
  pin_for: string,
  pin_digits: string,
  nodes: scene.Node[],
  dirty: boolean,
  // The painter draws on the window, and `paint` is true when the nodes
  // wait for the next vsync.
  gpu: boolean,
  paint: boolean,
  fling: Fling,
  // The downloads of items, and the last time that the app read their
  // progress.
  downloads: Saved[],
  downloads_at: i64,
  // True from a request that reached no server to the next reply of one.
  offline: boolean,
}

// A download of an item: the ID that Android gave, the item as the server
// sent it, the name of its file, and its last state.
pub struct Saved { id: i64, item: plex.Item, file: string, status: i32, done: i64, total: i64 }

// The time between two reads of the progress of the downloads.
const DOWNLOAD_MS: i64 = 1000i64;

// The images that the app keeps decoded, and the most that one batch fetches.
const CACHE_SIZE: i32 = 160;

const BATCH: i32 = 6;

const PAGE_SIZE: i32 = 60;

// The time between two checks of a PIN, and between two reports of the
// position of the playback.
const PIN_MS: i64 = 2000i64;

const REPORT_MS: i64 = 10000i64;

// The time after the last key before a search starts.
const SEARCH_MS: i64 = 700i64;

// --- settings

function no_section(): plex.Section {
  return plex.Section { key: "", kind: "", title: "" };
}

function no_server(): plex.Server {
  return plex.Server { name: "", id: "", token: "", owned: false, connections: [] };
}

function no_play(): Play {
  return Play { active: false, item: plex.no_item(), stream: plex.Stream { url: "", transcode: false, offset_ms: 0i64 }, session: "", prepared: false, paused: false, video: false, overlay: false, drawn: false, controls_until: 0i64, buffering: false, position: 0i64, duration: 0i64, reported_at: 0i64, updated_at: 0i64, retried: false, status: "", queue: [], album: [], bif: None, scrub_ms: -1i64, scrub_seek_at: 0i64, thumb_index: -1, thumb: None, level: 0, stalls: [], choice: plex.no_choice(), cues: [], sheet: false, images: [], delay_ms: 0i64, up_next_at: 0i64, next_off: false, tap_at: -1000i64, tap_x: 0, tap_overlay: false, badge: "", badge_until: 0i64, gesture: 0, gesture_from: 0, gesture_level: -1, gesture_max: 0, light: -1, next: plex.no_item(), next_queue: [], next_stream: plex.Stream { url: "", transcode: false, offset_ms: 0i64 }, next_session: "", next_ready: false, next_plan: "", next_tried: "", focus_paused: false, held: false };
}

function no_press(): Press {
  return Press { active: false, x0: 0.0, y0: 0.0, x: 0.0, y: 0.0, axis: 0, group: "", scroll0: 0, row0: 0, xs: [], ys: [], caught: false };
}

// The value of `key` in the lines of `key=value` of `text`, or "".
pub function setting(text: string, key: string): string {
  for line in text.split("\n") {
    if (line.starts_with(key + "=")) {
      return line.split_at(key.len() + 1).1;
    }
  }
  return "";
}

pub function num64(s: string): i64 {
  let v = 0i64;
  for c in s.bytes() {
    if (c < 48u8 || c > 57u8) {
      return v;
    }
    v = v * 10i64 + (c - 48u8) as i64;
  }
  return v;
}

pub function num(s: string): i32 {
  let v = 0;
  for c in s.bytes() {
    if (c < 48u8 || c > 57u8) {
      return v;
    }
    v = v * 10 + (c - 48u8) as i32;
  }
  return v;
}

function hex_id(dev: Device): string {
  let digits = "0123456789abcdef";
  let out = "";
  for i in 0..32 {
    let d = dev.random() % 16;
    out += digits.split_at(d).1.split_at(1).0;
  }
  return out;
}

function settings_path(s: App): string {
  return s.dir + "/settings";
}

function save(s: App): void {
  if (s.dir.len() == 0) {
    return;
  }
  let lines = [
    "id=" + s.client.id,
    "token=" + s.client.token,
    "account=" + s.account,
    "server_name=" + s.server.name,
    "server_id=" + s.server.id,
    "server_token=" + s.base.token,
    "server_uri=" + s.base.uri,
    "quality=" + s.quality.to_string(),
    "speed=" + s.speed.to_string(),
    "lang=" + s.lang,
    "subs=" + s.subs.to_string(),
    "account_lang=" + s.account_lang,
    "account_subs=" + s.account_subs.to_string(),
    "picked=" + s.picked.join(","),
    "caption_size=" + s.caption_size.to_string(),
    "caption_box=" + (if (s.caption_box) { "1" } else { "0" }),
    "smart=" + s.smart.join(","),
    "smart_count=" + s.smart_count.to_string(),
    "shuffle=" + (if (s.shuffle) { "1" } else { "0" }),
    "repeat=" + s.repeat.to_string(),
  ];
  s.dev.write(settings_path(s), lines.join("\n") + "\n");
}

// The app before its first event, with its files in `dir`. `server` and
// `token` name a server to use with no sign-in at plex.tv, or are "".
// `play` is the key of an item to open and play at once, or "", as a link
// into the app gives it.
pub function new(dev: Device, dir: string, server: string, token: string, play: string): App {
  let s = first_screen(dev, dir, server, token);
  if (play.len() == 0 || s.screen == ui.LOGIN || s.screen == ui.SERVERS) {
    return s;
  }
  return ask(s, "autoplay:" + play, Meta(play));
}

function first_screen(dev: Device, dir: string, server: string, token: string): App {
  let text = "";
  if (dir.len() > 0) {
    text = dev.read(dir + "/settings");
  }
  let id = setting(text, "id");
  if (id.len() == 0) {
    id = hex_id(dev);
  }
  let none: plex.Hub[] = [];
  let s = App {
    dev: dev, dir: dir, window: 0 as usize, w: 0, h: 0, top: 0, bottom: 0, shown: false,
    client: plex.Client { id: id, device: "Android", token: setting(text, "token") },
    server: no_server(), base: plex.Base { uri: setting(text, "server_uri"), token: setting(text, "server_token") },
    servers: [], states: [], probing: -1, probe_states: [], probe_at: 0i64, probes: [], rechecking: false, recheck_at: -100000i64, left: [], pin: plex.Pin { id: 0i64, code: "", token: "" }, pin_at: 0i64,
    account: setting(text, "account"), quality: num(setting(text, "quality")), speed: speed_of(setting(text, "speed")), lang: plex.language_code(setting(text, "lang")), subs: mode_of(setting(text, "subs")), account_lang: setting(text, "account_lang"), account_subs: mode_of(setting(text, "account_subs")), picked: listed(setting(text, "picked")), caption_size: num(setting(text, "caption_size")) % 3, caption_box: setting(text, "caption_box") != "0", smart: listed(setting(text, "smart")), smart_count: smart_index(setting(text, "smart_count")), smart_at: -SMART_MS, browsing: [], browsed: [], texts: texts.for_languages(dev.languages), shuffle: setting(text, "shuffle") == "1", repeat: num(setting(text, "repeat")) % 3, sleep: 0, sleep_at: 0i64, turned: false, local: false,
    screen: ui.LOGIN, tab: 0, title: "", scroll: 0, rows: [], stack: [],
    hubs: none, results: none, sections: [], section: no_section(), items: [], total: 0, sort: 0, unwatched: false, letters: [], item: plex.no_item(), children: [],
    query: "", typing: false, search_at: 0i64, error: "",
    api: None, asks: [], img: None, cache: map_new(64), cached: [], failed: [], report: None, reports: [], pending: load_pending(dev, dir),
    play: no_play(), press: no_press(), menu: plex.no_item(), focus: "", asked_notifications: false, users: [], pin_for: "", pin_digits: "", nodes: [], dirty: true, gpu: false, paint: false, fling: no_fling(),
    downloads: load_downloads(dev, dir), downloads_at: 0i64, offline: false,
  };
  s = App { ...s, server: plex.Server { ...no_server(), name: setting(text, "server_name"), id: setting(text, "server_id"), token: s.base.token } };
  if (s.quality < 0 || s.quality >= plex.qualities().len()) {
    s = App { ...s, quality: 0 };
  }
  if (server.len() > 0) {
    let manual = plex.manual_server(server, token);
    s = App { ...s, server: manual, base: plex.Base { uri: plex.connection_order(manual)[0], token: token } };
    save(s);
    return open_home(s);
  }
  save(s);
  if (s.base.uri.len() > 0) {
    return recheck(open_home(s));
  }
  if (s.client.token.len() > 0) {
    return open_servers(s);
  }
  return s;
}

// --- requests

// A request that the app asks for. `ask` makes it from the client and the
// server of the state, so a caller gives a value that borrows nothing.
enum Want {
  NewPin,
  CheckPin(i64),
  User,
  Resources,
  HomeUsers,
  SwitchUser(string, string),
  Sections,
  Hubs,
  Items(string, i32, i32, boolean),
  Letters(string, boolean),
  Meta(string),
  Children(string),
  Leaves(string),
  Bif(string),
  Subtitle(plex.Track),
  SelectTracks(string, plex.Choice),
  Search(string),
  Scrobble(string, boolean),
  Timeline(string, string, i64, i64, string),
  PingTranscode(string),
  StopTranscode(string),
}

function request_of(c: plex.Client, b: plex.Base, w: Want): plex.Request {
  match (w) {
    NewPin => {
      return plex.pin_request(c);
    },
    CheckPin(id) => {
      return plex.pin_check(c, id);
    },
    User => {
      return plex.user_request(c);
    },
    HomeUsers => {
      return plex.home_users(c);
    },
    SwitchUser(uuid, pin) => {
      return plex.switch_user(c, uuid, pin);
    },
    Resources => {
      return plex.resources_request(c);
    },
    Sections => {
      return plex.sections(c, b);
    },
    Hubs => {
      return plex.hubs(c, b);
    },
    Items(key, start, sort, unwatched) => {
      return plex.section_items(c, b, key, start, PAGE_SIZE, plex.sorts()[sort].param, unwatched);
    },
    Letters(key, unwatched) => {
      return plex.first_letters(c, b, key, unwatched);
    },
    Meta(key) => {
      return plex.metadata(c, b, key);
    },
    Children(key) => {
      return plex.children(c, b, key);
    },
    SelectTracks(part, choice) => {
      return plex.select_tracks(c, b, part, choice);
    },
    Bif(id) => {
      return plex.bif_request(c, b, id);
    },
    Subtitle(track) => {
      return plex.subtitle_request(c, b, track);
    },
    Leaves(key) => {
      return plex.Request { ...plex.children(c, b, key), url: b.uri + "/library/metadata/" + key + "/allLeaves" };
    },
    Search(q) => {
      return plex.search(c, b, q);
    },
    Scrobble(key, seen) => {
      return plex.scrobble(c, b, key, seen);
    },
    Timeline(key, state, at, total, session) => {
      return plex.timeline(c, b, key, state, at, total, session);
    },
    PingTranscode(session) => {
      return plex.ping_transcode(c, b, session);
    },
    StopTranscode(session) => {
      return plex.stop_transcode(c, b, session);
    }
  }
}

function ask(own s: App, purpose: string, w: Want): App {
  let req = request_of(s.client, s.base, w);
  return App { ...s, asks: s.asks.append(Ask { purpose: purpose, req: req }) };
}

// Starts the next request when no worker sends one.
function start_call(own c: Option[Call], dev: Device, next: Ask): (Option[Call], boolean) {
  match (c) {
    Some(call) => {
      return (Some(call), false);
    },
    None => {
      return (Some(Call { purpose: next.purpose, w: dev.fetch([next.req]) }), true);
    }
  }
}

function start_api(own s: App): App {
  if (s.asks.len() == 0) {
    return s;
  }
  let (api, started) = start_call(s.api, s.dev, s.asks[0]);
  if (!started) {
    return App { ...s, api: api };
  }
  return App { ...s, api: api, asks: s.asks.drop(1) };
}

struct Done { purpose: string, reply: plex.Reply }

function first_reply(rs: plex.Reply[]): plex.Reply {
  if (rs.len() == 0) {
    return plex.Reply { status: 0, body: [], error: "no reply" };
  }
  return rs[0];
}

function poll_call(own c: Option[Call]): (Option[Call], Option[Done]) {
  match (c) {
    Some(call) => {
      let Call { purpose, w } = call;
      match (w.poll()) {
        worker.Finished(rs) => {
          return (None, Some(Done { purpose: purpose, reply: first_reply(rs) }));
        },
        worker.Running(again) => {
          return (Some(Call { purpose: purpose, w: again }), None);
        }
      }
    },
    None => {
      return (None, None);
    }
  }
}

function poll_api(own s: App): App {
  let (api, done) = poll_call(s.api);
  let next = App { ...s, api: api };
  if let Some(d) = done {
    return start_api(answer(next, d.purpose, d.reply));
  }
  return start_api(next);
}

// Reports of playback go in a line of their own, so a slow report does not
// hold up the screens.
function report(own s: App, w: Want): App {
  let req = request_of(s.client, s.base, w);
  let purpose = report_purpose(w);
  // A new report of an item says more than what an old one kept.
  let t = s;
  if (purpose != "report") {
    t = without_pending(t, split_purpose(purpose).1.split(":")[1]);
  }
  return start_report(App { ...t, reports: t.reports.append(Ask { purpose: purpose, req: req }) });
}

// "report:seen:KEY" for a scrobble that marks an item watched, and
// "report:stop:KEY:AT:TOTAL" for the place where a play stopped. A report
// of another kind needs no second try.
function report_purpose(w: Want): string {
  match (w) {
    Scrobble(key, seen) => {
      return if (seen) { "report:seen:" + key } else { "report" };
    },
    Timeline(key, state, at, total, session) => {
      return if (state == "stopped") { "report:stop:" + key + ":" + at.to_string() + ":" + total.to_string() } else { "report" };
    },
    _ => {
      return "report";
    }
  }
}

function start_report(own s: App): App {
  if (s.reports.len() == 0) {
    return s;
  }
  let (r, started) = start_call(s.report, s.dev, s.reports[0]);
  if (!started) {
    return App { ...s, report: r };
  }
  return App { ...s, report: r, reports: s.reports.drop(1) };
}

function poll_report(own s: App): App {
  let (r, done) = poll_call(s.report);
  let next = App { ...s, report: r };
  if let Some(d) = done {
    if (!d.reply.ok()) {
      log.warn("plex: a report failed: " + d.reply.problem());
    }
    if (d.reply.status == 0) {
      next = keep_pending(App { ...next, offline: true }, d.purpose);
    } else if (d.reply.ok() && d.purpose.starts_with("report:seen:")) {
      let now = next.dev.mono_ms();
      next = check_smart(next, now);
    }
  }
  return start_report(next);
}

// --- what the server did not hear

function pending_path(dir: string): string {
  return dir + "/pending";
}

// The facts of the file of `dir`: a line per item with its key, 1 when it
// was watched, the place where its play stopped, and its length.
function load_pending(dev: Device, dir: string): Pending[] {
  let out: Pending[] = [];
  if (dir.len() == 0) {
    return out;
  }
  for line in dev.read(pending_path(dir)).split("\n") {
    let f = line.split("\t");
    if (f.len() == 4) {
      out = out.append(Pending { key: f[0], seen: f[1] == "1", at: num64(f[2]), total: num64(f[3]) });
    }
  }
  return out;
}

function save_pending(s: App): void {
  if (s.dir.len() == 0) {
    return;
  }
  let lines = s.pending.map((p: Pending): string => [p.key, if (p.seen) { "1" } else { "0" }, p.at.to_string(), p.total.to_string()].join("\t"));
  s.dev.write(pending_path(s.dir), lines.join("\n") + "\n");
}

function without_pending(own s: App, key: string): App {
  if (s.pending.filter((p: Pending): boolean => p.key == key).len() == 0) {
    return s;
  }
  let kept = s.pending.filter((p: Pending): boolean => p.key != key);
  let t = App { ...s, pending: kept };
  save_pending(t);
  return t;
}

// Keeps what a report that reached no server said. A watched item stays
// watched when a later stop of it fails too.
function keep_pending(own s: App, purpose: string): App {
  let f = purpose.split(":");
  if (f.len() < 3) {
    return s;
  }
  let key = f[2];
  let had = s.pending.filter((p: Pending): boolean => p.key == key);
  let seen = f[1] == "seen" || had.len() > 0 && had[0].seen;
  let at = if (f[1] == "stop" && f.len() == 5) { num64(f[3]) } else if (had.len() > 0) { had[0].at } else { 0i64 };
  let total = if (f[1] == "stop" && f.len() == 5) { num64(f[4]) } else if (had.len() > 0) { had[0].total } else { 0i64 };
  let kept = s.pending.filter((p: Pending): boolean => p.key != key).append(Pending { key: key, seen: seen, at: at, total: total });
  let t = App { ...s, pending: kept };
  save_pending(t);
  return t;
}

// Tells the server what it did not hear, now that it answers.
function send_pending(own s: App): App {
  let all = s.pending;
  let t = App { ...s, pending: [] };
  save_pending(t);
  let session = hex_id(t.dev);
  for p in all {
    if (p.seen) {
      t = report(t, Scrobble(p.key, true));
    } else {
      t = report(t, Timeline(p.key, "stopped", p.at, p.total, session));
    }
  }
  return t;
}

// --- images

function image_request(key: string): plex.Request {
  return plex.Request { method: "GET", url: key, headers: [("Accept", "image/jpeg, image/png, image/webp")], body: "" };
}

function in_flight(b: Option[Batch], key: string): boolean {
  match (b) {
    Some(batch) => {
      return batch.keys.contains(key);
    },
    None => {
      return false;
    }
  }
}

// Starts a batch of the images that the screen shows and the cache lacks.
function start_batch(own b: Option[Batch], dev: Device, keys: string[]): Option[Batch] {
  match (b) {
    Some(batch) => {
      return Some(batch);
    },
    None => {
      if (keys.len() == 0) {
        return None;
      }
      let reqs: plex.Request[] = [];
      for k in keys {
        reqs = reqs.append(image_request(k));
      }
      return Some(Batch { keys: keys, w: dev.fetch_images(reqs) });
    }
  }
}

function wanted(s: App): string[] {
  let out: string[] = [];
  for k in ui.images(s.nodes) {
    if (out.len() < BATCH && !s.cache.contains(k) && !s.failed.contains(k)) {
      out = out.append(k);
    }
  }
  return out;
}

function start_images(own s: App): App {
  let keys = wanted(s);
  return App { ...s, img: start_batch(s.img, s.dev, keys) };
}

struct Fetched { keys: string[], replies: plex.Reply[] }

function poll_batch(own b: Option[Batch]): (Option[Batch], Option[Fetched]) {
  match (b) {
    Some(batch) => {
      let Batch { keys, w } = batch;
      match (w.poll()) {
        worker.Finished(rs) => {
          return (None, Some(Fetched { keys: keys, replies: rs }));
        },
        worker.Running(again) => {
          return (Some(Batch { keys: keys, w: again }), None);
        }
      }
    },
    None => {
      return (None, None);
    }
  }
}

// Keeps a decoded image, and drops the oldest when the cache is full.
function remember(own s: App, key: string, img: draw.Image): App {
  let cache = s.cache.insert(key, img);
  let order = s.cached.append(key);
  while (order.len() > CACHE_SIZE) {
    cache = cache.remove(order[0]);
    order = order.drop(1);
  }
  return App { ...s, cache: cache, cached: order };
}

function poll_images(own s: App): App {
  let (b, done) = poll_batch(s.img);
  let next = App { ...s, img: b };
  let Some(f) = done else {
    return next;
  };
  let i = 0;
  while (i < f.keys.len()) {
    let key = f.keys[i];
    let got: Option[draw.Image] = None;
    if (i < f.replies.len() && f.replies[i].ok()) {
      let (w, h) = ui.image_size(next.nodes, key);
      if (w > 0 && h > 0) {
        got = next.dev.decode(f.replies[i].body, w, h);
      }
    }
    match (got) {
      Some(img) => {
        next = remember(next, key, img);
      },
      None => {
        next = App { ...next, failed: next.failed.append(key) };
      }
    }
    i += 1;
  }
  return App { ...next, dirty: true };
}

// --- replies

function failed(own s: App, what: string, r: plex.Reply): App {
  log.warn("plex: " + what + " failed: " + r.problem());
  return App { ...s, error: what + ": " + r.problem(), dirty: true };
}

// How soon after a race of the connections another can start.
const RECHECK_MS: i64 = 10000i64;

// Races the connections of the server that the app uses again, as Plezy
// does at each start: the address that the app saved can be one that this
// network cannot reach. The screen stays. A server with no identifier came
// from the intent, and has no other connection.
function recheck(own s: App): App {
  let now = s.dev.mono_ms();
  if (s.client.token.len() == 0 || s.server.id.len() == 0 || s.probing >= 0 || now - s.recheck_at < RECHECK_MS) {
    return s;
  }
  return ask(App { ...s, rechecking: true, recheck_at: now }, "recheck", Resources);
}

// The server list for a race again: the race of the server that the app
// uses, or nothing when plex.tv no longer lists it.
function got_recheck(own t: App, r: plex.Reply): App {
  if (!r.ok()) {
    return App { ...t, rechecking: false };
  }
  let list = plex.parse_servers(r.text());
  let at = -1;
  let states: string[] = [];
  for k in 0..list.len() {
    if (list[k].id == t.server.id) {
      at = k;
    }
    states = states.append("");
  }
  if (at < 0) {
    return App { ...t, rechecking: false };
  }
  return connect(App { ...t, servers: list, states: states }, at);
}

// Handles the reply to a request with `purpose`: the word before the first
// colon says what the request was, and the rest names its item.
function answer(own s: App, purpose: string, r: plex.Reply): App {
  let (verb, rest) = split_purpose(purpose);
  let t = App { ...s, dirty: true };
  if (verb == "pin") {
    return got_pin(t, r);
  }
  if (verb == "pincheck") {
    return got_pin_check(t, r);
  }
  if (verb == "user") {
    if (r.ok()) {
      let a = plex.parse_account(r.text());
      let u = App { ...t, account: a.name, account_lang: a.language, account_subs: a.subtitles };
      save(u);
      return u;
    }
    return t;
  }
  if (verb == "resources") {
    return got_servers(t, r);
  }
  if (verb == "recheck") {
    return got_recheck(t, r);
  }
  if (verb == "homeusers") {
    if (!r.ok()) {
      return failed(t, "the users", r);
    }
    return App { ...t, users: plex.parse_home_users(r.text()), error: "" };
  }
  if (verb == "switch") {
    return got_switch(t, rest, r);
  }
  if (verb == "bif") {
    return got_bif(t, rest, r);
  }
  if (verb == "retrack") {
    if (t.play.active && t.play.held && t.play.session == rest) {
      let ok = t.dev.play(t.play.stream.url);
      return App { ...t, play: Play { ...t.play, held: false } };
    }
    return t;
  }
  if (verb == "subfile") {
    let (key, id) = split_purpose(rest);
    if (r.ok() && t.dir.len() > 0 && saved_at(t, key) >= 0) {
      t.dev.write(download_subtitle_path(t.dir, key, id), r.text());
    }
    return t;
  }
  if (verb == "subtitle") {
    if (r.ok() && t.play.active && t.play.choice.subtitle == rest) {
      return App { ...t, play: Play { ...t.play, cues: plex.parse_cues(r.text()) }, dirty: true };
    }
    return t;
  }
  if (verb == "letters") {
    if (r.ok() && t.screen == ui.LIBRARY && rest == library_tag(t)) {
      return App { ...t, letters: plex.parse_letters(r.text()) };
    }
    return t;
  }
  if (r.status == 401 && t.client.token.len() > 0 && t.screen != ui.SERVERS) {
    return open_servers(App { ...t, error: "The server refused the sign-in. Choose a server again." });
  }
  if (!r.ok()) {
    // A request that reached no server can mean that the network changed.
    if (r.status == 0) {
      return recheck(App { ...failed(t, verb, r), offline: true });
    }
    return failed(App { ...t, offline: false }, verb, r);
  }
  let u = App { ...t, offline: false };
  if (u.pending.len() > 0) {
    u = send_pending(u);
  }
  return got_media(u, verb, rest, r);
}

function got_media(own t: App, verb: string, rest: string, r: plex.Reply): App {
  if (verb == "sections") {
    return App { ...t, sections: plex.parse_sections(r.text()), error: "" };
  }
  if (verb == "hubs") {
    return fill_channel(App { ...t, hubs: plex.parse_hubs(r.text()), error: "" });
  }
  if (verb == "items") {
    return got_items(t, rest, r);
  }
  if (verb == "playmeta") {
    return got_play_meta(t, rest, r);
  }
  if (verb == "meta") {
    if (t.screen == ui.DETAIL && t.item.key == rest) {
      if let Some(it) = plex.parse_item(r.text()) {
        return App { ...t, item: it };
      }
    }
    return t;
  }
  if (verb == "children") {
    if (t.screen == ui.DETAIL && t.item.key == rest) {
      return App { ...t, children: plex.parse_items(r.text()).items };
    }
    return t;
  }
  if (verb == "autoplay") {
    if let Some(it) = plex.parse_item(r.text()) {
      return play_detail(open_item(t, it));
    }
    return t;
  }
  if (verb == "leaves") {
    return play_first(t, plex.parse_items(r.text()).items);
  }
  if (verb == "download") {
    return got_download(t, r);
  }
  if (verb == "downloadall") {
    return download_all(t, plex.parse_items(r.text()).items);
  }
  if (verb == "browse") {
    return got_browse(t, rest, r);
  }
  if (verb == "smart") {
    return got_smart(t, rest, r);
  }
  if (verb == "search") {
    if (rest == t.query) {
      return App { ...t, results: plex.parse_hubs(r.text()), rows: [], error: "" };
    }
    return t;
  }
  return t;
}

function split_purpose(p: string): (string, string) {
  if let Some(i) = p.index_of(":") {
    return (p.split_at(i).0, p.split_at(i + 1).1);
  }
  return (p, "");
}

// The words of a request of the library that shows, in its order and with
// its filter: a reply to an older one is dropped.
function library_tag(s: App): string {
  let tag = s.section.key + ":" + s.sort.to_string();
  if (s.unwatched) {
    tag += "u";
  }
  return tag;
}

// Puts a page of the library at its place. The first page gives the total,
// and each place that no page has filled yet holds no_item.
function got_items(own t: App, rest: string, r: plex.Reply): App {
  let tag = library_tag(t) + ":";
  if (t.screen != ui.LIBRARY || !rest.starts_with(tag)) {
    return t;
  }
  let start = num(rest.split_at(tag.len()).1);
  let page = plex.parse_items(r.text());
  let items = t.items;
  let total = page.total.max(start + page.items.len());
  while (items.len() < total) {
    items = items.append(plex.no_item());
  }
  for k in 0..page.items.len() {
    items = items.with(start + k, page.items[k]);
  }
  return more_items(App { ...t, items: items, total: total });
}

// --- sign-in and servers

function got_pin(own t: App, r: plex.Reply): App {
  if (!r.ok()) {
    return failed(t, "sign-in", r);
  }
  let Some(pin) = plex.parse_pin(r.text()) else {
    return App { ...t, error: "plex.tv sent no PIN" };
  };
  return App { ...t, pin: pin, pin_at: t.dev.mono_ms() + PIN_MS, error: "" };
}

function got_pin_check(own t: App, r: plex.Reply): App {
  if (t.pin.id == 0i64) {
    return t;
  }
  if (!r.ok()) {
    if (r.status == 404) {
      return App { ...t, pin: plex.Pin { id: 0i64, code: "", token: "" }, error: "The code ran out. Sign in again." };
    }
    return App { ...t, pin_at: t.dev.mono_ms() + PIN_MS };
  }
  let Some(pin) = plex.parse_pin(r.text()) else {
    return App { ...t, pin_at: t.dev.mono_ms() + PIN_MS };
  };
  if (pin.token.len() == 0) {
    return App { ...t, pin_at: t.dev.mono_ms() + PIN_MS };
  }
  let client = t.client.with_token(pin.token);
  let u = App { ...t, client: client, pin: plex.Pin { id: 0i64, code: "", token: "" }, error: "" };
  save(u);
  log.info("plex: signed in");
  return ask(open_servers(u), "user", User);
}

// The users of the Plex Home of the account, to switch to one.
function open_users(own s: App): App {
  let title = s.texts.text("Switch user");
  return ask(App { ...push(s), screen: ui.USERS, title: title, scroll: 0, pin_for: "", pin_digits: "", dirty: true }, "homeusers", HomeUsers);
}

// A tap on user `i`: a protected user gets the keypad of the PIN first.
function pick_user(own s: App, i: i32): App {
  if (i < 0 || i >= s.users.len()) {
    return s;
  }
  let u = s.users[i];
  if (u.protected) {
    return App { ...s, pin_for: u.uuid, pin_digits: "", error: "", dirty: true };
  }
  return ask(s, "switch:" + u.title, SwitchUser(u.uuid, ""));
}

// A key of the keypad of the PIN. The fourth digit sends the PIN.
function pin_key(own s: App, key: string): App {
  if (key == "del") {
    let n = s.pin_digits.len();
    if (n == 0) {
      return s;
    }
    return App { ...s, pin_digits: s.pin_digits.take(n - 1).to_owned(), dirty: true };
  }
  if (key == "cancel") {
    return App { ...s, pin_for: "", pin_digits: "", dirty: true };
  }
  let digits = s.pin_digits + key;
  if (digits.len() < 4) {
    return App { ...s, pin_digits: digits, dirty: true };
  }
  let uuid = s.pin_for;
  let title = "";
  for u in s.users {
    if (u.uuid == uuid) {
      title = u.title;
    }
  }
  return ask(App { ...s, pin_digits: digits, dirty: true }, "switch:" + title, SwitchUser(uuid, digits));
}

// The reply of a switch: the token of the user replaces that of the
// account, and the app finds the servers of that user.
function got_switch(own t: App, title: string, r: plex.Reply): App {
  let token = "";
  if (r.ok()) {
    token = plex.parse_switch(r.text());
  }
  if (token.len() == 0) {
    let why = "The switch failed";
    if (r.status == 401 || r.status == 403) {
      why = "Wrong PIN";
    }
    return App { ...t, pin_digits: "", error: why, dirty: true };
  }
  let u = App { ...t, client: t.client.with_token(token), account: title, server: no_server(), base: plex.Base { uri: "", token: "" }, hubs: [], sections: [], results: [], users: [], pin_for: "", pin_digits: "", error: "" };
  save(u);
  log.info("plex: switched to the user " + title);
  return ask(open_servers(u), "user", User);
}

function open_servers(own s: App): App {
  let t = App { ...s, screen: ui.SERVERS, title: "Choose a server", scroll: 0, stack: [], dirty: true };
  return ask(t, "resources", Resources);
}

function got_servers(own t: App, r: plex.Reply): App {
  if (!r.ok()) {
    return failed(t, "the server list", r);
  }
  let list = plex.parse_servers(r.text());
  let states: string[] = [];
  for sv in list {
    states = states.append("");
  }
  let u = App { ...t, servers: list, states: states };
  if (list.len() == 1) {
    return connect(u, 0);
  }
  return u;
}

// How long a connection that answered waits for a better one of the same
// server, which comes before it in connection_order.
const PROBE_MS: i64 = 2000i64;

// Probes all the connections of server `i` at once. The first in
// connection_order that answers wins: a local one, then a remote one, then
// the relay of plex.tv. A connection that answered waits PROBE_MS at most
// for a better one.
function connect(own s: App, i: i32): App {
  if (i < 0 || i >= s.servers.len()) {
    return s;
  }
  let sv = s.servers[i];
  let order = plex.connection_order(sv);
  let left = probe_workers(s.probes, s.left);
  let probes: Probe[] = [];
  let states: i32[] = [];
  for k in 0..order.len() {
    probes = probes.append(Probe { conn: k, w: s.dev.fetch([plex.identity(s.client, plex.Base { uri: order[k], token: sv.token })]) });
    states = states.append(0);
  }
  let t = App { ...s, probing: i, probe_states: states, probe_at: s.dev.mono_ms(), probes: probes, left: left, states: s.states.with(i, "connecting"), dirty: true };
  if (order.len() == 0) {
    return App { ...t, probing: -1, rechecking: false, states: t.states.with(i, "unreachable") };
  }
  return t;
}

// A worker that asks connection `conn` of a server for its identity.
struct Probe { conn: i32, w: worker.Worker[plex.Reply[]] }

// The workers of `ps` after those of `left`.
function probe_workers(own ps: Probe[], own left: worker.Worker[plex.Reply[]][]): worker.Worker[plex.Reply[]][] {
  for p in ps {
    let Probe { conn, w } = p;
    left = left.append(w);
  }
  return left;
}

// The probes that still run, and the state of each connection.
function poll_probe_list(own ps: Probe[], states: i32[]): (Probe[], i32[]) {
  let running: Probe[] = [];
  let out = states;
  for p in ps {
    let Probe { conn, w } = p;
    let polled = w.poll();
    match (polled) {
      worker.Finished(rs) => {
        if (first_reply(rs).ok()) {
          out = out.with(conn, 1);
        } else {
          out = out.with(conn, 2);
        }
      },
      worker.Running(again) => {
        running = running.append(Probe { conn: conn, w: again });
      }
    }
  }
  return (running, out);
}

// The workers of a race that ended, less those that finished.
function poll_left(own ws: worker.Worker[plex.Reply[]][]): worker.Worker[plex.Reply[]][] {
  let out: worker.Worker[plex.Reply[]][] = [];
  for w in ws {
    let polled = w.poll();
    match (polled) {
      worker.Finished(rs) => {},
      worker.Running(again) => {
        out = out.append(again);
      }
    }
  }
  return out;
}

// The connection that wins: the first that answered with no better one
// that still waits, or -1. After PROBE_MS, a probe that waits counts as
// failed.
pub function winner(states: i32[], expired: boolean): i32 {
  for k in 0..states.len() {
    if (states[k] == 1) {
      return k;
    }
    if (states[k] == 0 && !expired) {
      return -1;
    }
  }
  return -1;
}

function poll_probes(own s: App): App {
  let left = poll_left(s.left);
  let (probes, states) = poll_probe_list(s.probes, s.probe_states);
  let i = s.probing;
  if (i < 0 || i >= s.servers.len()) {
    return App { ...s, probes: probes, probe_states: states, left: left };
  }
  let expired = s.dev.mono_ms() - s.probe_at >= PROBE_MS;
  let k = winner(states, expired);
  if (k < 0 && probes.len() == 0) {
    log.info("plex: no answer from " + s.servers[i].name);
    return App { ...s, probes: probes, probe_states: states, left: left, probing: -1, rechecking: false, states: s.states.with(i, "unreachable"), dirty: true };
  }
  if (k < 0) {
    return App { ...s, probes: probes, probe_states: states, left: left };
  }
  let sv = s.servers[i];
  let order = plex.connection_order(sv);
  let rest = probe_workers(probes, left);
  // A race again keeps the screen when the address that won works already,
  // or when nothing failed and the user is away from the home screen.
  let quiet = s.rechecking && s.error.len() == 0;
  let same = order[k] == s.base.uri;
  let home = s.screen == ui.HOME;
  let u = App { ...s, probing: -1, probes: [], probe_states: states, left: rest, rechecking: false, server: sv, base: plex.Base { uri: order[k], token: sv.token }, states: s.states.with(i, "connected"), error: "" };
  if (quiet && same) {
    return u;
  }
  save(u);
  log.info("plex: connected to " + sv.name + " at connection " + k.to_string());
  if (quiet && !home) {
    return u;
  }
  return open_home(u);
}

// --- navigation

function open_home(own s: App): App {
  let title = s.server.name;
  let t = App { ...s, screen: ui.HOME, tab: 0, title: title, scroll: 0, rows: [], stack: [], items: [], children: [], dirty: true };
  return ask(ask(t, "hubs", Hubs), "sections", Sections);
}

function page_of(s: App): Page {
  return Page { screen: s.screen, title: s.title, scroll: s.scroll, rows: s.rows, items: s.items, total: s.total, section: s.section, item: s.item, children: s.children, local: s.local };
}

function push(own s: App): App {
  let stack = s.stack.append(page_of(s));
  return App { ...s, stack: stack };
}

function restore(own s: App, p: Page): App {
  return App { ...s, screen: p.screen, title: p.title, scroll: p.scroll, rows: p.rows, items: p.items, total: p.total, section: p.section, item: p.item, children: p.children, local: p.local, dirty: true };
}

function pop(own s: App): App {
  if (s.stack.len() == 0) {
    return s;
  }
  let p = s.stack[s.stack.len() - 1];
  let stack = s.stack.take(s.stack.len() - 1);
  return restore(App { ...s, stack: stack }, p);
}

function open_tab(own s: App, tab: i32): App {
  if (tab < 0 || tab >= ui.tab_screens().len()) {
    return s;
  }
  let screen = ui.tab_screens()[tab];
  s.dev.hide_field();
  let title = [s.server.name, "Libraries", "Search", "Settings"][tab];
  let need_hubs = screen == ui.HOME && s.hubs.len() == 0;
  let need_sections = screen == ui.SECTIONS && s.sections.len() == 0;
  let t = App { ...s, screen: screen, tab: tab, title: title, scroll: 0, rows: [], stack: [], typing: false, dirty: true };
  if (need_hubs) {
    return ask(t, "hubs", Hubs);
  }
  if (need_sections) {
    return ask(t, "sections", Sections);
  }
  return t;
}

function open_section(own s: App, i: i32): App {
  if (i < 0 || i >= s.sections.len()) {
    return s;
  }
  let sec = s.sections[i];
  return reload_library(App { ...push(s), screen: ui.LIBRARY, title: sec.title, section: sec });
}

// Shows the library from its start in the order and with the filter of
// the state. The title order also asks for the first letters of the
// titles, for the letter strip.
function reload_library(own s: App): App {
  let t = more_items(App { ...s, items: [], total: 0, letters: [], scroll: 0, dirty: true });
  if (t.sort != 0) {
    return t;
  }
  let key = t.section.key;
  let unwatched = t.unwatched;
  let purpose = "letters:" + library_tag(t);
  return ask(t, purpose, Letters(key, unwatched));
}

// The places of the items that the screen shows, from one screen above it
// to one screen below it.
function visible_items(s: App): (i32, i32) {
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let (cols, w) = ui.grid(m);
  let ch = ui.card_height(m, w) + 12 * m.u;
  let screen = (ui.content_bottom(m, s.screen) - ui.content_top(m)).max(ch);
  let first = (s.scroll - screen).max(0) / ch * cols;
  let last = ((s.scroll + 2 * screen) / ch + 1) * cols;
  return (first, last);
}

// Asks for the page of the first place near the screen that no page has
// filled, unless a request for it waits.
function more_items(own s: App): App {
  if (s.screen != ui.LIBRARY) {
    return s;
  }
  let start = -1;
  if (s.total == 0 && s.items.len() == 0) {
    start = 0;
  } else {
    let (first, last) = visible_items(s);
    let k = first;
    while (k < last.min(s.total) && start < 0) {
      if (k >= s.items.len() || s.items[k].key.len() == 0) {
        start = k / PAGE_SIZE * PAGE_SIZE;
      }
      k += 1;
    }
  }
  if (start < 0) {
    return s;
  }
  let purpose = "items:" + library_tag(s) + ":" + start.to_string();
  for a in s.asks {
    if (a.purpose == purpose) {
      return s;
    }
  }
  if (has_call(s.api, purpose)) {
    return s;
  }
  let key = s.section.key;
  let sort = s.sort;
  let unwatched = s.unwatched;
  return ask(s, purpose, Items(key, start, sort, unwatched));
}

// Scrolls the library to the first item of letter `i` of the strip.
function jump_to_letter(own s: App, i: i32): App {
  if (i < 0 || i >= s.letters.len()) {
    return s;
  }
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let (cols, w) = ui.grid(m);
  let ch = ui.card_height(m, w) + 12 * m.u;
  let at = plex.letter_offset(s.letters, i);
  let next = clamp(at / cols * ch, 0, scroll_limit(s, m));
  return more_items(App { ...s, scroll: next, fling: no_fling(), dirty: true });
}

function has_call(c: Option[Call], purpose: string): boolean {
  match (c) {
    Some(call) => {
      return call.purpose == purpose;
    },
    None => {
      return false;
    }
  }
}

function open_item(own s: App, it: plex.Item): App {
  if (it.key.len() == 0) {
    return s;
  }
  let u = ask(App { ...push(s), screen: ui.DETAIL, title: plex.card_title(it), item: it, children: [], scroll: 0, local: false, dirty: true }, "meta:" + it.key, Meta(it.key));
  if (it.kind == "show" || it.kind == "season" || it.kind == "artist" || it.kind == "album") {
    return ask(u, "children:" + it.key, Children(it.key));
  }
  return u;
}

function item_at(s: App, act: string): Option[plex.Item] {
  let parts = act.split(":");
  if (parts[0] == "hub" && parts.len() == 3) {
    let hubs = shown_hubs(s);
    let i = num(parts[1]);
    let j = num(parts[2]);
    if (i < hubs.len() && j < hubs[i].items.len()) {
      return Some(hubs[i].items[j]);
    }
  }
  if (parts[0] == "grid" && parts.len() == 2 && num(parts[1]) < s.items.len()) {
    return Some(s.items[num(parts[1])]);
  }
  if (parts[0] == "child" && parts.len() == 2 && num(parts[1]) < s.children.len()) {
    return Some(s.children[num(parts[1])]);
  }
  return None;
}

// Plays the item of the detail screen: the item itself, the first episode
// of a season that the user has not seen, or that of a show.
function play_detail(own s: App): App {
  let it = s.item;
  if (plex.playable_kind(it.kind)) {
    return start_play(s, it, []);
  }
  // The children of a show are seasons, and the children of an artist are
  // albums, so the server gives all of their episodes or tracks.
  if (it.kind == "show" || it.kind == "artist") {
    return ask(s, "leaves:" + it.key, Leaves(it.key));
  }
  let children = s.children;
  return play_first(s, children);
}

// Plays the first episode not watched, and the rest after it. Music starts
// at its first track.
function play_first(own s: App, items: plex.Item[]): App {
  if (items.len() > 0 && items[0].kind == "track") {
    return play_list(s, items, 0);
  }
  let i = 0;
  while (i < items.len()) {
    if (plex.playable_kind(items[i].kind) && !plex.watched(items[i])) {
      return play_list(s, items, i);
    }
    i += 1;
  }
  if (items.len() > 0 && plex.playable_kind(items[0].kind)) {
    return play_list(s, items, 0);
  }
  return App { ...s, error: "Nothing to play" };
}

// Plays item `i` of `items`, and then the items after it. With shuffle,
// the items after it play in a random order. A track starts its album at
// the start, so that shuffle and repeat take the whole album.
function play_list(own s: App, items: plex.Item[], i: i32): App {
  let first = items[i];
  let rest = items.drop(i + 1);
  if (s.shuffle) {
    rest = shuffled(s.dev, items.filter((it: plex.Item): boolean => it.key != first.key));
  }
  let t = start_play(s, first, rest);
  return App { ...t, play: Play { ...t.play, album: items } };
}

// The items in a random order.
function shuffled(dev: Device, items: plex.Item[]): plex.Item[] {
  let out = items;
  let k = out.len() - 1;
  while (k > 0) {
    let j = dev.random() % (k + 1);
    let a = out[k];
    out = out.with(k, out[j]).with(j, a);
    k -= 1;
  }
  return out;
}

// The items of the album after `it`, in the order of the album.
function after_in(album: plex.Item[], it: plex.Item): plex.Item[] {
  let i = 0;
  while (i < album.len() && album[i].key != it.key) {
    i += 1;
  }
  return album.drop(i + 1);
}

// Shuffle on gives the items that have not played a random order. Shuffle
// off gives them the order of the album again.
function toggle_shuffle(own s: App): App {
  let on = !s.shuffle;
  let p = s.play;
  let queue = p.queue;
  if (p.active && p.album.len() > 0) {
    if (on) {
      queue = shuffled(s.dev, queue);
    } else {
      queue = after_in(p.album, p.item);
    }
  }
  let t = App { ...s, shuffle: on, play: Play { ...p, queue: queue }, dirty: true };
  save(t);
  return t;
}

function cycle_repeat(own s: App): App {
  let t = App { ...s, repeat: (s.repeat + 1) % 3, dirty: true };
  save(t);
  return t;
}

// The choices of the sleep timer in minutes. -1 stops at the end of the
// track that plays.
pub function sleeps(): i32[] {
  return [0, 15, 30, 60, -1];
}

function cycle_sleep(own s: App): App {
  let next = (s.sleep + 1) % sleeps().len();
  let minutes = sleeps()[next];
  let at = 0i64;
  if (minutes > 0) {
    at = s.dev.mono_ms() + minutes as i64 * 60000i64;
  }
  return App { ...s, sleep: next, sleep_at: at, dirty: true };
}

// The words of the repeat and the sleep buttons.
function repeat_text(texts: i18n.Strings, repeat: i32): string {
  if (repeat == 1) {
    return texts.text("REPEAT ALL");
  }
  if (repeat == 2) {
    return texts.text("REPEAT ONE");
  }
  return texts.text("REPEAT OFF");
}

function sleep_text(texts: i18n.Strings, sleep: i32): string {
  let minutes = sleeps()[sleep];
  if (minutes == 0) {
    return texts.text("SLEEP OFF");
  }
  if (minutes < 0) {
    return texts.text("SLEEP AT END");
  }
  return texts.format("SLEEP {0} MIN", [minutes.to_string()]);
}

function toggle_watched(own s: App): App {
  let it = s.item;
  let now = !plex.watched(it);
  return ask(App { ...s, item: plex.marked(it, now), dirty: true }, "scrobble", Scrobble(it.key, now));
}

// How long a finger rests on a poster before its menu opens.
const HOLD_MS: i64 = 500i64;

// The time that the finger of a press that may hold came down, or -1.
function hold_from(s: App): i64 {
  let p = s.press;
  if (!p.active || p.axis != 0 || p.caught || p.xs.len() == 0 || s.menu.key.len() > 0 || s.screen == ui.PLAYER) {
    return -1i64;
  }
  return p.xs[0].t / 1000000i64;
}

// Opens the menu of the poster under a finger that rests there for
// HOLD_MS. The press ends, so the lift of the finger opens nothing.
function hold_tick(own s: App, now: i64): App {
  let from = hold_from(s);
  if (from < 0i64 || now - from < HOLD_MS) {
    return s;
  }
  let Some(n) = scene.hit(s.nodes, s.press.x0 as i32, s.press.y0 as i32) else {
    return s;
  };
  let Some(it) = item_at(s, n.tap.name) else {
    return s;
  };
  // A card of the downloads holds downloads, and its detail removes them.
  if (it.key.len() == 0 || s.screen == ui.DOWNLOADS || s.local) {
    return s;
  }
  return App { ...s, press: no_press(), menu: it, dirty: true };
}

// Puts the item `it` in place of the item with its key, in each list that
// shows it.
function replace_item(own s: App, it: plex.Item): App {
  function swap(list: plex.Item[]): plex.Item[] {
    let out: plex.Item[] = [];
    for x in list {
      if (x.key == it.key) {
        out = out.append(it);
      } else {
        out = out.append(x);
      }
    }
    return out;
  }
  let hubs: plex.Hub[] = [];
  for h in s.hubs {
    hubs = hubs.append(plex.Hub { ...h, items: swap(h.items) });
  }
  let results: plex.Hub[] = [];
  for h in s.results {
    results = results.append(plex.Hub { ...h, items: swap(h.items) });
  }
  return App { ...s, hubs: hubs, results: results, items: swap(s.items), children: swap(s.children), dirty: true };
}

// --- downloads

function downloads_path(dir: string): string {
  return dir + "/downloads";
}

function download_meta_path(dir: string, key: string): string {
  return dir + "/download-" + key + ".json";
}

// The file that keeps the text of the subtitle track `id` of the download
// of the item `key`.
function download_subtitle_path(dir: string, key: string, id: string): string {
  return dir + "/download-" + key + "-" + id + ".sub";
}

// The downloads that the files of `dir` list. Each line of the list holds
// the ID, the key, the file, the status and the place to play from. The
// metadata of each item is in a file of its own.
function load_downloads(dev: Device, dir: string): Saved[] {
  let out: Saved[] = [];
  if (dir.len() == 0) {
    return out;
  }
  for line in dev.read(downloads_path(dir)).split("\n") {
    let f = line.split("\t");
    if (f.len() == 5) {
      if let Some(it) = plex.parse_item(dev.read(download_meta_path(dir, f[1]))) {
        let held = plex.file_item(it, plex.transcoded_file(it, f[2]));
        out = out.append(Saved { id: num64(f[0]), item: plex.Item { ...held, offset_ms: num64(f[4]) }, file: f[2], status: num(f[3]), done: 0i64, total: -1i64 });
      }
    }
  }
  return out;
}

function save_downloads(s: App): void {
  if (s.dir.len() == 0) {
    return;
  }
  let lines: string[] = [];
  for d in s.downloads {
    lines = lines.append([d.id.to_string(), d.item.key, d.file, d.status.to_string(), d.item.offset_ms.to_string()].join("\t"));
  }
  s.dev.write(downloads_path(s.dir), lines.join("\n") + "\n");
}

// The index of the download of the item `key`, or -1.
function saved_at(s: App, key: string): i32 {
  for i in 0..s.downloads.len() {
    if (s.downloads[i].item.key == key) {
      return i;
    }
  }
  return -1;
}

// The part of the download of the item `key` that came, in percent: 100
// once it is done, or -1 when the item has no download.
// The row of the download `d` on the screen of the downloads.
function saved_row(s: App, d: Saved): ui.SavedRow {
  let state = s.texts.text("Waiting");
  if (d.status == download.DONE) {
    state = s.texts.text("Done");
  } else if (d.status == download.FAILED) {
    state = s.texts.text("The download failed");
  } else if (d.status == download.PAUSED) {
    state = s.texts.text("Paused");
  } else if (d.status == download.RUNNING) {
    state = download_percent(s, d.item.key).to_string() + "%";
  }
  return ui.SavedRow { title: plex.card_title(d.item), detail: plex.episode_line(d.item), state: state, done: d.status == download.DONE, at: -1 };
}

// The rows of the downloads that are not done, under the cards of the
// downloads that are.
function waiting_rows(s: App): ui.SavedRow[] {
  let out: ui.SavedRow[] = [];
  for at in 0..s.downloads.len() {
    if (s.downloads[at].status != download.DONE) {
      out = out.append(ui.SavedRow { ...saved_row(s, s.downloads[at]), at: at });
    }
  }
  return out;
}

function download_percent(s: App, key: string): i32 {
  let at = saved_at(s, key);
  if (at < 0) {
    return -1;
  }
  let d = s.downloads[at];
  if (d.status == download.DONE) {
    return 100;
  }
  if (d.total <= 0i64) {
    return 0;
  }
  return clamp((d.done * 100i64 / d.total) as i32, 0, 99);
}

// True while a download is not done.
function downloading(s: App): boolean {
  return s.downloads.filter((d: Saved): boolean => d.status != download.DONE).len() > 0;
}

// True when the play reads a downloaded file.
function on_disk(p: Play): boolean {
  return p.stream.url.starts_with("file://");
}

// The home screen with no server and with downloads that play: it shows
// a note in place of the error of the connection.
function offline_home(s: App): boolean {
  return s.offline && s.screen == ui.HOME && s.downloads.filter((d: Saved): boolean => d.status == download.DONE).len() > 0;
}

// The rows of the screen: on the home screen, the downloads that are done
// come last, so the rows of the server keep their places.
function shown_hubs(s: App): plex.Hub[] {
  if (s.screen == ui.SEARCH) {
    return s.results;
  }
  let done = s.downloads.filter((d: Saved): boolean => d.status == download.DONE).map((d: Saved): plex.Item => d.item);
  if (s.screen == ui.DOWNLOADS) {
    return saved_hubs(s, done);
  }
  if (s.screen != ui.HOME || done.len() == 0) {
    return s.hubs;
  }
  let row = plex.Hub { title: s.texts.text("Downloads"), ident: "downloads", items: done };
  // With no server, the rows of the server are old, and only the
  // downloads play.
  if (s.offline) {
    return [row];
  }
  return s.hubs.append(row);
}

// The place of `x` in `xs`, or -1.
function position_of(xs: string[], x: string): i32 {
  for k in 0..xs.len() {
    if (xs[k] == x) {
      return k;
    }
  }
  return -1;
}

// The rows of the screen of the downloads: a card for each show, each
// movie and each album.
function saved_hubs(s: App, done: plex.Item[]): plex.Hub[] {
  let cards = plex.shelves(done).map((sh: plex.Shelf): plex.Item => sh.card);
  let out: plex.Hub[] = [];
  for (title, kinds) in [("SHOWS", ["show"]), ("MOVIES", ["movie"]), ("MUSIC", ["album", "track"])] {
    let row = cards.filter((c: plex.Item): boolean => position_of(kinds, c.kind) >= 0);
    if (row.len() > 0) {
      out = out.append(plex.Hub { title: s.texts.text(title), ident: "saved-" + title, items: row });
    }
  }
  let rest = cards.filter((c: plex.Item): boolean => c.kind != "show" && c.kind != "movie" && c.kind != "album" && c.kind != "track");
  if (rest.len() > 0) {
    out = out.append(plex.Hub { title: s.texts.text("Downloads"), ident: "saved-other", items: rest });
  }
  return out;
}

// Opens the detail screen of the card `card` of the downloads. Its items
// come from the phone. With a server, the metadata of a card that the
// server knows gives the synopsis.
function open_saved(own s: App, card: plex.Item): App {
  let done = s.downloads.filter((d: Saved): boolean => d.status == download.DONE).map((d: Saved): plex.Item => d.item);
  let children: plex.Item[] = [];
  for sh in plex.shelves(done) {
    if (sh.card.key == card.key && card.kind != "movie" && card.kind != "episode") {
      children = sh.items;
    }
  }
  let no_meta = s.offline || plex.app_key(card.key);
  let t = App { ...push(s), screen: ui.DETAIL, title: plex.card_title(card), item: card, children: children, scroll: 0, local: true, dirty: true };
  if (no_meta) {
    return t;
  }
  return ask(t, "meta:" + card.key, Meta(card.key));
}

// Plays the item of a detail screen of the downloads: the first episode
// not seen, or the first track, with the items after it as the queue.
function play_saved(own s: App): App {
  let it = s.item;
  let children = s.children;
  if (children.len() == 0) {
    return start_play(s, it, []);
  }
  let at = -1;
  for k in 0..children.len() {
    if (at < 0 && !(it.kind == "show" && plex.watched(children[k]))) {
      at = k;
    }
  }
  if (at < 0) {
    at = 0;
  }
  return start_play(s, children[at], children.drop(at).drop(1));
}

// Removes the downloads of the detail screen of the downloads, and goes
// back.
function remove_saved(own s: App): App {
  let keys = s.children.map((it: plex.Item): string => it.key);
  if (keys.len() == 0) {
    keys = [s.item.key];
  }
  let t = s;
  for key in keys {
    let at = saved_at(t, key);
    if (at >= 0) {
      t = drop_download(t, at);
    }
  }
  return pop(t);
}

// Starts the download of the item of the metadata `r`. A file that the
// phone does not play as it is downloads as a transcode at the quality of
// the settings.
function got_download(own t: App, r: plex.Reply): App {
  let Some(it) = plex.parse_item(r.text()) else {
    return t;
  };
  if (saved_at(t, it.key) >= 0 || !plex.playable_kind(it.kind)) {
    return t;
  }
  // A download plays the sound that the server remembers.
  let direct = plex.direct_with(it, t.dev.decoders, plex.remembered(it));
  let name = plex.download_name(it, !direct);
  let req = if (direct) { plex.download_request(t.client, t.base, it) } else { plex.download_transcode_request(t.client, t.base, it, plex.qualities()[t.quality], hex_id(t.dev), t.dev.decoders, plex.remembered(it)) };
  let id = t.dev.download(req, name, plex.full_title(it));
  if (id < 0i64) {
    return App { ...t, error: "Android refused the download" };
  }
  if (t.dir.len() > 0) {
    t.dev.write(download_meta_path(t.dir, it.key), r.text());
  }
  let held = plex.file_item(it, !direct);
  let u = App { ...t, downloads: t.downloads.append(Saved { id: id, item: held, file: name, status: download.PENDING, done: 0i64, total: -1i64 }), downloads_at: 0i64, error: "" };
  save_downloads(u);
  // The text of each subtitle comes with the file, so it shows with no
  // server.
  for track in plex.subtitle_tracks(held) {
    u = ask(u, "subfile:" + held.key + ":" + track.id, Subtitle(track));
  }
  return u;
}

// An item of the channel row of Android TV: its key, title and kind, and
// the address of its poster.
pub struct Card { key: string, title: string, kind: string, poster: string }

// The channel row on Android TV shows the items that came to the server
// last: the rows of the home screen that the server names "recent". The
// row of the items to go on with is Watch Next, so it is not in the channel.
function fill_channel(own t: App): App {
  let recent = t.hubs.filter((h: plex.Hub): boolean => h.ident.contains("recent"));
  let items: plex.Item[] = [];
  for h in recent {
    for it in h.items {
      if (items.len() < CHANNEL_ITEMS) {
        items = items.append(it);
      }
    }
  }
  if (items.len() > 0) {
    t.dev.channel(items.map((it: plex.Item): Card => Card { key: it.key, title: plex.card_title(it), kind: it.kind, poster: plex.image_url(t.base, plex.poster(it), 400, 600) }));
  }
  return t;
}

const CHANNEL_ITEMS: i32 = 20;

// Asks for the metadata of each item of `items` that plays and has no
// download, and downloads it: all of the episodes of a show or a season,
// or all of the tracks of an artist or an album.
function download_all(own t: App, items: plex.Item[]): App {
  for it in items {
    if (plex.playable_kind(it.kind) && saved_at(t, it.key) < 0) {
      t = ask(t, "download:" + it.key, Meta(it.key));
    }
  }
  return t;
}

// --- the media browser of Android Auto

// A request of a media browser for the items under the item `parent`.
struct Browsing { parent: string, req: browse.Request }

// The items of the root: each music library, and the downloaded music.
pub function browse_root(sections: plex.Section[], saved: plex.Item[], downloads: string): browse.Item[] {
  let out: browse.Item[] = [];
  for sec in sections {
    if (sec.kind == "artist") {
      out = out.append(browse.Item { id: "section:" + sec.key, title: sec.title, subtitle: "", playable: false });
    }
  }
  if (saved.any((it: plex.Item): boolean => it.kind == "track")) {
    out = out.append(browse.Item { id: "downloads", title: downloads, subtitle: "", playable: false });
  }
  return out;
}

// The browser items of the items of the server: an artist or an album
// opens, and a track plays.
pub function browse_items(items: plex.Item[]): browse.Item[] {
  let out: browse.Item[] = [];
  for it in items {
    if (it.kind == "track") {
      out = out.append(browse.Item { id: "track:" + it.key, title: it.title, subtitle: it.grandparent, playable: true });
    } else if (it.kind == "artist" || it.kind == "album") {
      out = out.append(browse.Item { id: it.kind + ":" + it.key, title: it.title, subtitle: it.parent, playable: false });
    }
  }
  return out;
}

function browse_event(own s: App, b: browse.Event): App {
  match (b) {
    browse.Connected(svc) => {
      s.dev.browse_connect(svc);
      return s;
    },
    browse.Asked(req) => {
      let parent = s.dev.browse_parent(req);
      return browse_asked(s, parent, req);
    },
    browse.PlayFrom(m) => {
      let id = s.dev.media_id(m);
      return browse_play(s, id);
    }
  }
}

// Answers a request at once from what the app has, or asks the server and
// answers when it replies.
function browse_asked(own s: App, parent: string, req: browse.Request): App {
  let saved = s.downloads.filter((d: Saved): boolean => d.status == download.DONE).map((d: Saved): plex.Item => d.item);
  if (parent == browse.ROOT && (s.sections.len() > 0 || s.base.uri.len() == 0)) {
    let ok = s.dev.browse_answer(req, browse_root(s.sections, saved, s.texts.text("Downloads")));
    return s;
  }
  if (parent == "downloads" || s.base.uri.len() == 0) {
    let ok = s.dev.browse_answer(req, browse_items(saved.filter((it: plex.Item): boolean => it.kind == "track")));
    return s;
  }
  let (kind, key) = split_purpose(parent);
  let want = if (parent == browse.ROOT) { Sections } else if (kind == "section") { Items(key, 0, 0, false) } else { Children(key) };
  let t = App { ...s, browsing: s.browsing.append(Browsing { parent: parent, req: req }) };
  return ask(t, "browse:" + parent, want);
}

// The reply of the server to the request of the browser for `parent`.
function got_browse(own t: App, parent: string, r: plex.Reply): App {
  let waiting = t.browsing.filter((b: Browsing): boolean => b.parent == parent);
  let u = App { ...t, browsing: t.browsing.filter((b: Browsing): boolean => b.parent != parent) };
  let items: browse.Item[] = [];
  if (r.ok() && parent == browse.ROOT) {
    let sections = plex.parse_sections(r.text());
    items = browse_root(sections, [], u.texts.text("Downloads"));
    u = App { ...u, sections: sections };
  } else if (r.ok()) {
    let got = plex.parse_items(r.text()).items;
    items = browse_items(got);
    if (got.any((it: plex.Item): boolean => it.kind == "track")) {
      u = App { ...u, browsed: got };
    }
  }
  for b in waiting {
    let ok = u.dev.browse_answer(b.req, items);
  }
  return u;
}

// Plays the track `id` of a browser, with the tracks of its album after it.
function browse_play(own s: App, id: string): App {
  let (kind, key) = split_purpose(id);
  if (kind != "track") {
    return s;
  }
  let at = position_of(s.browsed.map((it: plex.Item): string => it.key), key);
  if (at >= 0) {
    let tracks = s.browsed;
    return play_list(s, tracks, at);
  }
  let saved = saved_at(s, key);
  if (saved >= 0) {
    let it = s.downloads[saved].item;
    return start_play(s, it, []);
  }
  return ask(s, "autoplay:" + key, Meta(key));
}

// The numbers of episodes that a smart download keeps.
pub function smart_counts(): i32[] {
  return [1, 3, 5, 10];
}

// The index of `smart_counts()` in the settings file, or the one of 3.
function smart_index(text: string): i32 {
  if (text.len() == 0) {
    return 1;
  }
  return num(text) % smart_counts().len();
}

// The time between two checks of the smart downloads.
const SMART_MS: i64 = 1800000i64;

// Asks for the episodes of each show of the smart downloads.
function check_smart(own s: App, now: i64): App {
  if (s.base.uri.len() == 0 || s.offline) {
    return s;
  }
  let t = App { ...s, smart_at: now };
  for show in s.smart {
    t = ask(t, "smart:" + show, Leaves(show));
  }
  return t;
}

function smart_tick(own s: App, now: i64): App {
  if (s.smart.len() == 0 || now - s.smart_at < SMART_MS) {
    return s;
  }
  return check_smart(s, now);
}

// The episodes of the show `show`: the next ones that are not watched
// download, and the downloads of the watched ones go. The file that plays
// stays.
function got_smart(own t: App, show: string, r: plex.Reply): App {
  if (!r.ok() || !t.smart.contains(show)) {
    return t;
  }
  let episodes = plex.parse_items(r.text()).items;
  let wanted = episodes.filter((it: plex.Item): boolean => it.views == 0).take(smart_counts()[t.smart_count]);
  let u = download_all(t, wanted);
  for it in episodes {
    let at = saved_at(u, it.key);
    let playing = u.play.active && u.play.item.key == it.key;
    if (it.views > 0 && at >= 0 && !playing) {
      log.info("plex: the smart download of " + it.key + " was watched");
      u = drop_download(u, at);
    }
  }
  return u;
}

// Turns the smart downloads of the show `show` on or off.
function toggle_smart(own s: App, show: string): App {
  if (s.smart.contains(show)) {
    let off = App { ...s, smart: s.smart.filter((k: string): boolean => k != show), dirty: true };
    save(off);
    return off;
  }
  let on = App { ...s, smart: s.smart.append(show), dirty: true };
  save(on);
  return ask(on, "smart:" + show, Leaves(show));
}

// Stops the download at `at` and deletes its file.
function drop_download(own s: App, at: i32): App {
  let id = s.downloads[at].id;
  s.dev.download_remove(id);
  if (s.dir.len() > 0) {
    let it = s.downloads[at].item;
    s.dev.remove(download_meta_path(s.dir, it.key));
    for track in plex.subtitle_tracks(it) {
      s.dev.remove(download_subtitle_path(s.dir, it.key, track.id));
    }
  }
  let kept = s.downloads.filter((d: Saved): boolean => d.id != id);
  let t = App { ...s, downloads: kept, dirty: true };
  save_downloads(t);
  return t;
}

// Reads the progress of the downloads that are not done, each second. A
// download that failed goes, and so does one that the user deleted.
function download_tick(own s: App, now: i64): App {
  if (!downloading(s) || now - s.downloads_at < DOWNLOAD_MS) {
    return s;
  }
  let out: Saved[] = [];
  let changed = false;
  let lost = false;
  for d in s.downloads {
    if (d.status == download.DONE) {
      out = out.append(d);
    } else {
      let p = s.dev.download_progress(d.id);
      if (p.status == download.FAILED) {
        s.dev.download_remove(d.id);
        lost = true;
      } else if (p.status != download.GONE) {
        out = out.append(Saved { ...d, status: p.status, done: p.done, total: p.total });
      }
      changed = changed || p.status != d.status;
    }
  }
  let t = App { ...s, downloads: out, downloads_at: now, dirty: s.dirty || s.menu.key.len() > 0 || changed };
  if (lost) {
    t = App { ...t, error: "The download failed" };
  }
  if (changed) {
    save_downloads(t);
  }
  return t;
}

// Runs an action of the menu of a poster. Each action closes it.
function menu_act(own s: App, a: string): App {
  let it = s.menu;
  let t = App { ...s, menu: plex.no_item(), dirty: true };
  if (a == "menu:play" && plex.playable_kind(it.kind)) {
    return start_play(t, it, []);
  }
  if (a == "menu:mark") {
    let now = !plex.watched(it);
    return ask(replace_item(t, plex.marked(it, now)), "scrobble", Scrobble(it.key, now));
  }
  if (a == "menu:download" && plex.playable_kind(it.kind)) {
    let at = saved_at(t, it.key);
    if (at >= 0) {
      return drop_download(t, at);
    }
    return ask(t, "download:" + it.key, Meta(it.key));
  }
  if (a == "menu:download_all") {
    return ask(t, "downloadall:" + it.key, Leaves(it.key));
  }
  if (a == "menu:smart" && it.kind == "show") {
    return toggle_smart(t, it.key);
  }
  if (a == "menu:show" && it.grandparent_key.len() > 0) {
    return open_item(t, plex.Item { ...plex.no_item(), key: it.grandparent_key, kind: "show", title: it.grandparent });
  }
  return t;
}

function sign_out(own s: App): App {
  let client = s.client.with_token("");
  let t = App { ...s, client: client, account: "", server: no_server(), base: plex.Base { uri: "", token: "" }, servers: [], hubs: [], sections: [], results: [], screen: ui.LOGIN, stack: [], dirty: true };
  save(t);
  return t;
}

// The rates of the playback in hundredths, in the order that a tap on the
// speed button gives them.
pub function speeds(): i32[] {
  return [100, 125, 150, 200, 50, 75];
}

// The rate of a saved setting, or 100 when it is not one of `speeds()`.
function speed_of(text: string): i32 {
  let v = num(text);
  for rate in speeds() {
    if (rate == v) {
      return v;
    }
  }
  return 100;
}

// A mode of the subtitles from the settings file, or -1 for none.
function mode_of(text: string): i32 {
  if (text.len() == 0 || text.starts_with("-")) {
    return -1;
  }
  return num(text) % 3;
}

// The items of a list in the settings file, with commas between them.
function listed(text: string): string[] {
  if (text.len() == 0) {
    return [];
  }
  return text.split(",");
}

// The language of the tracks to play: the one of the settings, else the
// one of the account, else the first language of the phone.
pub function language(s: App): string {
  if (s.lang.len() > 0) {
    return s.lang;
  }
  let account = plex.language_code(s.account_lang);
  if (account.len() > 0 || s.dev.languages.len() == 0) {
    return account;
  }
  return plex.language_code(s.dev.languages[0]);
}

// The mode of the subtitles: the one of the settings, else the one of the
// account, else subtitles for the sound in another language.
pub function subtitle_mode(s: App): i32 {
  if (s.subs >= 0) {
    return s.subs;
  }
  if (s.account_subs >= 0) {
    return s.account_subs;
  }
  return plex.SUBS_FOREIGN;
}

// The key that a choice of tracks keeps: the show of an episode, so that
// a choice holds for all of its episodes.
function pick_key(it: plex.Item): string {
  if (it.kind == "episode" && it.grandparent_key.len() > 0) {
    return "show:" + it.grandparent_key;
  }
  return it.key;
}

// The tracks to play for `it`. A choice of the person holds, and else the
// tracks follow the language of the settings.
function tracks_for(s: App, it: plex.Item): plex.Choice {
  if (s.picked.contains(pick_key(it))) {
    return plex.remembered(it);
  }
  return plex.preferred(it, language(s), subtitle_mode(s));
}

function same_choice(a: plex.Choice, b: plex.Choice): boolean {
  return a.audio == b.audio && a.subtitle == b.subtitle;
}

// A rate in hundredths as the button shows it, such as "1.25x".
pub function speed_text(v: i32): string {
  let whole = (v / 100).to_string();
  let part = v % 100;
  if (part == 0) {
    return whole + "x";
  }
  if (part % 10 == 0) {
    return whole + "." + (part / 10).to_string() + "x";
  }
  return whole + "." + part.to_string() + "x";
}

// The next rate. The player takes it at once while it plays, and at the
// next start after a pause.
function cycle_speed(own s: App): App {
  let all = speeds();
  let i = 0;
  while (i < all.len() && all[i] != s.speed) {
    i += 1;
  }
  let next = all[(i + 1) % all.len()];
  let p = s.play;
  if (p.prepared && !p.paused) {
    s.dev.set_speed(next);
  }
  let now = s.dev.mono_ms();
  let t = App { ...s, speed: next, play: Play { ...p, badge: s.texts.format("SPEED {0}", [speed_text(next)]), badge_until: now + BADGE_MS }, dirty: true };
  save(t);
  return t;
}

// The quality that a play starts at: Original for Auto.
function first_level(quality: i32): i32 {
  if (quality == plex.auto_quality()) {
    return 0;
  }
  return quality;
}

// A stall more than this long before the next one does not count.
const STALL_WINDOW_MS: i64 = 60000i64;

// With Auto, two stalls of the stream in a minute take the next lower
// quality. The stream then starts again as a transcode where it is.
function stalled(own s: App, on: boolean): App {
  let p = s.play;
  if (!on || s.quality != plex.auto_quality() || !p.prepared || p.level + 1 >= plex.auto_quality() || on_disk(p)) {
    return s;
  }
  let now = s.dev.mono_ms();
  let recent: i64[] = [now];
  for at in p.stalls {
    if (now - at < STALL_WINDOW_MS) {
      recent = recent.append(at);
    }
  }
  if (recent.len() < 2) {
    return App { ...s, play: Play { ...p, stalls: recent } };
  }
  let level = p.level + 1;
  let q = plex.qualities()[level];
  let pos = s.dev.position();
  log.info("plex: the stream stalls, so it plays at " + q.name);
  s.dev.stop();
  if (p.video) {
    s.dev.hide_video();
  }
  let session = hex_id(s.dev);
  let stream = plex.transcode_for(s.client, s.base, p.item, q, pos, session, s.dev.decoders, p.choice);
  let ok = s.dev.play(stream.url);
  return App { ...s, play: Play { ...p, stream: stream, session: session, level: level, stalls: [], prepared: false, video: false, overlay: true, position: pos, status: q.name }, dirty: true };
}

function cycle_quality(own s: App): App {
  let quality = (s.quality + 1) % plex.qualities().len();
  let t = App { ...s, quality: quality, dirty: true };
  save(t);
  return t;
}

// The next language of the settings: automatic, then each language.
function cycle_language(own s: App): App {
  let codes = plex.languages().map((l: plex.Language): string => l.code);
  let at = position_of(codes, s.lang);
  let lang = "";
  if (at < 0) {
    lang = codes[0];
  } else if (at < codes.len() - 1) {
    lang = codes.drop(at).drop(1)[0];
  }
  let t = App { ...s, lang: lang, dirty: true };
  save(t);
  return t;
}

// The next mode of the subtitles: automatic, then off, with a foreign
// sound, and always.
function cycle_subtitles(own s: App): App {
  let subs = plex.SUBS_OFF;
  if (s.subs >= 0) {
    subs = [plex.SUBS_FOREIGN, plex.SUBS_ALWAYS, -1][s.subs];
  }
  let t = App { ...s, subs: subs, dirty: true };
  save(t);
  return t;
}

function language_text(s: App): string {
  let name = plex.language_name(language(s));
  if (s.lang.len() > 0) {
    return name;
  }
  if (name.len() == 0) {
    name = s.texts.text("Off");
  }
  return s.texts.format("Auto ({0})", [name]);
}

function subtitles_text(s: App): string {
  let names = ["Off", "Foreign sound", "Always"];
  let name = s.texts.text(names[subtitle_mode(s)]);
  if (s.subs >= 0) {
    return name;
  }
  return s.texts.format("Auto ({0})", [name]);
}

// --- playback

// The item to play, with all of its metadata when it is downloaded, its
// stream at quality `q`, and its tracks.
function stream_of(s: App, it: plex.Item, session: string, q: plex.Quality): (plex.Item, plex.Stream, plex.Choice) {
  let saved = saved_at(s, it.key);
  if (saved >= 0 && s.downloads[saved].status == download.DONE && s.dev.downloads_dir.len() > 0) {
    let d = s.downloads[saved];
    let held = plex.Item { ...d.item, offset_ms: it.offset_ms };
    let choice = tracks_for(s, held);
    return (held, plex.Stream { url: "file://" + s.dev.downloads_dir + "/" + d.file, transcode: false, offset_ms: it.offset_ms }, choice);
  }
  let choice = tracks_for(s, it);
  return (it, plex.stream_for(s.client, s.base, it, q, it.offset_ms, session, s.dev.decoders, choice), choice);
}

// The id of the first part of the first version of the item, or "".
function part_of(it: plex.Item): string {
  if (it.media.len() > 0 && it.media[0].parts.len() > 0) {
    return it.media[0].parts[0].id;
  }
  return "";
}

// True when a transcode of `it` with `choice` waits for the server to take
// the choice: a transcode plays the tracks that the server remembers.
function needs_retrack(it: plex.Item, stream: plex.Stream, choice: plex.Choice): boolean {
  return stream.transcode && part_of(it).len() > 0 && !same_choice(choice, plex.remembered(it));
}

function start_play(own s: App, first: plex.Item, queue: plex.Item[]): App {
  if (s.play.active) {
    s = stop_play(s, false);
  }
  let session = hex_id(s.dev);
  let level = first_level(s.quality);
  let (it, stream, choice) = stream_of(s, first, session, plex.qualities()[level]);
  let retrack = needs_retrack(it, stream, choice);
  let part = part_of(it);
  let p = Play { ...no_play(), active: true, item: it, stream: stream, session: session, overlay: true, status: "Loading", queue: queue, position: it.offset_ms, duration: it.duration_ms, level: level, choice: choice };
  let t = player_screen(s, p);
  log.info("plex: play " + it.key + " transcode=" + stream.transcode.to_string());
  if (retrack) {
    return ask(App { ...t, play: Play { ...t.play, held: true } }, "retrack:" + session, SelectTracks(part, choice));
  }
  if (!t.dev.play(stream.url)) {
    return App { ...t, play: Play { ...t.play, status: "The player refused the stream" } };
  }
  return t;
}

// The player screen for `p`, with requests for what the item needs other
// than its stream: the thumbnails, the subtitles, and its metadata.
function player_screen(own s: App, p: Play): App {
  let it = p.item;
  let t = App { ...push(s), screen: ui.PLAYER, play: p, dirty: true };
  if let Some(part) = plex.thumbnail_part(it) {
    t = ask(t, "bif:" + part.id, Bif(part.id));
  }
  t = ask_cues(t);
  // An item from a list has no markers and no tracks, so the app asks for
  // all of its metadata. A download keeps all of it.
  if (!audio(p) && !on_disk(p)) {
    t = ask(t, "playmeta:" + it.key, Meta(it.key));
  }
  return t;
}

function art_of(it: plex.Item): string {
  if (it.art.len() > 0) {
    return it.art;
  }
  return plex.poster(it);
}

function audio(p: Play): boolean {
  return p.item.kind == "track";
}

function timeline(own s: App, state: string): App {
  let p = s.play;
  return report(s, Timeline(p.item.key, state, p.position, p.duration, p.session));
}

function prepared(own s: App): App {
  log.info("plex: prepared " + s.play.item.key);
  let d = s.dev.duration();
  let p = Play { ...s.play, prepared: true, status: "" };
  if (d > 0i64) {
    p = Play { ...p, duration: d };
  }
  let silent = !p.stream.transcode && !audio(p) && has_sound(p.item) && !s.dev.has_audio();
  if (!silent && p.stream.offset_ms > 0i64) {
    s.dev.seek(p.stream.offset_ms);
  }
  if (!silent && !p.stream.transcode) {
    pick_sound(s.dev, p);
    pick_text(s.dev, p);
  }
  let t = App { ...s, play: p, dirty: true };
  if (silent) {
    return transcode_sound(t, "the player selected no sound track", p.stream.offset_ms);
  } else {
    return resume(t);
  }
}

// Shows the chosen subtitle of images of a file that plays as it is, or no
// subtitle track of the player.
function pick_text(dev: Device, p: Play): void {
  let ok = dev.select_text(plex.image_subtitle_index(p.item, p.choice));
}

// Plays the chosen sound track of a file that plays as it is. The sound
// tracks of the server and of the player are both in the order of the file.
function pick_sound(dev: Device, p: Play): void {
  if (p.choice.audio.len() == 0) {
    return;
  }
  let sounds = plex.audio_tracks(p.item);
  let k = 0;
  while (k < sounds.len() && sounds[k].id != p.choice.audio) {
    k += 1;
  }
  let tracks = dev.audio_tracks();
  if (k < sounds.len() && k < tracks.len()) {
    let ok = dev.select_track(tracks[k]);
  }
}

// Plays the item with a new choice of tracks, and makes the server
// remember it. A file that plays as it is changes its sound in place.
// Otherwise the stream starts again where it is, once the server has the
// choice.
// The tracks that the person chose. The choice holds for the item, and
// for all the episodes of its show.
function choose(own s: App, choice: plex.Choice): App {
  let key = pick_key(s.play.item);
  if (s.picked.contains(key)) {
    return switch_tracks(s, choice);
  }
  let picked = s.picked.append(key);
  if (picked.len() > PICKS) {
    picked = picked.drop(picked.len() - PICKS);
  }
  let t = App { ...s, picked: picked };
  save(t);
  return switch_tracks(t, choice);
}

// The number of choices of tracks that the app keeps.
const PICKS: i32 = 200;

// Plays the item that plays with the tracks of `choice`.
function switch_tracks(own s: App, choice: plex.Choice): App {
  let p = s.play;
  let part = part_of(p.item);
  let t = s;
  let next = Play { ...p, choice: choice, cues: [], sheet: false };
  let pos = p.position;
  if (p.prepared) {
    pos = t.dev.position();
  }
  // A downloaded file holds the tracks of the sheet, so it plays on.
  if (on_disk(p)) {
    if (part.len() > 0) {
      t = report(t, SelectTracks(part, choice));
    }
    return ask_cues(sound_now(t, next));
  }
  let q = plex.qualities()[p.level];
  let session = hex_id(t.dev);
  let stream = plex.stream_for(t.client, t.base, p.item, q, pos, session, t.dev.decoders, choice);
  if (!stream.transcode && !p.stream.transcode) {
    if (part.len() > 0) {
      t = report(t, SelectTracks(part, choice));
    }
    return ask_cues(sound_now(t, next));
  }
  log.info("plex: new tracks, so the stream starts again");
  t.dev.stop();
  if (p.video) {
    t.dev.hide_video();
  }
  if (p.stream.transcode) {
    t = report(t, StopTranscode(p.session));
  }
  let u = App { ...t, play: Play { ...next, stream: stream, session: session, prepared: false, video: false, overlay: true, position: pos, status: "Loading", held: part.len() > 0 }, dirty: true };
  // A transcode takes its sound and its subtitles from the tracks that the
  // server remembers for the part, so the stream starts after the server
  // has the choice.
  if (part.len() > 0) {
    return ask_cues(ask(u, "retrack:" + session, SelectTracks(part, choice)));
  }
  let ok = u.dev.play(stream.url);
  return ask_cues(u);
}

// Takes the choice that the server remembers for the item that plays. An
// item of a list has no tracks, so its choice comes with all of its
// metadata after the play starts. A transcode took the choice already. A
// file that plays as it is changes its sound in place, unless the sound of
// the choice needs a transcode.
function follow_remembered(own s: App, choice: plex.Choice): App {
  let p = s.play;
  let next = Play { ...p, choice: choice };
  if (p.stream.transcode) {
    return ask_cues(App { ...s, play: next, dirty: true });
  }
  if (!on_disk(p)) {
    let pos = p.position;
    if (p.prepared) {
      pos = s.dev.position();
    }
    let session = hex_id(s.dev);
    let stream = plex.stream_for(s.client, s.base, p.item, plex.qualities()[p.level], pos, session, s.dev.decoders, choice);
    if (stream.transcode) {
      log.info("plex: the remembered tracks need a transcode");
      s.dev.stop();
      if (p.video) {
        s.dev.hide_video();
      }
      let ok = s.dev.play(stream.url);
      return ask_cues(App { ...s, play: Play { ...next, stream: stream, session: session, prepared: false, video: false, overlay: true, position: pos, status: "Loading" }, dirty: true });
    }
  }
  return ask_cues(sound_now(s, next));
}

// The play `next` of a file that plays as it is. The player changes its
// sound in place, and `prepared` selects it for a player that is not
// prepared yet.
function sound_now(own s: App, next: Play): App {
  if (next.prepared) {
    pick_sound(s.dev, next);
    pick_text(s.dev, next);
  }
  return App { ...s, play: next, dirty: true };
}

// True when the first version of the item has a sound track.
function has_sound(it: plex.Item): boolean {
  return it.media.len() > 0 && it.media[0].audio.len() > 0;
}

// Plays the item again from `pos`, as a transcode in which the server
// converts the sound: the file played as it is, with no sound.
function transcode_sound(own s: App, why: string, pos: i64): App {
  let p = s.play;
  if (p.stream.transcode || p.retried) {
    return s;
  }
  log.warn("plex: no sound in direct play, " + why + ", so the server converts it");
  s.dev.stop();
  if (p.video) {
    s.dev.hide_video();
  }
  let session = hex_id(s.dev);
  let stream = plex.transcode_for(s.client, s.base, p.item, plex.qualities()[p.level], pos, session, s.dev.decoders, p.choice);
  let ok = s.dev.play(stream.url);
  return App { ...s, play: Play { ...p, stream: stream, session: session, retried: true, prepared: false, video: false, overlay: true, position: pos, status: "Converting the sound" }, dirty: true };
}

// Shows the video on the window and plays.
function resume(own s: App): App {
  let p = s.play;
  if (!p.prepared) {
    return s;
  }
  if (!s.dev.take_focus()) {
    log.info("plex: Android gave no audio focus, so the play waits");
    return App { ...s, play: Play { ...p, paused: true, overlay: true }, dirty: true };
  }
  let video = p.video;
  if (!audio(p) && !video && s.window != 0 as usize) {
    video = s.dev.show_video(s.window);
    if (video) {
      log.info("plex: video on the window");
      if (p.item.media.len() > 0 && p.item.media[0].frame_rate > 0.0f32) {
        s.dev.frame_rate(s.window, p.item.media[0].frame_rate);
      }
    }
  }
  s.dev.start();
  if (s.speed != 100) {
    s.dev.set_speed(s.speed);
  }
  s.dev.keep_screen_on(true);
  if (video) {
    s.dev.pip(true);
    s.dev.immersive(true);
    s.dev.request_frame();
  }
  let at = s.dev.mono_ms();
  let t = timeline(App { ...s, play: Play { ...p, paused: false, video: video, overlay: !video, reported_at: at, focus_paused: false }, dirty: true }, "playing");
  announce(t);
  // The media controls of a track are a notification.
  if (audio(t.play) && !t.asked_notifications) {
    t.dev.ask_notifications();
    return App { ...t, asked_notifications: true };
  }
  return t;
}

// Pauses and takes the video off the window, so the overlay can show.
// A call or another app took the audio focus, so the play pauses. When the
// focus comes back after such a pause, the play goes on. Android lowers
// the volume itself for a short sound, such as a notification.
function focus_changed(own s: App, c: focus.Change): App {
  let p = s.play;
  if (!p.active) {
    return s;
  }
  match (c) {
    focus.Loss => {
      if (p.paused || !p.prepared) {
        return s;
      }
      log.info("plex: another app took the audio focus");
      let t = pause_play(s);
      return App { ...t, play: Play { ...t.play, focus_paused: true } };
    },
    focus.Gain => {
      if (!p.focus_paused || !p.paused) {
        return s;
      }
      return resume(s);
    },
    focus.Duck => {
      return s;
    }
  }
}

function pause_play(own s: App): App {
  let p = s.play;
  s.dev.pause();
  if (p.video) {
    s.dev.pip(false);
    s.dev.pause_video();
  }
  s.dev.keep_screen_on(false);
  s.dev.immersive(false);
  let pos = s.dev.position();
  log.info("plex: paused at " + pos.to_string());
  let at = s.dev.mono_ms();
  let t = App { ...s, play: Play { ...p, paused: true, video: false, overlay: true, position: pos, reported_at: at }, dirty: true };
  let u = timeline(t, "paused");
  announce(u);
  return u;
}

function seek_by(own s: App, delta: i64): App {
  let target = s.dev.position() + delta;
  if (target < 0i64) {
    target = 0i64;
  }
  if (s.play.duration > 0i64 && target > s.play.duration) {
    target = s.play.duration - 1000i64;
  }
  return seek_to(s, target);
}

// A seek in a transcode stays in its stream: the server starts the segments
// at the seek.
function seek_to(own s: App, ms: i64): App {
  s.dev.seek(ms);
  let t = App { ...s, play: Play { ...s.play, position: ms }, dirty: true };
  announce(t);
  return t;
}

// Tells the media controls of Android the state of a track.
function announce(s: App): void {
  let p = s.play;
  if (p.active && audio(p)) {
    s.dev.now_playing(p.item.title, p.item.grandparent, p.item.parent, p.duration, !p.paused, p.position);
  }
}

// A command of the media controls of Android: from the notification, the
// lock screen, a headset or a watch.
function media_command(own s: App, c: session.Command): App {
  let p = s.play;
  if (!p.active) {
    return s;
  }
  match (c) {
    session.Play => {
      if (p.paused) {
        return resume(s);
      }
      return s;
    },
    session.Hold => {
      if (!p.paused && p.prepared) {
        return pause_play(s);
      }
      return s;
    },
    session.Next => {
      if (p.queue.len() > 0) {
        return play_next(s);
      }
      return s;
    },
    session.Previous => {
      return seek_to(s, 0i64);
    },
    session.End => {
      return stop_play(s, false);
    },
    session.SeekTo(ms) => {
      return seek_to(s, ms);
    }
  }
}

// Ends the playback and goes back. A watched item is marked so.
function stop_play(own s: App, completed: boolean): App {
  if (s.play.next.key.len() > 0) {
    s = drop_next(s);
  }
  let p = s.play;
  let pos = p.position;
  if (p.prepared) {
    pos = s.dev.position();
  }
  s.dev.stop();
  s.dev.drop_focus();
  s.dev.keep_screen_on(false);
  s.dev.immersive(false);
  if (p.video) {
    s.dev.pip(false);
    s.dev.frame_rate(s.window, 0.0f32);
  }
  if (audio(p)) {
    s.dev.media_end();
  }
  if (p.light >= 0) {
    s.dev.brightness(-1.0f32);
  }
  if (completed) {
    pos = p.duration;
  }
  let t = timeline(App { ...s, play: Play { ...p, position: pos } }, "stopped");
  if (p.stream.transcode) {
    t = report(t, StopTranscode(p.session));
  }
  let finished = completed || p.duration > 0i64 && pos * 10i64 >= p.duration * 9i64;
  if (finished) {
    t = report(t, Scrobble(p.item.key, true));
  }
  if (p.video || !audio(p) && plex.playable_kind(p.item.kind)) {
    if (finished) {
      t.dev.watch_next_drop(p.item.key);
    } else if (pos > 0i64) {
      let kind = if (p.item.kind == "episode") { 3 } else { 0 };
      t.dev.watch_next(p.item.key, plex.card_title(p.item), kind, pos, p.duration, plex.image_url(t.base, plex.poster(p.item), 400, 600));
    }
  }
  t = keep_place(t, p.item.key, if (finished) { 0i64 } else { pos });
  // Music that plays while another screen shows stops with no screen to go
  // back from.
  if (t.screen != ui.PLAYER) {
    return App { ...t, play: no_play(), dirty: true };
  }
  return refresh_detail(pop(App { ...t, play: no_play() }));
}

// Keeps the place `place` of the download of the item `key`.
function keep_place(own t: App, key: string, place: i64): App {
  let at = saved_at(t, key);
  if (at < 0) {
    return t;
  }
  let d = t.downloads[at];
  let u = App { ...t, downloads: t.downloads.with(at, Saved { ...d, item: plex.Item { ...d.item, offset_ms: place } }) };
  save_downloads(u);
  return u;
}

// Asks the server again for the item of a detail screen, for its new
// position and its watched state.
function refresh_detail(own s: App): App {
  if (s.screen != ui.DETAIL) {
    return s;
  }
  let key = s.item.key;
  return ask(s, "meta:" + key, Meta(key));
}

function completed(own s: App): App {
  if (s.play.next_ready && audio(s.play)) {
    return carry_on(s);
  }
  if (s.play.next_ready) {
    return take_next(s);
  }
  let album = s.play.album;
  let at_end = sleeps_at_end(s);
  let next = following(s);
  let t = stop_play(s, true);
  if (at_end) {
    log.info("plex: the sleep timer stops the music");
    return App { ...t, sleep: 0 };
  }
  if let Some((it, queue)) = next {
    return go_on(t, it, queue, album);
  }
  return t;
}

function sleeps_at_end(s: App): boolean {
  return s.sleep_at == 0i64 && sleeps()[s.sleep] < 0;
}

// The item that plays when the one that plays ends, and the queue after
// it, or None when the play stops there.
function following(s: App): Option[(plex.Item, plex.Item[])] {
  let p = s.play;
  if (sleeps_at_end(s)) {
    return None;
  }
  if (s.repeat == 2 && audio(p)) {
    return Some((plex.Item { ...p.item, offset_ms: 0i64 }, p.queue));
  }
  if (p.queue.len() > 0 && !p.next_off) {
    return Some((p.queue[0], p.queue.drop(1)));
  }
  if (s.repeat == 1 && p.album.len() > 0 && audio(p)) {
    let order = p.album;
    if (s.shuffle) {
      order = shuffled(s.dev, p.album);
    }
    return Some((order[0], order.drop(1)));
  }
  return None;
}

// The settings that choose the next track. A change of them takes the
// track that the second player prepares away.
function plan_of(s: App): string {
  let p = s.play;
  return [p.item.key, s.repeat.to_string(), s.shuffle.to_string(), s.sleep.to_string(), p.next_off.to_string(), p.queue.map((it: plex.Item): string => it.key).join(",")].join("|");
}

// Prepares the next item on the second player. The next track of the
// music follows with no gap. The next video starts at once when the card of
// the next item ends, so the second player prepares it while the card shows.
function line_up(own s: App): App {
  let p = s.play;
  if (!p.active || !p.prepared) {
    return s;
  }
  let plan = plan_of(s);
  if (p.next.key.len() > 0 && p.next_plan != plan) {
    s = drop_next(s);
    p = s.play;
  }
  if (p.next.key.len() > 0 || p.next_tried == plan || !audio(p) && p.up_next_at == 0i64) {
    return s;
  }
  let Some((it, queue)) = following(s) else {
    return App { ...s, play: Play { ...p, next_tried: plan } };
  };
  if (!follows(p, it)) {
    return App { ...s, play: Play { ...p, next_tried: plan } };
  }
  let session = hex_id(s.dev);
  let (item, stream, choice) = stream_of(s, it, session, plex.qualities()[p.level]);
  if (needs_retrack(item, stream, choice) || !s.dev.queue_next(stream.url)) {
    return App { ...s, play: Play { ...p, next_tried: plan } };
  }
  return App { ...s, play: Play { ...p, next: item, next_queue: queue, next_stream: stream, next_session: session, next_plan: plan, next_ready: false } };
}

// True when the second player can prepare `it` to follow `p`: a track
// follows a track, and a video follows a video.
function follows(p: Play, it: plex.Item): boolean {
  if (audio(p)) {
    return it.kind == "track";
  }
  return it.kind != "track" && plex.playable_kind(it.kind);
}

// Takes the next item away from the second player. The server stops the
// transcode that it started for the item.
function drop_next(own s: App): App {
  let p = s.play;
  s.dev.chain(false);
  let t = App { ...s, play: Play { ...p, next: plex.no_item(), next_ready: false, next_plan: "" } };
  if (p.next_stream.transcode) {
    return report(t, StopTranscode(p.next_session));
  }
  return t;
}

// An event of the second player. Once it is prepared, it follows the track
// that plays, or waits for the end of the card of the next video. When it
// fails, the next item starts as usual at the end.
function next_event(own s: App, c: player.Change): App {
  let p = s.play;
  if (p.next.key.len() == 0) {
    return s;
  }
  match (c) {
    player.Prepared => {
      if (audio(p)) {
        s.dev.chain(true);
      }
      return App { ...s, play: Play { ...p, next_ready: true } };
    },
    player.Failed(what, extra) => {
      log.warn("plex: the next item failed: " + what.to_string() + " " + extra.to_string());
      let t = drop_next(s);
      return App { ...t, play: Play { ...t.play, next_tried: p.next_plan } };
    },
    _ => {
      return s;
    }
  }
}

// The second player took over at the end of the track with no gap. The
// server hears that the track ended, and the next one plays.
function carry_on(own s: App): App {
  let p = s.play;
  s.dev.swap();
  log.info("plex: play " + p.next.key + " with no gap");
  let t = timeline(App { ...s, play: Play { ...p, position: p.duration } }, "stopped");
  if (p.stream.transcode) {
    t = report(t, StopTranscode(p.session));
  }
  t = keep_place(report(t, Scrobble(p.item.key, true)), p.item.key, 0i64);
  let np = Play { ...no_play(), active: true, item: p.next, stream: p.next_stream, session: p.next_session, overlay: true, queue: p.next_queue, album: p.album, duration: p.next.duration_ms, level: p.level, choice: tracks_for(t, p.next) };
  return prepared(App { ...t, play: np, dirty: true });
}

// The second player prepared the next video while its card showed. It
// takes the place of the video that ends, and plays at once.
function take_next(own s: App): App {
  let p = s.play;
  let t = stop_play(App { ...s, play: Play { ...p, next: plex.no_item() } }, true);
  t.dev.swap();
  log.info("plex: play " + p.next.key + " from the second player");
  let np = Play { ...no_play(), active: true, item: p.next, stream: p.next_stream, session: p.next_session, overlay: true, queue: p.next_queue, album: p.album, position: p.next.offset_ms, duration: p.next.duration_ms, level: p.level, choice: tracks_for(t, p.next) };
  return prepared(player_screen(t, np));
}

// The next item of a list, which keeps its album.
function go_on(own s: App, it: plex.Item, queue: plex.Item[], album: plex.Item[]): App {
  let t = start_play(s, it, queue);
  return App { ...t, play: Play { ...t.play, album: album } };
}

function play_failed(own s: App, what: i32, extra: i32): App {
  let p = s.play;
  log.warn("plex: playback failed: " + what.to_string() + " " + extra.to_string());
  if (!p.stream.transcode && !p.retried) {
    // The file did not play as it is, so the server transcodes it.
    s.dev.stop();
    let q = plex.qualities()[2];
    let session = hex_id(s.dev);
    let it = plex.Item { ...p.item, offset_ms: p.position };
    let stream = plex.stream_for(s.client, s.base, it, q, p.position, session, s.dev.decoders, p.choice);
    let ok = s.dev.play(stream.url);
    return App { ...s, play: Play { ...p, stream: stream, session: session, retried: true, prepared: false, video: false, overlay: true, status: "Transcoding" }, dirty: true };
  }
  if (p.video) {
    s.dev.hide_video();
  }
  return App { ...s, play: Play { ...p, video: false, overlay: true, paused: true, status: s.texts.format("This item does not play ({0}, {1})", [what.to_string(), extra.to_string()]) }, dirty: true };
}

function player_event(own s: App, c: player.Change): App {
  if (!s.play.active) {
    return s;
  }
  match (c) {
    player.Prepared => {
      return prepared(s);
    },
    player.Completed => {
      return completed(s);
    },
    player.Failed(what, extra) => {
      return play_failed(s, what, extra);
    },
    player.AudioNotPlaying => {
      let pos = s.dev.position();
      return transcode_sound(s, "the sound decoder stopped", pos);
    },
    player.VideoNotPlaying => {
      return play_failed(s, 805, 0);
    },
    player.Buffering(on) => {
      let status = "";
      if (on) {
        status = "Buffering";
      }
      return stalled(App { ...s, play: Play { ...s.play, buffering: on, status: status }, dirty: true }, on);
    },
    player.Rendering => {
      return s;
    },
    player.Cues => {
      return App { ...s, play: Play { ...s.play, images: with_keys(s.dev.image_cues(), s.dev.mono_ms()) }, dirty: true };
    },
    player.Seeked => {
      return App { ...s, play: Play { ...s.play, position: s.dev.position() }, dirty: true };
    }
  }
}

// The subtitles of images, each with a key of its own for its texture.
function with_keys(pictures: ui.Picture[], now: i64): ui.Picture[] {
  let out: ui.Picture[] = [];
  for k in 0..pictures.len() {
    out = out.append(ui.Picture { ...pictures[k], key: "cue|" + now.to_string() + "|" + k.to_string() });
  }
  return out;
}

// The step of the delay of the text subtitles.
const DELAY_STEP: i64 = 100i64;

// The delay as the sheet shows it, such as "+0.3 s".
pub function delay_text(ms: i64): string {
  let sign = if (ms < 0i64) { "-" } else { "+" };
  let tenths = ms.abs() / DELAY_STEP;
  return sign + (tenths / 10i64).to_string() + "." + (tenths % 10i64).to_string() + " s";
}

// The line of the text subtitle at the place of the playback.
function caption_of(p: Play): string {
  return plex.cue_at(p.cues, p.position - p.delay_ms);
}

// The delay of the sheet for a text subtitle that the app draws, or "".
function delay_shown(p: Play): string {
  if (plex.text_subtitle(p.item, p.choice).is_none()) {
    return "";
  }
  return delay_text(p.delay_ms);
}

// Keeps the position on the overlay and the server up to date. While the
// player is paused, the app still reports, and keeps its transcode alive.
function play_tick(own s: App, now: i64): App {
  if (s.play.badge.len() > 0 && now >= s.play.badge_until) {
    s = App { ...s, play: Play { ...s.play, badge: "" }, dirty: true };
  }
  if (s.sleep_at > 0i64 && now >= s.sleep_at) {
    log.info("plex: the sleep timer pauses the music");
    s = App { ...s, sleep: 0, sleep_at: 0i64 };
    if (s.play.active && !s.play.paused) {
      s = pause_play(s);
    }
  }
  let p = s.play;
  if (!p.active || !p.prepared) {
    return s;
  }
  if (p.paused) {
    if (now - p.reported_at < REPORT_MS) {
      return s;
    }
    let t = timeline(App { ...s, play: Play { ...p, reported_at: now } }, "paused");
    if (p.stream.transcode) {
      t = report(t, PingTranscode(p.session));
    }
    return t;
  }
  let t = s;
  if (p.video && p.overlay && now >= p.controls_until && t.press.group != "seek") {
    t = App { ...t, play: Play { ...t.play, overlay: false }, dirty: true };
  }
  let every = 500i64;
  if (p.cues.len() > 0) {
    every = 100i64;
  }
  if (now - p.updated_at >= every) {
    let before = skip_label(t.play) + "|" + up_next_secs(t.play, now - 500i64).to_string() + "|" + caption_of(t.play);
    let moved = Play { ...t.play, position: t.dev.position(), updated_at: now };
    let from = up_next_from(moved);
    if (moved.up_next_at == 0i64 && from >= 0i64 && moved.position >= from) {
      moved = Play { ...moved, up_next_at: now };
    }
    let after = skip_label(moved) + "|" + up_next_secs(moved, now).to_string() + "|" + caption_of(moved);
    t = App { ...t, play: moved, dirty: t.dirty || t.play.overlay || before != after };
    if (moved.up_next_at > 0i64 && now - moved.up_next_at >= UP_NEXT_MS) {
      return play_next(t);
    }
  }
  if (now - t.play.reported_at >= REPORT_MS) {
    t = App { ...t, play: Play { ...t.play, reported_at: now } };
    t = timeline(t, "playing");
  }
  return t;
}

// How long the controls show over the video after a tap.
const CONTROLS_MS: i64 = 4000i64;

// Asks for the file of the chosen subtitle track when the app draws it.
function ask_cues(own s: App): App {
  let Some(track) = plex.text_subtitle(s.play.item, s.play.choice) else {
    return s;
  };
  if (on_disk(s.play) && s.dir.len() > 0) {
    let text = s.dev.read(download_subtitle_path(s.dir, s.play.item.key, track.id));
    if (text.len() > 0) {
      return App { ...s, play: Play { ...s.play, cues: plex.parse_cues(text) }, dirty: true };
    }
  }
  return ask(s, "subtitle:" + track.id, Subtitle(track));
}

// The markers and the media of the item that plays, from all of its
// metadata. The thumbnails come now when the item of the list had none.
function got_play_meta(own t: App, key: string, r: plex.Reply): App {
  if (!t.play.active || t.play.item.key != key) {
    return t;
  }
  let Some(full) = plex.parse_item(r.text()) else {
    return t;
  };
  let had = plex.thumbnail_part(t.play.item).is_some();
  let had_cues = plex.text_subtitle(t.play.item, t.play.choice).is_some();
  let item = plex.Item { ...t.play.item, markers: full.markers, media: full.media };
  let want = tracks_for(t, item);
  let same = same_choice(want, plex.remembered(item));
  let unchosen = t.play.choice.audio.len() == 0 && t.play.choice.subtitle.len() == 0;
  let u = App { ...t, play: Play { ...t.play, item: item } };
  if (unchosen && same && (want.audio.len() > 0 || want.subtitle.len() > 0)) {
    u = follow_remembered(u, want);
  } else if (unchosen && !same) {
    u = switch_tracks(u, want);
  } else if (!had_cues) {
    u = ask_cues(u);
  }
  if (!had) {
    if let Some(part) = plex.thumbnail_part(item) {
      return ask(u, "bif:" + part.id, Bif(part.id));
    }
  }
  return u;
}

// How long the card of the next item counts down, and how long before the
// end it comes when the video has no credits marker.
const UP_NEXT_MS: i64 = 10000i64;

const UP_NEXT_LEAD_MS: i64 = 20000i64;

// The time of the video where the card of the next item comes: the start
// of the credits, else UP_NEXT_LEAD_MS before the end. -1 when there is no
// next item.
function up_next_from(p: Play): i64 {
  if (p.queue.len() == 0 || p.next_off || audio(p) || p.duration <= 0i64) {
    return -1i64;
  }
  for m in p.item.markers {
    if (m.kind == "credits") {
      return m.start_ms;
    }
  }
  return p.duration - UP_NEXT_LEAD_MS;
}

// The seconds that the card of the next item shows, or -1 with no card.
function up_next_secs(p: Play, now: i64): i32 {
  if (p.up_next_at == 0i64) {
    return -1;
  }
  let left = UP_NEXT_MS - (now - p.up_next_at);
  if (left < 0i64) {
    return 0;
  }
  return ((left + 999i64) / 1000i64) as i32;
}

// Plays the next item now. The item that plays counts as watched.
function play_next(own s: App): App {
  if (s.play.next_ready && !audio(s.play)) {
    return take_next(s);
  }
  let queue = s.play.queue;
  let album = s.play.album;
  let t = stop_play(s, true);
  return go_on(t, queue[0], queue.drop(1), album);
}

// The words of the skip button at the place of the playback, or "".
function skip_label(p: Play): string {
  if (!p.active || !p.prepared || audio(p)) {
    return "";
  }
  let Some(m) = plex.marker_at(p.item, p.position) else {
    return "";
  };
  if (m.kind == "credits") {
    return "Skip credits";
  }
  return "Skip intro";
}

// The preview thumbnails of the part `id`, when the item that plays has
// that part. A server with no thumbnails answers 404, and then the drag
// shows only the time.
function got_bif(own t: App, id: string, r: plex.Reply): App {
  let Some(part) = plex.thumbnail_part(t.play.item) else {
    return t;
  };
  if (!t.play.active || part.id != id || !r.ok()) {
    return t;
  }
  return App { ...t, play: Play { ...t.play, bif: plex.parse_bif(r.body) } };
}

// The seek bar among the nodes.
function seek_bar_of(ns: scene.Node[]): Option[scene.Node] {
  for n in ns {
    if (n.group == "seek") {
      return Some(n);
    }
  }
  return None;
}

// How long the player waits between two seeks while the finger drags.
const SCRUB_SEEK_MS: i64 = 200i64;

// The finger on the seek bar at `x`: the time under it shows with its
// thumbnail, and the player seeks there at most every SCRUB_SEEK_MS. When
// the finger leaves, the player seeks there at once.
function scrub(own s: App, x: i32, done: boolean): App {
  let p = s.play;
  let Some(n) = seek_bar_of(s.nodes) else {
    return s;
  };
  if (p.duration <= 0i64 || n.w <= 0) {
    return s;
  }
  let along = clamp(x - n.x, 0, n.w);
  let ms = p.duration * (along as i64) / (n.w as i64);
  if (done) {
    return seek_to(App { ...s, play: Play { ...p, scrub_ms: -1i64, thumb_index: -1, thumb: None } }, ms);
  }
  let now = s.dev.mono_ms();
  let at = p.scrub_seek_at;
  if (now - at >= SCRUB_SEEK_MS) {
    s.dev.seek(ms);
    at = now;
  }
  let index = p.thumb_index;
  let thumb = p.thumb;
  if let Some(f) = p.bif {
    let i = plex.bif_frame(f, ms);
    if (i >= 0 && i != index) {
      let m = ui.metrics(s.w, s.h, s.top, s.bottom);
      let (tw, th) = ui.thumb_size(m);
      index = i;
      thumb = s.dev.decode(plex.bif_jpeg(f, i), tw, th);
    }
  }
  return App { ...s, play: Play { ...p, scrub_ms: ms, scrub_seek_at: at, thumb_index: index, thumb: thumb, controls_until: now + CONTROLS_MS }, dirty: true };
}

// The side of the video at `x`: -1 for the left two fifths, 1 for the
// right two fifths, and 0 for the middle.
function tap_side(w: i32, x: i32): i32 {
  if (x * 5 < w * 2) {
    return -1;
  }
  if (x * 5 > w * 3) {
    return 1;
  }
  return 0;
}

// How soon a second tap must come to seek, and how long a badge shows.
const DOUBLE_TAP_MS: i64 = 300i64;

const BADGE_MS: i64 = 800i64;

// A second tap at the same side of the video soon after a tap on the video
// seeks back or forward 10 seconds, whatever control the first tap showed
// there. The controls stay as they were before the first tap. Each tap
// after that seeks again.
function double_tap(own s: App, x: i32): App {
  let p = s.play;
  let now = s.dev.mono_ms();
  let side = tap_side(s.w, x);
  if (side != 0 && now - p.tap_at <= DOUBLE_TAP_MS && side == tap_side(s.w, p.tap_x)) {
    let note = "+10";
    if (side < 0) {
      note = "-10";
    }
    return seek_by(App { ...s, play: Play { ...p, tap_at: now, tap_x: x, overlay: p.tap_overlay, badge: note, badge_until: now + BADGE_MS }, dirty: true }, side as i64 * 10000i64);
  }
  return s;
}

function player_act(own s: App, act: string, n: scene.Node, x: i32): App {
  if (s.play.drawn) {
    // The first tap can show the controls under the second.
    let before = s.play.tap_at;
    let t = double_tap(s, x);
    if (t.play.tap_at != before) {
      return t;
    }
    if (act == "overlay" || act == "hide") {
      t = App { ...t, play: Play { ...t.play, tap_at: t.dev.mono_ms(), tap_x: x, tap_overlay: t.play.overlay } };
    }
    s = t;
  }
  let p = s.play;
  if (act == "overlay") {
    if (!p.drawn) {
      // The player draws on the window itself, so nothing can show over the
      // video: the controls show with the video paused.
      return pause_play(s);
    }
    log.info("plex: controls over the video");
    let until = s.dev.mono_ms() + CONTROLS_MS;
    return App { ...s, play: Play { ...p, overlay: true, controls_until: until }, dirty: true };
  }
  if (act == "hide") {
    return App { ...s, play: Play { ...p, overlay: false }, dirty: true };
  }
  if (p.video && p.overlay) {
    // A control keeps the controls up for a while longer.
    let until = s.dev.mono_ms() + CONTROLS_MS;
    return player_control(App { ...s, play: Play { ...p, controls_until: until } }, act, n, x);
  }
  return player_control(s, act, n, x);
}

function player_control(own s: App, act: string, n: scene.Node, x: i32): App {
  let p = s.play;
  if (act == "toggle") {
    if (p.paused || !p.prepared) {
      return resume(s);
    }
    return pause_play(s);
  }
  if (act == "next_now" && p.queue.len() > 0) {
    return play_next(s);
  }
  if (act == "next_cancel") {
    return App { ...s, play: Play { ...p, next_off: true, up_next_at: 0i64 }, dirty: true };
  }
  if (act == "skip") {
    if let Some(m) = plex.marker_at(p.item, p.position) {
      log.info("plex: skip the " + m.kind);
      return seek_to(s, m.end_ms);
    }
    return s;
  }
  if (act == "tracks") {
    return App { ...s, play: Play { ...p, sheet: true }, dirty: true };
  }
  if (act == "speed") {
    return cycle_speed(s);
  }
  if (act == "turn") {
    s.dev.turn(!s.turned);
    return App { ...s, turned: !s.turned, dirty: true };
  }
  if (act == "shuffle") {
    return toggle_shuffle(s);
  }
  if (act == "repeat") {
    return cycle_repeat(s);
  }
  if (act == "sleep") {
    return cycle_sleep(s);
  }
  if (act == "next_track" && p.queue.len() > 0) {
    return play_next(s);
  }
  if (act == "tracks_close") {
    return App { ...s, play: Play { ...p, sheet: false }, dirty: true };
  }
  if (act.starts_with("audio:")) {
    return choose(s, plex.Choice { ...p.choice, audio: act.drop(6).to_owned() });
  }
  if (act.starts_with("sub:")) {
    return choose(s, plex.Choice { ...p.choice, subtitle: act.drop(4).to_owned() });
  }
  if (act == "sync:-" || act == "sync:+") {
    let step = if (act == "sync:+") { DELAY_STEP } else { -DELAY_STEP };
    return App { ...s, play: Play { ...p, delay_ms: p.delay_ms + step }, dirty: true };
  }
  if (act == "rew") {
    return seek_by(s, -10000i64);
  }
  if (act == "ffw") {
    return seek_by(s, 30000i64);
  }
  if (act == "back") {
    return leave_player(s);
  }
  return s;
}

// Back on the player: music plays on while the screen before shows, with a
// bar that opens the player again. A video stops.
function leave_player(own s: App): App {
  if (!audio(s.play) || !s.play.active) {
    return stop_play(s, false);
  }
  return pop(App { ...s, play: Play { ...s.play, sheet: false } });
}

// --- touches and keys

function scroll_limit(s: App, m: ui.Metrics): i32 {
  let v = view(s);
  let visible = ui.content_bottom(m, s.screen) - ui.content_top(m);
  let h = 0;
  if (s.screen == ui.HOME) {
    h = ui.home_height(m, v);
  } else if (s.screen == ui.SEARCH) {
    h = ui.home_height(m, v) + 72 * m.u;
  } else if (s.screen == ui.LIBRARY) {
    h = ui.grid_height(m, s.items.len()) + ui.chips_height(m);
  } else if (s.screen == ui.DETAIL) {
    h = ui.detail_height(m, v);
  } else if (s.screen == ui.SECTIONS) {
    h = s.sections.len() * 64 * m.u + 16 * m.u;
  } else if (s.screen == ui.SERVERS) {
    h = s.servers.len() * 72 * m.u + 160 * m.u;
  } else if (s.screen == ui.DOWNLOADS) {
    h = ui.downloads_height(m, v);
  } else if (s.screen == ui.SETTINGS) {
    h = ui.settings_height(m, v);
  }
  if (h <= visible) {
    return 0;
  }
  return h - visible;
}

function clamp(v: i32, lo: i32, hi: i32): i32 {
  if (v < lo) {
    return lo;
  }
  if (v > hi) {
    return hi;
  }
  return v;
}

function row_index(group: string): i32 {
  if (group.starts_with("row:")) {
    return num(group.split_at(4).1);
  }
  return -1;
}

function row_offset(rows: i32[], i: i32): i32 {
  if (i >= 0 && i < rows.len()) {
    return rows[i];
  }
  return 0;
}

function set_row(rows: i32[], i: i32, v: i32): i32[] {
  let out = rows;
  while (out.len() <= i) {
    out = out.append(0);
  }
  return out.with(i, v);
}

function row_items(s: App, i: i32): i32 {
  let hubs = shown_hubs(s);
  if (i >= 0 && i < hubs.len()) {
    return hubs[i].items.len();
  }
  return 0;
}

function touch(own s: App, action: i32, x: f32, y: f32): App {
  if (s.focus.len() > 0) {
    s = App { ...s, focus: "", dirty: true };
  }
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let slop = (8 * m.u) as f32;
  let p = s.press;
  let t_ns = s.dev.mono_ms() * 1000000i64;
  if (action == 0) {
    let group = scene.group_at(s.nodes, x as i32, y as i32);
    let xs = [motion.Sample { t: t_ns, y: x as f64 }];
    let ys = [motion.Sample { t: t_ns, y: y as f64 }];
    let caught = s.fling.group.len() > 0;
    let pressed = Press { active: true, x0: x, y0: y, x: x, y: y, axis: 0, group: group, scroll0: s.scroll, row0: row_offset(s.rows, row_index(group)), xs: xs, ys: ys, caught: caught };
    if (group == "seek" && s.screen == ui.PLAYER) {
      return scrub(App { ...s, fling: no_fling(), press: pressed }, x as i32, false);
    }
    if (group == "az" && s.screen == ui.LIBRARY) {
      return jump_to_letter(App { ...s, fling: no_fling(), press: pressed }, letter_under(s.nodes, y as i32));
    }
    return App { ...s, fling: no_fling(), press: pressed };
  }
  if (p.active && p.group == "seek") {
    if (action == 2) {
      return scrub(s, x as i32, false);
    }
    return scrub(App { ...s, press: no_press() }, x as i32, action == 1);
  }
  if (p.active && p.group == "az") {
    // A finger that slides along the letter strip jumps to each letter.
    let i = letter_under(s.nodes, y as i32);
    if (action == 2) {
      return jump_to_letter(s, i);
    }
    return jump_to_letter(App { ...s, press: no_press() }, i);
  }
  if (!p.active) {
    return s;
  }
  p = Press { ...p, xs: motion.track(p.xs, motion.Sample { t: t_ns, y: x as f64 }), ys: motion.track(p.ys, motion.Sample { t: t_ns, y: y as f64 }) };
  if (action == 2) {
    let dx = x - p.x0;
    let dy = y - p.y0;
    let axis = p.axis;
    if (axis == 0 && (abs_f(dx) > slop || abs_f(dy) > slop)) {
      axis = 2;
      if (p.group.len() > 0 && abs_f(dx) > abs_f(dy)) {
        axis = 1;
      }
    }
    s = App { ...s, press: Press { ...p, x: x, y: y, axis: axis } };
    if (s.screen == ui.PLAYER) {
      return player_drag(s, axis != 0 && abs_f(dy) >= abs_f(dx));
    }
    if (axis == 1) {
      let i = row_index(p.group);
      let max = ui.hub_row_width(m, row_items(s, i)) - m.w;
      if (max < 0) {
        max = 0;
      }
      return App { ...s, rows: set_row(s.rows, i, clamp(p.row0 - dx as i32, 0, max)), dirty: true };
    }
    if (axis == 2) {
      let next = clamp(p.scroll0 - dy as i32, 0, scroll_limit(s, m));
      return more_items(App { ...s, scroll: next, dirty: true });
    }
    return s;
  }
  let t = App { ...s, press: no_press() };
  if (action == 1 && p.axis == 0 && !p.caught) {
    return tapped(t, x as i32, y as i32);
  }
  if (t.screen == ui.PLAYER) {
    return App { ...t, play: Play { ...t.play, gesture: 0 } };
  }
  if (action == 1 && p.axis != 0) {
    return flung(t, p, m);
  }
  return t;
}

// A drag up or down on the video: on its left half it sets the brightness
// of the window, and on its right half the volume. `vertical` is true when
// the finger moved more up or down than across. Each change shows its level.
// A drag from the top or the bottom edge belongs to Android, which opens
// its notifications or its navigation with it.
function player_drag(own s: App, vertical: boolean): App {
  let p = s.play;
  let pr = s.press;
  if (p.gesture == 0) {
    let on = "";
    if let Some(n) = scene.hit(s.nodes, pr.x0 as i32, pr.y0 as i32) {
      on = n.tap.name;
    }
    let edge = 48 * ui.metrics(s.w, s.h, s.top, s.bottom).u;
    let from_edge = pr.y0 < s.top.max(edge) as f32 || pr.y0 > (s.h - s.bottom.max(edge)) as f32;
    if (!vertical || !p.video || !p.drawn || from_edge || on != "overlay" && on != "hide") {
      return s;
    }
    if (pr.x0 < (s.w / 2) as f32) {
      let from = p.light;
      if (from < 0) {
        from = (s.dev.system_brightness() * 1000.0f32) as i32;
      }
      p = Play { ...p, gesture: 1, gesture_from: from, gesture_level: from, gesture_max: 1000 };
    } else {
      let (level, max) = s.dev.volume();
      if (max <= 0) {
        return s;
      }
      p = Play { ...p, gesture: 2, gesture_from: level, gesture_level: level, gesture_max: max };
    }
  }
  let span = (s.h * 3 / 5).max(1) as f32;
  let step = ((pr.y0 - pr.y) / span * (p.gesture_max as f32)) as i32;
  let level = (p.gesture_from + step).max(0).min(p.gesture_max);
  let now = s.dev.mono_ms();
  if (p.gesture == 1) {
    let lit = level.max(10);
    if (lit != p.gesture_level || p.light < 0) {
      s.dev.brightness(lit as f32 / 1000.0f32);
    }
    return App { ...s, play: Play { ...p, light: lit, gesture_level: lit, badge: s.texts.format("LIGHT {0}%", [(lit / 10).to_string()]), badge_until: now + BADGE_MS }, dirty: true };
  }
  if (level != p.gesture_level) {
    s.dev.set_volume(level);
  }
  return App { ...s, play: Play { ...p, gesture_level: level, badge: s.texts.format("VOLUME {0}", [level.to_string()]), badge_until: now + BADGE_MS }, dirty: true };
}

// The letter of the strip at height `y`, or -1. Above the strip it is the
// first letter, and below it the last.
function letter_under(nodes: scene.Node[], y: i32): i32 {
  let last = -1;
  for n in nodes {
    if (n.group == "az" && n.tap.name.starts_with("letter:")) {
      let i = num(n.tap.name.split_at(7).1);
      if (y < n.y + n.h && (i == 0 || y >= n.y)) {
        return i;
      }
      last = last.max(i);
    }
  }
  return last;
}

// Starts a fling of the list that the finger moved, at the speed of the
// finger when it left.
function flung(own s: App, p: Press, m: ui.Metrics): App {
  let group = "list";
  let start = s.scroll;
  let v = motion.velocity(p.ys);
  if (p.axis == 1) {
    group = p.group;
    start = row_offset(s.rows, row_index(group));
    v = motion.velocity(p.xs);
  }
  let f = motion.fling(start, 0.0 - v, m.u as f64, 0i64);
  if (!motion.moving(f)) {
    return s;
  }
  s.dev.request_frame();
  return App { ...s, fling: Fling { group: group, f: f } };
}

// Moves a flung list to its place at the frame time `ns`. The fling starts
// at the first frame after the finger leaves, and stops at an end.
function fling_frame(own s: App, ns: i64): App {
  let fl = s.fling;
  if (fl.group.len() == 0) {
    return s;
  }
  let f = fl.f;
  if (f.t0 == 0i64) {
    f = motion.Fling { ...f, t0: ns };
  }
  let (pos, done) = motion.position(f, ns);
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let at = pos as i32;
  let max = 0;
  if (fl.group == "list") {
    max = scroll_limit(s, m);
  } else {
    max = ui.hub_row_width(m, row_items(s, row_index(fl.group))) - m.w;
  }
  if (max < 0) {
    max = 0;
  }
  let next = clamp(at, 0, max);
  let edge = next != at;
  let t = if (fl.group == "list") {
    more_items(App { ...s, scroll: next, dirty: true })
  } else {
    App { ...s, rows: set_row(s.rows, row_index(fl.group), next), dirty: true }
  };
  if (done || edge) {
    return App { ...t, fling: no_fling() };
  }
  return App { ...t, fling: Fling { group: fl.group, f: f } };
}

function abs_f(v: f32): f32 {
  if (v < 0.0) {
    return 0.0 - v;
  }
  return v;
}

function tapped(own s: App, x: i32, y: i32): App {
  let Some(n) = scene.hit(s.nodes, x, y) else {
    if (s.typing) {
      s.dev.hide_field();
      return App { ...s, typing: false, dirty: true };
    }
    return s;
  };
  return act(s, n.tap.name, n, x);
}

// Runs the action of a tapped node.
pub function act(own s: App, a: string, n: scene.Node, x: i32): App {
  if (s.screen == ui.PLAYER) {
    return player_act(s, a, n, x);
  }
  if (s.menu.key.len() > 0) {
    return menu_act(s, a);
  }
  let t = App { ...s, error: "" };
  if (a == "signin") {
    return ask(t, "pin", NewPin);
  }
  if (a == "cancel") {
    return App { ...t, pin: plex.Pin { id: 0i64, code: "", token: "" }, dirty: true };
  }
  if (a == "refresh") {
    return open_servers(t);
  }
  if (a.starts_with("server:")) {
    return connect(t, num(a.split_at(7).1));
  }
  if (a.starts_with("tab:")) {
    return open_tab(t, num(a.split_at(4).1));
  }
  if (a.starts_with("section:")) {
    return open_section(t, num(a.split_at(8).1));
  }
  if (a.starts_with("sort:")) {
    let k = num(a.split_at(5).1);
    if (k == t.sort || k < 0 || k >= plex.sorts().len()) {
      return t;
    }
    return reload_library(App { ...t, sort: k });
  }
  if (a.starts_with("unwatched:")) {
    return reload_library(App { ...t, unwatched: a == "unwatched:1" });
  }
  if (a.starts_with("letter:")) {
    return jump_to_letter(t, num(a.split_at(7).1));
  }
  if (a == "back") {
    return pop(t);
  }
  if (a == "play" && t.local) {
    return play_saved(t);
  }
  if (a == "play") {
    return play_detail(t);
  }
  if (a == "remove" && t.local) {
    return remove_saved(t);
  }
  if (a == "watched") {
    return toggle_watched(t);
  }
  if (a == "type") {
    t.dev.show_field(t.query);
    return App { ...t, typing: true, dirty: true };
  }
  if (a == "servers") {
    return open_servers(push(t));
  }
  if (a == "quality") {
    return cycle_quality(t);
  }
  if (a == "lang") {
    return cycle_language(t);
  }
  if (a == "subs") {
    return cycle_subtitles(t);
  }
  if (a == "capsize") {
    let u = App { ...t, caption_size: [1, 2, 0][t.caption_size], dirty: true };
    save(u);
    return u;
  }
  if (a == "smartcount") {
    let u = App { ...t, smart_count: [1, 2, 3, 0][t.smart_count], dirty: true };
    save(u);
    let now = u.dev.mono_ms();
    return check_smart(u, now);
  }
  if (a == "capbox") {
    let u = App { ...t, caption_box: !t.caption_box, dirty: true };
    save(u);
    return u;
  }
  if (a == "users") {
    return open_users(t);
  }
  if (a == "now:open" && t.play.active) {
    return App { ...push(t), screen: ui.PLAYER, dirty: true };
  }
  if (a == "now:toggle" && t.play.active) {
    if (t.play.paused) {
      return resume(t);
    }
    return pause_play(t);
  }
  if (a == "downloads") {
    let title = t.texts.text("Downloads");
    return App { ...push(t), screen: ui.DOWNLOADS, title: title, scroll: 0, dirty: true };
  }
  if (a.starts_with("saved:")) {
    let at = num(a.split_at(6).1);
    if (at < t.downloads.len() && t.downloads[at].status == download.DONE) {
      let it = t.downloads[at].item;
      return start_play(t, it, []);
    }
    return t;
  }
  if (a.starts_with("unsave:")) {
    let at = num(a.split_at(7).1);
    if (at < t.downloads.len()) {
      return drop_download(t, at);
    }
    return t;
  }
  if (a.starts_with("user:")) {
    return pick_user(t, num(a.split_at(5).1));
  }
  if (a.starts_with("pinkey:")) {
    return pin_key(t, a.split_at(7).1.to_owned());
  }
  if (a == "signout") {
    return sign_out(t);
  }
  if let Some(it) = item_at(t, a) {
    if (t.screen == ui.DOWNLOADS) {
      return open_saved(t, it);
    }
    if (t.local && it.kind == "track") {
      let rest = t.children.drop(position_of(t.children.map((c: plex.Item): string => c.key), it.key)).drop(1);
      return start_play(t, it, rest);
    }
    if (t.local) {
      return App { ...push(t), screen: ui.DETAIL, title: plex.card_title(it), item: it, children: [], scroll: 0, dirty: true };
    }
    return open_item(t, it);
  }
  return t;
}

const KEY_BACK: i32 = 4;

const KEY_ENTER: i32 = 66;

const KEY_DEL: i32 = 67;

// The back key and the back gesture of Android run the action of the close
// or back control that the screen shows.
function back(own s: App): App {
  if (s.typing) {
    s.dev.hide_field();
    return App { ...s, typing: false, dirty: true };
  }
  let none = scene.node(0, 0, 0, 0, scene.Blank);
  if (s.menu.key.len() > 0) {
    return act(s, "menu:close", none, 0);
  }
  if (s.pin_for.len() > 0) {
    return act(s, "pinkey:cancel", none, 0);
  }
  if (s.screen == ui.PLAYER && s.play.sheet) {
    return act(s, "tracks_close", none, 0);
  }
  if (s.screen == ui.LOGIN && s.pin.code.len() > 0) {
    return act(s, "cancel", none, 0);
  }
  if (s.screen == ui.PLAYER || s.stack.len() > 0) {
    return act(s, "back", none, 0);
  }
  if (s.screen != ui.HOME && s.screen != ui.LOGIN && s.screen != ui.SERVERS) {
    return open_tab(s, 0);
  }
  s.dev.finish();
  return s;
}

function key(own s: App, code: i32, action: i32): App {
  if (action == 0 && !s.typing) {
    return remote_key(s, code);
  }
  if (action != 1) {
    return s;
  }
  if (code == KEY_BACK) {
    return back(s);
  }
  if (!s.typing) {
    return s;
  }
  if (code == KEY_DEL && s.query.len() > 0) {
    let q = drop_last(s.query);
    return keyed(s, q);
  }
  if (code == KEY_ENTER) {
    return search_now(s);
  }
  return s;
}

// The keys of a TV remote, a game pad or a keyboard that move the focus
// and press the focused node, and the media keys.
const KEY_UP: i32 = 19;

const KEY_DOWN: i32 = 20;

const KEY_LEFT: i32 = 21;

const KEY_RIGHT: i32 = 22;

const KEY_CENTER: i32 = 23;

const KEY_BUTTON_A: i32 = 96;

const KEY_PLAY_PAUSE: i32 = 85;

// KEYCODE_SEARCH.
const KEY_SEARCH: i32 = 84;

const KEY_REWIND: i32 = 89;

const KEY_FAST_FORWARD: i32 = 90;

const KEY_MEDIA_PLAY: i32 = 126;

const KEY_MEDIA_PAUSE: i32 = 127;

// A key that went down. On the video with no controls, left and right
// seek as the buttons do, and the other keys of the D-pad show the
// controls. Elsewhere the D-pad moves the focus, and the centre presses it.
function remote_key(own s: App, code: i32): App {
  let p = s.play;
  if (s.screen == ui.PLAYER && p.active) {
    if (code == KEY_PLAY_PAUSE || code == KEY_MEDIA_PLAY && p.paused || code == KEY_MEDIA_PAUSE && !p.paused) {
      return player_control(s, "toggle", scene.node(0, 0, 0, 0, scene.Blank), 0);
    }
    if (code == KEY_REWIND) {
      return seek_by(s, -10000i64);
    }
    if (code == KEY_FAST_FORWARD) {
      return seek_by(s, 30000i64);
    }
    if (p.video && !p.overlay && p.drawn) {
      if (code == KEY_LEFT) {
        return seek_by(s, -10000i64);
      }
      if (code == KEY_RIGHT) {
        return seek_by(s, 30000i64);
      }
      if (code == KEY_UP || code == KEY_DOWN || code == KEY_CENTER || code == KEY_ENTER || code == KEY_BUTTON_A) {
        let until = s.dev.mono_ms() + CONTROLS_MS;
        return App { ...s, play: Play { ...p, overlay: true, controls_until: until }, focus: "toggle", dirty: true };
      }
    }
  }
  if (code == KEY_UP) {
    return move_focus(s, 0, -1);
  }
  if (code == KEY_DOWN) {
    return move_focus(s, 0, 1);
  }
  if (code == KEY_LEFT) {
    return move_focus(s, -1, 0);
  }
  if (code == KEY_RIGHT) {
    return move_focus(s, 1, 0);
  }
  if (code == KEY_CENTER || code == KEY_ENTER || code == KEY_BUTTON_A) {
    return press_focus(s);
  }
  // The Search key of a remote opens the search with the keyboard, whose
  // microphone takes the words by voice.
  if (code == KEY_SEARCH && s.screen != ui.PLAYER && ui.has_tabs(s.screen)) {
    let t = open_tab(s, 2);
    t.dev.show_field(t.query);
    return App { ...t, typing: true, dirty: true };
  }
  return s;
}

// Whether node `n` can take the focus: it acts, and it is not a veil over
// most of the screen. The seek bar takes the left and right keys instead.
function focusable(n: scene.Node, w: i32, h: i32): boolean {
  return n.acts() && n.w * n.h * 2 < w * h && n.tap.name != "seek";
}

// The node of the focus, or -1.
function focus_index(s: App): i32 {
  if (s.focus.len() == 0) {
    return -1;
  }
  for k in 0..s.nodes.len() {
    if (s.nodes[k].tap.name == s.focus && focusable(s.nodes[k], s.w, s.h)) {
      return k;
    }
  }
  return -1;
}

// The node that the focus moves to from node `k` in the direction (dx, dy):
// the nearest whose centre is that way, with a side offset counting three
// times as much as the distance along the direction. With no focus, the
// node at the top left.
function next_focus(s: App, k: i32, dx: i32, dy: i32): i32 {
  let best = -1;
  let best_score = 0;
  for j in 0..s.nodes.len() {
    let n = s.nodes[j];
    if (j == k || !focusable(n, s.w, s.h) || k >= 0 && n.tap.name == s.nodes[k].tap.name) {
      continue;
    }
    let cx = n.x + n.w / 2;
    let cy = n.y + n.h / 2;
    let score = cy * 4 + cx;
    if (k >= 0) {
      let f = s.nodes[k];
      let ox = cx - (f.x + f.w / 2);
      let oy = cy - (f.y + f.h / 2);
      let along = ox * dx + oy * dy;
      if (along <= 0) {
        continue;
      }
      score = along + 3 * (ox * dy + oy * dx).abs();
    }
    if (best < 0 || score < best_score) {
      best = j;
      best_score = score;
    }
  }
  return best;
}

function move_focus(own s: App, dx: i32, dy: i32): App {
  let j = next_focus(s, focus_index(s), dx, dy);
  if (j < 0) {
    return s;
  }
  let n = s.nodes[j];
  let t = App { ...s, focus: n.tap.name, dirty: true };
  if (t.screen == ui.PLAYER) {
    let until = t.dev.mono_ms() + CONTROLS_MS;
    return App { ...t, play: Play { ...t.play, controls_until: until } };
  }
  return show_focus(t, n);
}

// Scrolls the list that holds the focused node `n` until all of it shows.
function show_focus(own s: App, n: scene.Node): App {
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let pad = 16 * m.u;
  let i = row_index(n.group);
  if (i >= 0) {
    let at = row_offset(s.rows, i);
    let max = (ui.hub_row_width(m, row_items(s, i)) - m.w).max(0);
    if (n.x < pad) {
      at -= pad - n.x;
    } else if (n.x + n.w > m.w - pad) {
      at += n.x + n.w - (m.w - pad);
    }
    s = App { ...s, rows: set_row(s.rows, i, clamp(at, 0, max)) };
  }
  let top = ui.content_top(m);
  if (s.screen == ui.LIBRARY) {
    top += ui.chips_height(m);
  }
  let bottom = ui.content_bottom(m, s.screen);
  let next = s.scroll;
  if (n.y < top && n.y + n.h <= bottom) {
    next -= top - n.y + pad;
  } else if (n.y + n.h > bottom && n.y >= top) {
    next += n.y + n.h - bottom + pad;
  }
  return more_items(App { ...s, scroll: clamp(next, 0, scroll_limit(s, m)), fling: no_fling() });
}

// Presses the focused node, as a tap at its centre does.
function press_focus(own s: App): App {
  let k = focus_index(s);
  if (k < 0) {
    return move_focus(s, 0, 1);
  }
  let n = s.nodes[k];
  return act(s, n.tap.name, n, n.x + n.w / 2);
}

// The nodes of the screen with a ring around the focused node.
function with_focus(own nodes: scene.Node[], focus: string, u: i32): scene.Node[] {
  if (focus.len() == 0) {
    return nodes;
  }
  for n in nodes {
    if (n.tap.name == focus && n.acts()) {
      let g = 3 * u;
      let ring = scene.node(n.x - g, n.y - g, n.w + 2 * g, n.h + 2 * g, scene.Outline(draw.rgba(255, 255, 255, 255), 12 * u, 2 * u));
      return nodes.append(ring);
    }
  }
  return nodes;
}

function drop_last(q: string): string {
  let cs: string[] = [];
  for c in q.chars() {
    cs = cs.append(c.to_string());
  }
  return cs.take(cs.len() - 1).join("");
}

function typed(own s: App, c: i32): App {
  if (!s.typing || c < 32 || c == 127) {
    return s;
  }
  let q = s.query + char_string(c);
  return keyed(s, q);
}

// A key of a hardware keyboard changes the query, so the field of the
// keyboard of the system gets the same text.
function keyed(own s: App, q: string): App {
  s.dev.set_field(q);
  return query_changed(s, q);
}

// The typing ends and the search starts at once.
function search_now(own s: App): App {
  s.dev.hide_field();
  return App { ...s, typing: false, search_at: s.dev.mono_ms(), dirty: true };
}

function char_string(c: i32): string {
  return utf8.encode(c as char);
}

function query_changed(own s: App, q: string): App {
  return App { ...s, query: q, search_at: s.dev.mono_ms() + SEARCH_MS, dirty: true };
}

function search_tick(own s: App, now: i64): App {
  if (s.search_at == 0i64 || now < s.search_at) {
    return s;
  }
  let q = s.query;
  if (q.trim().len() == 0) {
    return App { ...s, search_at: 0i64, results: [], dirty: true };
  }
  return ask(App { ...s, search_at: 0i64 }, "search:" + q, Search(q));
}

function pin_tick(own s: App, now: i64): App {
  if (s.pin.id == 0i64 || now < s.pin_at || s.screen != ui.LOGIN) {
    return s;
  }
  for a in s.asks {
    if (a.purpose == "pincheck") {
      return s;
    }
  }
  if (has_call(s.api, "pincheck")) {
    return s;
  }
  return ask(App { ...s, pin_at: now + PIN_MS }, "pincheck", CheckPin(s.pin.id));
}

// --- the loop

pub function view(s: App): ui.View {
  let hubs = shown_hubs(s);
  let p = s.play;
  let (vw, vh) = if (p.images.len() > 0) { s.dev.video_size() } else { (0, 0) };
  let pv = ui.PlayerView { title: p.item.title, subtitle: player_subtitle(p.item) + mode_text(s.texts, p), position_ms: p.position, duration_ms: p.duration, paused: p.paused, buffering: p.buffering, overlay: p.overlay || s.screen == ui.PLAYER && !p.video, over_video: p.video && p.overlay, skip: s.texts.text(skip_label(p)), up_next: next_title(p), up_next_secs: up_next_secs(p, s.dev.mono_ms()), badge: p.badge, sheet: p.sheet, sounds: plex.audio_tracks(p.item), subtitles: plex.subtitle_tracks(p.item), choice: p.choice, speed: speed_text(s.speed), shuffle: s.shuffle, repeat: repeat_text(s.texts, s.repeat), sleep: sleep_text(s.texts, s.sleep), has_next: p.queue.len() > 0, caption: caption_of(p), scrub_ms: p.scrub_ms, thumb: p.thumb, thumb_key: "bif|" + p.item.key + "|" + p.thumb_index.to_string(), art: art_of(p.item), audio: audio(p), status: s.texts.text(p.status), turned: s.turned, pictures: p.images, video_w: vw, video_h: vh, delay: delay_shown(p), caption_size: s.caption_size, caption_box: s.caption_box };
  return ui.View {
    ...ui.empty_view(s.w, s.h),
    texts: s.texts,
    top: s.top, bottom: s.bottom,
    screen: s.screen, tab: s.tab, title: s.title, scroll: s.scroll, rows: s.rows, hubs: hubs,
    sections: s.sections, items: s.items, total: s.total, sort: s.sort, unwatched: s.unwatched, letters: s.letters, menu: s.menu, menu_download: download_percent(s, s.menu.key), menu_smart: s.smart.contains(s.menu.key), saved: waiting_rows(s), saved_done: s.downloads.filter((d: Saved): boolean => d.status == download.DONE).len(), saved_total: s.downloads.len(), now_playing: if (s.play.active && s.screen != ui.PLAYER) { p.item.title + " · " + p.item.grandparent } else { "" }, users: s.users, pin_for: s.pin_for, pin_digits: s.pin_digits, item: s.item, children: s.children,
    pin_code: s.pin.code, error: if (offline_home(s)) { "" } else { s.texts.text(s.error) }, offline: offline_home(s), servers: s.servers, server_states: s.states,
    query: s.query, typing: s.typing, account: s.account, server_name: s.server.name,
    quality: plex.qualities()[s.quality].name, language: language_text(s), subtitles: subtitles_text(s), caption_size: s.texts.text(["Small", "Medium", "Large"][s.caption_size]), caption_back: s.texts.text(if (s.caption_box) { "Panel" } else { "Shadow" }), smart: s.texts.format("{0} episodes", [smart_counts()[s.smart_count].to_string()]), player: pv, base: s.base,
    loading: busy(s), cache: s.cache, local: s.local,
  };
}

// How the stream reaches the player, after the subtitle.
function mode_text(texts: i18n.Strings, p: Play): string {
  if (!p.active || p.stream.url.len() == 0) {
    return "";
  }
  if (p.stream.transcode) {
    return " · " + texts.text("Transcode");
  }
  return " · " + texts.text("Direct play");
}

// The words of the next item on its card, or "".
function next_title(p: Play): string {
  if (p.queue.len() == 0) {
    return "";
  }
  let it = p.queue[0];
  if (it.kind == "episode") {
    return plex.episode_code(it) + " · " + it.title;
  }
  return it.title;
}

function player_subtitle(it: plex.Item): string {
  if (it.kind == "episode") {
    return it.grandparent + " · " + plex.episode_code(it);
  }
  if (it.kind == "track") {
    return it.grandparent;
  }
  if (it.year > 0) {
    return it.year.to_string();
  }
  return "";
}

function busy(s: App): boolean {
  return s.asks.len() > 0 || is_some_call(s.api);
}

function is_some_call(c: Option[Call]): boolean {
  match (c) {
    Some(_) => {
      return true;
    },
    None => {
      return false;
    }
  }
}

function is_some_batch(b: Option[Batch]): boolean {
  match (b) {
    Some(_) => {
      return true;
    },
    None => {
      return false;
    }
  }
}

// The milliseconds to wait for the next event before a Tick.
pub function timeout(s: App, now: i64): i32 {
  if (is_some_call(s.api) || is_some_batch(s.img) || is_some_call(s.report) || s.asks.len() > 0 || s.reports.len() > 0 || s.probes.len() > 0 || s.left.len() > 0) {
    return 30;
  }
  if (s.play.active && s.play.prepared) {
    if (s.play.paused) {
      return clamp((s.play.reported_at + REPORT_MS - now) as i32, 1, REPORT_MS as i32);
    }
    return 500;
  }
  let held = hold_from(s);
  if (held >= 0i64) {
    return clamp((held + HOLD_MS - now) as i32, 1, HOLD_MS as i32);
  }
  if (s.search_at > 0i64) {
    return clamp((s.search_at - now) as i32, 1, 1000);
  }
  if (s.pin.id != 0i64) {
    return clamp((s.pin_at - now) as i32, 1, 2000);
  }
  if (s.shown && downloading(s)) {
    return clamp((s.downloads_at + DOWNLOAD_MS - now) as i32, 1, DOWNLOAD_MS as i32);
  }
  return -1;
}

function event(own s: App, e: android.Event): App {
  if let Some(c) = player.event(e) {
    if (s.dev.from_next(e)) {
      return next_event(s, c);
    }
    return player_event(s, c);
  }
  if let Some(c) = focus.event(e) {
    return focus_changed(s, c);
  }
  if let Some(c) = session.event(e) {
    return media_command(s, c);
  }
  if let Some(b) = browse.event(e) {
    return browse_event(s, b);
  }
  match (e) {
    android.Start => {
      return App { ...s, shown: true, dirty: true };
    },
    android.Stop => {
      return App { ...s, shown: false };
    },
    android.Pause => {
      // Music plays on while the app is away. A video pauses, unless it
      // plays on in a picture-in-picture window.
      if (s.play.active && s.play.prepared && !s.play.paused && !audio(s.play) && !s.dev.in_pip()) {
        return pause_play(s);
      }
      return s;
    },
    android.WindowCreated(w) => {
      let (ww, wh) = s.dev.size(w.ptr);
      let gpu = s.dev.attach(w.ptr);
      return App { ...s, window: w.ptr, w: ww, h: wh, gpu: gpu, dirty: true };
    },
    android.WindowResized(w) => {
      let (ww, wh) = s.dev.size(w.ptr);
      let gpu = s.gpu;
      if (w.ptr != s.window) {
        gpu = s.dev.attach(w.ptr);
      }
      return App { ...s, window: w.ptr, w: ww, h: wh, gpu: gpu, dirty: true };
    },
    android.WindowRedraw(w) => {
      return App { ...s, window: w.ptr, dirty: true };
    },
    android.ContentRect(_, top, _, bottom) => {
      let b = s.h - bottom;
      if (b < 0 || s.h == 0) {
        b = 0;
      }
      return App { ...s, top: top, bottom: b, dirty: true };
    },
    android.WindowDestroyed(_) => {
      let t = s;
      if (t.play.video) {
        t = pause_play(t);
      }
      t.dev.detach();
      return App { ...t, window: 0 as usize, gpu: false, fling: no_fling() };
    },
    android.Vsync(ns) => {
      return frame(s, ns);
    },
    android.Touch(action, x, y) => {
      return touch(s, action, x, y);
    },
    android.Access(id, action) => {
      return access_act(s, id, action);
    },
    android.Key(code, action) => {
      return key(s, code, action);
    },
    android.Char(c) => {
      return typed(s, c);
    },
    android.Text(q) => {
      if (!s.typing) {
        return s;
      }
      return query_changed(s, q);
    },
    android.TextAction(_) => {
      if (!s.typing) {
        return s;
      }
      return search_now(s);
    },
    _ => {
      return s;
    }
  }
}

// Makes the nodes of the screen when it changed. With the GPU, they draw
// at the next vsync. With the CPU, they draw at once, unless the player
// has the window.
// The items of the screen for an accessibility service: each node with
// words, by its index. A node with an action is a button. A poster reads
// the title of its item, and a long press opens its menu.
function access_items(s: App): android.AccessItem[] {
  let out: android.AccessItem[] = [];
  for i in 0..s.nodes.len() {
    let n = s.nodes[i];
    let text = n.say;
    let actions = 0;
    if (n.tap.name.len() > 0) {
      actions = android.ACCESS_CLICK;
      if let Some(it) = item_at(s, n.tap.name) {
        if (it.key.len() > 0) {
          text = plex.card_title(it);
          actions |= android.ACCESS_LONG_CLICK;
        }
      }
    }
    if (text.len() > 0) {
      out = out.append(android.AccessItem { id: i, x: n.x, y: n.y, w: n.w, h: n.h, text: text, actions: actions });
    }
  }
  return out;
}

// A double tap of an accessibility service on an item taps its node, and a
// double tap and hold on a poster opens its menu.
function access_act(own s: App, id: i32, action: i32): App {
  if (id < 0 || id >= s.nodes.len()) {
    return s;
  }
  let n = s.nodes[id];
  if (action == android.ACCESS_LONG_CLICK) {
    if let Some(it) = item_at(s, n.tap.name) {
      if (it.key.len() > 0) {
        return App { ...s, menu: it, dirty: true };
      }
    }
    return s;
  }
  if (n.tap.name.len() == 0) {
    return s;
  }
  return act(s, n.tap.name, n, n.x + n.w / 2);
}

function draw_screen(own s: App): App {
  if (!s.dirty || s.window == 0 as usize || s.w == 0) {
    return s;
  }
  let m = ui.metrics(s.w, s.h, s.top, s.bottom);
  let t = App { ...s, nodes: with_focus(ui.nodes(view(s)), s.focus, m.u), dirty: false };
  t.dev.access(access_items(t));
  if (t.gpu) {
    t.dev.request_frame();
    return App { ...t, paint: true };
  }
  if (!t.play.video) {
    let f = t.dev.lock(t.window);
    if (f.width > 0) {
      let c = scene.render(f, text.from_faces([], []), text.new_cache(), t.nodes);
    }
    t.dev.post(f);
  }
  return t;
}

// The frame at the vsync `ns`: a fling moves to that time, and the GPU
// draws the screen when it changed, and each frame of a video with its
// controls over it.
function frame(own s: App, ns: i64): App {
  let t = draw_screen(fling_frame(s, ns));
  let more = t.fling.group.len() > 0;
  if (t.gpu && t.window != 0 as usize) {
    if (t.play.video) {
      let over: scene.Node[] = [];
      if (t.play.overlay || skip_label(t.play).len() > 0 || t.play.up_next_at > 0i64 || t.play.badge.len() > 0) {
        over = t.nodes;
      }
      if (t.dev.present(t.window, over, true)) {
        more = true;
        if (!t.play.drawn) {
          t = App { ...t, play: Play { ...t.play, drawn: true } };
        }
      }
    } else if (t.paint) {
      let shown = t.dev.present(t.window, t.nodes, false);
    }
    t = App { ...t, paint: false };
  }
  if (more) {
    t.dev.request_frame();
  }
  return t;
}

// The state after event `e`: the app handles it, polls its workers, starts
// the next requests and draws the screen when it changed.
pub function step(own s: App, e: android.Event): App {
  let now = s.dev.mono_ms();
  let t = smart_tick(download_tick(hold_tick(search_tick(pin_tick(line_up(play_tick(event(s, e), now)), now), now), now), now), now);
  t = poll_probes(poll_report(poll_images(poll_api(t))));
  t = start_report(start_api(t));
  t = draw_screen(untwist(t));
  return start_images(t);
}

// The screen that `turn` kept in the shape of the video follows the device
// again once the player is gone.
function untwist(own s: App): App {
  if (!s.turned || s.screen == ui.PLAYER) {
    return s;
  }
  s.dev.turn(false);
  return App { ...s, turned: false };
}

// Joins the workers that still run, and stops the player.
pub function close(own s: App): void {
  if (s.play.active) {
    s.dev.stop();
  }
  for p in s.probes {
    let Probe { conn, w } = p;
    let rs = w.join();
  }
  for w in s.left {
    let rs = w.join();
  }
  if let Some(c) = s.api {
    let rs = c.w.join();
  }
  if let Some(b) = s.img {
    let rs = b.w.join();
  }
  if let Some(r) = s.report {
    let rs = r.w.join();
  }
}
