// The Plex model of the app: the requests that it sends to plex.tv and to a
// media server, and the records that it reads from their JSON replies. Every
// function is pure. control.fern sends the requests through its Device.
import "std/json";
import "std/option";
import "std/string";
import "std/url";
import "std/utf8";

pub const PRODUCT: string = "Fern for Plex";

pub const VERSION: string = "1.0";

pub const PLEX_TV: string = "https://plex.tv";

pub const CLIENTS: string = "https://clients.plex.tv";

// The page at which the user types the code of a PIN.
pub const LINK_PAGE: string = "plex.tv/link";

// One HTTP request. A worker of app.fern sends it.
pub struct Request { method: string, url: string, headers: (string, string)[], body: string }

// The reply to a Request. `status` is 0 and `error` says why when no reply
// came.
pub struct Reply { status: i32, body: u8[], error: string }

// The client that sends the requests. `id` is the X-Plex-Client-Identifier,
// which stays the same for one installation. `token` is the token of the
// account, or of the server for a request to a server.
pub struct Client { id: string, device: string, token: string }

pub function (c: Client) with_token(token: string): Client {
  return Client { ...c, token: token };
}

// The headers that each request carries.
pub function headers(c: Client): (string, string)[] {
  let out: (string, string)[] = [
    ("Accept", "application/json"),
    ("X-Plex-Product", PRODUCT),
    ("X-Plex-Version", VERSION),
    ("X-Plex-Client-Identifier", c.id),
    ("X-Plex-Platform", "Android"),
    ("X-Plex-Device", c.device),
    ("X-Plex-Device-Name", c.device),
  ];
  if (c.token.len() > 0) {
    out = out.append(("X-Plex-Token", c.token));
  }
  return out;
}

pub function get(c: Client, u: string): Request {
  return Request { method: "GET", url: u, headers: headers(c), body: "" };
}

pub function put(c: Client, u: string): Request {
  return Request { method: "PUT", url: u, headers: headers(c), body: "" };
}

pub function post(c: Client, u: string): Request {
  return Request { method: "POST", url: u, headers: headers(c), body: "" };
}

pub function (r: Reply) ok(): boolean {
  return r.status >= 200 && r.status < 300;
}

// The reply as text, for a JSON body.
pub function (r: Reply) text(): string {
  return utf8.from_bytes_lossy(r.body);
}

// What went wrong with a reply that is not ok, for the screen.
pub function (r: Reply) problem(): string {
  if (r.status == 0) {
    if (r.error.len() > 0) {
      return r.error;
    }
    return "no reply";
  }
  if (r.status == 401) {
    return "not signed in (401)";
  }
  return "HTTP " + r.status.to_string();
}

// --- JSON fields

function text_at(d: json.Document, n: i32): string {
  if let Some(s) = d.as_string(n) {
    return s;
  }
  if let Some(t) = d.number_text(n) {
    return t;
  }
  if let Some(b) = d.as_bool(n) {
    if (b) {
      return "true";
    }
    return "false";
  }
  return "";
}

// The text of field `key` of object `n`, or "".
pub function str(d: json.Document, n: i32, key: string): string {
  if let Some(v) = d.get(n, key) {
    return text_at(d, v);
  }
  return "";
}

// The integer of field `key` of object `n`, or 0. A string of digits counts.
pub function int(d: json.Document, n: i32, key: string): i64 {
  if let Some(v) = d.get(n, key) {
    if let Some(i) = d.as_i64(v) {
      return i;
    }
    if let Some(f) = d.as_f64(v) {
      return f as i64;
    }
    return digits(text_at(d, v));
  }
  return 0i64;
}

function digits(s: string): i64 {
  let v = 0i64;
  let any = false;
  for c in s.bytes() {
    if (c < 48u8 || c > 57u8) {
      if (any) {
        return v;
      }
      return 0i64;
    }
    v = v * 10i64 + (c - 48u8) as i64;
    any = true;
  }
  return v;
}

pub function flag(d: json.Document, n: i32, key: string): boolean {
  if let Some(v) = d.get(n, key) {
    if let Some(b) = d.as_bool(v) {
      return b;
    }
    let t = text_at(d, v);
    return t == "1" || t == "true";
  }
  return false;
}

// The elements of the array field `key` of object `n`.
pub function elements(d: json.Document, n: i32, key: string): i32[] {
  let out: i32[] = [];
  let Some(a) = d.get(n, key) else {
    return out;
  };
  return items_of(d, a);
}

pub function items_of(d: json.Document, a: i32): i32[] {
  let out: i32[] = [];
  if (!d.is_array(a)) {
    return out;
  }
  let c = d.first(a);
  while (c >= 0) {
    out = out.append(c);
    c = d.next(a, c);
  }
  return out;
}

// The MediaContainer of a reply of a server, or the root when it has none.
pub function container(d: json.Document): i32 {
  if let Some(m) = d.get(d.root(), "MediaContainer") {
    return m;
  }
  return d.root();
}

// --- plex.tv: the sign-in with a PIN

// A PIN of plex.tv. The user types `code` at plex.tv/link. `token` is the
// token of the account once the user has done so.
pub struct Pin { id: i64, code: string, token: string }

pub function pin_request(c: Client): Request {
  return post(c, PLEX_TV + "/api/v2/pins?strong=false");
}

pub function pin_check(c: Client, id: i64): Request {
  return get(c, PLEX_TV + "/api/v2/pins/" + id.to_string());
}

pub function parse_pin(body: string): Option[Pin] {
  let Ok(d) = json.parse_document(body) else {
    return None;
  };
  let r = d.root();
  let id = int(d, r, "id");
  if (id == 0i64) {
    return None;
  }
  return Some(Pin { id: id, code: str(d, r, "code"), token: str(d, r, "authToken") });
}

// The account at plex.tv. `language` is the default language of its sound,
// and `subtitles` is the mode of its subtitles, one of SUBS_*, or -1.
pub struct Account { name: string, email: string, language: string, subtitles: i32 }

pub function user_request(c: Client): Request {
  return get(c, PLEX_TV + "/api/v2/user");
}

// A user of the Plex Home of the account. A protected user has a PIN.
pub struct HomeUser { uuid: string, title: string, protected: boolean, admin: boolean }

pub function home_users(c: Client): Request {
  return get(c, CLIENTS + "/api/v2/home/users");
}

pub function parse_home_users(body: string): HomeUser[] {
  let out: HomeUser[] = [];
  let Ok(d) = json.parse_document(body) else {
    return out;
  };
  for n in elements(d, d.root(), "users") {
    let uuid = str(d, n, "uuid");
    if (uuid.len() > 0) {
      out = out.append(HomeUser { uuid: uuid, title: str(d, n, "title"), protected: flag(d, n, "protected"), admin: flag(d, n, "admin") });
    }
  }
  return out;
}

// Switches the account to Home user `uuid`, with `pin` when the user has
// one. The reply holds the token of that user.
pub function switch_user(c: Client, uuid: string, pin: string): Request {
  let u = CLIENTS + "/api/v2/home/users/" + url.encode(uuid) + "/switch";
  if (pin.len() > 0) {
    u = u + "?" + url.query_encode([("pin", pin)]);
  }
  return post(c, u);
}

// The token in the reply of a switch, or "".
pub function parse_switch(body: string): string {
  let Ok(d) = json.parse_document(body) else {
    return "";
  };
  return str(d, d.root(), "authToken");
}

pub function parse_account(body: string): Account {
  let Ok(d) = json.parse_document(body) else {
    return Account { name: "", email: "", language: "", subtitles: -1 };
  };
  let r = d.root();
  let name = str(d, r, "friendlyName");
  if (name.len() == 0) {
    name = str(d, r, "username");
  }
  if (name.len() == 0) {
    name = str(d, r, "title");
  }
  let language = "";
  let subtitles = -1;
  if let Some(profile) = d.get(r, "profile") {
    language = str(d, profile, "defaultAudioLanguage");
    if let Some(mode) = d.get(profile, "autoSelectSubtitle") {
      if let Some(m) = d.as_i64(mode) {
        if (m >= 0i64 && m <= 2i64) {
          subtitles = m as i32;
        }
      }
    }
  }
  return Account { name: name, email: str(d, r, "email"), language: language, subtitles: subtitles };
}

// --- plex.tv: the servers of the account

// A connection of a server. `address` and `port` are the IP address and
// the port that `uri` names, and `protocol` is "https" or "http".
pub struct Connection { uri: string, local: boolean, relay: boolean, address: string, port: i32, protocol: string, ipv6: boolean }

pub struct Server { name: string, id: string, token: string, owned: boolean, connections: Connection[] }

pub function resources_request(c: Client): Request {
  return get(c, CLIENTS + "/api/v2/resources?includeHttps=1&includeRelay=1");
}

pub function parse_servers(body: string): Server[] {
  let out: Server[] = [];
  let Ok(d) = json.parse_document(body) else {
    return out;
  };
  for n in items_of(d, d.root()) {
    if (str(d, n, "provides").contains("server")) {
      out = out.append(server_of(d, n));
    }
  }
  return out;
}

function server_of(d: json.Document, n: i32): Server {
  let conns: Connection[] = [];
  for c in elements(d, n, "connections") {
    let uri = str(d, c, "uri");
    if (uri.len() > 0) {
      conns = conns.append(Connection { uri: uri, local: flag(d, c, "local"), relay: flag(d, c, "relay"), address: str(d, c, "address"), port: int(d, c, "port") as i32, protocol: str(d, c, "protocol"), ipv6: flag(d, c, "IPv6") });
    }
  }
  return Server { name: str(d, n, "name"), id: str(d, n, "clientIdentifier"), token: str(d, n, "accessToken"), owned: flag(d, n, "owned"), connections: conns };
}

// The addresses of a server in the order to try them: local, then the
// plain HTTP address of each local one on a private network, then remote,
// then the relay of plex.tv, which is slow and limited. IPv4 comes before
// IPv6 in each group.
//
// The HTTP address needs no name lookup. A resolver can refuse a
// plex.direct name with a private address, as a VPN such as Tailscale can.
// Plezy does the same, and only for a private address, because each
// request carries the token.
pub function connection_order(s: Server): string[] {
  let out: string[] = [];
  for v6 in [false, true] {
    for c in s.connections {
      if (c.local && !c.relay && c.ipv6 == v6) {
        out = add_new(out, c.uri);
      }
    }
  }
  for v6 in [false, true] {
    for c in s.connections {
      if (c.ipv6 == v6) {
        out = add_new(out, http_fallback(c));
      }
    }
  }
  for v6 in [false, true] {
    for c in s.connections {
      if (!c.local && !c.relay && c.ipv6 == v6) {
        out = add_new(out, c.uri);
      }
    }
  }
  for c in s.connections {
    if (c.relay) {
      out = add_new(out, c.uri);
    }
  }
  return out;
}

function add_new(own out: string[], uri: string): string[] {
  if (uri.len() == 0) {
    return out;
  }
  for u in out {
    if (u == uri) {
      return out;
    }
  }
  return out.append(uri);
}

// The plain HTTP address of a local HTTPS connection on a private network,
// as "http://address:port", or "".
pub function http_fallback(c: Connection): string {
  if (!c.local || c.relay || c.protocol != "https" || c.port <= 0 || !private_host(c.address)) {
    return "";
  }
  if (!c.uri.contains(".plex.direct") && !ip_literal(c.address)) {
    return "";
  }
  let host = c.address;
  if (host.contains(":") && !host.starts_with("[")) {
    host = "[" + host + "]";
  }
  return "http://" + host + ":" + c.port.to_string();
}

// The four numbers of an IPv4 address, or None.
function ipv4_parts(host: string): Option[i32[]] {
  let parts = host.split(".");
  if (parts.len() != 4) {
    return None;
  }
  let out: i32[] = [];
  for p in parts {
    if (p.len() == 0 || p.len() > 3 || digits(p) > 255i64) {
      return None;
    }
    for b in p.bytes() {
      if (b < 48u8 || b > 57u8) {
        return None;
      }
    }
    out = out.append(digits(p) as i32);
  }
  return Some(out);
}

function ip_literal(host: string): boolean {
  if let Some(_) = ipv4_parts(host) {
    return true;
  }
  return host.contains(":");
}

// Whether `host` is on a private network: an IPv4 address of 10/8,
// 172.16/12, 192.168/16, 100.64/10 (the carrier-grade NAT range that
// Tailscale uses), 127/8 or 169.254/16, a unique local IPv6 address
// (fc00::/7), or a name of a local network such as "nas.local" or a
// Tailscale name "nas.tail1234.ts.net".
pub function private_host(host: string): boolean {
  if let Some(a) = ipv4_parts(host) {
    return a[0] == 10 || a[0] == 127 || a[0] == 172 && a[1] >= 16 && a[1] <= 31 || a[0] == 192 && a[1] == 168 || a[0] == 100 && a[1] >= 64 && a[1] <= 127 || a[0] == 169 && a[1] == 254;
  }
  let h = host.to_ascii_lower();
  if (h.starts_with("[") && h.ends_with("]")) {
    h = h.split_at(h.len() - 1).0.split_at(1).1;
  }
  if (h.contains(":")) {
    return h.starts_with("fc") || h.starts_with("fd") || h == "::1";
  }
  if (h == "localhost" || h.len() > 0 && !h.contains(".")) {
    return true;
  }
  return h.ends_with(".local") || h.ends_with(".lan") || h.ends_with(".home.arpa") || h.ends_with(".internal") || h.ends_with(".ts.net");
}

// A server that the user typed, with a token of their own.
pub function manual_server(uri: string, token: string): Server {
  return Server { name: uri, id: "", token: token, owned: true, connections: [Connection { uri: trim_slash(uri), local: true, relay: false, address: "", port: 0, protocol: "", ipv6: false }] };
}

function trim_slash(s: string): string {
  if (s.ends_with("/")) {
    return s.split_at(s.len() - 1).0;
  }
  return s;
}

// --- a server

// A server at the address `base`, with the token for it.
pub struct Base { uri: string, token: string }

pub function identity(c: Client, b: Base): Request {
  return get(c.with_token(b.token), b.uri + "/identity");
}

pub function sections(c: Client, b: Base): Request {
  return get(c.with_token(b.token), b.uri + "/library/sections");
}

// An order of a library: the word on its chip and the `sort` value of the
// server.
pub struct Sort { name: string, param: string }

pub function sorts(): Sort[] {
  return [Sort { name: "TITLE", param: "titleSort" }, Sort { name: "YEAR", param: "year:desc" }, Sort { name: "ADDED", param: "addedAt:desc" }, Sort { name: "RATING", param: "rating:desc" }];
}

// The `size` items of library `key` from `start`, in `sort` order, and only
// those not watched when `unwatched` is true.
pub function section_items(c: Client, b: Base, key: string, start: i32, size: i32, sort: string, unwatched: boolean): Request {
  let q = url.query_encode(unwatched_filter([("X-Plex-Container-Start", start.to_string()), ("X-Plex-Container-Size", size.to_string()), ("sort", sort), ("includeGuids", "0")], unwatched));
  return get(c.with_token(b.token), b.uri + "/library/sections/" + key + "/all?" + q);
}

function unwatched_filter(own q: (string, string)[], unwatched: boolean): (string, string)[] {
  if (unwatched) {
    return q.append(("unwatched", "1"));
  }
  return q;
}

// The first letters of the titles of library `key`, in the order of the
// title sort, with the number of items of each.
pub function first_letters(c: Client, b: Base, key: string, unwatched: boolean): Request {
  let q = url.query_encode(unwatched_filter([], unwatched));
  let path = b.uri + "/library/sections/" + key + "/firstCharacter";
  if (q.len() > 0) {
    path = path + "?" + q;
  }
  return get(c.with_token(b.token), path);
}

// A first letter of the titles of a library, such as "A" or "#", and the
// number of items whose title starts with it.
pub struct Letter { key: string, size: i32 }

pub function parse_letters(body: string): Letter[] {
  let out: Letter[] = [];
  let Ok(d) = json.parse_document(body) else {
    return out;
  };
  for n in elements(d, container(d), "Directory") {
    let key = str(d, n, "title");
    if (key.len() == 0) {
      key = str(d, n, "key");
    }
    let size = int(d, n, "size") as i32;
    if (key.len() > 0 && size > 0) {
      out = out.append(Letter { key: key, size: size });
    }
  }
  return out;
}

// The index in the title sort of the first item of letter `i`.
pub function letter_offset(letters: Letter[], i: i32): i32 {
  let at = 0;
  for k in 0..i.min(letters.len()) {
    at += letters[k].size;
  }
  return at;
}

pub function hubs(c: Client, b: Base): Request {
  return get(c.with_token(b.token), b.uri + "/hubs?count=15");
}

pub function metadata(c: Client, b: Base, key: string): Request {
  return get(c.with_token(b.token), b.uri + "/library/metadata/" + key + "?includeMarkers=1");
}

pub function children(c: Client, b: Base, key: string): Request {
  return get(c.with_token(b.token), b.uri + "/library/metadata/" + key + "/children");
}

pub function search(c: Client, b: Base, query: string): Request {
  let q = url.query_encode([("query", query), ("limit", "20"), ("includeCollections", "0")]);
  return get(c.with_token(b.token), b.uri + "/hubs/search?" + q);
}

// Marks an item watched, or unwatched.
pub function scrobble(c: Client, b: Base, key: string, watched: boolean): Request {
  let verb = "/:/unscrobble?";
  if (watched) {
    verb = "/:/scrobble?";
  }
  let q = url.query_encode([("identifier", "com.plexapp.plugins.library"), ("key", key)]);
  return get(c.with_token(b.token), b.uri + verb + q);
}

// Reports the state of playback: "playing", "paused" or "stopped", at
// `time_ms` of `duration_ms`. The server keeps it as the resume point.
// `session` is the X-Plex-Session-Identifier of the stream, so the server
// joins the report to the stream that it serves.
pub function timeline(c: Client, b: Base, key: string, state: string, time_ms: i64, duration_ms: i64, session: string): Request {
  let q = url.query_encode([("ratingKey", key), ("key", "/library/metadata/" + key), ("state", state), ("time", time_ms.to_string()), ("duration", duration_ms.to_string()), ("hasMDE", "1")]);
  let r = get(c.with_token(b.token), b.uri + "/:/timeline?" + q);
  return Request { ...r, headers: r.headers.append(("X-Plex-Session-Identifier", session)) };
}

// Keeps the transcode `session` alive while the player is paused.
pub function ping_transcode(c: Client, b: Base, session: string): Request {
  return get(c.with_token(b.token), b.uri + "/video/:/transcode/universal/ping?" + url.query_encode([("session", session)]));
}

// The address of image `path` of the server, scaled to w by h. A path of
// plex.tv or of a web host is passed through the transcoder of the server
// as well.
pub function image_url(b: Base, path: string, w: i32, h: i32): string {
  let q = url.query_encode([("width", w.to_string()), ("height", h.to_string()), ("minSize", "1"), ("upscale", "0"), ("url", path), ("X-Plex-Token", b.token)]);
  return b.uri + "/photo/:/transcode?" + q;
}

// --- records of a server

pub struct Section { key: string, kind: string, title: string }

pub function parse_sections(body: string): Section[] {
  let out: Section[] = [];
  let Ok(d) = json.parse_document(body) else {
    return out;
  };
  for n in elements(d, container(d), "Directory") {
    let kind = str(d, n, "type");
    if (kind == "movie" || kind == "show" || kind == "artist") {
      out = out.append(Section { key: str(d, n, "key"), kind: kind, title: str(d, n, "title") });
    }
  }
  return out;
}

// The file of a version of an item. `key` is its address on the server.
// A sound or subtitle track of a file. `kind` is 2 for sound and 3 for
// subtitles. `selected` is true for the track that the server remembers,
// and `external` is true for a subtitle file beside the video. A `forced`
// subtitle track has only the lines in a foreign language.
pub struct Track { id: string, kind: i32, title: string, language: string, codec: string, selected: boolean, external: boolean, key: string, forced: boolean }

// A file of a version of an item. `indexes` is "sd" when the server holds
// preview thumbnails of it.
pub struct Part { id: string, key: string, container: string, size: i64, indexes: string, tracks: Track[] }

pub struct Media { container: string, video: string, audio: string, resolution: string, bitrate: i32, width: i32, height: i32, parts: Part[] }

// An item of a library: a movie, a show, a season, an episode, an artist,
// an album or a track. `key` is its ratingKey.
pub struct Item {
  key: string,
  kind: string,
  title: string,
  parent: string,
  grandparent: string,
  // The key of the show of an episode, or "".
  grandparent_key: string,
  year: i32,
  index: i32,
  parent_index: i32,
  summary: string,
  thumb: string,
  art: string,
  parent_thumb: string,
  grandparent_thumb: string,
  duration_ms: i64,
  offset_ms: i64,
  views: i32,
  leaves: i32,
  viewed_leaves: i32,
  children: i32,
  rating: string,
  content_rating: string,
  studio: string,
  genres: string[],
  media: Media[],
  markers: Marker[],
}

// A part of a video that a viewer can skip: "intro" or "credits", from
// `start_ms` up to `end_ms`.
pub struct Marker { kind: string, start_ms: i64, end_ms: i64 }

// The item as the server sees it after it is marked watched, or not
// watched when `seen` is false.
pub function marked(it: Item, seen: boolean): Item {
  if (seen) {
    return Item { ...it, views: 1, offset_ms: 0i64, viewed_leaves: it.leaves };
  }
  return Item { ...it, views: 0, viewed_leaves: 0 };
}

pub function no_item(): Item {
  return Item { key: "", kind: "", title: "", parent: "", grandparent: "", grandparent_key: "", year: 0, index: 0, parent_index: 0, summary: "", thumb: "", art: "", parent_thumb: "", grandparent_thumb: "", duration_ms: 0i64, offset_ms: 0i64, views: 0, leaves: 0, viewed_leaves: 0, children: 0, rating: "", content_rating: "", studio: "", genres: [], media: [], markers: [] };
}

function tags(d: json.Document, n: i32, key: string): string[] {
  let out: string[] = [];
  for t in elements(d, n, key) {
    let s = str(d, t, "tag");
    if (s.len() > 0) {
      out = out.append(s);
    }
  }
  return out;
}

function media_of(d: json.Document, n: i32): Media[] {
  let out: Media[] = [];
  for m in elements(d, n, "Media") {
    let parts: Part[] = [];
    for p in elements(d, m, "Part") {
      parts = parts.append(Part { id: int(d, p, "id").to_string(), key: str(d, p, "key"), container: str(d, p, "container"), size: int(d, p, "size"), indexes: str(d, p, "indexes"), tracks: tracks_of(d, p) });
    }
    out = out.append(Media { container: str(d, m, "container"), video: str(d, m, "videoCodec"), audio: str(d, m, "audioCodec"), resolution: str(d, m, "videoResolution"), bitrate: int(d, m, "bitrate") as i32, width: int(d, m, "width") as i32, height: int(d, m, "height") as i32, parts: parts });
  }
  return out;
}

function rating_of(d: json.Document, n: i32): string {
  let r = str(d, n, "audienceRating");
  if (r.len() == 0) {
    r = str(d, n, "rating");
  }
  return r;
}

pub function item_of(d: json.Document, n: i32): Item {
  return Item {
    key: str(d, n, "ratingKey"),
    kind: str(d, n, "type"),
    title: str(d, n, "title"),
    parent: str(d, n, "parentTitle"),
    grandparent: str(d, n, "grandparentTitle"),
    grandparent_key: str(d, n, "grandparentRatingKey"),
    year: int(d, n, "year") as i32,
    index: int(d, n, "index") as i32,
    parent_index: int(d, n, "parentIndex") as i32,
    summary: str(d, n, "summary"),
    thumb: str(d, n, "thumb"),
    art: str(d, n, "art"),
    parent_thumb: str(d, n, "parentThumb"),
    grandparent_thumb: str(d, n, "grandparentThumb"),
    duration_ms: int(d, n, "duration"),
    offset_ms: int(d, n, "viewOffset"),
    views: int(d, n, "viewCount") as i32,
    leaves: int(d, n, "leafCount") as i32,
    viewed_leaves: int(d, n, "viewedLeafCount") as i32,
    children: int(d, n, "childCount") as i32,
    rating: rating_of(d, n),
    content_rating: str(d, n, "contentRating"),
    studio: str(d, n, "studio"),
    genres: tags(d, n, "Genre"),
    media: media_of(d, n),
    markers: markers_of(d, n),
  };
}

function markers_of(d: json.Document, n: i32): Marker[] {
  let out: Marker[] = [];
  for m in elements(d, n, "Marker") {
    let kind = str(d, m, "type");
    if (kind == "intro" || kind == "credits") {
      out = out.append(Marker { kind: kind, start_ms: int(d, m, "startTimeOffset"), end_ms: int(d, m, "endTimeOffset") });
    }
  }
  return out;
}

// The marker that `ms` is in, or None.
pub function marker_at(it: Item, ms: i64): Option[Marker] {
  for m in it.markers {
    if (m.start_ms <= ms && ms < m.end_ms) {
      return Some(m);
    }
  }
  return None;
}

// A page of a library: the items, and the count of all its items.
pub struct Page { items: Item[], total: i32 }

pub function parse_items(body: string): Page {
  let none: Item[] = [];
  let Ok(d) = json.parse_document(body) else {
    return Page { items: none, total: 0 };
  };
  let m = container(d);
  let items: Item[] = [];
  for n in elements(d, m, "Metadata") {
    items = items.append(item_of(d, n));
  }
  let total = int(d, m, "totalSize") as i32;
  if (total == 0) {
    total = int(d, m, "size") as i32;
  }
  return Page { items: items, total: total };
}

// The first item of a reply, as /library/metadata/KEY gives it.
pub function parse_item(body: string): Option[Item] {
  let page = parse_items(body);
  if (page.items.len() == 0) {
    return None;
  }
  return Some(page.items[0]);
}

// A row of the home screen or of a search.
pub struct Hub { title: string, ident: string, items: Item[] }

pub function parse_hubs(body: string): Hub[] {
  let out: Hub[] = [];
  let Ok(d) = json.parse_document(body) else {
    return out;
  };
  for h in elements(d, container(d), "Hub") {
    let items: Item[] = [];
    for n in elements(d, h, "Metadata") {
      let it = item_of(d, n);
      if (playable_kind(it.kind) || it.kind == "show" || it.kind == "season" || it.kind == "artist" || it.kind == "album") {
        items = items.append(it);
      }
    }
    if (items.len() > 0) {
      out = out.append(Hub { title: str(d, h, "title"), ident: str(d, h, "hubIdentifier"), items: items });
    }
  }
  return out;
}

// --- what the screens show of an item

pub function playable_kind(kind: string): boolean {
  return kind == "movie" || kind == "episode" || kind == "track" || kind == "clip";
}

// The image of the item for a card: an episode shows its show, a track its
// album.
pub function poster(it: Item): string {
  if (it.kind == "episode" && it.grandparent_thumb.len() > 0) {
    return it.grandparent_thumb;
  }
  if (it.kind == "track" && it.parent_thumb.len() > 0) {
    return it.parent_thumb;
  }
  if (it.thumb.len() > 0) {
    return it.thumb;
  }
  return it.parent_thumb;
}

// The name of the item on a card.
pub function card_title(it: Item): string {
  if (it.kind == "episode" && it.grandparent.len() > 0) {
    return it.grandparent;
  }
  return it.title;
}

// The second line of a card: "S1 E3", a year, or the artist of an album.
pub function card_subtitle(it: Item): string {
  if (it.kind == "episode") {
    return episode_code(it);
  }
  if (it.kind == "season") {
    if (it.leaves > 0) {
      return it.leaves.to_string() + " episodes";
    }
    return "";
  }
  if (it.kind == "album" || it.kind == "track") {
    return it.parent;
  }
  if (it.year > 0) {
    return it.year.to_string();
  }
  return "";
}

// A card of the downloads and the downloaded items that it holds: a show
// and its episodes, an album and its tracks, or one movie.
pub struct Shelf { card: Item, items: Item[] }

// The downloads `items` on their cards, in the order of the first item of
// each card. The episodes of a show and the tracks of an album are in
// their order. A show card has the key of the show, so the server can
// give its synopsis. An album card has a key that only the app knows.
pub function shelves(items: Item[]): Shelf[] {
  let out: Shelf[] = [];
  for it in items {
    let card = shelf_card(it);
    let at = -1;
    for k in 0..out.len() {
      if (out[k].card.key == card.key) {
        at = k;
      }
    }
    if (at < 0) {
      out = out.append(Shelf { card: card, items: [it] });
    } else {
      out = out.with(at, Shelf { ...out[at], items: in_order(out[at].items.append(it)) });
    }
  }
  return out;
}

function shelf_card(it: Item): Item {
  if (it.kind == "episode" && it.grandparent.len() > 0) {
    let key = it.grandparent_key;
    if (key.len() == 0) {
      key = "saved-show:" + it.grandparent;
    }
    return Item { ...no_item(), key: key, kind: "show", title: it.grandparent, thumb: it.grandparent_thumb, art: it.art };
  }
  if (it.kind == "track" && it.parent.len() > 0) {
    return Item { ...no_item(), key: "saved-album:" + it.grandparent + "/" + it.parent, kind: "album", title: it.parent, parent: it.grandparent, thumb: it.parent_thumb };
  }
  return it;
}

// True for the key of a card that only the app knows, which the server
// has no metadata for.
pub function app_key(key: string): boolean {
  return key.starts_with("saved-");
}

// The items by season, then by episode or track.
function in_order(items: Item[]): Item[] {
  let out: Item[] = [];
  for it in items {
    let at = out.len();
    for k in 0..out.len() {
      if (at == out.len() && (it.parent_index < out[k].parent_index || it.parent_index == out[k].parent_index && it.index < out[k].index)) {
        at = k;
      }
    }
    out = out.take(at).append(it).concat(out.drop(at));
  }
  return out;
}

// The full name of the item, for a download: "Show · S1 E3 · Title" for an
// episode, else its title.
pub function full_title(it: Item): string {
  if (it.kind == "episode" && it.grandparent.len() > 0) {
    return it.grandparent + " · " + episode_line(it);
  }
  return it.title;
}

// The line under the name of an item in a list: the code and the title of
// an episode, else the second line of its card.
pub function episode_line(it: Item): string {
  if (it.kind == "episode") {
    return episode_code(it) + " · " + it.title;
  }
  return card_subtitle(it);
}

pub function episode_code(it: Item): string {
  return "S" + it.parent_index.to_string() + " E" + it.index.to_string();
}

pub function watched(it: Item): boolean {
  if (it.leaves > 0) {
    return it.viewed_leaves >= it.leaves;
  }
  return it.views > 0 && it.offset_ms == 0i64;
}

// The part of the item that the user has seen, from 0 to 1000, for the bar
// on a card. 0 when the user has not started it.
pub function progress(it: Item): i32 {
  if (it.duration_ms <= 0i64 || it.offset_ms <= 0i64) {
    return 0;
  }
  let p = it.offset_ms * 1000i64 / it.duration_ms;
  if (p > 1000i64) {
    return 1000;
  }
  return p as i32;
}

// A duration as "1h 52m", or "48m".
pub function duration_text(ms: i64): string {
  let minutes = ms / 60000i64;
  if (minutes >= 60i64) {
    let h = minutes / 60i64;
    let m = minutes % 60i64;
    if (m == 0i64) {
      return h.to_string() + "h";
    }
    return h.to_string() + "h " + m.to_string() + "m";
  }
  return minutes.to_string() + "m";
}

function two(n: i64): string {
  if (n < 10i64) {
    return "0" + n.to_string();
  }
  return n.to_string();
}

// A position as "1:02:03", or "2:03" under an hour.
pub function clock_text(ms: i64): string {
  let total = ms / 1000i64;
  if (total < 0i64) {
    total = 0i64;
  }
  let h = total / 3600i64;
  let m = total / 60i64 % 60i64;
  let s = total % 60i64;
  if (h > 0i64) {
    return h.to_string() + ":" + two(m) + ":" + two(s);
  }
  return m.to_string() + ":" + two(s);
}

// The facts on the detail screen, as one line: "2010 · 2h 28m · PG-13 · 8.7".
pub function facts(it: Item): string {
  let parts: string[] = [];
  if (it.kind == "episode") {
    parts = parts.append(episode_code(it));
  } else if (it.year > 0) {
    parts = parts.append(it.year.to_string());
  }
  if (it.duration_ms > 0i64) {
    parts = parts.append(duration_text(it.duration_ms));
  }
  if (it.content_rating.len() > 0) {
    parts = parts.append(it.content_rating);
  }
  if (it.rating.len() > 0) {
    parts = parts.append(it.rating);
  }
  if (it.media.len() > 0 && it.media[0].resolution.len() > 0) {
    parts = parts.append(resolution_badge(it.media[0].resolution));
  }
  return parts.join(" · ");
}

pub function resolution_badge(r: string): string {
  if (r == "4k") {
    return "4K";
  }
  if (r == "sd") {
    return "SD";
  }
  if (r.len() > 0 && r[0] >= 48u8 && r[0] <= 57u8) {
    return r + "p";
  }
  return r.to_ascii_upper();
}

// --- playback

// A quality of playback. `kbps` 0 plays the file as it is.
// A quality of a transcode: the cap of the video bitrate, the largest
// resolution, and the videoQuality of the encoder from 0 to 100.
pub struct Quality { name: string, kbps: i32, resolution: string, video_quality: i32 }

pub function qualities(): Quality[] {
  return [
    Quality { name: "Original", kbps: 0, resolution: "", video_quality: 100 },
    Quality { name: "1080p 20 Mbps", kbps: 20000, resolution: "1920x1080", video_quality: 100 },
    Quality { name: "1080p 8 Mbps", kbps: 8000, resolution: "1920x1080", video_quality: 60 },
    Quality { name: "720p 4 Mbps", kbps: 4000, resolution: "1280x720", video_quality: 100 },
    Quality { name: "480p 1.5 Mbps", kbps: 1500, resolution: "720x480", video_quality: 60 },
    Quality { name: "240p 320 kbps", kbps: 320, resolution: "420x240", video_quality: 30 },
    Quality { name: "Auto", kbps: 0, resolution: "", video_quality: 100 },
  ];
}

// The index of Auto in `qualities()`. Auto starts at Original, and the app
// takes a lower quality when the stream stalls. No stream uses Auto itself.
pub function auto_quality(): i32 {
  return qualities().len() - 1;
}

// The containers that ExoPlayer reads.
function direct_container(c: string): boolean {
  return c == "mp4" || c == "m4v" || c == "mov" || c == "mkv" || c == "webm" || c == "mpegts" || c == "ts" || c == "mp3" || c == "m4a" || c == "aac" || c == "flac" || c == "ogg" || c == "opus" || c == "wav";
}

// The MIME type of the Android decoders of the Plex codec `codec`, or "".
pub function codec_mime(codec: string): string {
  let table: (string, string)[] = [
    ("h264", "video/avc"),
    ("hevc", "video/hevc"),
    ("vp8", "video/x-vnd.on2.vp8"),
    ("vp9", "video/x-vnd.on2.vp9"),
    ("av1", "video/av01"),
    ("mpeg4", "video/mp4v-es"),
    ("mpeg2video", "video/mpeg2"),
    ("aac", "audio/mp4a-latm"),
    ("mp3", "audio/mpeg"),
    ("ac3", "audio/ac3"),
    ("eac3", "audio/eac3"),
    ("dca", "audio/vnd.dts"),
    ("truehd", "audio/true-hd"),
    ("opus", "audio/opus"),
    ("vorbis", "audio/vorbis"),
    ("flac", "audio/flac"),
    ("pcm", "audio/raw"),
    ("alac", "audio/alac"),
  ];
  for row in table {
    if (row.0 == codec) {
      return row.1;
    }
  }
  return "";
}

// The decoders that the compatibility definition of Android requires on
// each device. The app uses them when it cannot read the list of the device.
pub function baseline_decoders(): string[] {
  return ["video/avc", "video/hevc", "video/x-vnd.on2.vp8", "video/x-vnd.on2.vp9", "audio/mp4a-latm", "audio/mpeg", "audio/opus", "audio/vorbis", "audio/flac", "audio/raw"];
}

// Whether a decoder of `decoders` takes `codec`. No codec needs no decoder.
function decodes(decoders: string[], codec: string): boolean {
  if (codec.len() == 0) {
    return true;
  }
  let known = decoders;
  if (known.len() == 0) {
    known = baseline_decoders();
  }
  return known.contains(codec_mime(codec));
}

// Whether the phone, with the decoder types `decoders`, can play the first
// version of the item as it is.
pub function direct_playable(it: Item, decoders: string[]): boolean {
  return direct_with(it, decoders, no_choice());
}

// As direct_playable, with the sound of `choice`.
pub function direct_with(it: Item, decoders: string[], choice: Choice): boolean {
  if (it.media.len() == 0 || it.media[0].parts.len() == 0) {
    return false;
  }
  let m = it.media[0];
  return direct_container(m.container) && decodes(decoders, m.video) && decodes(decoders, audio_codec(it, choice));
}

// The request that downloads the file of the first version of the item as
// it is. The item must have a part.
pub function download_request(c: Client, b: Base, it: Item): Request {
  return get(c.with_token(b.token), b.uri + it.media[0].parts[0].key + "?download=1");
}

// The name of the file of a download of the item: its key and the
// extension of its container, or of Matroska for a transcode.
pub function download_name(it: Item, transcoded: boolean): string {
  let ext = "bin";
  if (transcoded) {
    ext = "transcode.mkv";
  } else if (it.media.len() > 0 && it.media[0].container.len() > 0) {
    ext = it.media[0].container;
  }
  return it.key + "." + ext;
}

// True when the download `name` of `it` is a transcode. A transcode made
// before its name said so has the name of an MKV file of an item that is
// not MKV.
pub function transcoded_file(it: Item, name: string): boolean {
  if (name.ends_with(".transcode.mkv")) {
    return true;
  }
  return name.ends_with(".mkv") && (it.media.len() == 0 || it.media[0].container != "mkv");
}

// The item as its downloaded file holds it. A transcode holds one sound
// track, the one that it played. The app draws no image subtitle from a
// file: a transcode burned it in, and the player shows none.
pub function file_item(it: Item, transcoded: boolean): Item {
  if (it.media.len() == 0 || it.media[0].parts.len() == 0) {
    return it;
  }
  let sounds = audio_tracks(it);
  let sound = remembered(it).audio;
  if (sound.len() == 0 && sounds.len() > 0) {
    sound = sounds[0].id;
  }
  let kept: Track[] = [];
  for t in it.media[0].parts[0].tracks {
    if (t.kind == 2 && transcoded) {
      if (t.id == sound) {
        kept = kept.append(Track { ...t, selected: true });
      }
    } else if (t.kind != 3 || text_codec(t.codec)) {
      kept = kept.append(t);
    }
  }
  let part = Part { ...it.media[0].parts[0], tracks: kept };
  return Item { ...it, media: [Media { ...it.media[0], parts: [part] }] };
}

// The address of the file of the item, which the player reads as it is.
// `session` joins the stream to the reports of the timeline.
pub function direct_url(b: Base, it: Item, session: string): string {
  return b.uri + it.media[0].parts[0].key + "?" + url.query_encode([("X-Plex-Session-Identifier", session), ("X-Plex-Token", b.token)]);
}

// What the client asks the transcoder to make: H.264 video and AAC sound,
// which each Android device decodes. A stream is HLS in
// MPEG-TS, and a download is one Matroska file over HTTP. HEVC never goes
// in MPEG-TS: a hardware HEVC encode into TS can change its picture
// parameters between slices. A quality with a bitrate adds an upper bound
// of the video bitrate. The server reads this value as a query of its own,
// so the parameter escapes its characters once more.
pub function profile_extra(q: Quality, protocol: string): string {
  let parts = ["add-settings(DirectPlayStreamSelection=true)"];
  if (q.kbps > 0) {
    parts = parts.append("add-limitation(scope=videoCodec&scopeName=*&type=upperBound&name=video.bitrate&value=" + q.kbps.to_string() + "&replace=true)");
  }
  let container = if (protocol == "hls") { "mpegts" } else { "mkv" };
  parts = parts.append("add-transcode-target(type=videoProfile&context=streaming&protocol=" + protocol + "&container=" + container + "&videoCodec=h264&audioCodec=aac)");
  return parts.join("+");
}

// The address of an HLS stream that the server makes from the whole item at
// quality `q`. The player seeks in the stream, and fastSeek starts the
// segments at the seek: an offset at the start can leave the first segment
// open with no data. `session` names the transcode. The client is Generic,
// the one platform that the transcoder takes with no targets of its own.
pub function hls_url(c: Client, b: Base, it: Item, q: Quality, session: string, choice: Choice): string {
  return transcode_url(c, b, it, q, session, choice, "hls");
}

// The request of one Matroska file that the server makes from the whole
// item, for a download. The download manager of Android cannot save HLS.
pub function download_transcode_request(c: Client, b: Base, it: Item, q: Quality, session: string, decoders: string[], choice: Choice): Request {
  return get(c.with_token(b.token), transcode_url(c, b, it, transcode_quality(it, q, decoders), session, choice, "http"));
}

// The address of a transcode of the whole item with `protocol`: "hls" for
// a stream, or "http" for one file.
function transcode_url(c: Client, b: Base, it: Item, q: Quality, session: string, choice: Choice, protocol: string): string {
  let copy = "0";
  if (q.kbps == 0) {
    copy = "1";
  }
  let pairs: (string, string)[] = [
    ("hasMDE", "1"),
    ("path", "/library/metadata/" + it.key),
    ("mediaIndex", "0"),
    ("partIndex", "0"),
    ("protocol", protocol),
    ("directPlay", "0"),
    ("directStream", copy),
    ("directStreamAudio", "1"),
    ("subtitleSize", "100"),
    ("audioBoost", "100"),
    ("location", "lan"),
    ("autoAdjustQuality", "0"),
    ("mediaBufferSize", "102400"),
    ("session", session),
    ("X-Plex-Session-Identifier", session),
    ("X-Plex-Client-Profile-Name", "Generic"),
    ("X-Plex-Client-Profile-Extra", profile_extra(q, protocol)),
    ("X-Plex-Client-Identifier", c.id),
    ("X-Plex-Product", PRODUCT),
    ("X-Plex-Version", VERSION),
    ("X-Plex-Platform", "Generic"),
    ("X-Plex-Device", c.device),
    ("X-Plex-Token", b.token),
  ];
  if (q.kbps > 0) {
    pairs = pairs.append(("videoResolution", q.resolution));
    pairs = pairs.append(("videoQuality", q.video_quality.to_string()));
  }
  if (choice.audio.len() > 0) {
    pairs = pairs.append(("audioStreamID", choice.audio));
  }
  // The server burns the subtitles that the client selected on the part,
  // unless the app draws them.
  let subtitles = "none";
  if (choice.subtitle.len() > 0 && text_subtitle(it, choice).is_none()) {
    subtitles = "burn";
  }
  pairs = pairs.append(("subtitles", subtitles));
  if (protocol != "hls") {
    return b.uri + "/video/:/transcode/universal/start?" + url.query_encode(pairs);
  }
  pairs = pairs.append(("fastSeek", "1")).append(("X-Plex-Incomplete-Segments", "1"));
  return b.uri + "/video/:/transcode/universal/start.m3u8?" + url.query_encode(pairs);
}

pub function stop_transcode(c: Client, b: Base, session: string): Request {
  return get(c.with_token(b.token), b.uri + "/video/:/transcode/universal/stop?" + url.query_encode([("session", session)]));
}

// The address that the player opens for the item, whether it is a
// transcode that the server keeps a session for, and where the player seeks
// to when it is ready.
pub struct Stream { url: string, transcode: boolean, offset_ms: i64 }

// The phone plays the file as it is with no subtitles, at Original quality,
// when it decodes the video and the chosen sound. Subtitles burn in a
// transcode.
pub function stream_for(c: Client, b: Base, it: Item, q: Quality, offset_ms: i64, session: string, decoders: string[], choice: Choice): Stream {
  if (q.kbps == 0 && (choice.subtitle.len() == 0 || text_subtitle(it, choice).is_some()) && direct_with(it, decoders, choice)) {
    return Stream { url: direct_url(b, it, session), transcode: false, offset_ms: offset_ms };
  }
  return transcode_for(c, b, it, q, offset_ms, session, decoders, choice);
}

// A transcode of the item at quality `q`. At Original quality the server
// copies H.264 video that the phone decodes, and converts the rest.
pub function transcode_for(c: Client, b: Base, it: Item, q: Quality, offset_ms: i64, session: string, decoders: string[], choice: Choice): Stream {
  return Stream { url: hls_url(c, b, it, transcode_quality(it, q, decoders), session, choice), transcode: true, offset_ms: offset_ms };
}

// The quality of a transcode at `q`. A transcode at Original or Auto
// copies only H.264 video, and encodes other video at 1080p 8 Mbps.
function transcode_quality(it: Item, q: Quality, decoders: string[]): Quality {
  if (q.kbps == 0 && !(it.media.len() > 0 && it.media[0].video == "h264" && decodes(decoders, "h264"))) {
    return qualities()[2];
  }
  return q;
}

// The sound and subtitle tracks of the part at `n`.
function tracks_of(d: json.Document, n: i32): Track[] {
  let out: Track[] = [];
  for t in elements(d, n, "Stream") {
    let kind = int(d, t, "streamType") as i32;
    if (kind == 2 || kind == 3) {
      let title = str(d, t, "displayTitle");
      if (title.len() == 0) {
        title = str(d, t, "language");
      }
      out = out.append(Track { id: int(d, t, "id").to_string(), kind: kind, title: title, language: str(d, t, "languageCode"), codec: str(d, t, "codec"), selected: flag(d, t, "selected"), external: str(d, t, "key").len() > 0, key: str(d, t, "key"), forced: flag(d, t, "forced") });
    }
  }
  return out;
}

function tracks_of_kind(it: Item, kind: i32): Track[] {
  if (it.media.len() == 0 || it.media[0].parts.len() == 0) {
    return [];
  }
  return it.media[0].parts[0].tracks.filter((t: Track): boolean => t.kind == kind);
}

// The sound tracks of the first version of an item, in the order of the
// file.
pub function audio_tracks(it: Item): Track[] {
  return tracks_of_kind(it, 2);
}

pub function subtitle_tracks(it: Item): Track[] {
  return tracks_of_kind(it, 3);
}

// The id of the track of `ts` that the server remembers, or "".
pub function selected_id(ts: Track[]): string {
  for t in ts {
    if (t.selected) {
      return t.id;
    }
  }
  return "";
}

// The sound and the subtitles that the user chose: track ids, "" for the
// sound of the file and for no subtitles.
pub struct Choice { audio: string, subtitle: string }

pub function no_choice(): Choice {
  return Choice { audio: "", subtitle: "" };
}

// The choice that the server remembers for an item.
pub function remembered(it: Item): Choice {
  return Choice { audio: selected_id(audio_tracks(it)), subtitle: selected_id(subtitle_tracks(it)) };
}

// A language that the settings offer: its two-letter code, the codes that
// a server gives a track in it, and its own name.
pub struct Language { code: string, codes: string[], name: string }

pub function languages(): Language[] {
  return [
    Language { code: "en", codes: ["eng"], name: "English" },
    Language { code: "fr", codes: ["fra", "fre"], name: "Français" },
    Language { code: "de", codes: ["deu", "ger"], name: "Deutsch" },
    Language { code: "es", codes: ["spa"], name: "Español" },
    Language { code: "it", codes: ["ita"], name: "Italiano" },
    Language { code: "pt", codes: ["por"], name: "Português" },
    Language { code: "nl", codes: ["nld", "dut"], name: "Nederlands" },
    Language { code: "sv", codes: ["swe"], name: "Svenska" },
    Language { code: "da", codes: ["dan"], name: "Dansk" },
    Language { code: "no", codes: ["nor", "nob", "nno"], name: "Norsk" },
    Language { code: "fi", codes: ["fin"], name: "Suomi" },
    Language { code: "pl", codes: ["pol"], name: "Polski" },
    Language { code: "ru", codes: ["rus"], name: "Русский" },
    Language { code: "ja", codes: ["jpn"], name: "日本語" },
    Language { code: "ko", codes: ["kor"], name: "한국어" },
    Language { code: "zh", codes: ["zho", "chi"], name: "中文" },
  ];
}

// The two-letter code of a language code such as "en-GB" or "eng", or ""
// for a language that the settings do not offer.
pub function language_code(code: string): string {
  let short = code.split("-")[0].to_ascii_lower();
  for l in languages() {
    if (l.code == short || l.codes.contains(short)) {
      return l.code;
    }
  }
  return "";
}

// The name of the language with the two-letter code `code`, or "".
pub function language_name(code: string): string {
  for l in languages() {
    if (l.code == code) {
      return l.name;
    }
  }
  return "";
}

pub function speaks(t: Track, code: string): boolean {
  return code.len() > 0 && language_code(t.language) == code;
}

// The modes of the subtitles: none, only while the sound is in another
// language than the one of the settings, and always.
pub const SUBS_OFF: i32 = 0;

pub const SUBS_FOREIGN: i32 = 1;

pub const SUBS_ALWAYS: i32 = 2;

// The tracks for the language `lang`, a two-letter code, with the
// subtitles of the mode `subs`. The sound is the track that the server
// remembers when it is in `lang`, else the first track in `lang` that is
// no commentary. A subtitle in `lang` shows always, or in SUBS_FOREIGN
// while the sound is in another language. Otherwise a forced subtitle in
// `lang` shows the lines in a foreign language. A wanted subtitle with
// none in `lang` is the one that the server remembers. With no track in
// `lang`, the choice is the one that the server remembers.
pub function preferred(it: Item, lang: string, subs: i32): Choice {
  let base = remembered(it);
  let sounds = audio_tracks(it);
  let texts = subtitle_tracks(it).filter((t: Track): boolean => speaks(t, lang));
  if (!sounds.any((t: Track): boolean => speaks(t, lang)) && texts.len() == 0) {
    return base;
  }
  let audio = base.audio;
  if (!sounds.any((t: Track): boolean => t.id == audio && speaks(t, lang))) {
    let in_lang = sounds.filter((t: Track): boolean => speaks(t, lang));
    let plain = in_lang.filter((t: Track): boolean => !t.title.to_ascii_lower().contains("comment"));
    if (plain.len() > 0) {
      audio = plain[0].id;
    } else if (in_lang.len() > 0) {
      audio = in_lang[0].id;
    }
  }
  let heard = sounds.any((t: Track): boolean => t.id == audio && speaks(t, lang));
  let full = texts.filter((t: Track): boolean => !t.forced);
  let forced = texts.filter((t: Track): boolean => t.forced);
  let sub = "";
  if (subs == SUBS_ALWAYS || subs == SUBS_FOREIGN && !heard) {
    sub = base.subtitle;
    if (full.len() > 0) {
      sub = full[0].id;
    } else if (forced.len() > 0) {
      sub = forced[0].id;
    }
  } else if (forced.len() > 0) {
    sub = forced[0].id;
  }
  return Choice { audio: audio, subtitle: sub };
}

// Makes the server remember a choice for each part of the item. A
// subtitle id of "0" turns subtitles off.
pub function select_tracks(c: Client, b: Base, part_id: string, choice: Choice): Request {
  let pairs: (string, string)[] = [];
  if (choice.audio.len() > 0) {
    pairs = pairs.append(("audioStreamID", choice.audio));
  }
  let sub = choice.subtitle;
  if (sub.len() == 0) {
    sub = "0";
  }
  pairs = pairs.append(("subtitleStreamID", sub)).append(("allParts", "1"));
  return put(c.with_token(b.token), b.uri + "/library/parts/" + part_id + "?" + url.query_encode(pairs));
}

// The codec of the sound that plays with `choice`.
function audio_codec(it: Item, choice: Choice): string {
  for t in audio_tracks(it) {
    if (t.id == choice.audio) {
      return t.codec;
    }
  }
  if (it.media.len() == 0) {
    return "";
  }
  return it.media[0].audio;
}

// The address `u` with no X-Plex-Token in its query.
function without_token(u: string): string {
  let parts = u.split("?");
  if (parts.len() < 2) {
    return u;
  }
  let kept: string[] = [];
  for pair in parts[1].split("&") {
    if (!pair.starts_with("X-Plex-Token=")) {
      kept = kept.append(pair);
    }
  }
  return parts[0] + "?" + kept.join("&");
}

// The name of the file that keeps the image at `u` on the phone. It comes
// from the address with no token, so a new token keeps the files.
pub function cache_name(u: string): string {
  let plain = without_token(u);
  return (plain.hash_fnv32() as i64).to_string() + "-" + plain.len().to_string() + ".img";
}

// The preview thumbnails of the part `id`, a BIF file.
// The chosen subtitle track when it is text that the app draws itself:
// SubRip, WebVTT, ASS or SSA, in a file beside the video or inside it.
pub function text_subtitle(it: Item, choice: Choice): Option[Track] {
  if (choice.subtitle.len() == 0) {
    return None;
  }
  for t in subtitle_tracks(it) {
    if (t.id == choice.subtitle && text_codec(t.codec)) {
      return Some(t);
    }
  }
  return None;
}

// True for the codec of a subtitle that the app draws itself.
function text_codec(codec: string): boolean {
  return ["srt", "subrip", "vtt", "webvtt", "ass", "ssa"].contains(codec);
}

// The text of a subtitle track. The server gives a track inside the file
// at the address that a file beside the video has.
pub function subtitle_request(c: Client, b: Base, t: Track): Request {
  let at = if (t.key.len() > 0) { t.key } else { "/library/streams/" + t.id };
  return get(c.with_token(b.token), b.uri + at);
}

// A line of subtitles: its text from `start_ms` until `end_ms`.
pub struct Cue { start_ms: i64, end_ms: i64, text: string }

// The cues of a SubRip, WebVTT, ASS or SSA file, in their order. A cue of
// SubRip or WebVTT has the lines after its time line, up to a blank line.
// A cue of ASS or SSA is a Dialogue line. The tags such as <i> and {\an8}
// are taken out.
pub function parse_cues(text: string): Cue[] {
  let out: Cue[] = [];
  let lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n");
  let events = false;
  let format = ["Layer", "Start", "End", "Style", "Name", "MarginL", "MarginR", "MarginV", "Effect", "Text"];
  let i = 0;
  while (i < lines.len()) {
    let line = lines[i];
    if (line.starts_with("[")) {
      events = line.trim() == "[Events]";
    } else if (events && line.starts_with("Format:")) {
      format = line.split_at(7).1.split(",").map((f: string): string => f.trim());
    } else if (line.starts_with("Dialogue:")) {
      if let Some(c) = dialogue_cue(line.split_at(9).1, format) {
        out = out.append(c);
      }
    }
    let arrow = line.index_of(" --> ");
    if let Some(at) = arrow {
      let start = cue_time(line.split_at(at).0.trim());
      let after = line.split_at(at + 5).1.trim();
      let end_text = after;
      if let Some(sp) = after.index_of(" ") {
        end_text = after.split_at(sp).0;
      }
      let end = cue_time(end_text);
      let words: string[] = [];
      i += 1;
      while (i < lines.len() && lines[i].trim().len() > 0) {
        words = words.append(untagged(lines[i].trim()));
        i += 1;
      }
      if (start >= 0i64 && end > start) {
        out = out.append(Cue { start_ms: start, end_ms: end, text: words.join("\n") });
      }
    } else {
      i += 1;
    }
  }
  return out;
}

// The cue of the fields of a Dialogue line of ASS or SSA, in the order of
// `format`. The text is the last field, and it can hold commas. \N is a
// new line, and \h is a space.
function dialogue_cue(fields: string, format: string[]): Option[Cue] {
  let parts = fields.split(",");
  let Some(start_at) = format.index_of("Start") else {
    return None;
  };
  let Some(end_at) = format.index_of("End") else {
    return None;
  };
  if (format[format.len() - 1] != "Text" || parts.len() < format.len()) {
    return None;
  }
  let start = cue_time(parts[start_at].trim());
  let end = cue_time(parts[end_at].trim());
  let words = untagged(parts.drop(format.len() - 1).join(",")).replace("\\N", "\n").replace("\\n", "\n").replace("\\h", " ");
  if (start < 0i64 || end <= start) {
    return None;
  }
  return Some(Cue { start_ms: start, end_ms: end, text: words.trim() });
}

// The time of "hh:mm:ss,mmm" or "mm:ss.mmm" in milliseconds, or -1.
function cue_time(t: string): i64 {
  let parts = t.replace(",", ".").split(":");
  if (parts.len() < 2 || parts.len() > 3) {
    return -1i64;
  }
  let total = 0i64;
  for k in 0..parts.len() - 1 {
    total = total * 60i64 + digits(parts[k]);
  }
  let last = parts[parts.len() - 1];
  let secs = last;
  let ms = 0i64;
  if let Some(dot) = last.index_of(".") {
    secs = last.split_at(dot).0;
    let frac = last.split_at(dot + 1).1;
    ms = digits(frac);
    if (frac.len() == 1) {
      ms *= 100i64;
    } else if (frac.len() == 2) {
      ms *= 10i64;
    }
  }
  return (total * 60i64 + digits(secs)) * 1000i64 + ms;
}

// The text with the tags of HTML, such as <i>, and of SSA, such as {\an8},
// taken out.
function untagged(s: string): string {
  let out: u8[] = [];
  let skip = 0u8;
  for c in s.bytes() {
    if (skip != 0u8) {
      if (c == skip) {
        skip = 0u8;
      }
      continue;
    }
    if (c == 60u8) {
      skip = 62u8;
      continue;
    }
    if (c == 123u8) {
      skip = 125u8;
      continue;
    }
    out = out.append(c);
  }
  return utf8.from_bytes_lossy(out);
}

// The words of the cue that shows at `ms`, or "".
pub function cue_at(cues: Cue[], ms: i64): string {
  for c in cues {
    if (ms >= c.start_ms && ms < c.end_ms) {
      return c.text;
    }
  }
  return "";
}

pub function bif_request(c: Client, b: Base, id: string): Request {
  return get(c.with_token(b.token), b.uri + "/library/parts/" + id + "/indexes/sd");
}

// The part of the first version of an item that has preview thumbnails,
// or None.
pub function thumbnail_part(it: Item): Option[Part] {
  if (it.media.len() == 0 || it.media[0].parts.len() == 0 || it.media[0].parts[0].indexes != "sd") {
    return None;
  }
  return Some(it.media[0].parts[0]);
}

// The preview thumbnails of a BIF file: the time of each frame in
// milliseconds, and where its JPEG starts and ends in `data`.
pub struct Bif { times_ms: i64[], starts: i32[], ends: i32[], data: u8[] }

function u32_le(b: u8[], at: i32): i64 {
  return b[at] as i64 | b[at + 1] as i64 << 8i64 | b[at + 2] as i64 << 16i64 | b[at + 3] as i64 << 24i64;
}

const BIF_MAGIC: u8[] = [137u8, 66u8, 73u8, 70u8, 13u8, 10u8, 26u8, 10u8];

// The frames of a BIF file, or None when `b` is not one. The header holds
// the count of frames at byte 12 and the milliseconds of one unit of time
// at byte 16, where 0 means 1000. The index at byte 64 holds a time and an
// offset for each frame, and an end entry after the last.
pub function parse_bif(b: u8[]): Option[Bif] {
  if (b.len() < 64) {
    return None;
  }
  for i in 0..8 {
    if (b[i] != BIF_MAGIC[i]) {
      return None;
    }
  }
  let count = u32_le(b, 12);
  let unit = u32_le(b, 16);
  if (unit == 0i64) {
    unit = 1000i64;
  }
  if (count < 0i64 || 64i64 + (count + 1i64) * 8i64 > b.len() as i64) {
    return None;
  }
  let n = count as i32;
  let times: i64[] = [];
  let starts: i32[] = [];
  let ends: i32[] = [];
  for i in 0..n {
    let at = 64 + i * 8;
    let start = u32_le(b, at + 4);
    let end = u32_le(b, at + 12);
    if (start < 0i64 || end < start || end > b.len() as i64) {
      return None;
    }
    times = times.append(u32_le(b, at) * unit);
    starts = starts.append(start as i32);
    ends = ends.append(end as i32);
  }
  return Some(Bif { times_ms: times, starts: starts, ends: ends, data: b });
}

// The frame for `ms`: the last one at or before it, or -1 when there is
// none.
pub function bif_frame(f: Bif, ms: i64): i32 {
  let lo = 0;
  let hi = f.times_ms.len() - 1;
  let found = -1;
  while (lo <= hi) {
    let mid = (lo + hi) / 2;
    if (f.times_ms[mid] <= ms) {
      found = mid;
      lo = mid + 1;
    } else {
      hi = mid - 1;
    }
  }
  return found;
}

// The JPEG bytes of frame `i`.
pub function bif_jpeg(f: Bif, i: i32): u8[] {
  let out: u8[] = [];
  for k in f.starts[i]..f.ends[i] {
    out = out.append(f.data[k]);
  }
  return out;
}

// The next episode after `key` in `episodes`, or None at the end.
pub function next_episode(episodes: Item[], key: string): Option[Item] {
  let i = 0;
  while (i < episodes.len()) {
    if (episodes[i].key == key) {
      if (i + 1 < episodes.len()) {
        return Some(episodes[i + 1]);
      }
      return None;
    }
    i += 1;
  }
  return None;
}
