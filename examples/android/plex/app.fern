// The Fern for Plex app: a NativeActivity with no Java code of its own.
// control.fern holds its behaviour. This file gives it the device of the
// phone: the clock, the files of the app, the window, the network through
// workers, the image decoder and the media player.
import "std/android";
import "std/android/launch";
import "std/android/draw";
import "std/android/gl";
import "std/android/image";
import "std/android/keyboard";
import "std/android/player";
import "std/android/service";
import "std/android/session";
import "std/android/text";
import "std/android/ui/painter";
import "std/android/ui/scene";
import "std/android/video/capabilities";
import "std/fetch";
import "std/log";
import "std/rand";
import "std/worker";
import "./control";
import "./plex";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

// The listener of the media player. Each method runs on the main thread and
// sends its event to the loop thread.
@jni("dev.fern.plex.Media implements android.media.MediaPlayer$OnPreparedListener, android.media.MediaPlayer$OnCompletionListener, android.media.MediaPlayer$OnErrorListener, android.media.MediaPlayer$OnInfoListener, android.media.MediaPlayer$OnSeekCompleteListener", "void onPrepared(android.media.MediaPlayer)")
pub function on_prepared(env: usize, thiz: usize, mp: usize): void {
  player.prepared(env, thiz, mp);
}

@jni("dev.fern.plex.Media", "void onCompletion(android.media.MediaPlayer)")
pub function on_completion(env: usize, thiz: usize, mp: usize): void {
  player.completed(env, thiz, mp);
}

@jni("dev.fern.plex.Media", "boolean onError(android.media.MediaPlayer, int, int)")
pub function on_error(env: usize, thiz: usize, mp: usize, what: i32, extra: i32): u8 {
  return player.failed(env, thiz, mp, what, extra);
}

@jni("dev.fern.plex.Media", "boolean onInfo(android.media.MediaPlayer, int, int)")
pub function on_info(env: usize, thiz: usize, mp: usize, what: i32, extra: i32): u8 {
  return player.info(env, thiz, mp, what, extra);
}

@jni("dev.fern.plex.Media", "void onSeekComplete(android.media.MediaPlayer)")
pub function on_seek_complete(env: usize, thiz: usize, mp: usize): void {
  player.seeked(env, thiz, mp);
}

// The callback of the media session: each media button of Android gives
// the loop a command.
@jni("dev.fern.plex.Controls extends android.media.session.MediaSession$Callback", "void onPlay()")
pub function controls_play(env: usize, thiz: usize): void {
  session.play(env);
}

@jni("dev.fern.plex.Controls", "void onPause()")
pub function controls_pause(env: usize, thiz: usize): void {
  session.pause(env);
}

@jni("dev.fern.plex.Controls", "void onSkipToNext()")
pub function controls_next(env: usize, thiz: usize): void {
  session.next(env);
}

@jni("dev.fern.plex.Controls", "void onSkipToPrevious()")
pub function controls_previous(env: usize, thiz: usize): void {
  session.previous(env);
}

@jni("dev.fern.plex.Controls", "void onStop()")
pub function controls_stop(env: usize, thiz: usize): void {
  session.stop(env);
}

@jni("dev.fern.plex.Controls", "void onSeekTo(long)")
pub function controls_seek(env: usize, thiz: usize, ms: i64): void {
  session.seek_to(env, ms);
}

// The foreground service that keeps the music at work while the window of
// the app is away.
@jni("dev.fern.plex.Playing extends android.app.Service", "android.os.IBinder onBind(android.content.Intent)")
pub function playing_bind(env: usize, thiz: usize, intent: usize): usize {
  return 0 as usize;
}

@jni("dev.fern.plex.Playing", "int onStartCommand(android.content.Intent, int, int)")
pub function playing_command(env: usize, thiz: usize, intent: usize, flags: i32, id: i32): i32 {
  return service.command(env, thiz, intent, service.Notice { channel: "plex", channel_name: "Playback", title: "Fern for Plex", text: "Music plays.", action: "", stop: "", unlock: false });
}

const SERVICE: string = "dev.fern.plex.Playing";

// The media session of the app, and the locks that keep the CPU and the
// Wi-Fi radio awake while a track plays with the screen off.
struct Media { session: Option[session.Session], awake: Cell[Option[service.Awake]] }

// Holds the locks while `on`, and lets them go otherwise.
function keep_awake(ctx: usize, media: Media, on: boolean): void {
  let held = media.awake.get();
  if (on) {
    if (held.is_none()) {
      media.awake.set(Some(service.stay_awake(ctx, "fern:plex")));
    }
    return;
  }
  if let Some(a) = held {
    service.release_awake(ctx, a);
    let none: Option[service.Awake] = None;
    media.awake.set(none);
  }
}

// Tells the media session the track, and starts the foreground service
// while it plays. The loop then stays alive after the Destroy of the
// activity.
function now_playing(ctx: usize, media: Media, title: string, artist: string, album: string, length_ms: i64, playing: boolean, at_ms: i64): void {
  keep_awake(ctx, media, playing);
  let Some(s) = media.session else {
    return;
  };
  android.keep_alive(ctx, playing);
  session.set_track(ctx, s, title, artist, album, length_ms, None);
  session.set_state(ctx, s, playing, at_ms);
  if (playing && !service.start_media(ctx, SERVICE, session.token(ctx, s))) {
    log.info("plex: Android gave no foreground service");
  }
}

function media_end(ctx: usize, media: Media): void {
  keep_awake(ctx, media, false);
  android.keep_alive(ctx, false);
  service.stop(ctx, SERVICE);
  if let Some(s) = media.session {
    session.set_state(ctx, s, false, 0i64);
  }
}

const POST_NOTIFICATIONS: string = "android.permission.POST_NOTIFICATIONS";

// Android 13 (API 33) and later show a notification of the app only with
// this permission.
function ask_notifications(ctx: usize): void {
  if (android.sdk_version(ctx) >= 33 && !android.has_permission(ctx, POST_NOTIFICATIONS)) {
    android.request_permissions(ctx, [POST_NOTIFICATIONS]);
  }
}

function mono_ms(): i64 {
  return monotonic_ns() / 1000000i64;
}

function read_text(path: string): string {
  if let Ok(b) = read_file_bytes(path) {
    return unsafe { string_from_bytes_unchecked(b) };
  }
  return "";
}

function write_text(path: string, text: string): void {
  let written = write_file(path, text);
}

// Sends one request. It runs in a worker, so it can wait for the network.
function send_one(r: plex.Request): plex.Reply {
  let req = fetch.request(r.method, r.url);
  for h in r.headers {
    req = req.with_header(h.0, h.1);
  }
  if (r.method == "POST") {
    req = req.with_text(r.body);
  }
  match (fetch.send(req)) {
    Ok(resp) => {
      return plex.Reply { status: resp.status, body: resp.body.bytes(), error: "" };
    },
    Err(e) => {
      return plex.Reply { status: 0, body: [], error: e.message() };
    }
  }
}

function send_all(rs: plex.Request[]): plex.Reply[] {
  let out: plex.Reply[] = [];
  for r in rs {
    out = out.append(send_one(r));
  }
  return out;
}

function fetch_all(rs: plex.Request[]): worker.Worker[plex.Reply[]] {
  return worker.spawn((): plex.Reply[] => send_all(rs));
}

// Sends the requests for images. An image that `dir` holds comes from
// there, and a new one goes there. Android deletes the files of its cache
// directory when storage runs low.
function fetch_images(dir: string, rs: plex.Request[]): worker.Worker[plex.Reply[]] {
  return worker.spawn((): plex.Reply[] => cached_all(dir, rs));
}

function cached_all(dir: string, rs: plex.Request[]): plex.Reply[] {
  let out: plex.Reply[] = [];
  let made = dir.len() > 0 && create_dir_all(dir).is_ok();
  for r in rs {
    let path = dir + "/" + plex.cache_name(r.url);
    let kept: u8[] = [];
    if (made) {
      if let Ok(b) = read_file_bytes(path) {
        kept = b;
      }
    }
    if (kept.len() > 0) {
      out = out.append(plex.Reply { status: 200, body: kept, error: "" });
    } else {
      let reply = send_one(r);
      if (made && reply.ok() && reply.body.len() > 0) {
        let written = write_file_bytes(path, reply.body);
      }
      out = out.append(reply);
    }
  }
  return out;
}

function window_size(window: usize): (i32, i32) {
  let w = android.Window { ptr: window };
  return (w.width(), w.height());
}

function lock(window: usize): draw.Frame {
  let w = android.Window { ptr: window };
  return w.lock();
}

// The MIME types that the decoders of the phone take, or none when Android
// does not tell them.
function decoders(ctx: usize): string[] {
  if let Ok(types) = capabilities.decoder_types(android.env(ctx), capabilities.default_limits()) {
    log.info("plex: decoders " + types.join(" "));
    return types;
  }
  log.warn("plex: no list of decoders");
  return [];
}

// The GPU side of the app: a painter on a GL context, which draws each
// screen on `window`, and the external texture that the player draws the
// video into, whose id is 0 on a GPU with no external textures. `target`
// is on that texture while the video shows. `shown_ns` is the time of the
// frame on the window, `matrix` its transform, `held` is true once the
// texture holds a frame of the target, `w` and `h` are the size of the
// window, and `overlaid` is true when controls showed over that frame.
struct Gpu { painter: painter.Painter, texture: gl.Texture, target: Option[player.Target], window: usize, shown_ns: i64, matrix: f32[], held: boolean, w: i32, h: i32, overlaid: boolean }

function new_gpu(): Option[Gpu] {
  let Some(c) = gl.open_context() else {
    return None;
  };
  let (on, t) = c.external();
  let pt = painter.on_canvas(painter.new(text.from_faces([], [])), Some(on));
  return Some(Gpu { painter: pt, texture: t, target: None, window: 0 as usize, shown_ns: -1i64, matrix: [], held: false, w: 0, h: 0, overlaid: false });
}

// Puts the painter on the window. False when the phone has no OpenGL ES 2,
// and then the app draws with the CPU.
function attach_gpu(gpu: Cell[Option[Gpu]], window: usize): boolean {
  let made = gpu.get();
  if (made.is_none()) {
    made = new_gpu();
  }
  let Some(g) = made else {
    log.warn("plex: no OpenGL ES 2, so the app draws with the CPU");
    return false;
  };
  let on = painter.attach(g.painter, window);
  gpu.set(Some(Gpu { ...g, painter: on, window: window, w: 0, h: 0 }));
  return painter.attached(on);
}

function detach_gpu(gpu: Cell[Option[Gpu]]): void {
  if let Some(g) = gpu.get() {
    gpu.set(Some(Gpu { ...g, painter: painter.detach(g.painter), window: 0 as usize }));
  }
}

// Draws the nodes on the window. With `video`, the newest frame of the
// video goes under them, in the middle of the window, with black bars that
// keep its shape. Until the texture holds a frame of this target, the video
// is black: the texture can still hold a frame of the target before. False
// when the GPU cannot draw it.
function present(ctx: usize, p: player.Player, gpu: Cell[Option[Gpu]], window: usize, nodes: scene.Node[], video: boolean): boolean {
  let Some(g) = gpu.get() else {
    return false;
  };
  if (!painter.attached(g.painter)) {
    return false;
  }
  let w = android.Window { ptr: window };
  let ww = w.width();
  let wh = w.height();
  let passes = [scene.Pass { nodes: nodes, dy: 0, alpha: 1.0 }];
  if (!video) {
    let pt = painter.present(painter.with_size(g.painter, ww, wh), passes, draw.rgb(0, 0, 0));
    gpu.set(Some(Gpu { ...g, painter: pt, w: ww, h: wh, overlaid: false }));
    return true;
  }
  let Some(t) = g.target else {
    return false;
  };
  let time = g.shown_ns;
  let matrix = g.matrix;
  let held = g.held;
  if let Some(f) = player.next_frame(ctx, t) {
    time = f.time_ns;
    matrix = f.matrix;
    held = f.held();
  }
  let changed = time != g.shown_ns || ww != g.w || wh != g.h || nodes.len() > 0 || g.overlaid;
  if (!changed) {
    return true;
  }
  let (vw, vh) = player.video_size(ctx, p);
  let tex = g.texture;
  let under = (c: gl.Canvas): void => {
    if (held) {
      c.draw_external(tex, matrix, gl.fit(vw, vh, gl.Part { x: 0, y: 0, w: c.width, h: c.height }));
    }
  };
  let pt = painter.present_over(painter.with_size(g.painter, ww, wh), passes, draw.rgb(0, 0, 0), under);
  gpu.set(Some(Gpu { ...g, painter: pt, shown_ns: time, matrix: matrix, held: held, w: ww, h: wh, overlaid: nodes.len() > 0 }));
  return true;
}

// Puts the video on the window. With external textures, the player draws
// into the texture, and present draws it. Otherwise the player draws on the
// window itself, so the painter leaves the window first.
function show_video(ctx: usize, p: player.Player, has: boolean, gpu: Cell[Option[Gpu]], window: usize): boolean {
  if (!has) {
    return false;
  }
  if let Some(g) = gpu.get() {
    if (g.target.is_some() && painter.attached(g.painter)) {
      gpu.set(Some(Gpu { ...g, shown_ns: -1i64 }));
      log.info("plex: video on a texture");
      return true;
    }
    if (painter.attached(g.painter) && g.texture.id != 0) {
      if let Some(t) = player.target(ctx, g.texture.id) {
        if (player.show_target(ctx, p, t)) {
          gpu.set(Some(Gpu { ...g, target: Some(t), shown_ns: -1i64, matrix: [], held: false }));
          log.info("plex: video on a texture");
          return true;
        }
        player.close_target(ctx, t);
      }
    }
    gpu.set(Some(Gpu { ...g, painter: painter.detach(g.painter) }));
  }
  log.warn("plex: no video texture, so the video fills the window");
  return player.show(ctx, p, android.Window { ptr: window });
}

// Pauses the video. On a texture the player keeps its surface: a player
// with no surface shuts its video decoder down, and a new decoder after the
// pause gets no frames. The painter keeps the window, so only the video on
// the window itself goes.
function pause_video(ctx: usize, p: player.Player, has: boolean, gpu: Cell[Option[Gpu]]): void {
  if let Some(g) = gpu.get() {
    if (g.target.is_some()) {
      return;
    }
  }
  hide_video(ctx, p, has, gpu);
}

// Takes the video off the window, and gives the window back to the
// painter.
function hide_video(ctx: usize, p: player.Player, has: boolean, gpu: Cell[Option[Gpu]]): void {
  if (!has) {
    return;
  }
  player.hide(ctx, p);
  if let Some(g) = gpu.get() {
    if let Some(t) = g.target {
      player.close_target(ctx, t);
    }
    let pt = g.painter;
    if (!painter.attached(pt) && g.window != 0 as usize) {
      pt = painter.attach(pt, g.window);
    }
    gpu.set(Some(Gpu { ...g, painter: pt, target: None }));
  }
}

function close_gpu(gpu: Cell[Option[Gpu]]): void {
  if let Some(g) = gpu.get() {
    gl.free(g.texture);
    let closed = painter.close(g.painter);
  }
  gpu.set(None);
}

// The device of the phone. `p` is the media player, or one with no object
// when Android gave none, and then nothing plays.
function device(ctx: usize, p: player.Player, gpu: Cell[Option[Gpu]], media: Media): control.Device {
  let has = p.obj != 0 as usize;
  let posters = android.cache_dir(ctx) + "/posters";
  return control.Device {
    mono_ms: (): i64 => mono_ms(),
    read: (path: string): string => read_text(path),
    write: (path: string, text: string): void => write_text(path, text),
    size: (window: usize): (i32, i32) => window_size(window),
    lock: (window: usize): draw.Frame => lock(window),
    post: (f: draw.Frame): void => android.post(f),
    finish: (): void => android.finish(ctx),
    keep_screen_on: (on: boolean): void => android.keep_screen_on(ctx, on),
    immersive: (on: boolean): void => android.immersive(ctx, on),
    brightness: (level: f32): void => android.brightness(ctx, level),
    system_brightness: (): f32 => android.system_brightness(ctx),
    volume: (): (i32, i32) => android.volume(ctx),
    set_volume: (level: i32): void => android.set_volume(ctx, level),
    now_playing: (title: string, artist: string, album: string, length_ms: i64, playing: boolean, at_ms: i64): void => now_playing(ctx, media, title, artist, album, length_ms, playing, at_ms),
    media_end: (): void => media_end(ctx, media),
    ask_notifications: (): void => ask_notifications(ctx),
    show_field: (q: string): void => keyboard.show(ctx, q, android.INPUT_TEXT, android.ACTION_SEARCH),
    set_field: (q: string): void => keyboard.set_text(ctx, q),
    hide_field: (): void => keyboard.hide(ctx),
    fetch: (rs: plex.Request[]): worker.Worker[plex.Reply[]] => fetch_all(rs),
    fetch_images: (rs: plex.Request[]): worker.Worker[plex.Reply[]] => fetch_images(posters, rs),
    decode: (bytes: u8[], w: i32, h: i32): Option[draw.Image] => image.decode_cover(bytes, w, h),
    play: (uri: string): boolean => has && player.open(ctx, p, uri),
    show_video: (window: usize): boolean => show_video(ctx, p, has, gpu, window),
    attach: (window: usize): boolean => attach_gpu(gpu, window),
    detach: (): void => detach_gpu(gpu),
    present: (window: usize, nodes: scene.Node[], video: boolean): boolean => present(ctx, p, gpu, window, nodes, video),
    hide_video: (): void => hide_video(ctx, p, has, gpu),
    pause_video: (): void => pause_video(ctx, p, has, gpu),
    request_frame: (): void => android.request_frame(ctx),
    start: (): void => start(ctx, p, has),
    pause: (): void => pause(ctx, p, has),
    seek: (ms: i64): void => seek(ctx, p, has, ms),
    position: (): i64 => position(ctx, p, has),
    duration: (): i64 => duration(ctx, p, has),
    stop: (): void => stop(ctx, p, has),
    has_audio: (): boolean => has && player.has_audio(ctx, p),
    audio_tracks: (): i32[] => sound_tracks(ctx, p, has),
    select_track: (i: i32): boolean => has && player.select_track(ctx, p, i),
    random: (): i32 => rand.next_i32() & 2147483647,
    decoders: decoders(ctx),
  };
}

function start(ctx: usize, p: player.Player, has: boolean): void {
  if (has) {
    let ok = player.start(ctx, p);
  }
}

function pause(ctx: usize, p: player.Player, has: boolean): void {
  if (has) {
    let ok = player.pause(ctx, p);
  }
}

function seek(ctx: usize, p: player.Player, has: boolean, ms: i64): void {
  if (has) {
    let ok = player.seek(ctx, p, ms, player.Sync);
  }
}

function position(ctx: usize, p: player.Player, has: boolean): i64 {
  if (has) {
    return player.position_ms(ctx, p);
  }
  return 0i64;
}

function duration(ctx: usize, p: player.Player, has: boolean): i64 {
  if (has) {
    return player.duration_ms(ctx, p);
  }
  return 0i64;
}

function stop(ctx: usize, p: player.Player, has: boolean): void {
  if (has) {
    player.stop(ctx, p);
  }
}

function sound_tracks(ctx: usize, p: player.Player, has: boolean): i32[] {
  if (has) {
    return player.audio_tracks(ctx, p);
  }
  return [];
}

function app_main(ctx: usize): usize {
  let p = player.Player { obj: 0 as usize, listener: 0 as usize };
  if let Some(made) = player.new(ctx, "dev.fern.plex.Media") {
    p = made;
  } else {
    log.warn("plex: no media player");
  }
  let none: Option[Gpu] = None;
  let gpu = cell_new(none);
  let none_awake: Option[service.Awake] = None;
  let media = Media { session: session.new(ctx, "dev.fern.plex.Controls", "Fern for Plex"), awake: cell_new(none_awake) };
  let first = control.new(device(ctx, p, gpu, media), android.data_dir(ctx), android.intent_extra(ctx, "server"), android.intent_extra(ctx, "token"), android.intent_extra(ctx, "play"));
  log.info("plex: started");
  let last = android.run(ctx, first, (own s: control.App, e: android.Event): control.App => control.step(s, e), (s: control.App): i32 => control.timeout(s, mono_ms()));
  control.close(last);
  media_end(ctx, media);
  if let Some(s) = media.session {
    session.close(ctx, s);
  }
  close_gpu(gpu);
  if (p.obj != 0 as usize) {
    player.close(ctx, p);
  }
  log.info("plex: destroyed");
  return 0 as usize;
}
