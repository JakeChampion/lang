import "std/jni";

pub function Java_dev_fern_demo_Native_answer(env: usize, thiz: usize): i32 {
  return 42;
}

pub function Java_dev_fern_demo_Native_jniVersion(env: usize, thiz: usize): i32 {
  return jni.get_version(env);
}

pub function Java_dev_fern_demo_Native_greeting(env: usize, thiz: usize): usize {
  return jni.new_string_utf(env, jni.cstr("Hello from Fern!"));
}

pub function Java_dev_fern_demo_Native_utf8Length(env: usize, thiz: usize, s: usize): i32 {
  return jni.get_string_utf_length(env, s);
}

pub function Java_dev_fern_demo_Native_isString(env: usize, thiz: usize, obj: usize): i32 {
  let strCls: usize = jni.find_class(env, jni.cstr("java/lang/String"));
  return jni.is_instance_of(env, obj, strCls);
}

pub function Java_dev_fern_demo_Native_objectHashCode(env: usize, thiz: usize, obj: usize): i32 {
  let cls: usize = jni.get_object_class(env, obj);
  let mid: usize = jni.get_method_id(env, cls, jni.cstr("hashCode"), jni.cstr("()I"));
  return jni.call_int_method_a(env, obj, mid, jni.jvalues([]));
}

pub function Java_dev_fern_demo_Native_charCodeAt(env: usize, thiz: usize, s: usize, i: usize): i32 {
  let cls: usize = jni.get_object_class(env, s);
  let mid: usize = jni.get_method_id(env, cls, jni.cstr("charAt"), jni.cstr("(I)C"));
  return jni.call_int_method_a(env, s, mid, jni.jvalues([i]));
}

function main(): i32 {
  return 0;
}
