import "std/jni";

pub function Java_dev_fern_demo_Native_answer(env: usize, thiz: usize): i32 {
  return 42;
}

pub function Java_dev_fern_demo_Native_jniVersion(env: usize, thiz: usize): i32 {
  return jni.get_version(env);
}

pub function Java_dev_fern_demo_Native_greeting(env: usize, thiz: usize): usize {
  return jni.new_string(env, "Hello from Fern!");
}

pub function Java_dev_fern_demo_Native_utf8Length(env: usize, thiz: usize, s: usize): i32 {
  return jni.get_string_utf_length(env, s);
}

pub function Java_dev_fern_demo_Native_isString(env: usize, thiz: usize, obj: usize): u8 {
  let name: usize = jni.cstr("java/lang/String");
  let strCls: usize = jni.find_class(env, name);
  jni.free_buffer(name);
  return jni.is_instance_of(env, obj, strCls) as u8;
}

// The method `name` with signature `sig` of the class of `obj`.
function method(env: usize, obj: usize, name: string, sig: string): usize {
  let n: usize = jni.cstr(name);
  let g: usize = jni.cstr(sig);
  let mid: usize = jni.get_method_id(env, jni.get_object_class(env, obj), n, g);
  jni.free_buffer(g);
  jni.free_buffer(n);
  return mid;
}

pub function Java_dev_fern_demo_Native_objectHashCode(env: usize, thiz: usize, obj: usize): i32 {
  let args: usize = jni.jvalues([]);
  let h: i32 = jni.call_int_method_a(env, obj, method(env, obj, "hashCode", "()I"), args);
  jni.free_buffer(args);
  return h;
}

pub function Java_dev_fern_demo_Native_charCodeAt(env: usize, thiz: usize, s: usize, i: i32): i32 {
  let args: usize = jni.jvalues([i as usize]);
  let c: i32 = jni.call_int_method_a(env, s, method(env, s, "charAt", "(I)C"), args);
  jni.free_buffer(args);
  return c;
}

function main(): i32 {
  return 0;
}
