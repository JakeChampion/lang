import "std/jni";

@jni("dev.fern.demo.Native", "int answer()")
pub function answer(env: usize, thiz: usize): i32 {
  return 42;
}

@jni("dev.fern.demo.Native", "int jniVersion()")
pub function jni_version(env: usize, thiz: usize): i32 {
  return jni.get_version(env);
}

@jni("dev.fern.demo.Native", "String greeting()")
pub function greeting(env: usize, thiz: usize): usize {
  return jni.new_string(env, "Hello from Fern!");
}

@jni("dev.fern.demo.Native", "int utf8Length(String)")
pub function utf8_length(env: usize, thiz: usize, s: usize): i32 {
  return jni.get_string_utf_length(env, s);
}

@jni("dev.fern.demo.Native", "boolean isString(Object)")
pub function is_string(env: usize, thiz: usize, obj: usize): u8 {
  let strCls: usize = jni.find_class(env, "java/lang/String");
  return jni.is_instance_of(env, obj, strCls) as u8;
}

@jni("dev.fern.demo.Native", "int objectHashCode(Object)")
pub function object_hash_code(env: usize, thiz: usize, obj: usize): i32 {
  let mid: usize = jni.get_method_id(env, jni.get_object_class(env, obj), "hashCode", "()I");
  let args: usize = jni.jvalues([]);
  let h: i32 = jni.call_int_method_a(env, obj, mid, args);
  jni.free_buffer(args);
  return h;
}

@jni("dev.fern.demo.Native", "int charCodeAt(String, int)")
pub function char_code_at(env: usize, thiz: usize, s: usize, i: i32): i32 {
  let mid: usize = jni.get_method_id(env, jni.get_object_class(env, s), "charAt", "(I)C");
  let args: usize = jni.jvalues([i as usize]);
  let c: i32 = jni.call_int_method_a(env, s, mid, args);
  jni.free_buffer(args);
  return c;
}
