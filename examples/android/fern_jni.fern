// examples/android/fern_jni.fern — a JNI native library written in Fern.
//
// This demonstrates both directions of the JNI boundary that the Android
// app path enables (no Kotlin/JVM code generated by Fern — just a .so the
// app loads with System.loadLibrary):
//
//   * Fern functions ARE JNI native methods. A JNI native method has the C
//     signature `(JNIEnv* env, jobject thiz, args...)`; Fern maps env/thiz
//     to `usize` params (System V / AAPCS64 integer registers), and an i32
//     return comes back as a `jint`. The symbol name follows the JNI
//     mangling `Java_<pkg with _ for .>_<Class>_<method>`.
//
//   * Fern can CALL JNIEnv methods, via std/jni (built on __c_call).
//
// Build the shared object (arm64 for a device, or x86-64 for an emulator):
//
//   fern -target arm64-android -shared \
//        -export Java_dev_fern_demo_Native_answer,Java_dev_fern_demo_Native_jniVersion,Java_dev_fern_demo_Native_greeting,Java_dev_fern_demo_Native_utf8Length,Java_dev_fern_demo_Native_isString,Java_dev_fern_demo_Native_objectHashCode,Java_dev_fern_demo_Native_charCodeAt \
//        -o libfern.so examples/android/fern_jni.fern
//
// Then drop libfern.so into the APK under lib/arm64-v8a/ and load it from a
// `Native` class with matching `external fun` declarations. See README.md
// for the full aapt2 / zipalign / apksigner (or Gradle) packaging recipe.

import "std/jni";

// jint Java_dev_fern_demo_Native_answer(JNIEnv* env, jobject thiz)
// The classic "native method returns 42" — Fern code invoked by the JVM.
pub function Java_dev_fern_demo_Native_answer(env: usize, thiz: usize): i32 {
    return 42;
}

// jint Java_dev_fern_demo_Native_jniVersion(JNIEnv* env, jobject thiz)
// Calls back INTO the JVM: GetVersion() (JNIEnv method index 4, taking only
// env) via the typed std/jni wrapper. Demonstrates the outbound path (the
// return is the JNI version, e.g. 0x00010006 for JNI 1.6).
pub function Java_dev_fern_demo_Native_jniVersion(env: usize, thiz: usize): i32 {
    return jni.get_version(env);
}

// jstring Java_dev_fern_demo_Native_greeting(JNIEnv* env, jobject thiz)
// Returns a freshly constructed Java String. `jni.cstr` turns a Fern string
// into the NUL-terminated `const char*` NewStringUTF wants; the returned
// jstring (an opaque handle, here a `usize`) is handed straight back to the
// JVM. Kotlin side: `external fun greeting(): String`.
pub function Java_dev_fern_demo_Native_greeting(env: usize, thiz: usize): usize {
    return jni.new_string_utf(env, jni.cstr("Hello from Fern!"));
}

// jint Java_dev_fern_demo_Native_utf8Length(JNIEnv* env, jobject thiz, jstring s)
// Reads an inbound Java String argument. The jstring is just another
// `usize` parameter (3rd integer register); GetStringUTFLength reports its
// UTF-8 byte length. Kotlin: `external fun utf8Length(s: String): Int`.
pub function Java_dev_fern_demo_Native_utf8Length(env: usize, thiz: usize, s: usize): i32 {
    return jni.get_string_utf_length(env, s);
}

// jboolean Java_dev_fern_demo_Native_isString(JNIEnv* env, jobject thiz, jobject obj)
// Resolves java.lang.String via FindClass (note the JVM-internal name with
// '/' separators, built with cstr) and asks IsInstanceOf whether `obj` is
// one. Kotlin: `external fun isString(obj: Any): Boolean`.
pub function Java_dev_fern_demo_Native_isString(env: usize, thiz: usize, obj: usize): i32 {
    var strCls: usize = jni.find_class(env, jni.cstr("java/lang/String"));
    return jni.is_instance_of(env, obj, strCls);
}

// jint Java_dev_fern_demo_Native_objectHashCode(JNIEnv* env, jobject thiz, jobject obj)
// CALLS a Java method on `obj`: resolves Object.hashCode() ("()I", no args)
// via GetObjectClass + GetMethodID, then invokes it with an empty jvalue
// array. The full no-arg call chain. Kotlin: `external fun
// objectHashCode(obj: Any): Int`.
pub function Java_dev_fern_demo_Native_objectHashCode(env: usize, thiz: usize, obj: usize): i32 {
    var cls: usize = jni.get_object_class(env, obj);
    var mid: usize = jni.get_method_id(env, cls, jni.cstr("hashCode"), jni.cstr("()I"));
    return jni.call_int_method_a(env, obj, mid, jni.jvalues([]));
}

// jint Java_dev_fern_demo_Native_charCodeAt(JNIEnv* env, jobject thiz, jstring s, jint i)
// CALLS a Java method WITH an argument: String.charAt(int) ("(I)C") on `s`,
// packing the index into a one-element jvalue array. Returns the UTF-16 code
// unit. Kotlin: `external fun charCodeAt(s: String, i: Int): Int`.
pub function Java_dev_fern_demo_Native_charCodeAt(env: usize, thiz: usize, s: usize, i: usize): i32 {
    var cls: usize = jni.get_object_class(env, s);
    var mid: usize = jni.get_method_id(env, cls, jni.cstr("charAt"), jni.cstr("(I)C"));
    return jni.call_int_method_a(env, s, mid, jni.jvalues([i]));
}

// A .so has no entry point, but the compiler still wants a `main`; it is
// never called when the library is loaded via dlopen / System.loadLibrary.
function main(): i32 { return 0; }
