// examples/android/fern_jni.fern — a JNI native library written in Fern.
//
// This demonstrates both directions of the JNI boundary that the Android
// app path enables (no Kotlin/JVM code generated by Fern — just a .so the
// app loads with System.loadLibrary):
//
//   * Fern functions ARE JNI native methods. A JNI native method has the C
//     signature `(JNIEnv* env, jobject thiz, args...)`; Fern maps env/thiz
//     to `usize` params (System V / AAPCS64 integer registers), and an i32
//     return comes back as a `jint`. The symbol name follows the JNI
//     mangling `Java_<pkg with _ for .>_<Class>_<method>`.
//
//   * Fern can CALL JNIEnv methods, via std/jni (built on __c_call).
//
// Build the shared object (arm64 for a device, or x86-64 for an emulator):
//
//   fern -target arm64-android -shared \
//        -export Java_dev_fern_demo_Native_answer,Java_dev_fern_demo_Native_jniVersion \
//        -o libfern.so examples/android/fern_jni.fern
//
// Then drop libfern.so into the APK under lib/arm64-v8a/ and load it from a
// `Native` class with a matching `external fun answer(): Int`. See README.md
// for the full aapt2 / zipalign / apksigner (or Gradle) packaging recipe.

import "std/jni";

// jint Java_dev_fern_demo_Native_answer(JNIEnv* env, jobject thiz)
// The classic "native method returns 42" — Fern code invoked by the JVM.
pub function Java_dev_fern_demo_Native_answer(env: usize, thiz: usize): i32 {
    return 42;
}

// jint Java_dev_fern_demo_Native_jniVersion(JNIEnv* env, jobject thiz)
// Calls back INTO the JVM: GetVersion() is JNIEnv method index 4, taking
// only env. Demonstrates the outbound std/jni path (the return is the JNI
// version, e.g. 0x00010006 for JNI 1.6).
pub function Java_dev_fern_demo_Native_jniVersion(env: usize, thiz: usize): i32 {
    return jni.call0(env, 4) as i32;
}

// A .so has no entry point, but the compiler still wants a `main`; it is
// never called when the library is loaded via dlopen / System.loadLibrary.
function main(): i32 { return 0; }
