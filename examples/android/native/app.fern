// A stopwatch with no Java code. NativeActivity loads this library and calls
// ANativeActivity_onCreate. A tap starts or pauses the stopwatch, and the
// back key closes the app. Each change writes a line to logcat.
import "std/android";
import "std/log";
import "./face";

struct App { ctx: usize, window: usize, started_ns: i64, before_ms: i64, running: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let first: App = App { ctx: ctx, window: 0 as usize, started_ns: 0 as i64, before_ms: 0 as i64, running: false };
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => timeout(s));
  log.info("stopwatch: destroyed at " + elapsed_ms(last).to_string() + " ms");
  return 0 as usize;
}

function elapsed_ms(s: App): i64 {
  if (!s.running) {
    return s.before_ms;
  }
  return s.before_ms + (monotonic_ns() - s.started_ns) / 1000000i64;
}

function timeout(s: App): i32 {
  if (s.running && s.window != 0 as usize) {
    return face.next_change_ms(elapsed_ms(s));
  }
  return 0 - 1;
}

function step(s: App, e: android.Event): App {
  match (e) {
    android.WindowCreated(w) => {
      log.info("stopwatch: window " + w.width().to_string() + "x" + w.height().to_string());
      return draw(App { ...s, window: w.ptr });
    },
    android.WindowResized(w) => {
      return draw(App { ...s, window: w.ptr });
    },
    android.WindowRedraw(w) => {
      return draw(App { ...s, window: w.ptr });
    },
    android.WindowDestroyed(_) => {
      return App { ...s, window: 0 as usize };
    },
    android.Touch(action, _, _) => {
      if (action == 0) {
        return draw(toggle(s));
      }
      return s;
    },
    android.Key(code, action) => {
      if (code == 4 && action == 1) {
        android.finish(s.ctx);
      }
      return s;
    },
    android.Tick => {
      return draw(s);
    },
    _ => {
      return s;
    }
  }
}

function toggle(s: App): App {
  if (s.running) {
    let paused: App = App { ...s, before_ms: elapsed_ms(s), running: false };
    android.keep_screen_on(s.ctx, false);
    log.info("stopwatch: paused at " + paused.before_ms.to_string() + " ms");
    return paused;
  }
  android.keep_screen_on(s.ctx, true);
  log.info("stopwatch: started at " + s.before_ms.to_string() + " ms");
  return App { ...s, started_ns: monotonic_ns(), running: true };
}

function draw(s: App): App {
  if (s.window == 0 as usize) {
    return s;
  }
  let w: android.Window = android.Window { ptr: s.window };
  let f: android.Frame = w.lock();
  if (f.width == 0) {
    return s;
  }
  f.fill(0, 0, f.width, f.height, android.rgb(0, 0, 0));
  let color: i32 = android.rgb(110, 110, 110);
  if (s.running) {
    color = android.rgb(80, 200, 120);
  }
  for r in face.face_rects(elapsed_ms(s), f.width, f.height) {
    f.fill(r.x, r.y, r.w, r.h, color);
  }
  android.post(f);
  return s;
}
