import "std/f64";
import "std/opus/packet";
import "std/test";
import "./voice";

// A vowel-like sound: a pitch of 150 Hz with three harmonics, in the
// 16-bit range.
function speech(n: i32, start: i32): i32[] {
  let x: i32[] = [];
  for i in 0..n {
    let t: f64 = (start + i) as f64 / (voice.RATE as f64);
    let w: f64 = 6.283185307179586 * 150.0 * t;
    let v: f64 = 6000.0 * w.sin() + 3000.0 * (2.0 * w).sin() + 1500.0 * (3.0 * w).sin();
    x = x.append(v as i32);
  }
  return x;
}

struct Coded { input: i32[], output: i32[], bytes: i32, frames: i32 }

function code(frames: i32): Coded {
  let enc = voice.encoder();
  let dec = voice.decoder();
  let input: i32[] = [];
  let output: i32[] = [];
  let bytes: i32 = 0;
  for f in 0..frames {
    let x: i32[] = speech(voice.FRAME, f * voice.FRAME);
    for v in x {
      input = input.append(v);
    }
    let (e1, p) = voice.encode(enc, x);
    enc = e1;
    bytes = bytes + p.len();
    match (dec) {
      Some(d) => {
        let (d1, y) = voice.decode(d, p);
        dec = Some(d1);
        for v in y {
          output = output.append(v);
        }
      },
      None => {}
    }
  }
  return Coded { input: input, output: output, bytes: bytes, frames: frames };
}

// The best normalised correlation of the output with the input, over the
// delay of the codec.
function best_correlation(c: Coded): f64 {
  let best: f64 = 0.0;
  for lag in 0..200 {
    let xy: f64 = 0.0;
    let xx: f64 = 0.0;
    let yy: f64 = 0.0;
    for i in 1600..c.output.len() - lag {
      let x: f64 = c.input[i] as f64;
      let y: f64 = c.output[i + lag] as f64;
      xy = xy + x * y;
      xx = xx + x * x;
      yy = yy + y * y;
    }
    let r: f64 = xy / (xx * yy + 1.0).sqrt();
    if (r > best) {
      best = r;
    }
  }
  return best;
}

// The decoded voice follows the input closely, after the delay of the codec.
function test_round_trip_keeps_the_voice(): test.TestOutcome {
  let c: Coded = code(50);
  let r: f64 = best_correlation(c);
  if (c.output.len() != c.input.len() || r < 0.95) {
    return test.fail("the output has " + c.output.len().to_string() + " samples and a correlation of " + r.to_string());
  }
  return test.pass();
}

// A second of voice takes about 24 kbit/s.
function test_rate_is_near_the_target(): test.TestOutcome {
  let c: Coded = code(50);
  let kbits: i32 = c.bytes * 8 / 1000;
  if (kbits < 18 || kbits > 30) {
    return test.fail("one second took " + kbits.to_string() + " kbit");
  }
  return test.pass();
}

// Each packet is one wideband CELT frame of 20 ms.
function test_packet_is_one_wideband_celt_frame(): test.TestOutcome {
  let (_, p) = voice.encode(voice.encoder(), speech(voice.FRAME, 0));
  let toc: u8 = p[0];
  let ok: boolean = packet.bandwidth(toc) == packet.WIDEBAND && packet.samples_per_frame(toc, voice.RATE) == voice.FRAME && !packet.stereo(toc);
  match (packet.mode(toc)) {
    packet.Celt => {},
    _ => {
      ok = false;
    }
  }
  return test.assert_eq(ok, true);
}

// A packet of another codec gives no samples.
function test_other_packet_gives_nothing(): test.TestOutcome {
  match (voice.decoder()) {
    Some(d) => {
      let (_, y) = voice.decode(d, [0u8, 1u8, 2u8]);
      return test.assert_eq(y.len(), 0);
    },
    None => {
      return test.fail("no decoder");
    }
  }
}

function main(): i32 {
  let r: test.TestRunner = test.new("walkie voice");
  r = r.it("the round trip keeps the voice", test_round_trip_keeps_the_voice);
  r = r.it("the rate is near the target", test_rate_is_near_the_target);
  r = r.it("a packet is one wideband CELT frame", test_packet_is_one_wideband_celt_frame);
  r = r.it("a packet of another codec gives nothing", test_other_packet_gives_nothing);
  return r.finish();
}
