// The look of the walkie-talkie screen, in the style of a dot-matrix
// display: a black background, white and grey type, and red only for what is
// live. Titles, labels and the code are rows of round dots. The talk button
// is a ring of dots that fills red while the phone talks and white while it
// listens. It draws a View on a frame and does no other I/O, so the host
// tests it on a frame in memory.
import "std/android/draw";
import "std/string";
import "../look";
import "../matrix";
import "./modes";
import "./rooms";
import "./screen";

pub struct Peer { name: string, invited: boolean }

pub struct View {
  title: string,
  status: string,
  notice: string,
  // The words of the talk button.
  label: string,
  // The code that the users compare, or "".
  code: string,
  // True while the phone looks for a peer.
  searching: boolean,
  peers: Peer[],
  room_buttons: boolean,
  // The code that the user types, while the keypad shows.
  typing: Option[string],
  // The short name of the mode on the button that opens the settings
  // screen, or "" for no button.
  mode_label: string,
  // The position of the chosen mode while the settings screen shows, and
  // whether each mode can be chosen.
  menu: Option[i32],
  available: boolean[],
  // The room server on the settings screen, and the name that the user types
  // while the keyboard for it shows.
  server: string,
  editing: Option[string],
}

// The colour of the state that the talk button shows: red while it talks or
// failed, white while it listens or is ready, and grey while it waits.
pub function accent(label: string): i32 {
  if (label == "TALKING" || label == "TAP TO SEARCH AGAIN") {
    return look.red();
  }
  if (label == "LISTENING" || label == "HOLD TO TALK") {
    return look.ink();
  }
  if (label == "WAIT" || label == "WAITING") {
    return look.muted();
  }
  return look.outline();
}

// The scale of the smaller text: the status, the notice and the help lines.
function small_scale(sc: i32): i32 {
  if (sc * 3 / 4 < 1) {
    return 1;
  }
  return sc * 3 / 4;
}

// The largest scale up to `cap` at which `text` fits in `w` pixels.
pub function fit_scale(text: string, w: i32, cap: i32): i32 {
  let sc = cap;
  while (sc > 1 && draw.text_width(text, sc) > w) {
    sc -= 1;
  }
  return sc;
}

pub function render(f: draw.Frame, v: View): void {
  let sc = screen.text_scale(f.width, draw.text_width("x", 1));
  f.fill(0, 0, f.width, f.height, look.bg());
  header(f, v, sc);
  if let Some(name) = v.editing {
    host_keyboard(f, name, sc);
    return;
  }
  if let Some(chosen) = v.menu {
    settings(f, chosen, v.available, v.server, sc);
    return;
  }
  if let Some(typed) = v.typing {
    keypad(f, typed);
    return;
  }
  if (v.mode_label.len() > 0) {
    look.outlined(f, screen.mode_button(f.width, f.height), v.mode_label, look.muted());
  }
  if (v.code.len() > 0) {
    compare(f, v.code);
  } else if (v.searching) {
    peers(f, v.peers, sc);
  }
  talk(f, v.label);
  if (v.room_buttons) {
    look.outlined(f, screen.room_button(f.width, f.height), "NEW ROOM", look.ink());
    look.outlined(f, screen.join_button(f.width, f.height), "JOIN ROOM", look.ink());
  }
}

// The title in dots, a dot in the colour of the state, the status and the
// notice.
function header(f: draw.Frame, v: View, sc: i32): void {
  let left: i32 = f.width / 14;
  let room: i32 = f.width - left * 2;
  if (v.mode_label.len() > 0 && v.menu.is_none() && v.editing.is_none()) {
    room = screen.mode_button(f.width, f.height).x - left * 2;
  }
  let p: i32 = matrix.fit_pitch(v.title, room, f.width / 90);
  let line: i32 = draw.text_height(sc) * 3 / 2;
  matrix.text(f, left, screen.mode_button(f.width, f.height).y + (screen.mode_button(f.width, f.height).h - matrix.height(p)) / 2, v.title, p, look.ink());
  let small: i32 = small_scale(sc);
  let th: i32 = draw.text_height(small);
  let chars: i32 = screen.line_chars(f.width - left * 2 - th, draw.text_width("x", 1), small) * 10 / 9;
  let y: i32 = line * 2 + line / 2;
  f.disc(left + th / 3, y + th / 2, th / 5, accent(v.label));
  for l in screen.wrap(v.status, chars) {
    f.text(left + th, y, l, small, look.muted());
    y = y + th * 4 / 3;
  }
  for l in screen.wrap(v.notice, chars) {
    f.text(left + th, y, l, small, look.red());
    y = y + th * 4 / 3;
  }
}

// The code that the users compare, in two groups of three dots, and the two
// buttons.
function compare(f: draw.Frame, code: string): void {
  let shown: string = code;
  if (code.len() == 6) {
    shown = code.take(3) + " " + code.drop(3);
  }
  let p: i32 = matrix.fit_pitch(shown, f.width * 8 / 10, f.width / 45);
  matrix.text(f, (f.width - matrix.width(shown, p)) / 2, f.height * 22 / 100, shown, p, look.ink());
  look.pill(f, screen.same_button(f.width, f.height), "MATCH", look.ink(), look.bg());
  look.outlined(f, screen.differ_button(f.width, f.height), "NO MATCH", look.red());
}

// The Wi-Fi Direct peers, one card each.
function peers(f: draw.Frame, list: Peer[], sc: i32): void {
  for k in 0..list.len() {
    if (k < screen.PEER_ROWS) {
      let row: screen.Rect = screen.peer_row(f.width, f.height, k);
      look.card(f, row, look.surface());
      let ts: i32 = fit_scale(list[k].name, row.w * 6 / 10, small_scale(sc));
      f.text(row.x + row.h / 3, row.y + row.h / 2 - draw.text_height(ts) / 2, list[k].name, ts, look.ink());
      if (list[k].invited) {
        let tag: string = "INVITED";
        let tp: i32 = look.label_pitch(row) * 3 / 4 + 1;
        matrix.text(f, row.x + row.w - row.h / 3 - matrix.width(tag, tp), row.y + (row.h - matrix.height(tp)) / 2, tag, tp, look.red());
      }
    }
  }
}

// The round talk button: filled red while it talks and white while it
// listens, and a ring of dots in the colour of the state otherwise.
function talk(f: draw.Frame, label: string): void {
  let r: screen.Rect = screen.talk_button(f.width, f.height);
  let cx: i32 = r.x + r.w / 2;
  let cy: i32 = r.y + r.h / 2;
  let rad: i32 = r.w / 2;
  let text: i32 = look.ink();
  if (label == "TALKING") {
    f.disc(cx, cy, rad, look.red());
  } else if (label == "LISTENING") {
    f.disc(cx, cy, rad, look.ink());
    text = look.bg();
  } else {
    f.disc(cx, cy, rad * 92 / 100, look.surface());
    look.dotted_ring(f, cx, cy, rad - rad / 30, rad / 30 + 1, 72, accent(label));
  }
  let p: i32 = matrix.fit_pitch(label, r.w * 7 / 10, r.w / 60 + 1);
  matrix.text(f, cx - matrix.width(label, p) / 2, cy - matrix.height(p) / 2, label, p, text);
}

// The six boxes of the code, the keys, CANCEL and JOIN.
function keypad(f: draw.Frame, typed: string): void {
  let n: i32 = rooms.CODE_LEN;
  let gap: i32 = f.width / 60;
  let bw: i32 = (f.width * 8 / 10 - gap * (n - 1)) / n;
  let bh: i32 = bw * 5 / 4;
  let y: i32 = f.height * 3 / 10 - bh - f.height / 40;
  for k in 0..n {
    let bx = f.width / 10 + k * (bw + gap);
    let edge = look.outline();
    if (k == typed.len()) {
      edge = look.ink();
    }
    let box: screen.Rect = screen.Rect { x: bx, y: y, w: bw, h: bh };
    look.card(f, box, edge);
    if (k < typed.len()) {
      look.dots_in(f, box, typed.drop(k).take(1), bh / 12, look.ink());
    }
  }
  for k in 0..screen.DELETE_KEY + 1 {
    let key: screen.Rect = screen.key_rect(f.width, f.height, k);
    key_cap(f, key, screen.key_label(k), k == screen.DELETE_KEY);
  }
  look.outlined(f, screen.room_button(f.width, f.height), "CANCEL", look.muted());
  if (typed.len() == n) {
    look.pill(f, screen.join_button(f.width, f.height), "JOIN", look.ink(), look.bg());
  } else {
    look.pill(f, screen.join_button(f.width, f.height), "JOIN", look.surface(), look.muted());
  }
}

// One key: a dark cap with its label in dots, red for a key that removes.
function key_cap(f: draw.Frame, key: screen.Rect, label: string, removes: boolean): void {
  let color: i32 = look.ink();
  if (removes) {
    color = look.red();
  }
  f.round_rect(key.x, key.y, key.w, key.h, key.w / 5, look.surface());
  look.dots_in(f, key, label, key.h / 14 + 1, color);
}

// The settings screen: a card for each mode with what it does, the chosen
// mode outlined in white with a red dot, the room server, and BACK.
function settings(f: draw.Frame, chosen: i32, available: [boolean], server: string, sc: i32): void {
  let list: modes.Mode[] = modes.all();
  let help_scale: i32 = small_scale(sc);
  let width: i32 = screen.mode_row(f.width, f.height, 0).w * 9 / 10;
  for m in list {
    help_scale = imin(help_scale, fit_scale(modes.help(m), width, small_scale(sc)));
  }
  help_scale = imin(help_scale, fit_scale(NO_SERVER, width, small_scale(sc)));
  for k in 0..list.len() {
    let row: screen.Rect = screen.mode_row(f.width, f.height, k);
    let open: boolean = k < available.len() && available[k];
    let edge: i32 = look.surface();
    if (k == chosen) {
      edge = look.ink();
    }
    look.card(f, row, edge);
    mode_card(f, row, list[k], k == chosen, open, help_scale);
  }
  server_card(f, server, help_scale);
  look.outlined(f, screen.back_button(f.width, f.height), "BACK", look.muted());
}

const NO_SERVER: string = "needs a server";

function imin(a: i32, b: i32): i32 {
  if (a < b) {
    return a;
  }
  return b;
}

// The name and the help of one mode in its card. Each help line has the
// same scale `small`.
function mode_card(f: draw.Frame, row: screen.Rect, m: modes.Mode, chosen: boolean, open: boolean, small: i32): void {
  let color: i32 = look.ink();
  let help: string = modes.help(m);
  if (!open) {
    color = look.muted();
    help = NO_SERVER;
  }
  let left: i32 = row.x + row.h / 4;
  let p: i32 = matrix.fit_pitch(modes.name(m), row.w * 7 / 10, row.h / 22 + 1);
  matrix.text(f, left, row.y + row.h / 5, modes.name(m), p, color);
  f.text(left, row.y + row.h * 64 / 100, help, small, look.muted());
  if (chosen) {
    f.disc(row.x + row.w - row.h / 4, row.y + row.h / 2, row.h / 12 + 1, look.red());
  }
}

// The card of the room server: SERVER in dots, and the name in text.
function server_card(f: draw.Frame, server: string, small: i32): void {
  let row: screen.Rect = screen.server_row(f.width, f.height);
  look.card(f, row, look.surface());
  let left: i32 = row.x + row.h / 4;
  matrix.text(f, left, row.y + row.h / 5, "SERVER", row.h / 22 + 1, look.ink());
  let ts: i32 = fit_scale(server, row.w * 9 / 10, small);
  f.text(left, row.y + row.h * 62 / 100, server, ts, look.muted());
}

// The field with the name of the server, the button that opens the keyboard
// of the phone, the keys, CANCEL and SAVE.
function host_keyboard(f: draw.Frame, name: string, sc: i32): void {
  let field: screen.Rect = screen.host_field(f.width, f.height);
  look.card(f, field, look.ink());
  let shown: string = name + "_";
  let ts: i32 = fit_scale(shown, field.w * 9 / 10, sc);
  f.text(field.x + field.h / 3, field.y + (field.h - draw.text_height(ts)) / 2, shown, ts, look.ink());
  look.outlined(f, screen.phone_keys_button(f.width, f.height), "PHONE KEYBOARD", look.ink());
  for k in 0..screen.HOST_DELETE_KEY + 1 {
    let key: screen.Rect = screen.host_key_rect(f.width, f.height, k);
    key_cap(f, key, screen.host_key_label(k), k >= screen.CLEAR_KEY);
  }
  look.outlined(f, screen.room_button(f.width, f.height), "CANCEL", look.muted());
  look.pill(f, screen.join_button(f.width, f.height), "SAVE", look.ink(), look.bg());
}
