// The walkie-talkie app. Two phones find each other by UDP broadcast on a
// Wi-Fi network or a Wi-Fi Direct group, or through the relay of a room on
// the room server. They run the key exchange, and the users compare the
// six-digit string. Then one holds the button to talk, and the other hears.
// The voice is Opus at 16 kHz, about 24 kbit/s.
//
// `node` holds the logic. This file does its input and output: the socket,
// the microphone, the speaker, the touches and the screen.
import "std/android";
import "std/android/audio";
import "std/android/focus";
import "std/android/p2p";
import "std/android/service";
import "std/hex";
import "std/log";
import "std/net";
import "std/rand";
import "std/tls/verify";
import "./control";
import "./internet";
import "./lan";
import "./modes";
import "./node";
import "./pcm";
import "./rooms";
import "./screen";
import "./server_host";
import "./ui";
import "./voice";

const MIC: string = "android.permission.RECORD_AUDIO";

// The foreground service that keeps the microphone and the network running
// while the window is not on the screen.
const SERVICE: string = "dev.fern.walkie.Talk";

// The receiver of the Wi-Fi Direct broadcasts.
const RECEIVER: string = "dev.fern.walkie.Direct";

const FOCUS: string = "dev.fern.walkie.Focus";

// Wi-Fi Direct discovery needs NEARBY_WIFI_DEVICES from API level 33, and
// the fine location before that.
const NEARBY: string = "android.permission.NEARBY_WIFI_DEVICES";

const LOCATION: string = "android.permission.ACCESS_FINE_LOCATION";

struct App {
  ctx: usize,
  window: usize,
  sock: Option[Socket],
  node: node.Node,
  mic: audio.Stream,
  spk: audio.Stream,
  capturing: boolean,
  up: pcm.Resampler,
  down: pcm.Resampler,
  agc: pcm.Agc,
  // The samples at the rate of the speaker that it did not take yet.
  queue: i32[],
  // The talk button is down, or the notification started a talk.
  pressed: boolean,
  toggled: boolean,
  drawn: string,
  asked: boolean,
  serving: boolean,
  p2p: Option[p2p.Manager],
  peers: p2p.Peer[],
  group_broadcast: Option[net.IpAddr],
  // The role of this phone in its Wi-Fi Direct group: the owner leads.
  group_role: i32,
  // The audio focus, which the phone holds while it talks.
  audio_focus: Option[focus.Focus],
  // The control stream of a Wi-Fi Direct group: the listening socket of the
  // owner, the stream to the peer, and the owner that the client dials at
  // `dial_at`.
  listener: Option[Socket],
  stream: Option[control.Stream],
  owner_ip: Option[net.IpAddr],
  dial_at: i64,
  // The room of the internet mode, the request for one, and the code that
  // the user types.
  room: Option[internet.Room],
  asking: Option[internet.Request],
  entering: Option[string],
  // The private directory of the app, the private directory that no backup
  // copies, this phone's identity seed, and the identities of the phones
  // that a user confirmed, as the files hold them.
  dir: string,
  keys: string,
  id_seed: u8[],
  pins: u8[][],
  // The way to find the other phone, and whether the settings screen shows.
  mode: modes.Mode,
  menu: boolean,
  // The room server that the user typed, or "" for the server of the build,
  // and the name while the user types it.
  server: string,
  host_edit: Option[string],
  // The wake lock and the Wi-Fi lock, while the foreground service runs.
  awake: Option[service.Awake],
  // Whether the notification shows the phone as talking.
  noticed: boolean,
}

@jni("dev.fern.walkie.Direct extends android.content.BroadcastReceiver", "void onReceive(android.content.Context, android.content.Intent)")
pub function direct_receive(env: usize, thiz: usize, context: usize, intent: usize): void {
  p2p.received(env, thiz, intent);
}

@jni("dev.fern.walkie.Focus implements android.media.AudioManager$OnAudioFocusChangeListener", "void onAudioFocusChange(int)")
pub function focus_change(env: usize, thiz: usize, change: i32): void {
  focus.changed(env, thiz, change);
}

@jni("dev.fern.walkie.Talk extends android.app.Service", "android.os.IBinder onBind(android.content.Intent)")
pub function talk_bind(env: usize, thiz: usize, intent: usize): usize {
  return 0 as usize;
}

@jni("dev.fern.walkie.Talk", "int onStartCommand(android.content.Intent, int, int)")
pub function talk_command(env: usize, thiz: usize, intent: usize, flags: i32, id: i32): i32 {
  return service.command(env, thiz, intent, notice(false));
}

// The notification of the service. Its TALK action talks while the app is
// in the background, and a second tap stops.
function notice(talking: boolean): service.Notice {
  let n: service.Notice = service.Notice { channel: "walkie", channel_name: "Walkie-talkie", title: "Fern Walkie", text: "The walkie-talkie is on.", action: "Talk", stop: "Disconnect", unlock: true };
  if (talking) {
    return service.Notice { ...n, text: "Talking. The other phone hears you.", action: "Stop talking" };
  }
  return n;
}

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function now_ms(): i64 {
  return monotonic_ns() / 1000000i64;
}

function node_id(): i64 {
  let b: u8[] = rand.bytes(8);
  let id: i64 = 0i64;
  for x in b {
    id = id << 8i64 | x as i64;
  }
  if (id < 0i64) {
    id = -(id + 1i64);
  }
  return id;
}

function any_addr(port: i32): net.SocketAddr {
  return net.socket_addr(net.V4([0u8, 0u8, 0u8, 0u8]), port);
}

// A socket on the first free port of lan.PORT and lan.SECOND_PORT, and the
// port. The socket is None when both ports are busy.
function open_socket(): (Option[Socket], i32) {
  for port in [lan.PORT, lan.SECOND_PORT] {
    match (net.udp_socket(any_addr(port))) {
      Ok(s) => {
        let nb: Result[void, net.NetError] = net.set_nonblocking(s, true);
        let bc: Result[void, net.NetError] = net.set_broadcast(s, true);
        return (Some(s), port);
      },
      Err(_) => {}
    }
  }
  return (None, lan.PORT);
}

function fresh_node(notice: string, id_seed: [u8], pins: u8[][], role: i32): node.Node {
  let n: node.Node = node.with_identity(node.new(lan.role_id(role, node_id()), rand.bytes(node.SEED_BYTES), now_ms()), id_seed, pins);
  return node.Node { ...n, notice: notice };
}

// The file `name` of `old`, moved into `keys` when `keys` has none. An older
// build kept the identity and the known phones where the backups copy them.
function move_key_file(keys: string, old: string, name: string): void {
  if (keys.len() == 0 || old.len() == 0 || read_file_bytes(keys + "/" + name).is_ok()) {
    return;
  }
  let Ok(b) = read_file_bytes(old + "/" + name) else {
    return;
  };
  if (write_file_bytes(keys + "/" + name, b).is_ok()) {
    let removed = remove_file(old + "/" + name);
  }
}

// This phone's identity seed in `dir`, which the first start makes. With no
// directory the identity lasts until the app stops.
function identity_seed(dir: string): u8[] {
  let path: string = dir + "/identity";
  if (dir.len() > 0) {
    if let Ok(b) = read_file_bytes(path) {
      if (b.len() == 32) {
        return b;
      }
    }
  }
  let seed: u8[] = rand.bytes(32);
  if (dir.len() > 0) {
    let written = write_file_bytes(path, seed);
  }
  return seed;
}

// The identities of the phones that a user confirmed, 32 bytes each.
function load_pins(dir: string): u8[][] {
  let out: u8[][] = [];
  if (dir.len() == 0) {
    return out;
  }
  let Ok(b) = read_file_bytes(dir + "/peers") else {
    return out;
  };
  let at = 0;
  while (at + 32 <= b.len()) {
    out = out.append(b.drop(at).take(32));
    at += 32;
  }
  return out;
}

// The mode that the settings screen chose, as the file of the app holds it.
function load_mode(dir: string): modes.Mode {
  if (dir.len() == 0) {
    return modes.Automatic;
  }
  let Ok(b) = read_file_bytes(dir + "/mode") else {
    return modes.Automatic;
  };
  return modes.of_bytes(b);
}

// The room server that the user typed, as the file of the app holds it.
function load_server(dir: string): string {
  if (dir.len() == 0) {
    return "";
  }
  let Ok(b) = read_file_bytes(dir + "/server") else {
    return "";
  };
  let name: string = unsafe { string_from_bytes_unchecked(b) };
  if (!modes.valid_host(name)) {
    return "";
  }
  return name;
}

function save_server(dir: string, name: string): void {
  if (dir.len() > 0) {
    let written = write_file(dir + "/server", name);
  }
}

// The room server: the one that the user typed, or the server of the build.
function server_of(s: App): string {
  if (s.server.len() > 0) {
    return s.server;
  }
  return server_host.SERVER_HOST;
}

function save_mode(dir: string, m: modes.Mode): void {
  if (dir.len() > 0) {
    let written = write_file_bytes(dir + "/mode", [modes.to_byte(m)]);
  }
}

// The file of known phones again, when the node learned a phone.
function save_pins(s: App): App {
  if (s.node.pins.len() == s.pins.len() || s.keys.len() == 0) {
    return s;
  }
  let all: u8[] = [];
  for p in s.node.pins {
    for x in p {
      all = all.append(x);
    }
  }
  let written = write_file_bytes(s.keys + "/peers", all);
  log.info("walkie: known phones " + s.node.pins.len().to_string());
  return App { ...s, pins: s.node.pins };
}

function app_main(ctx: usize): usize {
  let spk: audio.Stream = audio.playback(voice.RATE);
  let started: boolean = spk.start();
  let (sock, port) = open_socket();
  let notice = "";
  let fd: i32 = -1;
  if let Some(open) = sock {
    fd = open.fd;
  } else {
    notice = "no network: ports " + lan.PORT.to_string() + " and " + lan.SECOND_PORT.to_string() + " are busy";
  }
  android.keep_screen_on(ctx, true);
  let dir: string = android.data_dir(ctx);
  let keys: string = android.no_backup_dir(ctx);
  move_key_file(keys, dir, "identity");
  move_key_file(keys, dir, "peers");
  let id_seed: u8[] = identity_seed(keys);
  let pins: u8[][] = load_pins(keys);
  let mode: modes.Mode = load_mode(dir);
  let server: string = load_server(dir);
  let n: node.Node = fresh_node(notice, id_seed, pins, lan.ROLE_ANY);
  log.warn("walkie: identity " + hex.encode(node.identity_key(n).take(4)) + ", " + pins.len().to_string() + " known phones");
  log.warn("walkie: node " + n.link.me.to_string() + ", port " + port.to_string() + ", socket " + fd.to_string() + ", speaker rate " + spk.rate.to_string() + ", mode " + modes.name(mode) + ", server " + server);
  let first: App = App { ctx: ctx, window: 0 as usize, sock: sock, node: n, mic: audio.Stream { ptr: 0 as usize, rate: 0 }, spk: spk, capturing: false, up: pcm.resampler(voice.RATE, voice.RATE), down: pcm.resampler(voice.RATE, spk.rate), agc: pcm.agc(), queue: [], pressed: false, toggled: false, drawn: "", asked: false, serving: false, p2p: None, peers: [], group_broadcast: None, group_role: lan.ROLE_ANY, audio_focus: focus.new(ctx, FOCUS), listener: None, stream: None, owner_ip: None, dial_at: 0i64, room: None, asking: None, entering: None, dir: dir, keys: keys, id_seed: id_seed, pins: pins, mode: mode, menu: false, server: server, host_edit: None, awake: None, noticed: false };
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => 10);
  shut(last);
  return 0 as usize;
}

function shut(own s: App): void {
  s.mic.stop();
  s.mic.close();
  s.spk.stop();
  s.spk.close();
  node.close(s.node);
  if let Some(q) = s.asking {
    internet.cancel(q);
  }
  if let Some(sock) = s.sock {
    let closed: Result[void, net.NetError] = net.close(sock);
  }
}

function step(own s: App, e: android.Event): App {
  let t: App = event(s, e);
  return draw(pump(t, now_ms()));
}

function event(own s: App, e: android.Event): App {
  match (e) {
    android.WindowCreated(w) => {
      return App { ...s, window: w.ptr, drawn: "" };
    },
    android.WindowResized(w) => {
      return App { ...s, window: w.ptr, drawn: "" };
    },
    android.WindowRedraw(w) => {
      return App { ...s, window: w.ptr, drawn: "" };
    },
    android.WindowDestroyed(_) => {
      return App { ...s, window: 0 as usize };
    },
    android.Touch(action, x, y) => {
      return touch(s, action, x, y);
    },
    android.Key(code, action) => {
      return key(s, code, action);
    },
    _ => {
      return lifecycle_event(s, e);
    }
  }
}

// The activity and the foreground service.
function lifecycle_event(own s: App, e: android.Event): App {
  match (e) {
    android.Resume => {
      return resumed(s);
    },
    android.Destroy => {
      return destroyed(s);
    },
    _ => {
      return service_event(s, e);
    }
  }
}

// The actions of the notification of the foreground service.
function service_event(own s: App, e: android.Event): App {
  let Some(ev) = service.event(e) else {
    return direct_event(s, e);
  };
  match (ev) {
    service.Action => {
      return toggle_talk(s);
    },
    service.Stopped => {
      return leave(App { ...s, serving: false });
    }
  }
}

// The Wi-Fi Direct events.
function direct_event(own s: App, e: android.Event): App {
  let Some(ev) = p2p.event(e) else {
    return focus_event(s, e);
  };
  match (ev) {
    p2p.Enabled(on) => {
      log.info("walkie: Wi-Fi Direct " + on.to_string());
      return discover(s);
    },
    p2p.Peers(list) => {
      return App { ...s, peers: list, drawn: "" };
    },
    p2p.Group(g) => {
      return grouped(s, g);
    }
  }
}

function discover(own s: App): App {
  if let Some(p) = s.p2p {
    let started: boolean = p2p.discover(s.ctx, p);
    log.info("walkie: looking for Wi-Fi Direct peers " + started.to_string());
  }
  return s;
}

// The broadcast address of the group's subnet, a.b.c.255 for the owner
// a.b.c.d. The beacons go there as well, so that the two phones find each
// other on the group.
function subnet_broadcast(owner: string): Option[net.IpAddr] {
  match (net.ip_parse(owner)) {
    Ok(net.V4(b)) => {
      if (b.len() == 4) {
        return Some(net.V4([b[0], b[1], b[2], 255u8]));
      }
      return None;
    },
    _ => {
      return None;
    }
  }
}

function grouped(own s: App, g: p2p.Group): App {
  let t: App = App { ...s, listener: control.close_listener(s.listener), stream: control.close_option(s.stream), owner_ip: None };
  if (!g.formed) {
    log.info("walkie: no Wi-Fi Direct group");
    return App { ...t, group_broadcast: None, group_role: lan.ROLE_ANY, node: node.with_role(t.node, lan.ROLE_ANY, node_id()), drawn: "" };
  }
  log.info("walkie: Wi-Fi Direct group, owner " + g.owner_address + ", this phone owns it " + g.owner.to_string());
  let n: node.Node = node.noticed(t.node, "");
  if (g.owner) {
    return App { ...t, group_broadcast: subnet_broadcast(g.owner_address), group_role: lan.ROLE_LEAD, node: node.with_role(n, lan.ROLE_LEAD, node_id()), listener: control.listen(lan.PORT), drawn: "" };
  }
  let owner: Option[net.IpAddr] = net.ip_parse(g.owner_address).ok();
  return App { ...t, group_broadcast: subnet_broadcast(g.owner_address), group_role: lan.ROLE_FOLLOW, node: node.with_role(n, lan.ROLE_FOLLOW, node_id()), owner_ip: owner, dial_at: 0i64, drawn: "" };
}

function nearby_permission(ctx: usize): string {
  if (android.sdk_version(ctx) >= 33) {
    return NEARBY;
  }
  return LOCATION;
}

// Starts Wi-Fi Direct once the app may look for nearby devices, when the
// mode uses it.
function start_direct(own s: App): App {
  if (!modes.uses_direct(s.mode) || s.p2p.is_some() || !android.has_permission(s.ctx, nearby_permission(s.ctx))) {
    return s;
  }
  match (p2p.start(s.ctx, RECEIVER)) {
    Some(p) => {
      return discover(App { ...s, p2p: Some(p) });
    },
    None => {
      log.info("walkie: this phone has no Wi-Fi Direct");
      return s;
    }
  }
}

// The peer whose row is at (x, y), or -1.
function peer_at(s: App, w: i32, h: i32, x: f32, y: f32): i32 {
  for k in 0..s.peers.len() {
    if (k < screen.PEER_ROWS && screen.contains(screen.peer_row(w, h, k), x, y)) {
      return k;
    }
  }
  return -1;
}

// Invites peer `k`. Android asks the other user to accept.
function invite(own s: App, k: i32): App {
  let Some(p) = s.p2p else {
    return s;
  };
  let peer: p2p.Peer = s.peers[k];
  let sent: boolean = p2p.connect(s.ctx, p, peer.address);
  log.info("walkie: invited " + peer.name + " " + sent.to_string());
  return App { ...s, node: node.noticed(s.node, "invited " + peer.name + ": accept on the other phone"), drawn: "" };
}

// Asks for the microphone once the activity is in front. With the
// microphone, it starts the foreground service, and keeps the CPU and the
// Wi-Fi awake while the screen is off.
function resumed(own s: App): App {
  let mic: boolean = android.has_permission(s.ctx, MIC);
  let nearby: string = nearby_permission(s.ctx);
  if (!s.asked && (!mic || !android.has_permission(s.ctx, nearby))) {
    android.request_permissions(s.ctx, [MIC, nearby]);
  }
  let serving: boolean = s.serving;
  let awake: Option[service.Awake] = s.awake;
  if (mic && !serving) {
    serving = service.start(s.ctx, SERVICE);
    log.info("walkie: foreground service " + serving.to_string());
  }
  if (serving && awake.is_none()) {
    awake = Some(service.stay_awake(s.ctx, "fern:walkie"));
    log.info("walkie: awake with the screen off");
  }
  return start_direct(App { ...s, asked: true, serving: serving, awake: awake, drawn: "" });
}

// The keys type the name of the server while its keyboard shows. The back
// key closes the settings screen, and otherwise moves the app to the
// background, where it still hears the other phone. DISCONNECT in the
// notification leaves the session.
function key(own s: App, code: i32, action: i32): App {
  if let Some(name) = s.host_edit {
    return host_key(s, code, action, name);
  }
  if (code == 4 && action == 1 && s.menu) {
    return App { ...s, menu: false, drawn: "" };
  }
  if (code == 4 && action == 1) {
    android.to_background(s.ctx);
    log.info("walkie: to the background");
  }
  return s;
}

// The activity is not valid after Destroy, so the service stops first.
function destroyed(own s: App): App {
  if (s.serving) {
    service.stop(s.ctx, SERVICE);
  }
  if let Some(p) = s.p2p {
    p2p.stop(s.ctx, p);
  }
  if let Some(a) = s.awake {
    service.release_awake(s.ctx, a);
  }
  if let Some(f) = s.audio_focus {
    focus.close(s.ctx, f);
  }
  return App { ...s, serving: false, p2p: None, awake: None, audio_focus: None, listener: control.close_listener(s.listener), stream: control.close_option(s.stream), owner_ip: None };
}

// A call or another app took the audio focus: the transmission stops. A
// short sound of another app does not stop it.
function focus_event(own s: App, e: android.Event): App {
  let Some(change) = focus.event(e) else {
    return s;
  };
  log.info("walkie: audio focus " + focus_name(change));
  if let focus.Loss = change {
    if (s.capturing) {
      return App { ...s, node: node.mic_lost(s.node, "a call or another app took the audio", now_ms()) };
    }
  }
  return s;
}

function focus_name(c: focus.Change): string {
  match (c) {
    focus.Gain => {
      return "gained";
    },
    focus.Loss => {
      return "lost";
    },
    focus.Duck => {
      return "ducked";
    }
  }
  return "";
}

// Leaves the session and closes the app.
function leave(own s: App): App {
  let n: node.Node = node.leave(s.node, now_ms());
  android.finish(s.ctx);
  return App { ...s, node: n };
}

function size(s: App): (i32, i32) {
  if (s.window == 0 as usize) {
    return (0, 0);
  }
  let w: android.Window = android.Window { ptr: s.window };
  return (w.width(), w.height());
}

function touch(own s: App, action: i32, x: f32, y: f32): App {
  let (w, h) = size(s);
  if (w == 0) {
    return s;
  }
  let down: boolean = action == 0;
  if (overlay(s)) {
    return overlay_touch(s, w, h, x, y, down);
  }
  if (down && mode_button_shows(s) && screen.contains(screen.mode_button(w, h), x, y)) {
    return App { ...s, menu: true, drawn: "" };
  }
  match (s.node.link.phase) {
    lan.Verifying => {
      return verify_touch(s, w, h, x, y, down);
    },
    lan.Searching => {
      let k: i32 = peer_at(s, w, h, x, y);
      if (down && k >= 0) {
        return invite(s, k);
      }
      return search_touch(s, w, h, action, x, y);
    },
    _ => {}
  }
  return talk_touch(s, w, h, action, x, y);
}

// True while the keyboard of the server, the settings screen or the keypad
// shows.
function overlay(s: App): boolean {
  return s.host_edit.is_some() || s.menu || s.entering.is_some();
}

// A touch on the keyboard of the server, the settings screen or the keypad.
function overlay_touch(own s: App, w: i32, h: i32, x: f32, y: f32, down: boolean): App {
  if let Some(name) = s.host_edit {
    return host_touch(s, w, h, x, y, down, name);
  }
  if let Some(code) = s.entering {
    if (!s.menu) {
      return keypad_touch(s, w, h, x, y, down, code);
    }
  }
  return menu_touch(s, w, h, x, y, down);
}

// The room buttons show while the phone searches, with no room yet, when the
// mode uses rooms.
function room_buttons(s: App): boolean {
  return modes.uses_rooms(s.mode, server_of(s)) && s.room.is_none() && s.asking.is_none() && s.entering.is_none();
}

// The settings button shows while the phone searches, before a room.
function mode_button_shows(s: App): boolean {
  if let lan.Searching = s.node.link.phase {
    return s.room.is_none() && s.entering.is_none();
  }
  return false;
}

// A row of the settings screen chooses its mode, the card of the server opens
// its keyboard, FORGET forgets the known phones, and BACK closes the screen.
function menu_touch(own s: App, w: i32, h: i32, x: f32, y: f32, down: boolean): App {
  if (!down) {
    return s;
  }
  if (screen.contains(screen.back_button(w, h), x, y)) {
    return App { ...s, menu: false, drawn: "" };
  }
  if (screen.contains(screen.forget_button(w, h), x, y)) {
    log.info("walkie: forget the known phones");
    return App { ...s, node: node.noticed(node.forget(s.node), "this phone knows no other phone now"), drawn: "" };
  }
  if (screen.contains(screen.server_row(w, h), x, y)) {
    return App { ...s, host_edit: Some(s.server), drawn: "" };
  }
  let k: i32 = screen.mode_at(w, h, x, y);
  if (k < 0 || !modes.available(modes.at(k), server_of(s))) {
    return s;
  }
  return choose(s, modes.at(k));
}

// A key of the keyboard of the server, CANCEL, SAVE, or the button that opens
// the keyboard of the phone. An empty name uses
// the server of the build again. A mode that the new server cannot give
// changes to AUTOMATIC.
function host_touch(own s: App, w: i32, h: i32, x: f32, y: f32, down: boolean, name: string): App {
  if (!down) {
    return s;
  }
  if (screen.contains(screen.room_button(w, h), x, y)) {
    return close_host(s);
  }
  if (screen.contains(screen.join_button(w, h), x, y)) {
    return save_host(s, name);
  }
  if (screen.contains(screen.phone_keys_button(w, h), x, y)) {
    android.show_keyboard(s.ctx, true);
    return s;
  }
  let k: i32 = screen.host_key_at(w, h, x, y);
  if (k < 0) {
    return s;
  }
  return App { ...s, host_edit: Some(screen.host_typed(name, k)), drawn: "" };
}

// A key of the keyboard of the phone: a letter, a digit, "." or "-" types,
// DEL deletes, ENTER saves, and BACK cancels.
function host_key(own s: App, code: i32, action: i32, name: string): App {
  // KEYCODE_BACK when it comes up, and KEYCODE_ENTER when it goes down
  if (code == 4 && action == 1) {
    return close_host(s);
  }
  if (action != 0) {
    return s;
  }
  if (code == 66) {
    return save_host(s, name);
  }
  let k: i32 = screen.host_key_of_code(code);
  if (k < 0) {
    return s;
  }
  return App { ...s, host_edit: Some(screen.host_typed(name, k)), drawn: "" };
}

// Closes the keyboard of the server, and the keyboard of the phone.
function close_host(own s: App): App {
  android.show_keyboard(s.ctx, false);
  return App { ...s, host_edit: None, drawn: "" };
}

function save_host(own s: App, name: string): App {
  if (!modes.valid_host(name)) {
    return App { ...s, node: node.noticed(s.node, "that is not a host name"), drawn: "" };
  }
  save_server(s.dir, name);
  android.show_keyboard(s.ctx, false);
  log.info("walkie: server " + name);
  let quiet: node.Node = node.noticed(s.node, "");
  let t: App = App { ...s, server: name, host_edit: None, node: quiet, drawn: "" };
  if (modes.available(t.mode, server_of(t))) {
    return t;
  }
  return choose(t, modes.Automatic);
}

// Starts the search again in mode `m`. Wi-Fi Direct stops when `m` does not
// use it, and starts when it does.
function choose(own s: App, m: modes.Mode): App {
  save_mode(s.dir, m);
  log.info("walkie: mode " + modes.name(m));
  return start_direct(restart(drop_direct(App { ...s, mode: m, menu: false })));
}

// Stops Wi-Fi Direct when the mode does not use it.
function drop_direct(own s: App): App {
  if (modes.uses_direct(s.mode)) {
    return s;
  }
  if let Some(p) = s.p2p {
    p2p.stop(s.ctx, p);
  }
  return App { ...s, p2p: None, peers: [], group_broadcast: None, group_role: lan.ROLE_ANY, listener: control.close_listener(s.listener), stream: control.close_option(s.stream), owner_ip: None };
}

function search_touch(own s: App, w: i32, h: i32, action: i32, x: f32, y: f32): App {
  if (action != 0 || !room_buttons(s)) {
    return talk_touch(s, w, h, action, x, y);
  }
  if (screen.contains(screen.room_button(w, h), x, y)) {
    return enter_room(s, "CREATE", "");
  }
  if (screen.contains(screen.join_button(w, h), x, y)) {
    return App { ...s, entering: Some(""), drawn: "" };
  }
  return talk_touch(s, w, h, action, x, y);
}

// A key of the keypad, CANCEL, or JOIN when the code is whole.
function keypad_touch(own s: App, w: i32, h: i32, x: f32, y: f32, down: boolean, code: string): App {
  if (!down) {
    return s;
  }
  if (screen.contains(screen.room_button(w, h), x, y)) {
    return App { ...s, entering: None, drawn: "" };
  }
  if (screen.contains(screen.join_button(w, h), x, y) && code.len() == rooms.CODE_LEN) {
    return enter_room(App { ...s, entering: None }, "JOIN " + code, code);
  }
  let k: i32 = screen.key_at(w, h, x, y);
  if (k < 0) {
    return s;
  }
  return App { ...s, entering: Some(screen.typed(code, k)), drawn: "" };
}

// Asks the server for a room with `line`. The pump steps the request, and
// keeps the room that it gives.
function enter_room(own s: App, line: string, code: string): App {
  let host: string = server_of(s);
  let Some(roots) = verify.system_roots() else {
    return App { ...s, node: node.noticed(s.node, "no room: this phone has no trusted certificates"), drawn: "" };
  };
  let q: internet.Request = internet.request(host, rooms.PORT, line, code, roots, now_ms());
  return App { ...s, asking: Some(q), node: node.noticed(s.node, "asking the server " + host), drawn: "" };
}

// One step of the request for a room, which waits for nothing.
function ask(s: App, now: i64): App {
  let Some(q) = s.asking else {
    return s;
  };
  return asked(App { ...s, asking: None }, internet.step(q, now));
}

// The app after a step of its request: the request again, or the room.
function asked(t: App, p: internet.Progress): App {
  match (p) {
    internet.Pending(next) => {
      return App { ...t, asking: Some(next) };
    },
    internet.Done(reply, room) => {
      if let Some(r) = room {
        log.info("walkie: in a room on " + r.relay.to_string());
        let n: node.Node = node.in_room(node.noticed(t.node, "room " + r.code + ": the other phone joins with this code"), r.lead, node_id(), now_ms());
        return App { ...t, room: Some(r), node: n, drawn: "" };
      }
      let why = "the server refused";
      if let rooms.Refused(text) = reply {
        why = text;
      }
      return App { ...t, node: node.noticed(t.node, "no room: " + why), drawn: "" };
    }
  }
}

// SAME or DIFFERENT, while the users compare the strings.
function verify_touch(own s: App, w: i32, h: i32, x: f32, y: f32, down: boolean): App {
  let now: i64 = now_ms();
  if (down && screen.contains(screen.same_button(w, h), x, y)) {
    return App { ...s, node: node.confirm(s.node, now) };
  }
  if (down && screen.contains(screen.differ_button(w, h), x, y)) {
    return App { ...s, node: node.reject(s.node, now) };
  }
  return s;
}

// The talk button: hold to talk, tap to search again after the end, or tap
// to leave a room while the phone waits in it.
function talk_touch(own s: App, w: i32, h: i32, action: i32, x: f32, y: f32): App {
  let now: i64 = now_ms();
  let down: boolean = action == 0;
  if (down && screen.in_circle(screen.talk_button(w, h), x, y)) {
    if (node.ended(s.node) || waiting_in_room(s)) {
      return restart(s);
    }
    return App { ...s, pressed: true, toggled: false, node: node.press(s.node, now) };
  }
  if ((action == 1 || action == 3) && s.pressed) {
    return App { ...s, pressed: false, toggled: false, node: node.release(s.node, now) };
  }
  return s;
}

// A talk from the notification stops by itself after this time, so a tap
// that the user forgets does not send the sound of the room for long.
const NOTICE_TALK_MS: i64 = 60000i64;

// The TALK action of the notification: talk, or stop talking.
function toggle_talk(own s: App): App {
  let now: i64 = now_ms();
  log.info("walkie: talk from the notification " + (!s.pressed).to_string());
  if (s.pressed) {
    return App { ...s, pressed: false, toggled: false, node: node.release(s.node, now) };
  }
  return App { ...s, pressed: true, toggled: true, node: node.press_for(s.node, now, NOTICE_TALK_MS) };
}

// Shows the talk state in the notification when it changed.
function sync_notice(s: App): App {
  if (!s.serving || s.pressed == s.noticed) {
    return s;
  }
  service.update(s.ctx, SERVICE, notice(s.pressed));
  return App { ...s, noticed: s.pressed };
}

function waiting_in_room(s: App): boolean {
  if let lan.Searching = s.node.link.phase {
    return s.room.is_some();
  }
  return false;
}

// The words of the talk button.
function talk_label(s: App, now: i64): string {
  if (waiting_in_room(s)) {
    return "TAP TO LEAVE ROOM";
  }
  return node.button(s.node, now);
}

function restart(own s: App): App {
  node.close(s.node);
  return App { ...s, node: fresh_node("", s.id_seed, s.pins, s.group_role), pressed: false, drawn: "", room: None, entering: None };
}

// The network, the timers and the microphone, after each event.
function pump(own s: App, now: i64): App {
  let t: App = ask(streamed(receive_all(s, now), now), now);
  t = App { ...t, node: node.tick(node.fresh(t.node, rand.bytes(node.RANDOM_BYTES)), now) };
  if (t.toggled && t.node.talk_until == 0i64) {
    t = App { ...t, pressed: false, toggled: false };
  }
  t = speak(sync_mic(t, now));
  return sync_notice(save_pins(rejoin(flush(route(t)), now)));
}

// The control stream of a Wi-Fi Direct group: the owner accepts the client,
// and the client dials the owner again each second while it has no stream.
// The frames of the stream go to the node. When the stream closes, the node
// loses its peer at once.
function streamed(own s: App, now: i64): App {
  let t: App = dialled(accepted(s), now);
  t = App { ...t, stream: control.step_option(t.stream) };
  let Some(st) = t.stream else {
    return t;
  };
  let n: node.Node = t.node;
  let from: net.SocketAddr = net.socket_addr(st.peer, lan.PORT);
  for f in st.frames {
    n = node.receive(n, f, f.len(), from, now);
  }
  if (!st.lost) {
    return App { ...t, node: n };
  }
  log.info("walkie: the control stream to " + st.peer.to_string() + " closed");
  if (n.peer_addr.ip.eq(st.peer)) {
    n = node.transport_lost(n, now);
  }
  return App { ...t, node: n, stream: control.close_option(t.stream), dial_at: now + 1000i64 };
}

function accepted(own s: App): App {
  let Some(l) = s.listener else {
    return s;
  };
  let Some(st) = control.accept(l) else {
    return s;
  };
  log.info("walkie: control stream from " + st.peer.to_string());
  let old: Option[control.Stream] = control.close_option(s.stream);
  return App { ...s, stream: Some(st) };
}

function dialled(own s: App, now: i64): App {
  let Some(ip) = s.owner_ip else {
    return s;
  };
  if (s.stream.is_some() || now < s.dial_at) {
    return s;
  }
  return App { ...s, stream: control.dial(ip, lan.PORT), dial_at: now + 1000i64 };
}

// The key exchange, the control frames and the proofs go over the control
// stream once it is up. The beacons and the voice stay on UDP.
function route(own s: App): App {
  let Some(st) = s.stream else {
    return s;
  };
  if (!st.connected || s.room.is_some()) {
    return s;
  }
  let keep: node.Datagram[] = [];
  let sent: u8[][] = [];
  for d in s.node.out {
    if (!d.broadcast && control.carries(d.data)) {
      sent = sent.append(d.data);
    } else {
      keep = keep.append(d);
    }
  }
  return App { ...s, node: node.Node { ...s.node, out: keep }, stream: control.send_all(s.stream, sent) };
}

// In a room, a lost transport starts a new key exchange through the relay,
// as when the network of a phone changes. Leaving the room needs a tap.
function rejoin(own s: App, now: i64): App {
  let Some(r) = s.room else {
    return s;
  };
  if (!node.reconnecting(s.node)) {
    return s;
  }
  log.info("walkie: reconnecting in the room");
  let n: node.Node = node.resume(s.node, node_id(), rand.bytes(node.SEED_BYTES), now);
  return App { ...s, node: node.in_room(n, r.lead, node_id(), now), pressed: false, drawn: "" };
}

function receive_all(own s: App, now: i64): App {
  let Some(sock) = s.sock else {
    return s;
  };
  let n: node.Node = s.node;
  let buf: u8[] = [];
  for k in 0..2048 {
    buf = buf.append(0u8);
  }
  for k in 0..64 {
    match (net.recv_from(sock, buf)) {
      Ok((len, from)) => {
        if (!modes.accepts(s.mode, s.room, s.group_broadcast, from)) {
          continue;
        }
        if let Some(r) = s.room {
          if let Some(answer) = internet.challenged(r, buf, len) {
            let sent: Result[i32, net.NetError] = net.send_to(sock, answer, r.relay);
            continue;
          }
        }
        n = node.receive(n, buf, len, from, now);
      },
      Err(_) => {
        return App { ...s, node: n };
      }
    }
  }
  return App { ...s, node: n };
}

// Starts or stops the microphone as the node asks.
function sync_mic(own s: App, now: i64): App {
  if (s.node.capture == s.capturing) {
    return s;
  }
  if (!s.node.capture) {
    s.mic.stop();
    release_focus(s);
    return App { ...s, capturing: false };
  }
  if (!android.has_permission(s.ctx, MIC)) {
    android.request_permissions(s.ctx, [MIC]);
    return App { ...s, node: node.mic_lost(s.node, "allow the microphone, then press again", now) };
  }
  if let Some(f) = s.audio_focus {
    if (!focus.request(s.ctx, f)) {
      return App { ...s, node: node.mic_lost(s.node, "a call or another app has the audio", now) };
    }
  }
  let mic: audio.Stream = s.mic;
  if (mic.ptr == 0 as usize) {
    mic = audio.capture(voice.RATE);
  }
  if (!mic.start()) {
    release_focus(s);
    return App { ...s, mic: mic, node: node.mic_lost(s.node, "the microphone did not start", now) };
  }
  log.info("walkie: microphone rate " + mic.rate.to_string());
  return App { ...s, mic: mic, capturing: true, up: pcm.resampler(mic.rate, voice.RATE) };
}

function release_focus(s: App): void {
  if let Some(f) = s.audio_focus {
    focus.release(s.ctx, f);
  }
}

// The microphone samples since the last step.
function speak(own s: App): App {
  if (!s.capturing) {
    return s;
  }
  let (up, wire) = pcm.resample(s.up, s.mic.read(s.mic.rate / 10, 0));
  let (agc, loud) = pcm.amplify(s.agc, wire);
  return App { ...s, up: up, agc: agc, node: node.voice(s.node, loud) };
}

// The datagrams of the node: in a room each one goes to the relay, and
// otherwise the beacons go to the broadcast addresses of the mode.
function send_out(sock: Socket, n: node.Node, room: Option[internet.Room], targets: [net.IpAddr]): void {
  for d in n.out {
    if let Some(r) = room {
      let relayed: Result[i32, net.NetError] = net.send_to(sock, internet.wrap(r, d.data), r.relay);
    } else if (d.broadcast) {
      beacon(sock, d.data, targets);
    } else {
      let sent: Result[i32, net.NetError] = net.send_to(sock, d.data, n.peer_addr);
    }
  }
}

// Sends the datagrams of the node, plays its frames and writes its log lines.
function flush(own s: App): App {
  let n: node.Node = s.node;
  if let Some(sock) = s.sock {
    send_out(sock, n, s.room, modes.beacon_targets(s.mode, s.group_broadcast));
  }
  let down: pcm.Resampler = s.down;
  let queue: i32[] = s.queue;
  for f in n.heard {
    let (d2, samples) = pcm.resample(down, f);
    for v in samples {
      queue = queue.append(v);
    }
    down = d2;
  }
  if (queue.len() > 0) {
    queue = pcm.unplayed(queue, s.spk.write(queue, 0), s.spk.rate * 3 / 10);
  }
  for l in n.logs {
    log.info("walkie: " + l);
  }
  return App { ...s, down: down, queue: queue, node: node.drained(n) };
}

// A beacon goes to each address on each walkie port.
function beacon(sock: Socket, data: u8[], to: [net.IpAddr]): void {
  for ip in to {
    for port in [lan.PORT, lan.SECOND_PORT] {
      let sent: Result[i32, net.NetError] = net.send_to(sock, data, net.socket_addr(ip, port));
    }
  }
}

// The peers as they show, so that a change draws the screen again.
function peer_key(s: App): string {
  let out = "";
  for p in s.peers {
    out = out + p.name + p.status.to_string() + ";";
  }
  return out;
}

// The screen as `ui` draws it.
function view(s: App, label: string): ui.View {
  let n: node.Node = s.node;
  let code = "";
  let searching = false;
  match (n.link.phase) {
    lan.Verifying => {
      code = n.link.sas;
    },
    lan.Searching => {
      searching = true;
    },
    _ => {}
  }
  let peers: ui.Peer[] = [];
  for p in s.peers {
    peers = peers.append(ui.Peer { name: p.name, invited: p.status == 1 });
  }
  return ui.View { title: title(s), status: status_text(s), notice: n.notice, label: label, code: code, searching: searching, peers: peers, room_buttons: room_buttons(s), typing: s.entering, mode_label: mode_label(s), menu: menu_of(s), available: available_modes(s), server: server_label(s), editing: s.host_edit, known: s.node.pins.len() > 0 };
}

function mode_label(s: App): string {
  if (mode_button_shows(s)) {
    return "MODE: " + modes.short_name(s.mode);
  }
  return "";
}

function menu_of(s: App): Option[i32] {
  if (s.menu) {
    return Some(modes.index(s.mode));
  }
  return None;
}

function available_modes(s: App): boolean[] {
  let out: boolean[] = [];
  for m in modes.all() {
    out = out.append(modes.available(m, server_of(s)));
  }
  return out;
}

// The server on its card of the settings screen.
function server_label(s: App): string {
  if (s.server.len() > 0) {
    return s.server;
  }
  if (server_host.SERVER_HOST.len() > 0) {
    return server_host.SERVER_HOST + " (built in)";
  }
  return "none: tap to type one";
}

// In a room, the phone waits for the other phone there, not on this Wi-Fi.
// A mode with one way says what the user does for it.
function status_text(s: App): string {
  if (s.host_edit.is_some()) {
    return "type the host name of the room server, or clear it to use the server of the app";
  }
  if (s.menu) {
    return "this is " + node.label(node.identity_key(s.node)) + ": how does it find the other phone?";
  }
  if let lan.Searching = s.node.link.phase {
    return searching_text(s);
  }
  return node.status(s.node);
}

function searching_text(s: App): string {
  if (s.room.is_some()) {
    return "waiting for the other phone to join";
  }
  match (s.mode) {
    modes.InternetRoom => {
      return "make a room, or join the room of the other phone";
    },
    modes.WifiDirect => {
      if (s.group_broadcast.is_some()) {
        return "looking for the other phone in the group";
      }
      return "tap the other phone to invite it";
    },
    _ => {
      return node.status(s.node);
    }
  }
}

function draw(s: App): App {
  let n: node.Node = s.node;
  let label: string = talk_label(s, now_ms());
  let key: string = status_text(s) + "|" + n.notice + "|" + label + "|" + n.link.sas + "|" + peer_key(s) + "|" + room_key(s) + "|" + mode_label(s) + s.menu.to_string() + "|" + server_label(s) + "|" + s.host_edit.unwrap_or("^");
  if (s.window == 0 as usize || key == s.drawn) {
    return s;
  }
  let w: android.Window = android.Window { ptr: s.window };
  let f: android.Frame = w.lock();
  if (f.width == 0) {
    return s;
  }
  ui.render(f, view(s, label));
  android.post(f);
  return App { ...s, drawn: key };
}

function title(s: App): string {
  if (s.host_edit.is_some()) {
    return "SERVER";
  }
  if (s.menu) {
    return "SETTINGS";
  }
  if let Some(r) = s.room {
    return "WALKIE  " + r.code;
  }
  return "WALKIE";
}

// The room and the typed code as they show, so that a change draws again.
function room_key(s: App): string {
  let out = "";
  if let Some(r) = s.room {
    out = r.code;
  }
  if let Some(code) = s.entering {
    out = out + "/" + code;
  }
  return out;
}
