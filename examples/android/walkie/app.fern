// The walkie-talkie app, LAN build. Two phones on the same Wi-Fi network find
// each other by UDP broadcast, run the key exchange, and the users compare
// the six-digit string. Then one holds the button to talk, and the other
// hears. The voice is raw 16-bit audio at 16 kHz until the Opus encoder is
// ready.
import "std/android";
import "std/android/audio";
import "std/android/draw";
import "std/log";
import "std/net";
import "std/rand";
import "./lan";
import "./pcm";
import "./protocol";
import "./screen";
import "./secure";
import "./session";

const MIC: string = "android.permission.RECORD_AUDIO";

struct App {
  ctx: usize,
  window: usize,
  sock: i32,
  link: lan.Link,
  peer_addr: net.SocketAddr,
  chan: Option[secure.Channel],
  sess: session.Session,
  mic: audio.Stream,
  spk: audio.Stream,
  capturing: boolean,
  up: pcm.Resampler,
  down: pcm.Resampler,
  pending: i32[],
  notice: string,
  pressed: boolean,
  heard_at: i64,
  drawn: string,
  asked: boolean,
}

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function now_ms(): i64 {
  return monotonic_ns() / 1000000i64;
}

function node_id(): i64 {
  let b: u8[] = rand.bytes(8);
  let id: i64 = 0i64;
  for x in b {
    id = id << 8i64 | x as i64;
  }
  if (id < 0i64) {
    id = -(id + 1i64);
  }
  return id;
}

function any_addr(port: i32): net.SocketAddr {
  return net.socket_addr(net.V4([0u8, 0u8, 0u8, 0u8]), port);
}

function open_socket(): i32 {
  match (net.udp_socket(any_addr(lan.PORT))) {
    Ok(s) => {
      let nb: Result[void, net.NetError] = net.set_nonblocking(s, true);
      let bc: Result[void, net.NetError] = net.set_broadcast(s, true);
      return s;
    },
    Err(_) => {
      return -1;
    }
  }
  return -1;
}

function fresh(ctx: usize, sock: i32, spk: audio.Stream, notice: string): App {
  let s0: session.Session = session.with_codec(session.new(), protocol.CODEC_PCM16);
  let (s1, _) = session.step(s0, session.Start(session.Offline), now_ms());
  let down: pcm.Resampler = pcm.resampler(pcm.WIRE_RATE, spk.rate);
  return App { ctx: ctx, window: 0 as usize, sock: sock, link: lan.new(node_id()), peer_addr: any_addr(0), chan: None, sess: s1, mic: audio.Stream { ptr: 0 as usize, rate: 0 }, spk: spk, capturing: false, up: pcm.resampler(pcm.WIRE_RATE, pcm.WIRE_RATE), down: down, pending: [], notice: notice, pressed: false, heard_at: 0i64, drawn: "", asked: false };
}

function app_main(ctx: usize): usize {
  let spk: audio.Stream = audio.playback(pcm.WIRE_RATE);
  let started: boolean = spk.start();
  let sock: i32 = open_socket();
  let notice: string = "";
  if (sock < 0) {
    notice = "no network: port " + lan.PORT.to_string() + " is busy";
  }
  android.keep_screen_on(ctx, true);
  let first: App = fresh(ctx, sock, spk, notice);
  log.warn("walkie: node " + first.link.me.to_string() + ", port " + lan.PORT.to_string() + ", socket " + sock.to_string() + ", speaker rate " + spk.rate.to_string());
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => 10);
  shut(last);
  return 0 as usize;
}

function shut(own s: App): void {
  s.mic.stop();
  s.mic.close();
  s.spk.stop();
  s.spk.close();
  match (s.chan) {
    Some(c) => {
      secure.close(c);
    },
    None => {}
  }
  if (s.sock >= 0) {
    let closed: Result[void, net.NetError] = net.close(s.sock);
  }
}

function step(own s: App, e: android.Event): App {
  let t: App = event(s, e);
  return draw(pump(t, now_ms()));
}

function event(own s: App, e: android.Event): App {
  match (e) {
    android.WindowCreated(w) => {
      return App { ...s, window: w.ptr, drawn: "" };
    },
    android.WindowResized(w) => {
      return App { ...s, window: w.ptr, drawn: "" };
    },
    android.WindowRedraw(w) => {
      return App { ...s, window: w.ptr, drawn: "" };
    },
    android.WindowDestroyed(_) => {
      return App { ...s, window: 0 as usize };
    },
    android.Resume => {
      // Ask for the microphone once the activity is in front.
      if (!s.asked && !android.has_permission(s.ctx, MIC)) {
        android.request_permissions(s.ctx, [MIC]);
      }
      return App { ...s, asked: true, drawn: "" };
    },
    android.Touch(action, x, y) => {
      return touch(s, action, x, y);
    },
    android.Key(code, action) => {
      if (code == 4 && action == 1) {
        let (t, _) = session.step(s.sess, session.Leave, now_ms());
        android.finish(s.ctx);
        return App { ...s, sess: t };
      }
      return s;
    },
    _ => {
      return s;
    }
  }
}

function size(s: App): (i32, i32) {
  if (s.window == 0 as usize) {
    return (0, 0);
  }
  let w: android.Window = android.Window { ptr: s.window };
  return (w.width(), w.height());
}

function touch(own s: App, action: i32, x: f32, y: f32): App {
  let (w, h) = size(s);
  if (w == 0) {
    return s;
  }
  match (s.link.phase) {
    lan.Verifying => {
      if (action == 0 && screen.contains(screen.same_button(w, h), x, y)) {
        return confirm(s);
      }
      if (action == 0 && screen.contains(screen.differ_button(w, h), x, y)) {
        return reject(s);
      }
      return s;
    },
    lan.Closed => {
      if (action == 0 && screen.contains(screen.talk_button(w, h), x, y)) {
        return restart(s);
      }
      return s;
    },
    _ => {}
  }
  if (ended(s.sess.state)) {
    if (action == 0 && screen.contains(screen.talk_button(w, h), x, y)) {
      return restart(s);
    }
    return s;
  }
  if (action == 0 && screen.contains(screen.talk_button(w, h), x, y)) {
    return act(App { ...s, pressed: true }, session.PttDown);
  }
  if ((action == 1 || action == 3) && s.pressed) {
    return act(App { ...s, pressed: false }, session.PttUp);
  }
  return s;
}

// The session ended, or lost its peer: a tap searches again.
function ended(st: session.State): boolean {
  match (st) {
    session.Failed => {
      return true;
    },
    session.Reconnecting => {
      return true;
    },
    session.Idle => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function restart(own s: App): App {
  match (s.chan) {
    Some(c) => {
      secure.close(c);
    },
    None => {}
  }
  let closed: lan.Link = lan.close(s.link);
  let t: App = fresh(s.ctx, s.sock, s.spk, "");
  return App { ...t, window: s.window, mic: s.mic, asked: s.asked };
}

function confirm(s: App): App {
  let (l, chan) = lan.confirm(s.link);
  log.info("walkie: the string is confirmed");
  return act(App { ...s, link: l, chan: chan }, session.Authenticated);
}

function reject(own s: App): App {
  log.info("walkie: the string is rejected");
  let t: App = App { ...s, link: lan.close(s.link) };
  return act(t, session.AuthFailed);
}

// One session event and its actions.
function act(s: App, e: session.Event): App {
  let (t, acts) = session.step(s.sess, e, now_ms());
  let a: App = App { ...s, sess: t };
  for x in acts {
    a = action(a, x);
  }
  return a;
}

function action(s: App, a: session.Action): App {
  match (a) {
    session.Send(m) => {
      return send_frame(s, lan.CONTROL, protocol.encode(m));
    },
    session.Capture(on) => {
      return capture(s, on);
    },
    session.Notice(text) => {
      log.info("walkie: " + text);
      return App { ...s, notice: text };
    }
  }
  return s;
}

function capture(s: App, on: boolean): App {
  if (!on) {
    s.mic.stop();
    return App { ...s, capturing: false, pending: [] };
  }
  if (!android.has_permission(s.ctx, MIC)) {
    android.request_permissions(s.ctx, [MIC]);
    let (t, acts) = session.step(s.sess, session.MicLost, now_ms());
    return App { ...s, sess: t, notice: "allow the microphone, then press again" };
  }
  let mic: audio.Stream = s.mic;
  if (mic.ptr == 0 as usize) {
    mic = audio.capture(pcm.WIRE_RATE);
  }
  if (!mic.start()) {
    let (t, acts) = session.step(s.sess, session.MicLost, now_ms());
    return App { ...s, sess: t, mic: mic, notice: "the microphone did not start" };
  }
  return App { ...s, mic: mic, capturing: true, pending: [], up: pcm.resampler(mic.rate, pcm.WIRE_RATE) };
}

function send(s: App, data: u8[]): void {
  if (s.sock >= 0) {
    let sent: Result[i32, net.NetError] = net.send_to(s.sock, data, s.peer_addr);
  }
}

function send_all(s: App, out: u8[][]): void {
  for d in out {
    send(s, d);
  }
}

// A sealed control or voice frame to the peer.
function send_frame(s: App, kind: i32, plain: u8[]): App {
  match (s.chan) {
    Some(c) => {
      let (c1, frame) = match (kind == lan.VOICE) {
        true => secure.seal_voice(c, plain),
        false => secure.seal_control(c, plain),
      };
      send(s, lan.encode(kind, s.link.me, frame));
      return App { ...s, chan: Some(c1) };
    },
    None => {}
  }
  return s;
}

// The network, the timers and the microphone, after each event.
function pump(s: App, now: i64): App {
  let t: App = receive_all(s, now);
  let (l1, beacons) = lan.beacon(t.link, now);
  if (t.sock >= 0) {
    for b in beacons {
      let sent: Result[i32, net.NetError] = net.send_to(t.sock, b, net.socket_addr(net.V4([255u8, 255u8, 255u8, 255u8]), lan.PORT));
    }
  }
  let (l2, again) = lan.resend(l1, now);
  t = App { ...t, link: l2 };
  send_all(t, again);
  t = act(t, session.Tick);
  return speak(t);
}

function receive_all(s: App, now: i64): App {
  if (s.sock < 0) {
    return s;
  }
  let t: App = s;
  let buf: u8[] = [];
  for k in 0..2048 {
    buf = buf.append(0u8);
  }
  for k in 0..64 {
    match (net.recv_from(t.sock, buf)) {
      Ok((n, from)) => {
        match (lan.decode(buf, n)) {
          Some(p) => {
            t = packet(t, p, from, now);
          },
          None => {}
        }
      },
      Err(_) => {
        return t;
      }
    }
  }
  return t;
}

function packet(s: App, p: lan.Packet, from: net.SocketAddr, now: i64): App {
  let st: lan.Step = lan.heard(s.link, p, now);
  let t: App = App { ...s, link: st.link };
  send_all(t, st.out);
  match (st.heard) {
    lan.Found(peer) => {
      log.info("walkie: found peer " + peer.to_string() + " at " + from.to_string());
      let (l, out) = lan.pair(t.link, peer, now, rand.bytes(32), rand.bytes(16));
      let u: App = act(App { ...t, link: l, peer_addr: from }, session.PeerFound);
      send_all(u, out);
      return u;
    },
    lan.Verify(sas) => {
      log.info("walkie: keys are ready");
      let me: i32 = 2;
      let id: i64 = t.link.peer;
      if (lan.initiator(t.link)) {
        me = 1;
        id = t.link.me;
      }
      return act(t, session.TransportUp(lan.initiator(t.link), me, 3 - me, id));
    },
    lan.Failed => {
      log.info("walkie: the key exchange failed");
      return act(t, session.AuthFailed);
    },
    lan.Frame(kind, body) => {
      return frame(t, kind, body, now);
    },
    lan.Nothing => {}
  }
  return t;
}

function frame(s: App, kind: i32, body: u8[], now: i64): App {
  match (s.chan) {
    Some(c) => {
      if (kind == lan.CONTROL) {
        let (c1, plain) = secure.open_control(c, body);
        let t: App = App { ...s, chan: Some(c1) };
        match (plain) {
          Some(b) => {
            match (protocol.decode(b)) {
              Some(m) => {
                return act(t, session.Received(m));
              },
              None => {}
            }
          },
          None => {}
        }
        return t;
      }
      let (c2, voice) = secure.open_voice(c, body);
      let t2: App = App { ...s, chan: Some(c2) };
      match (voice) {
        Some(b) => {
          return play(t2, b, now);
        },
        None => {}
      }
      return t2;
    },
    None => {}
  }
  return s;
}

function play(s: App, b: u8[], now: i64): App {
  let (down, samples) = pcm.resample(s.down, pcm.unpack(b));
  let written: i32 = s.spk.write(samples, 0);
  return App { ...s, down: down, heard_at: now };
}

// The microphone samples since the last step, in 20 ms frames.
function speak(s: App): App {
  if (!s.capturing) {
    return s;
  }
  let raw: i32[] = s.mic.read(s.mic.rate / 10, 0);
  let (up, wire) = pcm.resample(s.up, raw);
  let pending: i32[] = s.pending;
  for v in wire {
    pending = pending.append(v);
  }
  let t: App = App { ...s, up: up };
  while (pending.len() >= pcm.FRAME) {
    let head: i32[] = [];
    let rest: i32[] = [];
    for k in 0..pending.len() {
      if (k < pcm.FRAME) {
        head = head.append(pending[k]);
      } else {
        rest = rest.append(pending[k]);
      }
    }
    t = send_frame(t, lan.VOICE, pcm.pack(head));
    pending = rest;
  }
  return App { ...t, pending: pending };
}

// The words of the talk button, and its color.
function button_face(s: App, now: i64): (string, i32) {
  match (s.link.phase) {
    lan.Closed => {
      return ("TAP TO SEARCH AGAIN", android.rgb(90, 90, 90));
    },
    _ => {}
  }
  match (s.sess.state) {
    session.Transmitting => {
      return ("TALKING", android.rgb(40, 170, 80));
    },
    session.Requesting => {
      return ("WAIT", android.rgb(200, 160, 30));
    },
    session.Listening => {
      if (s.sess.receiving || now - s.heard_at < 300i64) {
        return ("LISTENING", android.rgb(40, 110, 200));
      }
      return ("HOLD TO TALK", android.rgb(70, 70, 70));
    },
    _ => {}
  }
  if (ended(s.sess.state)) {
    return ("TAP TO SEARCH AGAIN", android.rgb(90, 90, 90));
  }
  return ("SEARCHING", android.rgb(50, 50, 50));
}

function status(s: App): string {
  match (s.link.phase) {
    lan.Searching => {
      return "looking for a phone on this Wi-Fi";
    },
    lan.Pairing => {
      return "found a phone: making keys";
    },
    lan.Verifying => {
      return "do both phones show this code?";
    },
    lan.Closed => {
      return "not connected";
    },
    lan.Ready => {
      return "connected";
    }
  }
  return "";
}

// The largest scale up to `cap` at which `text` fits in `w` pixels.
function fit_scale(text: string, w: i32, cap: i32): i32 {
  let sc: i32 = cap;
  while (sc > 1 && draw.text_width(text, sc) > w) {
    sc = sc - 1;
  }
  return sc;
}

function draw(s: App): App {
  let now: i64 = now_ms();
  let (label, color) = button_face(s, now);
  let key: string = status(s) + "|" + s.notice + "|" + label + "|" + s.link.sas;
  if (s.window == 0 as usize || key == s.drawn) {
    return s;
  }
  let w: android.Window = android.Window { ptr: s.window };
  let f: android.Frame = w.lock();
  if (f.width == 0) {
    return s;
  }
  let fw: i32 = f.width;
  let fh: i32 = f.height;
  let cell: i32 = draw.text_width("x", 1);
  let sc: i32 = screen.text_scale(fw, cell);
  let chars: i32 = screen.line_chars(fw, cell, sc);
  let line: i32 = draw.text_height(sc) * 3 / 2;
  let white: i32 = android.rgb(230, 230, 230);
  f.fill(0, 0, fw, fh, android.rgb(0, 0, 0));
  f.text(fw / 20, line, "Fern Walkie (LAN)", sc, white);
  let y: i32 = 2 * line;
  for l in screen.wrap(status(s), chars) {
    f.text(fw / 20, y, l, sc, android.rgb(160, 160, 160));
    y = y + line;
  }
  for l in screen.wrap(s.notice, chars) {
    f.text(fw / 20, y, l, sc, android.rgb(230, 120, 80));
    y = y + line;
  }
  match (s.link.phase) {
    lan.Verifying => {
      let big: i32 = sc * 3;
      let cw: i32 = draw.text_width(s.link.sas, big);
      f.text((fw - cw) / 2, fh / 5, s.link.sas, big, white);
      let same: screen.Rect = screen.same_button(fw, fh);
      let differ: screen.Rect = screen.differ_button(fw, fh);
      f.fill(same.x, same.y, same.w, same.h, android.rgb(40, 150, 70));
      f.fill(differ.x, differ.y, differ.w, differ.h, android.rgb(170, 50, 50));
      f.text(screen.center_x(same, draw.text_width("SAME", sc)), same.y + same.h / 2 - draw.text_height(sc) / 2, "SAME", sc, white);
      f.text(screen.center_x(differ, draw.text_width("DIFFERENT", sc)), differ.y + differ.h / 2 - draw.text_height(sc) / 2, "DIFFERENT", sc, white);
    },
    _ => {}
  }
  let b: screen.Rect = screen.talk_button(fw, fh);
  f.fill(b.x, b.y, b.w, b.h, color);
  let bs: i32 = fit_scale(label, b.w * 9 / 10, sc * 2);
  f.text(screen.center_x(b, draw.text_width(label, bs)), b.y + b.h / 2 - draw.text_height(bs) / 2, label, bs, white);
  android.post(f);
  return App { ...s, drawn: key };
}
