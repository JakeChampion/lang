// The layout of the walkie-talkie screen. It has no Android code, so the
// host tests it.
//
// The top fifth of the screen holds the title and the status lines. The
// middle holds the code to compare and its two buttons, or the list of
// peers. The round talk button sits in the lower half, and the room buttons
// below it make or join a room of the internet mode. A keypad takes the code
// of a room. The settings screen chooses the way to find the other phone.

import "std/string";
import "../look";
import "./rooms";
pub use "../look".{Rect, contains, center_x, wrap};

// The characters on one line of status text, at least.
pub const LINE_CHARS: i32 = 20;

// The scale of the text for a screen `w` pixels wide and characters `cell_w`
// pixels wide at scale 1: LINE_CHARS characters fit inside the margins.
pub function text_scale(w: i32, cell_w: i32): i32 {
  let s = w * 9 / 10 / (LINE_CHARS * cell_w);
  if (s < 1) {
    return 1;
  }
  return s;
}

// The characters that fit on one line inside the margins at scale `sc`.
pub function line_chars(w: i32, cell_w: i32, sc: i32): i32 {
  return w * 9 / 10 / (cell_w * sc);
}

// The square around the round talk button.
pub function talk_button(w: i32, h: i32): look.Rect {
  let d = w * 7 / 10;
  if (h * 3 / 10 < d) {
    d = h * 3 / 10;
  }
  return look.Rect { x: (w - d) / 2, y: h * 68 / 100 - d / 2, w: d, h: d };
}

// True when (x, y) is on the disc inside the square `r`.
pub function in_circle(r: look.Rect, x: f32, y: f32): boolean {
  let dx = x - (r.x + r.w / 2) as f32;
  let dy = y - (r.y + r.h / 2) as f32;
  let rad = (r.w / 2) as f32;
  return dx * dx + dy * dy < rad * rad;
}

// The button that says the two strings are the same.
pub function same_button(w: i32, h: i32): look.Rect {
  return look.Rect { x: w / 10, y: h * 33 / 100, w: w * 37 / 100, h: h * 6 / 100 };
}

// The button that says the two strings differ.
pub function differ_button(w: i32, h: i32): look.Rect {
  return look.Rect { x: w * 53 / 100, y: h * 33 / 100, w: w * 37 / 100, h: h * 6 / 100 };
}

// The number of Wi-Fi Direct peers that the screen lists.
pub const PEER_ROWS: i32 = 3;

// The row of peer `k` in the list, above the talk button.
pub function peer_row(w: i32, h: i32, k: i32): look.Rect {
  return look.Rect { x: w / 10, y: h * 3 / 10 + k * (h / 15), w: w * 8 / 10, h: h / 18 };
}

// The button that makes a room, and the button that joins one, in the row
// below the talk button.
pub function room_button(w: i32, h: i32): look.Rect {
  return look.Rect { x: w / 10, y: h * 885 / 1000, w: w * 37 / 100, h: h * 6 / 100 };
}

pub function join_button(w: i32, h: i32): look.Rect {
  return look.Rect { x: w * 53 / 100, y: h * 885 / 1000, w: w * 37 / 100, h: h * 6 / 100 };
}

// The keypad for the code of a room: a key for each letter of the code, and
// a last key that deletes a letter. It fills the place of the talk button and
// of the peer list.
pub const KEY_COLS: i32 = 8;

pub const KEY_ROWS: i32 = 4;

pub const DELETE_KEY: i32 = 31;

pub function key_rect(w: i32, h: i32, k: i32): look.Rect {
  return grid_key(w, h, k, KEY_ROWS);
}

// Key `k` of a keyboard of KEY_COLS columns and `rows` rows.
function grid_key(w: i32, h: i32, k: i32, rows: i32): look.Rect {
  let cell_w: i32 = w * 9 / 10 / KEY_COLS;
  let cell_h: i32 = h * 56 / 100 / rows;
  if (cell_h > cell_w * 5 / 4) {
    cell_h = cell_w * 5 / 4;
  }
  // The keys sit just above the room buttons, as a keyboard does.
  let top: i32 = room_button(w, h).y - h / 40 - rows * cell_h;
  let x: i32 = w / 20 + k % KEY_COLS * cell_w;
  let y: i32 = top + k / KEY_COLS * cell_h;
  return look.Rect { x: x + cell_w / 20, y: y + cell_h / 20, w: cell_w * 9 / 10, h: cell_h * 9 / 10 };
}

// The key at (x, y), or -1.
pub function key_at(w: i32, h: i32, x: f32, y: f32): i32 {
  for k in 0..DELETE_KEY + 1 {
    if (look.contains(key_rect(w, h, k), x, y)) {
      return k;
    }
  }
  return -1;
}

// The label of key `k`.
pub function key_label(k: i32): string {
  if (k == DELETE_KEY) {
    return "DEL";
  }
  let letters: [u8] = rooms.ALPHABET.as_bytes();
  return unsafe { string_from_bytes_unchecked([letters[k]]) };
}

// The code after a press of key `k`: a letter adds itself up to the length of
// a code, and DEL takes off the last letter.
pub function typed(code: string, k: i32): string {
  if (k == DELETE_KEY) {
    if (code.len() == 0) {
      return code;
    }
    return code.take(code.len() - 1);
  }
  if (k < 0 || k > DELETE_KEY || code.len() >= rooms.CODE_LEN) {
    return code;
  }
  return code + key_label(k);
}

// The button at the top right that opens the settings screen. It shows
// while the phone searches.
pub function mode_button(w: i32, h: i32): look.Rect {
  return look.Rect { x: w * 56 / 100, y: h * 2 / 100, w: w * 38 / 100, h: h * 5 / 100 };
}

// The rows of the settings screen, one for each way to find the other phone.
pub const MODE_ROWS: i32 = 4;

pub function mode_row(w: i32, h: i32, k: i32): look.Rect {
  return look.Rect { x: w / 10, y: h * 22 / 100 + k * (h * 13 / 100), w: w * 8 / 10, h: h * 11 / 100 };
}

// The row at (x, y), or -1.
pub function mode_at(w: i32, h: i32, x: f32, y: f32): i32 {
  for k in 0..MODE_ROWS {
    if (look.contains(mode_row(w, h, k), x, y)) {
      return k;
    }
  }
  return -1;
}

// The button that closes the settings screen, and the button that forgets
// the known phones, in the row of the room buttons.
pub function back_button(w: i32, h: i32): look.Rect {
  return room_button(w, h);
}

pub function forget_button(w: i32, h: i32): look.Rect {
  return join_button(w, h);
}

// The card of the settings screen that shows the room server, below the
// rows of the modes.
pub function server_row(w: i32, h: i32): look.Rect {
  return look.Rect { x: w / 10, y: h * 75 / 100, w: w * 8 / 10, h: h * 9 / 100 };
}

// The keyboard for the name of the room server: the letters, the digits,
// "." and "-", a key that clears the name, and a key that deletes a letter.
pub const HOST_ROWS: i32 = 5;

pub const HOST_CHARS: string = "abcdefghijklmnopqrstuvwxyz0123456789.-";

pub const CLEAR_KEY: i32 = 38;

pub const HOST_DELETE_KEY: i32 = 39;

pub function host_key_rect(w: i32, h: i32, k: i32): look.Rect {
  return grid_key(w, h, k, HOST_ROWS);
}

// The key of the host keyboard at (x, y), or -1.
pub function host_key_at(w: i32, h: i32, x: f32, y: f32): i32 {
  for k in 0..HOST_DELETE_KEY + 1 {
    if (look.contains(host_key_rect(w, h, k), x, y)) {
      return k;
    }
  }
  return -1;
}

pub function host_key_label(k: i32): string {
  if (k == CLEAR_KEY) {
    return "CLR";
  }
  if (k == HOST_DELETE_KEY) {
    return "DEL";
  }
  return unsafe { string_from_bytes_unchecked([HOST_CHARS.as_bytes()[k]]) };
}

// The longest name of a server, as DNS allows.
pub const HOST_MAX: i32 = 253;

// The name after a press of key `k`.
pub function host_typed(name: string, k: i32): string {
  if (k == CLEAR_KEY) {
    return "";
  }
  if (k == HOST_DELETE_KEY) {
    if (name.len() == 0) {
      return name;
    }
    return name.take(name.len() - 1);
  }
  if (k < 0 || k > HOST_DELETE_KEY || name.len() >= HOST_MAX) {
    return name;
  }
  return name + host_key_label(k);
}

// The field that shows the name as the user types it.
pub function host_field(w: i32, h: i32): look.Rect {
  return look.Rect { x: w / 10, y: h * 20 / 100, w: w * 8 / 10, h: h * 7 / 100 };
}

// The button below the field that opens the keyboard of the phone.
pub function phone_keys_button(w: i32, h: i32): look.Rect {
  return look.Rect { x: w / 10, y: h * 29 / 100, w: w * 8 / 10, h: h * 6 / 100 };
}

// The key of the host keyboard for an Android key code, or -1. The letters
// come as lower case, as a host name is.
pub function host_key_of_code(code: i32): i32 {
  // KEYCODE_A to KEYCODE_Z, and KEYCODE_0 to KEYCODE_9
  if (code >= 29 && code <= 54) {
    return code - 29;
  }
  if (code >= 7 && code <= 16) {
    return code - 7 + 26;
  }
  // KEYCODE_PERIOD, KEYCODE_MINUS and KEYCODE_DEL
  if (code == 56) {
    return 36;
  }
  if (code == 69) {
    return 37;
  }
  if (code == 67) {
    return HOST_DELETE_KEY;
  }
  return -1;
}
