// The control messages of the walkie-talkie protocol, and their encoding.
// A message is one byte of type, then its fields in network byte order.
// The secure channel carries each encoded message in one sealed frame.

pub const VERSION: i32 = 1;

pub const CODEC_OPUS: i32 = 1;

pub enum Message {
  // version, session ID, codec, capability bits
  Hello(i32, i64, i32, i32),
  // session ID, participant ID, request ID, timestamp in milliseconds
  PttRequest(i64, i32, i32, i64),
  // request ID, floor owner, lease in milliseconds
  PttGrant(i32, i32, i32),
  // request ID, floor owner
  PttDeny(i32, i32),
  // request ID
  PttRelease(i32),
  // session ID, sequence number
  Heartbeat(i64, i32),
  // reason code
  Bye(i32),
  // reason code
  Error(i32),
  // The rekey of one voice direction, at the start of a transmission: the
  // epoch of the new key and a new X25519 public key. The speaker sends the
  // offer, and the listener sends the accept.
  KeyOffer(i32, u8[]),
  KeyAccept(i32, u8[]),
  // After the users confirm the string: the Ed25519 public key of the
  // sender's identity, a signature for the exchange, and the flags
  // HAVE_PEER and DONE.
  Identity(u8[], u8[], i32),
}

// The flags of Identity: the sender has the identity of the receiver, and
// the sender also knows that the receiver has its identity.
pub const HAVE_PEER: i32 = 1;

pub const DONE: i32 = 2;

// Reason codes of Bye and Error.
pub const REASON_LEAVE: i32 = 1;

pub const REASON_VERSION: i32 = 2;

pub const REASON_TIMEOUT: i32 = 3;

pub const REASON_PROTOCOL: i32 = 4;

pub const REASON_CODEC: i32 = 5;

const T_HELLO: i32 = 1;

const T_REQUEST: i32 = 2;

const T_GRANT: i32 = 3;

const T_DENY: i32 = 4;

const T_RELEASE: i32 = 5;

const T_HEARTBEAT: i32 = 6;

const T_BYE: i32 = 7;

const T_ERROR: i32 = 8;

const T_KEY_OFFER: i32 = 9;

const T_KEY_ACCEPT: i32 = 10;

const T_IDENTITY: i32 = 11;

// The length of an X25519 public key.
pub const KEY_LEN: i32 = 32;

function put8(out: u8[], v: i32): u8[] {
  return out.append((v & 255) as u8);
}

function put16(out: u8[], v: i32): u8[] {
  return put8(put8(out, v >> 8), v);
}

function put32(out: u8[], v: i32): u8[] {
  return put16(put16(out, v >> 16), v);
}

function put64(out: u8[], v: i64): u8[] {
  return put32(put32(out, (v >> 32) as i32), (v & 4294967295i64) as i32);
}

pub function encode(m: Message): u8[] {
  match (m) {
    Hello(version, session, codec, caps) => {
      return put32(put8(put64(put16(put8([], T_HELLO), version), session), codec), caps);
    },
    PttRequest(session, participant, request, ts) => {
      return put64(put32(put32(put64(put8([], T_REQUEST), session), participant), request), ts);
    },
    PttGrant(request, owner, lease) => {
      return put32(put32(put32(put8([], T_GRANT), request), owner), lease);
    },
    PttDeny(request, owner) => {
      return put32(put32(put8([], T_DENY), request), owner);
    },
    PttRelease(request) => {
      return put32(put8([], T_RELEASE), request);
    },
    Heartbeat(session, seq) => {
      return put32(put64(put8([], T_HEARTBEAT), session), seq);
    },
    Bye(reason) => {
      return put16(put8([], T_BYE), reason);
    },
    Error(reason) => {
      return put16(put8([], T_ERROR), reason);
    },
    KeyOffer(epoch, public) => {
      return key_message(T_KEY_OFFER, epoch, public);
    },
    KeyAccept(epoch, public) => {
      return key_message(T_KEY_ACCEPT, epoch, public);
    },
    Identity(public, signature, flags) => {
      let out: u8[] = put8([], T_IDENTITY);
      for b in public {
        out = out.append(b);
      }
      for b in signature {
        out = out.append(b);
      }
      return put8(out, flags);
    }
  }
}

function key_message(t: i32, epoch: i32, public: [u8]): u8[] {
  let out = put32(put8([], t), epoch);
  for b in public {
    out = out.append(b);
  }
  return out;
}

// A rekey message: the type, the epoch, and a public key of KEY_LEN bytes.
function decode_key(b: [u8]): Option[Message] {
  if (b.len() != 5 + KEY_LEN) {
    return None;
  }
  let epoch = b[1] as i32 << 24 | b[2] as i32 << 16 | b[3] as i32 << 8 | b[4] as i32;
  let public: u8[] = [];
  for k in 5..b.len() {
    public = public.append(b[k]);
  }
  if (b[0] as i32 == T_KEY_OFFER) {
    return Some(KeyOffer(epoch, public));
  }
  return Some(KeyAccept(epoch, public));
}

// The `n` bytes of `b` from index `at`.
function span(b: [u8], at: i32, n: i32): u8[] {
  let out: u8[] = [];
  for k in at..at + n {
    out = out.append(b[k]);
  }
  return out;
}

// A cursor over the bytes of a message. A read past the end sets `bad`.
struct Cursor { b: u8[], at: i32, bad: boolean }

function take(r: Cursor, n: i32): (Cursor, i64) {
  if (r.at + n > r.b.len()) {
    return (Cursor { ...r, bad: true }, 0 as i64);
  }
  let v = 0 as i64;
  for k in 0..n {
    v = v << 8 as i64 | r.b[r.at + k] as i64;
  }
  return (Cursor { ...r, at: r.at + n }, v);
}

function take32(r: Cursor): (Cursor, i32) {
  let (next, v) = take(r, 4);
  return (next, v as i32);
}

// The message in `b`, or None when `b` is not one whole message.
pub function decode(b: u8[]): Option[Message] {
  if (b.len() == 0) {
    return None;
  }
  let t = b[0] as i32;
  if (t == T_KEY_OFFER || t == T_KEY_ACCEPT) {
    return decode_key(b);
  }
  if (t == T_IDENTITY) {
    if (b.len() != 1 + KEY_LEN + 64 + 1 || b[b.len() - 1] > 3u8) {
      return None;
    }
    return Some(Identity(span(b, 1, KEY_LEN), span(b, 1 + KEY_LEN, 64), b[b.len() - 1] as i32));
  }
  let r = Cursor { b: b, at: 1, bad: false };
  let m = Bye(0);
  if (t == T_HELLO) {
    let (r1, version) = take(r, 2);
    let (r2, session) = take(r1, 8);
    let (r3, codec) = take(r2, 1);
    let (r4, caps) = take32(r3);
    r = r4;
    m = Hello(version as i32, session, codec as i32, caps);
  } else if (t == T_REQUEST) {
    let (r1, session) = take(r, 8);
    let (r2, participant) = take32(r1);
    let (r3, request) = take32(r2);
    let (r4, ts) = take(r3, 8);
    r = r4;
    m = PttRequest(session, participant, request, ts);
  } else if (t == T_GRANT) {
    let (r1, request) = take32(r);
    let (r2, owner) = take32(r1);
    let (r3, lease) = take32(r2);
    r = r3;
    m = PttGrant(request, owner, lease);
  } else if (t == T_DENY) {
    let (r1, request) = take32(r);
    let (r2, owner) = take32(r1);
    r = r2;
    m = PttDeny(request, owner);
  } else if (t == T_RELEASE) {
    let (r1, request) = take32(r);
    r = r1;
    m = PttRelease(request);
  } else if (t == T_HEARTBEAT) {
    let (r1, session) = take(r, 8);
    let (r2, seq) = take32(r1);
    r = r2;
    m = Heartbeat(session, seq);
  } else if (t == T_BYE || t == T_ERROR) {
    let (r1, reason) = take(r, 2);
    r = r1;
    m = Bye(reason as i32);
    if (t == T_ERROR) {
      m = Error(reason as i32);
    }
  } else {
    return None;
  }
  if (r.bad || r.at != b.len()) {
    return None;
  }
  return Some(m);
}
