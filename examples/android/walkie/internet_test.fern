// Two walkie-talkie nodes in one room of the server: each datagram goes to
// the relay of `rooms` with the token of its node, and the relay sends it on.
// The clock steps 10 ms at a time, and each leg of the trip takes 10 ms.
import "std/crypto";
import "std/net";
import "std/test";
import "./internet";
import "./lan";
import "./node";
import "./rooms";
import "./secure";
import "./session";

const STEP_MS: i64 = 10i64;

// A datagram that arrives at `at`: at the relay from `from` when `to` is -1,
// or at node `to`.
struct Flight { at: i64, to: i32, from: net.SocketAddr, data: u8[] }

struct Sim {
  nodes: node.Node[],
  rooms: internet.Room[],
  table: rooms.Rooms,
  // The address of each phone.
  addrs: net.SocketAddr[],
  flights: Flight[],
  now: i64,
  heard: i32[],
  // The frames that node 1 heard from the start of the outage to the last
  // press and after it, and the new nodes after a lost transport.
  heard_dark: i32,
  heard_late: i32,
  resumed: i32,
}

// Node 0 presses and releases the button at these times, and node 1 moves to
// a new address at `move_at`. No datagram arrives from `dark_from` until
// `dark_to`.
struct Script { press: i64[], release: i64[], move_at: i64, dark_from: i64, dark_to: i64 }

function addr(last: i32, port: i32): net.SocketAddr {
  return net.socket_addr(net.ipv4(198, 51, 100, last), port);
}

function relay_addr(): net.SocketAddr {
  return net.socket_addr(net.ipv4(203, 0, 113, 1), rooms.PORT);
}

function random(seed: string): u8[] {
  let h = crypto.sha256(seed.as_bytes());
  let out: u8[] = [];
  for k in 0..rooms.RANDOM_LEN {
    out = out.append(h[k]);
  }
  return out;
}

// The random bytes of node `k` for the tick at `now`, different each time.
function entropy(k: i32, now: i64): u8[] {
  let out: u8[] = [];
  let v = now * 2654435761i64 + (k as i64 + 1i64) * 40503i64;
  for i in 0..node.RANDOM_BYTES {
    v = v * 6364136223846793005i64 + 1442695040888963407i64;
    out = out.append((v >> 33i64 & 255i64) as u8);
  }
  return out;
}

function id_seed(k: i32): u8[] {
  let out: u8[] = [];
  for i in 0..32 {
    out = out.append(((i * 11 + k * 53) % 256) as u8);
  }
  return out;
}

function seed(k: i32): u8[] {
  let out: u8[] = [];
  for i in 0..node.SEED_BYTES {
    out = out.append(((i * 7 + k * 31) % 256) as u8);
  }
  return out;
}

// A room that node 0 makes and node 1 joins. Node 0 has the higher random
// value, so only its role makes it the floor controller.
function start(): Sim {
  let made = rooms.answer(rooms.empty(random("secret")), "198.51.100.1", "CREATE", 0i64, random("a"));
  let code = "";
  if let rooms.Created(c, _) = made.reply {
    code = c;
  }
  let joined = rooms.answer(made.rooms, "198.51.100.2", "JOIN " + code, 0i64, random("b"));
  let r0: internet.Room[] = [];
  for reply in [made.reply, joined.reply] {
    if let Some(r) = internet.room_of(reply, code, relay_addr()) {
      r0 = r0.append(r);
    }
  }
  let maker = node.with_identity(node.new(1i64, seed(1), 0i64), id_seed(1), []);
  let joiner = node.with_identity(node.new(2i64, seed(2), 0i64), id_seed(2), []);
  let nodes = [node.in_room(maker, r0[0].lead, 9i64, 0i64), node.in_room(joiner, r0[1].lead, 5i64, 0i64)];
  return Sim { nodes: nodes, rooms: r0, table: joined.rooms, addrs: [addr(1, 47120), addr(2, 47120)], flights: [], now: 0i64, heard: [0, 0], heard_dark: 0, heard_late: 0, resumed: 0 };
}

function owner_of(s: Sim, a: net.SocketAddr): i32 {
  for i in 0..s.addrs.len() {
    if (s.addrs[i].eq(a)) {
      return i;
    }
  }
  return -1;
}

// The node at index i of nodes, and nodes with a new node in its place.
function take(own nodes: node.Node[], i: i32): (node.Node, node.Node[]) {
  return nodes.swap_at(i, node.new(0i64, [], 0i64));
}

// The Sim after node f.to receives flight f.
function received(own s: Sim, f: Flight): Sim {
  let (cur, rest) = take(s.nodes, f.to);
  return Sim { ...s, nodes: rest.with(f.to, node.receive(cur, f.data, f.data.len(), f.from, s.now)) };
}

// Node i after one step of the script: the cues of the users, a tick, and a
// start again in the room after a lost transport.
function stepped(own s: Sim, i: i32, sc: Script, users_confirm: boolean, voice: [i32]): Sim {
  let (n, rest) = take(s.nodes, i);
  if (users_confirm && shows_code(n)) {
    n = node.confirm(n, s.now);
  }
  if (i == 0 && sc.press.contains(s.now)) {
    n = node.press(n, s.now);
  }
  if (i == 0 && sc.release.contains(s.now)) {
    n = node.release(n, s.now);
  }
  n = node.voice(node.tick(node.fresh(n, entropy(i, s.now)), s.now), voice);
  let resumed = s.resumed;
  if (node.reconnecting(n)) {
    n = node.resume(n, 0i64, seed(i + 3), s.now);
    n = node.in_room(n, s.rooms[i].lead, 15i64 + 4i64 * (i as i64), s.now);
    resumed += 1;
  }
  return Sim { ...s, nodes: rest.with(i, n), resumed: resumed };
}

function deliver(own s0: Sim): Sim {
  let s = s0;
  let left: Flight[] = [];
  let later: Flight[] = [];
  for f in s.flights {
    if (f.at > s.now) {
      left = left.append(f);
    } else if (f.to < 0) {
      let r = rooms.relay(s.table, f.from, f.data, f.data.len(), s.now);
      s = Sim { ...s, table: r.rooms };
      if let Some(fw) = r.out {
        later = later.append(Flight { at: s.now + STEP_MS, to: owner_of(s, fw.to), from: relay_addr(), data: fw.data });
      }
    } else if (f.to >= 0) {
      // A phone answers a challenge of the relay at once, as the app does.
      if let Some(answer) = internet.challenged(s.rooms[f.to], f.data, f.data.len()) {
        later = later.append(Flight { at: s.now + STEP_MS, to: -1, from: s.addrs[f.to], data: answer });
      } else {
        s = received(s, f);
      }
    }
  }
  return Sim { ...s, flights: left.concat(later) };
}

function send(s: Sim, i: i32, dark: boolean): Sim {
  let flights = s.flights;
  if (!dark) {
    for d in s.nodes[i].out {
      flights = flights.append(Flight { at: s.now + STEP_MS, to: -1, from: s.addrs[i], data: internet.wrap(s.rooms[i], d.data) });
    }
  }
  let n = s.nodes[i];
  return Sim { ...s, flights: flights, heard: s.heard.with(i, s.heard[i] + n.heard.len()), nodes: s.nodes.with(i, node.drained(n)) };
}

function shows_code(n: node.Node): boolean {
  match (n.link.phase) {
    lan.Verifying => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function tone(): i32[] {
  let out: i32[] = [];
  for k in 0..160 {
    out = out.append((k % 32 - 16) * 1000);
  }
  return out;
}

// Both users confirm when the code shows, but not after the start of an
// outage. A node that lost its transport starts again in the room, as the
// app does.
function run(sc: Script, end: i64): Sim {
  let s = start();
  let voice = tone();
  while (s.now <= end) {
    let dark = s.now >= sc.dark_from && s.now < sc.dark_to;
    if (dark) {
      s = Sim { ...s, flights: [] };
    }
    s = deliver(s);
    let users_confirm = sc.dark_from < 0i64 || s.now < sc.dark_from;
    for i in 0..2 {
      s = stepped(s, i, sc, users_confirm, voice);
    }
    if (s.now == sc.move_at) {
      s = Sim { ...s, addrs: s.addrs.with(1, addr(7, 40000)) };
    }
    let before = s.heard[1];
    s = send(send(s, 0, dark), 1, dark);
    if (sc.dark_from >= 0i64 && s.now >= sc.dark_from) {
      if (s.now < sc.press[sc.press.len() - 1]) {
        s = Sim { ...s, heard_dark: s.heard_dark + s.heard[1] - before };
      } else {
        s = Sim { ...s, heard_late: s.heard_late + s.heard[1] - before };
      }
    }
    s = Sim { ...s, now: s.now + STEP_MS };
  }
  return s;
}

// The epoch of the voice key that `n` sends with, or receives with.
function epoch_of(n: node.Node, sending: boolean): i32 {
  if let Some(c) = n.chan {
    if (sending) {
      return secure.send_epoch(c);
    }
    return secure.recv_epoch(c);
  }
  return -1;
}

function test_two_phones_talk_through_the_relay(): test.TestOutcome {
  let s = run(Script { press: [5000i64], release: [15000i64], move_at: 10000i64, dark_from: -1i64, dark_to: -1i64 }, 20000i64);
  let a = s.nodes[0];
  let b = s.nodes[1];
  let rooms_ok = s.rooms.len() == 2 && s.rooms[0].code == s.rooms[1].code;
  let paired = a.link.sas.len() == 6 && a.link.sas == b.link.sas && session.connected(a.sess) && session.connected(b.sess) && a.sess.controller && !b.sess.controller;
  // 500 frames in 10 s: B moves at 10 s and must still hear the second half.
  // The transmission rekeys A's voice through the relay.
  let rekeyed = epoch_of(a, true) == 1 && epoch_of(b, false) == 1;
  let got = rooms_ok.to_string() + " " + paired.to_string() + " " + (s.heard[1] >= 480).to_string() + " " + (s.heard[1] <= 500).to_string() + " " + rekeyed.to_string();
  if (got != "true true true true true") {
    return test.fail(got + ": heard " + s.heard[1].to_string() + ", codes " + a.link.sas + " " + b.link.sas);
  }
  return test.pass();
}

// Both nodes of a room join it before they find each other.
function test_nodes_join_the_room(): test.TestOutcome {
  let s = start();
  let leads = s.rooms[0].lead.to_string() + " " + s.rooms[1].lead.to_string();
  return test.assert_eq(session.state_name(s.nodes[0].sess.state) + " " + session.state_name(s.nodes[1].sess.state) + " " + leads, "JOINING JOINING true false");
}

// Both phones lose the network from 8 s to 14 s while node 0 talks, and node
// 1 comes back on a new address. Each side loses the other and starts a new
// key exchange in the same room. The two phones know each other now, so they
// connect with no user who confirms a code. A press before the new session is
// up sends nothing, and a press after it is heard.
function test_phones_reconnect_in_the_room(): test.TestOutcome {
  let sc = Script { press: [4000i64, 13500i64, 20000i64], release: [13800i64, 24000i64], move_at: 11000i64, dark_from: 8000i64, dark_to: 14000i64 };
  let s = run(sc, 26000i64);
  let a = s.nodes[0];
  let b = s.nodes[1];
  let up = session.connected(a.sess) && session.connected(b.sess) && a.sess.peer_ready && b.sess.peer_ready;
  let got = s.resumed.to_string() + " " + up.to_string() + " " + s.heard_dark.to_string() + " " + (s.heard_late >= 180).to_string();
  if (got != "2 true 0 true") {
    return test.fail(got + ": heard " + s.heard_late.to_string() + " late, notices " + a.notice + " / " + b.notice);
  }
  return test.pass();
}

// The relay sends nothing that a phone without a room token sends.
function test_a_stranger_reaches_nobody(): test.TestOutcome {
  let s = start();
  let stranger = internet.Room { code: "", token: random("z").take(rooms.TOKEN_LEN), relay: relay_addr(), sent: cell_new(0i64), lead: false };
  let r = rooms.relay(s.table, addr(9, 5000), internet.wrap(stranger, [247u8, 1u8]), 19, 0i64);
  return test.assert_eq(r.out.is_some().to_string(), "false");
}

function main(): i32 {
  let r = test.new("walkie internet");
  r = r.it("two phones talk through the relay, and one moves", test_two_phones_talk_through_the_relay);
  r = r.it("two phones reconnect in the room after an outage", test_phones_reconnect_in_the_room);
  r = r.it("the nodes join the room", test_nodes_join_the_room);
  r = r.it("a stranger reaches nobody", test_a_stranger_reaches_nobody);
  return r.finish();
}
