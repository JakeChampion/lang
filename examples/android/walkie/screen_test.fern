import "std/test";
import "./screen";

function overlap(a: screen.Rect, b: screen.Rect): boolean {
  return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
}

function inside(r: screen.Rect, w: i32, h: i32): boolean {
  return r.x >= 0 && r.y >= 0 && r.x + r.w <= w && r.y + r.h <= h && r.w > 0 && r.h > 0;
}

// On a phone screen and on a small one, the buttons fit and do not overlap.
function test_buttons_fit_and_do_not_overlap(): test.TestOutcome {
  for size in [[1080, 2400], [720, 1280], [320, 480]] {
    let w = size[0];
    let h = size[1];
    let talk = screen.talk_button(w, h);
    let same = screen.same_button(w, h);
    let differ = screen.differ_button(w, h);
    if (!inside(talk, w, h) || !inside(same, w, h) || !inside(differ, w, h)) {
      return test.fail("a button is off the screen at " + w.to_string() + "x" + h.to_string());
    }
    if (overlap(talk, same) || overlap(talk, differ) || overlap(same, differ)) {
      return test.fail("buttons overlap at " + w.to_string() + "x" + h.to_string());
    }
  }
  return test.pass();
}

// The rows of the peer list fit, do not overlap each other, and stay above
// the talk button.
function test_peer_rows_fit_above_the_talk_button(): test.TestOutcome {
  for size in [[1080, 2400], [720, 1280], [320, 480]] {
    let w = size[0];
    let h = size[1];
    let talk = screen.talk_button(w, h);
    for k in 0..screen.PEER_ROWS {
      let row = screen.peer_row(w, h, k);
      if (!inside(row, w, h) || overlap(row, talk)) {
        return test.fail("peer row " + k.to_string() + " is off the screen or on the talk button at " + w.to_string() + "x" + h.to_string());
      }
      if (k > 0 && overlap(row, screen.peer_row(w, h, k - 1))) {
        return test.fail("peer rows overlap at " + w.to_string() + "x" + h.to_string());
      }
    }
  }
  return test.pass();
}

// The keys of the keypad fit, do not overlap, leave the room buttons free,
// and each key is the key at its middle. The text says what is wrong.
function keys_fit(w: i32, h: i32): string {
  let room = screen.room_button(w, h);
  let join = screen.join_button(w, h);
  for k in 0..screen.DELETE_KEY + 1 {
    let key = screen.key_rect(w, h, k);
    if (!inside(key, w, h) || overlap(key, room) || overlap(key, join)) {
      return "key " + k.to_string() + " is off the screen or on a room button";
    }
    if (k > 0 && overlap(key, screen.key_rect(w, h, k - 1))) {
      return "keys overlap";
    }
    if (screen.key_at(w, h, (key.x + key.w / 2) as f32, (key.y + key.h / 2) as f32) != k) {
      return "the middle of key " + k.to_string() + " is not that key";
    }
  }
  return "";
}

// The room buttons sit below the talk button, and the keypad fits.
function test_room_buttons_and_keypad_fit(): test.TestOutcome {
  for size in [[1080, 2400], [720, 1280], [320, 480]] {
    let w = size[0];
    let h = size[1];
    let talk = screen.talk_button(w, h);
    let room = screen.room_button(w, h);
    let join = screen.join_button(w, h);
    if (!inside(room, w, h) || !inside(join, w, h) || overlap(room, talk) || overlap(join, talk) || overlap(room, join)) {
      return test.fail("a room button is off the screen or on a button at " + w.to_string() + "x" + h.to_string());
    }
    let keys = keys_fit(w, h);
    if (keys != "") {
      return test.fail(keys + " at " + w.to_string() + "x" + h.to_string());
    }
  }
  return test.assert_eq(screen.key_at(1080, 2400, 1.0f32, 1.0f32).to_string(), "-1");
}

// The keys type the letters of a code, up to its length, and DEL takes one off.
function test_keypad_types_a_code(): test.TestOutcome {
  let code = "";
  for k in [0, 30, 1, 2, 3, 4, 5, 6, 7] {
    code = screen.typed(code, k);
  }
  let full = code;
  code = screen.typed(screen.typed(code, screen.DELETE_KEY), 8);
  let empty = screen.typed("", screen.DELETE_KEY);
  return test.assert_eq(full + " " + code + " [" + empty + "] " + screen.key_label(screen.DELETE_KEY), "A9BCDEFG A9BCDEFJ [] DEL");
}

// A touch counts on the round talk button, and not in the corners of its
// square.
function test_talk_button_is_round(): test.TestOutcome {
  let r = screen.talk_button(1080, 2400);
  let mid_x = (r.x + r.w / 2) as f32;
  let mid_y = (r.y + r.h / 2) as f32;
  let s = screen.in_circle(r, mid_x, mid_y).to_string() + " " + screen.in_circle(r, (r.x + 2) as f32, (r.y + 2) as f32).to_string() + " " + (r.w == r.h).to_string();
  return test.assert_eq(s, "true false true");
}

function test_contains_is_half_open(): test.TestOutcome {
  let r = screen.Rect { x: 10, y: 20, w: 5, h: 5 };
  let s = screen.contains(r, 10.0f32, 20.0f32).to_string() + " " + screen.contains(r, 15.0f32, 22.0f32).to_string() + " " + screen.contains(r, 14.5f32, 24.9f32).to_string();
  return test.assert_eq(s, "true false true");
}

// At the scale, LINE_CHARS characters of 15 pixels fit in 90% of the width.
function test_text_scale(): test.TestOutcome {
  let s = "";
  for w in [899, 1080, 1440, 200] {
    let sc = screen.text_scale(w, 15);
    let n = screen.line_chars(w, 15, sc);
    s = s + sc.to_string() + ":" + n.to_string() + ":" + (n * 15 * sc <= w * 9 / 10).to_string() + " ";
  }
  return test.assert_eq(s, "2:26:true 3:21:true 4:21:true 1:12:true ");
}

function joined(lines: string[]): string {
  let s = "";
  for l in lines {
    s = s + "[" + l + "]";
  }
  return s;
}

// Lines break at spaces, and a word longer than a line is cut.
function test_wrap(): test.TestOutcome {
  let a = joined(screen.wrap("looking for a phone on this Wi-Fi", 20));
  let b = joined(screen.wrap("abcdefghijkl xy", 5));
  let c = joined(screen.wrap("", 5));
  return test.assert_eq(a + " " + b + " " + c, "[looking for a phone][on this Wi-Fi] [abcde][fghij][kl xy] ");
}

// The settings button sits above the status and the peer list, and the
// rows of the settings screen fit above BACK and FORGET. Each row is the
// row at its middle.
function test_settings_fit(): test.TestOutcome {
  for size in [[1080, 2400], [720, 1280], [320, 480]] {
    let w: i32 = size[0];
    let h: i32 = size[1];
    let at: string = " at " + w.to_string() + "x" + h.to_string();
    let b: screen.Rect = screen.mode_button(w, h);
    if (!inside(b, w, h) || overlap(b, screen.peer_row(w, h, 0)) || overlap(b, screen.talk_button(w, h))) {
      return test.fail("the mode button is off the screen or on another button" + at);
    }
    let back: screen.Rect = screen.back_button(w, h);
    let forget: screen.Rect = screen.forget_button(w, h);
    if (!inside(back, w, h) || !inside(forget, w, h) || overlap(back, forget) || overlap(forget, screen.server_row(w, h))) {
      return test.fail("BACK and FORGET do not fit" + at);
    }
    for k in 0..screen.MODE_ROWS {
      let row: screen.Rect = screen.mode_row(w, h, k);
      if (!inside(row, w, h) || overlap(row, back) || overlap(row, forget) || k > 0 && overlap(row, screen.mode_row(w, h, k - 1))) {
        return test.fail("mode row " + k.to_string() + " does not fit" + at);
      }
      if (screen.mode_at(w, h, (row.x + row.w / 2) as f32, (row.y + row.h / 2) as f32) != k) {
        return test.fail("mode row " + k.to_string() + " is not the row at its middle" + at);
      }
    }
  }
  return test.assert_eq(screen.mode_at(1080, 2400, 5.0f32, 5.0f32), -1);
}

// The field, the keys of the server and the card of the server fit, and a
// press of each key does what its label says.
function test_host_keyboard_fits(): test.TestOutcome {
  for size in [[1080, 2400], [720, 1280], [320, 480]] {
    let w: i32 = size[0];
    let h: i32 = size[1];
    let at: string = " at " + w.to_string() + "x" + h.to_string();
    let field: screen.Rect = screen.host_field(w, h);
    let card: screen.Rect = screen.server_row(w, h);
    let phone: screen.Rect = screen.phone_keys_button(w, h);
    if (!inside(phone, w, h) || overlap(phone, field) || overlap(phone, screen.host_key_rect(w, h, 0))) {
      return test.fail("the button of the phone keyboard does not fit" + at);
    }
    if (!inside(field, w, h) || !inside(card, w, h) || overlap(card, screen.back_button(w, h)) || overlap(card, screen.mode_row(w, h, screen.MODE_ROWS - 1))) {
      return test.fail("the field or the card of the server does not fit" + at);
    }
    for k in 0..screen.HOST_DELETE_KEY + 1 {
      let key: screen.Rect = screen.host_key_rect(w, h, k);
      if (!inside(key, w, h) || overlap(key, field) || overlap(key, screen.room_button(w, h)) || overlap(key, screen.join_button(w, h))) {
        return test.fail("host key " + k.to_string() + " does not fit" + at);
      }
      if (screen.host_key_at(w, h, (key.x + key.w / 2) as f32, (key.y + key.h / 2) as f32) != k) {
        return test.fail("host key " + k.to_string() + " is not the key at its middle" + at);
      }
    }
  }
  let typed: string = screen.host_typed(screen.host_typed(screen.host_typed("", 0), 36), 27);
  let line: string = typed + " " + screen.host_typed(typed, screen.HOST_DELETE_KEY) + " [" + screen.host_typed(typed, screen.CLEAR_KEY) + "] " + screen.host_key_label(screen.CLEAR_KEY);
  return test.assert_eq(line, "a.1 a. [] CLR");
}

// The key codes of the phone keyboard give the keys of the host keyboard.
function test_host_key_of_code(): test.TestOutcome {
  let typed: string = "";
  // r, o, ., 4, -, z, then DEL, and a key that types nothing (SPACE)
  for code in [46, 43, 56, 11, 69, 54, 67, 62] {
    typed = screen.host_typed(typed, screen.host_key_of_code(code));
  }
  return test.assert_eq(typed + " " + screen.host_key_of_code(29).to_string() + " " + screen.host_key_of_code(62).to_string(), "ro.4- 0 -1");
}

function test_host_text(): test.TestOutcome {
  let long = "";
  for i in 0..300 {
    long += "a";
  }
  return test.assert_eq(screen.host_text("Room 4.Example-é_net") + " " + screen.host_text(long).len().to_string(), "room4.example-net " + screen.HOST_MAX.to_string());
}

function main(): i32 {
  let r = test.new("walkie screen");
  r = r.it("the buttons fit and do not overlap", test_buttons_fit_and_do_not_overlap);
  r = r.it("the peer rows fit above the talk button", test_peer_rows_fit_above_the_talk_button);
  r = r.it("the room buttons and the keypad fit", test_room_buttons_and_keypad_fit);
  r = r.it("the keypad types a code", test_keypad_types_a_code);
  r = r.it("the talk button is round", test_talk_button_is_round);
  r = r.it("contains is half-open", test_contains_is_half_open);
  r = r.it("the text scale follows the width", test_text_scale);
  r = r.it("text wraps at spaces", test_wrap);
  r = r.it("the settings fit", test_settings_fit);
  r = r.it("the keyboard of the server fits", test_host_keyboard_fits);
  r = r.it("phone key codes give host keys", test_host_key_of_code);
  r = r.it("the text of the phone keyboard gives a host name", test_host_text);
  return r.finish();
}
