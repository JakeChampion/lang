// The secure channel of the walkie-talkie: an authenticated key exchange,
// a short authentication string, and sealed frames.
//
// The key exchange is a hybrid of ephemeral X25519 and ML-KEM-768, in three
// messages:
//
// 1. The initiator sends a commitment, the SHA-256 of its X25519 public key
//    and a nonce, and its ML-KEM encapsulation key.
// 2. The responder sends its X25519 public key, a nonce, and an ML-KEM
//    ciphertext for that encapsulation key.
// 3. The initiator sends its X25519 public key and nonce, and the responder
//    checks them against the commitment.
//
// Each side fixes all of its values before it sees the values of the other
// side, so a third party in the middle cannot try keys until the
// authentication strings match. For this reason the initiator holds the
// ML-KEM key pair: the side that encapsulates chooses its value after it sees
// the key. Both shared secrets go into the key derivation, so the keys stay
// secret while one of the two problems stays hard. The two users compare the
// short authentication string at first pairing.
//
// Each direction and each channel has its own key. Both channels go over
// datagrams, which can be lost or reordered. A frame is sealed with
// ChaCha20-Poly1305, and its nonce is its sequence number. A frame of either
// channel is accepted once inside a window of 64 numbers.
//
// A voice direction gets a new key at the start of each transmission. The
// speaker offers a new X25519 public key, and the listener accepts with one
// of its own. Both put the shared secret into the chain of the direction, and
// they erase the private keys and the key before the last. A frame carries
// the epoch of its key, so the receiver also opens the frames that were in
// flight. Thus a recording of a transmission stays secret after a later
// compromise, and a passive party that took the keys loses them at the next
// transmission.
import "std/crypto";
import "std/crypto/chacha20poly1305";
import "std/crypto/mlkem768";
import "std/crypto/x25519";

const M_COMMIT: i32 = 16;

const M_KEY: i32 = 17;

const M_REVEAL: i32 = 18;

pub const CTL: i32 = 1;

pub const VOICE: i32 = 2;

const WINDOW: i32 = 64;

// The ML-KEM-768 sizes, and the random bytes that `start` takes for ML-KEM.
const EK_LEN: i32 = 1184;

const CT_LEN: i32 = 1088;

pub const KEM_RANDOM: i32 = 64;

const MAX_SEQUENCE: i64 = 9223372036854775807i64;

const FRESH: i32 = 0;

const COMMITTED: i32 = 1;

const READY: i32 = 2;

const CLOSED: i32 = 3;

// `kem` holds the ML-KEM secret of this side: the decapsulation key of the
// initiator or the random value of the responder, and then the shared
// secret. `ek` and `ct` are the public ML-KEM values of the exchange.
pub struct Handshake { initiator: boolean, private: Cell[u8[]], kem: Cell[u8[]], phase: Cell[i32], public: u8[], nonce: u8[], ek: u8[], ct: u8[], commit: u8[], peer_key: u8[], peer_nonce: u8[], done: boolean, failed: boolean }

pub struct Keys { send_ctl: Cell[u8[]], recv_ctl: Cell[u8[]], send_voice: Cell[u8[]], recv_voice: Cell[u8[]], sas: string }

// One direction of one channel: its key and its sequence state. For a voice
// receiver, `high` is the highest number seen and `seen` marks the numbers
// below it in the window. `epoch` counts the rekeys, `chain` makes the key of
// the next epoch, and a receiver keeps the key of the epoch before in `old`.
struct Way { key: u8[], next: i64, high: i64, seen: boolean[], epoch: i32, old: u8[], chain: u8[] }

// The speaker's half of a rekey: an X25519 key pair for the next epoch of
// its sending direction, used once.
pub struct Offer { epoch: i32, private: Cell[u8[]], public: u8[] }

// Copies share sequence state and keys. Use a channel from one event loop.
pub struct Channel { send_ctl: Cell[Way], recv_ctl: Cell[Way], send_voice: Cell[Way], recv_voice: Cell[Way], sas: string }

function cat(a: u8[], b: [u8]): u8[] {
  for x in b {
    a = a.append(x);
  }
  return a;
}

function text(s: string): u8[] {
  let out: u8[] = [];
  for i in 0..s.len() {
    out = out.append(s[i]);
  }
  return out;
}

function part(b: u8[], from: i32, n: i32): u8[] {
  let out: u8[] = [];
  for i in from..from + n {
    out = out.append(b[i]);
  }
  return out;
}

function commitment(public: [u8], nonce: [u8]): u8[] {
  return crypto.sha256(cat(cat(text("walkie commit"), public), nonce));
}

// The ML-KEM secret and encapsulation key of a side, from KEM_RANDOM bytes.
// The initiator makes a key pair. The responder keeps 32 bytes for its
// encapsulation.
function kem_start(initiator: boolean, own random: u8[]): (u8[], u8[]) {
  if (random.len() != KEM_RANDOM) {
    crypto.erase(random);
    return ([], []);
  }
  if (!initiator) {
    let m: u8[] = part(random, 0, 32);
    crypto.erase(random);
    return (m, []);
  }
  let result = mlkem768.keygen_derand(part(random, 0, 32), part(random, 32, 32));
  crypto.erase(random);
  match (result) {
    Ok(kp) => {
      return (kp.decapsulation_key, kp.encapsulation_key);
    },
    Err(_) => {}
  }
  return ([], []);
}

// A handshake from 32 random bytes for the X25519 private key, 16 for the
// nonce, and KEM_RANDOM for ML-KEM.
pub function start(initiator: boolean, own random_key: u8[], random_nonce: u8[], own random_kem: u8[]): Handshake {
  let public: u8[] = [];
  match (x25519.public_key(random_key)) {
    Ok(p) => {
      public = p;
    },
    Err(_) => {}
  }
  let (kem, ek) = kem_start(initiator, random_kem);
  let kem_ok: boolean = initiator && ek.len() == EK_LEN || !initiator && kem.len() == 32;
  let h = Handshake { initiator: initiator, private: cell_new(random_key), kem: cell_new(kem), phase: cell_new(FRESH), public: public, nonce: random_nonce, ek: ek, ct: [], commit: [], peer_key: [], peer_nonce: [], done: false, failed: public.len() != 32 || random_nonce.len() != 16 || !kem_ok };
  if (h.failed) {
    erase_private(h);
  }
  return h;
}

function erase_private(h: Handshake): void {
  h.phase.set(CLOSED);
  let secret = h.private.get();
  h.private.set([]);
  crypto.erase(secret);
  let kem = h.kem.get();
  h.kem.set([]);
  crypto.erase(kem);
}

// Abort also clears the key in every copy of this handshake.
pub function close_handshake(own h: Handshake): void {
  erase_private(h);
}

function refused(h: Handshake): (Handshake, u8[]) {
  erase_private(h);
  return (Handshake { ...h, failed: true }, []);
}

// The initiator's first message.
pub function first(h: Handshake): u8[] {
  if (!h.initiator || h.failed || h.done || h.phase.get() > COMMITTED || h.private.get().len() != 32) {
    return [];
  }
  h.phase.set(COMMITTED);
  return cat(cat([M_COMMIT as u8], commitment(h.public, h.nonce)), h.ek);
}

// The handshake after message `m`, and the reply to send, which is empty
// when there is none. `done` is set when the keys are ready.
pub function receive(h: Handshake, m: u8[]): (Handshake, u8[]) {
  if (h.done || h.failed || m.len() == 0 || h.private.get().len() != 32) {
    return refused(h);
  }
  let t: i32 = m[0] as i32;
  if (!h.initiator && t == M_COMMIT && m.len() == 33 + EK_LEN && h.phase.get() == FRESH) {
    return encapsulate(h, part(m, 1, 32), part(m, 33, EK_LEN));
  }
  if (h.initiator && t == M_KEY && m.len() == 49 + CT_LEN && h.phase.get() == COMMITTED) {
    return decapsulate(h, part(m, 1, 32), part(m, 33, 16), part(m, 49, CT_LEN));
  }
  if (!h.initiator && t == M_REVEAL && m.len() == 49 && h.phase.get() == COMMITTED && h.commit.len() == 32) {
    let key: u8[] = part(m, 1, 32);
    let nonce: u8[] = part(m, 33, 16);
    if (commitment(key, nonce) != h.commit) {
      return refused(h);
    }
    h.phase.set(READY);
    return (Handshake { ...h, peer_key: key, peer_nonce: nonce, done: true }, []);
  }
  return refused(h);
}

// The responder's reply to the commitment: its X25519 key, its nonce, and a
// ciphertext for the initiator's encapsulation key.
function encapsulate(h: Handshake, commit: u8[], ek: u8[]): (Handshake, u8[]) {
  let m = h.kem.get();
  h.kem.set([]);
  let result = mlkem768.encaps_derand(ek, m);
  crypto.erase(m);
  let Ok(e) = result else {
    return refused(h);
  };
  h.kem.set(e.shared_secret);
  h.phase.set(COMMITTED);
  let reply: u8[] = cat(cat(cat([M_KEY as u8], h.public), h.nonce), e.ciphertext);
  return (Handshake { ...h, commit: commit, ek: ek, ct: e.ciphertext }, reply);
}

// The initiator's reveal, after it takes the ML-KEM shared secret from the
// responder's ciphertext.
function decapsulate(h: Handshake, key: u8[], nonce: u8[], ct: u8[]): (Handshake, u8[]) {
  let dk = h.kem.get();
  h.kem.set([]);
  let result = mlkem768.decaps(dk, ct);
  crypto.erase(dk);
  let Ok(shared) = result else {
    return refused(h);
  };
  h.kem.set(shared);
  let reveal: u8[] = cat(cat([M_REVEAL as u8], h.public), h.nonce);
  h.phase.set(READY);
  return (Handshake { ...h, peer_key: key, peer_nonce: nonce, ct: ct, done: true }, reveal);
}

// The keys of a finished handshake, and its short authentication string:
// six decimal digits that both users read out.
pub function keys(h: Handshake): Option[Keys] {
  if (!h.done || h.failed || h.phase.get() != READY) {
    return None;
  }
  // Take the shared slot before derivation. No handshake copy can use it again.
  h.phase.set(CLOSED);
  let secret = h.private.get();
  h.private.set([]);
  let result = x25519.x25519(secret, h.peer_key);
  crypto.erase(secret);
  let kem = h.kem.get();
  h.kem.set([]);
  let shared: u8[] = [];
  match (result) {
    Ok(s) => {
      shared = cat(s, kem);
      crypto.erase(s);
    },
    Err(_) => {}
  }
  crypto.erase(kem);
  if (shared.len() != 64) {
    crypto.erase(shared);
    return None;
  }
  let mine: u8[] = cat(h.public, h.nonce);
  let theirs: u8[] = cat(h.peer_key, h.peer_nonce);
  let first_part: u8[] = theirs;
  let second_part: u8[] = mine;
  if (h.initiator) {
    first_part = mine;
    second_part = theirs;
  }
  let transcript: u8[] = crypto.sha256(cat(cat(cat(cat(text("walkie v2"), h.ek), h.ct), first_part), second_part));
  let prk: u8[] = crypto.hkdf_sha256_extract(transcript, shared);
  crypto.erase(shared);
  let i2r_ctl: u8[] = crypto.hkdf_sha256_expand(prk, text("i2r control"), 32);
  let r2i_ctl: u8[] = crypto.hkdf_sha256_expand(prk, text("r2i control"), 32);
  let i2r_voice: u8[] = crypto.hkdf_sha256_expand(prk, text("i2r voice"), 32);
  let r2i_voice: u8[] = crypto.hkdf_sha256_expand(prk, text("r2i voice"), 32);
  let sas_bytes: u8[] = crypto.hkdf_sha256_expand(prk, text("sas"), 4);
  crypto.erase(prk);
  let n: i64 = (sas_bytes[0] as i64 << 24 as i64 | sas_bytes[1] as i64 << 16 as i64 | sas_bytes[2] as i64 << 8 as i64 | sas_bytes[3] as i64) % (1000000 as i64);
  let sas: string = n.to_string();
  while (sas.len() < 6) {
    sas = "0" + sas;
  }
  if (h.initiator) {
    return Some(Keys { send_ctl: cell_new(i2r_ctl), recv_ctl: cell_new(r2i_ctl), send_voice: cell_new(i2r_voice), recv_voice: cell_new(r2i_voice), sas: sas });
  }
  return Some(Keys { send_ctl: cell_new(r2i_ctl), recv_ctl: cell_new(i2r_ctl), send_voice: cell_new(r2i_voice), recv_voice: cell_new(i2r_voice), sas: sas });
}

function way(own key: u8[]): Way {
  let seen: boolean[] = [];
  for k in 0..WINDOW {
    seen = seen.append(false);
  }
  // A drained or closed slot gives a way that seals and opens nothing.
  if (key.len() != 32) {
    crypto.erase(key);
    return Way { key: [], next: 0 as i64, high: 0 - 1 as i64, seen: seen, epoch: 0, old: [], chain: [] };
  }
  let first: u8[] = crypto.hkdf_sha256_expand(key, text("key"), 32);
  let chain: u8[] = crypto.hkdf_sha256_expand(key, text("chain"), 32);
  crypto.erase(key);
  return Way { key: first, next: 0 as i64, high: 0 - 1 as i64, seen: seen, epoch: 0, old: [], chain: chain };
}

function take_key(slot: Cell[u8[]]): u8[] {
  let key = slot.get();
  slot.set([]);
  return key;
}

// A key bundle creates one channel. Copies see the same drained slots.
pub function channel(k: Keys): Channel {
  let send_ctl = take_key(k.send_ctl);
  let recv_ctl = take_key(k.recv_ctl);
  let send_voice = take_key(k.send_voice);
  let recv_voice = take_key(k.recv_voice);
  return Channel { send_ctl: cell_new(way(send_ctl)), recv_ctl: cell_new(way(recv_ctl)), send_voice: cell_new(way(send_voice)), recv_voice: cell_new(way(recv_voice)), sas: k.sas };
}

// Clear a rejected key bundle, for example after a failed string comparison.
pub function close_keys(k: Keys): void {
  let send_ctl = take_key(k.send_ctl);
  let recv_ctl = take_key(k.recv_ctl);
  let send_voice = take_key(k.send_voice);
  let recv_voice = take_key(k.recv_voice);
  crypto.erase(send_ctl);
  crypto.erase(recv_ctl);
  crypto.erase(send_voice);
  crypto.erase(recv_voice);
}

// The 12-byte nonce of sequence number `seq`, and the 13 bytes that start a
// frame: the channel, the epoch of the key and the number. Those bytes are
// the associated data, so a frame cannot move to the other channel.
const HEAD: i32 = 13;

function head(kind: i32, epoch: i32, seq: i64): u8[] {
  let out: u8[] = [kind as u8, (epoch >> 24 & 255) as u8, (epoch >> 16 & 255) as u8, (epoch >> 8 & 255) as u8, (epoch & 255) as u8];
  for k in 0..8 {
    out = out.append((seq >> (56 - 8 * k) as i64 & 255 as i64) as u8);
  }
  return out;
}

function nonce(seq: i64): u8[] {
  let out: u8[] = [0 as u8, 0 as u8, 0 as u8, 0 as u8];
  for k in 0..8 {
    out = out.append((seq >> (56 - 8 * k) as i64 & 255 as i64) as u8);
  }
  return out;
}

function seal_way(w: Way, kind: i32, plain: [u8]): (Way, u8[]) {
  if (w.next < 0 as i64 || w.next == MAX_SEQUENCE) {
    return (w, []);
  }
  let h: u8[] = head(kind, w.epoch, w.next);
  match (chacha20poly1305.key(w.key)) {
    Ok(key) => {
      match (key.seal(nonce(w.next), plain, h)) {
        Ok(sealed) => {
          return (Way { ...w, next: w.next + 1 as i64 }, cat(h, sealed));
        },
        Err(_) => {}
      }
    },
    Err(_) => {}
  }
  return (w, []);
}

// The key of the epoch in the head of `frame`: the current key, or the key
// of the epoch before. Another epoch gives an empty key.
function frame_key(w: Way, frame: [u8]): u8[] {
  let epoch: i32 = frame[1] as i32 << 24 | frame[2] as i32 << 16 | frame[3] as i32 << 8 | frame[4] as i32;
  if (epoch == w.epoch) {
    return w.key;
  }
  if (epoch == w.epoch - 1) {
    return w.old;
  }
  return [];
}

// The plain bytes of `frame` on this way, without the replay check.
function open_frame(w: Way, kind: i32, frame: [u8]): Option[(i64, u8[])] {
  if (frame.len() < HEAD + 16 || frame[0] as i32 != kind) {
    return None;
  }
  let seq: i64 = 0 as i64;
  for k in 5..HEAD {
    seq = seq << 8 as i64 | frame[k] as i64;
  }
  if (seq < 0 as i64 || seq == MAX_SEQUENCE) {
    return None;
  }
  match (chacha20poly1305.key(frame_key(w, frame))) {
    Ok(key) => {
      match (key.open(nonce(seq), frame[HEAD:frame.len()], frame[0:HEAD])) {
        Ok(plain) => {
          return Some((seq, plain));
        },
        Err(_) => {}
      }
    },
    Err(_) => {}
  }
  return None;
}

pub function seal_control(c: Channel, plain: [u8]): (Channel, u8[]) {
  let (w, frame) = seal_way(c.send_ctl.get(), CTL, plain);
  c.send_ctl.set(w);
  return (c, frame);
}

pub function seal_voice(c: Channel, plain: [u8]): (Channel, u8[]) {
  let (w, frame) = seal_way(c.send_voice.get(), VOICE, plain);
  c.send_voice.set(w);
  return (c, frame);
}

// A control frame opens once inside the window, in any order.
pub function open_control(c: Channel, frame: [u8]): (Channel, Option[u8[]]) {
  let w = c.recv_ctl.get();
  match (open_frame(w, CTL, frame)) {
    Some((seq, plain)) => {
      match (accept(w, seq)) {
        Some(next) => {
          c.recv_ctl.set(next);
          return (c, Some(plain));
        },
        None => {}
      }
    },
    None => {}
  }
  return (c, None);
}

// A voice frame opens once inside the window, in any order. It gives its
// sequence number with its plaintext, so a gap shows a lost frame.
pub function open_voice(c: Channel, frame: [u8]): (Channel, Option[(i64, u8[])]) {
  let w = c.recv_voice.get();
  match (open_frame(w, VOICE, frame)) {
    Some((seq, plain)) => {
      match (accept(w, seq)) {
        Some(next) => {
          c.recv_voice.set(next);
          return (c, Some((seq, plain)));
        },
        None => {}
      }
    },
    None => {}
  }
  return (c, None);
}

// The receive state after frame `seq`, when its number is above the window,
// or in the window and not seen yet.
function accept(w: Way, seq: i64): Option[Way] {
  if (seq > w.high) {
    let seen: boolean[] = w.seen;
    let shift: i64 = seq - w.high;
    for k in 0..WINDOW {
      let from: i64 = k as i64 - shift;
      seen = seen.with(k, from >= 0 as i64 && w.seen[from as i32]);
    }
    return Some(Way { ...w, high: seq, seen: seen.with(0, true) });
  }
  let back: i64 = w.high - seq;
  if (back >= WINDOW as i64 || w.seen[back as i32]) {
    return None;
  }
  return Some(Way { ...w, seen: w.seen.with(back as i32, true) });
}

// Close clears the shared slots before erasure, so old channel copies close too.
pub function close(own c: Channel): void {
  let Channel { send_ctl: sc, recv_ctl: rc, send_voice: sv, recv_voice: rv, sas: _ } = c;
  close_way(sc);
  close_way(rc);
  close_way(sv);
  close_way(rv);
}

function close_way(state: Cell[Way]): void {
  let old = state.get();
  state.set(Way { key: [], next: 0 as i64, high: 0 - 1 as i64, seen: [], epoch: 0, old: [], chain: [] });
  erase_way(old);
}

function erase_way(own w: Way): void {
  let Way { key, next: _, high: _, seen: _, epoch: _, old, chain } = w;
  crypto.erase(key);
  crypto.erase(old);
  crypto.erase(chain);
}

// The epoch of the key that this side sends voice with, and of the key that
// it receives voice with.
pub function send_epoch(c: Channel): i32 {
  return c.send_voice.get().epoch;
}

pub function recv_epoch(c: Channel): i32 {
  return c.recv_voice.get().epoch;
}

// The speaker's offer for the next epoch of its sending direction, from 32
// random bytes.
pub function offer(c: Channel, own random: u8[]): Option[Offer] {
  let epoch: i32 = c.send_voice.get().epoch + 1;
  match (x25519.public_key(random)) {
    Ok(public) => {
      return Some(Offer { epoch: epoch, private: cell_new(random), public: public });
    },
    Err(_) => {}
  }
  crypto.erase(random);
  return None;
}

pub function close_offer(o: Offer): void {
  let secret = o.private.get();
  o.private.set([]);
  crypto.erase(secret);
}

function be32(v: i32): u8[] {
  return [(v >> 24 & 255) as u8, (v >> 16 & 255) as u8, (v >> 8 & 255) as u8, (v & 255) as u8];
}

// The chain and the key of `epoch`, from the chain before, the shared secret
// and the two public keys, the speaker's first.
function next_epoch(chain: [u8], epoch: i32, own shared: u8[], speaker: [u8], listener: [u8]): (u8[], u8[]) {
  let prk: u8[] = crypto.hkdf_sha256_extract(chain, shared);
  crypto.erase(shared);
  let info: u8[] = cat(cat(be32(epoch), speaker), listener);
  let next: u8[] = crypto.hkdf_sha256_expand(prk, cat(text("walkie rekey chain"), info), 32);
  let key: u8[] = crypto.hkdf_sha256_expand(prk, cat(text("walkie rekey key"), info), 32);
  crypto.erase(prk);
  return (next, key);
}

// The way with the key of a new epoch. A receiving way keeps the key of the
// epoch before for the frames in flight. The older keys and the old chain
// are erased.
function rekeyed(own w: Way, epoch: i32, own chain: u8[], own key: u8[], keep: boolean): Way {
  let Way { key: last, next, high, seen, epoch: _, old, chain: spent } = w;
  crypto.erase(old);
  crypto.erase(spent);
  let before: u8[] = [];
  if (keep) {
    before = last;
  } else {
    crypto.erase(last);
  }
  return Way { key: key, next: next, high: high, seen: seen, epoch: epoch, old: before, chain: chain };
}

// The listener's answer to the offer of `epoch` from `speaker`, from 32
// random bytes: the channel with the new receive key, and this side's public
// key to send back. An offer for another epoch gives no key.
pub function accept_offer(c: Channel, epoch: i32, speaker: [u8], own random: u8[]): (Channel, u8[]) {
  let w = c.recv_voice.get();
  if (epoch != w.epoch + 1) {
    crypto.erase(random);
    return (c, []);
  }
  let public: u8[] = [];
  if let Ok(p) = x25519.public_key(random) {
    public = p;
  }
  let result = x25519.x25519(random, speaker);
  crypto.erase(random);
  let Ok(shared) = result else {
    return (c, []);
  };
  let (chain, key) = next_epoch(w.chain, epoch, shared, speaker, public);
  c.recv_voice.set(rekeyed(w, epoch, chain, key, true));
  return (c, public);
}

// The speaker's side after the accept of `epoch` from `listener`: the
// channel with the new send key. The offer is used up either way.
pub function complete_offer(c: Channel, o: Offer, epoch: i32, listener: [u8]): Channel {
  let secret = o.private.get();
  o.private.set([]);
  let w = c.send_voice.get();
  if (epoch != o.epoch || epoch != w.epoch + 1) {
    crypto.erase(secret);
    return c;
  }
  let result = x25519.x25519(secret, listener);
  crypto.erase(secret);
  let Ok(shared) = result else {
    return c;
  };
  let (chain, key) = next_epoch(w.chain, epoch, shared, o.public, listener);
  c.send_voice.set(rekeyed(w, epoch, chain, key, false));
  return c;
}
