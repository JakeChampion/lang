// A device can give or take audio at another rate than the voice codec, so
// a linear resampler converts each direction.

// A streaming linear resampler. The next output is at `pos / to` input
// samples into the input that comes next, where -1 is `prev`, the last input
// sample before it. Whole numbers keep the place exact across blocks.
pub struct Resampler { from: i64, to: i64, pos: i64, prev: i32 }

pub function resampler(from_rate: i32, to_rate: i32): Resampler {
  return Resampler { from: from_rate as i64, to: to_rate as i64, pos: 0i64, prev: 0 };
}

// The output samples for the input samples `x`, and the resampler for the
// input that follows them.
pub function resample(r: Resampler, x: [i32]): (Resampler, i32[]) {
  let n = x.len();
  let out: i32[] = [];
  if (n == 0) {
    return (r, out);
  }
  let pos = r.pos;
  let limit = (n as i64 - 1i64) * r.to;
  while (pos < limit) {
    let i = ((pos + r.to) / r.to - 1i64) as i32;
    let frac = pos - i as i64 * r.to;
    let a = r.prev;
    if (i >= 0) {
      a = x[i];
    }
    let b = x[i + 1];
    out = out.append(a + (((b - a) as i64 * frac * 2i64 + r.to) / (2i64 * r.to)) as i32);
    pos += r.from;
  }
  return (Resampler { ...r, pos: pos - n as i64 * r.to, prev: x[n - 1] }, out);
}

// The samples of `queue` after the first `written`, which the speaker did
// not take yet. When more than `max` are left, the oldest ones go, so the
// delay of the voice stays short.
pub function unplayed(queue: [i32], written: i32, max: i32): i32[] {
  let from = written;
  if (from < 0) {
    from = 0;
  }
  if (queue.len() - from > max) {
    from = queue.len() - max;
  }
  let out: i32[] = [];
  for k in from..queue.len() {
    out = out.append(queue[k]);
  }
  return out;
}

// The gain of the microphone, in steps of 1/256. A phone that is not at the
// mouth gives quiet speech, so the gain raises speech to TARGET_PEAK, up to
// MAX_GAIN times. It does not rise on noise below NOISE_PEAK, and it falls at
// once so that a loud word is not clipped.
pub const GAIN_ONE: i32 = 256;

pub const MAX_GAIN: i32 = 2048;

pub const TARGET_PEAK: i32 = 16000;

pub const NOISE_PEAK: i32 = 600;

// `env` follows the peaks of the input: it rises at once and falls by an
// eighth of the difference on each block.
pub struct Agc { gain: i32, env: i32 }

pub function agc(): Agc {
  return Agc { gain: GAIN_ONE, env: 0 };
}

function peak_of(x: [i32]): i32 {
  let peak = 0;
  for v in x {
    if (v > peak) {
      peak = v;
    } else if (-v > peak) {
      peak = -v;
    }
  }
  return peak;
}

// The gain that brings the envelope `env` to TARGET_PEAK, from `gain`.
function next_gain(gain: i32, env: i32): i32 {
  if (env < NOISE_PEAK) {
    return gain;
  }
  let want = TARGET_PEAK * GAIN_ONE / env;
  if (want > MAX_GAIN) {
    want = MAX_GAIN;
  } else if (want < GAIN_ONE) {
    want = GAIN_ONE;
  }
  if (want <= gain) {
    return want;
  }
  return gain + (want - gain) / 8 + 1;
}

// The samples `x` at the gain of `a`, and the gain for the next block.
pub function amplify(a: Agc, x: [i32]): (Agc, i32[]) {
  let peak = peak_of(x);
  let env = a.env - (a.env - peak) / 8;
  if (peak > a.env) {
    env = peak;
  }
  let gain = next_gain(a.gain, env);
  if (peak > 0 && peak * gain > 32767 * GAIN_ONE) {
    gain = 32767 * GAIN_ONE / peak;
  }
  let out: i32[] = [];
  for v in x {
    out = out.append(v * gain / GAIN_ONE);
  }
  return (Agc { gain: gain, env: env }, out);
}
