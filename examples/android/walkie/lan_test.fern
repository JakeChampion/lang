import "std/crypto";
import "std/test";
import "./lan";
import "./secure";

function bytes(seed: string, n: i32): u8[] {
  let h = crypto.sha256(seed.as_bytes());
  let out: u8[] = [];
  for k in 0..n {
    out = out.append(h[k % 32]);
  }
  return out;
}

function packet(b: u8[]): lan.Packet {
  match (lan.decode(b, b.len())) {
    Some(p) => {
      return p;
    },
    None => {}
  }
  return lan.Packet { kind: 0, from: 0i64, body: [] };
}

function heard_name(h: lan.Heard): string {
  match (h) {
    lan.Nothing => {
      return "nothing";
    },
    lan.Found(id) => {
      return "found " + id.to_string();
    },
    lan.Verify(sas) => {
      return "verify";
    },
    lan.Failed => {
      return "failed";
    },
    lan.Frame(kind, _) => {
      return "frame " + kind.to_string();
    },
    lan.Identity(_) => {
      return "identity";
    }
  }
  return "";
}

function test_packet_round_trip(): test.TestOutcome {
  let b = lan.encode(lan.VOICE, 72623859790382856i64, [9u8, 8u8]);
  let p = packet(b);
  return test.assert_eq(p.kind.to_string() + " " + p.from.to_string() + " " + p.body.len().to_string() + " " + b.len().to_string(), "4 72623859790382856 2 12");
}

function test_short_or_foreign_datagrams_are_refused(): test.TestOutcome {
  let short = lan.decode([247u8, 1u8, 0u8], 3).is_some();
  let foreign = lan.decode([1u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8], 10).is_some();
  return test.assert_eq(short.to_string() + " " + foreign.to_string(), "false false");
}

// Two phones find each other by beacon, run the exchange, and show the same
// string. The smaller ID starts the exchange.
function test_two_phones_pair(): test.TestOutcome {
  let a = lan.new(5i64);
  let b = lan.new(9i64);
  let (a1, beacons) = lan.beacon(a, 0i64);
  let found = lan.heard(b, packet(beacons[0]), 0i64);
  if (heard_name(found.heard) != "found 5") {
    return test.fail("b heard " + heard_name(found.heard));
  }
  let (b1, hello) = lan.pair(found.link, 5i64, 0i64, bytes("b key", 32), bytes("b nonce", 16), bytes("b kem", secure.KEM_RANDOM));
  let back = lan.heard(a1, packet(lan.encode(lan.BEACON, 9i64, [])), 0i64);
  let (a2, commit) = lan.pair(back.link, 9i64, 0i64, bytes("a key", 32), bytes("a nonce", 16), bytes("a kem", secure.KEM_RANDOM));
  let s1 = lan.heard(b1, packet(commit[0]), 1i64);
  let s2 = lan.heard(a2, packet(s1.out[0]), 2i64);
  let s3 = lan.heard(s1.link, packet(s2.out[0]), 3i64);
  let names = packet(hello[0]).kind.to_string() + " " + heard_name(s2.heard) + " " + heard_name(s3.heard);
  return test.assert_eq(names + " " + (s2.link.sas == s3.link.sas && s2.link.sas.len() == 6).to_string() + " " + lan.initiator(s2.link).to_string(), "1 verify verify true true");
}

// The phone that starts the exchange hears no broadcasts. The other phone
// hears its beacon and sends its own beacon to it directly, again until the
// exchange starts, so the two still pair.
function test_pair_when_one_phone_hears_no_broadcast(): test.TestOutcome {
  let (a, beacons) = lan.beacon(lan.new(5i64), 0i64);
  let found = lan.heard(lan.new(9i64), packet(beacons[0]), 0i64);
  let (b, hello) = lan.pair(found.link, 5i64, 0i64, bytes("b key", 32), bytes("b nonce", 16), bytes("b kem", secure.KEM_RANDOM));
  // The first direct beacon is lost too, and b sends it again.
  let (b1, again) = lan.resend(b, 600i64);
  if (again.len() != 1 || again[0] != hello[0]) {
    return test.fail("b did not send its beacon again");
  }
  let s0 = lan.heard(a, packet(again[0]), 601i64);
  if (heard_name(s0.heard) != "found 9") {
    return test.fail("a heard " + heard_name(s0.heard));
  }
  let (a1, commit) = lan.pair(s0.link, 9i64, 601i64, bytes("a key", 32), bytes("a nonce", 16), bytes("a kem", secure.KEM_RANDOM));
  let s1 = lan.heard(b1, packet(commit[0]), 602i64);
  let s2 = lan.heard(a1, packet(s1.out[0]), 603i64);
  let s3 = lan.heard(s1.link, packet(s2.out[0]), 604i64);
  let (b2, quiet) = lan.resend(s3.link, 2000i64);
  return test.assert_eq(heard_name(s2.heard) + " " + heard_name(s3.heard) + " " + (s2.link.sas == s3.link.sas).to_string() + " " + quiet.len().to_string(), "verify verify true 0");
}

// A lost answer makes the peer send its message again, and a copy of a
// message gets the same answer, so the exchange still finishes.
function test_lost_messages_are_sent_again(): test.TestOutcome {
  let (a, commit) = lan.pair(lan.new(5i64), 9i64, 0i64, bytes("a key", 32), bytes("a nonce", 16), bytes("a kem", secure.KEM_RANDOM));
  let (b, hello) = lan.pair(lan.new(9i64), 5i64, 0i64, bytes("b key", 32), bytes("b nonce", 16), bytes("b kem", secure.KEM_RANDOM));
  let s1 = lan.heard(b, packet(commit[0]), 1i64);
  // The KEY answer is lost. a sends COMMIT again after RESEND_MS.
  let (a1, again) = lan.resend(a, 600i64);
  let s2 = lan.heard(s1.link, packet(again[0]), 601i64);
  if (s2.out.len() != 1 || s2.out[0] != s1.out[0]) {
    return test.fail("the copy of COMMIT did not get the same KEY");
  }
  let s3 = lan.heard(a1, packet(s2.out[0]), 602i64);
  // The REVEAL is lost too. b sends KEY again, and a answers it again.
  let (b1, key_again) = lan.resend(s2.link, 1200i64);
  let s4 = lan.heard(s3.link, packet(key_again[0]), 1201i64);
  let s5 = lan.heard(b1, packet(s4.out[0]), 1202i64);
  return test.assert_eq(heard_name(s3.heard) + " " + heard_name(s5.heard) + " " + (s3.link.sas == s5.link.sas).to_string(), "verify verify true");
}

// After the users confirm, frames of the peer reach the app, and frames of a
// third phone do not.
function test_frames_after_confirmation(): test.TestOutcome {
  let (a, commit) = lan.pair(lan.new(5i64), 9i64, 0i64, bytes("a key", 32), bytes("a nonce", 16), bytes("a kem", secure.KEM_RANDOM));
  let (b, hello) = lan.pair(lan.new(9i64), 5i64, 0i64, bytes("b key", 32), bytes("b nonce", 16), bytes("b kem", secure.KEM_RANDOM));
  let s1 = lan.heard(b, packet(commit[0]), 1i64);
  let s2 = lan.heard(a, packet(s1.out[0]), 2i64);
  let s3 = lan.heard(s1.link, packet(s2.out[0]), 3i64);
  let early = lan.heard(s2.link, packet(lan.encode(lan.VOICE, 9i64, [1u8])), 4i64);
  let (a1, ca) = lan.confirm(s2.link);
  let (b1, cb) = lan.confirm(s3.link);
  let (ca1, frame) = match (ca) {
    Some(c) => secure.seal_voice(c, [1u8, 2u8]),
    None => (secure.channel(secure.Keys { send_ctl: cell_new([]), recv_ctl: cell_new([]), send_voice: cell_new([]), recv_voice: cell_new([]), sas: "", binding: [], send_id: cell_new([]), recv_id: cell_new([]) }), []),
  };
  let got = lan.heard(b1, packet(lan.encode(lan.VOICE, 5i64, frame)), 5i64);
  let stranger = lan.heard(b1, packet(lan.encode(lan.VOICE, 7i64, frame)), 6i64);
  return test.assert_eq(heard_name(early.heard) + " " + heard_name(got.heard) + " " + heard_name(stranger.heard), "nothing frame 4 nothing");
}

// A rejected string closes the link and its keys.
function test_rejected_string_closes(): test.TestOutcome {
  let (a, commit) = lan.pair(lan.new(5i64), 9i64, 0i64, bytes("a key", 32), bytes("a nonce", 16), bytes("a kem", secure.KEM_RANDOM));
  let (b, hello) = lan.pair(lan.new(9i64), 5i64, 0i64, bytes("b key", 32), bytes("b nonce", 16), bytes("b kem", secure.KEM_RANDOM));
  let s1 = lan.heard(b, packet(commit[0]), 1i64);
  let s2 = lan.heard(a, packet(s1.out[0]), 2i64);
  let closed = lan.close(s2.link);
  let (c, chan) = lan.confirm(closed);
  return test.assert_eq(chan.is_some().to_string(), "false");
}

function main(): i32 {
  let r = test.new("walkie lan");
  r = r.it("a packet round-trips", test_packet_round_trip);
  r = r.it("short or foreign datagrams are refused", test_short_or_foreign_datagrams_are_refused);
  r = r.it("two phones pair", test_two_phones_pair);
  r = r.it("two phones pair when one hears no broadcast", test_pair_when_one_phone_hears_no_broadcast);
  r = r.it("lost messages are sent again", test_lost_messages_are_sent_again);
  r = r.it("frames pass after confirmation", test_frames_after_confirmation);
  r = r.it("a rejected string closes the link", test_rejected_string_closes);
  return r.finish();
}
