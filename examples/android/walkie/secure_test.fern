import "std/crypto";
import "std/crypto/chacha20poly1305";
import "std/crypto/ed25519";
import "std/test";
import "./secure";

// Fixed random bytes for a repeatable test.
function bytes(seed: string, n: i32): u8[] {
  let h = crypto.sha256(seed.as_bytes());
  let out: u8[] = [];
  for k in 0..n {
    out = out.append(h[k % 32]);
  }
  return out;
}

function party(initiator: boolean, name: string): secure.Handshake {
  return secure.start(initiator, bytes(name + " key", 32), bytes(name + " nonce", 16), bytes(name + " kem", secure.KEM_RANDOM));
}

// A full handshake between `a` (the initiator) and `b`.
function pair(a: secure.Handshake, b: secure.Handshake): (secure.Handshake, secure.Handshake) {
  let (b1, key_msg) = secure.receive(b, secure.first(a));
  let (a1, reveal) = secure.receive(a, key_msg);
  let (b2, none) = secure.receive(b1, reveal);
  return (a1, b2);
}

function channels(a: secure.Handshake, b: secure.Handshake): (secure.Channel, secure.Channel) {
  let (ha, hb) = pair(a, b);
  match (secure.keys(ha)) {
    Some(ka) => {
      match (secure.keys(hb)) {
        Some(kb) => {
          return (secure.channel(ka), secure.channel(kb));
        },
        None => {}
      }
    },
    None => {}
  }
  return (secure.channel(secure.Keys { send_ctl: cell_new([]), recv_ctl: cell_new([]), send_voice: cell_new([]), recv_voice: cell_new([]), sas: "", binding: [], send_id: cell_new([]), recv_id: cell_new([]) }), secure.channel(secure.Keys { send_ctl: cell_new([]), recv_ctl: cell_new([]), send_voice: cell_new([]), recv_voice: cell_new([]), sas: "x", binding: [], send_id: cell_new([]), recv_id: cell_new([]) }));
}

// The text and the sequence number of an opened voice frame.
function voiced(o: Option[(i64, u8[])]): string {
  match (o) {
    Some((seq, b)) => {
      return "ok:" + string_from_bytes_unchecked(b) + "@" + seq.to_string();
    },
    None => {
      return "refused";
    }
  }
}

function opened(o: Option[u8[]]): string {
  match (o) {
    Some(b) => {
      return "ok:" + string_from_bytes_unchecked(b);
    },
    None => {
      return "refused";
    }
  }
}

function test_handshake_agrees(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let (a1, f1) = secure.seal_control(a, "hello".as_bytes());
  let (b1, got) = secure.open_control(b, f1);
  let (b2, f2) = secure.seal_control(b1, "back".as_bytes());
  let (a2, back) = secure.open_control(a1, f2);
  return test.assert_eq(opened(got) + " " + opened(back) + " " + (a.sas == b.sas && a.sas.len() == 6).to_string(), "ok:hello ok:back true");
}

// A third party in the middle makes one handshake with each side. The two
// sides then show different authentication strings.
function test_man_in_the_middle_shows_different_strings(): test.TestOutcome {
  let (a, m1) = channels(party(true, "alice"), party(false, "mallory one"));
  let (m2, b) = channels(party(true, "mallory two"), party(false, "bob"));
  return test.assert_eq((a.sas == b.sas).to_string(), "false");
}

// A reveal that does not match the commitment is ignored, so a third party
// cannot end the exchange with one. The right reveal still finishes it.
function test_reveal_must_match_commitment(): test.TestOutcome {
  let a = party(true, "alice");
  let (b1, key_msg) = secure.receive(party(false, "bob"), secure.first(a));
  let other = party(true, "mallory");
  let other_commit = secure.first(other);
  let (other1, reveal) = secure.receive(other, key_msg);
  let (b2, none) = secure.receive(b1, reveal);
  let (a1, right) = secure.receive(a, key_msg);
  let (b3, _) = secure.receive(b2, right);
  let same = sas_of(a1) == sas_of(b3);
  secure.close_handshake(other1);
  return test.assert_eq(b2.failed.to_string() + " " + b2.done.to_string() + " " + none.len().to_string() + " " + b3.done.to_string() + " " + same.to_string(), "false false 0 true true");
}

// The string of a finished handshake, or "" when it gives no keys.
function sas_of(h: secure.Handshake): string {
  if let Some(k) = secure.keys(h) {
    let s = k.sas;
    secure.close_keys(k);
    return s;
  }
  return "";
}

// The three messages carry the ML-KEM-768 encapsulation key and ciphertext.
function test_hybrid_message_sizes(): test.TestOutcome {
  let a = party(true, "alice");
  let commit = secure.first(a);
  let (b1, key_msg) = secure.receive(party(false, "bob"), commit);
  let (a1, reveal) = secure.receive(a, key_msg);
  secure.close_handshake(a1);
  secure.close_handshake(b1);
  return test.assert_eq(commit.len().to_string() + " " + key_msg.len().to_string() + " " + reveal.len().to_string(), "1217 1137 49");
}

// A party in the middle changes one byte of the ML-KEM ciphertext. The
// initiator gets another shared secret, so the strings differ.
function test_changed_ciphertext_changes_the_string(): test.TestOutcome {
  let a = party(true, "alice");
  let (b1, key_msg) = secure.receive(party(false, "bob"), secure.first(a));
  let bad = key_msg.with(100, key_msg[100] ^ 1 as u8);
  let (a1, reveal) = secure.receive(a, bad);
  let (b2, none) = secure.receive(b1, reveal);
  let sa = sas_of(a1);
  let sb = sas_of(b2);
  return test.assert_eq((sa.len() == 6 && sb.len() == 6 && sa != sb).to_string(), "true");
}

// A party in the middle puts its own encapsulation key in the first
// message. The responder encapsulates to that key, so the strings differ.
function test_swapped_encapsulation_key_changes_the_string(): test.TestOutcome {
  let a = party(true, "alice");
  let mallory = party(true, "mallory");
  let commit = secure.first(a);
  let theirs = secure.first(mallory);
  let swapped: u8[] = [];
  for k in 0..commit.len() {
    let b = commit[k];
    if (k >= 33) {
      b = theirs[k];
    }
    swapped = swapped.append(b);
  }
  let (b1, key_msg) = secure.receive(party(false, "bob"), swapped);
  let (a1, reveal) = secure.receive(a, key_msg);
  let (b2, none) = secure.receive(b1, reveal);
  secure.close_handshake(mallory);
  let sa = sas_of(a1);
  let sb = sas_of(b2);
  return test.assert_eq((sa.len() == 6 && sb.len() == 6 && sa != sb).to_string(), "true");
}

// The ML-KEM secrets leave the handshake: after the keys, and after a failure.
function test_kem_secrets_are_erased(): test.TestOutcome {
  let (a, b) = pair(party(true, "alice"), party(false, "bob"));
  let ka = a;
  let kb = b;
  let sa = sas_of(a);
  let sb = sas_of(b);
  let c = party(false, "carol");
  let old = c;
  secure.close_handshake(c);
  return test.assert_eq(ka.kem.get().len().to_string() + " " + kb.kem.get().len().to_string() + " " + old.kem.get().len().to_string() + " " + (sa == sb).to_string(), "0 0 0 true");
}

// The ML-KEM part needs all of its random bytes.
function test_kem_random_is_required(): test.TestOutcome {
  let a = secure.start(true, bytes("key", 32), bytes("nonce", 16), bytes("kem", 32));
  let b = secure.start(false, bytes("key", 32), bytes("nonce", 16), []);
  return test.assert_eq(a.failed.to_string() + " " + b.failed.to_string() + " " + a.private.get().len().to_string(), "true true 0");
}

function test_changed_frame_is_refused(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let (a1, f) = secure.seal_control(a, "push".as_bytes());
  let bad = f.with(f.len() - 1, f[f.len() - 1] ^ 1 as u8);
  let (b1, got) = secure.open_control(b, bad);
  return test.assert_eq(opened(got), "refused");
}

// A control frame opens in any order, and after a lost one. A copy of a
// frame is refused.
function test_control_replay_is_refused_and_order_is_free(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let (a1, f1) = secure.seal_control(a, "one".as_bytes());
  let (a2, f2) = secure.seal_control(a1, "two".as_bytes());
  let (a3, f3) = secure.seal_control(a2, "three".as_bytes());
  let (a4, f4) = secure.seal_control(a3, "four".as_bytes());
  let (b1, second) = secure.open_control(b, f2);
  let (b2, first) = secure.open_control(b1, f1);
  let (b3, again) = secure.open_control(b2, f2);
  let (b4, fourth) = secure.open_control(b3, f4);
  return test.assert_eq(opened(second) + " " + opened(first) + " " + opened(again) + " " + opened(fourth), "ok:two ok:one refused ok:four");
}

function test_voice_window(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let frames: u8[][] = [];
  for k in 0..100 {
    let (next, f) = secure.seal_voice(a, ("v" + k.to_string()).as_bytes());
    a = next;
    frames = frames.append(f);
  }
  let out = "";
  let order: i32[] = [5, 3, 4, 3, 90, 30, 26, 89, 5];
  for i in order {
    let (next, got) = secure.open_voice(b, frames[i]);
    b = next;
    out = out + voiced(got) + " ";
  }
  return test.assert_eq(out, "ok:v5@5 ok:v3@3 ok:v4@4 refused ok:v90@90 ok:v30@30 refused ok:v89@89 refused ");
}

function test_channels_are_separate(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let (a1, ctl) = secure.seal_control(a, "floor".as_bytes());
  let (b1, as_voice) = secure.open_voice(b, ctl);
  let (a2, voice) = secure.seal_voice(a1, "audio".as_bytes());
  let (b2, as_ctl) = secure.open_control(b1, voice);
  return test.assert_eq(voiced(as_voice) + " " + opened(as_ctl), "refused refused");
}

// Acceptance test G: a third phone with its own handshake can neither read
// the voice of the pair nor put a frame into it.
function test_third_party_cannot_read_or_inject(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let (x, y) = channels(party(true, "eve"), party(false, "eve two"));
  let (a1, voice) = secure.seal_voice(a, "secret".as_bytes());
  let (y1, read) = secure.open_voice(y, voice);
  let (x1, forged) = secure.seal_voice(x, "inject".as_bytes());
  let (b1, injected) = secure.open_voice(b, forged);
  return test.assert_eq(voiced(read) + " " + voiced(injected), "refused refused");
}

// A message out of order is ignored, and the exchange goes on.
function test_wrong_order_handshake_is_ignored(): test.TestOutcome {
  let a = party(true, "alice");
  let b = party(false, "bob");
  let (b1, reply) = secure.receive(b, [18 as u8]);
  let (b2, key_msg) = secure.receive(b1, secure.first(a));
  secure.close_handshake(a);
  secure.close_handshake(b2);
  return test.assert_eq(b1.failed.to_string() + " " + reply.len().to_string() + " " + (key_msg.len() > 0).to_string(), "false 0 true");
}

function test_close_consumes_the_channel(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let sas = a.sas;
  secure.close(a);
  secure.close(b);
  return test.assert_eq(sas.len(), 6);
}

function test_sender_aliases_share_the_sequence(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let old = a;
  let (a1, one) = secure.seal_control(a, "one".as_bytes());
  let (a2, two) = secure.seal_control(old, "two".as_bytes());
  let (b1, first) = secure.open_control(b, one);
  let (b2, second) = secure.open_control(b1, two);
  secure.close(a2);
  secure.close(b2);
  return test.assert_eq(opened(first) + " " + opened(second), "ok:one ok:two");
}

function test_receiver_aliases_cannot_replay_a_frame(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let old = b;
  let (a1, voice) = secure.seal_voice(a, "voice".as_bytes());
  let (b1, first) = secure.open_voice(b, voice);
  let (b2, again) = secure.open_voice(old, voice);
  secure.close(a1);
  secure.close(b2);
  return test.assert_eq(voiced(first) + " " + voiced(again), "ok:voice@0 refused");
}

function test_close_invalidates_channel_aliases(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let old = a;
  let (b1, voice) = secure.seal_control(b, "voice".as_bytes());
  secure.close(a);
  let (a1, outgoing) = secure.seal_control(old, "late".as_bytes());
  let (a2, incoming) = secure.open_control(a1, voice);
  secure.close(a2);
  secure.close(b1);
  return test.assert_eq(outgoing.len().to_string() + " " + opened(incoming), "0 refused");
}

function test_ephemeral_key_is_used_once(): test.TestOutcome {
  let (a, b) = pair(party(true, "alice"), party(false, "bob"));
  let first = false;
  let second = false;
  match (secure.keys(a)) {
    Some(k) => {
      first = true;
      secure.close(secure.channel(k));
    },
    None => {}
  }
  match (secure.keys(a)) {
    Some(k) => {
      second = true;
      secure.close(secure.channel(k));
    },
    None => {}
  }
  secure.close_handshake(b);
  return test.assert_eq(first.to_string() + " " + second.to_string(), "true false");
}

function test_cancelled_handshake_clears_aliases(): test.TestOutcome {
  let a = party(true, "alice");
  let old = a;
  secure.close_handshake(a);
  let (stopped, _) = secure.receive(old, [17 as u8]);
  return test.assert_eq(old.private.get().len().to_string() + " " + stopped.failed.to_string(), "0 true");
}

function test_invalid_nonce_does_not_keep_a_private_key(): test.TestOutcome {
  let a = secure.start(true, bytes("key", 32), [], bytes("kem", secure.KEM_RANDOM));
  return test.assert_eq(a.failed.to_string() + " " + a.private.get().len().to_string(), "true 0");
}

function test_key_bundle_creates_one_channel(): test.TestOutcome {
  let (a, b) = pair(party(true, "alice"), party(false, "bob"));
  let sizes = "missing";
  match (secure.keys(a)) {
    Some(k) => {
      let first = secure.channel(k);
      let second = secure.channel(k);
      let (c1, good) = secure.seal_control(first, "one".as_bytes());
      let (c2, refused) = secure.seal_control(second, "two".as_bytes());
      sizes = (good.len() > 0).to_string() + " " + refused.len().to_string();
      secure.close(c1);
      secure.close(c2);
    },
    None => {}
  }
  secure.close_handshake(b);
  return test.assert_eq(sizes, "true 0");
}

function reject_aliased_keys(k: secure.Keys): i32 {
  let old = k;
  secure.close_keys(k);
  let c = secure.channel(old);
  let (next, frame) = secure.seal_voice(c, "late".as_bytes());
  let size = frame.len();
  secure.close(next);
  return size;
}

function test_rejected_key_bundle_clears_aliases(): test.TestOutcome {
  let (a, b) = pair(party(true, "alice"), party(false, "bob"));
  let size = -1;
  match (secure.keys(a)) {
    Some(k) => {
      size = reject_aliased_keys(k);
    },
    None => {}
  }
  secure.close_handshake(b);
  return test.assert_eq(size, 0);
}

// A voice frame of epoch 0 with sequence number `seq`, sealed by hand.
function voice_at(c: secure.Channel, seq: i64): u8[] {
  let head: u8[] = [secure.VOICE as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let nonce: u8[] = [0 as u8, 0 as u8, 0 as u8, 0 as u8];
  for k in 0..8 {
    let byte = (seq >> (56 - 8 * k) as i64 & 255 as i64) as u8;
    head = head.append(byte);
    nonce = nonce.append(byte);
  }
  match (chacha20poly1305.key(c.send_voice.get().key)) {
    Ok(key) => {
      match (key.seal(nonce, "boundary".as_bytes(), head)) {
        Ok(sealed) => {
          for byte in sealed {
            head = head.append(byte);
          }
          return head;
        },
        Err(_) => {}
      }
    },
    Err(_) => {}
  }
  return [];
}

function test_sequence_boundaries_do_not_change_the_window(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let (b0, inside) = secure.open_voice(b, voice_at(a, 5 as i64));
  if (voiced(inside) != "ok:boundary@5") {
    return test.fail("a hand-sealed frame inside the range did not open: " + voiced(inside));
  }
  let refused = 0;
  for seq in [-1i64, 9223372036854775807i64] {
    let frame = voice_at(a, seq);
    let (_, got) = secure.open_voice(b, frame);
    if (frame.len() >= 25 && voiced(got) == "refused") {
      refused += 1;
    }
  }
  let (a1, good) = secure.seal_voice(a, "ok".as_bytes());
  let (b1, got) = secure.open_voice(b, good);
  secure.close(a1);
  secure.close(b1);
  return test.assert_eq(refused.to_string() + " " + voiced(got), "2 ok:ok@0");
}

// One rekey of the direction from `speaker` to `listener`: the offer, the
// accept and the completion.
function rekey(speaker: secure.Channel, listener: secure.Channel, seed: string): (secure.Channel, secure.Channel) {
  let Some(o) = secure.offer(speaker, bytes(seed + " speaker", 32)) else {
    return (speaker, listener);
  };
  let (l1, public) = secure.accept_offer(listener, o.epoch, o.public, bytes(seed + " listener", 32));
  let s1 = secure.complete_offer(speaker, o, o.epoch, public);
  return (s1, l1);
}

// A rekey moves both sides to epoch 1. A frame that was in flight under the
// key of epoch 0 still opens, and a frame two epochs old does not.
function test_rekey_moves_the_voice_key(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let (a1, early) = secure.seal_voice(a, "early".as_bytes());
  let (a2, b1) = rekey(a1, b, "one");
  let (a3, late) = secure.seal_voice(a2, "late".as_bytes());
  let (b2, got_late) = secure.open_voice(b1, late);
  let (b3, got_early) = secure.open_voice(b2, early);
  let (a4, b4) = rekey(a3, b3, "two");
  let (a5, last) = secure.seal_voice(a4, "last".as_bytes());
  let (b5, got_last) = secure.open_voice(b4, last);
  let (b6, stale) = secure.open_voice(b5, early);
  let epochs = secure.send_epoch(a5).to_string() + "/" + secure.recv_epoch(b6).to_string();
  return test.assert_eq(epochs + " " + voiced(got_late) + " " + voiced(got_early) + " " + voiced(got_last) + " " + voiced(stale), "2/2 ok:late@1 ok:early@0 ok:last@2 refused");
}

// An offer for another epoch, and a low-order public key, change nothing.
function test_rekey_refuses_a_wrong_offer(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let Some(o) = secure.offer(a, bytes("speaker", 32)) else {
    return test.fail("no offer");
  };
  let (b1, skipped) = secure.accept_offer(b, o.epoch + 1, o.public, bytes("listener", 32));
  let zero: u8[] = [];
  for k in 0..32 {
    zero = zero.append(0 as u8);
  }
  let (b2, low) = secure.accept_offer(b1, o.epoch, zero, bytes("listener", 32));
  secure.close_offer(o);
  return test.assert_eq(skipped.len().to_string() + " " + low.len().to_string() + " " + secure.recv_epoch(b2).to_string(), "0 0 0");
}

// An offer is used once: its private key is gone after the completion.
function test_offer_is_used_once(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let Some(o) = secure.offer(a, bytes("speaker", 32)) else {
    return test.fail("no offer");
  };
  let (b1, public) = secure.accept_offer(b, o.epoch, o.public, bytes("listener", 32));
  let a1 = secure.complete_offer(a, o, o.epoch, public);
  let a2 = secure.complete_offer(a1, o, o.epoch, public);
  return test.assert_eq(o.private.get().len().to_string() + " " + secure.send_epoch(a2).to_string(), "0 1");
}

// The two directions rekey on their own, also at the same time.
function test_directions_rekey_on_their_own(): test.TestOutcome {
  let (a, b) = channels(party(true, "alice"), party(false, "bob"));
  let Some(oa) = secure.offer(a, bytes("a speaker", 32)) else {
    return test.fail("no offer");
  };
  let Some(ob) = secure.offer(b, bytes("b speaker", 32)) else {
    return test.fail("no offer");
  };
  let (b1, pb) = secure.accept_offer(b, oa.epoch, oa.public, bytes("b listener", 32));
  let (a1, pa) = secure.accept_offer(a, ob.epoch, ob.public, bytes("a listener", 32));
  let a2 = secure.complete_offer(a1, oa, oa.epoch, pb);
  let b2 = secure.complete_offer(b1, ob, ob.epoch, pa);
  let (a3, to_b) = secure.seal_voice(a2, "to b".as_bytes());
  let (b3, to_a) = secure.seal_voice(b2, "to a".as_bytes());
  let (b4, got_b) = secure.open_voice(b3, to_b);
  let (a4, got_a) = secure.open_voice(a3, to_a);
  return test.assert_eq(voiced(got_b) + " " + voiced(got_a), "ok:to b@0 ok:to a@0");
}

function id_key(name: string): Option[ed25519.PrivateKey] {
  if let Ok(k) = ed25519.private_key(bytes(name + " identity", 32)) {
    return Some(k);
  }
  return None;
}

// The key bundles of a finished handshake between `a` and `b`.
function bundles(a: string, b: string): Option[(secure.Keys, secure.Keys)] {
  let (ha, hb) = pair(party(true, a), party(false, b));
  let Some(ka) = secure.keys(ha) else {
    return None;
  };
  let Some(kb) = secure.keys(hb) else {
    return None;
  };
  return Some((ka, kb));
}

function shown(p: Option[u8[]], want: u8[]): string {
  if let Some(x) = p {
    return (x == want).to_string();
  }
  return "refused";
}

// A proof of identity opens on the other side, with the key, and not on
// the side that sent it.
function test_identity_proof_opens(): test.TestOutcome {
  let Some((ka, kb)) = bundles("alice", "bob") else {
    return test.fail("no keys");
  };
  let Some(ida) = id_key("alice") else {
    return test.fail("no identity");
  };
  let there = secure.check_proof(kb, secure.prove(ka, ida));
  let back = secure.check_proof(ka, secure.prove(ka, ida));
  return test.assert_eq(shown(there, ida.public_point()) + " " + shown(back, ida.public_point()), "true refused");
}

// A proof is good for its exchange alone: a party in the middle cannot pass
// it on to another exchange, and a changed byte or kind does not open.
function test_identity_proof_is_bound_to_its_exchange(): test.TestOutcome {
  let Some((ka, kb)) = bundles("alice", "bob") else {
    return test.fail("no keys");
  };
  let Some((km, kc)) = bundles("mallory", "carol") else {
    return test.fail("no keys");
  };
  let Some(ida) = id_key("alice") else {
    return test.fail("no identity");
  };
  let proof = secure.prove(ka, ida);
  let moved = secure.check_proof(kc, proof);
  let changed = secure.check_proof(kb, proof.with(20, proof[20] ^ 1 as u8));
  let kind = secure.check_proof(kb, proof.with(0, secure.TAG));
  return test.assert_eq(shown(moved, ida.public_point()) + " " + shown(changed, ida.public_point()) + " " + shown(kind, ida.public_point()), "refused refused refused");
}

// A tag names the identity only to a phone that knows the key. It does not
// carry the key, and it does not open in another exchange.
function test_identity_tag_needs_the_key(): test.TestOutcome {
  let Some((ka, kb)) = bundles("alice", "bob") else {
    return test.fail("no keys");
  };
  let Some((km, kc)) = bundles("mallory", "carol") else {
    return test.fail("no keys");
  };
  let Some(ida) = id_key("alice") else {
    return test.fail("no identity");
  };
  let Some(idb) = id_key("bob") else {
    return test.fail("no identity");
  };
  let tag = secure.announce(ka, ida);
  let known = secure.recognize(kb, tag, [idb.public_point(), ida.public_point()]);
  let strange = secure.recognize(kb, tag, [idb.public_point()]);
  let moved = secure.recognize(kc, tag, [ida.public_point()]);
  let not_proof = secure.check_proof(kb, tag);
  return test.assert_eq(shown(known, ida.public_point()) + " " + shown(strange, ida.public_point()) + " " + shown(moved, ida.public_point()) + " " + shown(not_proof, ida.public_point()), "true refused refused refused");
}

// The identity on the channel is signed for the exchange of the channel.
function test_pin_message_is_bound_to_its_channel(): test.TestOutcome {
  let Some((ka, kb)) = bundles("alice", "bob") else {
    return test.fail("no keys");
  };
  let Some((km, kc)) = bundles("mallory", "carol") else {
    return test.fail("no keys");
  };
  let Some(ida) = id_key("alice") else {
    return test.fail("no identity");
  };
  let Some(idm) = id_key("mallory") else {
    return test.fail("no identity");
  };
  let ca = secure.channel(ka);
  let cb = secure.channel(kb);
  let cc = secure.channel(kc);
  let (public, signature) = secure.pin_message(ca, ida);
  let (_, other) = secure.pin_message(ca, idm);
  let got = secure.check_pin(cb, public, signature).to_string() + " " + secure.check_pin(cc, public, signature).to_string() + " " + secure.check_pin(cb, public, other).to_string();
  secure.close(ca);
  secure.close(cb);
  secure.close(cc);
  secure.close_keys(km);
  return test.assert_eq(got, "true false false");
}

function test_initiator_must_commit_before_a_key_reply(): test.TestOutcome {
  let a = party(true, "alice");
  let other = party(true, "other");
  let (b, key_msg) = secure.receive(party(false, "bob"), secure.first(other));
  let (early, reply) = secure.receive(a, key_msg);
  secure.close_handshake(other);
  secure.close_handshake(b);
  return test.assert_eq(early.failed.to_string() + " " + early.done.to_string() + " " + reply.len().to_string(), "false false 0");
}

function test_handshake_aliases_cannot_reuse_a_key_reply(): test.TestOutcome {
  let a = party(true, "alice");
  let old = a;
  let (b, key_msg) = secure.receive(party(false, "bob"), secure.first(a));
  let (ready, _) = secure.receive(a, key_msg);
  let (again, reply) = secure.receive(old, key_msg);
  let twice = secure.keys(again).is_some();
  let derived = false;
  match (secure.keys(ready)) {
    Some(k) => {
      derived = true;
      secure.close(secure.channel(k));
    },
    None => {}
  }
  secure.close_handshake(b);
  return test.assert_eq(reply.len().to_string() + " " + twice.to_string() + " " + derived.to_string(), "0 false true");
}

// A commitment with a key that ML-KEM refuses is ignored, and the real
// commitment that follows still gets a reply.
function test_bad_encapsulation_key_is_ignored(): test.TestOutcome {
  let a = party(true, "alice");
  let real = secure.first(a);
  let bad: u8[] = [real[0]];
  for k in 1..real.len() {
    bad = bad.append(255 as u8);
  }
  let (b1, none) = secure.receive(party(false, "bob"), bad);
  let (b2, reply) = secure.receive(b1, real);
  secure.close_handshake(a);
  secure.close_handshake(b2);
  return test.assert_eq(b1.failed.to_string() + " " + none.len().to_string() + " " + (reply.len() > 0).to_string(), "false 0 true");
}

function main(): i32 {
  let r = test.new("walkie secure channel");
  r = r.it("the handshake agrees on keys and on the string", test_handshake_agrees);
  r = r.it("a party in the middle shows different strings", test_man_in_the_middle_shows_different_strings);
  r = r.it("the reveal must match the commitment", test_reveal_must_match_commitment);
  r = r.it("the messages carry the ML-KEM key and ciphertext", test_hybrid_message_sizes);
  r = r.it("a changed ML-KEM ciphertext changes the string", test_changed_ciphertext_changes_the_string);
  r = r.it("a swapped encapsulation key changes the string", test_swapped_encapsulation_key_changes_the_string);
  r = r.it("the ML-KEM secrets are erased", test_kem_secrets_are_erased);
  r = r.it("the ML-KEM part needs its random bytes", test_kem_random_is_required);
  r = r.it("a rekey moves the voice key", test_rekey_moves_the_voice_key);
  r = r.it("a rekey refuses a wrong offer", test_rekey_refuses_a_wrong_offer);
  r = r.it("an offer is used once", test_offer_is_used_once);
  r = r.it("the two directions rekey on their own", test_directions_rekey_on_their_own);
  r = r.it("a proof of identity opens on the other side", test_identity_proof_opens);
  r = r.it("a proof of identity is bound to its exchange", test_identity_proof_is_bound_to_its_exchange);
  r = r.it("a tag names the identity only to a phone that knows it", test_identity_tag_needs_the_key);
  r = r.it("the identity on the channel is bound to the channel", test_pin_message_is_bound_to_its_channel);
  r = r.it("a changed frame is refused", test_changed_frame_is_refused);
  r = r.it("a control frame opens once, in any order", test_control_replay_is_refused_and_order_is_free);
  r = r.it("voice frames open once inside the window", test_voice_window);
  r = r.it("a frame of one channel does not open on the other", test_channels_are_separate);
  r = r.it("a third party cannot read or inject", test_third_party_cannot_read_or_inject);
  r = r.it("a handshake message out of order is ignored", test_wrong_order_handshake_is_ignored);
  r = r.it("a commitment with a bad ML-KEM key is ignored", test_bad_encapsulation_key_is_ignored);
  r = r.it("close takes the channel and its keys", test_close_consumes_the_channel);
  r = r.it("sender aliases share the sequence", test_sender_aliases_share_the_sequence);
  r = r.it("receiver aliases cannot replay a frame", test_receiver_aliases_cannot_replay_a_frame);
  r = r.it("close invalidates channel aliases", test_close_invalidates_channel_aliases);
  r = r.it("the ephemeral key is used once", test_ephemeral_key_is_used_once);
  r = r.it("a cancelled handshake clears aliases", test_cancelled_handshake_clears_aliases);
  r = r.it("an invalid nonce keeps no private key", test_invalid_nonce_does_not_keep_a_private_key);
  r = r.it("a key bundle creates one channel", test_key_bundle_creates_one_channel);
  r = r.it("a rejected key bundle clears aliases", test_rejected_key_bundle_clears_aliases);
  r = r.it("sequence boundaries leave the replay window intact", test_sequence_boundaries_do_not_change_the_window);
  r = r.it("a key reply before the commitment is ignored", test_initiator_must_commit_before_a_key_reply);
  r = r.it("handshake aliases cannot reuse a key reply", test_handshake_aliases_cannot_reuse_a_key_reply);
  return r.finish();
}
