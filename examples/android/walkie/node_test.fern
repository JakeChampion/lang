// Two walkie-talkie nodes on a simulated network, with a clock that steps
// 10 ms at a time. The network drops a part of the datagrams and delays each
// by a random time, so some arrive out of order. A script of cues confirms the
// string and presses and releases the talk buttons.
import "std/net";
import "std/test";
import "./lan";
import "./node";
import "./secure";
import "./session";

const STEP_MS: i64 = 10i64;

// Microphone samples in one step at the wire rate of 16 kHz.
const STEP_SAMPLES: i32 = 160;

const CONFIRM: i32 = 1;

const PRESS: i32 = 2;

const RELEASE: i32 = 3;

// A datagram on its way to node `to`, which arrives at `at`.
struct Flight { at: i64, to: i32, data: u8[] }

// The network: `loss` datagrams in a thousand are dropped, and each takes
// `delay` ms and up to `jitter` ms more.
struct Network { loss: i64, delay: i64, jitter: i64 }

// User action `what` on node `who` at time `at`. A user confirms the string
// at `at` or, when it is not on the screen yet, when it shows.
struct Cue { at: i64, who: i32, what: i32 }

struct Sim {
  nodes: node.Node[],
  flights: Flight[],
  rng: i64,
  now: i64,
  // The voice frames that each node played.
  heard: i32[],
  // The notice of each node when its session ended, or "".
  lost: string[],
  // Both nodes transmitted at the same time.
  overlap: boolean,
}

function addr(i: i32): net.SocketAddr {
  return net.socket_addr(net.V4([10u8, 0u8, 0u8, (i + 1) as u8]), 47120);
}

function next(r: i64): i64 {
  return (r * 1103515245i64 + 12345i64) % 2147483648i64;
}

// The samples of one step of a tone, as a microphone gives them.
function tone(): i32[] {
  let out: i32[] = [];
  for k in 0..STEP_SAMPLES {
    out = out.append((k % 32 - 16) * 1000);
  }
  return out;
}

// The datagrams of node `from` on their way to the other node.
function send(s: Sim, from: i32, nw: Network): Sim {
  let rng = s.rng;
  let flights = s.flights;
  for d in s.nodes[from].out {
    rng = next(rng);
    if (rng % 1000i64 >= nw.loss) {
      rng = next(rng);
      let at = s.now + nw.delay + rng % (nw.jitter + 1i64);
      flights = flights.append(Flight { at: at, to: 1 - from, data: d.data });
    }
  }
  return Sim { ...s, rng: rng, flights: flights };
}

function deliver(s: Sim): Sim {
  let nodes = s.nodes;
  let left: Flight[] = [];
  for f in s.flights {
    if (f.at <= s.now) {
      nodes = nodes.with(f.to, node.receive(nodes[f.to], f.data, f.data.len(), addr(1 - f.to), s.now));
    } else {
      left = left.append(f);
    }
  }
  return Sim { ...s, nodes: nodes, flights: left };
}

function cue(n: node.Node, what: i32, now: i64): node.Node {
  if (what == CONFIRM) {
    return node.confirm(n, now);
  }
  if (what == PRESS) {
    return node.press(n, now);
  }
  return node.release(n, now);
}

function shows_code(n: node.Node): boolean {
  match (n.link.phase) {
    lan.Verifying => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function ended_notice(n: node.Node): string {
  match (n.sess.state) {
    session.Reconnecting => {
      return n.notice;
    },
    session.Failed => {
      return n.notice;
    },
    _ => {
      return "";
    }
  }
}

// Runs nodes 5 and 9 on the network until `end` ms, with the cues.
function run(nw: Network, cues: Cue[], end: i64): Sim {
  return run_nodes([node.new(5i64, seed(1), 0i64), node.new(9i64, seed(2), 0i64)], nw, cues, end);
}

function run_nodes(start: node.Node[], nw: Network, cues: Cue[], end: i64): Sim {
  let s = Sim { nodes: start, flights: [], rng: 12345i64, now: 0i64, heard: [0, 0], lost: ["", ""], overlap: false };
  let voice = tone();
  let done: boolean[] = [];
  for c in cues {
    done = done.append(false);
  }
  while (s.now <= end) {
    s = deliver(s);
    let nodes = s.nodes;
    for k in 0..cues.len() {
      let c = cues[k];
      if (!done[k] && c.at <= s.now && (c.what != CONFIRM || shows_code(nodes[c.who]))) {
        nodes = nodes.with(c.who, cue(nodes[c.who], c.what, s.now));
        done = done.with(k, true);
      }
    }
    for i in 0..2 {
      nodes = nodes.with(i, node.voice(node.tick(node.fresh(nodes[i], entropy(i, s.now)), s.now), voice));
    }
    s = Sim { ...s, nodes: nodes };
    for i in 0..2 {
      s = send(s, i, nw);
      let n = s.nodes[i];
      let heard = s.heard.with(i, s.heard[i] + n.heard.len());
      let lost = s.lost;
      if (lost[i] == "") {
        lost = lost.with(i, ended_notice(n));
      }
      s = Sim { ...s, nodes: s.nodes.with(i, node.drained(n)), heard: heard, lost: lost };
    }
    if (session.transmitting(s.nodes[0].sess) && session.transmitting(s.nodes[1].sess)) {
      s = Sim { ...s, overlap: true };
    }
    s = Sim { ...s, now: s.now + STEP_MS };
  }
  return s;
}

// The random bytes of node `k` for the tick at `now`, different each time.
function entropy(k: i32, now: i64): u8[] {
  let out: u8[] = [];
  let v = now * 2654435761i64 + (k as i64 + 1i64) * 40503i64;
  for i in 0..node.RANDOM_BYTES {
    v = v * 6364136223846793005i64 + 1442695040888963407i64;
    out = out.append((v >> 33i64 & 255i64) as u8);
  }
  return out;
}

function seed(k: i32): u8[] {
  let out: u8[] = [];
  for i in 0..node.SEED_BYTES {
    out = out.append(((i * 7 + k * 31) % 256) as u8);
  }
  return out;
}

// The send and receive epochs of the voice keys of `n`, as "send/receive".
function epochs(n: node.Node): string {
  if let Some(c) = n.chan {
    return secure.send_epoch(c).to_string() + "/" + secure.recv_epoch(c).to_string();
  }
  return "none";
}

function summary(s: Sim, end: i64): string {
  let a = s.nodes[0];
  let b = s.nodes[1];
  return "lost [" + s.lost[0] + "] [" + s.lost[1] + "], heard " + s.heard[0].to_string() + " " + s.heard[1].to_string() + ", overlap " + s.overlap.to_string() + ", buttons " + node.button(a, end) + " / " + node.button(b, end) + ", codes " + a.link.sas + " " + b.link.sas + ", epochs " + epochs(a) + " " + epochs(b);
}

// Node 5 confirms at 3 s, and node 9 confirms 8 s later. Node 5, the floor
// controller, talks for 10 s and again for 5 s. Node 9 talks for 5 s between
// them. Then both are silent for a minute.
function talk_script(): Cue[] {
  return [Cue { at: 3000i64, who: 0, what: CONFIRM }, Cue { at: 11000i64, who: 1, what: CONFIRM }, Cue { at: 13000i64, who: 0, what: PRESS }, Cue { at: 23000i64, who: 0, what: RELEASE }, Cue { at: 26000i64, who: 1, what: PRESS }, Cue { at: 31000i64, who: 1, what: RELEASE }, Cue { at: 34000i64, who: 0, what: PRESS }, Cue { at: 39000i64, who: 0, what: RELEASE }];
}

// The two nodes stay connected through the script. Each hears at least
// `min_a` and `min_b` frames of the 750 and 250 that the other sends. Each
// transmission has its own voice key: node 5 talks twice and node 9 once.
function check_talk(nw: Network, min_heard_by_b: i32, min_heard_by_a: i32): test.TestOutcome {
  return check_session(run(nw, talk_script(), 100000i64), 100000i64, min_heard_by_b, min_heard_by_a);
}

function check_session(s: Sim, end: i64, min_heard_by_b: i32, min_heard_by_a: i32): test.TestOutcome {
  let a = s.nodes[0];
  let b = s.nodes[1];
  let ok = s.lost[0] == "" && s.lost[1] == "" && !s.overlap && session.connected(a.sess) && session.connected(b.sess) && a.link.sas.len() == 6 && a.link.sas == b.link.sas && s.heard[1] >= min_heard_by_b && s.heard[0] >= min_heard_by_a && s.heard[1] <= 750 && s.heard[0] <= 250 && node.button(a, end) == "HOLD TO TALK" && node.button(b, end) == "HOLD TO TALK" && epochs(a) == "2/1" && epochs(b) == "1/2";
  if (!ok) {
    return test.fail(summary(s, end));
  }
  return test.pass();
}

// A 32-byte identity seed of phone `k`, and the public key that it gives.
function id_seed(k: i32): u8[] {
  let out: u8[] = [];
  for i in 0..32 {
    out = out.append(((i * 11 + k * 53) % 256) as u8);
  }
  return out;
}

function key_of(k: i32): u8[] {
  return node.identity_key(node.with_identity(node.new(1i64, seed(9), 0i64), id_seed(k), []));
}

// Nodes 5 and 9 with identities 1 and 2, which know the phones in `pins_a`
// and `pins_b`.
function phones(pins_a: u8[][], pins_b: u8[][]): node.Node[] {
  return [node.with_identity(node.new(5i64, seed(1), 0i64), id_seed(1), pins_a), node.with_identity(node.new(9i64, seed(2), 0i64), id_seed(2), pins_b)];
}

// The talk script with no user who confirms the string.
function presses(): Cue[] {
  let out: Cue[] = [];
  for c in talk_script() {
    if (c.what != CONFIRM) {
      out = out.append(c);
    }
  }
  return out;
}

// Two phones that know each other need no string: they connect, talk and
// rekey with no user who confirms.
function test_known_phones_need_no_string(): test.TestOutcome {
  let s = run_nodes(phones([key_of(2)], [key_of(1)]), Network { loss: 50i64, delay: 5i64, jitter: 20i64 }, presses(), 100000i64);
  return check_session(s, 100000i64, 700, 230);
}

// Two new phones show the string. After the users confirm it, each phone
// knows the other.
function test_new_phones_learn_each_other(): test.TestOutcome {
  let s = run_nodes(phones([], []), Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, talk_script(), 100000i64);
  let a = s.nodes[0];
  let b = s.nodes[1];
  let learned = a.pins.len() == 1 && a.pins[0] == key_of(2) && b.pins.len() == 1 && b.pins[0] == key_of(1);
  return test.assert_eq(learned.to_string() + " " + session.connected(a.sess).to_string() + " " + session.connected(b.sess).to_string(), "true true true");
}

// When only one phone knows the other, both still show the string.
function test_one_known_side_shows_the_string(): test.TestOutcome {
  let s = run_nodes(phones([key_of(2)], []), Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, presses(), 20000i64);
  return test.assert_eq(shows_code(s.nodes[0]).to_string() + " " + shows_code(s.nodes[1]).to_string(), "true true");
}

function test_clean_network(): test.TestOutcome {
  return check_talk(Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, 740, 240);
}

function test_five_percent_loss_and_reordering(): test.TestOutcome {
  return check_talk(Network { loss: 50i64, delay: 5i64, jitter: 40i64 }, 650, 200);
}

function test_twenty_percent_loss(): test.TestOutcome {
  return check_talk(Network { loss: 200i64, delay: 20i64, jitter: 60i64 }, 520, 100);
}

// A press before the other phone confirms does not start a transmission.
function test_press_before_the_peer_confirms(): test.TestOutcome {
  let cues: Cue[] = [Cue { at: 3000i64, who: 0, what: CONFIRM }, Cue { at: 4000i64, who: 0, what: PRESS }];
  let s = run(Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, cues, 6000i64);
  let a = s.nodes[0];
  return test.assert_eq(session.transmitting(a.sess).to_string() + " " + s.heard[1].to_string() + " " + a.notice, "false 0 wait for the other phone to confirm the code");
}

// When the other phone never confirms, the session ends with a reason.
function test_peer_that_never_confirms(): test.TestOutcome {
  let cues: Cue[] = [Cue { at: 3000i64, who: 0, what: CONFIRM }];
  let s = run(Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, cues, 3000i64 + session.CONFIRM_TIMEOUT_MS as i64 + 1000i64);
  return test.assert_eq(s.lost[0], "the other phone did not confirm the code");
}

// A node that hears one beacon and then nothing more stops its key exchange
// after PAIR_TIMEOUT_MS, so that it does not wait for the peer forever.
function test_a_peer_that_goes_silent_while_pairing(): test.TestOutcome {
  let beacon = lan.encode(lan.BEACON, 9i64, []);
  let n = node.receive(node.new(5i64, seed(1), 0i64), beacon, beacon.len(), addr(1), 0i64);
  let pairing = n.link.phase;
  let t = n;
  let now = 0i64;
  while (now <= lan.PAIR_TIMEOUT_MS) {
    now += 10i64;
    t = node.tick(node.drained(t), now);
  }
  let started = match (pairing) {
    lan.Pairing => true,
    _ => false,
  };
  return test.assert_eq(started.to_string() + " " + node.reconnecting(t).to_string() + " " + node.ended(t).to_string(), "true true true");
}

// A third party on the network reads the node ID of a beacon and sends
// handshake datagrams in its name: from its own address, and from the
// address of the peer. The pairing goes on, and both phones show the code.
function test_spoofed_handshake_does_not_end_pairing(): test.TestOutcome {
  let a = node.tick(node.new(5i64, seed(1), 0i64), 0i64);
  let b = node.new(9i64, seed(2), 0i64);
  for d in a.out {
    b = node.receive(b, d.data, d.data.len(), addr(0), 10i64);
  }
  a = node.drained(a);
  let forged = lan.encode(lan.HANDSHAKE, 5i64, [16u8]);
  let elsewhere = net.socket_addr(net.V4([10u8, 0u8, 0u8, 66u8]), 47120);
  b = node.receive(b, forged, forged.len(), elsewhere, 20i64);
  b = node.receive(b, forged, forged.len(), addr(0), 30i64);
  let after = node.status(b);
  let s = run_nodes([a, b], Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, [], 3000i64);
  return test.assert_eq(after + " / " + shows_code(s.nodes[0]).to_string() + " " + shows_code(s.nodes[1]).to_string(), "found a phone: making keys / true true");
}

// A phone that knows two phones connects with no code to the one that is
// there. Its status names that phone, so its user can see which one it is.
function test_known_phone_shows_its_name(): test.TestOutcome {
  let start = [node.with_identity(node.new(5i64, seed(1), 0i64), id_seed(1), [key_of(2), key_of(3)]), node.with_identity(node.new(9i64, seed(2), 0i64), id_seed(3), [key_of(1)])];
  let s = run_nodes(start, Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, [], 5000i64);
  let a = s.nodes[0];
  return test.assert_eq(node.status(a) + " " + (node.label(key_of(3)) != node.label(key_of(2))).to_string(), "connected to " + node.label(key_of(3)) + " true");
}

// A stranger with no key of this phone gets its tag and nothing more: no
// proof, so it does not learn the identity of this phone.
function test_stranger_gets_no_proof(): test.TestOutcome {
  let s = run_nodes(phones([key_of(2)], []), Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, [], 5000i64);
  return test.assert_eq(s.nodes[0].ident.len().to_string() + " " + s.nodes[1].ident.len().to_string() + " " + s.nodes[1].peer_identity.len().to_string(), "2 1 0");
}

// A phone that forgets its known phones shows the string again.
function test_forgotten_phone_shows_the_string(): test.TestOutcome {
  let p = phones([key_of(2)], [key_of(1)]);
  let s = run_nodes([node.forget(p[0]), p[1]], Network { loss: 0i64, delay: 5i64, jitter: 0i64 }, [], 5000i64);
  return test.assert_eq(shows_code(s.nodes[0]).to_string() + " " + shows_code(s.nodes[1]).to_string(), "true true");
}

function main(): i32 {
  let r = test.new("walkie nodes");
  r = r.it("two nodes talk on a clean network", test_clean_network);
  r = r.it("two phones that know each other need no string", test_known_phones_need_no_string);
  r = r.it("two new phones learn each other after the string", test_new_phones_learn_each_other);
  r = r.it("one known side still shows the string", test_one_known_side_shows_the_string);
  r = r.it("a known phone shows its name", test_known_phone_shows_its_name);
  r = r.it("a stranger gets no proof of identity", test_stranger_gets_no_proof);
  r = r.it("a forgotten phone shows the string again", test_forgotten_phone_shows_the_string);
  r = r.it("two nodes talk with 5% loss and reordering", test_five_percent_loss_and_reordering);
  r = r.it("two nodes talk with 20% loss", test_twenty_percent_loss);
  r = r.it("a press before the peer confirms waits", test_press_before_the_peer_confirms);
  r = r.it("a peer that never confirms ends the session", test_peer_that_never_confirms);
  r = r.it("a peer that goes silent while pairing ends the search", test_a_peer_that_goes_silent_while_pairing);
  r = r.it("a spoofed handshake does not end the pairing", test_spoofed_handshake_does_not_end_pairing);
  return r.finish();
}
