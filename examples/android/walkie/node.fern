// One walkie-talkie phone without its Android parts: the LAN link, the key
// exchange, the session and the voice frames. The app gives it datagrams,
// touches, microphone samples and the time. It does what the node asks: it
// sends the datagrams in `out`, plays the frames in `heard`, and runs the
// microphone while `capture` is true. A host test runs two nodes on a
// simulated network.
import "std/crypto";
import "std/crypto/ed25519";
import "std/net";
import "std/opus/celt_encoder";
import "./lan";
import "./protocol";
import "./secure";
import "./session";
import "./voice";

// A datagram to send: to the broadcast address on each walkie port, or to
// the peer.
pub struct Datagram { broadcast: boolean, data: u8[] }

pub struct Node {
  link: lan.Link,
  peer_addr: net.SocketAddr,
  chan: Option[secure.Channel],
  sess: session.Session,
  // Random bytes for the key exchange: 32 for the key, then 16 for the nonce.
  seed: u8[],
  capture: boolean,
  // Microphone samples at `voice.RATE` that do not fill a frame yet.
  pending: i32[],
  enc: celt_encoder.Encoder,
  rx: voice.Receiver,
  notice: string,
  heard_at: i64,
  // Fresh random bytes from the app for the rekeys, which the copies of the
  // node share, and the rekey of this side's voice: due at the next tick,
  // or offered and not accepted yet.
  random: Cell[u8[]],
  rekey_due: boolean,
  offer: Option[secure.Offer],
  offer_at: i64,
  // The last accept that this side sent, for an offer that comes again.
  accepted: i32,
  accepted_key: u8[],
  // This phone's identity, and the identities of the phones that a user
  // confirmed before. Until the peer confirms, this side sends the frames
  // of `ident` again at `ident_at`: the tag of its identity, and its proof
  // once it knows the peer. `peer_identity` is the identity that the peer
  // proved, or that it sent after the users confirmed the string.
  identity: Option[ed25519.PrivateKey],
  pins: u8[][],
  ident: u8[][],
  ident_at: i64,
  peer_identity: u8[],
  // The user confirmed the string of this session. Then the two phones send
  // their identities on the channel, at `pin_at`, until each one knows that
  // the other has its identity.
  confirmed: boolean,
  pinning: boolean,
  peer_has_mine: boolean,
  pin_at: i64,
  // The outputs since the app last took them.
  out: Datagram[],
  heard: i32[][],
  logs: string[],
}

pub const SEED_BYTES: i32 = 48 + secure.KEM_RANDOM;

// The random bytes that the app gives with `fresh` before each tick: enough
// for one offer and one accept.
pub const RANDOM_BYTES: i32 = 64;

// A node with ID `me`, which sends Opus voice frames.
pub function new(me: i64, own seed: u8[], now: i64): Node {
  let (s1, _) = session.step(session.new(), session.Start(session.Offline), now);
  return Node { link: lan.new(me), peer_addr: net.socket_addr(net.V4([0u8, 0u8, 0u8, 0u8]), 0), chan: None, sess: s1, seed: seed, capture: false, pending: [], enc: voice.encoder(), rx: voice.receiver(), notice: "", heard_at: 0i64, random: cell_new([]), rekey_due: false, offer: None, offer_at: 0i64, accepted: 0, accepted_key: [], identity: None, pins: [], ident: [], ident_at: 0i64, peer_identity: [], confirmed: false, pinning: false, peer_has_mine: false, pin_at: 0i64, out: [], heard: [], logs: [] };
}

// The node with this phone's identity, from a 32-byte seed, and the
// identities of the phones that a user confirmed before.
pub function with_identity(n: Node, seed: [u8], pins: u8[][]): Node {
  match (ed25519.private_key(seed)) {
    Ok(k) => {
      return Node { ...n, identity: Some(k), pins: pins };
    },
    Err(_) => {}
  }
  return Node { ...n, pins: pins };
}

// The public key of this phone's identity, or empty.
pub function identity_key(n: Node): u8[] {
  if let Some(k) = n.identity {
    return k.public_point();
  }
  return [];
}

// The short name of the phone with the identity `public`, which the screen
// shows: "phone" and four digits.
pub function label(public: [u8]): string {
  if (public.len() == 0) {
    return "";
  }
  let h = crypto.sha256(public);
  let v = ((h[0] as i32 << 8 | h[1] as i32) % 10000).to_string();
  while (v.len() < 4) {
    v = "0" + v;
  }
  return "phone " + v;
}

// The node with no known phones.
pub function forget(n: Node): Node {
  return Node { ...n, pins: [] };
}

function knows(n: Node, identity: u8[]): boolean {
  for p in n.pins {
    if (p == identity) {
      return true;
    }
  }
  return false;
}

// The node with its outputs taken.
pub function drained(n: Node): Node {
  return Node { ...n, out: [], heard: [], logs: [] };
}

pub function close(own n: Node): void {
  match (n.chan) {
    Some(c) => {
      secure.close(c);
    },
    None => {}
  }
  if let Some(o) = n.offer {
    secure.close_offer(o);
  }
  let pool = n.random.get();
  n.random.set([]);
  crypto.erase(pool);
  let closed = lan.close(n.link);
}

// The session ended, or the key exchange did: a tap starts a new node.
pub function ended(n: Node): boolean {
  match (n.link.phase) {
    lan.Closed => {
      return true;
    },
    _ => {}
  }
  match (n.sess.state) {
    session.Failed => {
      return true;
    },
    session.Reconnecting => {
      return true;
    },
    session.Idle => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// The node with an ID for `role`, while it searches. The role decides which
// phone is the floor controller of the next session.
pub function with_role(n: Node, role: i32, random: i64): Node {
  if let lan.Searching = n.link.phase {
    return Node { ...n, link: lan.new(lan.role_id(role, random)) };
  }
  return n;
}

// The node in a room of the server, while it searches. The phone that made
// the room leads, and the session joins the room.
pub function in_room(n: Node, lead: boolean, random: i64, now: i64): Node {
  let lan.Searching = n.link.phase else {
    return n;
  };
  let role = lan.ROLE_FOLLOW;
  if (lead) {
    role = lan.ROLE_LEAD;
  }
  let (s1, _) = session.step(session.new(), session.Start(session.Internet), now);
  return Node { ...with_role(n, role, random), sess: s1 };
}

// The control stream to the peer closed.
pub function transport_lost(n: Node, now: i64): Node {
  return act(n, session.TransportLost, now);
}

// The transport was lost, and the peer did not leave.
pub function reconnecting(n: Node): boolean {
  if let session.Reconnecting = n.sess.state {
    return true;
  }
  return false;
}

// A new node with ID `me` for a new key exchange with the same peer, after
// the transport was lost. It keeps this phone's identity and the phones that
// it knows, so two phones that know each other compare no string again. It
// sends no voice until the new session is up.
pub function resume(own n: Node, me: i64, own seed: u8[], now: i64): Node {
  let identity = n.identity;
  let pins = n.pins;
  let notice = "reconnecting: " + n.notice;
  close(n);
  return Node { ...new(me, seed, now), identity: identity, pins: pins, notice: notice };
}

// The `len` bytes of `b` from index `at`.
function part(b: [u8], at: i32, len: i32): u8[] {
  let out: u8[] = [];
  for k in at..at + len {
    out = out.append(b[k]);
  }
  return out;
}

function log(n: Node, line: string): Node {
  return Node { ...n, logs: n.logs.append(line) };
}

function to_peer(n: Node, data: u8[][]): Node {
  let out = n.out;
  for d in data {
    out = out.append(Datagram { broadcast: false, data: d });
  }
  return Node { ...n, out: out };
}

// The datagram in the first `len` bytes of `data`, from `from`. After the
// node finds its peer, it takes datagrams only from the peer's address.
pub function receive(n: Node, data: [u8], len: i32, from: net.SocketAddr, now: i64): Node {
  if (!searching(n) && !from.eq(n.peer_addr)) {
    return n;
  }
  match (lan.decode(data, len)) {
    Some(p) => {
      return packet(n, p, from, now);
    },
    None => {}
  }
  return n;
}

function searching(n: Node): boolean {
  if let lan.Searching = n.link.phase {
    return true;
  }
  return false;
}

function packet(n: Node, p: lan.Packet, from: net.SocketAddr, now: i64): Node {
  let st = lan.heard(n.link, p, now);
  let t = to_peer(Node { ...n, link: st.link }, st.out);
  match (st.heard) {
    lan.Found(peer) => {
      let u = log(t, "found peer " + peer.to_string() + " at " + from.to_string());
      let (l, out) = lan.pair(u.link, peer, now, part(u.seed, 0, 32), part(u.seed, 32, 16), part(u.seed, 48, secure.KEM_RANDOM));
      return to_peer(act(Node { ...u, link: l, peer_addr: from, seed: [] }, session.PeerFound, now), out);
    },
    lan.Verify(sas) => {
      let me = 2;
      let id = t.link.peer;
      if (lan.initiator(t.link)) {
        me = 1;
        id = t.link.me;
      }
      let u = act(log(t, "keys are ready"), session.TransportUp(lan.initiator(t.link), me, 3 - me, id), now);
      return announced(u, now);
    },
    lan.Failed => {
      return act(log(t, "the key exchange failed"), session.AuthFailed, now);
    },
    lan.Identity(body) => {
      return identified(t, body, now);
    },
    lan.Frame(kind, body) => {
      return frame(t, kind, body, now);
    },
    lan.Nothing => {}
  }
  return t;
}

function frame(n: Node, kind: i32, body: u8[], now: i64): Node {
  match (n.chan) {
    Some(c) => {
      if (kind == lan.CONTROL) {
        let (c1, plain) = secure.open_control(c, body);
        let t = Node { ...n, chan: Some(c1) };
        match (plain) {
          Some(b) => {
            match (protocol.decode(b)) {
              Some(protocol.KeyOffer(epoch, public)) => {
                return offered(t, epoch, public);
              },
              Some(protocol.KeyAccept(epoch, public)) => {
                return accepted(t, epoch, public);
              },
              Some(protocol.Identity(public, signature, flags)) => {
                return pinned(t, public, signature, flags, now);
              },
              Some(m) => {
                return act(t, session.Received(m), now);
              },
              None => {}
            }
          },
          None => {}
        }
        return t;
      }
      let (c2, voice) = secure.open_voice(c, body);
      let t2 = Node { ...n, chan: Some(c2) };
      match (voice) {
        Some((seq, b)) => {
          return played(t2, seq, b, now);
        },
        None => {}
      }
      return t2;
    },
    None => {}
  }
  return n;
}

// The node with the frames of voice packet `b`, with sequence number `seq`,
// in `heard`. The log says when the voice of the peer starts again.
function played(n: Node, seq: i64, b: [u8], now: i64): Node {
  let t = n;
  if (now - n.heard_at > 1000i64) {
    t = log(n, "hearing the peer");
  }
  let (rx, frames) = voice.receive(voice.Receiver { ...t.rx }, seq, b);
  let heard = t.heard;
  for f in frames {
    heard = heard.append(f);
  }
  return Node { ...t, rx: rx, heard: heard, heard_at: now };
}

// One session event and its actions. The log gets each change of state,
// and the confirmation of the peer.
function act(n: Node, e: session.Event, now: i64): Node {
  let (s, acts) = session.step(n.sess, e, now);
  let t = Node { ...n, sess: s };
  let was = session.state_name(n.sess.state);
  let next = session.state_name(s.state);
  if (next != was) {
    t = log(t, "state " + next);
  }
  if (s.peer_ready && !n.sess.peer_ready) {
    t = log(t, "the other phone confirmed");
  }
  for a in acts {
    t = action(t, a);
  }
  return t;
}

function action(n: Node, a: session.Action): Node {
  match (a) {
    session.Send(m) => {
      return send_frame(n, lan.CONTROL, protocol.encode(m));
    },
    session.Capture(on) => {
      return Node { ...n, capture: on, pending: [], rekey_due: n.rekey_due || on };
    },
    session.Notice(text) => {
      return log(Node { ...n, notice: text }, text);
    }
  }
  return n;
}

// A sealed control or voice frame to the peer.
function send_frame(n: Node, kind: i32, plain: u8[]): Node {
  match (n.chan) {
    Some(c) => {
      let (c1, sealed) = match (kind == lan.VOICE) {
        true => secure.seal_voice(c, plain),
        false => secure.seal_control(c, plain),
      };
      return to_peer(Node { ...n, chan: Some(c1) }, [lan.encode(kind, n.link.me, sealed)]);
    },
    None => {}
  }
  return n;
}

// The tag of this side's identity, to the peer now and again at each
// RESEND_MS until the peer confirms.
function announced(n: Node, now: i64): Node {
  let Some(id) = n.identity else {
    return n;
  };
  let Some(k) = n.link.keys else {
    return n;
  };
  let frame = lan.encode(lan.IDENTITY, n.link.me, secure.announce(k, id));
  return to_peer(Node { ...n, ident: [frame], ident_at: now + lan.RESEND_MS }, [frame]);
}

function proving(n: Node, now: i64): Node {
  let shows = false;
  match (n.link.phase) {
    lan.Verifying => {
      shows = true;
    },
    lan.Ready => {
      shows = !n.sess.peer_ready;
    },
    _ => {}
  }
  if (!shows || n.ident.len() == 0 || now < n.ident_at) {
    return n;
  }
  return to_peer(Node { ...n, ident_at: now + lan.RESEND_MS }, n.ident);
}

// An identity frame of the peer. A tag of a known phone gets this side's
// proof. A proof of a known phone means that the peer knows this phone too,
// because it sent the proof: the two met before and a user confirmed the
// string then, so they need no new check.
function identified(n: Node, body: u8[], now: i64): Node {
  let Some(k) = n.link.keys else {
    return n;
  };
  if let Some(_) = secure.recognize(k, body, n.pins) {
    let Some(id) = n.identity else {
      return n;
    };
    if (n.ident.len() != 1) {
      return n;
    }
    let frame = lan.encode(lan.IDENTITY, n.link.me, secure.prove(k, id));
    return to_peer(Node { ...n, ident: n.ident.append(frame) }, [frame]);
  }
  let Some(p) = secure.check_proof(k, body) else {
    return n;
  };
  if (!knows(n, p)) {
    return n;
  }
  let t = Node { ...n, peer_identity: p };
  return accept(log(t, "the other phone is known: no string to compare"), now);
}

// This side's identity on the channel, with its flags, to the peer.
function send_pin(n: Node, now: i64): Node {
  let Some(id) = n.identity else {
    return n;
  };
  let Some(c) = n.chan else {
    return n;
  };
  let (public, signature) = secure.pin_message(c, id);
  let flags = 0;
  if (n.peer_identity.len() > 0) {
    flags = protocol.HAVE_PEER;
    if (n.peer_has_mine) {
      flags = flags | protocol.DONE;
    }
  }
  return send_frame(Node { ...n, pin_at: now + lan.RESEND_MS }, lan.CONTROL, protocol.encode(protocol.Identity(public, signature, flags)));
}

function pins_done(n: Node): boolean {
  return n.peer_identity.len() > 0 && n.peer_has_mine;
}

// The identity again at each RESEND_MS, until each phone has the other's.
function pinning(n: Node, now: i64): Node {
  if (!n.pinning || pins_done(n) || now < n.pin_at || !session.connected(n.sess)) {
    return n;
  }
  return send_pin(n, now);
}

// The peer's identity on the channel. After a user confirmed the string of
// this session, this phone keeps it. A peer that does not know yet that
// this side has its identity gets an answer at once.
function pinned(n: Node, public: u8[], signature: u8[], flags: i32, now: i64): Node {
  let Some(c) = n.chan else {
    return n;
  };
  if (n.identity.is_none() || !secure.check_pin(c, public, signature)) {
    return n;
  }
  if (n.peer_identity.len() > 0 && n.peer_identity != public) {
    return n;
  }
  let t = Node { ...n, peer_identity: public, pinning: true, peer_has_mine: n.peer_has_mine || (flags & protocol.HAVE_PEER) != 0 };
  if (t.confirmed && !knows(t, public)) {
    t = log(Node { ...t, pins: t.pins.append(public) }, "this phone now knows the other phone as " + label(public));
  }
  if ((flags & protocol.DONE) == 0) {
    return send_pin(t, now);
  }
  return t;
}

// The beacons, the handshake resends, the session timers and the rekey at
// `now`.
pub function tick(n: Node, now: i64): Node {
  let (l1, beacons) = lan.beacon(n.link, now);
  let out = n.out;
  for b in beacons {
    out = out.append(Datagram { broadcast: true, data: b });
  }
  let (l2, again) = lan.resend(l1, now);
  if (lan.expired(l2, now)) {
    let t = log(Node { ...n, link: lan.close(l2), out: out }, "the key exchange did not finish");
    return act(t, session.TransportLost, now);
  }
  return pinning(proving(rekeying(act(to_peer(Node { ...n, link: l2, out: out }, again), session.Tick, now), now), now), now);
}

// The node with `random`, fresh random bytes for the rekeys, in place of the
// bytes it did not use. The app gives RANDOM_BYTES before each tick.
pub function fresh(n: Node, own random: u8[]): Node {
  let old = n.random.get();
  n.random.set(random);
  crypto.erase(old);
  return n;
}

// 32 of the random bytes, which leave the node. Too few gives none.
function draw(n: Node): u8[] {
  let pool = n.random.get();
  if (pool.len() < 32) {
    return [];
  }
  let out = part(pool, 0, 32);
  n.random.set(part(pool, 32, pool.len() - 32));
  crypto.erase(pool);
  return out;
}

// A transmission starts with an offer of a new key for this side's voice.
// The offer goes again after each RESEND_MS until the peer accepts it.
function rekeying(n: Node, now: i64): Node {
  let Some(c) = n.chan else {
    return n;
  };
  if let Some(o) = n.offer {
    if (now < n.offer_at) {
      return n;
    }
    return send_frame(Node { ...n, offer_at: now + lan.RESEND_MS }, lan.CONTROL, protocol.encode(protocol.KeyOffer(o.epoch, o.public)));
  }
  if (!n.rekey_due) {
    return n;
  }
  let Some(o) = secure.offer(c, draw(n)) else {
    return n;
  };
  let next = Node { ...n, rekey_due: false, offer: Some(o), offer_at: now + lan.RESEND_MS };
  return send_frame(next, lan.CONTROL, protocol.encode(protocol.KeyOffer(o.epoch, o.public)));
}

// The peer offers a new key for its voice. The first offer of the next epoch
// gets an accept with a new key of this side. The same offer again gets the
// same accept, because the first one can be lost.
function offered(n: Node, epoch: i32, public: u8[]): Node {
  let Some(c) = n.chan else {
    return n;
  };
  if (epoch == n.accepted && n.accepted_key.len() > 0) {
    return send_frame(n, lan.CONTROL, protocol.encode(protocol.KeyAccept(epoch, n.accepted_key)));
  }
  let (c1, mine) = secure.accept_offer(c, epoch, public, draw(n));
  if (mine.len() == 0) {
    return n;
  }
  let u = log(Node { ...n, chan: Some(c1), accepted: epoch, accepted_key: mine }, "the peer's voice has key " + epoch.to_string());
  return send_frame(u, lan.CONTROL, protocol.encode(protocol.KeyAccept(epoch, mine)));
}

// The peer accepts this side's offer: this side sends with the new key.
function accepted(n: Node, epoch: i32, public: u8[]): Node {
  let Some(c) = n.chan else {
    return n;
  };
  let Some(o) = n.offer else {
    return n;
  };
  if (o.epoch != epoch) {
    return n;
  }
  let c1 = secure.complete_offer(c, o, epoch, public);
  return log(Node { ...n, chan: Some(c1), offer: None }, "this side's voice has key " + secure.send_epoch(c1).to_string());
}

// Microphone samples at `voice.RATE`. Each full frame goes to the peer as
// one Opus packet.
pub function voice(n: Node, samples: [i32]): Node {
  if (!n.capture) {
    return n;
  }
  let pending = n.pending;
  for v in samples {
    pending = pending.append(v);
  }
  let t = n;
  let at = 0;
  while (pending.len() - at >= voice.FRAME) {
    let head: i32[] = [];
    for k in at..at + voice.FRAME {
      head = head.append(pending[k]);
    }
    let (enc, packet) = voice.encode(celt_encoder.Encoder { ...t.enc }, head);
    t = Node { ...t, enc: enc };
    if (packet.len() > 0) {
      t = send_frame(t, lan.VOICE, packet);
    }
    at += voice.FRAME;
  }
  let rest: i32[] = [];
  for k in at..pending.len() {
    rest = rest.append(pending[k]);
  }
  return Node { ...t, pending: rest };
}

pub function press(n: Node, now: i64): Node {
  return act(n, session.PttDown, now);
}

pub function release(n: Node, now: i64): Node {
  return act(n, session.PttUp, now);
}

// The user says that both phones show the same string.
pub function confirm(n: Node, now: i64): Node {
  match (n.link.phase) {
    lan.Verifying => {},
    _ => {
      return n;
    }
  }
  let t = log(Node { ...n, confirmed: true, pinning: n.identity.is_some() }, "the string is confirmed");
  return accept(t, now);
}

// The channel of the session, after the user or a proof of a known phone.
function accept(n: Node, now: i64): Node {
  let (l, chan) = lan.confirm(n.link);
  return act(Node { ...n, link: l, chan: chan }, session.Authenticated, now);
}

// The user says that the strings differ.
pub function reject(own n: Node, now: i64): Node {
  let t = log(Node { ...n, link: lan.close(n.link) }, "the string is rejected");
  return act(t, session.AuthFailed, now);
}

pub function leave(n: Node, now: i64): Node {
  return act(n, session.Leave, now);
}

// The microphone failed or was not allowed: the floor goes back.
// The node with the notice `text` under the status line.
pub function noticed(n: Node, text: string): Node {
  return Node { ...n, notice: text };
}

pub function mic_lost(n: Node, why: string, now: i64): Node {
  let t = act(n, session.MicLost, now);
  return Node { ...t, notice: why };
}

// The status line.
pub function status(n: Node): string {
  match (n.link.phase) {
    lan.Searching => {
      return "looking for a phone on this Wi-Fi";
    },
    lan.Pairing => {
      return "found a phone: making keys";
    },
    lan.Verifying => {
      return "do both phones show this code?";
    },
    lan.Closed => {
      return "not connected";
    },
    lan.Ready => {
      if (session.connected(n.sess) && !n.sess.peer_ready) {
        return "waiting for the other phone to confirm";
      }
      if (n.peer_identity.len() > 0) {
        return "connected to " + label(n.peer_identity);
      }
      return "connected";
    }
  }
  return "";
}

// The words of the talk button.
pub function button(n: Node, now: i64): string {
  if (ended(n)) {
    return "TAP TO SEARCH AGAIN";
  }
  match (n.sess.state) {
    session.Transmitting => {
      return "TALKING";
    },
    session.Requesting => {
      return "WAIT";
    },
    session.Listening => {
      if (!n.sess.peer_ready) {
        return "WAITING";
      }
      if (n.sess.receiving || now - n.heard_at < 300i64) {
        return "LISTENING";
      }
      return "HOLD TO TALK";
    },
    _ => {}
  }
  return "SEARCHING";
}
