import "std/test";
import "./pcm";

function ramp(n: i32, step: i32): i32[] {
  let x: i32[] = [];
  for i in 0..n {
    x = x.append(i * step);
  }
  return x;
}

// The same rate gives the same samples back, one sample late, across blocks.
function test_same_rate_is_identity(): test.TestOutcome {
  let r = pcm.resampler(16000, 16000);
  let (r1, a) = pcm.resample(r, ramp(100, 3));
  let (r2, b) = pcm.resample(r1, ramp(100, 3));
  return test.assert_eq((a.len() + b.len()).to_string() + " " + a[98].to_string() + " " + b[0].to_string(), "199 294 297");
}

// 48 kHz to 16 kHz keeps one sample in three, and a straight line stays
// straight across the block boundary.
function test_downsample_by_three(): test.TestOutcome {
  let r = pcm.resampler(48000, 16000);
  let (r1, a) = pcm.resample(r, ramp(960, 1));
  let (r2, b) = pcm.resample(r1, ramp(960, 1));
  return test.assert_eq(a.len().to_string() + " " + a[1].to_string() + " " + a[319].to_string() + " " + b.len().to_string(), "320 3 957 320");
}

// 16 kHz to 48 kHz gives three samples for each, on the line between them.
function test_upsample_by_three(): test.TestOutcome {
  let r = pcm.resampler(16000, 48000);
  let (r1, a) = pcm.resample(r, [0, 300, 600]);
  return test.assert_eq(a.len().to_string() + " " + a[1].to_string() + " " + a[2].to_string() + " " + a[3].to_string(), "6 100 200 300");
}

// The samples that the speaker did not take stay, and an old backlog goes.
function test_unplayed(): test.TestOutcome {
  let q = ramp(10, 1);
  let rest = pcm.unplayed(q, 4, 100);
  let newest = pcm.unplayed(q, 2, 3);
  let failed = pcm.unplayed(q, -5, 100);
  return test.assert_eq(rest.len().to_string() + " " + rest[0].to_string() + " " + newest.len().to_string() + " " + newest[0].to_string() + " " + failed.len().to_string(), "6 4 3 7 10");
}

// A tone of `peak`, in blocks of 160 samples.
function tone(peak: i32, block: i32): i32[] {
  let x: i32[] = [];
  for i in 0..160 {
    let k: i32 = (block * 160 + i) % 32;
    let v = peak * k / 8;
    if (k >= 8 && k < 24) {
      v = peak * (16 - k) / 8;
    } else if (k >= 24) {
      v = peak * (k - 32) / 8;
    }
    x = x.append(v);
  }
  return x;
}

function peak(x: [i32]): i32 {
  let p = 0;
  for v in x {
    if (v > p) {
      p = v;
    } else if (0 - v > p) {
      p = 0 - v;
    }
  }
  return p;
}

// Runs `blocks` blocks of a tone of `level` through `a`, and gives the peak
// of the last block.
function settle(a: pcm.Agc, level: i32, blocks: i32): (pcm.Agc, i32) {
  let g = a;
  let last = 0;
  for b in 0..blocks {
    let (g1, y) = pcm.amplify(g, tone(level, b));
    g = g1;
    last = peak(y);
  }
  return (g, last);
}

// Quiet speech rises to about the target, and loud speech keeps its level.
function test_gain_raises_quiet_speech(): test.TestOutcome {
  let (quiet, q) = settle(pcm.agc(), 2000, 60);
  let (loud, l) = settle(pcm.agc(), 30000, 60);
  let near = q > pcm.TARGET_PEAK * 9 / 10 && q <= pcm.TARGET_PEAK;
  return test.assert_eq(near.to_string() + " " + l.to_string() + " " + loud.gain.to_string(), "true 30000 256");
}

// The gain stops at MAX_GAIN, and it does not rise on noise.
function test_gain_limits(): test.TestOutcome {
  let (faint, f) = settle(pcm.agc(), 700, 80);
  let (noise, n) = settle(pcm.agc(), 300, 80);
  return test.assert_eq(faint.gain.to_string() + " " + noise.gain.to_string() + " " + n.to_string(), "2048 256 300");
}

// After quiet speech, the gain falls at once for a loud word, so the word
// is not clipped.
function test_gain_does_not_clip(): test.TestOutcome {
  let (quiet, q) = settle(pcm.agc(), 2000, 60);
  let (after, y) = pcm.amplify(quiet, tone(20000, 0));
  return test.assert_eq((quiet.gain > pcm.GAIN_ONE * 7).to_string() + " " + peak(y).to_string() + " " + after.gain.to_string(), "true 20000 256");
}

function main(): i32 {
  let r = test.new("walkie pcm");
  r = r.it("the same rate is the identity", test_same_rate_is_identity);
  r = r.it("48 kHz to 16 kHz keeps one sample in three", test_downsample_by_three);
  r = r.it("16 kHz to 48 kHz interpolates", test_upsample_by_three);
  r = r.it("the samples that the speaker did not take stay", test_unplayed);
  r = r.it("the gain raises quiet speech", test_gain_raises_quiet_speech);
  r = r.it("the gain stops at its limit and not on noise", test_gain_limits);
  r = r.it("the gain does not clip a loud word", test_gain_does_not_clip);
  return r.finish();
}
