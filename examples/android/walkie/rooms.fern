// The rooms of the internet mode. One phone creates a room and gets a short
// code. The other phone joins the room with the code. The server gives each
// member a token, over TLS. The token never goes on the wire again: each
// datagram to the relay carries the ID of the member, a counter, and a MAC
// that the token keys. The relay sends a datagram to the other member of
// its room. The relay cannot read the voice, because the phones seal it with
// the keys of their own exchange.
//
// A valid datagram from a new address does not move the member. The relay
// sends a challenge to that address, and the member moves when its answer
// comes from there. So a party that copies a datagram, or that sends from a
// false address, cannot turn the traffic of a room to itself or to another
// host.
//
// This module does no I/O. The server gives it the time and the random bytes.
import "core/map";
import "std/crypto";
import "std/hex";
import "std/net";

pub const PORT: i32 = 47130;

pub const CODE_LEN: i32 = 8;

// No 0, O, 1, I or L: a user reads the code to the other user.
pub const ALPHABET: string = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";

pub const TOKEN_LEN: i32 = 16;

// The random bytes of one request: 8 for the code and the bytes of the token.
pub const RANDOM_LEN: i32 = 24;

// A datagram to the relay is MAGIC, the ID of the member, a counter, the
// datagram of the LAN transport, and the MAC. The relay sends CHALLENGE and a
// cookie to a new address, and the member sends ANSWER, its ID, a counter,
// the cookie and the MAC from that address.
pub const MAGIC: u8 = 248u8;

pub const CHALLENGE: u8 = 249u8;

pub const ANSWER: u8 = 250u8;

pub const ID_LEN: i32 = 8;

const MAC_LEN: i32 = 16;

const COOKIE_LEN: i32 = 16;

// The part of a datagram before its body.
const HEAD_LEN: i32 = 1 + ID_LEN + 8;

// A cookie is good for the period that it was made in and the next one.
pub const COOKIE_MS: i64 = 10000i64;

// A room with one member closes 10 minutes after it opens. A room with two
// members closes after 2 minutes with no datagram.
pub const OPEN_MS: i64 = 600000i64;

pub const IDLE_MS: i64 = 120000i64;

// Each host can send 10 requests in a minute and hold 4 open rooms, so a
// guess of the code is slow and a few hosts cannot fill the server. A host
// is an IPv4 address or an IPv6 /64. The table of hosts has a limit.
pub const RATE_MS: i64 = 60000i64;

pub const RATE_MAX: i32 = 10;

pub const ROOMS_PER_HOST: i32 = 4;

pub const MAX_HOSTS: i32 = 16384;

pub const MAX_ROOMS: i32 = 4096;

// The longest request line.
pub const LINE_MAX: i32 = 64;

// `high` is the highest counter of the member that the relay took.
pub struct Member { token: u8[], id: u8[], addr: Option[net.SocketAddr], high: i64 }

// `host` made the room.
pub struct Room { code: string, host: string, opened: i64, last: i64, members: Member[] }

// `hits` holds the times of the recent requests of each host, and `index`
// gives the room of each member ID in hex. `secret` keys the cookies.
pub struct Rooms { rooms: Room[], hits: Map[string, i64[]], index: Map[string, i32], secret: u8[] }

pub enum Reply {
  Created(string, u8[]),
  Joined(u8[]),
  Refused(string),
}

pub struct Answer { rooms: Rooms, reply: Reply }

// A datagram for the relay to send.
pub struct Forward { to: net.SocketAddr, data: u8[] }

pub struct Relayed { rooms: Rooms, out: Option[Forward] }

// No rooms, with 32 random bytes that key the cookies of the relay.
pub function empty(secret: [u8]): Rooms {
  let key: u8[] = [];
  for b in secret {
    key = key.append(b);
  }
  return Rooms { rooms: [], hits: map_new(16), index: map_new(16), secret: key };
}

// The host of `ip` for the limits: the address, or the /64 of an IPv6
// address.
pub function host_key(ip: net.IpAddr): string {
  let a = ip.to_canonical();
  match (a) {
    net.V6(b) => {
      let prefix: u8[] = [];
      for k in 0..8 {
        prefix = prefix.append(b[k]);
      }
      return hex.encode(prefix) + "/64";
    },
    _ => {
      return a.to_string();
    }
  }
}

// The ID of the member with `token`, which its datagrams carry.
pub function member_id(token: [u8]): u8[] {
  let h = crypto.sha256(cat(text("walkie relay id"), token));
  let out: u8[] = [];
  for k in 0..ID_LEN {
    out = out.append(h[k]);
  }
  return out;
}

function cat(a: [u8], b: [u8]): u8[] {
  let out: u8[] = [];
  for x in a {
    out = out.append(x);
  }
  for x in b {
    out = out.append(x);
  }
  return out;
}

function text(s: string): u8[] {
  return cat(s.as_bytes(), []);
}

function be64(v: i64): u8[] {
  let out: u8[] = [];
  for k in 0..8 {
    out = out.append((v >> (56 - 8 * k) as i64 & 255i64) as u8);
  }
  return out;
}

function read64(b: [u8], at: i32): i64 {
  let v = 0i64;
  for k in at..at + 8 {
    v = v << 8i64 | b[k] as i64;
  }
  return v;
}

function bytes(b: [u8], from: i32, to: i32): u8[] {
  let out: u8[] = [];
  for k in from..to {
    out = out.append(b[k]);
  }
  return out;
}

// The MAC of `body` with the key `key`.
function mac(key: [u8], body: [u8]): u8[] {
  return bytes(crypto.hmac_sha256(key, body), 0, MAC_LEN);
}

// The code that 8 random bytes give. The modulo bias is below one part in
// 10^7.
function code_of(random: [u8]): string {
  let v: i64 = 0i64;
  for k in 0..8 {
    v = v << 8i64 | random[k] as i64;
  }
  v = v & 9223372036854775807i64;
  let letters: [u8] = ALPHABET.as_bytes();
  let n = letters.len() as i64;
  let out: u8[] = [];
  for k in 0..CODE_LEN {
    out = out.append(letters[(v % n) as i32]);
    v /= n;
  }
  return string_from_bytes_unchecked(out);
}

function member(token: u8[]): Member {
  return Member { token: token, id: member_id(token), addr: None, high: -1i64 };
}

function token_of(random: [u8]): u8[] {
  let out: u8[] = [];
  for k in 8..RANDOM_LEN {
    out = out.append(random[k]);
  }
  return out;
}

// Compares two values in a time that does not depend on where they differ.
function same(a: [u8], b: [u8]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let d = 0;
  for k in 0..a.len() {
    d = d | (a[k] ^ b[k]) as i32;
  }
  return d == 0;
}

function open(room: Room, now: i64): boolean {
  if (room.members.len() < 2) {
    return now - room.opened < OPEN_MS;
  }
  return now - room.last < IDLE_MS;
}

// The table without its closed rooms and old requests.
pub function expire(r: Rooms, now: i64): Rooms {
  let rooms: Room[] = [];
  for room in r.rooms {
    if (open(room, now)) {
      rooms = rooms.append(room);
    }
  }
  let hits: Map[string, i64[]] = map_new(16);
  for ip in r.hits.keys() {
    let at: i64[] = [];
    for t in r.hits.get_or(ip, []) {
      if (now - t < RATE_MS) {
        at = at.append(t);
      }
    }
    if (at.len() > 0) {
      hits = hits.insert(ip, at);
    }
  }
  return indexed(Rooms { ...r, rooms: rooms, hits: hits });
}

// The table with the room of each member ID.
function indexed(r: Rooms): Rooms {
  let index: Map[string, i32] = map_new(16);
  for i in 0..r.rooms.len() {
    for m in r.rooms[i].members {
      index = index.insert(hex.encode(m.id), i);
    }
  }
  return Rooms { ...r, index: index };
}

// The table with one more request from `ip`, or None when `ip` sent too
// many, or when the table of hosts is full.
function counted(r: Rooms, ip: string, now: i64): Option[Rooms] {
  if (r.hits.contains(ip)) {
    let at = r.hits.get_or(ip, []);
    if (at.len() >= RATE_MAX) {
      return None;
    }
    return Some(Rooms { ...r, hits: r.hits.insert(ip, at.append(now)) });
  }
  if (r.hits.len() >= MAX_HOSTS) {
    return None;
  }
  return Some(Rooms { ...r, hits: r.hits.insert(ip, [now]) });
}

function rooms_of(r: Rooms, ip: string): i32 {
  let n = 0;
  for room in r.rooms {
    if (room.host == ip) {
      n += 1;
    }
  }
  return n;
}

function room_index(r: Rooms, code: string): i32 {
  for i in 0..r.rooms.len() {
    if (r.rooms[i].code == code) {
      return i;
    }
  }
  return -1;
}

function refused(r: Rooms, why: string): Answer {
  return Answer { rooms: r, reply: Refused(why) };
}

// Opens a room for `ip`. `random` holds RANDOM_LEN bytes.
pub function create(r0: Rooms, ip: string, now: i64, random: [u8]): Answer {
  let Some(r) = counted(expire(r0, now), ip, now) else {
    return refused(expire(r0, now), "too many requests");
  };
  if (r.rooms.len() >= MAX_ROOMS) {
    return refused(r, "the server is full");
  }
  if (rooms_of(r, ip) >= ROOMS_PER_HOST) {
    return refused(r, "this network has too many rooms");
  }
  let code = code_of(random);
  if (room_index(r, code) >= 0) {
    return refused(r, "try again");
  }
  let token = token_of(random);
  let room = Room { code: code, host: ip, opened: now, last: now, members: [member(token)] };
  return Answer { rooms: indexed(Rooms { ...r, rooms: r.rooms.append(room) }), reply: Created(code, token) };
}

// Adds `ip` to the room of `code`. `random` holds RANDOM_LEN bytes.
pub function join(r0: Rooms, ip: string, code: string, now: i64, random: [u8]): Answer {
  let Some(r) = counted(expire(r0, now), ip, now) else {
    return refused(expire(r0, now), "too many requests");
  };
  let i = room_index(r, code.to_ascii_upper());
  if (i < 0) {
    return refused(r, "no room has this code");
  }
  let room = r.rooms[i];
  if (room.members.len() >= 2) {
    return refused(r, "the room is full");
  }
  let token = token_of(random);
  let joined = Room { ...room, last: now, members: room.members.append(member(token)) };
  return Answer { rooms: indexed(Rooms { ...r, rooms: r.rooms.with(i, joined) }), reply: Joined(token) };
}

// The text of a reply, as the server sends it.
pub function reply_line(reply: Reply): string {
  match (reply) {
    Created(code, token) => {
      return "ROOM " + code + " " + hex.encode(token) + "\n";
    },
    Joined(token) => {
      return "JOINED " + hex.encode(token) + "\n";
    },
    Refused(why) => {
      return "ERROR " + why + "\n";
    }
  }
  return "";
}

function token_text(text: string): Option[u8[]] {
  if let Ok(token) = hex.decode(text) {
    if (token.len() == TOKEN_LEN) {
      return Some(token);
    }
  }
  return None;
}

// The reply in a line from the server, without its newline.
pub function parse_reply(line: string): Reply {
  let words = line.trim().split(" ");
  if (words.len() == 3 && words[0] == "ROOM" && words[1].len() == CODE_LEN) {
    if let Some(token) = token_text(words[2]) {
      return Created(words[1], token);
    }
  }
  if (words.len() == 2 && words[0] == "JOINED") {
    if let Some(token) = token_text(words[1]) {
      return Joined(token);
    }
  }
  if let Some(why) = line.trim().strip_prefix("ERROR ") {
    return Refused(why);
  }
  return Refused("the server sent an unknown reply");
}

// The answer to one request line from `ip`: `CREATE`, or `JOIN` and a code.
pub function answer(r: Rooms, ip: string, line: string, now: i64, random: [u8]): Answer {
  let words = line.trim().split(" ");
  if (words.len() == 1 && words[0] == "CREATE") {
    return create(r, ip, now, random);
  }
  if (words.len() == 2 && words[0] == "JOIN" && words[1].len() == CODE_LEN) {
    return join(r, ip, words[1], now, random);
  }
  return refused(r, "unknown request");
}

// The datagram that a phone with `token` sends to the relay for `packet`.
// `counter` grows with each datagram of the member.
pub function wrap(token: [u8], counter: i64, packet: [u8]): u8[] {
  let head = cat(cat([MAGIC], member_id(token)), be64(counter));
  let body = cat(head, packet);
  return cat(body, mac(token, body));
}

// The answer of the phone with `token` to the challenge in the first `n`
// bytes of `data`, or None when it is not a challenge for this member.
pub function answer_challenge(token: [u8], counter: i64, data: [u8], n: i32): Option[u8[]] {
  if (n != 1 + ID_LEN + COOKIE_LEN || n > data.len() || data[0] != CHALLENGE) {
    return None;
  }
  let id = member_id(token);
  if (!same(bytes(data, 1, 1 + ID_LEN), id)) {
    return None;
  }
  let body = cat(cat(cat([ANSWER], id), be64(counter)), bytes(data, 1 + ID_LEN, n));
  return Some(cat(body, mac(token, body)));
}

// The cookie of the member `id` at the address `to`, for period `period`.
function cookie(r: Rooms, id: [u8], to: net.SocketAddr, period: i64): u8[] {
  return bytes(crypto.hmac_sha256(r.secret, cat(cat(cat(text("walkie cookie"), id), be64(period)), to.to_string().as_bytes())), 0, COOKIE_LEN);
}

function nothing(r: Rooms): Relayed {
  return Relayed { rooms: r, out: None };
}

// The room and the member of the ID at `data[1:]`, when its room is open
// and the MAC of the first `n` bytes is good.
function sender(r: Rooms, data: [u8], n: i32, now: i64): Option[(i32, i32)] {
  let i = r.index.get_or(hex.encode(bytes(data, 1, 1 + ID_LEN)), -1);
  if (i < 0 || i >= r.rooms.len() || !open(r.rooms[i], now)) {
    return None;
  }
  let room = r.rooms[i];
  for m in 0..room.members.len() {
    let mb = room.members[m];
    if (same(mb.id, bytes(data, 1, 1 + ID_LEN)) && same(mac(mb.token, bytes(data, 0, n - MAC_LEN)), bytes(data, n - MAC_LEN, n))) {
      return Some((i, m));
    }
  }
  return None;
}

function with_member(r: Rooms, i: i32, m: i32, mb: Member, now: i64): Rooms {
  let room = r.rooms[i];
  return Rooms { ...r, rooms: r.rooms.with(i, Room { ...room, last: now, members: room.members.with(m, mb) }) };
}

// Relays the first `n` bytes of `data`, which came from `from`. A datagram
// from the address of its member goes to the other member when the relay
// knows that address. A newer datagram from another address gets a
// challenge there, and an answer from that address moves the member.
pub function relay(r: Rooms, from: net.SocketAddr, data: [u8], n: i32, now: i64): Relayed {
  if (n > data.len() || n < HEAD_LEN + MAC_LEN) {
    return nothing(r);
  }
  if (data[0] == ANSWER && n == HEAD_LEN + COOKIE_LEN + MAC_LEN) {
    return answered(r, from, data, n, now);
  }
  if (data[0] != MAGIC || n <= HEAD_LEN + MAC_LEN) {
    return nothing(r);
  }
  let Some((i, m)) = sender(r, data, n, now) else {
    return nothing(r);
  };
  let mb = r.rooms[i].members[m];
  let counter = read64(data, 1 + ID_LEN);
  if let Some(a) = mb.addr {
    if (a.eq(from)) {
      let high = mb.high;
      if (counter > high) {
        high = counter;
      }
      let members = r.rooms[i].members.with(m, Member { ...mb, high: high });
      return Relayed { rooms: with_member(r, i, m, Member { ...mb, high: high }, now), out: forward(members, 1 - m, data, n) };
    }
  }
  if (counter <= mb.high) {
    return nothing(r);
  }
  let challenge = cat(cat([CHALLENGE], mb.id), cookie(r, mb.id, from, now / COOKIE_MS));
  return Relayed { rooms: with_member(r, i, m, Member { ...mb, high: counter }, now), out: Some(Forward { to: from, data: challenge }) };
}

// An answer to a challenge: the member moves to `from` when the cookie is
// the one that the relay sent to `from`, and the answer is newer than each
// datagram that the relay took from the member.
function answered(r: Rooms, from: net.SocketAddr, data: [u8], n: i32, now: i64): Relayed {
  let Some((i, m)) = sender(r, data, n, now) else {
    return nothing(r);
  };
  let mb = r.rooms[i].members[m];
  let counter = read64(data, 1 + ID_LEN);
  let got = bytes(data, HEAD_LEN, HEAD_LEN + COOKIE_LEN);
  let period = now / COOKIE_MS;
  if (counter <= mb.high || !same(got, cookie(r, mb.id, from, period)) && !same(got, cookie(r, mb.id, from, period - 1i64))) {
    return nothing(r);
  }
  return nothing(with_member(r, i, m, Member { ...mb, addr: Some(from), high: counter }, now));
}

function forward(members: Member[], other: i32, data: [u8], n: i32): Option[Forward] {
  if (other >= members.len()) {
    return None;
  }
  let Some(to) = members[other].addr else {
    return None;
  };
  return Some(Forward { to: to, data: bytes(data, HEAD_LEN, n - MAC_LEN) });
}
