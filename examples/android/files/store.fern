// The places that the app shows: the storage of the phone, the shares of
// SMB servers, and the folders of WebDAV servers. Each function takes a
// place, so the screens and the copy work the same way on each of them.
import "std/array";
import "std/base64";
import "std/i32";
import "std/i64";
import "std/string";
import "std/unicode";
import "std/utf8";
import "./dav";
import "./smb";

// A server: a share of an SMB server, or a folder of a WebDAV server.
pub enum Link { Smb(smb.Server), Dav(dav.Server) }

pub enum Place { Local, Remote(Link) }

// The most bytes that one step of a copy moves.
pub const STEP: i32 = 8388608;

pub function same_place(a: Place, b: Place): boolean {
  return match ((a, b)) {
    (Local(), Local()) => true,
    (Remote(x), Remote(y)) => same_link(x, y),
    _ => false,
  };
}

function same_link(a: Link, b: Link): boolean {
  return match ((a, b)) {
    (Smb(x), Smb(y)) => x.host == y.host && x.share == y.share && x.user == y.user && x.port == y.port,
    (Dav(x), Dav(y)) => x.url == y.url && x.user == y.user,
    _ => false,
  };
}

// The text that names a server: smb://host/share, or the address of the
// WebDAV folder.
pub function link_text(link: Link): string {
  return match (link) {
    Smb(s) => "smb://" + s.host + "/" + s.share,
    Dav(d) => d.url,
  };
}

function io_text(e: IoError): string {
  match (e) {
    NotFound(_) => {
      return "The phone has no such file or folder.";
    },
    PermissionDenied(_) => {
      return "Android refused access.";
    },
    AlreadyExists(_) => {
      return "That name is in use already.";
    },
    Other(_, message, _) => {
      return message;
    },
    _ => {
      return "The storage gave an error.";
    }
  }
}

// `dir` with `name` below it.
pub function join(dir: string, name: string): string {
  if (dir.len() == 0) {
    return name;
  }
  if (name.len() == 0) {
    return dir;
  }
  if (dir.ends_with("/")) {
    return dir + name;
  }
  return dir + "/" + name;
}

// The directory that holds `path`, or "" for a path with one part.
pub function parent(path: string): string {
  let parts = path.split("/").filter((p: string): boolean => p.len() > 0);
  if (parts.len() <= 1) {
    return if (path.starts_with("/")) { "/" } else { "" };
  }
  let up = parts.take(parts.len() - 1).join("/");
  return if (path.starts_with("/")) { "/" + up } else { up };
}

// The last part of `path`.
pub function base(path: string): string {
  let parts = path.split("/").filter((p: string): boolean => p.len() > 0);
  if (parts.len() == 0) {
    return "";
  }
  return parts[parts.len() - 1];
}

function local_list(path: string): Result[smb.Entry[], string] {
  match (read_dir(path)) {
    Ok(names) => {
      let out: smb.Entry[] = [];
      for name in names {
        if let Ok(st) = stat(join(path, name)) {
          out = out.append(smb.Entry { name: name, dir: st.is_dir, size: if (st.is_dir) { 0i64 } else { st.size }, modified: st.mtime });
        } else {
          out = out.append(smb.Entry { name: name, dir: false, size: 0i64, modified: 0i64 });
        }
      }
      return Ok(out);
    },
    Err(e) => {
      return Err(io_text(e));
    }
  }
}

function local_read(path: string, offset: i64, limit: i32): Result[smb.Part, string] {
  let size = 0i64;
  match (stat(path)) {
    Ok(st) => {
      size = st.size;
    },
    Err(e) => {
      return Err(io_text(e));
    }
  }
  match (open_reader(path)) {
    Ok(r) => {
      let data: u8[] = [];
      let failure = "";
      if let Err(e) = r.seek(offset, 0) {
        failure = io_text(e);
      }
      while (failure.len() == 0 && data.len() < limit) {
        match (r.read_chunk_bytes((limit - data.len()).min(65536))) {
          Ok(bytes) => {
            if (bytes.len() == 0) {
              break;
            }
            data = data.concat(bytes);
          },
          Err(e) => {
            failure = io_text(e);
          }
        }
      }
      let closed = r.close();
      if (failure.len() > 0) {
        return Err(failure);
      }
      return Ok(smb.Part { data: data, size: size });
    },
    Err(e) => {
      return Err(io_text(e));
    }
  }
}

function local_write(path: string, offset: i64, data: u8[]): Result[void, string] {
  let opened = if (offset == 0i64) { open_writer(path) } else { open_writer_with(path, 0) };
  match (opened) {
    Ok(w) => {
      let failure = "";
      if let Err(e) = w.seek(offset, 0) {
        failure = io_text(e);
      }
      if (failure.len() == 0) {
        if let Err(e) = w.write_bytes(data) {
          failure = io_text(e);
        }
      }
      let closed = w.close();
      if (failure.len() > 0) {
        return Err(failure);
      }
      return Ok(());
    },
    Err(e) => {
      return Err(io_text(e));
    }
  }
}

function done(r: Result[void, IoError]): Result[void, string] {
  match (r) {
    Ok(_) => {
      return Ok(());
    },
    Err(e) => {
      return Err(io_text(e));
    }
  }
}

// The files and the directories of the directory `path` of `place`.
pub function list(place: Place, path: string): Result[smb.Entry[], string] {
  match (place) {
    Local => {
      return local_list(path);
    },
    Remote(Smb(server)) => {
      return smb.list(server, path);
    },
    Remote(Dav(server)) => {
      return dav.list(server, path);
    }
  }
}

// At most `limit` bytes of the file from the byte `offset`.
pub function read(place: Place, path: string, offset: i64, limit: i32): Result[smb.Part, string] {
  match (place) {
    Local => {
      return local_read(path, offset, limit);
    },
    Remote(Smb(server)) => {
      return smb.read(server, path, offset, limit);
    },
    Remote(Dav(server)) => {
      return dav.read(server, path, offset, limit);
    }
  }
}

// Writes `data` to the file from the byte `offset`. A write from the byte
// 0 makes the file, or empties the file that is there.
pub function write(place: Place, path: string, offset: i64, data: u8[]): Result[void, string] {
  match (place) {
    Local => {
      return local_write(path, offset, data);
    },
    Remote(Smb(server)) => {
      return smb.write(server, path, offset, data);
    },
    Remote(Dav(server)) => {
      return dav.write(server, path, offset, data);
    }
  }
}

pub function make_dir(place: Place, path: string): Result[void, string] {
  match (place) {
    Local => {
      return done(create_dir(path, 493));
    },
    Remote(Smb(server)) => {
      return smb.make_dir(server, path);
    },
    Remote(Dav(server)) => {
      return dav.make_dir(server, path);
    }
  }
}

// Removes the file, or the directory and all that it holds.
pub function remove(place: Place, path: string, dir: boolean): Result[void, string] {
  match (place) {
    Local => {
      return done(if (dir) { remove_dir_all(path) } else { remove_file(path) });
    },
    Remote(Smb(server)) => {
      return smb.remove(server, path, dir);
    },
    Remote(Dav(server)) => {
      return dav.remove(server, path);
    }
  }
}

pub function rename_to(place: Place, from: string, to: string): Result[void, string] {
  match (place) {
    Local => {
      return done(rename(from, to));
    },
    Remote(Smb(server)) => {
      return smb.rename(server, from, to);
    },
    Remote(Dav(server)) => {
      return dav.rename(server, from, to);
    }
  }
}

// One step of a copy: a directory to make, or a file to copy.
pub struct Step { from: string, to: string, size: i64, dir: boolean }

// The steps that copy `item` of the directory `from` to the name `name` of
// the directory `to`: each directory before what it holds.
function plan_one(src: Place, from: string, item: smb.Entry, to: string, name: string): Result[Step[], string] {
  let source = join(from, item.name);
  let target = join(to, name);
  if (!item.dir) {
    return Ok([Step { from: source, to: target, size: item.size, dir: false }]);
  }
  let out = [Step { from: source, to: target, size: 0i64, dir: true }];
  let below = list(src, source)?;
  for child in below {
    out = out.concat(plan_one(src, source, child, target, child.name)?);
  }
  return Ok(out);
}

// A name that `taken` does not have: `name`, or `name` with a number.
pub function free_name(taken: string[], name: string): string {
  if (!taken.contains(name)) {
    return name;
  }
  let dot = name.last_index_of(".").unwrap_or(-1);
  let stem = if (dot > 0) { name.take(dot) } else { name };
  let rest = if (dot > 0) { name.drop(dot) } else { "" };
  let n = 2;
  while (taken.contains(stem + " (" + n.to_string() + ")" + rest)) {
    n += 1;
  }
  return stem + " (" + n.to_string() + ")" + rest;
}

// The steps that copy `items` of the directory `from` of `src` into the
// directory `to` of `dst`. An item whose name `dst` has gets a new name.
pub function plan(src: Place, from: string, items: smb.Entry[], dst: Place, to: string): Result[Step[], string] {
  let taken = list(dst, to)?.map((e: smb.Entry): string => e.name);
  let out: Step[] = [];
  for item in items {
    let name = free_name(taken, item.name);
    taken = taken.append(name);
    out = out.concat(plan_one(src, from, item, to, name)?);
  }
  return Ok(out);
}

// Does the step from its byte `offset`, and gives the bytes that it copied.
// A file is complete when the result is less than STEP.
pub function advance(src: Place, dst: Place, step: Step, offset: i64): Result[i64, string] {
  if (step.dir) {
    make_dir(dst, step.to)?;
    return Ok(0i64);
  }
  if let Remote(Dav(server)) = dst {
    return if (offset == 0i64) { put_whole(src, server, step) } else { Ok(0i64) };
  }
  let part = read(src, step.from, offset, STEP)?;
  if (part.data.len() > 0 || offset == 0i64) {
    write(dst, step.to, offset, part.data)?;
  }
  return Ok(part.data.len() as i64);
}

// Sends the file of `step` whole to the WebDAV server `server`, which
// takes a file whole, and gives its size. A file that is not on the phone
// goes to a file of the phone first.
function put_whole(src: Place, server: dav.Server, step: Step): Result[i64, string] {
  if let Local = src {
    let size = match (stat(step.from)) {
      Ok(st) => st.size,
      Err(_) => {
        return Err("The file is not on the phone.");
      },
    };
    dav.put_file(server, step.to, step.from)?;
    return Ok(size);
  }
  let dir = match (temp_dir("fern-files-up")) {
    Ok(d) => d,
    Err(_) => {
      return Err("The phone has no room for the file.");
    },
  };
  let held = join(dir, "part");
  let sent = match (copied_whole(src, step.from, held)) {
    Ok(size) => dav.put_file(server, step.to, held).map((x: void): i64 => size),
    Err(text) => Err(text),
  };
  let removed = remove_dir_all(dir);
  return sent;
}

// Copies the file `from` of `src` to the file `to` of the phone, and gives
// its size.
function copied_whole(src: Place, from: string, to: string): Result[i64, string] {
  let step = Step { from: from, to: to, size: 0i64, dir: false };
  let offset = 0i64;
  while (true) {
    let n = advance(src, Local, step, offset)?;
    offset += n;
    if (n < STEP as i64) {
      return Ok(offset);
    }
  }
  return Ok(offset);
}

// The bytes of the files below the directory `path`, in at most
// MOST_SEARCHED directories.
function total(place: Place, path: string): i64 {
  let sum = 0i64;
  let waiting = [path];
  let read = 0;
  while (read < waiting.len() && read < MOST_SEARCHED) {
    if let Ok(entries) = list(place, waiting[read]) {
      for e in entries {
        if (e.dir) {
          waiting = waiting.append(join(waiting[read], e.name));
        } else {
          sum += e.size;
        }
      }
    }
    read += 1;
  }
  return sum;
}

// `entries` of the directory `path`, each directory with the bytes of the
// files below it as its size.
pub function measured(place: Place, path: string, entries: smb.Entry[]): smb.Entry[] {
  return entries.map((e: smb.Entry): smb.Entry => if (e.dir) { smb.Entry { ...e, size: total(place, join(path, e.name)) } } else { e });
}

// The folder at the top of a storage of the phone that holds what the
// person deleted, until the person restores it or deletes it there.
pub const TRASH: string = ".FernTrash";

// The name of an item in the trash: the time of its delete, the folder
// that it was in as base64, and its name. So two items of one name do not
// meet, and the item can go back.
pub function trash_name(now: i64, dir: string, name: string): string {
  return now.to_string() + "~" + base64.encode_url(dir.bytes()) + "~" + name;
}

// The folder and the name that an item of the trash had, or None for a
// name that `trash_name` did not make.
pub function trashed(entry: string): Option[(string, string)] {
  let parts = entry.splitn("~", 3);
  if (parts.len() != 3) {
    return None;
  }
  let Ok(dir) = base64.decode_url(parts[1]) else {
    return None;
  };
  return Some((utf8.from_bytes_lossy(dir), parts[2]));
}

// Moves `items` of the folder `dir` to the trash of the storage `top`.
pub function to_trash(top: string, dir: string, items: smb.Entry[], now: i64): Result[void, string] {
  let trash = join(top, TRASH);
  if (stat(trash).is_err()) {
    make_dir(Local, trash)?;
  }
  for item in items {
    rename_to(Local, join(dir, item.name), join(trash, trash_name(now, dir, item.name)))?;
  }
  return Ok(());
}

// Moves `items` of the trash `trash` back to the folders that they were
// in. An item whose name is in use there gets a new name.
pub function restore(trash: string, items: smb.Entry[]): Result[void, string] {
  for item in items {
    if let Some((dir, name)) = trashed(item.name) {
      if (stat(dir).is_err() && create_dir_all(dir).is_err()) {
        return Err("The folder of " + name + " is not there, and the app could not make it.");
      }
      let taken = list(Local, dir)?.map((e: smb.Entry): string => e.name);
      rename_to(Local, join(trash, item.name), join(dir, free_name(taken, name)))?;
    }
  }
  return Ok(());
}

// The most items that a search gives, and the most directories that it
// reads.
pub const MOST_FOUND: i32 = 200;

const MOST_SEARCHED: i32 = 2000;

// The items below the directory `path` whose name has the text `needle`,
// in each case of its letters. The name of each item is its path below
// `path`. A directory that does not open is not an error of the search.
pub function search(place: Place, path: string, needle: string): Result[smb.Entry[], string] {
  let want = needle.to_lower();
  let out: smb.Entry[] = [];
  let waiting = [""];
  let read = 0;
  while (read < waiting.len() && read < MOST_SEARCHED && out.len() < MOST_FOUND) {
    let below = waiting[read];
    read += 1;
    match (list(place, join(path, below))) {
      Ok(entries) => {
        for e in entries {
          let name = join(below, e.name);
          if (e.dir) {
            waiting = waiting.append(name);
          }
          if (e.name.to_lower().contains(want) && out.len() < MOST_FOUND) {
            out = out.append(smb.Entry { ...e, name: name });
          }
        }
      },
      Err(e) => {
        if (read == 1) {
          return Err(e);
        }
      }
    }
  }
  return Ok(out);
}

// The total and the free bytes of the storage that holds `path`.
pub function space(path: string): Option[(i64, i64)] {
  if let Ok(fs) = statfs(path) {
    return Some((fs.block_size * fs.blocks, fs.block_size * fs.blocks_avail));
  }
  return None;
}

// A size for a person: "512 B", "1.4 MB".
pub function size_text(bytes: i64): string {
  let units = ["B", "KB", "MB", "GB", "TB"];
  let whole = bytes;
  let tenth = 0i64;
  let at = 0;
  while (whole >= 1024i64 && at < 4) {
    tenth = whole % 1024i64 * 10i64 / 1024i64;
    whole /= 1024i64;
    at += 1;
  }
  if (at == 0 || whole >= 100i64) {
    return whole.to_string() + " " + units[at];
  }
  return whole.to_string() + "." + tenth.to_string() + " " + units[at];
}

// The day of `seconds` from 1970 in UTC, as 2026-11-22. It is the civil
// date from the count of days, by the method of Howard Hinnant.
pub function day_text(seconds: i64): string {
  if (seconds <= 0i64) {
    return "";
  }
  let z = seconds / 86400i64 + 719468i64;
  let era = z / 146097i64;
  let doe = z - era * 146097i64;
  let yoe = (doe - doe / 1460i64 + doe / 36524i64 - doe / 146096i64) / 365i64;
  let doy = doe - (365i64 * yoe + yoe / 4i64 - yoe / 100i64);
  let mp = (5i64 * doy + 2i64) / 153i64;
  let day = doy - (153i64 * mp + 2i64) / 5i64 + 1i64;
  let month = if (mp < 10i64) { mp + 3i64 } else { mp - 9i64 };
  let year = yoe + era * 400i64 + (if (month <= 2i64) { 1i64 } else { 0i64 });
  return year.to_string() + "-" + month.to_string().pad_start(2, '0') + "-" + day.to_string().pad_start(2, '0');
}
