// A file explorer with no Java code of its own. NativeActivity loads this
// library and calls ANativeActivity_onCreate. std/android/ui/app runs the
// program of files.fern.
import "std/android";
import "std/android/draw";
import "std/android/image";
import "std/i32";
import "std/android/launch";
import "std/android/ui/app";
import "std/jni";
import "std/result";
import "./files";
import "./open";
import "./prefs";
import "./store";
import "./vault";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

// The content provider that lets another app read one file. Android makes
// it when the process starts, and calls it on a thread of its own.
@jni("dev.fern.files.Shared extends android.content.ContentProvider", "boolean onCreate()")
pub function shared_create(env: usize, thiz: usize): u8 {
  return 1u8;
}

@jni("dev.fern.files.Shared", "android.os.ParcelFileDescriptor openFile(android.net.Uri, java.lang.String)")
pub function shared_open(env: usize, thiz: usize, uri: usize, mode: usize): usize {
  return open.descriptor(env, uri);
}

@jni("dev.fern.files.Shared", "java.lang.String getType(android.net.Uri)")
pub function shared_type(env: usize, thiz: usize, uri: usize): usize {
  return open.kind(env, uri);
}

@jni("dev.fern.files.Shared", "android.database.Cursor query(android.net.Uri, java.lang.String[], java.lang.String, java.lang.String[], java.lang.String)")
pub function shared_query(env: usize, thiz: usize, uri: usize, columns: usize, selection: usize, values: usize, order: usize): usize {
  return open.row(env, uri);
}

// The provider is for reading only, so the three calls that change data
// change nothing.
@jni("dev.fern.files.Shared", "android.net.Uri insert(android.net.Uri, android.content.ContentValues)")
pub function shared_insert(env: usize, thiz: usize, uri: usize, values: usize): usize {
  return 0 as usize;
}

@jni("dev.fern.files.Shared", "int delete(android.net.Uri, java.lang.String, java.lang.String[])")
pub function shared_delete(env: usize, thiz: usize, uri: usize, selection: usize, values: usize): i32 {
  return 0;
}

@jni("dev.fern.files.Shared", "int update(android.net.Uri, android.content.ContentValues, java.lang.String, java.lang.String[])")
pub function shared_update(env: usize, thiz: usize, uri: usize, change: usize, selection: usize, values: usize): i32 {
  return 0;
}

const MAIN: string = "/storage/emulated/0";

function root(label: string, path: string): files.Root {
  let (total, free) = store.space(path).unwrap_or((0i64, 0i64));
  return files.Root { label: label, path: path, total: total, free: free };
}

// The storage of the phone, then each card or drive below /storage.
function roots(): files.Root[] {
  let out = [root("Phone storage", MAIN)];
  for name in read_dir("/storage").unwrap_or([]) {
    if (name != "emulated" && name != "self") {
      out = out.append(root("Card " + name, "/storage/" + name));
    }
  }
  return out;
}

// True when the app has access to all files. Without it Android shows the
// directories of a storage and hides their files.
function has_access(ctx: usize): boolean {
  let e = android.env(ctx);
  let environment = jni.find_class(e, "android/os/Environment");
  let method = jni.get_static_method_id(e, environment, "isExternalStorageManager", "()Z");
  let granted = (jni.invoke(e, jni.CALL_STATIC + 3, environment, method, 0 as usize) & 255 as usize) != 0 as usize;
  let class_ref = jni.delete_local_ref(e, environment);
  return jni.check(e).is_ok() && granted;
}

// Opens the screen of Android that gives this app access to all files.
function ask_access(ctx: usize): boolean {
  let e = android.env(ctx);
  let zero = 0 as usize;
  let uri_class = jni.find_class(e, "android/net/Uri");
  let parse = jni.get_static_method_id(e, uri_class, "parse", "(Ljava/lang/String;)Landroid/net/Uri;");
  let text = jni.new_string(e, "package:dev.fern.files");
  let args = jni.jvalues([text]);
  let uri = jni.call_static_object_method_a(e, uri_class, parse, args);
  jni.free_buffer(args);
  let text_ref = jni.delete_local_ref(e, text);
  let uri_ref = jni.delete_local_ref(e, uri_class);
  if (jni.check(e).is_err() || uri == zero) {
    return false;
  }
  let intent_class = jni.find_class(e, "android/content/Intent");
  let ctor = jni.get_method_id(e, intent_class, "<init>", "(Ljava/lang/String;Landroid/net/Uri;)V");
  let action = jni.new_string(e, "android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION");
  let init = jni.jvalues([action, uri]);
  let intent = jni.new_object_a(e, intent_class, ctor, init);
  jni.free_buffer(init);
  let action_ref = jni.delete_local_ref(e, action);
  let data_ref = jni.delete_local_ref(e, uri);
  let class_ref = jni.delete_local_ref(e, intent_class);
  if (jni.check(e).is_err() || intent == zero) {
    return false;
  }
  let ok = jni.call_void(e, android.activity_object(ctx), "startActivity", "(Landroid/content/Intent;)V", [intent]);
  let intent_ref = jni.delete_local_ref(e, intent);
  return ok;
}

// The image in `bytes`, at `wide` pixels across or less.
function picture(bytes: u8[], wide: i32): Option[draw.Image] {
  let (w, h) = image.size(bytes)?;
  let across = w.min(wide).max(1);
  return image.decode_cover(bytes, across, ((h as i64 * (across as i64) / (w.max(1) as i64)) as i32).max(1));
}

function app_main(ctx: usize): usize {
  let dir = android.no_backup_dir(ctx);
  // The copies of server files that other apps showed go at each start.
  let cache = android.cache_dir(ctx) + "/open";
  let cleared = remove_dir_all(cache);
  let made = create_dir_all(cache);
  let platform = files.Platform {
    roots: (): files.Root[] => roots(),
    access: (): boolean => has_access(ctx),
    ask_access: (): boolean => ask_access(ctx),
    save: (servers: files.Saved[]): boolean => vault.save(dir, android.env(ctx), servers),
    keep: (p: files.Prefs): boolean => prefs.save(dir, p),
    open: (path: string): boolean => open.view(ctx, path),
    share: (path: string): boolean => open.send(ctx, path),
    decode: (bytes: u8[], wide: i32): Option[draw.Image] => picture(bytes, wide),
  };
  let last = app.run(ctx, files.start(roots(), has_access(ctx), vault.load(dir, android.env(ctx)), cache, prefs.load(dir)), files.program(platform));
  return 0 as usize;
}
