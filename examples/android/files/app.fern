// A file explorer with no Java code of its own. NativeActivity loads this
// library and calls ANativeActivity_onCreate. std/android/ui/app runs the
// program of files.fern.
import "std/android";
import "std/android/launch";
import "std/android/ui/app";
import "std/jni";
import "std/result";
import "./files";
import "./store";
import "./vault";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

const MAIN: string = "/storage/emulated/0";

function root(label: string, path: string): files.Root {
  let (total, free) = store.space(path).unwrap_or((0i64, 0i64));
  return files.Root { label: label, path: path, total: total, free: free };
}

// The storage of the phone, then each card or drive below /storage.
function roots(): files.Root[] {
  let out = [root("Phone storage", MAIN)];
  for name in read_dir("/storage").unwrap_or([]) {
    if (name != "emulated" && name != "self") {
      out = out.append(root("Card " + name, "/storage/" + name));
    }
  }
  return out;
}

// Opens the screen of Android that gives this app access to all files.
function ask_access(ctx: usize): boolean {
  let e = android.env(ctx);
  let zero = 0 as usize;
  let uri_class = jni.find_class(e, "android/net/Uri");
  let parse = jni.get_static_method_id(e, uri_class, "parse", "(Ljava/lang/String;)Landroid/net/Uri;");
  let text = jni.new_string(e, "package:dev.fern.files");
  let args = jni.jvalues([text]);
  let uri = jni.call_static_object_method_a(e, uri_class, parse, args);
  jni.free_buffer(args);
  let text_ref = jni.delete_local_ref(e, text);
  let uri_ref = jni.delete_local_ref(e, uri_class);
  if (jni.check(e).is_err() || uri == zero) {
    return false;
  }
  let intent_class = jni.find_class(e, "android/content/Intent");
  let ctor = jni.get_method_id(e, intent_class, "<init>", "(Ljava/lang/String;Landroid/net/Uri;)V");
  let action = jni.new_string(e, "android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION");
  let init = jni.jvalues([action, uri]);
  let intent = jni.new_object_a(e, intent_class, ctor, init);
  jni.free_buffer(init);
  let action_ref = jni.delete_local_ref(e, action);
  let data_ref = jni.delete_local_ref(e, uri);
  let class_ref = jni.delete_local_ref(e, intent_class);
  if (jni.check(e).is_err() || intent == zero) {
    return false;
  }
  let ok = jni.call_void(e, android.activity_object(ctx), "startActivity", "(Landroid/content/Intent;)V", [intent]);
  let intent_ref = jni.delete_local_ref(e, intent);
  return ok;
}

function app_main(ctx: usize): usize {
  let dir = android.no_backup_dir(ctx);
  let platform = files.Platform {
    roots: (): files.Root[] => roots(),
    ask_access: (): boolean => ask_access(ctx),
    save: (servers: files.Saved[]): boolean => vault.save(dir, android.env(ctx), servers),
  };
  let last = app.run(ctx, files.start(roots(), vault.load(dir, android.env(ctx))), files.program(platform));
  return 0 as usize;
}
