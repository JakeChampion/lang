// The servers that the person saved. The file holds them sealed with a key
// of the Android Keystore, so a copy of the file gives no password.
import "std/android/keystore";
import "std/base64";
import "std/i32";
import "std/kv";
import "std/result";
import "std/utf8";
import "./files";
import "./smb";

const KEY: string = "fern-files.servers.v1";

const FILE: string = "/servers";

// The servers as text: a count, then the fields of each server. Each value
// is base64, so a password can hold each character.
pub function encode(servers: files.Saved[]): string {
  let store = kv.empty("").set("count", servers.len().to_string());
  for i in 0..servers.len() {
    let s = servers[i];
    let at = i.to_string() + ".";
    let fields = [("name", s.name), ("host", s.server.host), ("share", s.server.share), ("user", s.server.user), ("password", s.server.password), ("domain", s.server.domain)];
    for field in fields {
      store = store.set(at + field.0, base64.encode(field.1.bytes()));
    }
    store = store.set(at + "port", s.server.port.to_string());
  }
  return store.encode();
}

// The servers of the text that `encode` made. A server with no address is
// not a server, so the result does not have it.
pub function decode(text: string): files.Saved[] {
  let Ok(store) = kv.decode("", text) else {
    return [];
  };
  let field = (key: string): string => {
    if let Some(value) = store.get(key) {
      if let Ok(bytes) = base64.decode(value) {
        return utf8.from_bytes_lossy(bytes);
      }
    }
    return "";
  };
  let count = i32.parse_i32(store.get("count").unwrap_or("0")).unwrap_or(0);
  let out: files.Saved[] = [];
  for i in 0..count {
    let at = i.to_string() + ".";
    let port = i32.parse_i32(store.get(at + "port").unwrap_or("445")).unwrap_or(445);
    let server = smb.Server { host: field(at + "host"), port: port, share: field(at + "share"), user: field(at + "user"), password: field(at + "password"), domain: field(at + "domain") };
    if (server.host.len() > 0) {
      out = out.append(files.Saved { name: field(at + "name"), server: server });
    }
  }
  return out;
}

pub function load(dir: string, env: usize): files.Saved[] {
  let Ok(store) = kv.open(dir + FILE) else {
    return [];
  };
  let Some(sealed) = store.get("servers") else {
    return [];
  };
  let Ok(bytes) = base64.decode(sealed) else {
    return [];
  };
  let Ok(clear) = keystore.open(env, KEY, bytes) else {
    return [];
  };
  return decode(utf8.from_bytes_lossy(clear));
}

pub function save(dir: string, env: usize, servers: files.Saved[]): boolean {
  if (dir.len() == 0 || keystore.ensure_key(env, KEY).is_err()) {
    return false;
  }
  let Ok(sealed) = keystore.seal(env, KEY, encode(servers).bytes()) else {
    return false;
  };
  return kv.empty(dir + FILE).set("servers", base64.encode(sealed)).save().is_ok();
}
