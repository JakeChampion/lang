// Tests of the parts of the file explorer that do not need a screen: the
// hashes and the messages of the SMB sign-in, the paths, and the texts.
import "std/base64";
import "std/hex";
import "std/kv";
import "std/net";
import "std/test";
import "./dav";
import "./docs";
import "./files";
import "./md4";
import "./ntlm";
import "./open";
import "./pack";
import "./prefs";
import "./scan";
import "./smb";
import "./smb3";
import "./store";
import "./stream";
import "./vault";

// The first outcome that is a failure, or a pass.
function all(outcomes: test.TestOutcome[]): test.TestOutcome {
  for outcome in outcomes {
    if let test.Fail(_) = outcome {
      return outcome;
    }
  }
  return test.pass();
}

function holds(fact: boolean, otherwise: string): test.TestOutcome {
  return if (fact) { test.pass() } else { test.fail(otherwise) };
}

// The test vectors of RFC 1320.
function test_md4(): test.TestOutcome {
  let empty: u8[] = [];
  return all([
    test.assert_eq(hex.encode(md4.sum(empty)), "31d6cfe0d16ae931b73c59d7e0c089c0"),
    test.assert_eq(hex.encode(md4.sum("abc".bytes())), "a448017aaf21d8525fc10ae87aa6729d"),
    test.assert_eq(hex.encode(md4.sum("12345678901234567890123456789012345678901234567890123456789012345678901234567890".bytes())), "e33b4ddc9c38f2199c3e7b164fcc0536"),
  ]);
}

// The HMAC-MD5 vector of RFC 2202, and the NTOWFv2 key of MS-NLMP 4.2.4.
function test_ntlm_keys(): test.TestOutcome {
  return all([
    test.assert_eq(hex.encode(ntlm.hmac_md5("Jefe".bytes(), "what do ya want for nothing?".bytes())), "750c783e6ab0b503eaa86e310a5db738"),
    test.assert_eq(hex.encode(ntlm.v2_key("User", "Domain", "Password")), "0c868a403bfd7a93a3001ef22ef02e3f"),
    test.assert_eq(ntlm.text16(ntlm.utf16("Ünï cödé.txt")), "Ünï cödé.txt"),
  ]);
}

function test_challenge(): test.TestOutcome {
  let none = ntlm.challenge("not a message".bytes());
  let message = ntlm.negotiate();
  return all([holds(none.is_none(), "text that is not NTLM gave a challenge"), test.assert_eq(hex.encode(ntlm.part(message, 0, 8)), "4e544c4d53535000")]);
}

// One record of a directory listing: a directory with the name "docs".
function record(name: string, dir: boolean, size: i64, next: i32): u8[] {
  let wide = ntlm.utf16(name);
  let out = ntlm.put32(ntlm.put32([], next as i64), 0i64);
  // 2026-11-22 in the 100 ns units of Windows, for each of the four times.
  let time = (1795305600i64 + 11644473600i64) * 10000000i64;
  out = ntlm.put64(ntlm.put64(ntlm.put64(ntlm.put64(out, time), time), time), time);
  out = ntlm.put64(ntlm.put64(out, size), size);
  out = ntlm.put32(ntlm.put32(out, if (dir) { 16i64 } else { 32i64 }), wide.len() as i64);
  return out.concat(wide);
}

function test_listing(): test.TestOutcome {
  let first = record("..", true, 0i64, 0);
  let second = record("docs", true, 0i64, 0);
  let buffer = record("..", true, 0i64, first.len()).concat(record("docs", true, 0i64, second.len())).concat(record("a.txt", false, 1536i64, 0));
  let found = smb.entries(buffer);
  if (found.len() != 2) {
    return test.fail("the listing has " + found.len().to_string() + " entries");
  }
  return all([
    test.assert_eq(found[0].name, "docs"),
    holds(found[0].dir, "docs is not a directory"),
    test.assert_eq(found[1].name, "a.txt"),
    test.assert_eq(found[1].size, 1536i64),
    test.assert_eq(store.day_text(found[1].modified), "2026-11-22"),
  ]);
}

// A string of an RPC message, as a server writes it.
function wide_text(out: u8[], text: string): u8[] {
  let wide = ntlm.utf16(text).concat(ntlm.zeros(2));
  let count = (wide.len() / 2) as i64;
  let b = ntlm.put32(ntlm.put32(ntlm.put32(out, count), 0i64), count).concat(wide);
  return b.concat(ntlm.zeros((4 - b.len() % 4) % 4));
}

// The reply to NetrShareEnum with a disk share, a hidden share, the pipe
// share, and a disk share with no remark.
function test_shares(): test.TestOutcome {
  let stub = ntlm.put32(ntlm.put32(ntlm.put32(ntlm.put32(ntlm.put32(ntlm.put32([], 1i64), 1i64), 0x20000i64), 4i64), 0x20004i64), 4i64);
  let kinds = [0i64, 0x80000000i64, 0x80000003i64, 0i64];
  for i in 0..4 {
    stub = ntlm.put32(ntlm.put32(ntlm.put32(stub, 0x20008i64), kinds[i]), if (i == 3) { 0i64 } else { 0x2000ci64 });
  }
  stub = wide_text(wide_text(stub, "media"), "Films and music");
  stub = wide_text(wide_text(stub, "C$"), "Default share");
  stub = wide_text(wide_text(stub, "IPC$"), "IPC");
  stub = wide_text(stub, "Ünï");
  let request = smb.share_request("nas");
  let bind = smb.share_bind();
  return all([
    test.assert_eq(smb.share_names(stub).join(","), "media,Ünï"),
    test.assert_eq(smb.share_names([]).len(), 0),
    test.assert_eq(ntlm.get16(request, 8), request.len()),
    test.assert_eq(ntlm.get16(request, 22), 15),
    test.assert_eq(bind.len(), 72),
    test.assert_eq(hex.encode(ntlm.part(bind, 32, 48)), "c84f324b7016d30112785a47bf6ee188"),
  ]);
}

// A reply has a good signature only with the key, the flag and each byte.
function test_signature(): test.TestOutcome {
  let key = ntlm.zeros(15).append(7u8);
  let head = ntlm.put32(ntlm.zeros(16), 8i64).concat(ntlm.zeros(44));
  let framed = smb.sealed(head, "body".bytes(), key);
  let msg = ntlm.part(framed, 4, framed.len());
  let changed = msg.with(66, 0u8);
  let plain = smb.sealed(ntlm.zeros(64), "body".bytes(), key);
  return all([
    holds(smb.signed_by(msg, key), "a signed reply did not pass"),
    holds(!smb.signed_by(changed, key), "a changed reply passed"),
    holds(!smb.signed_by(msg, ntlm.zeros(16)), "a reply passed with another key"),
    holds(!smb.signed_by(ntlm.part(plain, 4, plain.len()), key), "a reply with no signature flag passed"),
  ]);
}

// A read takes what the server and the credits allow, and costs one credit
// for each 64 KiB.
function test_request_sizes(): test.TestOutcome {
  return all([
    test.assert_eq(smb.payload(8388608, 8388608, 256), 4194304),
    test.assert_eq(smb.payload(8388608, 1048576, 256), 1048576),
    test.assert_eq(smb.payload(8388608, 8388608, 3), 196608),
    test.assert_eq(smb.payload(8388608, 8388608, 0), 65536),
    test.assert_eq(smb.payload(100, 65536, 1), 100),
    test.assert_eq(smb.charge_of(0), 1),
    test.assert_eq(smb.charge_of(65536), 1),
    test.assert_eq(smb.charge_of(65537), 2),
    test.assert_eq(smb.charge_of(4194304), 64),
  ]);
}

// The AES-CMAC vectors of RFC 4493: no message, one block, 40 bytes.
function test_cmac(): test.TestOutcome {
  let key = hex.decode("2b7e151628aed2a6abf7158809cf4f3c").unwrap_or([]);
  let msg = hex.decode("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411").unwrap_or([]);
  let empty: u8[] = [];
  return all([
    test.assert_eq(hex.encode(smb3.cmac(key, empty)), "bb1d6929e95937287fa37d129b756746"),
    test.assert_eq(hex.encode(smb3.cmac(key, ntlm.part(msg, 0, 16))), "070a16b46b4d4144f79bdd9dd04a287c"),
    test.assert_eq(hex.encode(smb3.cmac(key, msg)), "dfa66747de9ae63030ca32611497c827"),
  ]);
}

// An encrypted message opens with its key, and not after a change.
function test_encrypted_message(): test.TestOutcome {
  let key = ntlm.zeros(15).append(9u8);
  let session = ntlm.put64([], 77i64);
  let Ok(wire) = smb3.seal(key, session, ntlm.zeros(11).append(1u8), "a request".bytes()) else {
    return test.fail("the message did not encrypt");
  };
  let back = smb3.open(key, wire);
  let changed = smb3.open(key, wire.with(60, wire[60] ^ 1u8));
  let other = smb3.open(ntlm.zeros(16), wire);
  return all([
    test.assert_eq(wire.len(), 52 + 9),
    test.assert_eq(hex.encode(ntlm.part(wire, 0, 4)), "fd534d42"),
    test.assert_eq(ntlm.get32(wire, 36), 9i64),
    holds(back.is_ok() && back.unwrap_or([]) == "a request".bytes(), "the message did not come back"),
    holds(changed.is_err(), "a changed message opened"),
    holds(other.is_err(), "a message opened with another key"),
  ]);
}

// The contexts of a negotiation, and the cipher that a reply picks.
function test_negotiation_contexts(): test.TestOutcome {
  let sent = smb3.contexts(ntlm.zeros(32));
  let reply = ntlm.put16(ntlm.zeros(6), 3).concat(ntlm.zeros(52));
  reply = ntlm.put32(reply, 128i64).concat(sent);
  return all([
    test.assert_eq(sent.len(), 48 + 16 + 16),
    test.assert_eq(ntlm.get16(sent, 0), 1),
    test.assert_eq(ntlm.get16(sent, 48), 2),
    test.assert_eq(smb3.cipher_of(reply), smb3.AES_128_GCM),
    test.assert_eq(smb3.signer_of(reply), smb3.AES_GMAC),
    test.assert_eq(smb3.cipher_of(ntlm.zeros(64)), 0),
    test.assert_eq(smb3.signer_of(ntlm.zeros(64)), smb3.AES_CMAC),
    test.assert_eq(smb3.gmac(ntlm.zeros(16), ntlm.zeros(64), true).len(), 16),
    holds(smb3.gmac(ntlm.zeros(16), ntlm.zeros(64), true) != smb3.gmac(ntlm.zeros(16), ntlm.zeros(64), false), "a request and a reply have one GMAC"),
    test.assert_eq(smb3.derived(ntlm.zeros(16), "SMBSigningKey\x00", ntlm.zeros(64)).len(), 16),
  ]);
}

// A scan finds the one address of its range that listens.
function test_scan(): test.TestOutcome {
  let Ok(listener) = net.listen_at(net.socket_addr(net.ipv4(127, 0, 0, 2), 0), net.listen_options()) else {
    return test.fail("no listener");
  };
  let port = net.local_port(listener).unwrap_or(0);
  let found = scan.open_hosts([127u8, 0u8, 0u8, 9u8], 1, 4, port, 300i64);
  let closed = tcp_close(listener);
  let none = scan.open_hosts([127u8, 0u8, 0u8, 9u8], 1, 4, port, 300i64);
  return all([test.assert_eq(found.join(","), "127.0.0.2"), test.assert_eq(none.len(), 0)]);
}

function test_paths(): test.TestOutcome {
  return all([
    test.assert_eq(smb.wire_path("/docs/a b.txt"), "docs\\a b.txt"),
    test.assert_eq(store.join("", "a"), "a"),
    test.assert_eq(store.join("/a/", "b"), "/a/b"),
    test.assert_eq(store.parent("/a/b/c"), "/a/b"),
    test.assert_eq(store.parent("a"), ""),
    test.assert_eq(store.base("/a/b c"), "b c"),
    test.assert_eq(store.free_name(["a.txt", "a (2).txt"], "a.txt"), "a (3).txt"),
    test.assert_eq(store.free_name(["docs"], "docs"), "docs (2)"),
  ]);
}

function test_types(): test.TestOutcome {
  return all([
    test.assert_eq(open.mime("Holiday.JPG"), "image/jpeg"),
    test.assert_eq(open.mime("/a/b.c/film.mkv"), "video/x-matroska"),
    test.assert_eq(open.mime("notes"), "application/octet-stream"),
    test.assert_eq(open.mime("archive.tar.xyz"), "application/octet-stream"),
  ]);
}

function test_prefs(): test.TestOutcome {
  let pin = files.Mark { label: "Films = \"best\"", path: "/storage/emulated/0/Movies", server: "" };
  let recent = files.Mark { label: "a.mkv", path: "films/a.mkv", server: "NAS" };
  let back = prefs.decode(prefs.encode(files.Prefs { sort: 2, hidden: true, grid: true, pins: [pin], recent: [recent, pin] }));
  let first = prefs.decode("not a store");
  return all([
    test.assert_eq(back.sort, 2),
    holds(back.hidden && back.grid, "hidden and grid did not come back"),
    test.assert_eq(back.pins.len(), 1),
    test.assert_eq(back.pins[0].label, "Films = \"best\""),
    test.assert_eq(back.recent[0].server, "NAS"),
    test.assert_eq(back.recent[0].path, "films/a.mkv"),
    test.assert_eq(first.sort + first.pins.len(), 0),
  ]);
}

// No name of an archive puts a file outside the folder of the extraction.
function test_archive_names(): test.TestOutcome {
  return all([
    test.assert_eq(pack.safe_parts("../../etc/passwd").join("/"), "etc/passwd"),
    test.assert_eq(pack.safe_parts("/abs/./x").join("/"), "abs/x"),
    test.assert_eq(pack.safe_parts("a\\..\\b.txt").join("/"), "a/b.txt"),
    test.assert_eq(pack.safe_parts("..").len(), 0),
  ]);
}

// The range of a header in a file of 1000 bytes, as text.
function span(header: string): string {
  if let Some((first, last)) = stream.range_of(header, 1000i64) {
    return first.to_string() + "-" + last.to_string();
  }
  return "none";
}

function test_ranges(): test.TestOutcome {
  return all([
    test.assert_eq(span("bytes=0-99"), "0-99"),
    test.assert_eq(span("bytes=500-"), "500-999"),
    test.assert_eq(span("bytes=-10"), "990-999"),
    test.assert_eq(span("bytes=900-5000"), "900-999"),
    test.assert_eq(span("bytes=1000-"), "none"),
    test.assert_eq(span("bytes=5-2"), "none"),
    test.assert_eq(span("bytes=0-1,5-6"), "none"),
    test.assert_eq(span("lines=1-2"), "none"),
    test.assert_eq(stream.path_of("abc", "My film (1).mkv"), "/abc/My_film__1_.mkv"),
    test.assert_eq(stream.address(8080, "t", "a.mp3"), "http://127.0.0.1:8080/t/a.mp3"),
    holds(open.plays("a.MKV") && open.plays("b.flac") && !open.plays("c.pdf"), "the wrong files play"),
  ]);
}

function shown(v: docs.Value): string {
  return match (v) {
    docs.Text(text) => text,
    docs.Number(n) => n.to_string(),
    docs.Empty => "-",
  };
}

// The rows that the file picker of the system gets for a server and for
// its files, and the IDs of its documents.
function test_documents(): test.TestOutcome {
  let nas = files.Saved { name: "Films", link: store.Smb(smb.Server { host: "nas", port: 445, share: "media", user: "", password: "", domain: "" }) };
  let file = smb.Entry { name: "a b.mkv", dir: false, size: 77i64, modified: 1000i64 };
  let folder = smb.Entry { name: "x", dir: true, size: 0i64, modified: 0i64 };
  let root = ["root_id", "title", "summary", "document_id", "icon", "flags", "other"].map((c: string): string => shown(docs.root_value(c, 2, nas, 9))).join("|");
  let one = ["document_id", "_display_name", "mime_type", "last_modified", "_size", "flags"].map((c: string): string => shown(docs.document_value(c, 2, "dir/a b.mkv", file))).join("|");
  let dir = ["mime_type", "last_modified", "_size"].map((c: string): string => shown(docs.document_value(c, 2, "x", folder))).join("|");
  let (at, path) = docs.document_of("2:dir/a:b.mkv").unwrap_or((-1, ""));
  return all([
    test.assert_eq(root, "2|Films|smb://nas/media|2:|9|1|-"),
    test.assert_eq(one, "2:dir/a b.mkv|a b.mkv|video/x-matroska|1000000|77|6"),
    test.assert_eq(dir, docs.DIRECTORY + "|-|-"),
    test.assert_eq(at.to_string() + " " + path, "2 dir/a:b.mkv"),
    holds(docs.document_of("x:1").is_none() && docs.document_of("nothing").is_none() && docs.document_of("-1:a").is_none(), "a bad ID gave a document"),
  ]);
}

// How the mode `mode` of openDocument writes, as a word.
function mode_word(mode: string): string {
  let Ok(how) = docs.write_mode(mode) else {
    return "bad";
  };
  let Some(keep) = how else {
    return "read";
  };
  return if (keep) { "keep" } else { "empty" };
}

// What the picker may do with a document, where a new document goes, how
// a mode of openDocument writes, and the record of an upload.
function test_document_writes(): test.TestOutcome {
  let modes = ["r", "w", "wt", "rwt", "wa", "rw"].map(mode_word).join(",");
  let u = docs.Upload { saved_dir: "/data/user/0/dev.fern.files/no_backup", server: 3, path: "Films/new film.mkv", copy: "/data/user/0/dev.fern.files/cache/documents/3-new film.mkv" };
  let back = docs.upload_of(docs.upload_text(u)).map((b: docs.Upload): string => b.saved_dir + "|" + b.server.to_string() + "|" + b.path + "|" + b.copy).unwrap_or("none");
  return all([
    test.assert_eq(docs.document_flags("", true), 8i64),
    test.assert_eq(docs.document_flags("Films", true), 12i64),
    test.assert_eq(docs.document_flags("Films/a.mkv", false), 6i64),
    test.assert_eq(docs.created_path("Films", ["a.mkv", "b.txt"], "c.txt"), "Films/c.txt"),
    test.assert_eq(docs.created_path("Films", ["a.mkv", "b.txt"], "b.txt"), "Films/b (2).txt"),
    test.assert_eq(docs.created_path("", [], "../x.txt"), "x.txt"),
    test.assert_eq(modes, "read,empty,empty,empty,keep,keep"),
    test.assert_eq(docs.partial_path("Films/a.mkv"), "Films/.a.mkv.fern-upload"),
    test.assert_eq(docs.partial_path("a.mkv"), ".a.mkv.fern-upload"),
    holds(docs.write_mode("x").is_err(), "an unknown mode must be an error"),
    test.assert_eq(back, u.saved_dir + "|3|" + u.path + "|" + u.copy),
    holds(docs.upload_of("").is_none() && docs.upload_of("a\nb\nc\nd").is_none() && docs.upload_of("a\n1\nc").is_none(), "a bad record gave an upload"),
  ]);
}

function test_trash_names(): test.TestOutcome {
  let name = store.trash_name(1795377562000i64, "/storage/emulated/0/Ünï dir", "a~b.txt");
  let (dir, base) = store.trashed(name).unwrap_or(("", ""));
  return all([
    test.assert_eq(dir, "/storage/emulated/0/Ünï dir"),
    test.assert_eq(base, "a~b.txt"),
    holds(!name.contains("/"), "the name of an item of the trash has a slash"),
    holds(store.trashed("plain.txt").is_none() && store.trashed("1~!!~x").is_none(), "a plain name read as an item of the trash"),
  ]);
}

function test_texts(): test.TestOutcome {
  return all([
    test.assert_eq(store.size_text(5i64), "5 B"),
    test.assert_eq(store.size_text(1536i64), "1.5 KB"),
    test.assert_eq(store.size_text(128849018880i64), "120 GB"),
    test.assert_eq(store.day_text(0i64), ""),
    test.assert_eq(store.day_text(951782400i64), "2000-02-29"),
  ]);
}

// A copy of a directory in steps of 1 MiB gives the same bytes.
function test_copy(): test.TestOutcome {
  let Ok(dir) = temp_dir("fern-files") else {
    return test.fail("no temp dir");
  };
  let big: u8[] = [];
  for i in 0..150000 {
    big = big.append((i % 251) as u8);
  }
  let block = big;
  for i in 0..4 {
    big = big.concat(block).concat(block);
  }
  let made = store.make_dir(store.Local, dir + "/src").is_ok() && store.make_dir(store.Local, dir + "/src/in").is_ok() && store.make_dir(store.Local, dir + "/dst").is_ok();
  let wrote = write_file_bytes(dir + "/src/in/big.bin", big).is_ok() && write_file_bytes(dir + "/src/in/empty", []).is_ok();
  let Ok(items) = store.list(store.Local, dir + "/src") else {
    return test.fail("no listing");
  };
  let Ok(steps) = store.plan(store.Local, dir + "/src", items, store.Local, dir + "/dst") else {
    return test.fail("no plan");
  };
  for step in steps {
    let offset = 0i64;
    while (true) {
      let Ok(n) = store.advance(store.Local, store.Local, step, offset) else {
        return test.fail("a step failed");
      };
      offset += n;
      if (step.dir || n < store.STEP as i64) {
        break;
      }
    }
  }
  let copy = read_file_bytes(dir + "/dst/in/big.bin").unwrap_or([]);
  let empty = read_file_bytes(dir + "/dst/in/empty");
  let removed = remove_dir_all(dir);
  return all([
    holds(made && wrote, "the files of the test are not there"),
    test.assert_eq(steps.len(), 3),
    test.assert_eq(copy.len(), big.len()),
    holds(copy == big, "the copy has different bytes"),
    holds(empty.is_ok(), "the copy has no empty file"),
  ]);
}

// The smb.Server of a saved server, or an empty one for a WebDAV server.
function smb_of(s: files.Saved): smb.Server {
  return match (s.link) {
    store.Smb(x) => x,
    store.Dav(_) => smb.Server { host: "", port: 0, share: "", user: "", password: "", domain: "" },
  };
}

function test_vault(): test.TestOutcome {
  let server = smb.Server { host: "nas.local", port: 4450, share: "media", user: "jo", password: "p=1\n\"é#", domain: "HOME" };
  let web = dav.Server { url: "https://cloud.example/remote.php/dav/files/jo", user: "jo", password: "a b=c", pin: "0aff" };
  let back = vault.decode(vault.encode([files.Saved { name: "Films = here", link: store.Smb(server) }, files.Saved { name: "", link: store.Smb(smb.Server { ...server, host: "" }) }, files.Saved { name: "Cloud", link: store.Dav(web) }]));
  if (back.len() != 2) {
    return test.fail("the vault gave " + back.len().to_string() + " servers");
  }
  let cloud = match (back[1].link) {
    store.Dav(x) => x.url + "|" + x.user + "|" + x.password + "|" + x.pin,
    store.Smb(_) => "smb",
  };
  // A server that an older Fern Files saved has no kind and is SMB.
  let old = vault.decode(kv.empty("").set("count", "1").set("0.name", base64.encode("NAS".bytes())).set("0.host", base64.encode("nas".bytes())).set("0.share", base64.encode("media".bytes())).set("0.port", "445").encode());
  return all([
    test.assert_eq(back[0].name, "Films = here"),
    test.assert_eq(smb_of(back[0]).password, "p=1\n\"é#"),
    test.assert_eq(smb_of(back[0]).port, 4450),
    test.assert_eq(smb_of(back[0]).domain, "HOME"),
    test.assert_eq(back[1].name + "|" + cloud, "Cloud|https://cloud.example/remote.php/dav/files/jo|jo|a b=c|0aff"),
    test.assert_eq(old.len() == 1 && smb_of(old[0]).share == "media" && smb_of(old[0]).port == 445, true),
    test.assert_eq(vault.decode("not a store").len(), 0),
  ]);
}

function main(): i32 {
  let r = test.new("Fern Files protocol");
  r = r.it("MD4 gives the hashes of RFC 1320", test_md4);
  r = r.it("the NTLMv2 key follows the specification", test_ntlm_keys);
  r = r.it("the sign-in messages have the NTLM mark", test_challenge);
  r = r.it("a directory listing gives its entries without . and ..", test_listing);
  r = r.it("the reply to a share question gives the disk shares", test_shares);
  r = r.it("a reply passes only with its signature", test_signature);
  r = r.it("a request takes what the credits pay for", test_request_sizes);
  r = r.it("AES-CMAC gives the values of RFC 4493", test_cmac);
  r = r.it("an encrypted message opens only with its key", test_encrypted_message);
  r = r.it("a negotiation names its hash and its cipher", test_negotiation_contexts);
  r = r.it("a scan finds the address that listens", test_scan);
  r = r.it("paths join, split and get free names", test_paths);
  r = r.it("a file name gives its media type", test_types);
  r = r.it("the preferences survive their file", test_prefs);
  r = r.it("an archive name stays below its folder", test_archive_names);
  r = r.it("a range request names the bytes of a file", test_ranges);
  r = r.it("the file picker gets rows for servers and files", test_documents);
  r = r.it("the file picker may make, write and delete documents", test_document_writes);
  r = r.it("an item of the trash keeps its folder and its name", test_trash_names);
  r = r.it("sizes and days read well", test_texts);
  r = r.it("a copy in steps keeps each byte", test_copy);
  r = r.it("the saved servers survive the vault", test_vault);
  return r.finish();
}
