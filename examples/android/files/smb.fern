// An SMB client, from MS-SMB2: the files of a share on a Windows computer,
// a NAS or a Samba server. It speaks the dialects from 2.0.2 to 3.1.1 and
// signs in with NTLMv2. After the sign-in it signs each request, and with
// the 3.1.1 dialect it encrypts each request.
//
// A socket cannot go from one worker to the next, so each function here
// makes its own connection: it connects, signs in, opens the share, does
// its work and closes.
import "std/array";
import "std/crypto";
import "std/dns";
import "std/i32";
import "std/i64";
import "std/net";
import "std/rand";
import "std/result";
import "std/time";
import "./ntlm";
import "./smb3";

pub struct Server { host: string, port: i32, share: string, user: string, password: string, domain: string }

// A file or a directory of a share. `modified` is in seconds from 1970.
pub struct Entry { name: string, dir: boolean, size: i64, modified: i64 }

// A part of a file, and the size of the whole file.
pub struct Part { data: u8[], size: i64 }

// What a connection keeps from one request to the next. `credits` is the
// count of 64 KiB units that the server lets the client send, and
// `most_read` and `most_write` are the most bytes of one read and one write.
// `signer` is the signature of the session: HMAC_SHA256, smb3.AES_CMAC or
// smb3.AES_GMAC. `seal_key` and `open_key` are the keys of the encrypted
// messages, or are empty.
struct State { session: u8[], tree: u8[], next: i64, key: u8[], signs: boolean, credits: i32, most_read: i32, most_write: i32, dialect: i32, signer: i32, seal_key: u8[], open_key: u8[] }

// A reply: its status and what follows its header of 64 bytes. `sent` and
// `raw` are the whole request and the whole reply, for the sign-in hash.
struct Answer { status: i64, body: u8[], tree: u8[], session: u8[], sent: u8[], raw: u8[] }

struct Opened { id: u8[], size: i64 }

const NEGOTIATE: i32 = 0;

const SESSION_SETUP: i32 = 1;

const TREE_CONNECT: i32 = 3;

const CREATE: i32 = 5;

const CLOSE: i32 = 6;

const READ: i32 = 8;

const WRITE: i32 = 9;

const QUERY_DIRECTORY: i32 = 14;

const SET_INFO: i32 = 17;

const OK: i64 = 0i64;

const PENDING: i64 = 0x103i64;

const MORE_PROCESSING: i64 = 0xc0000016i64;

const NO_MORE_FILES: i64 = 0x80000006i64;

const END_OF_FILE: i64 = 0xc0000011i64;

// A read gave a part of a message of a pipe, and the pipe has more.
const BUFFER_OVERFLOW: i64 = 0x80000005i64;

// The capability of the 2.1 dialect for a read or a write of more than
// 64 KiB.
const LARGE_MTU: i64 = 4i64;

// The capability of the 3.0 dialects for encrypted messages.
const ENCRYPTION: i64 = 0x40i64;

// The signature of a session of a dialect before 3.0.
const HMAC_SHA256: i32 = 0;

const SMB_2_0_2: i32 = 0x0202;

const SMB_2_1: i32 = 0x0210;

const SMB_3_0: i32 = 0x0300;

const SMB_3_0_2: i32 = 0x0302;

const SMB_3_1_1: i32 = 0x0311;

// The credits that each request asks the server for.
const WANTED_CREDITS: i32 = 256;

// The most credits that one request costs: 64 of them are 4 MiB.
const MOST_CHARGE: i32 = 64;

// The bytes that one credit pays for. A request of this size costs one
// credit in each dialect.
pub const CHUNK: i32 = 65536;

// The seconds between 1601, where a Windows file time starts, and 1970.
const EPOCH_GAP: i64 = 11644473600i64;

const WAIT_SECONDS: i64 = 20i64;

// What each status of a reply means, for a person.
const MEANINGS: (i64, string)[] = [
  (0xc000006di64, "The user name or the password is wrong."),
  (0xc000006ai64, "The user name or the password is wrong."),
  (0xc0000064i64, "The user name or the password is wrong."),
  (0xc0000022i64, "The server refused access."),
  (0xc00000cci64, "The server has no share with that name."),
  (0xc0000034i64, "The server has no such file or folder."),
  (0xc000003ai64, "The server has no such file or folder."),
  (0xc000000fi64, "The server has no such file or folder."),
  (0xc0000035i64, "That name is in use already."),
  (0xc0000101i64, "The folder is not empty."),
  (0xc0000043i64, "Another program uses the file."),
  (0xc000007fi64, "The share is full."),
  (0xc00000bbi64, "The server accepts no SMB dialect that this app speaks."),
];

pub function status_text(status: i64): string {
  for meaning in MEANINGS {
    if (meaning.0 == status) {
      return meaning.1;
    }
  }
  return "The server gave the error " + status.to_hex() + ".";
}

function send_all(sock: Socket, data: u8[]): boolean {
  let rest = data;
  while (rest.len() > 0) {
    let sent = tcp_send_bytes(sock, rest);
    if (sent <= 0) {
      return false;
    }
    rest = array.drop(rest, sent);
  }
  return true;
}

function receive(sock: Socket, n: i32): Result[u8[], string] {
  let out: u8[] = [];
  while (out.len() < n) {
    match (net.read_deadline(sock, n - out.len(), time.duration_seconds(WAIT_SECONDS))) {
      Ok(net.Chunk(bytes)) => {
        if (bytes.len() == 0) {
          return Err("The server closed the connection.");
        }
        out = out.concat(bytes);
      },
      Ok(_) => {
        return Err("The server did not answer in time.");
      },
      Err(e) => {
        return Err("The connection failed: " + e.message());
      }
    }
  }
  return Ok(out);
}

// The path of a share as SMB writes it: with backslashes, and with none at
// its start or its end.
pub function wire_path(path: string): string {
  let parts = path.split("/").filter((p: string): boolean => p.len() > 0);
  return parts.join("\\");
}

function header(st: State, command: i32, flags: i64, charge: i32): u8[] {
  let h: u8[] = [254, 83, 77, 66];
  h = ntlm.put16(ntlm.put16(h, 64), if (command == NEGOTIATE) { 0 } else { charge });
  h = ntlm.put16(ntlm.put16(ntlm.put32(h, 0i64), command), WANTED_CREDITS);
  h = ntlm.put64(ntlm.put32(ntlm.put32(h, flags), 0i64), st.next);
  return ntlm.put32(h, 0i64).concat(st.tree).concat(st.session).concat(ntlm.zeros(16));
}

// The request as it goes on the wire: with its signature when the session
// signs, and with the 4 bytes of its length before it.
pub function sealed(head: u8[], body: u8[], key: u8[]): u8[] {
  let msg = head.concat(body);
  if (key.len() > 0) {
    let mac = crypto.hmac_sha256(key, msg);
    msg = ntlm.part(msg, 0, 48).concat(ntlm.part(mac, 0, 16)).concat(array.drop(msg, 64));
  }
  let n = msg.len();
  let frame: u8[] = [0u8, (n >> 16 & 255) as u8, (n >> 8 & 255) as u8, (n & 255) as u8];
  return frame.concat(msg);
}

// True when the reply `msg` has the HMAC-SHA256 signature of `key`.
pub function signed_by(msg: u8[], key: u8[]): boolean {
  return marked(msg, key, HMAC_SHA256);
}

// The 16 bytes that sign `msg` with the signature `signer`.
function mark(msg: u8[], key: u8[], signer: i32, reply: boolean): u8[] {
  if (signer == smb3.AES_GMAC) {
    return smb3.gmac(key, msg, reply);
  }
  if (signer == smb3.AES_CMAC) {
    return smb3.cmac(key, msg);
  }
  return ntlm.part(crypto.hmac_sha256(key, msg), 0, 16);
}

function marked(msg: u8[], key: u8[], signer: i32): boolean {
  if (msg.len() < 64 || (ntlm.get32(msg, 16) & 8i64) == 0i64) {
    return false;
  }
  let clear = ntlm.part(msg, 0, 48).concat(ntlm.zeros(16)).concat(array.drop(msg, 64));
  return mark(clear, key, signer, true) == ntlm.part(msg, 48, 64);
}

// The request as it goes on the wire, with no length before it: encrypted
// when the session has a key for that, or else signed when the session
// signs.
function wire(st: State, head: u8[], body: u8[]): Result[u8[], string] {
  let msg = head.concat(body);
  if (st.seal_key.len() > 0) {
    return smb3.seal(st.seal_key, st.session, rand.bytes(12), msg);
  }
  if (st.signs) {
    return Ok(ntlm.part(msg, 0, 48).concat(mark(msg, st.key, st.signer, false)).concat(array.drop(msg, 64)));
  }
  return Ok(msg);
}

function framed(msg: u8[]): u8[] {
  let n = msg.len();
  let frame: u8[] = [0u8, (n >> 16 & 255) as u8, (n >> 8 & 255) as u8, (n & 255) as u8];
  return frame.concat(msg);
}

// The bytes of one read or one write: `want`, but no more than the server
// takes in one request, and no more than the credits pay for.
pub function payload(want: i32, most: i32, credits: i32): i32 {
  return want.min(most).min(credits.max(1).min(MOST_CHARGE) * CHUNK).max(0);
}

// The credits that a request with `bytes` of data costs.
pub function charge_of(bytes: i32): i32 {
  return ((bytes + CHUNK - 1) / CHUNK).max(1);
}

function request(sock: Socket, st: State, command: i32, body: u8[]): (State, Result[Answer, string]) {
  return charged(sock, st, command, body, 1);
}

// Sends one request that costs `charge` credits and reads its reply. The
// server can send a reply that says that the work goes on: the reply after
// it is the result. Each reply gives the client more credits.
function charged(sock: Socket, st: State, command: i32, body: u8[], charge: i32): (State, Result[Answer, string]) {
  let after = State { ...st, next: st.next + charge as i64, credits: st.credits - charge };
  let head = header(st, command, if (st.signs && st.seal_key.len() == 0) { 8i64 } else { 0i64 }, charge);
  let Ok(sent) = wire(st, head, body) else {
    return (after, Err("The app could not encrypt a request."));
  };
  if (!send_all(sock, framed(sent))) {
    return (after, Err("The connection to the server broke."));
  }
  while (true) {
    let Ok(size) = receive(sock, 4) else {
      return (after, Err("The server did not answer."));
    };
    let n = size[1] as i32 << 16 | size[2] as i32 << 8 | size[3] as i32;
    match (opened(st, receive(sock, n))) {
      Ok(msg) => {
        if (msg.len() < 64 || msg[0] != 254u8 || msg[1] != 83u8) {
          return (after, Err("The server sent a reply that is not SMB 2."));
        }
        let status = ntlm.get32(msg, 8);
        after = State { ...after, credits: after.credits + ntlm.get16(msg, 14) };
        if (status == PENDING) {
          continue;
        }
        if (st.signs && st.seal_key.len() == 0 && !marked(msg, st.key, st.signer)) {
          return (after, Err("The server sent a reply with a wrong signature."));
        }
        return (after, Ok(Answer { status: status, body: array.drop(msg, 64), tree: ntlm.part(msg, 36, 40), session: ntlm.part(msg, 40, 48), sent: sent, raw: msg }));
      },
      Err(e) => {
        return (after, Err(e));
      }
    }
  }
  return (after, Err("The server did not answer."));
}

// The reply as the server wrote it: an encrypted reply opens with the key
// of the session. A session that encrypts takes no reply in the clear.
function opened(st: State, got: Result[u8[], string]): Result[u8[], string] {
  let msg = got?;
  if (st.open_key.len() == 0) {
    return Ok(msg);
  }
  if (msg.len() < 4 || ntlm.part(msg, 0, 4) != smb3.TRANSFORM) {
    return Err("The server sent a reply in the clear on an encrypted session.");
  }
  return smb3.open(st.open_key, msg);
}

// The reply, when its status is `want`, or what its status means.
function expect(got: Result[Answer, string], want: i64): Result[Answer, string] {
  match (got) {
    Ok(a) => {
      if (a.status != want) {
        return Err(status_text(a.status));
      }
      return Ok(a);
    },
    Err(e) => {
      return Err(e);
    }
  }
}

// The NTLM message in a security buffer. A server can put it in an SPNEGO
// token, and the message then starts at its signature.
function ntlm_message(blob: u8[]): u8[] {
  let sign: u8[] = [78, 84, 76, 77, 83, 83, 80, 0];
  let at = 0;
  while (at + 8 <= blob.len()) {
    if (ntlm.part(blob, at, at + 8) == sign) {
      return array.drop(blob, at);
    }
    at += 1;
  }
  return blob;
}

// The state with the sizes of the reply to the negotiation. A server of
// the 2.1 dialect with large requests takes more than 64 KiB in one read or
// one write, and each 64 KiB costs one credit.
function sized(st: State, body: u8[]): State {
  if (body.len() < 40 || ntlm.get16(body, 4) < SMB_2_1 || (ntlm.get32(body, 24) & LARGE_MTU) == 0i64) {
    return st;
  }
  let limit = (MOST_CHARGE * CHUNK) as i64;
  return State { ...st, most_read: ntlm.get32(body, 32).min(limit).max(CHUNK as i64) as i32, most_write: ntlm.get32(body, 36).min(limit).max(CHUNK as i64) as i32 };
}

// The request that offers each dialect. The contexts at its end are for
// the 3.1.1 dialect, and a server of an older dialect does not read them.
function hello(): u8[] {
  let dialects = [SMB_2_0_2, SMB_2_1, SMB_3_0, SMB_3_0_2, SMB_3_1_1];
  let b = ntlm.put32(ntlm.put16(ntlm.put16(ntlm.put16(ntlm.put16([], 36), dialects.len()), 1), 0), LARGE_MTU | ENCRYPTION).concat(rand.bytes(16));
  let fixed = 64 + 36 + dialects.len() * 2;
  let pad = (8 - fixed % 8) % 8;
  b = ntlm.put16(ntlm.put16(ntlm.put32(b, (fixed + pad) as i64), smb3.CONTEXTS), 0);
  for dialect in dialects {
    b = ntlm.put16(b, dialect);
  }
  return b.concat(ntlm.zeros(pad)).concat(smb3.contexts(rand.bytes(32)));
}

// The state with the keys of a session that signed in with the key `key`.
// `hash` is the hash of the sign-in messages, which the 3.1.1 dialect puts
// in each key. `terms` is the reply to the negotiation: with 3.1.1 it
// names the signature, and the session encrypts when it names AES-128-GCM.
function keyed(st: State, key: u8[], hash: u8[], terms: u8[]): State {
  if (st.dialect < SMB_3_0) {
    return State { ...st, key: key, signs: true };
  }
  if (st.dialect < SMB_3_1_1) {
    return State { ...st, key: smb3.derived(key, "SMB2AESCMAC\x00", "SmbSign\x00".bytes()), signs: true, signer: smb3.AES_CMAC };
  }
  let signed = State { ...st, key: smb3.derived(key, "SMBSigningKey\x00", hash), signs: true, signer: smb3.signer_of(terms) };
  if (smb3.cipher_of(terms) != smb3.AES_128_GCM) {
    return signed;
  }
  return State { ...signed, seal_key: smb3.derived(key, "SMBC2SCipherKey\x00", hash), open_key: smb3.derived(key, "SMBS2CCipherKey\x00", hash) };
}

function session_body(blob: u8[]): u8[] {
  let b = ntlm.put16([], 25).append(0u8).append(1u8);
  b = ntlm.put16(ntlm.put16(ntlm.put32(ntlm.put32(b, 0i64), 0i64), 88), blob.len());
  return ntlm.put64(b, 0i64).concat(blob);
}

// Agrees the dialect, signs in and opens the share. It gives the state of
// the connection.
function sign_in(sock: Socket, s: Server): Result[State, string] {
  let st = State { session: ntlm.zeros(8), tree: ntlm.zeros(4), next: 0i64, key: [], signs: false, credits: 1, most_read: CHUNK, most_write: CHUNK, dialect: 0, signer: HMAC_SHA256, seal_key: [], open_key: [] };
  let (st0, agreed) = request(sock, st, NEGOTIATE, hello());
  let terms = expect(agreed, OK)?;
  let dialect = ntlm.get16(terms.body, 4);
  let st1 = State { ...sized(st0, terms.body), dialect: dialect };
  let hash = smb3.hashed(smb3.hashed(ntlm.zeros(64), terms.sent), terms.raw);
  let (st2, asked) = request(sock, st1, SESSION_SETUP, session_body(ntlm.negotiate()));
  let first = expect(asked, MORE_PROCESSING)?;
  let offset = ntlm.get16(first.body, 4) - 64;
  let token = ntlm_message(ntlm.part(first.body, offset, offset + ntlm.get16(first.body, 6)));
  let Some(challenge) = ntlm.challenge(token) else {
    return Err("The server sent a sign-in challenge that is not NTLM.");
  };
  let now = (now_unix_ms() / 1000i64 + EPOCH_GAP) * 10000000i64;
  let reply = ntlm.authenticate(challenge, s.user, s.domain, s.password, rand.bytes(8), now);
  let st3 = State { ...st2, session: first.session };
  let (st4, answered) = request(sock, st3, SESSION_SETUP, session_body(reply.message));
  let done = expect(answered, OK)?;
  let guest = (ntlm.get16(done.body, 2) & 3) != 0;
  let st5 = st4;
  if (s.user.len() > 0 && !guest) {
    st5 = keyed(st4, reply.key, smb3.hashed(smb3.hashed(smb3.hashed(hash, first.sent), first.raw), done.sent), terms.body);
  }
  let path = ntlm.utf16("\\\\" + s.host + "\\" + s.share);
  let tree = ntlm.put16(ntlm.put16(ntlm.put16(ntlm.put16([], 9), 0), 72), path.len()).concat(path);
  let (st6, connected) = request(sock, st5, TREE_CONNECT, tree);
  let share = expect(connected, OK)?;
  return Ok(State { ...st6, tree: share.tree });
}

// Runs `work` on a connection to the share of `s`, and closes it.
function with_share[T](s: Server, work: (Socket, State) => Result[T, string]): Result[T, string] {
  if (s.host.len() == 0 || s.share.len() == 0) {
    return Err("Give the name of the server and of the share.");
  }
  match (dns.dial(s.host, if (s.port > 0) { s.port } else { 445 }, dns.dial_options())) {
    Ok(sock) => {
      let out: Result[T, string] = Err("");
      match (sign_in(sock, s)) {
        Ok(st) => {
          out = work(sock, st);
        },
        Err(e) => {
          out = Err(e);
        }
      }
      let closed = tcp_close(sock);
      return out;
    },
    Err(e) => {
      return Err("Could not reach " + s.host + ": " + e.message());
    }
  }
}

// Opens the file or the directory `path` of the share.
function open(sock: Socket, st: State, path: string, access: i64, disposition: i64, options: i64, attributes: i64): (State, Result[Opened, string]) {
  let name = ntlm.utf16(wire_path(path));
  let b = ntlm.put16([], 57).append(0u8).append(0u8);
  b = ntlm.put64(ntlm.put64(ntlm.put32(b, 2i64), 0i64), 0i64);
  b = ntlm.put32(ntlm.put32(ntlm.put32(ntlm.put32(ntlm.put32(b, access), attributes), 7i64), disposition), options);
  b = ntlm.put32(ntlm.put32(ntlm.put16(ntlm.put16(b, 120), name.len()), 0i64), 0i64);
  b = if (name.len() > 0) { b.concat(name) } else { b.append(0u8) };
  let (after, got) = request(sock, st, CREATE, b);
  match (expect(got, OK)) {
    Ok(a) => {
      return (after, Ok(Opened { id: ntlm.part(a.body, 64, 80), size: ntlm.get64(a.body, 48) }));
    },
    Err(e) => {
      return (after, Err(e));
    }
  }
}

function close(sock: Socket, st: State, id: u8[]): (State, Result[Answer, string]) {
  let (after, got) = request(sock, st, CLOSE, ntlm.put32(ntlm.put16(ntlm.put16([], 24), 0), 0i64).concat(id));
  return (after, expect(got, OK));
}

// The entries of one reply of a directory query, with no "." and "..".
pub function entries(buffer: u8[]): Entry[] {
  let out: Entry[] = [];
  let at = 0;
  while (at + 64 <= buffer.len()) {
    let next = ntlm.get32(buffer, at) as i32;
    let length = ntlm.get32(buffer, at + 60) as i32;
    let name = ntlm.text16(ntlm.part(buffer, at + 64, at + 64 + length));
    if (name != "." && name != "..") {
      let written = ntlm.get64(buffer, at + 24) / 10000000i64 - EPOCH_GAP;
      out = out.append(Entry { name: name, dir: (ntlm.get32(buffer, at + 56) & 16i64) != 0i64, size: ntlm.get64(buffer, at + 40), modified: written.max(0i64) });
    }
    if (next <= 0) {
      break;
    }
    at += next;
  }
  return out;
}

function listed(sock: Socket, st: State, path: string): (State, Result[Entry[], string]) {
  let (st1, opened) = open(sock, st, path, 0x100081i64, 1i64, 0x21i64, 0i64);
  let Ok(dir) = opened else {
    return (st1, Err(opened.err().unwrap_or("")));
  };
  let out: Entry[] = [];
  let state = st1;
  let first = true;
  let failure = "";
  while (true) {
    let q = ntlm.put16([], 33).append(1u8).append(if (first) { 1u8 } else { 0u8 });
    q = ntlm.put32(ntlm.put16(ntlm.put16(ntlm.put32(q, 0i64).concat(dir.id), 96), 2), CHUNK as i64).concat(ntlm.utf16("*"));
    let (next, got) = request(sock, state, QUERY_DIRECTORY, q);
    state = next;
    first = false;
    match (got) {
      Ok(a) => {
        if (a.status == NO_MORE_FILES) {
          break;
        }
        if (a.status != OK) {
          failure = status_text(a.status);
          break;
        }
        let offset = ntlm.get16(a.body, 2) - 64;
        out = out.concat(entries(ntlm.part(a.body, offset, offset + ntlm.get32(a.body, 4) as i32)));
      },
      Err(e) => {
        failure = e;
        break;
      }
    }
  }
  let (last, closed) = close(sock, state, dir.id);
  if (failure.len() > 0) {
    return (last, Err(failure));
  }
  return (last, Ok(out));
}

// The files and the directories of the directory `path` of the share. An
// empty path is the top of the share.
pub function list(s: Server, path: string): Result[Entry[], string] {
  return with_share(s, (sock: Socket, st: State): Result[Entry[], string] => {
    let (after, got) = listed(sock, st, path);
    return got;
  });
}

// At most `limit` bytes of the file `path` from the byte `offset`, and the
// size of the file. The part is empty at the end of the file.
pub function read(s: Server, path: string, offset: i64, limit: i32): Result[Part, string] {
  return with_share(s, (sock: Socket, st: State): Result[Part, string] => {
    let (st1, opened) = open(sock, st, path, 0x120089i64, 1i64, 0x60i64, 0i64);
    let file = opened?;
    let data: u8[] = [];
    let state = st1;
    let failure = "";
    while (data.len() < limit) {
      let want = payload(limit - data.len(), state.most_read, state.credits);
      let q = ntlm.put64(ntlm.put32(ntlm.put16([], 49).append(80u8).append(0u8), want as i64), offset + data.len() as i64).concat(file.id);
      q = ntlm.put16(ntlm.put16(ntlm.put32(ntlm.put32(ntlm.put32(q, 0i64), 0i64), 0i64), 0), 0).append(0u8);
      let (next, got) = charged(sock, state, READ, q, charge_of(want));
      state = next;
      match (got) {
        Ok(a) => {
          if (a.status == END_OF_FILE) {
            break;
          }
          if (a.status != OK) {
            failure = status_text(a.status);
            break;
          }
          let at = a.body[2] as i32 - 64;
          let bytes = ntlm.part(a.body, at, at + ntlm.get32(a.body, 4) as i32);
          if (bytes.len() == 0) {
            break;
          }
          data = data.concat(bytes);
        },
        Err(e) => {
          failure = e;
          break;
        }
      }
    }
    let (last, closed) = close(sock, state, file.id);
    if (failure.len() > 0) {
      return Err(failure);
    }
    return Ok(Part { data: data, size: file.size });
  });
}

// A string of an RPC message: its counts, its characters with the 0 at
// the end, and zeros up to a multiple of 4 bytes.
function rpc_string(out: u8[], text: string): u8[] {
  let wide = ntlm.utf16(text).concat(ntlm.zeros(2));
  let count = (wide.len() / 2) as i64;
  let b = ntlm.put32(ntlm.put32(ntlm.put32(out, count), 0i64), count).concat(wide);
  return b.concat(ntlm.zeros((4 - b.len() % 4) % 4));
}

function rpc_head(kind: i32, length: i32): u8[] {
  let b: u8[] = [5u8, 0u8, kind as u8, 3u8, 16u8, 0u8, 0u8, 0u8];
  return ntlm.put32(ntlm.put16(ntlm.put16(b, length), 0), 1i64);
}

// The RPC message that binds a pipe to the server service, with NDR.
pub function share_bind(): u8[] {
  let service: u8[] = [0xc8, 0x4f, 0x32, 0x4b, 0x70, 0x16, 0xd3, 0x01, 0x12, 0x78, 0x5a, 0x47, 0xbf, 0x6e, 0xe1, 0x88];
  let ndr: u8[] = [0x04, 0x5d, 0x88, 0x8a, 0xeb, 0x1c, 0xc9, 0x11, 0x9f, 0xe8, 0x08, 0x00, 0x2b, 0x10, 0x48, 0x60];
  let b = ntlm.put32(ntlm.put32(ntlm.put16(ntlm.put16(rpc_head(11, 72), 4280), 4280), 0i64), 1i64);
  b = ntlm.put16(ntlm.put16(ntlm.put16(b, 0), 1).concat(service), 3);
  return ntlm.put32(ntlm.put16(b, 0).concat(ndr), 2i64);
}

// The RPC message that asks the server `host` for its shares: the call
// NetrShareEnum at the level 1.
pub function share_request(host: string): u8[] {
  let stub = rpc_string(ntlm.put32([], 0x20000i64), "\\\\" + host);
  stub = ntlm.put32(ntlm.put32(ntlm.put32(ntlm.put32(ntlm.put32(stub, 1i64), 1i64), 0x20004i64), 0i64), 0i64);
  stub = ntlm.put32(ntlm.put32(stub, 0xffffffffi64), 0i64);
  let head = ntlm.put16(ntlm.put16(ntlm.put32(rpc_head(0, 24 + stub.len()), stub.len() as i64), 0), 15);
  return head.concat(stub);
}

// The string of an RPC message at the byte `at`, and the byte after it.
function rpc_text(stub: u8[], at: i32): (string, i32) {
  let count = ntlm.get32(stub, at + 8) as i32;
  let end = at + 12 + count * 2;
  let text = ntlm.text16(ntlm.part(stub, at + 12, end - 2));
  return (text, end + (4 - end % 4) % 4);
}

// The names of the disk shares in the reply to `share_request`, with no
// share whose name ends in "$".
pub function share_names(stub: u8[]): string[] {
  if (stub.len() < 24 || ntlm.get32(stub, 8) == 0i64 || ntlm.get32(stub, 16) == 0i64) {
    return [];
  }
  let count = ntlm.get32(stub, 12) as i32;
  let at = 24 + count * 12;
  let out: string[] = [];
  for i in 0..count {
    if (at + 12 > stub.len()) {
      break;
    }
    let kind = ntlm.get32(stub, 24 + i * 12 + 4);
    let (name, after) = rpc_text(stub, at);
    at = after;
    if (ntlm.get32(stub, 24 + i * 12 + 8) != 0i64) {
      let (remark, next) = rpc_text(stub, at);
      at = next;
    }
    if ((kind & 0xffffi64) == 0i64 && !name.ends_with("$")) {
      out = out.append(name);
    }
  }
  return out;
}

// Sends `message` on the pipe `id` and reads the RPC message that answers:
// each of its parts, up to the last one.
function pipe_call(sock: Socket, st: State, id: u8[], message: u8[]): (State, Result[u8[], string]) {
  let q = ntlm.put64(ntlm.put32(ntlm.put16(ntlm.put16([], 49), 112), message.len() as i64), 0i64).concat(id);
  q = ntlm.put32(ntlm.put16(ntlm.put16(ntlm.put32(ntlm.put32(q, 0i64), 0i64), 0), 0), 0i64).concat(message);
  let (wrote, sent) = request(sock, st, WRITE, q);
  if let Err(e) = expect(sent, OK) {
    return (wrote, Err(e));
  }
  let state = wrote;
  let stub: u8[] = [];
  let part: u8[] = [];
  while (true) {
    let r = ntlm.put64(ntlm.put32(ntlm.put16([], 49).append(80u8).append(0u8), CHUNK as i64), 0i64).concat(id);
    r = ntlm.put16(ntlm.put16(ntlm.put32(ntlm.put32(ntlm.put32(r, 0i64), 0i64), 0i64), 0), 0).append(0u8);
    let (next, got) = request(sock, state, READ, r);
    state = next;
    let Ok(a) = got else {
      return (state, Err(got.err().unwrap_or("")));
    };
    if (a.status != OK && a.status != BUFFER_OVERFLOW) {
      return (state, Err(status_text(a.status)));
    }
    let at = a.body[2] as i32 - 64;
    part = part.concat(ntlm.part(a.body, at, at + ntlm.get32(a.body, 4) as i32));
    if (part.len() < 16 || part.len() < ntlm.get16(part, 8)) {
      continue;
    }
    if (part[2] != 2u8) {
      return (state, Ok(part));
    }
    stub = stub.concat(ntlm.part(part, 24, ntlm.get16(part, 8)));
    if ((part[3] & 2u8) != 0u8) {
      return (state, Ok(stub));
    }
    part = array.drop(part, ntlm.get16(part, 8));
  }
  return (state, Err("The server did not answer."));
}

// The names of the disk shares of the server. The `share` of `s` has no
// effect: the question goes to the pipe of the server service.
pub function shares(s: Server): Result[string[], string] {
  return with_share(Server { ...s, share: "IPC$" }, (sock: Socket, st: State): Result[string[], string] => {
    let (st1, opened) = open(sock, st, "srvsvc", 0x12019fi64, 1i64, 0x40i64, 0i64);
    let pipe = opened?;
    let (st2, bound) = pipe_call(sock, st1, pipe.id, share_bind());
    let ack = bound?;
    if (ack.len() < 3 || ack[2] != 12u8) {
      return Err("The server does not list its shares.");
    }
    let (st3, answered) = pipe_call(sock, st2, pipe.id, share_request(s.host));
    let (last, closed) = close(sock, st3, pipe.id);
    return Ok(share_names(answered?));
  });
}

// Writes `data` to the file `path` from the byte `offset`. A write from
// the byte 0 makes the file, or empties the file that is there.
pub function write(s: Server, path: string, offset: i64, data: u8[]): Result[void, string] {
  return with_share(s, (sock: Socket, st: State): Result[void, string] => {
    let (st1, opened) = open(sock, st, path, 0x120116i64, if (offset == 0i64) { 5i64 } else { 1i64 }, 0x60i64, 0x80i64);
    let file = opened?;
    let state = st1;
    let done = 0;
    let failure = "";
    while (done < data.len()) {
      let bytes = ntlm.part(data, done, done + payload(data.len() - done, state.most_write, state.credits));
      let q = ntlm.put64(ntlm.put32(ntlm.put16(ntlm.put16([], 49), 112), bytes.len() as i64), offset + done as i64).concat(file.id);
      q = ntlm.put32(ntlm.put16(ntlm.put16(ntlm.put32(ntlm.put32(q, 0i64), 0i64), 0), 0), 0i64).concat(bytes);
      let (next, got) = charged(sock, state, WRITE, q, charge_of(bytes.len()));
      state = next;
      if let Err(e) = expect(got, OK) {
        failure = e;
        break;
      }
      done += bytes.len();
    }
    let (last, closed) = close(sock, state, file.id);
    if (failure.len() > 0) {
      return Err(failure);
    }
    return Ok(());
  });
}

// Makes the directory `path`.
pub function make_dir(s: Server, path: string): Result[void, string] {
  return with_share(s, (sock: Socket, st: State): Result[void, string] => {
    let (st1, opened) = open(sock, st, path, 0x100081i64, 2i64, 0x21i64, 0x10i64);
    let dir = opened?;
    let (last, closed) = close(sock, st1, dir.id);
    return Ok(());
  });
}

// Removes one file or one empty directory: the server deletes it when the
// handle closes.
function removed(sock: Socket, st: State, path: string, dir: boolean): (State, Result[void, string]) {
  let (st1, opened) = open(sock, st, path, 0x10080i64, 1i64, if (dir) { 0x1001i64 } else { 0x1040i64 }, 0i64);
  let Ok(it) = opened else {
    return (st1, Err(opened.err().unwrap_or("")));
  };
  let (last, closed) = close(sock, st1, it.id);
  match (closed) {
    Ok(_) => {
      return (last, Ok(()));
    },
    Err(e) => {
      return (last, Err(e));
    }
  }
}

// Removes a directory after each thing that it holds.
function removed_tree(sock: Socket, st: State, path: string): (State, Result[void, string]) {
  let (st1, got) = listed(sock, st, path);
  let Ok(items) = got else {
    return (st1, Err(got.err().unwrap_or("")));
  };
  let state = st1;
  for item in items {
    let child = path + "/" + item.name;
    let (next, gone) = if (item.dir) { removed_tree(sock, state, child) } else { removed(sock, state, child, false) };
    state = next;
    if let Err(e) = gone {
      return (state, Err(e));
    }
  }
  return removed(sock, state, path, true);
}

// Removes the file `path`, or the directory `path` and all that it holds.
pub function remove(s: Server, path: string, dir: boolean): Result[void, string] {
  return with_share(s, (sock: Socket, st: State): Result[void, string] => {
    let (after, got) = if (dir) { removed_tree(sock, st, path) } else { removed(sock, st, path, false) };
    return got;
  });
}

// Gives the file or the directory `from` the path `to` in the same share.
pub function rename(s: Server, from: string, to: string): Result[void, string] {
  return with_share(s, (sock: Socket, st: State): Result[void, string] => {
    let (st1, opened) = open(sock, st, from, 0x110080i64, 1i64, 0i64, 0i64);
    let it = opened?;
    let name = ntlm.utf16(wire_path(to));
    let info = ntlm.put32(ntlm.put64(ntlm.zeros(8), 0i64), name.len() as i64).concat(name);
    let q = ntlm.put32(ntlm.put16([], 33).append(1u8).append(10u8), info.len() as i64);
    q = ntlm.put32(ntlm.put16(ntlm.put16(q, 96), 0), 0i64).concat(it.id).concat(info);
    let (st2, got) = request(sock, st1, SET_INFO, q);
    let (last, closed) = close(sock, st2, it.id);
    expect(got, OK)?;
    return Ok(());
  });
}
