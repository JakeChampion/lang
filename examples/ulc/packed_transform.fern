// Packed float SIMD for the decoder. Lapping retains double precision.
import "std/array";
import "std/f64";
import "./transform";

pub struct Plan { prepared: boolean, shape: transform.Plan, cosine: u8[], sine: u8[], triple_cos: u8[], triple_sin: u8[], pre_cos: u8[], pre_sin: u8[], merge_cos: u8[], merge_sin: u8[], post_cos: u8[], post_sin: u8[], window_cos: u8[], window_sin: u8[] }

pub struct Scratch { re: u8[], im: u8[], transformed: f64[], samples: f64[] }

pub struct Inverse { lap: f64[], work: Scratch }

pub function deferred(n: i32): Plan {
  let shape = transform.Plan { n: n, reversal: [], pre_cos: [], pre_sin: [], post_cos: [], post_sin: [], fft_cos: [], fft_sin: [], window_cos: [], window_sin: [] };
  return Plan { prepared: false, shape: shape, cosine: [], sine: [], triple_cos: [], triple_sin: [], pre_cos: [], pre_sin: [], merge_cos: [], merge_sin: [], post_cos: [], post_sin: [], window_cos: [], window_sin: [] };
}

pub function is_deferred(p: Plan): boolean {
  return !p.prepared && p.shape.n >= 16 && p.shape.n <= 32768 && (p.shape.n & p.shape.n - 1) == 0
    && p.shape.reversal.len() == 0 && p.shape.pre_cos.len() == 0 && p.shape.pre_sin.len() == 0
    && p.shape.post_cos.len() == 0 && p.shape.post_sin.len() == 0 && p.shape.fft_cos.len() == 0 && p.shape.fft_sin.len() == 0
    && p.shape.window_cos.len() == 0 && p.shape.window_sin.len() == 0 && p.cosine.len() == 0 && p.sine.len() == 0
    && p.triple_cos.len() == 0 && p.triple_sin.len() == 0 && p.pre_cos.len() == 0 && p.pre_sin.len() == 0
    && p.merge_cos.len() == 0 && p.merge_sin.len() == 0 && p.post_cos.len() == 0 && p.post_sin.len() == 0
    && p.window_cos.len() == 0 && p.window_sin.len() == 0;
}

function pack(values: [f64]): u8[] {
  let out = __alloc_u8((values.len() + 3) / 4 * 16);
  let i = 0;
  while (i < values.len()) {
    let a = values[i];
    let b = if (i + 1 < values.len()) { values[i + 1] } else { 0.0 };
    let c = if (i + 2 < values.len()) { values[i + 2] } else { 0.0 };
    let d = if (i + 3 < values.len()) { values[i + 3] } else { 0.0 };
    out = __f32x4_with_bytes(out, 4 * i, __f32x4_pack(__f64x2_of(a, b), __f64x2_of(c, d)));
    i += 4;
  }
  return out;
}

pub function plan(n: i32): Plan {
  let p = transform.plan(n);
  let quarter = n / 8;
  let cosine = __alloc_u8((quarter - 1) * 16);
  let sine = __alloc_u8((quarter - 1) * 16);
  let triple_cos = __alloc_u8((quarter - 1) * 16);
  let triple_sin = __alloc_u8((quarter - 1) * 16);
  for k in 0..quarter - 1 {
    cosine = __f32x4_with_bytes(cosine, 16 * k, __f32x4_splat(p.fft_cos[k] as f32));
    sine = __f32x4_with_bytes(sine, 16 * k, __f32x4_splat(p.fft_sin[k] as f32));
    let c = p.fft_cos[k];
    let t = p.fft_sin[k];
    triple_cos = __f32x4_with_bytes(triple_cos, 16 * k, __f32x4_splat((c * (c * c - 3.0 * t * t)) as f32));
    triple_sin = __f32x4_with_bytes(triple_sin, 16 * k, __f32x4_splat((t * (3.0 * c * c - t * t)) as f32));
  }
  let merge_cos = __alloc_u8(quarter * 16);
  let merge_sin = __alloc_u8(quarter * 16);
  let post_cos = __alloc_u8(quarter * 16);
  let post_sin = __alloc_u8(quarter * 16);
  for k in 0..quarter {
    let offset = n / 4 - 1;
    let third = 3 * k;
    let sign = 1.0;
    if (third >= n / 4) {
      third -= n / 4;
      sign = -1.0;
    }
    merge_cos = __f32x4_with_bytes(merge_cos, 16 * k, __f32x4_of(1.0 as f32, p.fft_cos[offset + k] as f32, p.fft_cos[offset + 2 * k] as f32, (sign * p.fft_cos[offset + third]) as f32));
    merge_sin = __f32x4_with_bytes(merge_sin, 16 * k, __f32x4_of(0.0 as f32, p.fft_sin[offset + k] as f32, p.fft_sin[offset + 2 * k] as f32, (sign * p.fft_sin[offset + third]) as f32));
    post_cos = __f32x4_with_bytes(post_cos, 16 * k, __f32x4_of(p.post_cos[k] as f32, p.post_cos[k + 2 * quarter] as f32, p.post_cos[k + quarter] as f32, p.post_cos[k + 3 * quarter] as f32));
    post_sin = __f32x4_with_bytes(post_sin, 16 * k, __f32x4_of(p.post_sin[k] as f32, p.post_sin[k + 2 * quarter] as f32, p.post_sin[k + quarter] as f32, p.post_sin[k + 3 * quarter] as f32));
  }
  return Plan { prepared: true, shape: p, cosine: cosine, sine: sine, triple_cos: triple_cos, triple_sin: triple_sin, pre_cos: pack(p.pre_cos), pre_sin: pack(p.pre_sin), merge_cos: merge_cos, merge_sin: merge_sin, post_cos: post_cos, post_sin: post_sin, window_cos: pack(p.window_cos), window_sin: pack(p.window_sin) };
}

pub function scratch(n: i32): Scratch {
  return Scratch { re: __alloc_u8(2 * n), im: __alloc_u8(2 * n), transformed: transform.zeros(n), samples: transform.zeros(n) };
}

// Four interleaved FFTs share each SIMD butterfly and need no lane shuffle.
pub function dct4(input: [f64], p: Plan, own work: Scratch, scaled: boolean = false): Scratch {
  if (scaled) {
    // Exact binary scaling avoids float subnormal operations in tiny noise tails.
    let input_scaled = transform.zeros(p.shape.n);
    for i in 0..p.shape.n {
      input_scaled = input_scaled.with(i, input[i] * 79228162514264337593543950336.0);
    }
    work = dct4(input_scaled, p, work, false);
    let Scratch { re, im, transformed, samples } = work;
    for i in 0..p.shape.n {
      transformed = transformed.with(i, transformed[i] * 1.2621774483536189e-29);
    }
    return Scratch { re: re, im: im, transformed: transformed, samples: samples };
  }
  let Scratch { re, im, transformed, samples } = work;
  let n = p.shape.n;
  let half = n / 2;
  let quarter = half / 4;
  if (!p.prepared || n < 16 || n > 32768 || (n & n - 1) != 0 || input.len() < n || transformed.len() < n || re.len() < 2 * n || im.len() < 2 * n || p.cosine.len() < 16 * (quarter - 1) || p.sine.len() < 16 * (quarter - 1) || p.triple_cos.len() < 16 * (quarter - 1) || p.triple_sin.len() < 16 * (quarter - 1) || p.merge_cos.len() < 2 * n || p.merge_sin.len() < 2 * n || p.post_cos.len() < 2 * n || p.post_sin.len() < 2 * n) {
    eprint("invalid packed FFT dimensions");
    exit(1);
  }
  let re_address = 0 as usize;
  let im_address = 0 as usize;
  unsafe {
    // Keep retained scratch buffers unchanged. Each vector span is below 2 * n.
    if (__load_i32(re as usize - 8 as usize) != 1) {
      re = __send_copy(re);
    }
    if (__load_i32(im as usize - 8 as usize) != 1) {
      im = __send_copy(im);
    }
    if (__load_i32(transformed as usize - 8 as usize) != 1) {
      transformed = __send_copy(transformed);
    }
    re_address = re as usize + 8 as usize;
    im_address = im as usize + 8 as usize;
  }
  unsafe {
    for group in 0..quarter {
      let j = p.shape.reversal[group];
      let a = __f32x4_pack(__f64x2_of(input[2 * j], input[2 * j + 2]), __f64x2_of(input[2 * j + 4], input[2 * j + 6]));
      let b = __f32x4_pack(__f64x2_of(input[n - 1 - 2 * j], input[n - 3 - 2 * j]), __f64x2_of(input[n - 5 - 2 * j], input[n - 7 - 2 * j]));
      let c = __f32x4_load_bytes(p.pre_cos, 4 * j);
      let t = __f32x4_load_bytes(p.pre_sin, 4 * j);
      __f32x4_store(re_address + (16 * group) as usize, __f32x4_mul_add(a, c, b * t));
      __f32x4_store(im_address + (16 * group) as usize, __f32x4_mul_add(a, t, -(b * c)));
    }
    execute[0](p, re_address, im_address, transformed as usize + 8 as usize);
  }

  return Scratch { re: re, im: im, transformed: transformed, samples: samples };
}

// Each FFT span contains 2 * n bytes. The output contains n floats or doubles.
function execute[const PACKED: i32](p: Plan, re_address: usize, im_address: usize, address: usize): void {
  let packed = PACKED != 0;
  let n = p.shape.n;
  let quarter = n / 8;
  unsafe {
    let cosine_address = p.cosine as usize + 8 as usize;
    let sine_address = p.sine as usize + 8 as usize;
    let merge_cos_address = p.merge_cos as usize + 8 as usize;
    let merge_sin_address = p.merge_sin as usize + 8 as usize;
    let width = if (packed) { 4 } else { 2 };
    while (width <= quarter) {
      if (width * 2 <= quarter) {
        radix4(p, re_address, im_address, width);
        width *= 4;
        continue;
      }
      let twiddle = width / 2 - 1;
      let base = 0;
      while (base < quarter) {
        let first = 16 * base;
        let second = first + 8 * width;
        let first_re = __f32x4_load_ptr(re_address + first as usize);
        let first_im = __f32x4_load_ptr(im_address + first as usize);
        let second_re = __f32x4_load_ptr(re_address + second as usize);
        let second_im = __f32x4_load_ptr(im_address + second as usize);
        __f32x4_store(re_address + first as usize, first_re + second_re);
        __f32x4_store(im_address + first as usize, first_im + second_im);
        __f32x4_store(re_address + second as usize, first_re - second_re);
        __f32x4_store(im_address + second as usize, first_im - second_im);
        for k in 1..width / 2 {
          let a = 16 * (base + k);
          let b = a + 8 * width;
          let c = __f32x4_load_ptr(cosine_address + (16 * (twiddle + k)) as usize);
          let t = __f32x4_load_ptr(sine_address + (16 * (twiddle + k)) as usize);
          let br = __f32x4_load_ptr(re_address + b as usize);
          let bi = __f32x4_load_ptr(im_address + b as usize);
          let vr = __f32x4_mul_add(br, c, -(bi * t));
          let vi = __f32x4_mul_add(br, t, bi * c);
          let ar = __f32x4_load_ptr(re_address + a as usize);
          let ai = __f32x4_load_ptr(im_address + a as usize);
          __f32x4_store(re_address + a as usize, ar + vr);
          __f32x4_store(im_address + a as usize, ai + vi);
          __f32x4_store(re_address + b as usize, ar - vr);
          __f32x4_store(im_address + b as usize, ai - vi);
        }
        base += width;
      }
      width *= 2;
    }
    let signs = __f32x4_of(-(1.0 as f32), 1.0 as f32, -(1.0 as f32), 1.0 as f32);
    for k in 0..quarter {
      let r = __f32x4_load_ptr(re_address + (16 * k) as usize);
      let i = __f32x4_load_ptr(im_address + (16 * k) as usize);
      let c = __f32x4_load_ptr(merge_cos_address + (16 * k) as usize);
      let t = __f32x4_load_ptr(merge_sin_address + (16 * k) as usize);
      let rr = __f32x4_mul_add(r, c, -(i * t));
      let ii = __f32x4_mul_add(r, t, i * c);
      let a = __f32x4_zip_lo(rr, ii);
      let b = __f32x4_zip_hi(rr, ii);
      let sum = a + b;
      let diff = a - b;
      let other = __f32x4_swap_halves(sum);
      let rotated = __f32x4_reverse(diff) * signs;
      let lo = __f32x4_zip_lo(sum + other, diff + rotated);
      let hi = __f32x4_zip_lo(sum - other, diff - rotated);
      let real = __f32x4_zip_lo(lo, hi);
      let imag = __f32x4_zip_hi(lo, hi);
      let pc = __f32x4_load_bytes(p.post_cos, 16 * k);
      let ps = __f32x4_load_bytes(p.post_sin, 16 * k);
      let left = __f32x4_mul_add(real, pc, -(imag * ps));
      let right = __f32x4_mul_add(real, ps, imag * pc);
      if (packed && quarter >= 4) {
        // Reuse FFT scratch for the two rotations before output transposition.
        __f32x4_store(re_address + (16 * k) as usize, left);
        __f32x4_store(im_address + (16 * k) as usize, right);
      } else {
        put_post(address, n, k, __f32x4_lane(left, 0), __f32x4_lane(right, 0), packed);
        put_post(address, n, k + 2 * quarter, __f32x4_lane(left, 1), __f32x4_lane(right, 1), packed);
        put_post(address, n, k + quarter, __f32x4_lane(left, 2), __f32x4_lane(right, 2), packed);
        put_post(address, n, k + 3 * quarter, __f32x4_lane(left, 3), __f32x4_lane(right, 3), packed);
      }
    }
    if (packed && quarter >= 4) {
      let k = 0;
      while (k < quarter) {
        packed_post(address, re_address, im_address, quarter, k);
        k += 4;
      }
    }
  }
}

@inline
function radix4_zero(re: usize, im: usize, step: i32): void {
  unsafe {
    let ar = __f32x4_load_ptr(re);
    let ai = __f32x4_load_ptr(im);
    let br = __f32x4_load_ptr(re + step as usize);
    let bi = __f32x4_load_ptr(im + step as usize);
    let er = ar + br;
    let ei = ai + bi;
    let fr = ar - br;
    let fi = ai - bi;
    let cr = __f32x4_load_ptr(re + (2 * step) as usize);
    let ci = __f32x4_load_ptr(im + (2 * step) as usize);
    let dr = __f32x4_load_ptr(re + (3 * step) as usize);
    let di = __f32x4_load_ptr(im + (3 * step) as usize);
    let gr = cr + dr;
    let gi = ci + di;
    let hr = cr - dr;
    let hi = ci - di;
    __f32x4_store(re, er + gr);
    __f32x4_store(im, ei + gi);
    __f32x4_store(re + (2 * step) as usize, er - gr);
    __f32x4_store(im + (2 * step) as usize, ei - gi);
    __f32x4_store(re + step as usize, fr - hi);
    __f32x4_store(im + step as usize, fi + hr);
    __f32x4_store(re + (3 * step) as usize, fr + hi);
    __f32x4_store(im + (3 * step) as usize, fi - hr);
  }
}

// Two FFT levels share their loads and need three complex rotations.
function radix4(p: Plan, re_address: usize, im_address: usize, width: i32): void {
  unsafe {
    let cosine = p.cosine as usize + 8 as usize;
    let sine = p.sine as usize + 8 as usize;
    let triple_cos = p.triple_cos as usize + 8 as usize;
    let triple_sin = p.triple_sin as usize + 8 as usize;
    let base = 0;
    while (base < p.shape.n / 8) {
      radix4_zero(re_address + (16 * base) as usize, im_address + (16 * base) as usize, 8 * width);
      for k in 1..width / 2 {
        let a = 16 * (base + k);
        let b = a + 8 * width;
        let c = a + 16 * width;
        let d = a + 24 * width;
        let c2 = __f32x4_load_ptr(cosine + (16 * (width / 2 - 1 + k)) as usize);
        let t2 = __f32x4_load_ptr(sine + (16 * (width / 2 - 1 + k)) as usize);
        let br = __f32x4_load_ptr(re_address + b as usize);
        let bi = __f32x4_load_ptr(im_address + b as usize);
        let vr = __f32x4_mul_add(br, c2, -(bi * t2));
        let vi = __f32x4_mul_add(br, t2, bi * c2);
        let ar = __f32x4_load_ptr(re_address + a as usize);
        let ai = __f32x4_load_ptr(im_address + a as usize);
        let er = ar + vr;
        let ei = ai + vi;
        let fr = ar - vr;
        let fi = ai - vi;
        let c1 = __f32x4_load_ptr(cosine + (16 * (width - 1 + k)) as usize);
        let t1 = __f32x4_load_ptr(sine + (16 * (width - 1 + k)) as usize);
        let cr = __f32x4_load_ptr(re_address + c as usize);
        let ci = __f32x4_load_ptr(im_address + c as usize);
        let wr = __f32x4_mul_add(cr, c1, -(ci * t1));
        let wi = __f32x4_mul_add(cr, t1, ci * c1);
        let c3 = __f32x4_load_ptr(triple_cos + (16 * (width - 1 + k)) as usize);
        let t3 = __f32x4_load_ptr(triple_sin + (16 * (width - 1 + k)) as usize);
        let dr = __f32x4_load_ptr(re_address + d as usize);
        let di = __f32x4_load_ptr(im_address + d as usize);
        let zr = __f32x4_mul_add(dr, c3, -(di * t3));
        let zi = __f32x4_mul_add(dr, t3, di * c3);
        let gr = wr + zr;
        let gi = wi + zi;
        let hr = wr - zr;
        let hi = wi - zi;
        __f32x4_store(re_address + a as usize, er + gr);
        __f32x4_store(im_address + a as usize, ei + gi);
        __f32x4_store(re_address + c as usize, er - gr);
        __f32x4_store(im_address + c as usize, ei - gi);
        __f32x4_store(re_address + b as usize, fr - hi);
        __f32x4_store(im_address + b as usize, fi + hr);
        __f32x4_store(re_address + d as usize, fr + hi);
        __f32x4_store(im_address + d as usize, fi - hr);
      }
      base += width * 2;
    }
  }
}

// The caller owns n input floats, n output floats, and two FFT spans of 2 * n bytes.
pub unsafe function dct4_packed(input: usize, output: usize, re_address: usize, im_address: usize, p: Plan): void {
  let n = p.shape.n;
  let half = n / 2;
  let quarter = n / 8;
  if (!p.prepared || n < 16 || n > 32768 || (n & n - 1) != 0 || p.shape.reversal.len() < quarter || p.pre_cos.len() < 2 * n || p.pre_sin.len() < 2 * n || p.cosine.len() < 16 * (quarter - 1) || p.sine.len() < 16 * (quarter - 1) || p.triple_cos.len() < 16 * (quarter - 1) || p.triple_sin.len() < 16 * (quarter - 1) || p.merge_cos.len() < 2 * n || p.merge_sin.len() < 2 * n || p.post_cos.len() < 2 * n || p.post_sin.len() < 2 * n) {
    eprint("invalid packed FFT dimensions");
    exit(1);
  }
  unsafe {
    for pair in 0..quarter / 2 {
      let group = pair * 2;
      let j0 = p.shape.reversal[group];
      if (j0 < 0 || j0 + 3 >= half) {
        eprint("invalid packed FFT reversal");
        exit(1);
      }
      let lo0 = __f32x4_load_ptr(input + (8 * j0) as usize);
      let hi0 = __f32x4_load_ptr(input + (8 * j0 + 16) as usize);
      let a0 = __f32x4_zip_lo(__f32x4_zip_lo(lo0, hi0), __f32x4_zip_hi(lo0, hi0));
      let tail_lo0 = __f32x4_load_ptr(input + (4 * (n - 8 - 2 * j0)) as usize);
      let tail_hi0 = __f32x4_load_ptr(input + (4 * (n - 4 - 2 * j0)) as usize);
      let b0 = __f32x4_reverse(__f32x4_zip_hi(__f32x4_zip_lo(tail_lo0, tail_hi0), __f32x4_zip_hi(tail_lo0, tail_hi0)));
      let c0 = __f32x4_load_bytes(p.pre_cos, 4 * j0);
      let t0 = __f32x4_load_bytes(p.pre_sin, 4 * j0);
      let r0 = __f32x4_mul_add(a0, c0, b0 * t0);
      let i0 = __f32x4_mul_add(a0, t0, -(b0 * c0));
      let j1 = p.shape.reversal[group + 1];
      if (j1 < 0 || j1 + 3 >= half) {
        eprint("invalid packed FFT reversal");
        exit(1);
      }
      let lo1 = __f32x4_load_ptr(input + (8 * j1) as usize);
      let hi1 = __f32x4_load_ptr(input + (8 * j1 + 16) as usize);
      let a1 = __f32x4_zip_lo(__f32x4_zip_lo(lo1, hi1), __f32x4_zip_hi(lo1, hi1));
      let tail_lo1 = __f32x4_load_ptr(input + (4 * (n - 8 - 2 * j1)) as usize);
      let tail_hi1 = __f32x4_load_ptr(input + (4 * (n - 4 - 2 * j1)) as usize);
      let b1 = __f32x4_reverse(__f32x4_zip_hi(__f32x4_zip_lo(tail_lo1, tail_hi1), __f32x4_zip_hi(tail_lo1, tail_hi1)));
      let c1 = __f32x4_load_bytes(p.pre_cos, 4 * j1);
      let t1 = __f32x4_load_bytes(p.pre_sin, 4 * j1);
      let r1 = __f32x4_mul_add(a1, c1, b1 * t1);
      let i1 = __f32x4_mul_add(a1, t1, -(b1 * c1));
      __f32x4_store(re_address + (16 * group) as usize, r0 + r1);
      __f32x4_store(im_address + (16 * group) as usize, i0 + i1);
      __f32x4_store(re_address + (16 * (group + 1)) as usize, r0 - r1);
      __f32x4_store(im_address + (16 * (group + 1)) as usize, i0 - i1);
    }
    execute[1](p, re_address, im_address, output);
  }
}

// Four adjacent FFT groups become eight contiguous stores.
@inline
unsafe function packed_post(address: usize, re: usize, im: usize, quarter: i32, k: i32): void {
  unsafe {
    let l0 = __f32x4_load_ptr(re + (16 * k) as usize);
    let l1 = __f32x4_load_ptr(re + (16 * (k + 1)) as usize);
    let l2 = __f32x4_load_ptr(re + (16 * (k + 2)) as usize);
    let l3 = __f32x4_load_ptr(re + (16 * (k + 3)) as usize);
    let lt0 = __f32x4_zip_lo(l0, l2);
    let lt1 = __f32x4_zip_lo(l1, l3);
    let lt2 = __f32x4_zip_hi(l0, l2);
    let lt3 = __f32x4_zip_hi(l1, l3);
    let lv0 = __f32x4_zip_lo(lt0, lt1);
    let lv1 = __f32x4_zip_hi(lt0, lt1);
    let lv2 = __f32x4_zip_lo(lt2, lt3);
    let lv3 = __f32x4_zip_hi(lt2, lt3);
    let r0 = __f32x4_load_ptr(im + (16 * (quarter - 4 - k)) as usize);
    let r1 = __f32x4_load_ptr(im + (16 * (quarter - 4 - k + 1)) as usize);
    let r2 = __f32x4_load_ptr(im + (16 * (quarter - 4 - k + 2)) as usize);
    let r3 = __f32x4_load_ptr(im + (16 * (quarter - 4 - k + 3)) as usize);
    let rt0 = __f32x4_zip_lo(r0, r2);
    let rt1 = __f32x4_zip_lo(r1, r3);
    let rt2 = __f32x4_zip_hi(r0, r2);
    let rt3 = __f32x4_zip_hi(r1, r3);
    let rv0 = __f32x4_zip_lo(rt0, rt1);
    let rv1 = __f32x4_zip_hi(rt0, rt1);
    let rv2 = __f32x4_zip_lo(rt2, rt3);
    let rv3 = __f32x4_zip_hi(rt2, rt3);
    let v0 = __f32x4_reverse(rv3);
    __f32x4_store(address + (8 * k) as usize, __f32x4_zip_lo(lv0, v0));
    __f32x4_store(address + (8 * k + 16) as usize, __f32x4_zip_hi(lv0, v0));
    let v1 = __f32x4_reverse(rv2);
    __f32x4_store(address + (8 * (k + 2 * quarter)) as usize, __f32x4_zip_lo(lv1, v1));
    __f32x4_store(address + (8 * (k + 2 * quarter) + 16) as usize, __f32x4_zip_hi(lv1, v1));
    let v2 = __f32x4_reverse(rv1);
    __f32x4_store(address + (8 * (k + quarter)) as usize, __f32x4_zip_lo(lv2, v2));
    __f32x4_store(address + (8 * (k + quarter) + 16) as usize, __f32x4_zip_hi(lv2, v2));
    let v3 = __f32x4_reverse(rv0);
    __f32x4_store(address + (8 * (k + 3 * quarter)) as usize, __f32x4_zip_lo(lv3, v3));
    __f32x4_store(address + (8 * (k + 3 * quarter) + 16) as usize, __f32x4_zip_hi(lv3, v3));
  }
}

@inline
function put_post(address: usize, n: i32, j: i32, left: f32, right: f32, packed: boolean): void {
  unsafe {
    if (packed) {
      __store_i32(address + (8 * j) as usize, f32_bits(left));
      __store_i32(address + (4 * (n - 1 - 2 * j)) as usize, f32_bits(right));
    } else {
      __store_i64(address + (16 * j) as usize, f64_bits(left as f64));
      __store_i64(address + (8 * (n - 1 - 2 * j)) as usize, f64_bits(right as f64));
    }
  }
}

@inline
pub function inverse(coefs: [f64], own lap: f64[], overlap: i32, p: Plan, own work: Scratch, scaled: boolean = false): Inverse {
  return inverse_impl[0](coefs, lap, overlap, p, work, scaled);
}

// This path retains double precision throughout the transform and overlap.
@inline
pub function inverse_precise(coefs: [f64], own lap: f64[], overlap: i32, p: Plan, own work: Scratch): Inverse {
  return inverse_impl[1](coefs, lap, overlap, p, work, false);
}

function inverse_impl[const PRECISE: i32](coefs: [f64], own lap: f64[], overlap: i32, p: Plan, own work: Scratch, scaled: boolean): Inverse {
  let n = p.shape.n;
  let silent = true;
  for i in 0..n {
    if (coefs[i] != 0.0) {
      silent = false;
      break;
    }
  }
  if (!silent) {
    if (PRECISE != 0) {
      let accurate = transform.dct4_planned(coefs, p.shape);
      let output = work.transformed;
      for i in 0..n {
        output = output.with(i, accurate[i]);
      }
      work = Scratch { ...work, transformed: output };
    } else {
      work = dct4(coefs, p, work, scaled);
    }
  }
  let Scratch { re, im, transformed: temp, samples: out } = work;
  if (silent) {
    for i in 0..n {
      temp = temp.with(i, 0.0);
    }
  }
  let flat = (n - overlap) / 2;
  let i = 0;
  while (i + 1 < flat) {
    let a = __f64x2_of(lap[n / 2 - 1 - i], lap[n / 2 - 2 - i]);
    let b = __f64x2_load(temp, n / 2 + i);
    out = __f64x2_with(out, i, a);
    out = __f64x2_with(out, n - 2 - i, __f64x2_reverse(b));
    i += 2;
  }
  while (i < flat) {
    out = out.with(i, lap[n / 2 - 1 - i]);
    out = out.with(n - 1 - i, temp[n / 2 + i]);
    i += 1;
  }
  while (i + 1 < n / 2) {
    let a = __f64x2_of(lap[n / 2 - 1 - i], lap[n / 2 - 2 - i]);
    let b = __f64x2_load(temp, n / 2 + i);
    let c = __f64x2_load(p.shape.window_cos, n - overlap + i - flat);
    let s = __f64x2_load(p.shape.window_sin, n - overlap + i - flat);
    let left = c * a - s * b;
    let right = s * a + c * b;
    out = __f64x2_with(out, i, left);
    out = __f64x2_with(out, n - 2 - i, __f64x2_reverse(right));
    i += 2;
  }
  while (i < n / 2) {
    let a = lap[n / 2 - 1 - i];
    let b = temp[n / 2 + i];
    let c = p.shape.window_cos[n - overlap + i - flat];
    let s = p.shape.window_sin[n - overlap + i - flat];
    out = out.with(i, c * a - s * b);
    out = out.with(n - 1 - i, s * a + c * b);
    i += 1;
  }
  for i in 0..n / 2 {
    lap = lap.with(i, temp[i]);
  }
  return Inverse { lap: lap, work: Scratch { re: re, im: im, transformed: temp, samples: out } };
}

pub struct Dual { mdct: f64[], mdst: f64[], lap: f64[], work: Scratch }

pub function forward_dual(samples: [f64], own lap: f64[], offset: i32, overlap: i32, p: Plan, own work: Scratch): Dual {
  let n = samples.len();
  let half = n / 2;
  let ct = transform.zeros(n);
  let st = transform.zeros(n);
  let flat = (n - overlap) / 2;
  for i in 0..half {
    let a = lap[offset + i];
    let b = lap[offset + n - 1 - i];
    let c = samples[i];
    let d = samples[n - 1 - i];
    let cosine = 1.0;
    let sine = 0.0;
    if (i >= flat) {
      cosine = p.shape.window_cos[n - overlap + i - flat];
      sine = p.shape.window_sin[n - overlap + i - flat];
    }
    lap = lap.with(offset + i, sine * c);
    lap = lap.with(offset + n - 1 - i, cosine * d);
    ct = ct.with(half - 1 - i, cosine * c + sine * d);
    ct = ct.with(half + i, -a + b);
    st = st.with(half - 1 - i, cosine * c - sine * d);
    st = st.with(half + i, a + b);
  }
  for i in 0..half {
    st = st.with(2 * i + 1, -st[2 * i + 1]);
  }
  work = dct4(ct, p, work);
  ct = work.transformed;
  work = dct4(st, p, work);
  st = work.transformed;
  let mdst = transform.zeros(n);
  let scale = 2.0 / (n as f64);
  for i in 0..n {
    ct = ct.with(i, ct[i] * scale);
    mdst = mdst.with(i, st[n - 1 - i] * scale);
  }
  return Dual { mdct: ct, mdst: mdst, lap: lap, work: work };
}
