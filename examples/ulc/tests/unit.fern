import "std/result";
import "std/array";
import "std/f64";
import "std/string";
import "std/i32";
import "../transform";
import "../packed_transform";
import "../packed_decoder";
import "../codec";
import "../encoder";
import "../analysis";
import "../bitstream";
import "../audio";

function require(ok: boolean, message: string): void {
  if (!ok) {
    eprint("FAIL: " + message);
    exit(1);
  }
}

function near(a: f64, b: f64, tolerance: f64): boolean {
  return (a - b).abs() <= tolerance;
}

function nybbles(codes: [i32]): u8[] {
  let out: u8[] = [];
  let i = 0;
  while (i < codes.len()) {
    let value = codes[i];
    if (i + 1 < codes.len()) {
      value |= codes[i + 1] << 4;
    }
    out = out.append(value as u8);
    i += 2;
  }
  return out;
}

function get(codes: [i32], n: i32): codec.Coefficients {
  let result = codec.coefficients(codec.reader(nybbles(codes), 0, 1234567u32), n);
  match (result) {
    Ok(v) => {
      return v;
    },
    Err(e) => {
      eprint(e);
      exit(1);
    }
  }
}

function transform_tests(): void {
  for n in [16, 32, 256] {
    let x = transform.zeros(n);
    for i in 0..n {
      x = x.with(i, (i as f64 * 0.23).sin() + 0.3 * (i as f64 * 0.71).cos());
    }
    let y = transform.dct4(x);
    for k in 0..n {
      let expected = 0.0;
      for j in 0..n {
        expected += x[j] * (3.141592653589793 / (n as f64) * (j as f64 + 0.5) * (k as f64 + 0.5)).cos();
      }
      require(near(y[k], expected, 0.000000001), "DCT-IV direct definition");
    }
    let back = transform.dct4(y);
    for j in 0..n {
      require(near(back[j] * 2.0 / (n as f64), x[j], 0.000000001), "DCT-IV involution");
    }
  }
  let previous = transform.zeros(256);
  let enc_lap = transform.zeros(128);
  let dec_lap = transform.zeros(128);
  for b in 0..5 {
    let x = transform.zeros(256);
    for j in 0..256 {
      x = x.with(j, ((b * 256 + j) as f64 * 0.12).sin());
    }
    let f = transform.forward(x, enc_lap);
    enc_lap = f.lap;
    let overlap = 256;
    if (b == 0) {
      overlap = 0;
    }
    let d = transform.inverse(f.coefs, dec_lap, overlap);
    dec_lap = d.lap;
    for j in 0..256 {
      require(near(d.samples[j], previous[j], 0.000000001), "MDCT overlap reconstruction");
    }
    previous = x;
  }
}

function window_cache_tests(): void {
  let n = 128;
  let p = transform.plan(n);
  let coefs = transform.zeros(n);
  let lap = transform.zeros(n / 2);
  for i in 0..n {
    coefs = coefs.with(i, (i as f64 * 0.19).sin() * 0.1);
  }
  for i in 0..n / 2 {
    lap = lap.with(i, (i as f64 * 0.31).cos() * 0.1);
  }
  let temp = transform.dct4(coefs);
  for overlap in [0, 1, 2, 4, 8, 16, 32, 64, 128] {
    let working = lap.take(n / 2);
    let result = transform.inverse_planned(coefs, working, overlap, p);
    let flat = (n - overlap) / 2;
    for i in 0..n / 2 {
      let a = lap[n / 2 - 1 - i];
      let b = temp[n / 2 + i];
      let low = a;
      let high = b;
      if (i >= flat) {
        let angle = 3.141592653589793 * (i as f64 - flat as f64 + 0.5) / ((2 * overlap) as f64);
        low = angle.cos() * a - angle.sin() * b;
        high = angle.sin() * a + angle.cos() * b;
      }
      require(near(result.samples[i], low, 0.0000000001) && near(result.samples[n - 1 - i], high, 0.0000000001), "cached window includes single-sample overlap");
    }
  }
}

function syntax_tests(): void {
  let v = get([0, 2, 14, 7, 9, 15, 14, 15], 16);
  require(v.values[0] == 0.125 && v.values[1] == -0.125 && v.values[2] == 1.53125 && v.values[3] == -1.53125, "signed squares");
  require(v.values[15] == 0.0, "zero tail");
  require(get([14, 15], 16).reader.pos == 2, "silent subblock");
  require(get([0, 0, 15], 16).reader.pos == 3, "short zero run");
  require(get([0, 1, 0, 0], 33).reader.pos == 4, "long zero run");
  let q = get([14, 12, 2, 15, 14, 15], 16);
  require(q.values[0] == 4.0 / 2147483648.0, "extended precision quantizer");
  let noise = get([0, 8, 0, 0, 0], 16);
  for x in noise.values {
    require(x.abs() == 0.0078125, "noise fill amplitude");
  }
  let tail = get([0, 15, 15, 3, 2, 1], 16);
  require(tail.values[0].abs() == 0.03125, "noise tail amplitude");
  require(tail.values[15].abs() < tail.values[0].abs(), "noise tail decay");
  require(codec.coefficients(codec.reader(nybbles([0, 1, 15, 15]), 0, 1u32), 16).is_err(), "reject oversized run");
  require(codec.coefficients(codec.reader(nybbles([15]), 0, 1u32), 16).is_err(), "reject initial noise tail");
  require(codec.coefficients(codec.reader(nybbles([14, 13]), 0, 1u32), 16).is_err(), "reject reserved quantizer");
  require(codec.coefficients(codec.reader([], 0, 1u32), 16).is_err(), "reject truncation");
  require(codec.decoder(128, 1).is_err() && codec.decoder(512, 0).is_err() && codec.decoder(300, 1).is_err(), "validate config");
}

function containers(): void {
  for channels in [1, 2, 3] {
    let samples = transform.zeros(777 * channels);
    for i in 0..samples.len() {
      samples = samples.with(i, 0.2 * (i as f64 * 0.17).sin());
    }
    let input = audio.Audio { rate: 44100, channels: channels, samples: samples };
    for bits in [8, 16, 24, 32] {
      let Ok(wav) = audio.write_wav(input, bits) else {
        require(false, "write WAV");
        return;
      };
      let Ok(back) = audio.read_wav(wav) else {
        require(false, "read WAV");
        return;
      };
      require(back.channels == channels && back.rate == 44100 && back.samples.len() == samples.len(), "WAV metadata");
      let tolerance = 1.0 / ((1 << bits - 1) as f64) + 0.0000001;
      for i in 0..samples.len() {
        require(near(back.samples[i], samples[i], tolerance), "WAV samples");
      }
    }
    let Ok(encoded) = audio.encode(input, 100, 256) else {
      require(false, "encode ULC2");
      return;
    };
    let Ok(decoded) = audio.decode(encoded) else {
      require(false, "decode ULC2");
      return;
    };
    require(decoded.samples.len() == 1536 * channels, "ULC2 frame count");
    let mse = 0.0;
    for i in 0..samples.len() {
      let d = decoded.samples[512 * channels + i] - samples[i];
      mse += d * d;
    }
    require(mse / (samples.len() as f64) < 0.0004, "roundtrip with two block delay");
    for length in [0, 1, 23, encoded.len() - 1] {
      require(audio.decode(encoded.take(length)).is_err(), "reject truncated container");
    }
  }
  let silent = audio.Audio { rate: 8000, channels: 1, samples: transform.zeros(256) };
  let Ok(encoded_silence) = audio.encode(silent, 100, 256) else {
    require(false, "encode silence");
    return;
  };
  require(encoded_silence.len() == 30, "silent subblocks use the two-nybble stop code");
  let Ok(wav) = audio.write_wav(silent, 8) else {
    require(false, "write chunk fixture");
    return;
  };
  // Insert an odd-length unknown chunk with padding before the fmt chunk.
  let padded = wav.take(12).concat([74u8, 85u8, 78u8, 75u8, 1u8, 0u8, 0u8, 0u8, 99u8, 0u8]).concat(wav.drop(12));
  let size = padded.len() - 8;
  for i in 0..4 {
    padded = padded.with(4 + i, (size >> 8 * i) as u8);
  }
  let Ok(with_chunk) = audio.read_wav(padded) else {
    require(false, "parse padded unknown WAV chunk");
    return;
  };
  require(with_chunk.samples.len() == 256, "skip WAV metadata chunks");
  require(audio.read_wav(wav.with(32, 0u8)).is_err(), "reject invalid WAV block alignment");
  require(audio.read_wav(wav.with(40, 255u8)).is_err(), "reject truncated WAV data chunk");
  let bad_float = audio.Audio { ...silent, samples: [f64_from_bits(9221120237041090560)] };
  require(audio.write_wav(bad_float, 32).is_err(), "reject nonfinite float sample");
  require(audio.read_wav([]).is_err(), "reject bad WAV");
}

function planar_tests(): void {
  let negative_zero = f64_from_bits(-9223372036854775807i64 - 1i64);
  let values = [0.0, negative_zero, 0.5, -0.5, 1.0, -1.0, f64_from_bits(1i64), -f64_from_bits(1i64)];
  for n in [0, 1, 2, 5, 256] {
    for channels in 1..6 {
      let samples = transform.zeros(n * channels);
      for i in 0..samples.len() {
        samples = samples.with(i, values[i % values.len()]);
      }
      let Ok(actual) = encoder.planar(samples, n, channels) else {
        exit(1);
      };
      for channel in 0..channels {
        for i in 0..n {
          let value = samples[i * channels + channel];
          if ((channel & 1) == 0 && channel + 1 < channels) {
            value = 0.5 * (value + samples[i * channels + channel + 1]);
          } else if ((channel & 1) != 0) {
            value = 0.5 * (samples[i * channels + channel - 1] - value);
          }
          require(f64_bits(actual[channel * n + i]) == f64_bits(value), "paired channel conversion preserves every scalar bit");
        }
      }
    }
  }
  require(encoder.planar([0.0], 1, 2).is_err(), "channel conversion rejects incorrect dimensions");
  require(encoder.planar([], -1, 1).is_err(), "channel conversion rejects negative frame counts");
  require(encoder.planar([], 0, 0).is_err(), "channel conversion rejects zero channels");
}

function paired_log_tests(): void {
  let seed = 417u32;
  for i in 0..65536 {
    seed ^= seed << 13u32;
    seed ^= seed >> 17u32;
    seed ^= seed << 5u32;
    let a = (f32_from_bits(seed as i32) as f64).abs();
    seed ^= seed << 13u32;
    seed ^= seed >> 17u32;
    seed ^= seed << 5u32;
    let b = (f32_from_bits(seed as i32) as f64).abs();
    if (!a.is_finite()) {
      a = 0.0;
    }
    if (!b.is_finite()) {
      b = 0.0;
    }
    let actual = analysis.fast_logs(__f64x2_of(a, b));
    require(f64_bits(__f64x2_lane(actual, 0)) == f64_bits(analysis.fast_log(a)), "paired logarithm preserves the first scalar result");
    require(f64_bits(__f64x2_lane(actual, 1)) == f64_bits(analysis.fast_log(b)), "paired logarithm preserves the second scalar result");
  }
}

function prepared_priority_tests(p: encoder.Prepared, n: i32, channels: i32): void {
  let count = 0;
  for value in p.coefs {
    if (value.abs() >= 0.00000000023283064365386963) {
      count += 1;
    }
  }
  require(p.nonzero == count, "nonzero count matches the coefficient threshold");
  for ch in 0..channels {
    for pair in 0..n / 2 {
      let index = ch * n + 2 * pair;
      let a = p.coefs[index].abs();
      let b = p.coefs[index + 1].abs();
      if (a >= 0.00000000023283064365386963 && a > 2.0 * b) {
        require(p.ranks[index] < p.ranks[index + 1], "pair priorities preserve the stronger first coefficient");
      }
      if (b >= 0.00000000023283064365386963 && b > 2.0 * a) {
        require(p.ranks[index + 1] < p.ranks[index], "pair priorities preserve the stronger second coefficient");
      }
    }
  }
}

function priority_rank_tests(): void {
  let seed = 417u32;
  for n in [0, 1, 7, 256, 513] {
    for pattern in 0..3 {
      let keys = transform.zeros(n);
      for i in 0..n {
        seed ^= seed << 13u32;
        seed ^= seed >> 17u32;
        seed ^= seed << 5u32;
        let value = 7.0 + (i % 4) as f64 * 0.000000001;
        if (pattern == 1) {
          value = (i % 11 - 5) as f64 * 0.125;
        }
        if (pattern == 2) {
          value = (seed as i32) as f64 * 0.000001;
        }
        keys = keys.with(i, value);
      }
      let actual = analysis.ranks(keys);
      for i in 0..n {
        let expected = 0;
        let value = keys[i] as f32;
        for j in 0..n {
          let other = keys[j] as f32;
          if (other > value || other == value && j > i) {
            expected += 1;
          }
        }
        require(actual[i] == expected, "radix ranks preserve stable float32 priority order");
      }
    }
  }
}

function encoder_features(): void {
  let order = analysis.ranks([1.0, -2.0, 8.0, 0.0]);
  require(order[2] == 0 && order[0] == 1 && order[3] == 2 && order[1] == 3, "priority radix order");
  for n in [256, 2048] {
    let Ok(initial) = encoder.create(n, 2, 44100, encoder.Cbr(96.0)) else {
      require(false, "create CBR encoder");
      return;
    };
    let state = initial;
    let Ok(decoder0) = codec.decoder(n, 2) else {
      require(false, "create feature decoder");
      return;
    };
    let dec = decoder0;
    let switched = false;
    let nonzero = false;
    for b in 0..8 {
      let samples = transform.zeros(2 * n);
      if (b == 2 || b == 5) {
        for i in 0..n / 8 {
          samples = samples.with(2 * i, 0.5 * (i as f64 * 0.71).sin());
          samples = samples.with(2 * i + 1, 0.3 * (i as f64 * 1.13).cos());
        }
      }
      let Ok(prepared) = encoder.prepare(state, samples) else {
        require(false, "prepare transient frame");
        return;
      };
      prepared_priority_tests(prepared, n, 2);
      for keep in [0, 1, prepared.nonzero / 2, prepared.nonzero] {
        let measured = bitstream.pass(prepared.coefs, prepared.noise, prepared.ranks, n, 2, prepared.control, keep, true);
        let written = bitstream.pass(prepared.coefs, prepared.noise, prepared.ranks, n, 2, prepared.control, keep, false);
        require(measured.bytes.len() == 0, "count-only passes produce no output bytes");
        require(measured.bits == written.bits && written.bytes.len() * 8 == written.bits, "count-only pass matches actual bytes at each coefficient limit");
      }
      let Ok(encoded) = encoder.encode_prepared(prepared) else {
        require(false, "encode CBR transient");
        return;
      };
      require(encoded.bits as f64 <= (n as f64 * 96000.0 / 44100.0).floor(), "strict per-block CBR budget");
      require(encoded.complexity >= 0.0 && encoded.complexity <= 1.0, "bounded block complexity");
      if (encoded.control != 0x10) {
        switched = true;
      }
      if (encoded.complexity > 0.0) {
        nonzero = true;
      }
      state = encoded.state;
      let Ok(decoded) = codec.decode_block(dec, encoded.bytes, 0) else {
        require(false, "decode transient output");
        return;
      };
      dec = decoded.state;
      require(decoded.next_byte == encoded.bytes.len(), "complete transient bitstream");
    }
    require(switched && nonzero, "automatic transient detection and overlap scaling");
  }
  let source = audio.Audio { rate: 44100, channels: 1, samples: transform.zeros(1024) };
  let Ok(average) = audio.analyze(source, 256) else {
    require(false, "analyze silence");
    return;
  };
  require(average == 0.0, "silent average complexity");
  let Ok(encoded) = audio.encode_mode(source, encoder.Abr(32.0, 1.0), 256) else {
    require(false, "ABR silence overhead");
    return;
  };
  require(audio.decode(encoded).is_ok(), "ABR silence decodes");
  require(encoder.create(256, 1, 44100, encoder.Cbr(0.0)).is_err(), "reject zero CBR rate");
  require(encoder.create(256, 1, 44100, encoder.Abr(64.0, 0.0)).is_err(), "reject zero ABR complexity");
  require(encoder.create(256, 1, 0, encoder.Vbr(75.0)).is_err(), "reject zero sample rate");
  require(audio.encode_mode(source, encoder.Cbr(0.001), 256).is_err(), "reject impossible CBR budget");
}

// Compare the packed recurrence with independently evaluated scalar steps.
function grid_bits_match(cosine: [f64], sine: [f64], offset: i32, count: i32, start: f64, step: f64): boolean {
  let dc = step.cos();
  let ds = step.sin();
  let c = 0.0;
  let t = 0.0;
  for i in 0..count {
    if ((i & 31) == 0) {
      let angle = start + step * (i as f64);
      c = angle.cos();
      t = angle.sin();
    }
    if (f64_bits(cosine[offset + i]) != f64_bits(c) || f64_bits(sine[offset + i]) != f64_bits(t)) {
      return false;
    }
    let next = c * dc - t * ds;
    t = t * dc + c * ds;
    c = next;
  }
  return true;
}

function plan_grid_tests(): void {
  let n = 16;
  while (n <= 32768) {
    let p = transform.plan(n);
    require(grid_bits_match(p.pre_cos, p.pre_sin, 0, n / 2, 0.0, 3.141592653589793 / (n as f64)), "pre-rotation matches scalar IEEE steps");
    require(grid_bits_match(p.post_cos, p.post_sin, 0, n / 2, 3.141592653589793 / (4.0 * (n as f64)), 3.141592653589793 / (n as f64)), "post-rotation matches scalar IEEE steps");
    let bits = 0;
    let length = n / 2;
    while (length > 1) {
      bits += 1;
      length >>= 1;
    }
    for i in 0..n / 2 {
      let angle = 3.141592653589793 * (i as f64) / (n as f64);
      let post = 3.141592653589793 * (i as f64 + 0.25) / (n as f64);
      require(near(p.pre_cos[i], angle.cos(), 0.00000000000002) && near(p.pre_sin[i], angle.sin(), 0.00000000000002), "pre-rotation recurrence stays within its error bound");
      require(near(p.post_cos[i], post.cos(), 0.00000000000002) && near(p.post_sin[i], post.sin(), 0.00000000000002), "post-rotation recurrence stays within its error bound");
      let reversed = 0;
      let value = i;
      for bit in 0..bits {
        reversed = reversed << 1 | value & 1;
        value >>= 1;
      }
      require(p.reversal[i] == reversed, "incremental reversal matches scalar reversal");
    }
    let width = 2;
    while (width <= n / 2) {
      require(grid_bits_match(p.fft_cos, p.fft_sin, width / 2 - 1, width / 2, 0.0, 2.0 * 3.141592653589793 / (width as f64)), "FFT grid matches scalar IEEE steps");
      for i in 0..width / 2 {
        let angle = 2.0 * 3.141592653589793 * (i as f64) / (width as f64);
        require(near(p.fft_cos[width / 2 - 1 + i], angle.cos(), 0.00000000000002) && near(p.fft_sin[width / 2 - 1 + i], angle.sin(), 0.00000000000002), "FFT recurrence stays within its error bound");
      }
      width *= 2;
    }
    let overlap = n;
    while (overlap >= 2) {
      require(grid_bits_match(p.window_cos, p.window_sin, n - overlap, overlap / 2, 3.141592653589793 / (4.0 * (overlap as f64)), 3.141592653589793 / (2.0 * (overlap as f64))), "window grid matches scalar IEEE steps");
      for i in 0..overlap / 2 {
        let angle = 3.141592653589793 * (i as f64 + 0.5) / ((2 * overlap) as f64);
        let at = n - overlap + i;
        require(near(p.window_cos[at], angle.cos(), 0.00000000000002) && near(p.window_sin[at], angle.sin(), 0.00000000000002), "window recurrence stays within its error bound");
      }
      overlap >>= 1;
    }
    n *= 2;
  }
}

function deferred_plan_tests(): void {
  let Ok(lazy) = packed_decoder.decoder(256, 1, true) else {
    exit(1);
  };
  let Ok(eager) = packed_decoder.decoder(256, 1) else {
    exit(1);
  };
  let input = nybbles([0, 0, 15, 15, 0, 0, 0]);
  let Ok(a) = packed_decoder.decode_block(packed_decoder.Decoder { ...lazy }, input, 0) else {
    exit(1);
  };
  let Ok(b) = packed_decoder.decode_block(eager, input, 0) else {
    exit(1);
  };
  for i in 0..a.samples.len() {
    require(a.samples[i] == b.samples[i], "deferred plans preserve exact output bytes");
  }
  for p in lazy.plans {
    require(packed_transform.is_deferred(p), "plan preparation preserves retained decoder aliases");
  }
  require(a.state.plans[0].prepared, "the active transform plan is prepared");
  for i in 1..4 {
    require(packed_transform.is_deferred(a.state.plans[i]), "unused transform plans stay deferred");
  }
  let bad = packed_transform.Plan { ...lazy.plans[0], cosine: [0u8] };
  require(packed_decoder.decode_block(packed_decoder.Decoder { ...lazy, plans: lazy.plans.with(0, bad) }, input, 0).is_err(), "deferred plans reject partial tables");
  let Ok(silent) = packed_decoder.decode_block(lazy, nybbles([0, 14, 15]), 0) else {
    exit(1);
  };
  for p in silent.state.plans {
    require(packed_transform.is_deferred(p), "silence does not prepare transform tables");
  }
}

function packed_output_tests(): void {
  for n in [16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768] {
    let input = __alloc_u8(4 * n + 8);
    let output = __alloc_u8(4 * n + 8);
    let re = __alloc_u8(2 * n + 8);
    let im = __alloc_u8(2 * n + 8);
    for buffer in [output, re, im] {
      unsafe {
        for i in 0..4 {
          __store_u8(buffer as usize + 8 as usize + i as usize, 165);
          __store_u8(buffer as usize + 8 as usize + (buffer.len() - 1 - i) as usize, 165);
        }
      }
    }
    let precise = transform.zeros(n);
    for i in 0..n {
      let value = ((i as f64 * 0.19).sin() * 0.01 + (i as f64 * 0.071).cos() * 0.003) as f32;
      precise = precise.with(i, value as f64);
      unsafe {
        __store_i32(input as usize + 12 as usize + (4 * i) as usize, f32_bits(value));
      }
    }
    let expected = transform.dct4(precise);
    unsafe {
      packed_transform.dct4_packed(input as usize + 12 as usize, output as usize + 12 as usize, re as usize + 12 as usize, im as usize + 12 as usize, packed_transform.plan(n));
    }
    // The unsafe FFT borrows addresses. Keep the input owner alive through the call.
    for i in 0..n {
      let bits = f32_bits(precise[i] as f32) as u32;
      for byte in 0..4 {
        require(input[4 + 4 * i + byte] == (bits >> (8 * byte) as u32) as u8, "packed FFT preserves its input bytes");
      }
    }
    let peak = 1.0;
    let error = 0.0;
    for i in 0..n {
      if (expected[i].abs() > peak) {
        peak = expected[i].abs();
      }
      unsafe {
        let value = f32_from_bits(__load_i32(output as usize + 12 as usize + (4 * i) as usize)) as f64;
        require(value.is_finite(), "packed FFT output stays finite");
        if ((expected[i] - value).abs() > error) {
          error = (expected[i] - value).abs();
        }
      }
    }
    require(error < peak * 0.000003, "packed output order matches the double FFT at every size");
    for buffer in [output, re, im] {
      for i in 0..4 {
        require(buffer[i] == 165u8 && buffer[buffer.len() - 1 - i] == 165u8, "unaligned FFT spans preserve their boundary bytes");
      }
    }
  }
}

function packed_tests(): void {
  for n in [32, 256, 2048, 32768] {
    let input = transform.zeros(n);
    for i in 0..n {
      input = input.with(i, (i as f64 * 0.19).sin() * 0.01 + (i as f64 * 0.071).cos() * 0.003);
    }
    let expected = transform.dct4(input);
    let retained = packed_transform.scratch(n);
    let result = packed_transform.dct4(input, packed_transform.plan(n), packed_transform.Scratch { ...retained });
    for byte in retained.re {
      require(byte == 0, "packed real scratch preserves retained aliases");
    }
    for byte in retained.im {
      require(byte == 0, "packed imaginary scratch preserves retained aliases");
    }
    let peak = 1.0;
    let error = 0.0;
    for i in 0..n {
      if (expected[i].abs() > peak) {
        peak = expected[i].abs();
      }
      let diff = (expected[i] - result.transformed[i]).abs();
      if (diff > error) {
        error = diff;
      }
    }
    require(error < peak * 0.000003, "packed FFT matches double precision");
    let precise = packed_transform.inverse_precise(input, transform.zeros(n / 2), 0, packed_transform.plan(n), packed_transform.scratch(n));
    for i in 0..n {
      require(precise.work.transformed[i] == expected[i], "precise inverse retains every double FFT value");
    }
  }
  let tiny = transform.zeros(256);
  for i in 0..256 {
    tiny = tiny.with(i, (i as f64 * 0.19).sin() * (f32_from_bits(1) as f64));
  }
  let exact = transform.dct4(tiny);
  let scaled = packed_transform.dct4(tiny, packed_transform.plan(256), packed_transform.scratch(256), true);
  let peak = 0.0;
  let error = 0.0;
  for i in 0..256 {
    if (exact[i].abs() > peak) {
      peak = exact[i].abs();
    }
    if ((exact[i] - scaled.transformed[i]).abs() > error) {
      error = (exact[i] - scaled.transformed[i]).abs();
    }
  }
  require(error < peak * 0.000003, "scaled FFT retains tiny coefficients");
  // Every ordinary noise-run length crosses different SIMD and batch boundaries.
  for count in 16..528 {
    let q = count % 27;
    let amplitude = count % 8 + 1;
    let prefix = if (q < 14) { [q] } else { [14, q - 14] };
    let run = count - 16;
    let codes = prefix.concat([8, run >> 5, run >> 1 & 15, amplitude - 1 << 1 | run & 1]);
    let data = nybbles(codes);
    let initial_seed = count as u32 * 2654435761u32;
    let Ok(decoded) = codec.coefficients(codec.reader(data, 0, initial_seed), count) else {
      exit(1);
    };
    let packed = __alloc_u8(4 * count);
    let final_seed = 0u32;
    unsafe {
      let Ok(parsed) = codec.coefficient_buffer(codec.reader(data, 0, initial_seed), count, packed as usize + 8 as usize, true) else {
        exit(1);
      };
      final_seed = parsed.reader.seed;
    }
    let seed = initial_seed;
    let level = (amplitude * amplitude) as f64 / ((1u64 << (7 + q) as u64) as f64);
    for i in 0..count {
      seed ^= seed << 13u32;
      seed ^= seed >> 17u32;
      seed ^= seed << 5u32;
      if ((seed & 2147483648u32) != 0u32) {
        level = -level;
      }
      require(f64_bits(decoded.values[i]) == f64_bits(level), "noise run preserves each scalar sign");
      unsafe {
        require(__load_i32(packed as usize + 8 as usize + (4 * i) as usize) == f32_bits((level * 79228162514264337593543950336.0) as f32), "batched noise run preserves exact packed bits");
      }
    }
    require(decoded.reader.seed == seed && final_seed == seed, "batched noise run preserves its final seed");
  }
  for q in [0, 26] {
    for code in 0..256 {
      let prefix = if (q == 0) { [0] } else { [14, 12] };
      let codes = prefix.concat([15, 15, 0, code >> 4, code & 15]);
      let decoded = get(codes, 32768);
      let packed = __alloc_u8(4 * 32768);
      unsafe {
        let parsed = codec.coefficient_buffer(codec.reader(nybbles(codes), 0, 1234567u32), 32768, packed as usize + 8 as usize, true);
        require(parsed.is_ok(), "packed noise tail accepts every decay code");
      }
      let seed = 1234567u32;
      let level = (1.0 / ((1u64 << (9 + q) as u64) as f64)) as f32;
      let decay = (1.0 - (code * code) as f64 / 524288.0) as f32;
      for i in 0..32768 {
        seed ^= seed << 13u32;
        seed ^= seed >> 17u32;
        seed ^= seed << 5u32;
        if ((seed & 2147483648u32) != 0u32) {
          level = -level;
        }
        require(f64_bits(decoded.values[i]) == f64_bits(level as f64), "noise tail preserves every rounded value");
        unsafe {
          let bits = __load_i32(packed as usize + 8 as usize + (4 * i) as usize);
          require(bits == f32_bits((level as f64 * 79228162514264337593543950336.0) as f32), "packed noise tail preserves exact binary scaling");
        }
        level *= decay;
      }
    }
  }
  let seed = 1234567u32;
  for count in 0..1001 {
    require(codec.advance_seed(1234567u32, count) == seed, "noise seed jump matches scalar xorshift");
    seed ^= seed << 13u32;
    seed ^= seed >> 17u32;
    seed ^= seed << 5u32;
  }
  for codes in [[0, 0, 15, 15, 0, 0, 0], [0, 0, 8, 0, 0, 0, 15, 14, 15]] {
    let data = nybbles(codes);
    let Ok(scan) = codec.scan_block(data, 0, 256, 1) else {
      exit(1);
    };
    let Ok(state) = codec.decoder(256, 1) else {
      exit(1);
    };
    let Ok(block) = codec.decode_block(state, data, 0) else {
      exit(1);
    };
    require(scan.next_byte == block.next_byte && scan.last_size == block.state.last_size, "scan matches block boundaries");
    require(codec.advance_seed(1234567u32, scan.noise_samples) == block.state.seed, "scan counts noise samples");
  }
}

function verify_scan(template: codec.Decoder, data: u8[]): boolean {
  let scanned = codec.scan_block(data, 0, 256, 1);
  let decoded = codec.decode_block(codec.Decoder { ...template, lap_zero: false }, data, 0);
  match (scanned) {
    Ok(scan) => {
      let Ok(block) = decoded else {
        require(false, "scanner accepted a malformed block");
        return false;
      };
      require(scan.next_byte == block.next_byte && scan.last_size == block.state.last_size && scan.silent == block.state.lap_zero, "scanner and decoder metadata agree");
      require(codec.advance_seed(1234567u32, scan.noise_samples) == block.state.seed, "scanner and decoder noise counts agree");
      return true;
    },
    Err(_) => {
      require(decoded.is_err(), "scanner rejected a valid block");
      return false;
    }
  }
}

function check_packed_coefficients(data: u8[], size: i32, seed: u32): void {
  let expected = codec.coefficients(codec.reader(data, 0, seed), size);
  let bytes = __alloc_u8(4 * size + 36);
  unsafe {
    let address = bytes as usize + 25 as usize;
    __memset(bytes as usize + 8 as usize, 165, bytes.len());
    __memset(address, 0, 4 * size);
    let parsed = codec.coefficient_buffer(codec.reader(data, 0, seed), size, address, true);
    match (expected) {
      Ok(value) => {
        let Ok(actual) = parsed else {
          exit(1);
        };
        require(actual.reader.pos == value.reader.pos && actual.reader.seed == value.reader.seed, "packed coefficients preserve cursor and seed");
        require(actual.noise_samples == value.noise_samples && actual.silent == value.silent && actual.needs_scale == value.needs_scale, "packed coefficients preserve parser flags");
        for i in 0..size {
          require(__load_i32(address + (4 * i) as usize) == f32_bits((value.values[i] * 79228162514264337593543950336.0) as f32), "packed coefficients preserve exact scaled bits");
        }
      },
      Err(error) => {
        let Err(actual) = parsed else {
          exit(1);
        };
        require(actual == error, "packed coefficients preserve scalar errors");
      }
    }
  }
  for i in 0..bytes.len() {
    if (i < 17 || i >= 17 + 4 * size) {
      require(bytes[i] == 165u8, "packed stores remain within the output span");
    }
  }
}

function coefficient_parser_tests(): void {
  // Compare every four-command word with the independent double parser.
  for word in 0..65536 {
    let prefix = if ((word & 1) == 0) { [0] } else { [14, 12] };
    let data = nybbles(prefix.concat([word & 15, word >> 4 & 15, word >> 8 & 15, word >> 12, 15, 14, 15]));
    check_packed_coefficients(data, 16, word as u32 * 2654435761u32);
  }
  let ordinary = [2, 3, 4, 5, 6, 7, 9, 10, 11, 12, 13, 14];
  for first in 0..27 {
    let initial = if (first < 14) { [first] } else { [14, first - 14] };
    for next in 0..27 {
      let changed = if (next < 14) { [next] } else { [14, next - 14] };
      let codes = initial.concat(ordinary).concat([15]).concat(changed).concat(ordinary).concat([15, 14, 15]);
      check_packed_coefficients(nybbles(codes), 32, 1234567u32);
    }
  }
  for extended in [false, true] {
    for count in 0..25 {
      let codes = if (extended) { [14, 12] } else { [0] };
      for i in 0..count {
        codes = codes.append(ordinary[i % ordinary.len()]);
      }
      let data = nybbles(codes.concat([15, 14, 15]));
      for size in 16..21 {
        check_packed_coefficients(data, size, 1234567u32);
      }
      let truncated: u8[] = [];
      for byte in data {
        check_packed_coefficients(truncated, 16, 1234567u32);
        truncated = truncated.append(byte);
      }
    }
  }
}

function parser_properties(): void {
  let Ok(template) = codec.decoder(256, 1) else {
    exit(1);
  };
  require(verify_scan(template, nybbles([0, 0, 15, 15, 0, 0, 0])), "valid noise block reaches the scanner");
  for control in [0, 1, 8, 15] {
    for at in 0..17 {
      let codes: i32[] = [0, 0];
      for i in 0..256 {
        codes = codes.append(if (i == at) { control } else { 2 });
      }
      let _ = verify_scan(template, nybbles(codes));
    }
  }
  let seed = 417u32;
  for trial in 0..500 {
    let data: u8[] = [];
    for i in 0..trial % 65 {
      seed ^= seed << 13u32;
      seed ^= seed >> 17u32;
      seed ^= seed << 5u32;
      data = data.append(seed as u8);
    }
    let _ = verify_scan(template, data);
  }
  for value in template.output {
    require(value == 0.0, "output cache preserves retained aliases");
  }
  for value in template.lap_scratch {
    require(value == 0.0, "overlap cache preserves retained aliases");
  }
  let Ok(buffer) = audio.wav_buffer(44100, 1, 32, 5) else {
    exit(1);
  };
  let alias = buffer;
  let Ok(changed) = audio.write_samples(buffer, 44, [0.5, -0.5, 0.25, -0.25, 0.0], 32) else {
    exit(1);
  };
  for i in 44..64 {
    require(alias[i] == 0u8, "direct float stores preserve byte-buffer aliases");
  }
  let Ok(back) = audio.read_wav(changed) else {
    exit(1);
  };
  require(back.samples[0] == 0.5 && back.samples[1] == -0.5 && back.samples[4] == 0.0, "unaligned float stores include the scalar tail");
}

function packed_file_tests(): void {
  let Ok(template) = packed_decoder.decoder(256, 1) else {
    exit(1);
  };
  let Ok(first) = packed_decoder.decode_block(packed_decoder.Decoder { ...template }, nybbles([0, 0, 15, 15, 0, 0, 0]), 0) else {
    exit(1);
  };
  for bytes in [template.lap, template.coefs, template.re, template.im, template.temp, template.samples, template.output] {
    for value in bytes {
      require(value == 0u8, "packed decoder preserves retained state buffers");
    }
  }
  let retained = first.samples;
  let saved = __alloc_u8(retained.len());
  unsafe {
    __memcpy(saved as usize + 8 as usize, retained as usize + 8 as usize, retained.len());
  }
  let silence = nybbles([0, 14, 15]);
  let Ok(second) = packed_decoder.decode_block(first.state, silence, 0) else {
    exit(1);
  };
  require(!second.silent, "silent coefficients retain the previous overlap");
  let Ok(third) = packed_decoder.decode_block(second.state, silence, 0) else {
    exit(1);
  };
  require(third.silent, "two silent blocks clear the overlap");
  for byte in third.samples {
    require(byte == 0u8, "silent packed blocks contain zero samples");
  }
  for i in 0..retained.len() {
    require(retained[i] == saved[i], "packed decoder preserves retained output blocks");
  }
  require(packed_decoder.decode_block(packed_decoder.Decoder { ...template, coefs: [] }, silence, 0).is_err(), "packed decoder validates its buffer dimensions");
  let source = __alloc_u8(20);
  unsafe {
    __f32x4_store(source as usize + 8 as usize, __f32x4_of(39614081257132168796771975168.0 as f32, -(39614081257132168796771975168.0 as f32), 0.0 as f32, 0.0 as f32));
  }
  let Ok(buffer) = audio.wav_buffer(44100, 1, 32, 5) else {
    exit(1);
  };
  let alias = buffer;
  let Ok(changed) = packed_decoder.write_samples(buffer, 44, source, 1, 32) else {
    exit(1);
  };
  for i in 44..64 {
    require(alias[i] == 0u8, "packed WAV stores preserve byte-buffer aliases");
  }
  let Ok(back) = audio.read_wav(changed) else {
    exit(1);
  };
  require(back.samples[0] == 0.5 && back.samples[1] == -0.5 && back.samples[4] == 0.0, "packed WAV stores include unaligned scalar tails");
  require(packed_decoder.write_samples(__alloc_u8(64), -1, source, 1, 32).is_err(), "packed WAV stores reject negative offsets");
  require(packed_decoder.write_samples(__alloc_u8(64), 44, source, 0, 32).is_err(), "packed WAV stores reject invalid channel counts");
  let nonfinite = __alloc_u8(16);
  unsafe {
    __store_i32(nonfinite as usize + 8 as usize, 2139095040);
  }
  require(packed_decoder.write_samples(__alloc_u8(64), 44, nonfinite, 1, 32).is_err(), "packed WAV stores reject nonfinite samples");
  for channels in 1..4 {
    for frames in 0..10 {
      let source = __alloc_u8(4 * channels * frames);
      let expected = __alloc_u8(source.len());
      unsafe {
        let input = source as usize + 8 as usize;
        for channel in 0..channels {
          for i in 0..frames {
            let value = ((i * 7 + channel * 3) % 17 - 8) as f64 * 9903520314283042199192993792.0;
            __store_i32(input + (4 * (channel * frames + i)) as usize, f32_bits(value as f32));
          }
        }
        for i in 0..frames {
          for channel in 0..channels {
            let a = f32_from_bits(__load_i32(input + (4 * ((channel & ~1) * frames + i)) as usize));
            let value = a;
            if ((channel | 1) < channels) {
              let b = f32_from_bits(__load_i32(input + (4 * ((channel | 1) * frames + i)) as usize));
              value = if ((channel & 1) == 0) { a + b } else { a - b };
            }
            __store_i32(expected as usize + 8 as usize + (4 * (i * channels + channel)) as usize, f32_bits((value as f64 * 1.2621774483536189e-29) as f32));
          }
        }
      }
      let Ok(actual) = packed_decoder.write_samples(__alloc_u8(3 + source.len()), 3, source, channels, 32) else {
        exit(1);
      };
      for i in 0..source.len() {
        require(actual[3 + i] == expected[i], "packed WAV output equals scalar channel reconstruction");
      }
    }
    for bad_bits in [2139095040, -8388608, 2143289345] {
      for index in 0..8 * channels {
        let source = __alloc_u8(32 * channels);
        unsafe {
          __store_i32(source as usize + 8 as usize + (4 * index) as usize, bad_bits);
        }
        require(packed_decoder.write_samples(__alloc_u8(source.len()), 0, source, channels, 32).is_err(), "packed WAV output rejects each nonfinite lane");
      }
    }
  }
}

function pcm_random_tests(): void {
  let seed = 1234567u32;
  for bits in [8, 16, 24] {
    let scale = (1 << bits - 1) as f64;
    for channels in [1, 2] {
      for mode in [0, 1, 2] {
        let frames = 32768;
        let source = __alloc_u8(4 * frames * channels);
        let floats = transform.zeros(frames * channels);
        unsafe {
          let input = source as usize + 8 as usize;
          for channel in 0..channels {
            for i in 0..frames {
              seed ^= seed << 13u32;
              seed ^= seed >> 17u32;
              seed ^= seed << 5u32;
              let value = f32_from_bits(((seed & 2147483647u32) % 2139095040u32 | seed & 2147483648u32) as i32);
              if (mode != 0) {
                let integer = i * 251 % (1 << bits - 1);
                let edge = (integer as f64 + 0.5) * (if (mode == 1) { 1.0 } else { -1.0 });
                let sample = if (channel == 0) { edge } else if (i % 3 == 0) { -0.00000001 } else if (i % 3 == 1) { 0.0 } else { 0.00000001 };
                value = (sample / scale * 79228162514264337593543950336.0) as f32;
              }
              __store_i32(input + (4 * (channel * frames + i)) as usize, f32_bits(value));
            }
          }
          for i in 0..frames {
            let a = f32_from_bits(__load_i32(input + (4 * i) as usize)) as f64;
            let b = if (channels == 2) { f32_from_bits(__load_i32(input + (4 * (frames + i)) as usize)) as f64 } else { 0.0 };
            floats = floats.with(i * channels, (a + b) * 1.2621774483536189e-29);
            if (channels == 2) {
              floats = floats.with(i * channels + 1, (a - b) * 1.2621774483536189e-29);
            }
          }
        }
        let size = frames * channels * (bits / 8);
        let Ok(actual) = packed_decoder.write_samples(__alloc_u8(size + 7), 3, source, channels, bits) else {
          exit(1);
        };
        let Ok(expected) = audio.write_samples(__alloc_u8(size + 7), 3, floats, bits) else {
          exit(1);
        };
        for i in 0..actual.len() {
          require(actual[i] == expected[i], "SIMD matches scalar PCM across random values and half-integer boundaries");
        }
      }
    }
  }
}

function pcm_output_tests(): void {
  for bits in [8, 16, 24] {
    let scale = (1 << bits - 1) as f64;
    let edges = [-2.0, -1.0, -1.0 + 0.5 / scale, -1.5 / scale, -0.5 / scale, -0.0, 0.0, 0.5 / scale, 1.5 / scale, 1.0 - 0.5 / scale, 0.000000000000000055511151231257827 / scale, 2.0, 1.0, -0.000000000000000055511151231257827 / scale];
    for channels in 1..5 {
      for frames in 0..16 {
        let source = __alloc_u8(4 * channels * frames);
        let floats = transform.zeros(channels * frames);
        unsafe {
          let input = source as usize + 8 as usize;
          for channel in 0..channels {
            for i in 0..frames {
              __store_i32(input + (4 * (channel * frames + i)) as usize, f32_bits((edges[(i + 3 * channel) % edges.len()] * 79228162514264337593543950336.0) as f32));
            }
          }
          for i in 0..frames {
            for channel in 0..channels {
              let a = f32_from_bits(__load_i32(input + (4 * ((channel & ~1) * frames + i)) as usize)) as f64;
              let value = a;
              if ((channel | 1) < channels) {
                let b = f32_from_bits(__load_i32(input + (4 * ((channel | 1) * frames + i)) as usize)) as f64;
                value = if ((channel & 1) == 0) { a + b } else { a - b };
              }
              floats = floats.with(i * channels + channel, value * 1.2621774483536189e-29);
            }
          }
        }
        let size = channels * frames * (bits / 8);
        let buffer = __alloc_u8(size + 7);
        let alias = buffer;
        let Ok(actual) = packed_decoder.write_samples(buffer, 3, source, channels, bits) else {
          exit(1);
        };
        let Ok(expected) = audio.write_samples(__alloc_u8(size + 7), 3, floats, bits) else {
          exit(1);
        };
        for i in 0..actual.len() {
          require(actual[i] == expected[i], "direct PCM preserves scalar rounding, clipping, and output bounds");
          require(alias[i] == 0u8, "direct PCM preserves retained output aliases");
        }
      }
      for bad in [2139095040, -8388608, 2143289345] {
        for i in 0..channels * 4 {
          let source = __alloc_u8(16 * channels);
          unsafe {
            __store_i32(source as usize + 8 as usize + (4 * i) as usize, bad);
          }
          require(packed_decoder.write_samples(__alloc_u8(16 * channels), 0, source, channels, bits).is_err(), "direct PCM rejects every nonfinite input lane");
        }
      }
    }
  }
}

pub function run_tests(): i32 {
  plan_grid_tests();
  deferred_plan_tests();
  window_cache_tests();
  transform_tests();
  print("ok - transform definition and lapping");
  packed_tests();
  packed_output_tests();
  coefficient_parser_tests();
  parser_properties();
  packed_file_tests();
  pcm_output_tests();
  pcm_random_tests();
  print("ok - packed FFT, noise index, and seed jumps");
  syntax_tests();
  print("ok - coefficient syntax and validation");
  encoder_features();
  planar_tests();
  priority_rank_tests();
  paired_log_tests();
  print("ok - transient encoder, rate control, and count-only passes");
  containers();
  print("ok - WAV and ULC2 roundtrips");
  return 0;
}

function main(): i32 {
  return run_tests();
}
