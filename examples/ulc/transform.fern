// Pure Fern radix-2 FFT and unnormalised DCT-IV.
import "std/array";
import "std/f64";

const PI: f64 = 3.141592653589793;

pub function zeros(n: i32): f64[] {
  if (n <= 0) {
    return [];
  }
  return __alloc_f64(n);
}

pub struct Plan { n: i32, reversal: i32[], pre_cos: f64[], pre_sin: f64[], post_cos: f64[], post_sin: f64[], fft_cos: f64[], fft_sin: f64[], window_cos: f64[], window_sin: f64[] }

struct TrigGrid { cosine: f64[], sine: f64[] }

// Direct evaluation every 32 steps bounds the error of the angle recurrence.
@inline
function grid(own cosine: f64[], own sine: f64[], offset: i32, count: i32, start: f64, step: f64): TrigGrid {
  let dc = step.cos();
  let ds = step.sin();
  let base = 0;
  while (base < count) {
    let angle = start + step * (base as f64);
    let c = angle.cos();
    let s = angle.sin();
    let end = if (count - base < 32) { count } else { base + 32 };
    let i = base;
    while (i < end) {
      cosine = cosine.with(offset + i, c);
      sine = sine.with(offset + i, s);
      let next = c * dc - s * ds;
      s = s * dc + c * ds;
      c = next;
      i += 1;
    }
    base = end;
  }
  return TrigGrid { cosine: cosine, sine: sine };
}

pub function plan(n: i32): Plan {
  if (n <= 0) {
    return Plan { n: n, reversal: [], pre_cos: [], pre_sin: [], post_cos: [], post_sin: [], fft_cos: [], fft_sin: [], window_cos: [0.7071067811865476], window_sin: [0.7071067811865476] };
  }
  let half = n / 2;
  let TrigGrid { cosine: pre_cos, sine: pre_sin } = grid(zeros(half), zeros(half), 0, half, 0.0, PI / (n as f64));
  let TrigGrid { cosine: post_cos, sine: post_sin } = grid(zeros(half), zeros(half), 0, half, PI / (4.0 * (n as f64)), PI / (n as f64));
  let fft_cos = zeros(half - 1);
  let fft_sin = zeros(half - 1);
  let reversal = __alloc_i32(half);
  let reversed = 0;
  for j in 0..half {
    reversal = reversal.with(j, reversed);
    let bit = half >> 1;
    while ((reversed & bit) != 0) {
      reversed ^= bit;
      bit >>= 1;
    }
    reversed ^= bit;
  }
  let width = 2;
  while (width <= half) {
    let pair = grid(fft_cos, fft_sin, width / 2 - 1, width / 2, 0.0, 2.0 * PI / (width as f64));
    fft_cos = pair.cosine;
    fft_sin = pair.sine;
    width *= 2;
  }
  let window_cos = zeros(n);
  let window_sin = zeros(n);
  let overlap = n;
  while (overlap >= 2) {
    let pair = grid(window_cos, window_sin, n - overlap, overlap / 2, PI / (4.0 * (overlap as f64)), PI / (2.0 * (overlap as f64)));
    window_cos = pair.cosine;
    window_sin = pair.sine;
    overlap >>= 1;
  }
  window_cos = window_cos.with(n - 1, 0.7071067811865476);
  window_sin = window_sin.with(n - 1, 0.7071067811865476);
  return Plan { n: n, reversal: reversal, pre_cos: pre_cos, pre_sin: pre_sin, post_cos: post_cos, post_sin: post_sin, fft_cos: fft_cos, fft_sin: fft_sin, window_cos: window_cos, window_sin: window_sin };
}

pub struct Scratch { re: f64[], im: f64[], transformed: f64[], samples: f64[] }

pub function scratch(n: i32): Scratch {
  return Scratch { re: zeros(n / 2), im: zeros(n / 2), transformed: zeros(n), samples: zeros(n) };
}

// Pair even coefficients with reversed odd coefficients for an N/2-point FFT.
pub function dct4_reuse(input: [f64], p: Plan, own work: Scratch): Scratch {
  let n = p.n;
  let half = n / 2;
  let re = work.re;
  let im = work.im;
  for j in 0..half {
    let a = input[2 * j];
    let b = input[n - 1 - 2 * j];
    let at = p.reversal[j];
    re = re.with(at, a * p.pre_cos[j] + b * p.pre_sin[j]);
    im = im.with(at, a * p.pre_sin[j] - b * p.pre_cos[j]);
  }
  let width = 2;
  while (width <= half) {
    let twiddle = width / 2 - 1;
    let base = 0;
    while (base < half) {
      if (width == 2) {
        let ar = re[base];
        let ai = im[base];
        let br = re[base + 1];
        let bi = im[base + 1];
        re = re.with(base, ar + br);
        im = im.with(base, ai + bi);
        re = re.with(base + 1, ar - br);
        im = im.with(base + 1, ai - bi);
      } else {
        let k = 0;
        while (k < width / 2) {
          let a = base + k;
          let b = a + width / 2;
          let cr = __f64x2_load(p.fft_cos, twiddle + k);
          let ci = __f64x2_load(p.fft_sin, twiddle + k);
          let br = __f64x2_load(re, b);
          let bi = __f64x2_load(im, b);
          let vr = br * cr - bi * ci;
          let vi = br * ci + bi * cr;
          let ur = __f64x2_load(re, a);
          let ui = __f64x2_load(im, a);
          re = __f64x2_with(re, a, ur + vr);
          im = __f64x2_with(im, a, ui + vi);
          re = __f64x2_with(re, b, ur - vr);
          im = __f64x2_with(im, b, ui - vi);
          k += 2;
        }
      }
      base += width;
    }
    width *= 2;
  }
  let out = work.transformed;
  for j in 0..half {
    let c = p.post_cos[j];
    let s = p.post_sin[j];
    out = out.with(2 * j, re[j] * c - im[j] * s);
    out = out.with(n - 1 - 2 * j, re[j] * s + im[j] * c);
  }
  return Scratch { ...work, re: re, im: im, transformed: out };
}

pub function dct4_planned(input: [f64], p: Plan): f64[] {
  let work = Scratch { re: zeros(p.n / 2), im: zeros(p.n / 2), transformed: zeros(p.n), samples: [] };
  return dct4_reuse(input, p, work).transformed;
}

pub function dct4(input: [f64]): f64[] {
  return dct4_planned(input, plan(input.len()));
}

pub struct Inverse { samples: f64[], lap: f64[] }

pub struct ReusedInverse { lap: f64[], work: Scratch }

// The lapping layout follows libfourier's Fourier_IMDCT_Template.
pub function inverse_reuse(coefs: [f64], own lap: f64[], overlap: i32, p: Plan, own work: Scratch): ReusedInverse {
  let n = coefs.len();
  let silent = true;
  for value in coefs {
    if (value != 0.0) {
      silent = false;
      break;
    }
  }
  if (!silent) {
    work = dct4_reuse(coefs, p, work);
  }
  let Scratch { re, im, transformed: temp, samples: out } = work;
  if (silent) {
    for i in 0..n {
      temp = temp.with(i, 0.0);
    }
  }
  let flat = (n - overlap) / 2;
  for i in 0..n / 2 {
    let a = lap[n / 2 - 1 - i];
    let b = temp[n / 2 + i];
    if (i < flat) {
      out = out.with(i, a);
      out = out.with(n - 1 - i, b);
    } else {
      let c = p.window_cos[n - overlap + i - flat];
      let s = p.window_sin[n - overlap + i - flat];
      out = out.with(i, c * a - s * b);
      out = out.with(n - 1 - i, s * a + c * b);
    }
  }
  for i in 0..n / 2 {
    lap = lap.with(i, temp[i]);
  }
  return ReusedInverse { lap: lap, work: Scratch { re: re, im: im, transformed: temp, samples: out } };
}

pub function inverse_planned(coefs: [f64], own lap: f64[], overlap: i32, p: Plan): Inverse {
  let result = inverse_reuse(coefs, lap, overlap, p, scratch(p.n));
  return Inverse { samples: result.work.samples, lap: result.lap };
}

pub function inverse(coefs: [f64], own lap: f64[], overlap: i32): Inverse {
  return inverse_planned(coefs, lap, overlap, plan(coefs.len()));
}

pub struct Forward { coefs: f64[], lap: f64[] }

// Long-window MDCT. Its normalisation belongs in the encoder.
pub function forward(samples: [f64], own lap: f64[]): Forward {
  let n = samples.len();
  let folded = zeros(n);
  for i in 0..n / 2 {
    let angle = PI * (i as f64 + 0.5) / ((2 * n) as f64);
    let c = angle.cos();
    let s = angle.sin();
    folded = folded.with(n / 2 - 1 - i, c * samples[i] + s * samples[n - 1 - i]);
    folded = folded.with(n / 2 + i, lap[i]);
    lap = lap.with(i, -s * samples[i] + c * samples[n - 1 - i]);
  }
  let coefs = dct4(folded);
  for i in 0..n {
    coefs = coefs.with(i, coefs[i] * (2.0 / (n as f64)));
  }
  return Forward { coefs: coefs, lap: lap };
}

pub struct Dual { mdct: f64[], mdst: f64[], lap: f64[] }

pub function forward_dual(samples: [f64], own lap: f64[], offset: i32, overlap: i32, p: Plan): Dual {
  let n = samples.len();
  let half = n / 2;
  let ct = zeros(n);
  let st = zeros(n);
  let flat = (n - overlap) / 2;
  for i in 0..half {
    let a = lap[offset + i];
    let b = lap[offset + n - 1 - i];
    let c = samples[i];
    let d = samples[n - 1 - i];
    let cosine = 1.0;
    let sine = 0.0;
    if (i >= flat) {
      cosine = p.window_cos[n - overlap + i - flat];
      sine = p.window_sin[n - overlap + i - flat];
    }
    lap = lap.with(offset + i, sine * c);
    lap = lap.with(offset + n - 1 - i, cosine * d);
    ct = ct.with(half - 1 - i, cosine * c + sine * d);
    ct = ct.with(half + i, -a + b);
    st = st.with(half - 1 - i, cosine * c - sine * d);
    st = st.with(half + i, a + b);
  }
  for i in 0..half {
    st = st.with(2 * i + 1, -st[2 * i + 1]);
  }
  ct = dct4_planned(ct, p);
  st = dct4_planned(st, p);
  let mdst = zeros(n);
  let scale = 2.0 / (n as f64);
  for i in 0..n {
    ct = ct.with(i, ct[i] * scale);
    mdst = mdst.with(i, st[n - 1 - i] * scale);
  }
  return Dual { mdct: ct, mdst: mdst, lap: lap };
}
