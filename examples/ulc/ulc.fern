import "std/number_parse";
import "std/string";
import "std/i32";
import "std/f64";
import "std/io";
import "std/result";
import "./audio";
import "./file_decoder";
import "./file_encoder";
import "./encoder";

function usage(): i32 {
  print("ULC2 codec in Fern\nUsage:\n  ulc encode INPUT.wav OUTPUT.ulc [QUALITY=75] [BLOCKSIZE=2048]\n  ulc encode-cbr INPUT.wav OUTPUT.ulc KBPS [BLOCKSIZE=2048]\n  ulc encode-abr INPUT.wav OUTPUT.ulc KBPS [BLOCKSIZE=2048] [AVERAGE_COMPLEXITY]\n  ulc analyze INPUT.wav [BLOCKSIZE=2048]\n  ulc decode INPUT.ulc OUTPUT.wav [PCM8|PCM16|PCM24|FLOAT32] [THREADS=auto]\n  ulc info INPUT.ulc");
  return 1;
}

function integer(s: string): Result[i32, string] {
  return i32.parse_i32(s).map_err((e: number_parse.ParseNumberError): string => e.message());
}

function number(s: string): Result[f64, string] {
  return f64.parse_f64(s).map_err((e: number_parse.ParseNumberError): string => e.message());
}

function selected_threads(): Result[i32, string] {
  let available = cpu_count();
  let threads = if (target_os() != "linux") { 1 } else if (available >= 4) { 4 } else if (available >= 2) { 2 } else { 1 };
  if let Some(value) = env("ULC_THREADS") {
    threads = integer(value)?;
  }
  if (threads != 1 && threads != 2 && threads != 4) {
    return Err("ULC_THREADS must be 1, 2, or 4");
  }
  return Ok(threads);
}

function run(argv: string[]): Result[i32, string] {
  if (argv.len() < 3) {
    return Ok(usage());
  }
  let command = argv[1];
  if (command != "encode" && command != "encode-cbr" && command != "encode-abr" && command != "decode" && command != "info" && command != "analyze") {
    return Ok(usage());
  }
  if (command == "info" && argv.len() != 3 || command == "analyze" && argv.len() > 4) {
    return Ok(usage());
  }
  if (command != "info" && command != "analyze" && argv.len() < 4) {
    return Ok(usage());
  }
  if ((command == "encode-cbr" || command == "encode-abr") && argv.len() < 5) {
    return Ok(usage());
  }
  if (command == "decode" && argv.len() > 6 || command != "encode-abr" && argv.len() > 6 || argv.len() > 7) {
    return Ok(usage());
  }
  let input = read_file_bytes(argv[2]).map_err((e: IoError): string => e.message())?;
  if (command == "info") {
    let h = audio.header(input)?;
    print("ULC2: " + h.rate.to_string() + " Hz, " + h.channels.to_string() + " channels, block size " + h.block_size.to_string() + ", " + h.blocks.to_string() + " blocks");
    return Ok(0);
  }
  if (command == "analyze") {
    let size = 2048;
    if (argv.len() == 4) {
      size = integer(argv[3])?;
    }
    print(audio.analyze(audio.read_wav(input)?, size)?.to_string());
    return Ok(0);
  }
  let output: u8[] = [];
  if (command == "decode") {
    let bits = 16;
    if (argv.len() >= 5) {
      let format = argv[4];
      if (format == "PCM8") {
        bits = 8;
      } else if (format == "PCM16") {
        bits = 16;
      } else if (format == "PCM24") {
        bits = 24;
      } else if (format == "FLOAT32") {
        bits = 32;
      } else {
        return Err("unknown output format: " + format);
      }
    }
    let threads = selected_threads()?;
    if (argv.len() == 6) {
      threads = integer(argv[5])?;
    }
    file_decoder.write(input, bits, threads, argv[3])?;
    return Ok(0);
  } else {
    let rate = 75.0;
    let size = 2048;
    if (argv.len() >= 5) {
      rate = number(argv[4])?;
    }
    if (argv.len() >= 6) {
      size = integer(argv[5])?;
    }
    let source = audio.read_wav(input)?;
    let mode = encoder.Vbr(rate);
    if (command == "encode-cbr") {
      mode = encoder.Cbr(rate);
    } else if (command == "encode-abr") {
      let average = 1.0;
      if (argv.len() == 7) {
        average = number(argv[6])?;
      } else {
        average = audio.analyze(source, size)?;
        if (average == 0.0) {
          average = 1.0;
        }
      }
      mode = encoder.Abr(rate, average);
    }
    output = file_encoder.encode(source, mode, size, selected_threads()?)?;
  }
  write_file_bytes(argv[3], output).map_err((e: IoError): string => e.message())?;
  return Ok(0);
}

function main(): i32 {
  match (run(args())) {
    Ok(code) => {
      return code;
    },
    Err(message) => {
      eprint("ulc: " + message);
      return 1;
    }
  }
}
