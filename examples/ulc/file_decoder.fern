// Parallel file decode with exact noise-seed and overlap reconstruction.
import "std/array";
import "std/worker";
import "std/io";
import "std/result";
import "./audio";
import "./codec";
import "./packed_decoder";

struct Index { offsets: i32[], noise: i32[], last_size: i32[], silent: boolean }

// The caller fills every data byte before the buffer can leave this module.
unsafe function decoded_buffer(h: audio.Header, bits: i32, blocks: i32): Result[u8[], string] {
  let header = audio.wav_buffer(h.rate, h.channels, bits, 0)?;
  let size = blocks as u64 * (h.block_size as u64) * (h.channels as u64) * ((bits / 8) as u64);
  if (size > 1073741760u64) {
    return Err("WAV output is too large");
  }
  unsafe {
    let out = __alloc_u8_uninit(44 + size as i32 + (size as i32 & 1));
    let address = out as usize + 8 as usize;
    __memcpy(address, header as usize + 8 as usize, 44);
    __store_i32(address + 4 as usize, (size + 36u64) as i32);
    __store_i32(address + 40 as usize, size as i32);
    if ((size & 1u64) != 0u64) {
      __store_u8(address + 44 as usize + size as usize, 0);
    }
    return Ok(out);
  }
}

function clear_block(out: u8[], at: i32, count: i32, bits: i32): void {
  unsafe {
    __memset(out as usize + 8 as usize + at as usize, if (bits == 8) { 128 } else { 0 }, count);
  }
}

function index(data: u8[], h: audio.Header): Result[Index, string] {
  let offsets: i32[] = [h.offset];
  let noise: i32[] = [0];
  let sizes: i32[] = [0];
  let at = h.offset;
  let total = 0;
  let silent = true;
  for i in 0..h.blocks {
    let block = codec.scan_block(data, at, h.block_size, h.channels)?;
    if (h.max_block_bytes != 0 && block.next_byte - at > h.max_block_bytes) {
      return Err("block exceeds ULC2 maximum block size");
    }
    at = block.next_byte;
    total += block.noise_samples;
    silent = silent && block.silent;
    offsets = offsets.append(at);
    noise = noise.append(total);
    sizes = sizes.append(block.last_size);
  }
  return Ok(Index { offsets: offsets, noise: noise, last_size: sizes, silent: silent });
}

function part(data: u8[], h: audio.Header, ix: Index, template: packed_decoder.Decoder, begin: i32, end: i32, bits: i32): Result[u8[], string] {
  let start = if (begin > 0) { begin - 1 } else { 0 };
  let state = template;
  state = packed_decoder.Decoder { ...state, seed: codec.advance_seed(1234567u32, ix.noise[start]), last_size: ix.last_size[start] };
  let out: u8[] = [];
  unsafe {
    out = decoded_buffer(h, bits, end - begin)?;
  }
  for i in start..end {
    let block = packed_decoder.decode_block(state, data, ix.offsets[i])?;
    state = block.state;
    if (i >= begin) {
      let count = h.block_size * h.channels * (bits / 8);
      let offset = 44 + (i - begin) * count;
      if (block.silent) {
        clear_block(out, offset, count, bits);
      } else {
        out = packed_decoder.write_samples(out, offset, block.samples, h.channels, bits)?;
      }
    }
  }
  return Ok(out);
}

function combine(parts: u8[][]): u8[] {
  let total = 44;
  for part in parts {
    total += part.len() - 44;
  }
  let output = __alloc_u8(total);
  let at = 0;
  for i in 0..parts.len() {
    let start = if (i == 0) { 0 } else { 44 };
    let count = parts[i].len() - start;
    output = __bytes_into(output, at, parts[i], start, count);
    at += count;
  }
  let size = (output.len() - 44) as u32;
  let riff = (output.len() - 8) as u32;
  for i in 0..4 {
    output = output.with(4 + i, (riff >> (8 * i) as u32) as u8);
    output = output.with(40 + i, (size >> (8 * i) as u32) as u8);
  }
  return output;
}

function serial(data: u8[], h: audio.Header, bits: i32): Result[u8[], string] {
  let out: u8[] = [];
  unsafe {
    out = decoded_buffer(h, bits, h.blocks)?;
  }
  let state = packed_decoder.decoder(h.block_size, h.channels)?;
  let offset = h.offset;
  for i in 0..h.blocks {
    let block = packed_decoder.decode_block(state, data, offset)?;
    if (h.max_block_bytes != 0 && block.next_byte - offset > h.max_block_bytes) {
      return Err("block exceeds ULC2 maximum block size");
    }
    state = block.state;
    offset = block.next_byte;
    let count = h.block_size * h.channels * (bits / 8);
    let at = 44 + i * count;
    if (block.silent) {
      clear_block(out, at, count, bits);
    } else {
      out = packed_decoder.write_samples(out, at, block.samples, h.channels, bits)?;
    }
  }
  return Ok(out);
}

pub function decode(data: u8[], bits: i32, threads: i32): Result[u8[], string] {
  if (threads != 1 && threads != 2 && threads != 4) {
    return Err("decoder threads must be 1, 2, or 4");
  }
  let h = audio.header(data)?;
  if (h.blocks as u64 * (h.block_size as u64) * (h.channels as u64) > 134217728u64) {
    return Err("decoded audio exceeds the in-memory limit (134217728 samples)");
  }
  if (threads == 1 || h.blocks < 32) {
    return serial(data, h, bits);
  }
  let ix = index(data, h)?;
  if (ix.silent) {
    return Ok(audio.wav_buffer(h.rate, h.channels, bits, h.blocks * h.block_size * h.channels)?);
  }
  let template = packed_decoder.decoder(h.block_size, h.channels)?;
  let half = h.blocks / 2;
  if (threads == 2) {
    let left = worker.spawn((): Result[u8[], string] => part(data, h, ix, template, 0, half, bits));
    let right = part(data, h, ix, template, half, h.blocks, bits);
    let first = left.join();
    return Ok(combine([first?, right?]));
  }
  let q = h.blocks / 4;
  let a = worker.spawn((): Result[u8[], string] => part(data, h, ix, template, 0, q, bits));
  let b = worker.spawn((): Result[u8[], string] => part(data, h, ix, template, q, half, bits));
  let c = worker.spawn((): Result[u8[], string] => part(data, h, ix, template, half, half + q, bits));
  let fourth = part(data, h, ix, template, half + q, h.blocks, bits);
  let first = a.join();
  let second = b.join();
  let third = c.join();
  return Ok(combine([first?, second?, third?, fourth?]));
}

function shared_part(data: u8[], h: audio.Header, ix: Index, template: packed_decoder.Decoder, begin: i32, end: i32, bits: i32, destination: usize): Result[void, string] {
  let start = if (begin > 0) { begin - 1 } else { 0 };
  let state = packed_decoder.Decoder { ...template, seed: codec.advance_seed(1234567u32, ix.noise[start]), last_size: ix.last_size[start] };
  let block_bytes = h.block_size * h.channels * (bits / 8);
  let bytes = if (bits == 32) { [] } else { __alloc_u8(block_bytes) };
  for i in start..end {
    let block = packed_decoder.decode_block(state, data, ix.offsets[i])?;
    state = block.state;
    if (i >= begin && !block.silent) {
      if (bits == 32) {
        unsafe {
          // The validated file limit bounds this range. Workers own disjoint blocks.
          packed_decoder.store_float_samples(destination + 44 as usize + (i * block_bytes) as usize, block.samples, h.channels)?;
        }
      } else {
        bytes = packed_decoder.write_samples(bytes, 0, block.samples, h.channels, bits)?;
        unsafe {
          __memcpy(destination + 44 as usize + (i * block_bytes) as usize, bytes as usize + 8 as usize, block_bytes);
        }
      }
    }
  }
  return Ok(());
}

struct Child { pid: i32, status: usize, outcome: Result[void, string] }

function launch(data: u8[], h: audio.Header, ix: Index, template: packed_decoder.Decoder, begin: i32, end: i32, bits: i32, destination: usize, status: usize): Child {
  let pid = proc_fork();
  if (pid == 0) {
    let result = shared_part(data, h, ix, template, begin, end, bits, destination);
    let success = match (result) { Ok(_) => 1, Err(_) => -1 };
    unsafe {
      // Scratch allocations stay in the child's private heap.
      __store_i32(status + 64 as usize, success);
      __worker_exit(status as i64, 0 as usize);
    }
  }
  if (pid < 0) {
    return Child { pid: 0, status: status, outcome: shared_part(data, h, ix, template, begin, end, bits, destination) };
  }
  return Child { pid: pid, status: status, outcome: Ok(()) };
}

function join(child: Child): Result[void, string] {
  if (child.pid == 0) {
    return child.outcome;
  }
  let status = proc_waitpid_status(child.pid);
  while (status == -4) {
    status = proc_waitpid_status(child.pid);
  }
  if (status != 0) {
    return Err("parallel decoder worker failed");
  }
  unsafe {
    if (__load_i32(child.status + 64 as usize) != 1) {
      return Err("parallel decoder worker failed");
    }
  }
  return Ok(());
}

function shared_work(data: u8[], h: audio.Header, ix: Index, template: packed_decoder.Decoder, bits: i32, threads: i32, destination: usize, controls: usize): Result[void, string] {
  let half = h.blocks / 2;
  if (threads == 2) {
    let left = launch(data, h, ix, template, 0, half, bits, destination, controls);
    let right = shared_part(data, h, ix, template, half, h.blocks, bits, destination);
    let first = join(left);
    first?;
    right?;
    return Ok(());
  }
  let q = h.blocks / 4;
  let a = launch(data, h, ix, template, 0, q, bits, destination, controls);
  let b = launch(data, h, ix, template, q, half, bits, destination, controls + 128 as usize);
  let c = launch(data, h, ix, template, half, half + q, bits, destination, controls + 256 as usize);
  let fourth = shared_part(data, h, ix, template, half + q, h.blocks, bits, destination);
  let first = join(a);
  let second = join(b);
  let third = join(c);
  first?;
  second?;
  third?;
  fourth?;
  return Ok(());
}

// The mapping stays live until every worker joins and the file write ends.
pub function write(data: u8[], bits: i32, threads: i32, path: string): Result[void, string] {
  if (target_os() == "linux") {
    return write_linux(data, bits, threads, path);
  }
  return save(path, decode(data, bits, threads)?);
}

function write_linux(data: u8[], bits: i32, threads: i32, path: string): Result[void, string] {
  if (threads != 1 && threads != 2 && threads != 4) {
    return Err("decoder threads must be 1, 2, or 4");
  }
  let h = audio.header(data)?;
  let count = h.blocks as u64 * (h.block_size as u64) * (h.channels as u64);
  if (count > 134217728u64) {
    return Err("decoded audio exceeds the in-memory limit (134217728 samples)");
  }
  let header = audio.wav_buffer(h.rate, h.channels, bits, 0)?;
  let size = count * ((bits / 8) as u64);
  if (size > 1073741760u64) {
    return Err("WAV output is too large");
  }
  if (threads == 1 || h.blocks < 4 || count < 65536u64) {
    return save(path, decode(data, bits, threads)?);
  }
  let ix = index(data, h)?;
  if (ix.silent) {
    return save(path, audio.wav_buffer(h.rate, h.channels, bits, count as i32)?);
  }
  let template = packed_decoder.decoder(h.block_size, h.channels)?;
  let region_size = (size + 1024u64) as i64;
  let region = 0i64;
  unsafe {
    region = __worker_region(region_size);
  }
  if (region <= 0i64) {
    return save(path, decode(data, bits, threads)?);
  }
  let box = region as usize + 512 as usize;
  let destination = box + 8 as usize;
  unsafe {
    // This temporary byte-array header is immortal. It never enters the heap.
    __store_i32(box - 8 as usize, -1);
    __store_i64(box, (size + 44u64) as i64);
    __memcpy(destination, header as usize + 8 as usize, 44);
    __store_i32(destination + 4 as usize, (size + 36u64) as i32);
    __store_i32(destination + 40 as usize, size as i32);
    if (bits == 8) {
      __memset(destination + 44 as usize, 128, size as i32);
    }
  }
  let result = shared_work(data, h, ix, template, bits, threads, destination, region as usize);
  if let Err(error) = result {
    unsafe {
      __worker_unmap(region, region_size, false);
    }
    return Err(error);
  }
  let written: Result[void, string] = Ok(());
  unsafe {
    let bytes = box as u8[];
    written = save(path, bytes);
    // Drop the borrowed array before its mapping leaves the address space.
    __send_release(bytes);
    __worker_unmap(region, region_size, false);
  }
  return written;
}

function save(path: string, bytes: u8[]): Result[void, string] {
  return write_file_bytes(path, bytes).map_err((e: IoError): string => e.message());
}
