// The text of --debug: the request and the response as oha writes them,
// with the `{:#?}` form of Rust's `http::Request` and `http::Response`.
import "std/i32";
import "std/string";
import "std/utf8";
import "./fields";

// The version of HTTP as `http::Version` writes it.
pub function version_text(http: i32): string {
  return match (http) {
    10 => "HTTP/1.0",
    20 => "HTTP/2.0",
    30 => "HTTP/3.0",
    _ => "HTTP/1.1",
  };
}

// A value of a header field as `HeaderValue` writes it: in quotes, with an
// escape for a quote and for each byte that is not visible ASCII.
pub function value_text(v: u8[]): string {
  let out: u8[] = [34 as u8];
  for b in v {
    if (b == 34 as u8) {
      out = out.concat("\\\"".bytes());
    } else if (b >= 32 as u8 && b < 127 as u8 || b == 9 as u8) {
      out = out.append(b);
    } else {
      out = out.concat(("\\x" + (b as i32).to_hex()).bytes());
    }
  }
  return utf8.from_bytes_lossy(out.append(34 as u8));
}

// Bytes as the `Bytes` of the bytes crate writes them: `b"..."` with the
// escapes of a byte string of Rust.
pub function bytes_text(v: u8[]): string {
  let out: u8[] = "b\"".bytes();
  for b in v {
    let escape = match (b as i32) {
      10 => "\\n",
      13 => "\\r",
      9 => "\\t",
      92 => "\\\\",
      34 => "\\\"",
      0 => "\\0",
      _ => "",
    };
    if (escape.len() > 0) {
      out = out.concat(escape.bytes());
    } else if (b >= 32 as u8 && b < 127 as u8) {
      out = out.append(b);
    } else {
      out = out.concat(("\\x" + (b as i32).to_hex().pad_start(2, '0')).bytes());
    }
  }
  return utf8.from_bytes_lossy(out.append(34 as u8));
}

function headers_text(f: fields.Field[]): string {
  let out = "    headers: {\n";
  for x in f {
    out += "        \"" + x.name + "\": " + value_text(x.value.bytes()) + ",\n";
  }
  return out + "    },\n";
}

// The request of --debug.
pub function request_text(method: string, uri: string, http: i32, f: fields.Field[], body: u8[]): string {
  let out = "Request {\n    method: " + method + ",\n    uri: " + uri + ",\n    version: " + version_text(http) + ",\n" + headers_text(f);
  if (body.len() == 0) {
    return out + "    body: Full {\n        data: None,\n    },\n}\n";
  }
  return out + "    body: Full {\n        data: Some(\n            " + bytes_text(body) + ",\n        ),\n    },\n}\n";
}

// The response of --debug.
pub function response_text(status: i32, http: i32, f: fields.Field[], body: u8[]): string {
  return "Response {\n    status: " + status.to_string() + ",\n    version: " + version_text(http) + ",\n" + headers_text(f) + "    body: " + bytes_text(body) + ",\n}\n";
}
