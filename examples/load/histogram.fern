// A histogram of latencies in nanoseconds, with the log-linear buckets of
// HdrHistogram. Values below 2^SUB_BITS have a bucket each. Above, each power
// of two has HALF buckets, so a bucket is at most 1/HALF of its lowest value
// wide: three significant digits.
import "std/f64";
import "std/i64";

const SUB_BITS: i32 = 11;

const SUB: i32 = 2048;

const HALF: i32 = 1024;

// The last power of two with buckets: 2^47 ns is 39 hours. Longer values go
// in the last bucket.
const TOP_BITS: i32 = 47;

pub const BUCKETS: i32 = SUB + (TOP_BITS - SUB_BITS) * HALF;

pub struct Histogram { counts: i64[], total: i64, min: i64, max: i64, sum: i64 }

pub function new(): Histogram {
  let counts: i64[] = [];
  for _ in 0..BUCKETS {
    counts = counts.append(0);
  }
  return Histogram { counts: counts, total: 0, min: 0, max: 0, sum: 0 };
}

pub function index_of(v: i64): i32 {
  if (v < SUB as i64) {
    if (v < 0) {
      return 0;
    }
    return v as i32;
  }
  let shift = 64 - v.leading_zeros() - SUB_BITS;
  let index = SUB + (shift - 1) * HALF + (v >> shift as i64) as i32 - HALF;
  if (index >= BUCKETS) {
    return BUCKETS - 1;
  }
  return index;
}

pub function lowest(index: i32): i64 {
  if (index < SUB) {
    return index as i64;
  }
  let shift = (index - SUB) / HALF + 1;
  return ((index - SUB) % HALF + HALF) as i64 << shift as i64;
}

pub function highest(index: i32): i64 {
  if (index < SUB) {
    return index as i64;
  }
  let shift = (index - SUB) / HALF + 1;
  return lowest(index) + (1 as i64 << shift as i64) - 1;
}

pub function (h: Histogram) record(v: i64): Histogram {
  let i = index_of(v);
  let min = if (h.total == 0 || v < h.min) { v } else { h.min };
  let max = if (v > h.max) { v } else { h.max };
  return Histogram { counts: h.counts.with(i, h.counts[i] + 1), total: h.total + 1, min: min, max: max, sum: h.sum + v };
}

pub function (h: Histogram) mean(): i64 {
  if (h.total == 0) {
    return 0;
  }
  return h.sum / h.total;
}

// The value at `hundredths` of a percent, 9999 for 99.99%: the highest value
// of the bucket that holds that rank, but not past the extremes recorded. As
// in oha, the rank of p percent of N values is floor(p / 100 * N) + 1.
pub function (h: Histogram) at(hundredths: i64): i64 {
  if (h.total == 0) {
    return 0;
  }
  let rank = h.total * hundredths / 10000 + 1;
  if (rank > h.total) {
    rank = h.total;
  }
  let seen: i64 = 0;
  for i in 0..BUCKETS {
    seen += h.counts[i];
    if (seen >= rank) {
      let v = highest(i);
      if (v > h.max) {
        return h.max;
      }
      if (v < h.min) {
        return h.min;
      }
      return v;
    }
  }
  return h.max;
}

// The histogram of the values of both `h` and `o`.
pub function (h: Histogram) merge(o: Histogram): Histogram {
  if (o.total == 0) {
    return h;
  }
  if (h.total == 0) {
    return o;
  }
  let counts = h.counts;
  for i in 0..BUCKETS {
    if (o.counts[i] != 0) {
      counts = counts.with(i, counts[i] + o.counts[i]);
    }
  }
  let min = if (o.min < h.min) { o.min } else { h.min };
  let max = if (o.max > h.max) { o.max } else { h.max };
  return Histogram { counts: counts, total: h.total + o.total, min: min, max: max, sum: h.sum + o.sum };
}

// The count of each of `bins` bins from the lowest value to the highest, as
// the histogram of oha has them: bin k holds the values above bin k - 1 and
// not above `min + k * (max - min) / (bins - 1)`. A bucket goes in the bin of
// its lowest value, but not below the lowest value recorded.
pub function (h: Histogram) bins(bins: i32): i64[] {
  let out: i64[] = [];
  for _ in 0..bins {
    out = out.append(0);
  }
  if (h.total == 0) {
    return out;
  }
  let span = (h.max - h.min) as f64;
  for i in 0..BUCKETS {
    let n = h.counts[i];
    if (n == 0) {
      continue;
    }
    let v = lowest(i);
    if (v < h.min) {
      v = h.min;
    }
    let k = 0;
    if (span > 0.0) {
      k = ((v - h.min) as f64 * ((bins - 1) as f64) / span).ceil() as i32;
      if (k >= bins) {
        k = bins - 1;
      }
    }
    out = out.with(k, out[k] + n);
  }
  return out;
}
