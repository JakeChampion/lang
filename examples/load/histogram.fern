// The latencies of a run in nanoseconds, each value kept, as oha keeps them.
// The percentiles and the bins come from the values themselves.
import "core/cmp";
import "std/array";
import "std/f64";
import "std/i64";

// `sorted` says that `values` is in ascending order.
pub struct Histogram { values: i64[], total: i64, min: i64, max: i64, sum: i64, sorted: boolean }

pub function new(): Histogram {
  let values: i64[] = [];
  return Histogram { values: values, total: 0, min: 0, max: 0, sum: 0, sorted: true };
}

pub function (h: Histogram) record(v: i64): Histogram {
  let min = if (h.total == 0 || v < h.min) { v } else { h.min };
  let max = if (h.total == 0 || v > h.max) { v } else { h.max };
  let sorted = h.sorted && (h.total == 0 || v >= h.max);
  return Histogram { values: h.values.append(v), total: h.total + 1, min: min, max: max, sum: h.sum + v, sorted: sorted };
}

pub function (h: Histogram) mean(): i64 {
  if (h.total == 0) {
    return 0;
  }
  return h.sum / h.total;
}

// The value at `hundredths` of a percent, 9999 for 99.99%, as oha takes it:
// the value at index floor(p / 100 * N) of the N values in order. It is -1
// when that index is past the last value.
pub function (h: Histogram) at(hundredths: i64): i64 {
  return h.percentiles([hundredths])[0];
}

// The value at each of `hundredths`, as `at` gives it. A count of the values
// in buckets of three significant digits gives the bucket of each index, and
// only the values in those buckets are sorted.
pub function (h: Histogram) percentiles(hundredths: i64[]): i64[] {
  let out: i64[] = [];
  if (h.sorted) {
    for p in hundredths {
      let i = index_at(p, h.total);
      out = out.append(if (i < h.total) { h.values[i as i32] } else { -1 });
    }
    return out;
  }
  let counts: i64[] = [];
  let marked: boolean[] = [];
  for _ in 0..BUCKETS {
    counts = counts.append(0);
    marked = marked.append(false);
  }
  for v in h.values {
    let b = bucket_of(v);
    counts = counts.with(b, counts[b] + 1);
  }
  let buckets: i32[] = [];
  let offsets: i64[] = [];
  for p in hundredths {
    let i = index_at(p, h.total);
    let b = 0;
    let before: i64 = 0;
    while (i < h.total && before + counts[b] <= i) {
      before += counts[b];
      b += 1;
    }
    buckets = buckets.append(if (i < h.total) { b } else { -1 });
    offsets = offsets.append(i - before);
    if (i < h.total) {
      marked = marked.with(b, true);
    }
  }
  let picked: i64[] = [];
  for v in h.values {
    if (marked[bucket_of(v)]) {
      picked = picked.append(v);
    }
  }
  picked = cmp.sort(picked);
  for k in 0..buckets.len() {
    let b = buckets[k];
    if (b < 0) {
      out = out.append(-1);
      continue;
    }
    let before: i64 = 0;
    for j in 0..b {
      if (marked[j]) {
        before += counts[j];
      }
    }
    out = out.append(picked[(before + offsets[k]) as i32]);
  }
  return out;
}

// The buckets of `percentiles`: a bucket for each value below 2^SUB_BITS,
// and HALF buckets for each power of two above, up to 2^TOP_BITS ns, which
// is 39 hours. A longer value is in the last bucket.
const SUB_BITS: i32 = 11;

const SUB: i32 = 2048;

const HALF: i32 = 1024;

const TOP_BITS: i32 = 47;

const BUCKETS: i32 = SUB + (TOP_BITS - SUB_BITS) * HALF;

function bucket_of(v: i64): i32 {
  if (v < SUB as i64) {
    return if (v < 0) { 0 } else { v as i32 };
  }
  let shift = 64 - v.leading_zeros() - SUB_BITS;
  let index = SUB + (shift - 1) * HALF + (v >> shift as i64) as i32 - HALF;
  return if (index >= BUCKETS) { BUCKETS - 1 } else { index };
}

// The index of the value at `hundredths` of a percent of `n` values in
// order, computed in f64 as oha computes it.
pub function index_at(hundredths: i64, n: i64): i64 {
  return (hundredths as f64 / 100.0 / 100.0 * (n as f64)) as i64;
}

// The histogram of the values of both `h` and `o`.
pub function (h: Histogram) merge(o: Histogram): Histogram {
  if (o.total == 0) {
    return h;
  }
  if (h.total == 0) {
    return o;
  }
  let min = if (o.min < h.min) { o.min } else { h.min };
  let max = if (o.max > h.max) { o.max } else { h.max };
  return Histogram { values: h.values.concat(o.values), total: h.total + o.total, min: min, max: max, sum: h.sum + o.sum, sorted: false };
}

// Nanoseconds in seconds, as Rust's Duration::as_secs_f64 computes them: the
// whole seconds and the fraction, each rounded once.
pub function secs_f64(ns: i64): f64 {
  return (ns / 1000000000) as f64 + (ns % 1000000000) as f64 / 1000000000.0;
}

// The count of each of `bins` bins, as the histogram of oha computes them in
// seconds: the step is (max - min) / (bins - 1), and a value v goes in bin
// ceil((v - min) / step), but not past the last bin.
pub function (h: Histogram) bins(bins: i32): i64[] {
  let out: i64[] = [];
  for _ in 0..bins {
    out = out.append(0);
  }
  if (h.total == 0) {
    return out;
  }
  let min = secs_f64(h.min);
  let step = (secs_f64(h.max) - min) / ((bins - 1) as f64);
  for v in h.values {
    let at = ((secs_f64(v) - min) / step).ceil();
    let k = if (at.is_nan() || at < 0.0) { 0 } else if (at >= (bins - 1) as f64) { bins - 1 } else { at as i32 };
    out = out.with(k, out[k] + 1);
  }
  return out;
}
