// The two ways jq 1.7 writes a number.
//
// A number literal, of the program or of the input, keeps its decimal digits:
// jq writes it as the decNumber library does (`1.000`, `1E+2`, `123.0` for
// `12.30e1`). A computed number is an f64: jq writes the shortest digits that
// give the same f64, as `jvp_dtoa_fmt` does (`1e+17`, `1e-07`, `0.0001`).
//
// The text of a computed number starts with `~`, and the text of a literal
// does not. jq compares two literals as decimals, and compares the other
// pairs as two f64 values.
import "std/f64";
import "std/string";

struct Decimal { negative: boolean, digits: string, exponent: i32, ok: boolean }

function is_digit(b: u8): boolean {
  return b >= b'0' && b <= b'9';
}

// The coefficient digits and the exponent of a decimal literal, with the
// leading zeros of the coefficient gone.
function decimal(s: string): Decimal {
  let bad = Decimal { negative: false, digits: "", exponent: 0, ok: false };
  let i = 0;
  let negative = false;
  if (i < s.len() && (s[i] == b'-' || s[i] == b'+')) {
    negative = s[i] == b'-';
    i += 1;
  }
  let digits = "";
  let fraction = 0;
  let seen_point = false;
  let seen_digit = false;
  while (i < s.len() && (is_digit(s[i]) || s[i] == b'.' && !seen_point)) {
    if (s[i] == b'.') {
      seen_point = true;
    } else {
      seen_digit = true;
      if (digits.len() > 0 || s[i] != b'0') {
        digits += slice_unchecked(s, i, i + 1).to_owned();
      }
      if (seen_point) {
        fraction += 1;
      }
    }
    i += 1;
  }
  if (!seen_digit) {
    return bad;
  }
  let exponent = 0;
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i += 1;
    let sign = 1;
    if (i < s.len() && (s[i] == b'+' || s[i] == b'-')) {
      if (s[i] == b'-') {
        sign = -1;
      }
      i += 1;
    }
    if (i >= s.len()) {
      return bad;
    }
    while (i < s.len() && is_digit(s[i])) {
      // Each exponent above 2000000000 is out of range, as 2000000000 is.
      exponent = if (exponent > 200000000) { 2000000000 } else { exponent * 10 + (s[i] - b'0') as i32 };
      i += 1;
    }
    exponent *= sign;
  }
  if (i != s.len()) {
    return bad;
  }
  if (digits.len() == 0) {
    digits = "0";
  }
  return Decimal { negative: negative, digits: digits, exponent: exponent - fraction, ok: true };
}

// Whether `s` is a decimal literal as jq reads one: `1`, `1.`, `.5`, `+1e2`.
pub function is_decimal(s: string): boolean {
  return decimal(s).ok;
}

function zeros(n: i32): string {
  let out = "";
  for i in 0..n {
    out += "0";
  }
  return out;
}

// The limits of the decNumber context of jq. A larger adjusted exponent is an
// infinity, and a smaller exponent rounds half up to ETINY.
const EMAX: i32 = 999999999;

const ETINY: i32 = -1147483646;

// The decimal `d` in the range of the decNumber context of jq.
function in_range(d: Decimal): Decimal {
  let n = d.digits.len();
  if (d.digits == "0") {
    let e = if (d.exponent > EMAX) { EMAX } else if (d.exponent < ETINY) { ETINY } else { d.exponent };
    return Decimal { ...d, exponent: e };
  }
  if (d.exponent >= ETINY) {
    return d;
  }
  let drop = ETINY - d.exponent;
  if (drop > n) {
    return Decimal { ...d, digits: "0", exponent: ETINY };
  }
  let keep = slice_unchecked(d.digits, 0, n - drop).to_owned();
  if (d.digits[n - drop] < b'5') {
    return Decimal { ...d, digits: if (keep.len() == 0) { "0" } else { keep }, exponent: ETINY };
  }
  if (keep.len() == 0) {
    return Decimal { ...d, digits: "1", exponent: ETINY };
  }
  let (up, carry) = increment(keep);
  return Decimal { ...d, digits: if (carry) { "1" + zeros(keep.len()) } else { up }, exponent: ETINY };
}

// The decNumber to-scientific-string of the literal `s`, or `s` when it is
// not a decimal literal. An infinity is `Infinity`, as decNumber writes it.
pub function canonical(s: string): string {
  let parsed = decimal(s);
  if (!parsed.ok) {
    return s;
  }
  let sign = "";
  if (parsed.negative) {
    sign = "-";
  }
  if (parsed.digits != "0" && parsed.exponent + parsed.digits.len() - 1 > EMAX) {
    return sign + "Infinity";
  }
  let d = in_range(parsed);
  let n = d.digits.len();
  let adjusted = d.exponent + n - 1;
  if (d.exponent <= 0 && adjusted >= -6) {
    if (d.exponent == 0) {
      return sign + d.digits;
    }
    let point = n + d.exponent;
    if (point <= 0) {
      return sign + "0." + zeros(-point) + d.digits;
    }
    return sign + slice_unchecked(d.digits, 0, point).to_owned() + "." + slice_unchecked(d.digits, point, n).to_owned();
  }
  let out = sign + slice_unchecked(d.digits, 0, 1).to_owned();
  if (n > 1) {
    out += "." + slice_unchecked(d.digits, 1, n).to_owned();
  }
  if (adjusted >= 0) {
    return out + "E+" + adjusted.to_string();
  }
  return out + "E" + adjusted.to_string();
}

// The texts of the three computed numbers that have no digits.
const NAN: string = "~nan";

const INFINITY: string = "~inf";

const MINUS_INFINITY: string = "~-inf";

// The sign of the literal `t` when it is an infinity, or 0.
function infinity_sign(t: string): i32 {
  if (t.len() > 0 && t[0] == b'I') {
    return 1;
  }
  if (t.len() > 1 && t[0] == b'-' && t[1] == b'I') {
    return -1;
  }
  return 0;
}

// Whether `t` is the text of a computed number.
pub function is_computed(t: string): boolean {
  return t.len() > 0 && t[0] == b'~';
}

// The text of the computed number `n`.
pub function integer(n: i64): string {
  return "~" + n.to_string();
}

// The text of a number as jq writes it. NaN is null, and an infinity is the
// largest finite f64 of its sign.
pub function written(t: string): str {
  if (!is_computed(t)) {
    let inf = infinity_sign(t);
    if (inf > 0) {
      return "1.7976931348623157e+308";
    }
    if (inf < 0) {
      return "-1.7976931348623157e+308";
    }
    return t;
  }
  if (t == NAN) {
    return "null";
  }
  if (t == INFINITY) {
    return "1.7976931348623157e+308";
  }
  if (t == MINUS_INFINITY) {
    return "-1.7976931348623157e+308";
  }
  return slice_unchecked(t, 1, t.len());
}

// Whether the literal `t` is its own decNumber form: it has no exponent, and
// not six zeros after a leading `0.`.
pub function in_canonical_form(t: string): boolean {
  let zeros = -1;
  let start = 0;
  if (t.len() > 0 && t[0] == b'-') {
    start = 1;
  }
  if (t.len() > start + 1 && t[start] == b'0' && t[start + 1] == b'.') {
    zeros = 0;
    let i = start + 2;
    while (i < t.len() && t[i] == b'0') {
      zeros += 1;
      i += 1;
    }
  }
  if (zeros >= 6) {
    return false;
  }
  for i in 0..t.len() {
    if (t[i] == b'e' || t[i] == b'E') {
      return false;
    }
  }
  return true;
}

// The f64 of a number text. jq rounds a literal to 17 significant digits,
// half to even, and then gives the nearest f64. An out-of-range literal is an
// infinity.
pub function value(s: string): f64 {
  if (is_computed(s)) {
    if (s == NAN) {
      return 0.0 / 0.0;
    }
    if (s == INFINITY) {
      return 1.0 / 0.0;
    }
    if (s == MINUS_INFINITY) {
      return -1.0 / 0.0;
    }
    return match (f64.parse_f64(slice_unchecked(s, 1, s.len()))) {
      Ok(v) => v,
      Err(_) => 0.0,
    };
  }
  let inf = infinity_sign(s);
  if (inf != 0) {
    return inf as f64 / 0.0;
  }
  if (s.len() > 17) {
    let r = rounded(s);
    if (r.len() > 0) {
      return parse_literal(r);
    }
  }
  return parse_literal(s);
}

function parse_literal(s: string): f64 {
  match (f64.parse_f64(s)) {
    Ok(v) => {
      return v;
    },
    Err(_) => {
      let d = decimal(s);
      if (d.ok && d.digits != "0" && d.exponent > 0) {
        if (d.negative) {
          return -1.0 / 0.0;
        }
        return 1.0 / 0.0;
      }
      return 0.0;
    }
  }
}

// The literal `s` with its coefficient rounded to 17 digits, half to even, or
// "" when it has 17 significant digits or fewer.
function rounded(s: string): string {
  let d = decimal(s);
  let n = d.digits.len();
  let last = n;
  while (last > 0 && d.digits[last - 1] == b'0') {
    last -= 1;
  }
  if (!d.ok || last <= 17) {
    return "";
  }
  let keep = slice_unchecked(d.digits, 0, 17).to_owned();
  let next = d.digits[17];
  let rest = last > 18;
  let odd = (keep[16] - b'0') % 2u8 == 1u8;
  let exponent = d.exponent + n - 17;
  if (next > b'5' || next == b'5' && (rest || odd)) {
    let (up, carry) = increment(keep);
    keep = up;
    if (carry) {
      exponent += 1;
    }
  }
  let sign = if (d.negative) { "-" } else { "" };
  return sign + keep + "E" + exponent.to_string();
}

// The digits `digits` plus one in the last place, with the same count of
// digits, and whether the sum is a power of ten.
function increment(digits: string): (string, boolean) {
  let i = digits.len() - 1;
  while (i >= 0 && digits[i] == b'9') {
    i -= 1;
  }
  if (i < 0) {
    return ("1" + zeros(digits.len() - 1), true);
  }
  let d = (digits[i] - b'0') as i32 + 1;
  return (slice_unchecked(digits, 0, i).to_owned() + d.to_string() + zeros(digits.len() - i - 1), false);
}

// The shortest digits of a finite, positive f64, and the place of its decimal
// point: the value is 0.D times ten to the point.
struct Shortest { digits: string, point: i32 }

function shortest(x: f64): Shortest {
  let d = decimal(x.to_string());
  let digits = d.digits;
  let point = d.exponent + digits.len();
  let end = digits.len();
  while (end > 1 && digits[end - 1] == b'0') {
    end -= 1;
  }
  if (digits == "0") {
    return Shortest { digits: "0", point: 1 };
  }
  return Shortest { digits: slice_unchecked(digits, 0, end).to_owned(), point: point };
}

function exponent_text(e: i32): string {
  let sign = "+";
  let n = e;
  if (e < 0) {
    sign = "-";
    n = -e;
  }
  if (n < 10) {
    return sign + "0" + n.to_string();
  }
  return sign + n.to_string();
}

// The text of a computed number: the shortest digits of a finite f64.
pub function format(x: f64): string {
  if (x != x) {
    return NAN;
  }
  if (x > 1.7976931348623157e308) {
    return INFINITY;
  }
  if (x < -1.7976931348623157e308) {
    return MINUS_INFINITY;
  }
  let sign = "~";
  if (x < 0.0 || x == 0.0 && 1.0 / x < 0.0) {
    sign = "~-";
  }
  let a = x;
  if (a < 0.0) {
    a = -a;
  }
  let s = shortest(a);
  let n = s.digits.len();
  if (s.point <= -4 || s.point > n + 15) {
    let out = sign + slice_unchecked(s.digits, 0, 1).to_owned();
    if (n > 1) {
      out += "." + slice_unchecked(s.digits, 1, n).to_owned();
    }
    return out + "e" + exponent_text(s.point - 1);
  }
  if (s.point <= 0) {
    return sign + "0." + zeros(-s.point) + s.digits;
  }
  if (s.point >= n) {
    return sign + s.digits + zeros(s.point - n);
  }
  return sign + slice_unchecked(s.digits, 0, s.point).to_owned() + "." + slice_unchecked(s.digits, s.point, n).to_owned();
}

// The order of two number texts. jq 1.7.1 compares two literals as exact
// decimals, and the other pairs as two f64 values. The shortest digits of two
// f64 values order as the f64 values do, so plain digits need no parse.
pub function compare(a: string, b: string): i32 {
  // jq orders NaN below each number, and below NaN also.
  if (a == NAN) {
    return -1;
  }
  if (b == NAN) {
    return 1;
  }
  if (a == b) {
    return 0;
  }
  let ca = is_computed(a);
  let cb = is_computed(b);
  if (ca && cb) {
    let fast = plain_compare(slice_unchecked(a, 1, a.len()), slice_unchecked(b, 1, b.len()));
    if (fast != 2) {
      return fast;
    }
  }
  if (ca || cb) {
    return order(value(a), value(b));
  }
  let fast = plain_compare(a, b);
  if (fast != 2) {
    return fast;
  }
  let x = decimal(a);
  let y = decimal(b);
  if (!x.ok || !y.ok) {
    return order(infinity_sign(a) as f64, infinity_sign(b) as f64);
  }
  let zx = x.digits == "0";
  let zy = y.digits == "0";
  if (zx && zy) {
    return 0;
  }
  let sx = 1;
  if (zx) {
    sx = 0;
  } else if (x.negative) {
    sx = -1;
  }
  let sy = 1;
  if (zy) {
    sy = 0;
  } else if (y.negative) {
    sy = -1;
  }
  if (sx != sy) {
    if (sx < sy) {
      return -1;
    }
    return 1;
  }
  return sx * magnitude(x, y);
}

function order(x: f64, y: f64): i32 {
  return if (x < y) { -1 } else if (x > y) { 1 } else { 0 };
}

// The parts of a plain decimal: an optional minus, digits, and an optional
// fraction, with no exponent. It gives whether it is negative, and the start
// and the end of the whole part with no leading zero. The end is -1 when the
// text is not plain.
function plain_parts(s: string): (boolean, i32, i32) {
  let i = 0;
  let negative = false;
  if (s.len() > 0 && s[0] == b'-') {
    negative = true;
    i = 1;
  }
  let start = i;
  while (i < s.len() && is_digit(s[i])) {
    i += 1;
  }
  let end = i;
  if (end == start) {
    return (false, 0, -1);
  }
  if (i < s.len()) {
    if (s[i] != b'.') {
      return (false, 0, -1);
    }
    i += 1;
    while (i < s.len() && is_digit(s[i])) {
      i += 1;
    }
    if (i < s.len()) {
      return (false, 0, -1);
    }
  }
  while (start < end && s[start] == b'0') {
    start += 1;
  }
  return (negative, start, end);
}

// The order of the absolute values of two plain decimals, from their whole
// parts and then their fractions.
function plain_magnitude(a: string, sa: i32, ea: i32, b: string, sb: i32, eb: i32): i32 {
  if (ea - sa != eb - sb) {
    return if (ea - sa < eb - sb) { -1 } else { 1 };
  }
  for k in 0..ea - sa {
    if (a[sa + k] != b[sb + k]) {
      return if (a[sa + k] < b[sb + k]) { -1 } else { 1 };
    }
  }
  let i = ea + 1;
  let j = eb + 1;
  while (i < a.len() || j < b.len()) {
    let da = if (i < a.len()) { a[i] } else { b'0' };
    let db = if (j < b.len()) { b[j] } else { b'0' };
    if (da != db) {
      return if (da < db) { -1 } else { 1 };
    }
    i += 1;
    j += 1;
  }
  return 0;
}

// The order of two plain decimals with no exponent, or 2 when a text is not
// plain. It allocates nothing, and most literals are plain.
function plain_compare(a: string, b: string): i32 {
  let (na, sa, ea) = plain_parts(a);
  if (ea < 0) {
    return 2;
  }
  let (nb, sb, eb) = plain_parts(b);
  if (eb < 0) {
    return 2;
  }
  let m = plain_magnitude(a, sa, ea, b, sb, eb);
  if (na == nb) {
    return if (na) { -m } else { m };
  }
  let zero = plain_magnitude(a, sa, ea, "0", 1, 1) == 0 && plain_magnitude(b, sb, eb, "0", 1, 1) == 0;
  if (zero) {
    return 0;
  }
  return if (na) { -1 } else { 1 };
}

// The order of the absolute values of two nonzero decimals.
function magnitude(x: Decimal, y: Decimal): i32 {
  let ax = x.exponent + x.digits.len();
  let ay = y.exponent + y.digits.len();
  if (ax != ay) {
    if (ax < ay) {
      return -1;
    }
    return 1;
  }
  let n = x.digits.len();
  if (y.digits.len() > n) {
    n = y.digits.len();
  }
  for i in 0..n {
    let dx = b'0';
    if (i < x.digits.len()) {
      dx = x.digits[i];
    }
    let dy = b'0';
    if (i < y.digits.len()) {
      dy = y.digits[i];
    }
    if (dx != dy) {
      if (dx < dy) {
        return -1;
      }
      return 1;
    }
  }
  return 0;
}

// The whole part of the size of `x`, held to the range of an i64 as jq does.
pub function int_magnitude(x: f64): u64 {
  if (x <= -9223372036854775808.0) {
    return 9223372036854775808u64;
  }
  if (x >= 9223372036854775807.0) {
    return 9223372036854775807u64;
  }
  if (x < 0.0) {
    return (-x) as u64;
  }
  return x as u64;
}
