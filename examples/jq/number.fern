// The two ways jq 1.7 writes a number.
//
// A number literal, of the program or of the input, keeps its decimal digits:
// jq writes it as the decNumber library does (`1.000`, `1E+2`, `123.0` for
// `12.30e1`). A computed number is an f64: jq writes the shortest digits that
// give the same f64, as `jvp_dtoa_fmt` does (`1e+17`, `1e-07`, `0.0001`).
import "std/f64";
import "std/string";

struct Decimal { negative: boolean, digits: string, exponent: i32, ok: boolean }

function is_digit(b: u8): boolean {
  return b >= b'0' && b <= b'9';
}

// The coefficient digits and the exponent of a decimal literal, with the
// leading zeros of the coefficient gone.
function decimal(s: string): Decimal {
  let bad = Decimal { negative: false, digits: "", exponent: 0, ok: false };
  let i = 0;
  let negative = false;
  if (i < s.len() && (s[i] == b'-' || s[i] == b'+')) {
    negative = s[i] == b'-';
    i += 1;
  }
  let digits = "";
  let fraction = 0;
  let seen_point = false;
  let seen_digit = false;
  while (i < s.len() && (is_digit(s[i]) || s[i] == b'.' && !seen_point)) {
    if (s[i] == b'.') {
      seen_point = true;
    } else {
      seen_digit = true;
      if (digits.len() > 0 || s[i] != b'0') {
        digits += slice_unchecked(s, i, i + 1).to_owned();
      }
      if (seen_point) {
        fraction += 1;
      }
    }
    i += 1;
  }
  if (!seen_digit) {
    return bad;
  }
  let exponent = 0;
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i += 1;
    let sign = 1;
    if (i < s.len() && (s[i] == b'+' || s[i] == b'-')) {
      if (s[i] == b'-') {
        sign = -1;
      }
      i += 1;
    }
    if (i >= s.len()) {
      return bad;
    }
    while (i < s.len() && is_digit(s[i])) {
      if (exponent < 100000000) {
        exponent = exponent * 10 + (s[i] - b'0') as i32;
      }
      i += 1;
    }
    exponent *= sign;
  }
  if (i != s.len()) {
    return bad;
  }
  if (digits.len() == 0) {
    digits = "0";
  }
  return Decimal { negative: negative, digits: digits, exponent: exponent - fraction, ok: true };
}

function zeros(n: i32): string {
  let out = "";
  for i in 0..n {
    out += "0";
  }
  return out;
}

// The decNumber to-scientific-string of the literal `s`, or `s` when it is
// not a decimal literal.
pub function canonical(s: string): string {
  let d = decimal(s);
  if (!d.ok) {
    return s;
  }
  let sign = "";
  if (d.negative) {
    sign = "-";
  }
  let n = d.digits.len();
  let adjusted = d.exponent + n - 1;
  if (d.exponent <= 0 && adjusted >= -6) {
    if (d.exponent == 0) {
      return sign + d.digits;
    }
    let point = n + d.exponent;
    if (point <= 0) {
      return sign + "0." + zeros(-point) + d.digits;
    }
    return sign + slice_unchecked(d.digits, 0, point).to_owned() + "." + slice_unchecked(d.digits, point, n).to_owned();
  }
  let out = sign + slice_unchecked(d.digits, 0, 1).to_owned();
  if (n > 1) {
    out += "." + slice_unchecked(d.digits, 1, n).to_owned();
  }
  if (adjusted >= 0) {
    return out + "E+" + adjusted.to_string();
  }
  return out + "E" + adjusted.to_string();
}

// The texts of the three computed numbers that have no digits.
const NAN: string = "nan";

const INFINITY: string = "inf";

const MINUS_INFINITY: string = "-inf";

// The text of a number as jq writes it. NaN is null, and an infinity is the
// largest finite f64 of its sign.
pub function written(t: string): string {
  if (t == NAN) {
    return "null";
  }
  if (t == INFINITY) {
    return "1.7976931348623157e+308";
  }
  if (t == MINUS_INFINITY) {
    return "-1.7976931348623157e+308";
  }
  return t;
}

// The f64 of a number text, as jq compares numbers. An out-of-range literal
// is an infinity.
pub function value(s: string): f64 {
  if (s == NAN) {
    return 0.0 / 0.0;
  }
  if (s == INFINITY) {
    return 1.0 / 0.0;
  }
  if (s == MINUS_INFINITY) {
    return -1.0 / 0.0;
  }
  match (f64.parse_f64(s)) {
    Ok(v) => {
      return v;
    },
    Err(_) => {
      let d = decimal(s);
      if (d.ok && d.digits != "0" && d.exponent > 0) {
        if (d.negative) {
          return -1.0 / 0.0;
        }
        return 1.0 / 0.0;
      }
      return 0.0;
    }
  }
}

// The shortest digits of a finite, positive f64, and the place of its decimal
// point: the value is 0.D times ten to the point.
struct Shortest { digits: string, point: i32 }

function shortest(x: f64): Shortest {
  let d = decimal(x.to_string());
  let digits = d.digits;
  let point = d.exponent + digits.len();
  let end = digits.len();
  while (end > 1 && digits[end - 1] == b'0') {
    end -= 1;
  }
  if (digits == "0") {
    return Shortest { digits: "0", point: 1 };
  }
  return Shortest { digits: slice_unchecked(digits, 0, end).to_owned(), point: point };
}

function exponent_text(e: i32): string {
  let sign = "+";
  let n = e;
  if (e < 0) {
    sign = "-";
    n = -e;
  }
  if (n < 10) {
    return sign + "0" + n.to_string();
  }
  return sign + n.to_string();
}

// The text of a computed number: the shortest digits of a finite f64.
pub function format(x: f64): string {
  if (x != x) {
    return NAN;
  }
  if (x > 1.7976931348623157e308) {
    return INFINITY;
  }
  if (x < -1.7976931348623157e308) {
    return MINUS_INFINITY;
  }
  let sign = "";
  if (x < 0.0 || x == 0.0 && 1.0 / x < 0.0) {
    sign = "-";
  }
  let a = x;
  if (a < 0.0) {
    a = -a;
  }
  let s = shortest(a);
  let n = s.digits.len();
  if (s.point <= -4 || s.point > n + 15) {
    let out = sign + slice_unchecked(s.digits, 0, 1).to_owned();
    if (n > 1) {
      out += "." + slice_unchecked(s.digits, 1, n).to_owned();
    }
    return out + "e" + exponent_text(s.point - 1);
  }
  if (s.point <= 0) {
    return sign + "0." + zeros(-s.point) + s.digits;
  }
  if (s.point >= n) {
    return sign + s.digits + zeros(s.point - n);
  }
  return sign + slice_unchecked(s.digits, 0, s.point).to_owned() + "." + slice_unchecked(s.digits, s.point, n).to_owned();
}

// The order of two number texts as exact decimals. jq 1.7 compares two
// number literals so, and the shortest digits of two f64 values order as the
// f64 values do.
pub function compare(a: string, b: string): i32 {
  // jq orders NaN below each number, and below NaN also.
  if (a == NAN) {
    return -1;
  }
  if (b == NAN) {
    return 1;
  }
  let x = decimal(a);
  let y = decimal(b);
  if (!x.ok || !y.ok) {
    let fa = value(a);
    let fb = value(b);
    if (fa < fb) {
      return -1;
    }
    if (fa > fb) {
      return 1;
    }
    return 0;
  }
  let zx = x.digits == "0";
  let zy = y.digits == "0";
  if (zx && zy) {
    return 0;
  }
  let sx = 1;
  if (zx) {
    sx = 0;
  } else if (x.negative) {
    sx = -1;
  }
  let sy = 1;
  if (zy) {
    sy = 0;
  } else if (y.negative) {
    sy = -1;
  }
  if (sx != sy) {
    if (sx < sy) {
      return -1;
    }
    return 1;
  }
  return sx * magnitude(x, y);
}

// The order of the absolute values of two nonzero decimals.
function magnitude(x: Decimal, y: Decimal): i32 {
  let ax = x.exponent + x.digits.len();
  let ay = y.exponent + y.digits.len();
  if (ax != ay) {
    if (ax < ay) {
      return -1;
    }
    return 1;
  }
  let n = x.digits.len();
  if (y.digits.len() > n) {
    n = y.digits.len();
  }
  for i in 0..n {
    let dx = b'0';
    if (i < x.digits.len()) {
      dx = x.digits[i];
    }
    let dy = b'0';
    if (i < y.digits.len()) {
      dy = y.digits[i];
    }
    if (dx != dy) {
      if (dx < dy) {
        return -1;
      }
      return 1;
    }
  }
  return 0;
}
