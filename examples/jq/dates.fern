// The date functions of jq: the calendar, `strftime` and `strptime`. The
// time zone is UTC.

import "std/string";

// A broken-down time, as the `struct tm` of C: `year` is the full year, `mon`
// is from 0, `wday` is from Sunday, and `yday` is from 0.
pub struct Tm { year: i64, mon: i64, mday: i64, hour: i64, min: i64, sec: i64, wday: i64, yday: i64 }

function floor_div(a: i64, b: i64): i64 {
  let q = a / b;
  if (a % b != 0 && a < 0 != b < 0) {
    return q - 1;
  }
  return q;
}

function floor_mod(a: i64, b: i64): i64 {
  return a - floor_div(a, b) * b;
}

// The days from 1970-01-01 to the day `d` of the month `m` (from 1) of `y`.
function days_from_civil(y: i64, m: i64, d: i64): i64 {
  let year = if (m <= 2) { y - 1 } else { y };
  let era = floor_div(year, 400);
  let yoe = year - era * 400;
  let shifted = if (m > 2) { m - 3 } else { m + 9 };
  let doy = (153 * shifted + 2) / 5 + d - 1;
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + doe - 719468;
}

// The days to a date that can have a month and a day out of their ranges.
function days_of(year: i64, mon: i64, mday: i64): i64 {
  let months = year * 12 + mon;
  return days_from_civil(floor_div(months, 12), floor_mod(months, 12) + 1, 1) + mday - 1;
}

pub function gmtime(secs: i64): Tm {
  let days = floor_div(secs, 86400);
  let rest = floor_mod(secs, 86400);
  let z = days + 719468;
  let era = floor_div(z, 146097);
  let doe = z - era * 146097;
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  let mp = (5 * doy + 2) / 153;
  let mday = doy - (153 * mp + 2) / 5 + 1;
  let month = if (mp < 10) { mp + 3 } else { mp - 9 };
  let year = if (month <= 2) { yoe + era * 400 + 1 } else { yoe + era * 400 };
  return Tm {
    year: year, mon: month - 1, mday: mday, hour: rest / 3600, min: rest % 3600 / 60, sec: rest % 60,
    wday: floor_mod(days + 4, 7), yday: days - days_from_civil(year, 1, 1),
  };
}

// The seconds from 1970-01-01. A field out of its range moves the date, as
// in `timegm` of C.
pub function timegm(t: Tm): i64 {
  return days_of(t.year, t.mon, t.mday) * 86400 + t.hour * 3600 + t.min * 60 + t.sec;
}

// `t` with the day of the week and the day of the year of its date.
function with_days(t: Tm): Tm {
  let days = days_of(t.year, t.mon, t.mday);
  let first = days_of(t.year + floor_div(t.mon, 12), 0, 1);
  return Tm { ...t, wday: floor_mod(days + 4, 7), yday: days - first };
}

// ---- strftime ----

function day_names(): string[] {
  return ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
}

function month_names(): string[] {
  return ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
}

function name_of(names: string[], at: i64, short: boolean): string {
  if (at < 0 || at >= names.len() as i64) {
    return "?";
  }
  let name = names[at as i32];
  if (short) {
    return slice_unchecked(name, 0, 3).to_owned();
  }
  return name;
}

function padded(n: i64, width: i32, fill: string): string {
  let digits = if (n < 0) { (-n).to_string() } else { n.to_string() };
  let out = digits;
  while (out.len() + (if (n < 0) { 1 } else { 0 }) < width) {
    out = fill + out;
  }
  if (n < 0) {
    return "-" + out;
  }
  return out;
}

function two(n: i64): string {
  return padded(n, 2, "0");
}

function hour12(t: Tm): i64 {
  let h = t.hour % 12;
  if (h == 0) {
    return 12;
  }
  return h;
}

function weeks_in(year: i64): i64 {
  let first = floor_mod(days_from_civil(year, 1, 1) + 4, 7);
  let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
  if (first == 4 || leap && first == 3) {
    return 53;
  }
  return 52;
}

// The ISO 8601 year and week of `t`.
function iso_week(t: Tm): (i64, i64) {
  let week = floor_div(t.yday - floor_mod(t.wday + 6, 7) + 10, 7);
  if (week < 1) {
    return (t.year - 1, weeks_in(t.year - 1));
  }
  if (week > weeks_in(t.year)) {
    return (t.year + 1, 1);
  }
  return (t.year, week);
}

// The text of a conversion that is a format of its own, or "".
function composite(c: u8): string {
  return match (c) {
    b'c' => "%a %b %e %H:%M:%S %Y",
    b'D' => "%m/%d/%y",
    b'x' => "%m/%d/%y",
    b'F' => "%Y-%m-%d",
    b'T' => "%H:%M:%S",
    b'X' => "%H:%M:%S",
    b'R' => "%H:%M",
    b'r' => "%I:%M:%S %p",
    _ => "",
  };
}

function date_field(c: u8, t: Tm): string {
  let (iso_year, week) = iso_week(t);
  return match (c) {
    b'a' => name_of(day_names(), t.wday, true),
    b'A' => name_of(day_names(), t.wday, false),
    b'b' => name_of(month_names(), t.mon, true),
    b'h' => name_of(month_names(), t.mon, true),
    b'B' => name_of(month_names(), t.mon, false),
    b'C' => two(floor_div(t.year, 100)),
    b'd' => two(t.mday),
    b'e' => padded(t.mday, 2, " "),
    b'g' => two(floor_mod(iso_year, 100)),
    b'G' => iso_year.to_string(),
    b'j' => padded(t.yday + 1, 3, "0"),
    b'm' => two(t.mon + 1),
    b'u' => (if (t.wday == 0) { 7 } else { t.wday }).to_string(),
    b'U' => two((t.yday + 7 - t.wday) / 7),
    b'V' => two(week),
    b'w' => t.wday.to_string(),
    b'W' => two((t.yday + 7 - floor_mod(t.wday + 6, 7)) / 7),
    b'y' => two(floor_mod(t.year, 100)),
    b'Y' => t.year.to_string(),
    _ => "",
  };
}

function time_field(c: u8, t: Tm): string {
  return match (c) {
    b'H' => two(t.hour),
    b'I' => two(hour12(t)),
    b'k' => padded(t.hour, 2, " "),
    b'l' => padded(hour12(t), 2, " "),
    b'M' => two(t.min),
    b'p' => if (t.hour >= 12) { "PM" } else { "AM" },
    b'P' => if (t.hour >= 12) { "pm" } else { "am" },
    b's' => timegm(t).to_string(),
    b'S' => two(t.sec),
    b'z' => "+0000",
    b'Z' => "UTC",
    b'n' => "\n",
    b't' => "\t",
    b'%' => "%",
    _ => "",
  };
}

// `t` in the format `format`. A conversion that the port does not have stays
// as it is in the format.
pub function strftime(format: string, t: Tm): string {
  let out = "";
  let i = 0;
  while (i < format.len()) {
    if (format[i] != b'%' || i + 1 == format.len()) {
      out += slice_unchecked(format, i, i + 1);
      i += 1;
      continue;
    }
    let c = format[i + 1];
    let field = date_field(c, t) + time_field(c, t);
    if (composite(c).len() > 0) {
      field = strftime(composite(c), t);
    }
    if (field.len() == 0) {
      field = slice_unchecked(format, i, i + 2).to_owned();
    }
    out += field;
    i += 2;
  }
  return out;
}

// ---- strptime ----

// `xday` is true after a conversion that gives a part of the date. The day
// of the week and the day of the year then come from the date.
struct Scan { t: Tm, at: i32, ok: boolean, xday: boolean, have_wday: boolean, have_yday: boolean, have_date: boolean, pm: i32, hour12: boolean }

function failed(s: Scan): Scan {
  return Scan { ...s, ok: false };
}

function is_space(b: u8): boolean {
  return b == b' ' || b >= 9 && b <= 13;
}

function skip_spaces(text: string, at: i32): i32 {
  let i = at;
  while (i < text.len() && is_space(text[i])) {
    i += 1;
  }
  return i;
}

// A number of `digits` digits or fewer at `s.at`, from `lo` to `hi`. The
// result is -1 when the text has no such number.
function number_at(text: string, s: Scan, lo: i64, hi: i64, digits: i32): (i64, Scan) {
  let i = s.at;
  while (i < text.len() && text[i] == b' ') {
    i += 1;
  }
  let start = i;
  let n: i64 = 0;
  while (i < text.len() && i - start < digits && text[i] >= b'0' && text[i] <= b'9') {
    n = n * 10 + (text[i] - b'0') as i64;
    i += 1;
  }
  if (i == start || n < lo || n > hi) {
    return (-1, failed(s));
  }
  return (n, Scan { ...s, at: i });
}

function lower(b: u8): u8 {
  if (b >= b'A' && b <= b'Z') {
    return b + 32;
  }
  return b;
}

function has_word(text: string, at: i32, word: str): boolean {
  if (at + word.len() > text.len()) {
    return false;
  }
  for i in 0..word.len() {
    if (lower(text[at + i]) != lower(word[i])) {
      return false;
    }
  }
  return true;
}

// The index of the name at `s.at`, in full or as its first three letters.
function name_at(text: string, s: Scan, names: string[]): (i64, Scan) {
  for i in 0..names.len() {
    if (has_word(text, s.at, names[i])) {
      return (i as i64, Scan { ...s, at: s.at + names[i].len() });
    }
  }
  for i in 0..names.len() {
    if (has_word(text, s.at, slice_unchecked(names[i], 0, 3))) {
      return (i as i64, Scan { ...s, at: s.at + 3 });
    }
  }
  return (-1, failed(s));
}

function dated(s: Scan, t: Tm): Scan {
  return Scan { ...s, t: t, xday: true };
}

function scan_date(text: string, c: u8, s: Scan): Scan {
  match (c) {
    b'Y' => {
      let (n, r) = number_at(text, s, 0, 9999, 4);
      return dated(r, Tm { ...r.t, year: n });
    },
    b'y' => {
      let (n, r) = number_at(text, s, 0, 99, 2);
      return dated(r, Tm { ...r.t, year: if (n >= 69) { 1900 + n } else { 2000 + n } });
    },
    b'C' => {
      let (_, r) = number_at(text, s, 0, 99, 2);
      return Scan { ...r, xday: true };
    },
    b'm' => {
      let (n, r) = number_at(text, s, 1, 12, 2);
      return Scan { ...dated(r, Tm { ...r.t, mon: n - 1 }), have_date: true };
    },
    b'd' => {
      let (n, r) = number_at(text, s, 1, 31, 2);
      return Scan { ...dated(r, Tm { ...r.t, mday: n }), have_date: true };
    },
    b'j' => {
      let (n, r) = number_at(text, s, 1, 366, 3);
      return Scan { ...r, t: Tm { ...r.t, yday: n - 1 }, have_yday: true };
    },
    _ => {
      return scan_names(text, c, s);
    }
  }
}

function scan_names(text: string, c: u8, s: Scan): Scan {
  if (c == b'a' || c == b'A') {
    let (n, r) = name_at(text, s, day_names());
    return Scan { ...r, t: Tm { ...r.t, wday: n }, have_wday: true };
  }
  if (c == b'b' || c == b'B' || c == b'h') {
    let (n, r) = name_at(text, s, month_names());
    return Scan { ...dated(r, Tm { ...r.t, mon: n }), have_date: true };
  }
  if (c == b'w') {
    let (n, r) = number_at(text, s, 0, 6, 1);
    return Scan { ...r, t: Tm { ...r.t, wday: n }, have_wday: true };
  }
  if (c == b'u') {
    let (n, r) = number_at(text, s, 1, 7, 1);
    return Scan { ...r, t: Tm { ...r.t, wday: n % 7 }, have_wday: true };
  }
  if (c == b'U' || c == b'W' || c == b'V') {
    let (_, r) = number_at(text, s, 0, 53, 2);
    return r;
  }
  return scan_time(text, c, s);
}

function scan_time(text: string, c: u8, s: Scan): Scan {
  match (c) {
    b'H' => {
      let (n, r) = number_at(text, s, 0, 23, 2);
      return Scan { ...r, t: Tm { ...r.t, hour: n }, hour12: false };
    },
    b'I' => {
      let (n, r) = number_at(text, s, 1, 12, 2);
      return Scan { ...r, t: Tm { ...r.t, hour: n % 12 }, hour12: true };
    },
    b'M' => {
      let (n, r) = number_at(text, s, 0, 59, 2);
      return Scan { ...r, t: Tm { ...r.t, min: n } };
    },
    b'S' => {
      let (n, r) = number_at(text, s, 0, 61, 2);
      return Scan { ...r, t: Tm { ...r.t, sec: n } };
    },
    b'p' => {
      return scan_half(text, s);
    },
    b's' => {
      return scan_seconds(text, s);
    },
    b'z' => {
      return scan_zone(text, s);
    },
    _ => {
      return scan_other(text, c, s);
    }
  }
}

function scan_half(text: string, s: Scan): Scan {
  if (has_word(text, s.at, "AM")) {
    return Scan { ...s, at: s.at + 2, pm: 0 };
  }
  if (has_word(text, s.at, "PM")) {
    return Scan { ...s, at: s.at + 2, pm: 1 };
  }
  return failed(s);
}

function scan_seconds(text: string, s: Scan): Scan {
  let i = s.at;
  let n: i64 = 0;
  while (i < text.len() && text[i] >= b'0' && text[i] <= b'9') {
    n = n * 10 + (text[i] - b'0') as i64;
    i += 1;
  }
  if (i == s.at) {
    return failed(s);
  }
  return Scan { ...s, t: gmtime(n), at: i, have_wday: true, have_yday: true };
}

// `Z`, or a sign with the hours and the minutes. jq does not use the zone.
function scan_zone(text: string, s: Scan): Scan {
  let i = skip_spaces(text, s.at);
  if (i < text.len() && text[i] == b'Z') {
    return Scan { ...s, at: i + 1 };
  }
  if (i >= text.len() || text[i] != b'+' && text[i] != b'-') {
    return failed(s);
  }
  i += 1;
  let digits = 0;
  while (i < text.len() && digits < 4) {
    if (text[i] == b':' && digits == 2) {
      i += 1;
      continue;
    }
    if (text[i] < b'0' || text[i] > b'9') {
      break;
    }
    digits += 1;
    i += 1;
  }
  if (digits != 2 && digits != 4) {
    return failed(s);
  }
  return Scan { ...s, at: i };
}

function scan_other(text: string, c: u8, s: Scan): Scan {
  if (c == b'e') {
    return scan_date(text, b'd', s);
  }
  if (c == b'k') {
    return scan_time(text, b'H', s);
  }
  if (c == b'l') {
    return scan_time(text, b'I', s);
  }
  if (c == b'P') {
    return scan_half(text, s);
  }
  if (c == b'n' || c == b't') {
    return Scan { ...s, at: skip_spaces(text, s.at) };
  }
  if (c == b'Z') {
    let i = s.at;
    while (i < text.len() && lower(text[i]) >= b'a' && lower(text[i]) <= b'z') {
      i += 1;
    }
    return Scan { ...s, at: i };
  }
  if (c == b'%' && s.at < text.len() && text[s.at] == b'%') {
    return Scan { ...s, at: s.at + 1 };
  }
  if (composite(c).len() > 0) {
    return scan(text, composite(c), s);
  }
  return failed(s);
}

function scan(text: string, format: string, start: Scan): Scan {
  let s = start;
  let i = 0;
  while (s.ok && i < format.len()) {
    if (is_space(format[i])) {
      s = Scan { ...s, at: skip_spaces(text, s.at) };
      i += 1;
    } else if (format[i] != b'%' || i + 1 == format.len()) {
      if (s.at >= text.len() || text[s.at] != format[i]) {
        return failed(s);
      }
      s = Scan { ...s, at: s.at + 1 };
      i += 1;
    } else {
      i += 1;
      if ((format[i] == b'E' || format[i] == b'O') && i + 1 < format.len()) {
        i += 1;
      }
      s = scan_date(text, format[i], s);
      i += 1;
    }
  }
  return s;
}

// The month and the day of the month from the day of the year. Day 366 of a
// year with 365 days is day 32 of December, as in glibc.
function from_year_day(t: Tm): Tm {
  let mon: i64 = 11;
  while (mon > 0 && days_of(t.year, mon, 1) - days_of(t.year, 0, 1) > t.yday) {
    mon -= 1;
  }
  return Tm { ...t, mon: mon, mday: t.yday - (days_of(t.year, mon, 1) - days_of(t.year, 0, 1)) + 1 };
}

// The time that `text` holds in the format `format`. The second result is
// false when the text does not match the format. With no date in the text,
// the day of the week is 8 and the day of the year is 367, as in jq with glibc.
pub function strptime(text: string, format: string): (Tm, boolean) {
  let zero = Tm { year: 1900, mon: 0, mday: 0, hour: 0, min: 0, sec: 0, wday: 8, yday: 367 };
  let s = scan(text, format, Scan { t: zero, at: 0, ok: true, xday: false, have_wday: false, have_yday: false, have_date: false, pm: -1, hour12: false });
  if (!s.ok || s.at != text.len()) {
    return (zero, false);
  }
  let t = s.t;
  if (s.hour12 && s.pm == 1) {
    t = Tm { ...t, hour: t.hour + 12 };
  }
  if (s.have_yday && !s.have_date) {
    t = from_year_day(t);
  }
  if (s.xday || s.have_yday) {
    let found = with_days(t);
    t = Tm { ...t, wday: if (s.have_wday) { t.wday } else { found.wday }, yday: if (s.have_yday) { t.yday } else { found.yday } };
  }
  return (t, true);
}
