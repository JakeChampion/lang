// The evaluator of the jq language.
//
// `run` gives the outputs of a filter for one input. jq gives the outputs one
// at a time, and an error stops the filter; `Outputs` holds the values before
// the error and the error.
import "std/json";
import "std/base64";
import "std/f64";
import "std/string";
import "std/utf8";
import "./filter";
import "./number";
import "./output";
import "./reader";

// `error` is empty, or it holds the one value of the error.
pub struct Outputs { values: json.JsonValue[], error: json.JsonValue[] }

pub struct Env { names: string[], values: json.JsonValue[], funcs: Func[] }

// A function of a `def`, or an argument of a call. `scope` holds the one
// environment of the definition, or of the call for an argument. An argument
// has no parameters and does not see itself.
struct Func { name: string, params: string[], body: filter.Ast, scope: Env[], argument: boolean }

pub function env(): Env {
  return Env { names: [], values: [], funcs: [] };
}

pub function (e: Env) with(name: string, value: json.JsonValue): Env {
  return Env { names: e.names.append(name), values: e.values.append(value), funcs: e.funcs };
}

function (e: Env) define(f: Func): Env {
  return Env { names: e.names, values: e.values, funcs: e.funcs.append(f) };
}

// The last function of `e` with this name and this number of parameters.
function (e: Env) find(name: string, count: i32): Func[] {
  let i = e.funcs.len() - 1;
  while (i >= 0) {
    if (e.funcs[i].name == name && e.funcs[i].params.len() == count) {
      return [e.funcs[i]];
    }
    i -= 1;
  }
  return [];
}

function ok(values: json.JsonValue[]): Outputs {
  return Outputs { values: values, error: [] };
}

function one(v: json.JsonValue): Outputs {
  return ok([v]);
}

function raise(v: json.JsonValue): Outputs {
  return Outputs { values: [], error: [v] };
}

function fail(message: string): Outputs {
  return raise(json.JString(message));
}

// The error after "jq: error (at ...)", or "" when there is none.
pub function (o: Outputs) message(): string {
  if (o.error.len() == 0) {
    return "";
  }
  if let json.JString(s) = o.error[0] {
    return ": " + s;
  }
  return " (not a string): " + output.compact(o.error[0]);
}

function (o: Outputs) failed(): boolean {
  return o.error.len() > 0;
}

// `more` after `o`, unless `o` already failed.
function (o: Outputs) then(more: Outputs): Outputs {
  return Outputs { values: o.values.concat(more.values), error: more.error };
}

pub function type_name(v: json.JsonValue): string {
  return match (v) {
    json.JNull => "null",
    json.JBool(_) => "boolean",
    json.JNumber(_) => "number",
    json.JString(_) => "string",
    json.JArray(_) => "array",
    json.JObject(_) => "object",
  };
}

// The value as an error message shows it: compact, and cut to 11 bytes and
// "..." when it is longer than 14.
pub function shown(v: json.JsonValue): string {
  let s = output.compact(v);
  if (s.len() > 14) {
    return slice_unchecked(s, 0, 11).to_owned() + "...";
  }
  return s;
}

pub function truthy(v: json.JsonValue): boolean {
  return match (v) {
    json.JNull => false,
    json.JBool(b) => b,
    _ => true,
  };
}

pub function run(f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  match (f) {
    filter.Identity => {
      return one(input);
    },
    filter.Literal(v) => {
      return one(v);
    },
    filter.Var(name) => {
      return lookup(e, name);
    },
    filter.Index(target, key) => {
      return run_index(target, key, input, e, false);
    },
    filter.Slice(target, from, to) => {
      return run_slice(target, from, to, input, e, false);
    },
    filter.Iterate(target) => {
      return each(run(target, input, e), iterate);
    },
    filter.Optional(step) => {
      return run_guarded(step, input, e);
    },
    filter.Try(inner) => {
      return ok(run(inner, input, e).values);
    },
    filter.Pipe(a, b) => {
      return run_pipe(run(a, input, e), b, e);
    },
    filter.Comma(a, b) => {
      let o = run(a, input, e);
      if (o.failed()) {
        return o;
      }
      return o.then(run(b, input, e));
    },
    filter.Collect(inner) => {
      let o = run(inner, input, e);
      if (o.failed()) {
        return Outputs { values: [], error: o.error };
      }
      return one(json.JArray(o.values));
    },
    filter.EmptyArray => {
      return one(json.JArray([]));
    },
    filter.Object(keys, values) => {
      return build_object(keys, values, 0, [], [], input, e);
    },
    filter.Compare(op, a, b) => {
      return run_binary(op, a, b, input, e);
    },
    filter.Arith(op, a, b) => {
      return run_binary(op, a, b, input, e);
    },
    filter.Alt(a, b) => {
      return run_alt(a, b, input, e);
    },
    filter.Call(name, args) => {
      let found = e.find(name, args.len());
      if (found.len() > 0) {
        return call_defined(found[0], args, 0, input, e, callee_scope(found[0]));
      }
      return call(name, args, input, e);
    },
    filter.Def(name, params, body, rest) => {
      return run(rest, input, e.define(Func { name: name, params: params, body: body, scope: [e], argument: false }));
    },
    filter.Catch(body, handler) => {
      let o = run(body, input, e);
      if (!o.failed()) {
        return o;
      }
      return ok(o.values).then(run(handler, o.error[0], e));
    },
    filter.Format(name) => {
      return format(name, input);
    },
    filter.Update(op, target, value) => {
      return run_update(op, target, value, input, e);
    },
    filter.Interp(name, texts, parts) => {
      return interpolate(name, texts, parts, parts.len() - 1, texts[parts.len()], input, e);
    },
    filter.If(cond, yes, no) => {
      return run_if(cond, yes, no, input, e);
    },
    filter.Bind(source, name, body) => {
      return run_bind(source, name, body, input, e);
    },
    filter.Reduce(source, name, init, update) => {
      return run_fold(false, source, name, init, [update, filter.Identity], input, e);
    },
    filter.Foreach(source, name, init, update, extract) => {
      return run_fold(true, source, name, init, [update, extract], input, e);
    },
    filter.And(a, b) => {
      return run_logic(false, a, b, input, e);
    },
    filter.Or(a, b) => {
      return run_logic(true, a, b, input, e);
    },
    filter.Negate(inner) => {
      return each(run(inner, input, e), negate);
    }
  }
}

function lookup(e: Env, name: string): Outputs {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return one(e.values[i]);
    }
    i -= 1;
  }
  return fail("$" + name + " is not defined");
}

// The outputs of `step` for each value of `o`, in order.
function each(o: Outputs, step: (json.JsonValue) => Outputs): Outputs {
  let out = ok([]);
  for v in o.values {
    out = out.then(step(v));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: o.error };
}

function run_pipe(o: Outputs, b: filter.Ast, e: Env): Outputs {
  let out = ok([]);
  for v in o.values {
    out = out.then(run(b, v, e));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: o.error };
}

function iterate(v: json.JsonValue): Outputs {
  return match (v) {
    json.JArray(items) => ok(items),
    json.JObject(o) => ok(o.values()),
    _ => fail("Cannot iterate over " + type_name(v) + " (" + shown(v) + ")"),
  };
}

function negate(v: json.JsonValue): Outputs {
  if let json.JNumber(t) = v {
    return one(json.JNumber(number.format(-number.value(t))));
  }
  return fail(type_name(v) + " (" + shown(v) + ") cannot be negated");
}

// The index runs on the input. jq takes each key, and then each target.
// The step `step` with a `?`: an error of the step itself gives no output.
// An error of the path before the step stays an error.
function run_guarded(step: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  return match (step) {
    filter.Index(target, key) => run_index(target, key, input, e, true),
    filter.Slice(target, from, to) => run_slice(target, from, to, input, e, true),
    filter.Iterate(target) => each(run(target, input, e), iterate_guarded),
    _ => ok(run(step, input, e).values),
  };
}

function guarded(o: Outputs, guard: boolean): Outputs {
  if (guard && o.failed()) {
    return ok(o.values);
  }
  return o;
}

function iterate_guarded(v: json.JsonValue): Outputs {
  return guarded(iterate(v), true);
}

function run_index(target: filter.Ast, key: filter.Ast, input: json.JsonValue, e: Env, guard: boolean): Outputs {
  let keys = run(key, input, e);
  let out = ok([]);
  for k in keys.values {
    let targets = run(target, input, e);
    for t in targets.values {
      out = out.then(guarded(index(t, k), guard));
      if (out.failed()) {
        return out;
      }
    }
    if (targets.failed()) {
      return Outputs { ...out, error: targets.error };
    }
  }
  return Outputs { ...out, error: keys.error };
}

// The slice of `v` that the path element `{"start": a, "end": b}` names.
function slice_of(v: json.JsonValue, o: json.JsonObject): Outputs {
  if (!o.contains("start") || !o.contains("end")) {
    return fail("Array/string slice indices must be integers");
  }
  return slice(v, o.get_or("start", json.JNull), o.get_or("end", json.JNull));
}

function index_error(v: json.JsonValue, k: json.JsonValue): Outputs {
  if let json.JString(s) = k {
    return fail("Cannot index " + type_name(v) + " with string \"" + s + "\"");
  }
  return fail("Cannot index " + type_name(v) + " with " + type_name(k));
}

pub function index(v: json.JsonValue, k: json.JsonValue): Outputs {
  match (v) {
    json.JNull => {
      return match (k) {
        json.JString(_) => one(json.JNull),
        json.JNumber(_) => one(json.JNull),
        json.JObject(_) => one(json.JNull),
        _ => index_error(v, k),
      };
    },
    json.JObject(o) => {
      if let json.JString(s) = k {
        return one(o.get_or(s, json.JNull));
      }
      return index_error(v, k);
    },
    json.JArray(items) => {
      if let json.JNumber(t) = k {
        let x = number.value(t);
        let i = floor_index(x);
        if (i < 0) {
          i += items.len();
        }
        if (x != x || i < 0 || i >= items.len()) {
          return one(json.JNull);
        }
        return one(items[i]);
      }
      if let json.JArray(part) = k {
        return one(json.JArray(positions(items, part)));
      }
      if let json.JObject(o) = k {
        return slice_of(v, o);
      }
      return index_error(v, k);
    },
    json.JString(_) => {
      if let json.JObject(o) = k {
        return slice_of(v, o);
      }
      return index_error(v, k);
    },
    _ => {
      return index_error(v, k);
    }
  }
}

// The i32 of a floored index. An index past the range of i32 is outside any
// array.
function floor_index(x: f64): i32 {
  if (x != x) {
    return 0;
  }
  if (x >= 2147483647.0) {
    return 2147483647;
  }
  if (x <= -2147483648.0) {
    return -2147483647;
  }
  let i = x as i32;
  if (i as f64 > x) {
    i -= 1;
  }
  return i;
}

function ceil_index(x: f64): i32 {
  let i = floor_index(x);
  if (i as f64 < x && i < 2147483647) {
    i += 1;
  }
  return i;
}

function run_slice(target: filter.Ast, from: filter.Ast, to: filter.Ast, input: json.JsonValue, e: Env, guard: boolean): Outputs {
  let tos = run(to, input, e);
  let out = ok([]);
  for t in tos.values {
    let froms = run(from, input, e);
    for f in froms.values {
      let targets = run(target, input, e);
      for v in targets.values {
        out = out.then(guarded(slice(v, f, t), guard));
        if (out.failed()) {
          return out;
        }
      }
      if (targets.failed()) {
        return Outputs { ...out, error: targets.error };
      }
    }
    if (froms.failed()) {
      return Outputs { ...out, error: froms.error };
    }
  }
  return Outputs { ...out, error: tos.error };
}

struct Bounds { start: i32, end: i32, error: string }

function bound(b: json.JsonValue, fallback: i32, len: i32, up: boolean): (i32, string) {
  let i = fallback;
  match (b) {
    json.JNull => {},
    json.JNumber(t) => {
      // A NaN bound is the end of its side, as a null bound is.
      let x = number.value(t);
      if (x != x) {
        return (i, "");
      }
      if (up) {
        i = ceil_index(x);
      } else {
        i = floor_index(x);
      }
      if (i < 0) {
        i += len;
      }
    },
    _ => {
      return (0, "Array/string slice indices must be integers");
    }
  }
  if (i < 0) {
    i = 0;
  }
  if (i > len) {
    i = len;
  }
  return (i, "");
}

function bounds(f: json.JsonValue, t: json.JsonValue, len: i32): Bounds {
  let (start, e1) = bound(f, 0, len, false);
  let (end, e2) = bound(t, len, len, true);
  if (e1.len() > 0 || e2.len() > 0) {
    return Bounds { start: 0, end: 0, error: if (e1.len() > 0) { e1 } else { e2 } };
  }
  if (end < start) {
    end = start;
  }
  return Bounds { start: start, end: end, error: "" };
}

pub function slice(v: json.JsonValue, f: json.JsonValue, t: json.JsonValue): Outputs {
  match (v) {
    json.JNull => {
      return one(json.JNull);
    },
    json.JArray(items) => {
      let b = bounds(f, t, items.len());
      if (b.error.len() > 0) {
        return fail(b.error);
      }
      let part: json.JsonValue[] = [];
      for i in b.start..b.end {
        part = part.append(items[i]);
      }
      return one(json.JArray(part));
    },
    json.JString(s) => {
      let starts = char_starts(s);
      let b = bounds(f, t, starts.len() - 1);
      if (b.error.len() > 0) {
        return fail(b.error);
      }
      return one(json.JString(slice_unchecked(s, starts[b.start], starts[b.end]).to_owned()));
    },
    _ => {
      return fail("Cannot index " + type_name(v) + " with object");
    }
  }
}

// The byte offset of each code point of `s`, and its length at the end.
function char_starts(s: string): i32[] {
  let out: i32[] = [];
  for i in 0..s.len() {
    if ((s[i] & 0xc0 as u8) != 0x80 as u8) {
      out = out.append(i);
    }
  }
  return out.append(s.len());
}

function build_object(keys: filter.Ast[], values: filter.Ast[], at: i32, names: string[], items: json.JsonValue[], input: json.JsonValue, e: Env): Outputs {
  if (at == keys.len()) {
    return one(json.JObject(object_of(names, items)));
  }
  let ks = run(keys[at], input, e);
  let out = ok([]);
  for k in ks.values {
    let json.JString(name) = k else {
      return out.then(fail("Cannot use " + type_name(k) + " (" + shown(k) + ") as object key"));
    };
    let vs = run(values[at], input, e);
    for v in vs.values {
      out = out.then(build_object(keys, values, at + 1, names.append(name), items.append(v), input, e));
      if (out.failed()) {
        return out;
      }
    }
    if (vs.failed()) {
      return Outputs { ...out, error: vs.error };
    }
  }
  return Outputs { ...out, error: ks.error };
}

// A later entry with the same name replaces the value and keeps the place.
function object_of(names: string[], items: json.JsonValue[]): json.JsonObject {
  let o = json.object();
  for i in 0..names.len() {
    o = o.insert(names[i], items[i]);
  }
  return o;
}

// jq takes each right value, and then each left value.
function run_binary(op: string, a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let rights = run(b, input, e);
  let out = ok([]);
  for r in rights.values {
    let lefts = run(a, input, e);
    for l in lefts.values {
      out = out.then(binary(op, l, r));
      if (out.failed()) {
        return out;
      }
    }
    if (lefts.failed()) {
      return Outputs { ...out, error: lefts.error };
    }
  }
  return Outputs { ...out, error: rights.error };
}

function binary(op: string, l: json.JsonValue, r: json.JsonValue): Outputs {
  return match (op) {
    "+" => add(l, r),
    "-" => subtract(l, r),
    "*" => multiply(l, r),
    "/" => divide(l, r),
    "%" => remainder(l, r),
    _ => one(json.JBool(compare_holds(op, order(l, r)))),
  };
}

function compare_holds(op: string, c: i32): boolean {
  return match (op) {
    "==" => c == 0,
    "!=" => c != 0,
    "<" => c < 0,
    "<=" => c <= 0,
    ">" => c > 0,
    _ => c >= 0,
  };
}

// `a and b` is false for a false left value and takes each right value
// otherwise. `a or b` is true for a true left value.
function run_logic(is_or: boolean, a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let lefts = run(a, input, e);
  let out = ok([]);
  for l in lefts.values {
    if (truthy(l) == is_or) {
      out = out.then(one(json.JBool(is_or)));
      continue;
    }
    let rights = run(b, input, e);
    for r in rights.values {
      out = out.then(one(json.JBool(truthy(r))));
    }
    if (rights.failed()) {
      return Outputs { ...out, error: rights.error };
    }
  }
  return Outputs { ...out, error: lefts.error };
}

function rank(v: json.JsonValue): i32 {
  return match (v) {
    json.JNull => 0,
    json.JBool(b) => if (b) { 2 } else { 1 },
    json.JNumber(_) => 3,
    json.JString(_) => 4,
    json.JArray(_) => 5,
    json.JObject(_) => 6,
  };
}

function sign(c: i32): i32 {
  if (c < 0) {
    return -1;
  }
  if (c > 0) {
    return 1;
  }
  return 0;
}

function compare_text(a: string, b: string): i32 {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  for i in 0..n {
    if (a[i] != b[i]) {
      if (a[i] < b[i]) {
        return -1;
      }
      return 1;
    }
  }
  return sign(a.len() - b.len());
}

function sorted(names: string[]): string[] {
  let out = names;
  for i in 1..out.len() {
    let j = i;
    while (j > 0 && compare_text(out[j - 1], out[j]) > 0) {
      let t = out[j];
      out = out.with(j, out[j - 1]).with(j - 1, t);
      j -= 1;
    }
  }
  return out;
}

function compare_arrays(a: json.JsonValue[], b: json.JsonValue[]): i32 {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  for i in 0..n {
    let c = order(a[i], b[i]);
    if (c != 0) {
      return c;
    }
  }
  return sign(a.len() - b.len());
}

// Objects compare by their sorted keys, and then by the values in the order
// of those keys.
function compare_objects(a: json.JsonObject, b: json.JsonObject): i32 {
  let ka = sorted(a.keys());
  let kb = sorted(b.keys());
  let ja: json.JsonValue[] = [];
  let jb: json.JsonValue[] = [];
  for k in ka {
    ja = ja.append(json.JString(k));
  }
  for k in kb {
    jb = jb.append(json.JString(k));
  }
  let c = compare_arrays(ja, jb);
  if (c != 0) {
    return c;
  }
  for k in ka {
    let d = order(a.get_or(k, json.JNull), b.get_or(k, json.JNull));
    if (d != 0) {
      return d;
    }
  }
  return 0;
}

// The order of jq: null, false, true, numbers, strings, arrays, objects.
pub function order(a: json.JsonValue, b: json.JsonValue): i32 {
  let ra = rank(a);
  let rb = rank(b);
  if (ra != rb) {
    return sign(ra - rb);
  }
  match (a) {
    json.JNumber(x) => {
      let json.JNumber(y) = b else {
        return 0;
      };
      return number.compare(x, y);
    },
    json.JString(x) => {
      let json.JString(y) = b else {
        return 0;
      };
      return compare_text(x, y);
    },
    json.JArray(x) => {
      let json.JArray(y) = b else {
        return 0;
      };
      return compare_arrays(x, y);
    },
    json.JObject(x) => {
      let json.JObject(y) = b else {
        return 0;
      };
      return compare_objects(x, y);
    },
    _ => {
      return 0;
    }
  }
}

// ---- Arithmetic ----

function computed(x: f64): json.JsonValue {
  return json.JNumber(number.format(x));
}

function cannot(l: json.JsonValue, r: json.JsonValue, what: string): Outputs {
  return fail(type_name(l) + " (" + shown(l) + ") and " + type_name(r) + " (" + shown(r) + ") cannot be " + what);
}

function add(l: json.JsonValue, r: json.JsonValue): Outputs {
  if let json.JNull = l {
    return one(r);
  }
  match (r) {
    json.JNull => {
      return one(l);
    },
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        return one(computed(number.value(x) + number.value(y)));
      }
    },
    json.JString(y) => {
      if let json.JString(x) = l {
        return one(json.JString(x + y));
      }
    },
    json.JArray(y) => {
      if let json.JArray(x) = l {
        return one(json.JArray(x.concat(y)));
      }
    },
    json.JObject(y) => {
      if let json.JObject(x) = l {
        let o = x;
        for k in y.keys() {
          o = o.insert(k, y.get_or(k, json.JNull));
        }
        return one(json.JObject(o));
      }
    },
    _ => {}
  }
  return cannot(l, r, "added");
}

function subtract(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (r) {
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        return one(computed(number.value(x) - number.value(y)));
      }
    },
    json.JArray(y) => {
      if let json.JArray(x) = l {
        let kept: json.JsonValue[] = [];
        for v in x {
          if (!holds(y, v)) {
            kept = kept.append(v);
          }
        }
        return one(json.JArray(kept));
      }
    },
    _ => {}
  }
  return cannot(l, r, "subtracted");
}

function holds(items: json.JsonValue[], v: json.JsonValue): boolean {
  for x in items {
    if (order(x, v) == 0) {
      return true;
    }
  }
  return false;
}

function multiply(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (l) {
    json.JNumber(x) => {
      if let json.JNumber(y) = r {
        return one(computed(number.value(x) * number.value(y)));
      }
      if let json.JString(t) = r {
        return repeat(t, number.value(x));
      }
    },
    json.JString(t) => {
      if let json.JNumber(y) = r {
        return repeat(t, number.value(y));
      }
    },
    json.JObject(x) => {
      if let json.JObject(y) = r {
        return one(json.JObject(merge(x, y)));
      }
    },
    _ => {}
  }
  return cannot(l, r, "multiplied");
}

// `t` the whole number of times of `n`. A negative `n` gives null.
function repeat(t: string, n: f64): Outputs {
  if (n != n || n < 0.0) {
    return one(json.JNull);
  }
  if (n * (t.len() as f64) >= 2147483647.0) {
    return fail("Repeat string result too long");
  }
  return one(json.JString(t.repeat(n as i32)));
}

// The entries of `b` on those of `a`. Two objects with one key merge in turn.
function merge(a: json.JsonObject, b: json.JsonObject): json.JsonObject {
  let o = a;
  for k in b.keys() {
    let v = b.get_or(k, json.JNull);
    if let json.JObject(y) = v {
      if let json.JObject(x) = a.get_or(k, json.JNull) {
        v = json.JObject(merge(x, y));
      }
    }
    o = o.insert(k, v);
  }
  return o;
}

function divide(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (r) {
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        if (number.value(y) == 0.0) {
          return cannot(l, r, "divided because the divisor is zero");
        }
        return one(computed(number.value(x) / number.value(y)));
      }
    },
    json.JString(y) => {
      if let json.JString(x) = l {
        return one(json.JArray(split(x, y)));
      }
    },
    _ => {}
  }
  return cannot(l, r, "divided");
}

// The parts of `s` between each `sep`. An empty `sep` gives each code point.
function split(s: string, sep: string): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  if (s.len() == 0) {
    return out;
  }
  if (sep.len() == 0) {
    let starts = char_starts(s);
    for i in 0..starts.len() - 1 {
      out = out.append(json.JString(slice_unchecked(s, starts[i], starts[i + 1]).to_owned()));
    }
    return out;
  }
  for part in s.split(sep) {
    out = out.append(json.JString(part));
  }
  return out;
}

// The whole part of the size of `x`, held to the range of an i64 as jq does.
function magnitude(x: f64): u64 {
  if (x <= -9223372036854775808.0) {
    return 9223372036854775808u64;
  }
  if (x >= 9223372036854775807.0) {
    return 9223372036854775807u64;
  }
  if (x < 0.0) {
    return (-x) as u64;
  }
  return x as u64;
}

// jq takes the remainder of the whole parts. The sign is that of the left.
function remainder(l: json.JsonValue, r: json.JsonValue): Outputs {
  let json.JNumber(x) = l else {
    return cannot(l, r, "divided (remainder)");
  };
  let json.JNumber(y) = r else {
    return cannot(l, r, "divided (remainder)");
  };
  let a = number.value(x);
  let b = number.value(y);
  if (a != a || b != b) {
    return one(computed(0.0 / 0.0));
  }
  let d = magnitude(b);
  if (d == 0u64) {
    return cannot(l, r, "divided (remainder) because the divisor is zero");
  }
  let m = (magnitude(a) % d) as f64;
  if (a < 0.0) {
    return one(computed(-m));
  }
  return one(computed(m));
}

// `a // b` gives the values of `a` that are not false or null, and the values
// of `b` when `a` has none.
function run_alt(a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let o = run(a, input, e);
  let kept: json.JsonValue[] = [];
  for v in o.values {
    if (truthy(v)) {
      kept = kept.append(v);
    }
  }
  if (o.failed() || kept.len() > 0) {
    return Outputs { values: kept, error: o.error };
  }
  return run(b, input, e);
}

// ---- Functions ----

function call(name: string, args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  return match (name) {
    "empty" => ok([]),
    "error" => run_error(args, input, e),
    "not" => one(json.JBool(!truthy(input))),
    "type" => one(json.JString(type_name(input))),
    "length" => length(input),
    "keys" => keys(input, true),
    "keys_unsorted" => keys(input, false),
    "has" => run_has(args[0], input, e),
    "map" => collect(run_pipe(iterate(input), args[0], e)),
    "select" => run_select(args[0], input, e),
    "add" => sum(iterate(input)),
    "to_entries" => to_entries(input),
    "from_entries" => from_entries(input),
    "tostring" => one(to_string(input)),
    "tojson" => one(json.JString(output.compact(input))),
    _ => call_more(name, args, input, e),
  };
}

function call_more(name: string, args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  return match (name) {
    "range" => run_range(args, input, e),
    "sort" => sort(input),
    "reverse" => reverse(input),
    "min" => extreme(input, true),
    "max" => extreme(input, false),
    "unique" => by("unique", filter.Identity, input, e),
    "join" => run_join(args[0], input, e),
    "flatten" => run_flatten(args, input, e),
    "any" => quantify(true, args, input, e),
    "all" => quantify(false, args, input, e),
    "recurse" => run_recurse(args, input, e),
    "first" => first(args, input, e),
    "last" => last(args, input, e),
    "limit" => run_limit(args[0], args[1], input, e),
    "path" => paths_of(args[0], input, e),
    "paths" => with_keys(paths_of(paths_filter(args), input, e)),
    "getpath" => run_getpath(args[0], input, e),
    "setpath" => run_setpath(args[0], args[1], input, e),
    "delpaths" => run_delpaths(args[0], input, e),
    "del" => run_del(args[0], input, e),
    "map_values" => run_update("|=", filter.Iterate(filter.Identity), args[0], input, e),
    "walk" => walk(input, args[0], e),
    "while" => run_while(args[0], args[1], input, e),
    "until" => run_until(args[0], args[1], input, e),
    "nth" => nth(args, input, e),
    "isempty" => is_empty(run(args[0], input, e)),
    "with_entries" => with_entries(args[0], input, e),
    "sort_by" => by("sort", args[0], input, e),
    "group_by" => by("group", args[0], input, e),
    "unique_by" => by("unique", args[0], input, e),
    "min_by" => by("min", args[0], input, e),
    "max_by" => by("max", args[0], input, e),
    _ => call_text(name, args, input, e),
  };
}

function call_text(name: string, args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  return match (name) {
    "ascii_downcase" => ascii_case(input, false),
    "ascii_upcase" => ascii_case(input, true),
    "explode" => explode(input),
    "implode" => implode(input),
    "fromjson" => from_json(input),
    "tonumber" => to_number(input),
    "utf8bytelength" => byte_length(input),
    "startswith" => with_argument(name, args[0], input, e),
    "endswith" => with_argument(name, args[0], input, e),
    "ltrimstr" => with_argument(name, args[0], input, e),
    "rtrimstr" => with_argument(name, args[0], input, e),
    "split" => with_argument(name, args[0], input, e),
    "contains" => with_argument(name, args[0], input, e),
    "inside" => with_argument(name, args[0], input, e),
    "in" => with_argument(name, args[0], input, e),
    "indices" => with_argument(name, args[0], input, e),
    "index" => with_argument(name, args[0], input, e),
    "rindex" => with_argument(name, args[0], input, e),
    _ => call_number(name, args, input, e),
  };
}

// `error` raises the input. `error(f)` raises the first output of `f`.
function run_error(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  if (args.len() == 0) {
    return raise(input);
  }
  let o = run(args[0], input, e);
  if (o.values.len() > 0) {
    return raise(o.values[0]);
  }
  return o;
}

function collect(o: Outputs): Outputs {
  if (o.failed()) {
    return Outputs { values: [], error: o.error };
  }
  return one(json.JArray(o.values));
}

function whole(n: i32): json.JsonValue {
  return json.JNumber(n.to_string());
}

function length(v: json.JsonValue): Outputs {
  return match (v) {
    json.JNull => one(whole(0)),
    json.JNumber(t) => {
      let x = number.value(t);
      if (x < 0.0) { one(computed(-x)) } else { one(computed(x)) }
    },
    json.JString(s) => one(whole(char_starts(s).len() - 1)),
    json.JArray(items) => one(whole(items.len())),
    json.JObject(o) => one(whole(o.len())),
    _ => fail(type_name(v) + " (" + shown(v) + ") has no length"),
  };
}

function keys(v: json.JsonValue, in_order: boolean): Outputs {
  let out: json.JsonValue[] = [];
  match (v) {
    json.JObject(o) => {
      let names = o.keys();
      if (in_order) {
        names = sorted(names);
      }
      for k in names {
        out = out.append(json.JString(k));
      }
    },
    json.JArray(items) => {
      for i in 0..items.len() {
        out = out.append(whole(i));
      }
    },
    _ => {
      return fail(type_name(v) + " (" + shown(v) + ") has no keys");
    }
  }
  return one(json.JArray(out));
}

function run_has(key: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let ks = run(key, input, e);
  let out = ok([]);
  for k in ks.values {
    out = out.then(has(input, k));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: ks.error };
}

function has(v: json.JsonValue, k: json.JsonValue): Outputs {
  if let json.JObject(o) = v {
    if let json.JString(s) = k {
      return one(json.JBool(o.contains(s)));
    }
  }
  if let json.JArray(items) = v {
    if let json.JNumber(t) = k {
      // jq cuts the index to its whole part, so -0.5 is the index 0.
      let x = number.value(t);
      return one(json.JBool(items.len() > 0 && x > -1.0 && x < items.len() as f64));
    }
  }
  return fail("Cannot check whether " + type_name(v) + " has a " + type_name(k) + " key");
}

function run_select(cond: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let conds = run(cond, input, e);
  let kept: json.JsonValue[] = [];
  for c in conds.values {
    if (truthy(c)) {
      kept = kept.append(input);
    }
  }
  return Outputs { values: kept, error: conds.error };
}

function sum(o: Outputs): Outputs {
  if (o.failed()) {
    return Outputs { values: [], error: o.error };
  }
  let total: json.JsonValue = json.JNull;
  for v in o.values {
    let next = add(total, v);
    if (next.failed()) {
      return next;
    }
    total = next.values[0];
  }
  return one(total);
}

function to_entries(v: json.JsonValue): Outputs {
  let ks = keys(v, false);
  if (ks.failed()) {
    return ks;
  }
  let json.JArray(names) = ks.values[0] else {
    return ks;
  };
  let out: json.JsonValue[] = [];
  for k in names {
    let item = index(v, k);
    out = out.append(json.JObject(json.object_of(["key", "value"], [k, item.values[0]])));
  }
  return one(json.JArray(out));
}

// The first of the fields `names` of `v` that is not false or null, or null.
function first_field(v: json.JsonValue, names: string[]): Outputs {
  for name in names {
    let o = index(v, json.JString(name));
    if (o.failed() || truthy(o.values[0])) {
      return o;
    }
  }
  return one(json.JNull);
}

// jq 1.7: `map({(.key // .Key // .name // .Name): (if has("value") then
// .value else .Value end)}) | add | . //= {}`.
function from_entries(v: json.JsonValue): Outputs {
  let entries = iterate(v);
  if (entries.failed()) {
    return entries;
  }
  let o = json.object();
  for x in entries.values {
    let key = first_field(x, ["key", "Key", "name", "Name"]);
    if (key.failed()) {
      return key;
    }
    let json.JString(name) = key.values[0] else {
      return fail("Cannot use " + type_name(key.values[0]) + " (" + shown(key.values[0]) + ") as object key");
    };
    let present = has(x, json.JString("value"));
    if (present.failed()) {
      return present;
    }
    let field = if (truthy(present.values[0])) { "value" } else { "Value" };
    o = o.insert(name, index(x, json.JString(field)).values[0]);
  }
  return one(json.JObject(o));
}

function to_string(v: json.JsonValue): json.JsonValue {
  if let json.JString(_) = v {
    return v;
  }
  return json.JString(output.compact(v));
}

// ---- Control ----

function run_if(cond: filter.Ast, yes: filter.Ast, no: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let conds = run(cond, input, e);
  let out = ok([]);
  for c in conds.values {
    if (truthy(c)) {
      out = out.then(run(yes, input, e));
    } else {
      out = out.then(run(no, input, e));
    }
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: conds.error };
}

function run_bind(source: filter.Ast, name: string, body: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let sources = run(source, input, e);
  let out = ok([]);
  for v in sources.values {
    out = out.then(run(body, input, e.with(name, v)));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: sources.error };
}

// `reduce` and `foreach`. `steps` holds the update and the extract. Each
// initial value starts a fold of its own.
function run_fold(each: boolean, source: filter.Ast, name: string, init: filter.Ast, steps: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  let inits = run(init, input, e);
  let out = ok([]);
  for first in inits.values {
    out = out.then(fold(each, run(source, input, e), name, first, steps, e));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: inits.error };
}

// The state after an update is its last output, or null when it has none.
// A `foreach` gives the extract of each output of the update, and a `reduce`
// gives the last state.
function fold(each: boolean, sources: Outputs, name: string, first: json.JsonValue, steps: filter.Ast[], e: Env): Outputs {
  let state = first;
  let out = ok([]);
  for x in sources.values {
    let scope = e.with(name, x);
    let updates = run(steps[0], state, scope);
    if (each) {
      out = out.then(run_pipe(updates, steps[1], scope));
    } else {
      out = Outputs { ...out, error: updates.error };
    }
    if (out.failed()) {
      return out;
    }
    state = json.JNull;
    if (updates.values.len() > 0) {
      state = updates.values[updates.values.len() - 1];
    }
  }
  if (sources.failed()) {
    return Outputs { ...out, error: sources.error };
  }
  if (each) {
    return out;
  }
  return one(state);
}

// ---- Generators and arrays ----

// `values`, `nulls`, `scalars` and the other selectors by type.
function of_type(name: string, v: json.JsonValue): Outputs {
  let t = type_name(v);
  let nested = t == "array" || t == "object";
  let keep = match (name) {
    "values" => t != "null",
    "nulls" => t == "null",
    "scalars" => !nested,
    "iterables" => nested,
    "arrays" => t == "array",
    "objects" => t == "object",
    "booleans" => t == "boolean",
    "numbers" => t == "number",
    _ => t == "string",
  };
  if (keep) {
    return one(v);
  }
  return ok([]);
}

// jq takes each start, then each end, then each step.
function run_range(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  let froms = one(whole(0));
  let upto = args[0];
  if (args.len() > 1) {
    froms = run(args[0], input, e);
    upto = args[1];
  }
  let out = ok([]);
  for f in froms.values {
    let tos = run(upto, input, e);
    for t in tos.values {
      if (args.len() < 3) {
        out = out.then(count(f, t));
      } else {
        out = out.then(run_steps(f, t, args[2], input, e));
      }
      if (out.failed()) {
        return out;
      }
    }
    if (tos.failed()) {
      return Outputs { ...out, error: tos.error };
    }
  }
  return Outputs { ...out, error: froms.error };
}

function count(from: json.JsonValue, upto: json.JsonValue): Outputs {
  let json.JNumber(f) = from else {
    return fail("Range bounds must be numeric");
  };
  let json.JNumber(t) = upto else {
    return fail("Range bounds must be numeric");
  };
  let out: json.JsonValue[] = [];
  let x = number.value(f);
  let end = number.value(t);
  while (x < end) {
    out = out.append(computed(x));
    x += 1.0;
  }
  return ok(out);
}

function run_steps(from: json.JsonValue, upto: json.JsonValue, by: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let bys = run(by, input, e);
  let out = ok([]);
  for b in bys.values {
    out = out.then(steps(from, upto, b));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: bys.error };
}

// `range(from; upto; by)` compares and adds as `<`, `>` and `+` do, so a
// bound that is not a number has the order of its type.
function steps(from: json.JsonValue, upto: json.JsonValue, by: json.JsonValue): Outputs {
  let direction = order(by, whole(0));
  let out: json.JsonValue[] = [];
  if (direction == 0) {
    return ok(out);
  }
  let x = from;
  while (order(x, upto) * direction < 0) {
    out = out.append(x);
    let next = add(x, by);
    if (next.failed()) {
      return Outputs { values: out, error: next.error };
    }
    x = next.values[0];
  }
  return ok(out);
}

// A stable merge sort in the order of jq.
function sorted_values(items: json.JsonValue[]): json.JsonValue[] {
  if (items.len() < 2) {
    return items;
  }
  let half = items.len() / 2;
  let left: json.JsonValue[] = [];
  let right: json.JsonValue[] = [];
  for i in 0..items.len() {
    if (i < half) {
      left = left.append(items[i]);
    } else {
      right = right.append(items[i]);
    }
  }
  left = sorted_values(left);
  right = sorted_values(right);
  let out: json.JsonValue[] = [];
  let i = 0;
  let j = 0;
  while (i < left.len() || j < right.len()) {
    if (j == right.len() || i < left.len() && order(left[i], right[j]) <= 0) {
      out = out.append(left[i]);
      i += 1;
    } else {
      out = out.append(right[j]);
      j += 1;
    }
  }
  return out;
}

function sort(v: json.JsonValue): Outputs {
  if let json.JArray(items) = v {
    return one(json.JArray(sorted_values(items)));
  }
  return fail(type_name(v) + " (" + shown(v) + ") cannot be sorted, as it is not an array");
}

// jq 1.7: `[.[length - 1 - range(0; length)]]`.
function reverse(v: json.JsonValue): Outputs {
  let n = length(v);
  if (n.failed()) {
    return n;
  }
  let out: json.JsonValue[] = [];
  if let json.JArray(items) = v {
    let i = items.len() - 1;
    while (i >= 0) {
      out = out.append(items[i]);
      i -= 1;
    }
    return one(json.JArray(out));
  }
  if (order(n.values[0], whole(0)) == 0) {
    return one(json.JArray(out));
  }
  return fail("Cannot index " + type_name(v) + " with number");
}

// Of equal values, `min` gives the first and `max` gives the last.
function extreme(v: json.JsonValue, least: boolean): Outputs {
  let json.JArray(items) = v else {
    let what = type_name(v) + " (" + shown(v) + ")";
    return fail(what + " and " + what + " cannot be iterated over");
  };
  if (items.len() == 0) {
    return one(json.JNull);
  }
  let best = items[0];
  for i in 1..items.len() {
    let c = order(items[i], best);
    if (least && c < 0 || !least && c >= 0) {
      best = items[i];
    }
  }
  return one(best);
}

function run_join(sep: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let seps = run(sep, input, e);
  let out = ok([]);
  for s in seps.values {
    out = out.then(join(input, s));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: seps.error };
}

// jq 1.7 adds the parts with `+`: a boolean or a number as its text, null as
// "", and each other value as it is.
function join(v: json.JsonValue, sep: json.JsonValue): Outputs {
  let items = iterate(v);
  if (items.failed()) {
    return items;
  }
  let text: json.JsonValue = json.JNull;
  for x in items.values {
    let left = one(json.JString(""));
    if let json.JString(_) = text {
      left = add(text, sep);
    }
    if (left.failed()) {
      return left;
    }
    let part = x;
    let t = type_name(x);
    if (t == "boolean" || t == "number") {
      part = to_string(x);
    } else if (t == "null") {
      part = json.JString("");
    }
    let next = add(left.values[0], part);
    if (next.failed()) {
      return next;
    }
    text = next.values[0];
  }
  if (truthy(text)) {
    return one(text);
  }
  return one(json.JString(""));
}

function run_flatten(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  if (args.len() == 0) {
    return flatten(input, whole(-1));
  }
  let depths = run(args[0], input, e);
  let out = ok([]);
  for d in depths.values {
    if (order(d, whole(0)) < 0) {
      return out.then(fail("flatten depth must not be negative"));
    }
    out = out.then(flatten(input, d));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: depths.error };
}

// An array in `v` opens while `depth` is not 0, as `_flatten` of jq 1.7 does.
function flatten(v: json.JsonValue, depth: json.JsonValue): Outputs {
  let items = iterate(v);
  if (items.failed()) {
    return items;
  }
  let out: json.JsonValue[] = [];
  for x in items.values {
    let opens = false;
    if let json.JArray(_) = x {
      opens = order(depth, whole(0)) != 0;
    }
    if (!opens) {
      out = out.append(x);
      continue;
    }
    let less = subtract(depth, whole(1));
    if (less.failed()) {
      return less;
    }
    let inner = flatten(x, less.values[0]);
    if (inner.failed()) {
      return inner;
    }
    if let json.JArray(more) = inner.values[0] {
      out = out.concat(more);
    }
  }
  return one(json.JArray(out));
}

// `any` and `all`, with a generator and a condition when the call has them.
// The first value that decides the answer stops the search.
function quantify(is_any: boolean, args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  let source = if (args.len() == 2) { run(args[0], input, e) } else { iterate(input) };
  let cond = if (args.len() == 0) { filter.Identity } else { args[args.len() - 1] };
  for v in source.values {
    let conds = run(cond, v, e);
    for c in conds.values {
      if (truthy(c) == is_any) {
        return one(json.JBool(is_any));
      }
    }
    if (conds.failed()) {
      return Outputs { values: [], error: conds.error };
    }
  }
  if (source.failed()) {
    return Outputs { values: [], error: source.error };
  }
  return one(json.JBool(!is_any));
}

function run_recurse(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  if (args.len() == 0) {
    return recurse(input, filter.Optional(filter.Iterate(filter.Identity)), [], e);
  }
  let conds: filter.Ast[] = [];
  if (args.len() == 2) {
    conds = [args[1]];
  }
  return recurse(input, args[0], conds, e);
}

// `v`, and then the same for each output of `f` on `v`. With a condition,
// an output goes on one time for each true value of the condition.
function recurse(v: json.JsonValue, f: filter.Ast, conds: filter.Ast[], e: Env): Outputs {
  let out = one(v);
  let nexts = run(f, v, e);
  for x in nexts.values {
    let held = one(json.JBool(true));
    if (conds.len() > 0) {
      held = run(conds[0], x, e);
    }
    for h in held.values {
      if (truthy(h)) {
        out = out.then(recurse(x, f, conds, e));
        if (out.failed()) {
          return out;
        }
      }
    }
    if (held.failed()) {
      return Outputs { ...out, error: held.error };
    }
  }
  return Outputs { ...out, error: nexts.error };
}

function first(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  if (args.len() == 0) {
    return index(input, whole(0));
  }
  let o = run(args[0], input, e);
  if (o.values.len() > 0) {
    return one(o.values[0]);
  }
  return o;
}

function last(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  if (args.len() == 0) {
    return index(input, whole(-1));
  }
  let o = run(args[0], input, e);
  if (o.failed()) {
    return Outputs { values: [], error: o.error };
  }
  if (o.values.len() == 0) {
    return one(json.JNull);
  }
  return one(o.values[o.values.len() - 1]);
}

function run_limit(n: filter.Ast, f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let counts = run(n, input, e);
  let out = ok([]);
  for c in counts.values {
    out = out.then(limit(c, f, input, e));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: counts.error };
}

// jq 1.7 counts down from `n` with `-`, and stops at 0 or less. A negative
// `n` gives each output.
function limit(n: json.JsonValue, f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let sign = order(n, whole(0));
  if (sign == 0) {
    return ok([]);
  }
  let o = run(f, input, e);
  if (sign < 0) {
    return o;
  }
  let left = n;
  let kept: json.JsonValue[] = [];
  for v in o.values {
    let less = subtract(left, whole(1));
    if (less.failed()) {
      return Outputs { values: kept, error: less.error };
    }
    left = less.values[0];
    kept = kept.append(v);
    if (order(left, whole(0)) <= 0) {
      return ok(kept);
    }
  }
  return Outputs { values: kept, error: o.error };
}

// ---- Functions with a key ----

// `sort_by`, `group_by`, `unique_by`, `min_by` and `max_by`. The key of an
// item is the array of the outputs of `f` on it.
function by(what: string, f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let items = iterate(input);
  if (items.failed()) {
    return items;
  }
  let pairs: json.JsonValue[] = [];
  let ks: json.JsonValue[] = [];
  for i in 0..items.values.len() {
    let k = run(f, items.values[i], e);
    if (k.failed()) {
      return Outputs { values: [], error: k.error };
    }
    ks = ks.append(json.JArray(k.values));
    pairs = pairs.append(json.JArray([json.JArray(k.values), whole(i)]));
  }
  let json.JArray(_) = input else {
    let both = type_name(input) + " (" + shown(input) + ") and array (" + shown(json.JArray(ks)) + ")";
    if (what == "min" || what == "max") {
      return fail(both + " cannot be iterated over");
    }
    return fail(both + " cannot be sorted, as they are not both arrays");
  };
  if (what == "min" || what == "max") {
    return one(extreme_by(items.values, ks, what == "min"));
  }
  return one(json.JArray(grouped(what, items.values, sorted_values(pairs))));
}

function extreme_by(items: json.JsonValue[], ks: json.JsonValue[], least: boolean): json.JsonValue {
  if (items.len() == 0) {
    return json.JNull;
  }
  let best = 0;
  for i in 1..items.len() {
    let c = order(ks[i], ks[best]);
    if (least && c < 0 || !least && c >= 0) {
      best = i;
    }
  }
  return items[best];
}

// `pairs` holds each key and the place of its item, in the order of the keys.
function grouped(what: string, items: json.JsonValue[], pairs: json.JsonValue[]): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  let group: json.JsonValue[] = [];
  let last: json.JsonValue = json.JNull;
  for p in pairs {
    let item = items[place(p)];
    let k = index(p, whole(0)).values[0];
    let same = group.len() > 0 && order(last, k) == 0;
    last = k;
    if (what == "sort") {
      out = out.append(item);
    } else if (what == "unique") {
      if (!same) {
        out = out.append(item);
      }
      group = [item];
    } else if (same) {
      group = group.append(item);
    } else {
      if (group.len() > 0) {
        out = out.append(json.JArray(group));
      }
      group = [item];
    }
  }
  if (what == "group" && group.len() > 0) {
    out = out.append(json.JArray(group));
  }
  return out;
}

function place(pair: json.JsonValue): i32 {
  if let json.JNumber(t) = index(pair, whole(1)).values[0] {
    return number.value(t) as i32;
  }
  return 0;
}

function with_entries(f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let entries = to_entries(input);
  if (entries.failed()) {
    return entries;
  }
  let mapped = collect(run_pipe(iterate(entries.values[0]), f, e));
  if (mapped.failed()) {
    return mapped;
  }
  return from_entries(mapped.values[0]);
}

function is_empty(o: Outputs): Outputs {
  if (o.values.len() > 0) {
    return one(json.JBool(false));
  }
  if (o.failed()) {
    return o;
  }
  return one(json.JBool(true));
}

// jq 1.7: `def _while: if cond then ., (update | _while) else empty end`.
function run_while(cond: filter.Ast, update: filter.Ast, v: json.JsonValue, e: Env): Outputs {
  let conds = run(cond, v, e);
  let out = ok([]);
  for c in conds.values {
    if (!truthy(c)) {
      continue;
    }
    out = out.then(one(v));
    let nexts = run(update, v, e);
    for n in nexts.values {
      out = out.then(run_while(cond, update, n, e));
      if (out.failed()) {
        return out;
      }
    }
    if (nexts.failed()) {
      return Outputs { ...out, error: nexts.error };
    }
  }
  return Outputs { ...out, error: conds.error };
}

// jq 1.7: `def _until: if cond then . else (next | _until) end`.
function run_until(cond: filter.Ast, next: filter.Ast, v: json.JsonValue, e: Env): Outputs {
  let conds = run(cond, v, e);
  let out = ok([]);
  for c in conds.values {
    if (truthy(c)) {
      out = out.then(one(v));
      continue;
    }
    let nexts = run(next, v, e);
    for n in nexts.values {
      out = out.then(run_until(cond, next, n, e));
      if (out.failed()) {
        return out;
      }
    }
    if (nexts.failed()) {
      return Outputs { ...out, error: nexts.error };
    }
  }
  return Outputs { ...out, error: conds.error };
}

// `nth(n)` is `.[n]`. `nth(n; f)` counts down from `n + 1` with `-`, as jq
// 1.7 does, and gives the output at which the count is 0 or less.
function nth(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  let counts = run(args[0], input, e);
  let out = ok([]);
  for n in counts.values {
    if (args.len() == 1) {
      out = out.then(index(input, n));
    } else {
      out = out.then(nth_output(n, args[1], input, e));
    }
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: counts.error };
}

function nth_output(n: json.JsonValue, f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  if (order(n, whole(0)) < 0) {
    return fail("nth doesn't support negative indices");
  }
  let start = add(n, whole(1));
  if (start.failed()) {
    return start;
  }
  let left = start.values[0];
  let o = run(f, input, e);
  for v in o.values {
    let less = subtract(left, whole(1));
    if (less.failed()) {
      return less;
    }
    left = less.values[0];
    if (order(left, whole(0)) <= 0) {
      return one(v);
    }
  }
  return Outputs { values: [], error: o.error };
}

// ---- Strings ----

function ascii_case(v: json.JsonValue, upper: boolean): Outputs {
  let json.JString(s) = v else {
    return fail("explode input must be a string");
  };
  if (upper) {
    return one(json.JString(s.to_ascii_upper()));
  }
  return one(json.JString(s.to_ascii_lower()));
}

function explode(v: json.JsonValue): Outputs {
  let json.JString(s) = v else {
    return fail("explode input must be a string");
  };
  let out: json.JsonValue[] = [];
  let i = 0;
  while (i < s.len()) {
    let Some((cp, size)) = utf8.decode_at(s, i) else {
      break;
    };
    out = out.append(whole(cp));
    i += size;
  }
  return one(json.JArray(out));
}

function implode(v: json.JsonValue): Outputs {
  let json.JArray(items) = v else {
    return fail("implode input must be an array");
  };
  let s = "";
  for x in items {
    let cp = 0.0 / 0.0;
    if let json.JNumber(t) = x {
      cp = number.value(t);
    }
    if (cp != cp) {
      return fail(type_name(x) + " (" + shown(x) + ") can't be imploded, unicode codepoint needs to be numeric");
    }
    s += filter.codepoint_text(floor_index(cp));
  }
  return one(json.JString(s));
}

// The one value of the JSON text `v`, read as jq reads its input.
function from_json(v: json.JsonValue): Outputs {
  let json.JString(s) = v else {
    return fail(type_name(v) + " (" + shown(v) + ") only strings can be parsed");
  };
  let r = reader.read(s);
  let bad = r.error;
  if (r.values.len() > 1) {
    bad = "Unexpected extra JSON values";
  } else if (r.values.len() == 0 && bad.len() == 0) {
    bad = "Expected JSON value";
  }
  if (bad.len() > 0) {
    return fail(bad + " (while parsing '" + reader.c_string(s) + "')");
  }
  return one(r.values[0].value);
}

function to_number(v: json.JsonValue): Outputs {
  if let json.JNumber(_) = v {
    return one(v);
  }
  let json.JString(_) = v else {
    return fail(type_name(v) + " (" + shown(v) + ") cannot be parsed as a number");
  };
  let parsed = from_json(v);
  if (parsed.failed()) {
    return parsed;
  }
  if let json.JNumber(_) = parsed.values[0] {
    return parsed;
  }
  return fail(type_name(v) + " (" + shown(v) + ") cannot be parsed as a number");
}

function byte_length(v: json.JsonValue): Outputs {
  if let json.JString(s) = v {
    return one(whole(s.len()));
  }
  return fail(type_name(v) + " (" + shown(v) + ") only strings have UTF-8 byte length");
}

// A function of the input and each output of its one argument.
function with_argument(name: string, arg: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let args = run(arg, input, e);
  let out = ok([]);
  for a in args.values {
    out = out.then(apply(name, input, a));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: args.error };
}

function apply(name: string, v: json.JsonValue, a: json.JsonValue): Outputs {
  return match (name) {
    "contains" => contains_checked(v, a),
    "inside" => contains_checked(a, v),
    "in" => has(a, v),
    "indices" => indices(v, a),
    "index" => index_of(v, a, false),
    "rindex" => index_of(v, a, true),
    _ => text_function(name, v, a),
  };
}

function text_function(name: string, v: json.JsonValue, a: json.JsonValue): Outputs {
  let trims = name == "ltrimstr" || name == "rtrimstr";
  let json.JString(s) = v else {
    return if (trims) { one(v) } else { fail(text_error(name)) };
  };
  let json.JString(t) = a else {
    return if (trims) { one(v) } else { fail(text_error(name)) };
  };
  return match (name) {
    "startswith" => one(json.JBool(s.starts_with(t))),
    "endswith" => one(json.JBool(s.ends_with(t))),
    "split" => one(json.JArray(split(s, t))),
    "ltrimstr" => if (s.starts_with(t)) { one(json.JString(slice_unchecked(s, t.len(), s.len()).to_owned())) } else { one(v) },
    _ => if (s.ends_with(t)) { one(json.JString(slice_unchecked(s, 0, s.len() - t.len()).to_owned())) } else { one(v) },
  };
}

function text_error(name: string): string {
  if (name == "split") {
    return "split input and separator must be strings";
  }
  return name + "() requires string inputs";
}

function contains_checked(a: json.JsonValue, b: json.JsonValue): Outputs {
  if (rank(a) != rank(b)) {
    return fail(type_name(a) + " (" + shown(a) + ") and " + type_name(b) + " (" + shown(b) + ") cannot have their containment checked");
  }
  return one(json.JBool(contains(a, b)));
}

// An object holds each key of `b` with a value that contains that of `b`. An
// array holds, for each item of `b`, an item that contains it. A string holds
// `b` as a part. Other values are equal.
function contains(a: json.JsonValue, b: json.JsonValue): boolean {
  match (a) {
    json.JObject(x) => {
      if let json.JObject(y) = b {
        for k in y.keys() {
          if (!x.contains(k) || !contains(x.get_or(k, json.JNull), y.get_or(k, json.JNull))) {
            return false;
          }
        }
        return true;
      }
    },
    json.JArray(x) => {
      if let json.JArray(y) = b {
        for want in y {
          if (!any_contains(x, want)) {
            return false;
          }
        }
        return true;
      }
    },
    json.JString(x) => {
      if let json.JString(y) = b {
        return x.contains(y);
      }
    },
    _ => {}
  }
  return order(a, b) == 0;
}

function any_contains(items: json.JsonValue[], want: json.JsonValue): boolean {
  for x in items {
    if (contains(x, want)) {
      return true;
    }
  }
  return false;
}

// Each place in `items` at which `part` starts.
function positions(items: json.JsonValue[], part: json.JsonValue[]): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  if (part.len() == 0) {
    return out;
  }
  for i in 0..items.len() {
    let here = i + part.len() <= items.len();
    for j in 0..part.len() {
      if (here && order(items[i + j], part[j]) != 0) {
        here = false;
      }
    }
    if (here) {
      out = out.append(whole(i));
    }
  }
  return out;
}

// jq 1.7 gives the byte offsets in a string.
function indices(v: json.JsonValue, a: json.JsonValue): Outputs {
  if let json.JArray(items) = v {
    if let json.JArray(_) = a {
      return index(v, a);
    }
    return one(json.JArray(positions(items, [a])));
  }
  if let json.JString(s) = v {
    if let json.JString(t) = a {
      let out: json.JsonValue[] = [];
      if (t.len() > 0) {
        for i in 0..s.len() - t.len() + 1 {
          if (slice_unchecked(s, i, i + t.len()).to_owned() == t) {
            out = out.append(whole(i));
          }
        }
      }
      return one(json.JArray(out));
    }
  }
  return index(v, a);
}

// jq 1.7: `indices($i) | .[0]`, and `.[-1:][0]` for the last.
function index_of(v: json.JsonValue, a: json.JsonValue, from_end: boolean): Outputs {
  let found = indices(v, a);
  if (found.failed()) {
    return found;
  }
  if (!from_end) {
    return index(found.values[0], whole(0));
  }
  let tail = slice(found.values[0], whole(-1), json.JNull);
  if (tail.failed()) {
    return tail;
  }
  return index(tail.values[0], whole(0));
}

// ---- Numbers ----

function call_number(name: string, args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  return match (name) {
    "nan" => one(computed(0.0 / 0.0)),
    "infinite" => one(computed(1.0 / 0.0)),
    "isnan" => one(json.JBool(number_is(name, input))),
    "isinfinite" => one(json.JBool(number_is(name, input))),
    "isnormal" => one(json.JBool(number_is(name, input))),
    "pow" => run_pow(args[0], args[1], input, e),
    "floor" => math_of(name, input),
    "ceil" => math_of(name, input),
    "round" => math_of(name, input),
    "trunc" => math_of(name, input),
    "fabs" => math_of(name, input),
    "sqrt" => math_of(name, input),
    "log" => math_of(name, input),
    "log2" => math_of(name, input),
    "log10" => math_of(name, input),
    "exp2" => math_of(name, input),
    "exp10" => math_of(name, input),
    _ => of_type(name, input),
  };
}

// A value that is not a number is not NaN, not infinite and not normal.
function number_is(name: string, v: json.JsonValue): boolean {
  let json.JNumber(t) = v else {
    return false;
  };
  let x = number.value(t);
  if (name == "isnan") {
    return x != x;
  }
  let size = x.abs();
  if (name == "isinfinite") {
    return size > 1.7976931348623157e308;
  }
  return size >= 2.2250738585072014e-308 && size <= 1.7976931348623157e308;
}

function number_of(v: json.JsonValue): (f64, Outputs) {
  if let json.JNumber(t) = v {
    return (number.value(t), ok([]));
  }
  return (0.0, fail(type_name(v) + " (" + shown(v) + ") number required"));
}

function math_of(name: string, v: json.JsonValue): Outputs {
  let (x, bad) = number_of(v);
  if (bad.failed()) {
    return bad;
  }
  return one(computed(match (name) {
    "floor" => x.floor(),
    "ceil" => x.ceil(),
    "round" => x.round(),
    "trunc" => x.trunc(),
    "fabs" => x.abs(),
    "sqrt" => x.sqrt(),
    "log" => x.log(),
    "log2" => x.log2(),
    "log10" => x.log10(),
    "exp2" => x.exp2(),
    _ => x.exp10(),
  }));
}

// jq takes each exponent, and then each base.
function run_pow(base: filter.Ast, exponent: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let exponents = run(exponent, input, e);
  let out = ok([]);
  for y in exponents.values {
    let bases = run(base, input, e);
    for x in bases.values {
      let (a, bad_a) = number_of(x);
      let (b, bad_b) = number_of(y);
      if (bad_a.failed()) {
        return out.then(bad_a);
      }
      if (bad_b.failed()) {
        return out.then(bad_b);
      }
      out = out.then(one(computed(a.pow(b))));
    }
    if (bases.failed()) {
      return Outputs { ...out, error: bases.error };
    }
  }
  return Outputs { ...out, error: exponents.error };
}

// ---- Formats and string interpolation ----

// The strings of a literal with interpolations. `tail` is the text after the
// part `at`. jq takes each value of a later part, and then each value of the
// part before it.
function interpolate(name: string, texts: string[], parts: filter.Ast[], at: i32, tail: string, input: json.JsonValue, e: Env): Outputs {
  if (at < 0) {
    return one(json.JString(tail));
  }
  let vs = run(parts[at], input, e);
  let out = ok([]);
  for v in vs.values {
    let f = format(name, v);
    if (f.failed()) {
      return out.then(f);
    }
    let json.JString(piece) = f.values[0] else {
      return out;
    };
    out = out.then(interpolate(name, texts, parts, at - 1, texts[at] + piece + tail, input, e));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: vs.error };
}

function text_of(v: json.JsonValue): string {
  if let json.JString(s) = v {
    return s;
  }
  return output.compact(v);
}

function format(name: string, v: json.JsonValue): Outputs {
  return match (name) {
    "text" => one(json.JString(text_of(v))),
    "json" => one(json.JString(output.compact(v))),
    "html" => one(json.JString(escaped(text_of(v), "html"))),
    "uri" => one(json.JString(uri(text_of(v)))),
    "csv" => row(name, v),
    "tsv" => row(name, v),
    "sh" => shell(v),
    "base64" => one(json.JString(base64.encode(text_of(v).bytes()))),
    "base64d" => base64_decoded(text_of(v)),
    _ => fail(name + " is not a valid format"),
  };
}

// The text of one byte in the format `name`, or "" when the byte stays. jq
// writes a NUL as a backslash and a 0 in each of these formats.
function escape_of(b: u8, name: string): string {
  if (b == 0 as u8) {
    return "\\0";
  }
  if (name == "html") {
    return match (b) {
      b'<' => "&lt;",
      b'>' => "&gt;",
      b'&' => "&amp;",
      b'\'' => "&apos;",
      b'"' => "&quot;",
      _ => "",
    };
  }
  if (name == "csv") {
    return if (b == b'"') { "\"\"" } else { "" };
  }
  if (name == "sh") {
    return if (b == b'\'') { "'\\''" } else { "" };
  }
  return match (b) {
    b'\t' => "\\t",
    b'\n' => "\\n",
    b'\r' => "\\r",
    b'\\' => "\\\\",
    _ => "",
  };
}

function escaped(s: string, name: string): string {
  let out = "";
  let from = 0;
  for i in 0..s.len() {
    let piece = escape_of(s[i], name);
    if (piece.len() > 0) {
      out += slice_unchecked(s, from, i).to_owned() + piece;
      from = i + 1;
    }
  }
  return out + slice_unchecked(s, from, s.len()).to_owned();
}

// Each byte but a letter, a digit and `-_.~` as a percent sign and two hex
// digits in upper case.
function uri(s: string): string {
  let digits = "0123456789ABCDEF";
  let out = "";
  let from = 0;
  for i in 0..s.len() {
    let b = s[i];
    let stays = b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z' || b >= b'0' && b <= b'9' || b == b'-' || b == b'_' || b == b'.' || b == b'~';
    if (!stays) {
      let n = b as i32;
      out += slice_unchecked(s, from, i).to_owned() + "%" + slice_unchecked(digits, n / 16, n / 16 + 1).to_owned() + slice_unchecked(digits, n % 16, n % 16 + 1).to_owned();
      from = i + 1;
    }
  }
  return out + slice_unchecked(s, from, s.len()).to_owned();
}

// A row of `@csv` or of `@tsv`. null and NaN are empty fields.
function row(name: string, v: json.JsonValue): Outputs {
  let json.JArray(items) = v else {
    return fail(type_name(v) + " (" + shown(v) + ") cannot be " + name + "-formatted, only array");
  };
  let fields: string[] = [];
  for x in items {
    match (x) {
      json.JNull => {
        fields = fields.append("");
      },
      json.JBool(_) => {
        fields = fields.append(output.compact(x));
      },
      json.JNumber(t) => {
        let n = number.value(t);
        fields = fields.append(if (n != n) { "" } else { output.compact(x) });
      },
      json.JString(s) => {
        if (name == "csv") {
          fields = fields.append("\"" + escaped(s, name) + "\"");
        } else {
          fields = fields.append(escaped(s, name));
        }
      },
      _ => {
        return fail(type_name(x) + " (" + shown(x) + ") is not valid in a csv row");
      }
    }
  }
  if (name == "csv") {
    return one(json.JString(fields.join(",")));
  }
  return one(json.JString(fields.join("\t")));
}

// The words of a shell command: each string in single quotes.
function shell(v: json.JsonValue): Outputs {
  let items = [v];
  if let json.JArray(all) = v {
    items = all;
  }
  let words: string[] = [];
  for x in items {
    match (x) {
      json.JString(s) => {
        words = words.append("'" + escaped(s, "sh") + "'");
      },
      json.JArray(_) => {
        return fail(type_name(x) + " (" + shown(x) + ") can not be escaped for shell");
      },
      json.JObject(_) => {
        return fail(type_name(x) + " (" + shown(x) + ") can not be escaped for shell");
      },
      _ => {
        words = words.append(output.compact(x));
      }
    }
  }
  return one(json.JString(words.join(" ")));
}

function base64_digit(b: u8): i32 {
  if (b >= b'A' && b <= b'Z') {
    return (b - b'A') as i32;
  }
  if (b >= b'a' && b <= b'z') {
    return (b - b'a') as i32 + 26;
  }
  if (b >= b'0' && b <= b'9') {
    return (b - b'0') as i32 + 52;
  }
  if (b == b'+') {
    return 62;
  }
  if (b == b'/') {
    return 63;
  }
  return -1;
}

// jq reads to the first `=`, and gives U+FFFD for bytes that are not UTF-8.
function base64_decoded(s: string): Outputs {
  let bytes: u8[] = [];
  let code = 0;
  let pending = 0;
  for i in 0..s.len() {
    if (s[i] == b'=') {
      break;
    }
    let d = base64_digit(s[i]);
    if (d < 0) {
      return fail("string (" + shown(json.JString(s)) + ") is not valid base64 data");
    }
    code = code * 64 + d;
    pending += 1;
    if (pending == 4) {
      bytes = bytes.append((code >> 16 & 255) as u8).append((code >> 8 & 255) as u8).append((code & 255) as u8);
      code = 0;
      pending = 0;
    }
  }
  if (pending == 1) {
    return fail("string (" + shown(json.JString(s)) + ") trailing base64 byte found");
  }
  if (pending == 3) {
    bytes = bytes.append((code >> 10 & 255) as u8).append((code >> 2 & 255) as u8);
  } else if (pending == 2) {
    bytes = bytes.append((code >> 4 & 255) as u8);
  }
  let text = unsafe { string_from_bytes_unchecked(bytes) };
  if (utf8.is_valid(text)) {
    return one(json.JString(text));
  }
  return one(json.JString(reader.repaired(text)));
}

// ---- Paths ----

// A value that a path expression gave, and the path to it. `tracked` is the
// value that the path gives in the input. jq follows a path only from a value
// that is that same value, which `attached` says.
struct PathItem { path: json.JsonValue[], tracked: json.JsonValue, value: json.JsonValue, attached: boolean }

struct PathOuts { items: PathItem[], error: json.JsonValue[] }

function path_ok(items: PathItem[]): PathOuts {
  return PathOuts { items: items, error: [] };
}

function path_fail(message: string): PathOuts {
  return PathOuts { items: [], error: [json.JString(message)] };
}

function (o: PathOuts) failed(): boolean {
  return o.error.len() > 0;
}

function (o: PathOuts) then(more: PathOuts): PathOuts {
  return PathOuts { items: o.items.concat(more.items), error: more.error };
}

// The value as jq shows it in a message about a path: cut to 26 bytes and
// "..." when it is longer than 29.
function shown_long(v: json.JsonValue): string {
  let s = output.compact(v);
  if (s.len() > 29) {
    return slice_unchecked(s, 0, 26).to_owned() + "...";
  }
  return s;
}

function on_path(it: PathItem, key: json.JsonValue, v: json.JsonValue): PathItem {
  return PathItem { path: it.path.append(key), tracked: v, value: v, attached: true };
}

// A value that no path step gave. jq holds it to be the tracked value when it
// is the same null or boolean, or the same value through a variable.
function off_path(it: PathItem, v: json.JsonValue, through_variable: boolean): PathItem {
  let simple = match (v) {
    json.JNull => true,
    json.JBool(_) => true,
    _ => through_variable,
  };
  return PathItem { path: it.path, tracked: it.tracked, value: v, attached: simple && order(v, it.tracked) == 0 };
}

function run_paths(f: filter.Ast, it: PathItem, e: Env): PathOuts {
  match (f) {
    filter.Identity => {
      return path_ok([it]);
    },
    filter.Index(target, key) => {
      return paths_index(target, key, it, e, false);
    },
    filter.Slice(target, from, to) => {
      return paths_slice(target, from, to, it, e, false);
    },
    filter.Iterate(target) => {
      return paths_iterate(run_paths(target, it, e), false);
    },
    filter.Optional(step) => {
      return paths_guarded(step, it, e);
    },
    filter.Try(inner) => {
      return path_ok(run_paths(inner, it, e).items);
    },
    filter.Pipe(a, b) => {
      return paths_each(run_paths(a, it, e), b, e);
    },
    filter.Comma(a, b) => {
      let o = run_paths(a, it, e);
      if (o.failed()) {
        return o;
      }
      return o.then(run_paths(b, it, e));
    },
    filter.If(cond, yes, no) => {
      return paths_if(cond, yes, no, it, e);
    },
    filter.Alt(a, b) => {
      return paths_alt(a, b, it, e);
    },
    filter.Bind(source, name, body) => {
      return paths_bind(source, name, body, it, e);
    },
    filter.Foreach(source, name, init, update, extract) => {
      return paths_foreach(source, name, init, [update, extract], it, e);
    },
    filter.Catch(body, handler) => {
      let o = run_paths(body, it, e);
      if (!o.failed()) {
        return o;
      }
      return path_ok(o.items).then(run_paths(handler, off_path(it, o.error[0], false), e));
    },
    filter.Call(name, args) => {
      let found = e.find(name, args.len());
      if (found.len() > 0) {
        return paths_defined(found[0], args, 0, it, e, callee_scope(found[0]));
      }
      return paths_call(name, args, it, e);
    },
    filter.Def(name, params, body, rest) => {
      return run_paths(rest, it, e.define(Func { name: name, params: params, body: body, scope: [e], argument: false }));
    },
    filter.Var(_) => {
      return paths_plain(f, it, e, true);
    },
    _ => {
      return paths_plain(f, it, e, false);
    }
  }
}

// A filter that makes no path step: each output is off the path.
function paths_plain(f: filter.Ast, it: PathItem, e: Env, through_variable: boolean): PathOuts {
  let vs = run(f, it.value, e);
  let items: PathItem[] = [];
  for v in vs.values {
    items = items.append(off_path(it, v, through_variable));
  }
  return PathOuts { items: items, error: vs.error };
}

function paths_guarded(step: filter.Ast, it: PathItem, e: Env): PathOuts {
  return match (step) {
    filter.Index(target, key) => paths_index(target, key, it, e, true),
    filter.Slice(target, from, to) => paths_slice(target, from, to, it, e, true),
    filter.Iterate(target) => paths_iterate(run_paths(target, it, e), true),
    _ => path_ok(run_paths(step, it, e).items),
  };
}

// The path outputs of `step` from each item of `o`.
function paths_each(o: PathOuts, step: filter.Ast, e: Env): PathOuts {
  let out = path_ok([]);
  for it in o.items {
    out = out.then(run_paths(step, it, e));
    if (out.failed()) {
      return out;
    }
  }
  return PathOuts { ...out, error: o.error };
}

function paths_iterate(o: PathOuts, guard: boolean): PathOuts {
  let out = path_ok([]);
  for it in o.items {
    out = out.then(path_iterate(it, guard));
    if (out.failed()) {
      return out;
    }
  }
  return PathOuts { ...out, error: o.error };
}

function path_iterate(it: PathItem, guard: boolean): PathOuts {
  if (!it.attached) {
    return path_fail("Invalid path expression near attempt to iterate through " + shown_long(it.value));
  }
  let items: PathItem[] = [];
  match (it.value) {
    json.JArray(all) => {
      for i in 0..all.len() {
        items = items.append(on_path(it, whole(i), all[i]));
      }
    },
    json.JObject(o) => {
      for k in o.keys() {
        items = items.append(on_path(it, json.JString(k), o.get_or(k, json.JNull)));
      }
    },
    _ => {
      if (guard) {
        return path_ok([]);
      }
      return path_fail("Cannot iterate over " + type_name(it.value) + " (" + shown(it.value) + ")");
    }
  }
  return path_ok(items);
}

// One step from `it` with the key `k`. The value comes from `index`.
function path_step(it: PathItem, k: json.JsonValue, guard: boolean): PathOuts {
  if (!it.attached) {
    return path_fail("Invalid path expression near attempt to access element " + shown(k) + " of " + shown_long(it.value));
  }
  let v = index(it.value, k);
  if (v.failed()) {
    if (guard) {
      return path_ok([]);
    }
    return PathOuts { items: [], error: v.error };
  }
  return path_ok([on_path(it, k, v.values[0])]);
}

function paths_index(target: filter.Ast, key: filter.Ast, it: PathItem, e: Env, guard: boolean): PathOuts {
  let keys = run(key, it.value, e);
  let out = path_ok([]);
  for k in keys.values {
    let targets = run_paths(target, it, e);
    for t in targets.items {
      out = out.then(path_step(t, k, guard));
      if (out.failed()) {
        return out;
      }
    }
    if (targets.failed()) {
      return PathOuts { ...out, error: targets.error };
    }
  }
  return PathOuts { ...out, error: keys.error };
}

function paths_slice(target: filter.Ast, from: filter.Ast, to: filter.Ast, it: PathItem, e: Env, guard: boolean): PathOuts {
  let tos = run(to, it.value, e);
  let out = path_ok([]);
  for t in tos.values {
    let froms = run(from, it.value, e);
    for f in froms.values {
      let key = json.JObject(json.object_of(["start", "end"], [f, t]));
      let targets = run_paths(target, it, e);
      for x in targets.items {
        out = out.then(path_step(x, key, guard));
        if (out.failed()) {
          return out;
        }
      }
      if (targets.failed()) {
        return PathOuts { ...out, error: targets.error };
      }
    }
    if (froms.failed()) {
      return PathOuts { ...out, error: froms.error };
    }
  }
  return PathOuts { ...out, error: tos.error };
}

function paths_if(cond: filter.Ast, yes: filter.Ast, no: filter.Ast, it: PathItem, e: Env): PathOuts {
  let conds = run(cond, it.value, e);
  let out = path_ok([]);
  for c in conds.values {
    if (truthy(c)) {
      out = out.then(run_paths(yes, it, e));
    } else {
      out = out.then(run_paths(no, it, e));
    }
    if (out.failed()) {
      return out;
    }
  }
  return PathOuts { ...out, error: conds.error };
}

function paths_alt(a: filter.Ast, b: filter.Ast, it: PathItem, e: Env): PathOuts {
  let o = run_paths(a, it, e);
  let kept: PathItem[] = [];
  for x in o.items {
    if (truthy(x.value)) {
      kept = kept.append(x);
    }
  }
  if (o.failed() || kept.len() > 0) {
    return PathOuts { items: kept, error: o.error };
  }
  return run_paths(b, it, e);
}

function paths_bind(source: filter.Ast, name: string, body: filter.Ast, it: PathItem, e: Env): PathOuts {
  let sources = run(source, it.value, e);
  let out = path_ok([]);
  for v in sources.values {
    out = out.then(run_paths(body, it, e.with(name, v)));
    if (out.failed()) {
      return out;
    }
  }
  return PathOuts { ...out, error: sources.error };
}

// jq keeps the value of the state of a `foreach` and not its path. Each
// update starts at the path of the `foreach` itself.
function paths_foreach(source: filter.Ast, name: string, init: filter.Ast, steps: filter.Ast[], it: PathItem, e: Env): PathOuts {
  let inits = run(init, it.value, e);
  let out = path_ok([]);
  for first in inits.values {
    let state = first;
    let sources = run(source, it.value, e);
    for x in sources.values {
      let scope = e.with(name, x);
      let updates = run_paths(steps[0], off_path(it, state, true), scope);
      out = out.then(paths_each(updates, steps[1], scope));
      if (out.failed()) {
        return out;
      }
      state = json.JNull;
      if (updates.items.len() > 0) {
        state = updates.items[updates.items.len() - 1].value;
      }
    }
    if (sources.failed()) {
      return PathOuts { ...out, error: sources.error };
    }
  }
  return PathOuts { ...out, error: inits.error };
}

// The functions that keep a path. Each other function gives values that are
// off the path.
function paths_call(name: string, args: filter.Ast[], it: PathItem, e: Env): PathOuts {
  let key = name + "/" + args.len().to_string();
  return match (key) {
    "empty/0" => path_ok([]),
    "select/1" => paths_if(args[0], filter.Identity, filter.Call("empty", []), it, e),
    "recurse/0" => paths_recurse(it, filter.Optional(filter.Iterate(filter.Identity)), [], e),
    "recurse/1" => paths_recurse(it, args[0], [], e),
    "recurse/2" => paths_recurse(it, args[0], [args[1]], e),
    "first/0" => path_step(it, whole(0), false),
    "last/0" => path_step(it, whole(-1), false),
    "first/1" => paths_limit(whole(1), args[0], it, e),
    "limit/2" => paths_limits(args[0], args[1], it, e),
    "nth/1" => paths_index(filter.Identity, args[0], it, e, false),
    "getpath/1" => paths_getpath(args[0], it, e),
    _ => paths_other(name, args, it, e),
  };
}

// A selector by type keeps the path. Each other function is off the path.
function paths_other(name: string, args: filter.Ast[], it: PathItem, e: Env): PathOuts {
  let selectors = ["values", "nulls", "scalars", "iterables", "arrays", "objects", "booleans", "numbers", "strings"];
  if (args.len() == 0 && selectors.contains(name)) {
    if (of_type(name, it.value).values.len() > 0) {
      return path_ok([it]);
    }
    return path_ok([]);
  }
  return paths_plain(filter.Call(name, args), it, e, false);
}

function paths_recurse(it: PathItem, f: filter.Ast, conds: filter.Ast[], e: Env): PathOuts {
  let out = path_ok([it]);
  let nexts = run_paths(f, it, e);
  for x in nexts.items {
    let held = one(json.JBool(true));
    if (conds.len() > 0) {
      held = run(conds[0], x.value, e);
    }
    for h in held.values {
      if (truthy(h)) {
        out = out.then(paths_recurse(x, f, conds, e));
        if (out.failed()) {
          return out;
        }
      }
    }
    if (held.failed()) {
      return PathOuts { ...out, error: held.error };
    }
  }
  return PathOuts { ...out, error: nexts.error };
}

function paths_limits(n: filter.Ast, f: filter.Ast, it: PathItem, e: Env): PathOuts {
  let counts = run(n, it.value, e);
  let out = path_ok([]);
  for c in counts.values {
    out = out.then(paths_limit(c, f, it, e));
    if (out.failed()) {
      return out;
    }
  }
  return PathOuts { ...out, error: counts.error };
}

function paths_limit(n: json.JsonValue, f: filter.Ast, it: PathItem, e: Env): PathOuts {
  let sign = order(n, whole(0));
  if (sign == 0) {
    return path_ok([]);
  }
  let o = run_paths(f, it, e);
  if (sign < 0) {
    return o;
  }
  let left = n;
  let kept: PathItem[] = [];
  for x in o.items {
    let less = subtract(left, whole(1));
    if (less.failed()) {
      return PathOuts { items: kept, error: less.error };
    }
    left = less.values[0];
    kept = kept.append(x);
    if (order(left, whole(0)) <= 0) {
      return path_ok(kept);
    }
  }
  return PathOuts { items: kept, error: o.error };
}

function paths_getpath(arg: filter.Ast, it: PathItem, e: Env): PathOuts {
  let ps = run(arg, it.value, e);
  let out = path_ok([]);
  for p in ps.values {
    let json.JArray(keys) = p else {
      return out.then(path_fail("Path must be specified as an array"));
    };
    let v = getpath(it.value, keys, 0);
    if (v.failed()) {
      return out.then(PathOuts { items: [], error: v.error });
    }
    out = out.then(path_ok([PathItem { path: it.path.concat(keys), tracked: v.values[0], value: v.values[0], attached: it.attached }]));
  }
  return PathOuts { ...out, error: ps.error };
}

// The paths that `f` gives on `input`, each as an array of its keys.
function paths_of(f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let o = run_paths(f, PathItem { path: [], tracked: input, value: input, attached: true }, e);
  let paths: json.JsonValue[] = [];
  for it in o.items {
    if (!it.attached) {
      return Outputs { values: paths, error: [json.JString("Invalid path expression with result " + shown_long(it.value))] };
    }
    paths = paths.append(json.JArray(it.path));
  }
  return Outputs { values: paths, error: o.error };
}

// jq 1.7: `path(recurse) | select(length > 0)`, and `recurse | select(f)`
// when `paths` has a filter.
function paths_filter(args: filter.Ast[]): filter.Ast {
  let all: filter.Ast = filter.Call("recurse", []);
  if (args.len() > 0) {
    return filter.Pipe(all, filter.Call("select", [args[0]]));
  }
  return all;
}

function with_keys(o: Outputs): Outputs {
  let kept: json.JsonValue[] = [];
  for p in o.values {
    if (order(p, json.JArray([])) != 0) {
      kept = kept.append(p);
    }
  }
  return Outputs { values: kept, error: o.error };
}

function getpath(v: json.JsonValue, keys: json.JsonValue[], at: i32): Outputs {
  if (at == keys.len()) {
    return one(v);
  }
  if let json.JNull = v {
    return one(v);
  }
  let child = index(v, keys[at]);
  if (child.failed()) {
    return child;
  }
  return getpath(child.values[0], keys, at + 1);
}

function run_getpath(arg: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let ps = run(arg, input, e);
  let out = ok([]);
  for p in ps.values {
    let json.JArray(keys) = p else {
      return out.then(fail("Path must be specified as an array"));
    };
    out = out.then(getpath(input, keys, 0));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: ps.error };
}

// `v` with `x` at the path `keys` from `at`. A null on the way becomes an
// object or an array.
function setpath(v: json.JsonValue, keys: json.JsonValue[], at: i32, x: json.JsonValue): Outputs {
  if (at == keys.len()) {
    return one(x);
  }
  let child = index(v, keys[at]);
  if (child.failed()) {
    return child;
  }
  let inner = setpath(child.values[0], keys, at + 1, x);
  if (inner.failed()) {
    return inner;
  }
  return set(v, keys[at], inner.values[0]);
}

function set(v: json.JsonValue, k: json.JsonValue, x: json.JsonValue): Outputs {
  match (k) {
    json.JString(name) => {
      if let json.JNull = v {
        return one(json.JObject(json.object_of([name], [x])));
      }
      if let json.JObject(o) = v {
        let fields = o;
        fields = fields.insert(name, x);
        return one(json.JObject(fields));
      }
    },
    json.JNumber(t) => {
      if let json.JNull = v {
        return set_item([], number.value(t), x);
      }
      if let json.JArray(items) = v {
        return set_item(items, number.value(t), x);
      }
    },
    json.JObject(o) => {
      if let json.JNull = v {
        return set_slice([], o, x);
      }
      if let json.JArray(items) = v {
        return set_slice(items, o, x);
      }
      if let json.JString(_) = v {
        return fail("Cannot update string slices");
      }
    },
    _ => {}
  }
  return index_error(v, k);
}

function set_item(items: json.JsonValue[], at: f64, x: json.JsonValue): Outputs {
  if (at != at) {
    return fail("Cannot set array element at NaN index");
  }
  let i = at as i32;
  if (i < 0) {
    i += items.len();
  }
  if (i < 0) {
    return fail("Out of bounds negative array index");
  }
  if (i > 536870911) {
    return fail("Array index too large");
  }
  let out = items;
  while (out.len() <= i) {
    out = out.append(json.JNull);
  }
  return one(json.JArray(out.with(i, x)));
}

function set_slice(items: json.JsonValue[], o: json.JsonObject, x: json.JsonValue): Outputs {
  let b = slice_bounds(o, items.len());
  if (b.error.len() > 0) {
    return fail(b.error);
  }
  let json.JArray(more) = x else {
    return fail("A slice of an array can only be assigned another array");
  };
  let out: json.JsonValue[] = [];
  for i in 0..b.start {
    out = out.append(items[i]);
  }
  out = out.concat(more);
  for i in b.end..items.len() {
    out = out.append(items[i]);
  }
  return one(json.JArray(out));
}

// The bounds of the path element `{"start": a, "end": b}` in an array of
// `len` items.
function slice_bounds(o: json.JsonObject, len: i32): Bounds {
  if (!o.contains("start") || !o.contains("end")) {
    return Bounds { start: 0, end: 0, error: "Array/string slice indices must be integers" };
  }
  return bounds(o.get_or("start", json.JNull), o.get_or("end", json.JNull), len);
}

function run_setpath(path: filter.Ast, value: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let xs = run(value, input, e);
  let out = ok([]);
  for x in xs.values {
    let ps = run(path, input, e);
    for p in ps.values {
      let json.JArray(keys) = p else {
        return out.then(fail("Path must be specified as an array"));
      };
      out = out.then(setpath(input, keys, 0, x));
      if (out.failed()) {
        return out;
      }
    }
    if (ps.failed()) {
      return Outputs { ...out, error: ps.error };
    }
  }
  return Outputs { ...out, error: xs.error };
}

// `v` with no value at each path of `paths`.
function delpaths(v: json.JsonValue, paths: json.JsonValue): Outputs {
  let json.JArray(all) = paths else {
    return fail("Paths must be specified as an array");
  };
  let sorted_paths: json.JsonValue[][] = [];
  for p in sorted_values(all) {
    let json.JArray(keys) = p else {
      return fail("Path must be specified as array, not " + type_name(p));
    };
    if (keys.len() == 0) {
      return one(json.JNull);
    }
    sorted_paths = sorted_paths.append(keys);
  }
  return delete_paths(v, sorted_paths, 0);
}

// `v` with no value at each of the sorted paths, which all have the same
// keys before `at`. A run of paths with one key at `at` goes down into that
// key, but when the first path of the run ends there, the key itself goes.
// The keys that go leave `v` in one step, so each index is a place of `v` as
// it was.
function delete_paths(v: json.JsonValue, paths: json.JsonValue[][], at: i32): Outputs {
  let out = v;
  let ends: json.JsonValue[] = [];
  let i = 0;
  while (i < paths.len()) {
    let key = paths[i][at];
    let run: json.JsonValue[][] = [];
    let j = i;
    while (j < paths.len() && order(paths[j][at], key) == 0) {
      run = run.append(paths[j]);
      j += 1;
    }
    if (paths[i].len() == at + 1) {
      ends = ends.append(key);
    } else {
      let child = index(out, key);
      if (child.failed()) {
        return child;
      }
      let inner = one(json.JNull);
      if let json.JNull = child.values[0] {
        inner = ok([]);
      } else {
        inner = delete_paths(child.values[0], run, at + 1);
      }
      if (inner.failed()) {
        return inner;
      }
      if (inner.values.len() > 0) {
        let next = set(out, key, inner.values[0]);
        if (next.failed()) {
          return next;
        }
        out = next.values[0];
      }
    }
    i = j;
  }
  return delete_keys(out, ends);
}

function delete_keys(v: json.JsonValue, keys: json.JsonValue[]): Outputs {
  if (keys.len() == 0) {
    return one(v);
  }
  match (v) {
    json.JNull => {
      return one(v);
    },
    json.JObject(o) => {
      let fields = o;
      for k in keys {
        let json.JString(name) = k else {
          return fail("Cannot delete " + type_name(k) + " field of object");
        };
        fields = fields.remove(name);
      }
      return one(json.JObject(fields));
    },
    json.JArray(items) => {
      return delete_items(items, keys);
    },
    _ => {
      return fail("Cannot delete fields from " + type_name(v));
    }
  }
}

// `items` with no item at each key: an index, an index from the end, or a
// slice. Each key is a place of `items` as it is now.
function delete_items(items: json.JsonValue[], keys: json.JsonValue[]): Outputs {
  let gone: boolean[] = [];
  for i in 0..items.len() {
    gone = gone.append(false);
  }
  for k in keys {
    let start = 0;
    let end = 0;
    match (k) {
      json.JNumber(t) => {
        start = number.value(t) as i32;
        if (start < 0) {
          start += items.len();
        }
        end = start + 1;
      },
      json.JObject(o) => {
        let b = slice_bounds(o, items.len());
        if (b.error.len() > 0) {
          return fail(b.error);
        }
        start = b.start;
        end = b.end;
      },
      _ => {
        return fail("Cannot delete " + type_name(k) + " element of array");
      }
    }
    for i in start..end {
      if (i >= 0 && i < items.len()) {
        gone = gone.with(i, true);
      }
    }
  }
  let out: json.JsonValue[] = [];
  for i in 0..items.len() {
    if (!gone[i]) {
      out = out.append(items[i]);
    }
  }
  return one(json.JArray(out));
}

function run_delpaths(arg: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let ps = run(arg, input, e);
  let out = ok([]);
  for p in ps.values {
    out = out.then(delpaths(input, p));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: ps.error };
}

function run_del(f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let ps = paths_of(f, input, e);
  if (ps.failed()) {
    return Outputs { values: [], error: ps.error };
  }
  return delpaths(input, json.JArray(ps.values));
}

// ---- Updates ----

// `target = value` sets each path of `target` to each output of `value`.
// The other operators change the value at each path: `|=` with a filter, and
// `+=` and the others with the operator and each output of `value`.
function run_update(op: string, target: filter.Ast, value: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  if (op == "|=") {
    return modify(op, target, value, json.JNull, input, e);
  }
  let xs = run(value, input, e);
  let out = ok([]);
  for x in xs.values {
    if (op == "=") {
      out = out.then(assign(target, x, input, e));
    } else {
      out = out.then(modify(op, target, value, x, input, e));
    }
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: xs.error };
}

function assign(target: filter.Ast, x: json.JsonValue, input: json.JsonValue, e: Env): Outputs {
  let ps = paths_of(target, input, e);
  if (ps.failed()) {
    return Outputs { values: [], error: ps.error };
  }
  let out = input;
  for p in ps.values {
    let json.JArray(keys) = p else {
      continue;
    };
    let next = setpath(out, keys, 0, x);
    if (next.failed()) {
      return next;
    }
    out = next.values[0];
  }
  return one(out);
}

// The new value for `v` in an update. `|=` takes the first output of the
// filter, and no output deletes the path.
function updated(op: string, f: filter.Ast, x: json.JsonValue, v: json.JsonValue, e: Env): Outputs {
  if (op == "|=") {
    return run(f, v, e);
  }
  if (op == "//") {
    return if (truthy(v)) { one(v) } else { one(x) };
  }
  return binary(op, v, x);
}

function modify(op: string, target: filter.Ast, f: filter.Ast, x: json.JsonValue, input: json.JsonValue, e: Env): Outputs {
  let ps = paths_of(target, input, e);
  if (ps.failed()) {
    return Outputs { values: [], error: ps.error };
  }
  let out = input;
  let gone: json.JsonValue[] = [];
  for p in ps.values {
    let json.JArray(keys) = p else {
      continue;
    };
    let old = getpath(out, keys, 0);
    if (old.failed()) {
      return old;
    }
    let news = updated(op, f, x, old.values[0], e);
    if (news.values.len() == 0) {
      if (news.failed()) {
        return news;
      }
      gone = gone.append(p);
      continue;
    }
    let next = setpath(out, keys, 0, news.values[0]);
    if (next.failed()) {
      return next;
    }
    out = next.values[0];
  }
  return delpaths(out, json.JArray(gone));
}

// jq 1.7: `def w: if type == "object" then map_values(w) elif type ==
// "array" then map(w) else . end | f`.
function walk(v: json.JsonValue, f: filter.Ast, e: Env): Outputs {
  let rebuilt = v;
  match (v) {
    json.JObject(o) => {
      let fields = json.object();
      for k in o.keys() {
        let inner = walk(o.get_or(k, json.JNull), f, e);
        if (inner.values.len() > 0) {
          fields = fields.insert(k, inner.values[0]);
        } else if (inner.failed()) {
          return inner;
        }
      }
      rebuilt = json.JObject(fields);
    },
    json.JArray(items) => {
      let out: json.JsonValue[] = [];
      for x in items {
        let inner = walk(x, f, e);
        if (inner.failed()) {
          return Outputs { values: [], error: inner.error };
        }
        out = out.concat(inner.values);
      }
      rebuilt = json.JArray(out);
    },
    _ => {}
  }
  return run(f, rebuilt, e);
}

// ---- Functions of a `def` ----

// The environment for the body of `f`, before its parameters. A function
// sees itself, so that it can call itself.
function callee_scope(f: Func): Env {
  if (f.argument) {
    return f.scope[0];
  }
  return f.scope[0].define(f);
}

// The outputs of the body of `f` with its parameters from `at` bound in
// `scope`. A parameter is the argument as a filter of the caller. A `$`
// parameter is a variable for each output of the argument also, and jq takes
// each value of an earlier parameter first.
function call_defined(f: Func, args: filter.Ast[], at: i32, input: json.JsonValue, e: Env, scope: Env): Outputs {
  if (at == args.len()) {
    return run(f.body, input, scope);
  }
  let name = filter.param_name(f.params[at]);
  let bound = scope.define(Func { name: name, params: [], body: args[at], scope: [e], argument: true });
  if (name == f.params[at]) {
    return call_defined(f, args, at + 1, input, e, bound);
  }
  let vs = run(args[at], input, e);
  let out = ok([]);
  for v in vs.values {
    out = out.then(call_defined(f, args, at + 1, input, e, bound.with(name, v)));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: vs.error };
}

function paths_defined(f: Func, args: filter.Ast[], at: i32, it: PathItem, e: Env, scope: Env): PathOuts {
  if (at == args.len()) {
    return run_paths(f.body, it, scope);
  }
  let name = filter.param_name(f.params[at]);
  let bound = scope.define(Func { name: name, params: [], body: args[at], scope: [e], argument: true });
  if (name == f.params[at]) {
    return paths_defined(f, args, at + 1, it, e, bound);
  }
  let vs = run(args[at], it.value, e);
  let out = path_ok([]);
  for v in vs.values {
    out = out.then(paths_defined(f, args, at + 1, it, e, bound.with(name, v)));
    if (out.failed()) {
      return out;
    }
  }
  return PathOuts { ...out, error: vs.error };
}
