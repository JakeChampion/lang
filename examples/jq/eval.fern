// The evaluator of the jq language.
//
// A filter gives its outputs one at a time to a sink. The sink takes the
// state of the run and gives it back, so each part of the state changes in
// place. A sink that stops the filter sets the signal of the state: an
// error, a `break`, or a halt. A generator stops at the first signal, so a
// filter with no end stops in `first`, `limit` and `label`.
import "std/json";
import "std/base64";
import "std/f64";
import "std/string";
import "std/utf8";
import "./dates";
import "./filter";
import "./input" as stream;
import "./modules";
import "./number";
import "./output";
import "./reader";
import "./regex";

// `error` is empty, or it holds the one value of the error. A function of
// values gives this, and `give` sends it to a sink.
pub struct Outputs { values: json.JsonValue[], error: json.JsonValue[] }

pub struct Env { names: string[], values: json.JsonValue[], funcs: Func[] }

// A function of a `def`, or an argument of a call. `scope` holds the one
// environment of the definition, or of the call for an argument. An argument
// has no parameters and does not see itself. A function of a module keeps
// its `own_name` for the calls to itself when an import gives it a new name.
// `single` tells that `single` holds for each call of the function.
struct Func { name: string, own_name: string, params: string[], body: filter.Ast, scope: Env[], argument: boolean, single: boolean }

// The signals of a run.
pub const OK: i32 = 0;

pub const ERROR: i32 = 1;

// An error or a `break` of the sink of a `try`, which that `try` does not
// catch. `esc` counts the `try` bodies that it goes out of, and `inner` is the
// signal that it carries.
const ESCAPED: i32 = 2;

pub const BREAK: i32 = 3;

pub const HALT: i32 = 4;

// The state of a run.
//
// - `err` is the value of an error, `brk` the label of a `break`, and `code`
//   the exit status of a halt.
// - `labels` gives a new number to each label, `limit` and `first`.
// - A construct that collects keeps its part in `items`, `found` or `v` while
//   its filter runs, and puts back the value of the construct around it.
// - A construct that gives outputs while its filter runs keeps its part on
//   the stack `stack`.
// - `out` holds the text that the command line writes next, and `last` the
//   kind of its last output: 0 for none, 1 for false or null, 2 otherwise.
pub struct St {
  sig: i32,
  err: json.JsonValue,
  esc: i32,
  inner: i32,
  brk: i32,
  code: i32,
  labels: i32,
  items: json.JsonValue[],
  found: PathItem[],
  v: json.JsonValue,
  stack: json.JsonValue[],
  out: string,
  last: i32,
  io: stream.Source,
}

pub function env(): Env {
  return Env { names: [], values: [], funcs: [] };
}

pub function state(io: stream.Source): own St {
  return St { sig: OK, err: json.JNull, esc: 0, inner: 0, brk: 0, code: 0, labels: 0, items: [], found: [], v: json.JNull, stack: [], out: "", last: 0, io: io };
}

pub function (e: Env) with(name: string, value: json.JsonValue): Env {
  return Env { names: e.names.append(name), values: e.values.append(value), funcs: e.funcs };
}

function (e: Env) define(f: Func): Env {
  return Env { names: e.names, values: e.values, funcs: e.funcs.append(f) };
}

// The last function of `e` with this name and this number of parameters.
function (e: Env) find(name: string, count: i32): Func[] {
  let i = e.funcs.len() - 1;
  while (i >= 0) {
    if (e.funcs[i].name == name && e.funcs[i].params.len() == count) {
      return [e.funcs[i]];
    }
    i -= 1;
  }
  return [];
}

function ok(values: json.JsonValue[]): Outputs {
  return Outputs { values: values, error: [] };
}

function one(v: json.JsonValue): Outputs {
  return ok([v]);
}

function raise(v: json.JsonValue): Outputs {
  return Outputs { values: [], error: [v] };
}

function fail(message: string): Outputs {
  return raise(json.JString(message));
}

// The error after "jq: error (at ...)", or "" when there is none.
pub function (o: Outputs) message(): string {
  if (o.error.len() == 0) {
    return "";
  }
  return error_text(o.error[0]);
}

// The text after "jq: error (at ...)" for the error value `v`.
pub function error_text(v: json.JsonValue): string {
  if let json.JString(s) = v {
    return ": " + s;
  }
  return " (not a string): " + output.compact(v);
}

function (o: Outputs) failed(): boolean {
  return o.error.len() > 0;
}

// The state with the error `v`.
function raised(own st: St, v: json.JsonValue): own St {
  return St { ...st, sig: ERROR, err: v };
}

function failed_with(own st: St, message: string): own St {
  return raised(st, json.JString(message));
}

// Each value of `o` to `k`, and then the error of `o`.
function give(o: Outputs, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let s = st;
  for v in o.values {
    s = k(v, s);
    if (s.sig != OK) {
      return s;
    }
  }
  if (o.error.len() > 0) {
    return raised(s, o.error[0]);
  }
  return s;
}

// The outputs of `f` on `input` in an array, and the error that stopped it.
// A unit test reads a filter so.
pub function outputs(f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let s = run(f, input, e, append_item, state(stream.empty()));
  if (s.sig == ERROR) {
    return Outputs { values: s.items, error: [s.err] };
  }
  return ok(s.items);
}

function append_item(v: json.JsonValue, own s: St): own St {
  return St { ...s, items: s.items.append(v) };
}

// The outputs of `f` in an array. `k` takes the array, unless `f` stopped.
function run_collect(f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let saved = st.items;
  let s = run(f, input, e, append_item, St { ...st, items: [] });
  let items = s.items;
  let t = St { ...s, items: saved };
  if (t.sig != OK) {
    return t;
  }
  return k(json.JArray(items), t);
}

// The outputs of `f` in the array `items` of the state. The caller puts
// back its own `items`.
function collected(f: filter.Ast, input: json.JsonValue, e: Env, own st: St): own St {
  return run(f, input, e, append_item, St { ...st, items: [] });
}

// A sink that gives the outputs of a `try` body to `k`. An error of `k` is
// not an error of the body.
function escaping(k: (json.JsonValue, own St) => own St): (json.JsonValue, own St) => own St {
  return (v: json.JsonValue, own s: St): own St => escape_signal(k(v, s));
}

function escape_signal(own s: St): own St {
  if (s.sig == ERROR || s.sig == BREAK) {
    return St { ...s, sig: ESCAPED, esc: 1, inner: s.sig };
  }
  if (s.sig == ESCAPED) {
    return St { ...s, esc: s.esc + 1 };
  }
  return s;
}

// Whether a `try` body stopped on its own error or `break`. jq raises a
// `break` as the error `{"__jq": N}`, so a `try` around it catches it.
function caught(s: St): boolean {
  return s.sig == ERROR || s.sig == BREAK;
}

// The value of the error that a `try` body stopped on.
function caught_value(s: St): json.JsonValue {
  if (s.sig == BREAK) {
    return json.JObject(json.object().insert("__jq", whole(s.brk)));
  }
  return s.err;
}

// The state after a `try` body: an error of the sink goes on.
function unescaped(own s: St): own St {
  if (s.sig != ESCAPED) {
    return s;
  }
  if (s.esc == 1) {
    return St { ...s, sig: s.inner, esc: 0 };
  }
  return St { ...s, esc: s.esc - 1 };
}

pub function truthy(v: json.JsonValue): boolean {
  return match (v) {
    json.JNull => false,
    json.JBool(b) => b,
    _ => true,
  };
}

// fern-lint: allow cyclomatic-complexity
pub function run(f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  match (f) {
    filter.Identity => {
      return k(input, st);
    },
    filter.Literal(v) => {
      return k(v, st);
    },
    filter.Var(name) => {
      return give(lookup(e, name), k, st);
    },
    filter.Index(target, key) => {
      return run_index(target, key, input, e, false, k, st);
    },
    filter.Slice(target, from, to) => {
      return run_slice(target, from, to, input, e, false, k, st);
    },
    filter.Iterate(target) => {
      return run(target, input, e, (v: json.JsonValue, own s: St): own St => iterate_to(v, false, k, s), st);
    },
    filter.Optional(step) => {
      return run_guarded(step, input, e, k, st);
    },
    filter.Try(inner) => {
      let s = run(inner, input, e, escaping(k), st);
      if (caught(s)) {
        return St { ...s, sig: OK, err: json.JNull };
      }
      return unescaped(s);
    },
    filter.Pipe(a, b) => {
      return each_of(a, input, e, (v: json.JsonValue, own s: St): own St => run(b, v, e, k, s), st);
    },
    filter.Comma(a, b) => {
      let s = run(a, input, e, k, st);
      if (s.sig != OK) {
        return s;
      }
      return run(b, input, e, k, s);
    },
    filter.Collect(inner) => {
      return run_collect(inner, input, e, k, st);
    },
    filter.EmptyArray => {
      return k(json.JArray([]), st);
    },
    filter.Object(keys, values) => {
      return build_object(keys, values, 0, [], [], input, e, k, st);
    },
    filter.Compare(op, a, b) => {
      return run_binary(op, a, b, input, e, k, st);
    },
    filter.Arith(op, a, b) => {
      return run_binary(op, a, b, input, e, k, st);
    },
    filter.Alt(a, b) => {
      return run_alt(a, b, input, e, k, st);
    },
    filter.Call(name, args) => {
      let found = e.find(name, args.len());
      if (found.len() > 0) {
        return call_defined(found[0], args, 0, input, e, callee_scope(found[0]), k, st);
      }
      return call(name, args, input, e, k, st);
    },
    filter.Def(name, params, body, rest) => {
      return run(rest, input, e.define(defined(name, params, body, e)), k, st);
    },
    filter.Catch(body, handler) => {
      let s = run(body, input, e, escaping(k), st);
      if (caught(s)) {
        let err = caught_value(s);
        return run(handler, err, e, k, St { ...s, sig: OK, err: json.JNull });
      }
      return unescaped(s);
    },
    filter.Format(name) => {
      return give(format(name, input), k, st);
    },
    filter.Update(op, target, value) => {
      return run_update(op, target, value, input, e, k, st);
    },
    filter.Interp(name, texts, parts) => {
      return interpolate(name, texts, parts, parts.len() - 1, texts[parts.len()], input, e, k, st);
    },
    filter.If(cond, yes, no) => {
      if (single(cond, e)) {
        return run_branch(cond, yes, no, input, e, k, st);
      }
      return run(cond, input, e, (c: json.JsonValue, own s: St): own St => run(if (truthy(c)) { yes } else { no }, input, e, k, s), st);
    },
    filter.Bind(source, name, body) => {
      return each_of(source, input, e, (v: json.JsonValue, own s: St): own St => run(body, input, e.with(name, v), k, s), st);
    },
    filter.Reduce(source, name, init, update) => {
      return run(init, input, e, (first: json.JsonValue, own s: St): own St => reduce_from(source, name, update, first, input, e, k, s), st);
    },
    filter.Foreach(source, name, init, update, extract) => {
      return run(init, input, e, (first: json.JsonValue, own s: St): own St => foreach_from(source, name, update, extract, first, input, e, k, s), st);
    },
    filter.And(a, b) => {
      return run_logic(false, a, b, input, e, k, st);
    },
    filter.Or(a, b) => {
      return run_logic(true, a, b, input, e, k, st);
    },
    filter.Negate(inner) => {
      return run(inner, input, e, (v: json.JsonValue, own s: St): own St => give(negate(v), k, s), st);
    },
    filter.Label(name, body) => {
      let id = st.labels;
      return ended(id, run(body, input, e.with(filter.label_var(name), whole(id)), k, St { ...st, labels: id + 1 }));
    },
    filter.Break(name) => {
      let found = lookup(e, filter.label_var(name));
      if (found.failed()) {
        return raised(st, found.error[0]);
      }
      return broken(st, label_id(found.values[0]));
    },
    _ => {
      return failed_with(st, "unknown filter");
    }
  }
}

// Whether each run of `f` in `e` gives one output at most, and does nothing
// after that output. The outputs of such a filter can come first in an
// array, and the order of the outputs, the errors and the effects is that
// of jq. A call of a parameter can give more outputs.
function single(f: filter.Ast, e: Env): boolean {
  return match (f) {
    filter.Identity => true,
    filter.Literal(_) => true,
    filter.Var(_) => true,
    filter.EmptyArray => true,
    filter.Format(_) => true,
    filter.Break(_) => true,
    filter.Collect(_) => true,
    filter.Index(target, key) => single(target, e) && single(key, e),
    filter.Slice(target, from, to) => single(target, e) && single(from, e) && single(to, e),
    filter.Optional(a) => single(a, e),
    filter.Try(a) => single(a, e),
    filter.Negate(a) => single(a, e),
    filter.Label(_, a) => single(a, e),
    filter.Reduce(_, _, init, _) => single(init, e),
    filter.Update(op, _, value) => op == "|=" || single(value, e),
    filter.Object(keys, values) => all_single(keys, e) && all_single(values, e),
    filter.Interp(_, _, parts) => all_single(parts, e),
    filter.Call(name, args) => single_call(name, args, e),
    filter.Def(name, params, body, rest) => single(rest, e.define(defined(name, params, body, e))),
    _ => single_pair(f, e),
  };
}

function single_pair(f: filter.Ast, e: Env): boolean {
  return match (f) {
    filter.Pipe(a, b) => single(a, e) && single(b, e),
    filter.Arith(_, a, b) => single(a, e) && single(b, e),
    filter.Compare(_, a, b) => single(a, e) && single(b, e),
    filter.Alt(a, b) => single(a, e) && single(b, e),
    filter.Catch(a, b) => single(a, e) && single(b, e),
    filter.And(a, b) => single(a, e) && single(b, e),
    filter.Or(a, b) => single(a, e) && single(b, e),
    filter.Bind(source, _, body) => single(source, e) && single(body, e),
    filter.If(cond, yes, no) => single(cond, e) && single(yes, e) && single(no, e),
    _ => false,
  };
}

function all_single(fs: filter.Ast[], e: Env): boolean {
  for f in fs {
    if (!single(f, e)) {
      return false;
    }
  }
  return true;
}

// The built-in functions that can give more than one output.
const GENERATORS: string[] = ["recurse", "paths", "inputs", "path", "range", "repeat", "limit", "while", "until"];

// A call of a function of a `def` gives its outputs to `single` when the
// function does and each `$` parameter takes one value. A built-in function
// does when it is not a generator and each argument does.
function single_call(name: string, args: filter.Ast[], e: Env): boolean {
  let found = e.find(name, args.len());
  if (found.len() == 0) {
    return !GENERATORS.contains(name) && all_single(args, e);
  }
  let f = found[0];
  if (!f.single) {
    return false;
  }
  for i in 0..args.len() {
    if (filter.param_name(f.params[i]) != f.params[i] && !single(args[i], e)) {
      return false;
    }
  }
  return true;
}

// The function of `def name(params): body` in `e`. Its calls to itself count
// as single while `single` checks its body, and its parameters do not.
function defined(name: string, params: string[], body: filter.Ast, e: Env): Func {
  let f = Func { name: name, own_name: name, params: params, body: body, scope: [e], argument: false, single: true };
  let inner = e.define(f);
  for p in params {
    let x = filter.param_name(p);
    inner = inner.define(Func { name: x, own_name: x, params: [], body: filter.Identity, scope: [e], argument: true, single: false });
  }
  return Func { ...f, single: single(body, inner) };
}

// The outputs of `f` to `k`. When `f` is single, its outputs come first in
// an array, so that its frames are gone while `k` runs: a function that
// calls itself then needs less stack for each call.
function each_of(f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (!single(f, e)) {
    return run(f, input, e, k, st);
  }
  let saved = st.items;
  let c = collected(f, input, e, st);
  let vs = c.items;
  let s = St { ...c, items: saved };
  if (s.sig != OK) {
    return s;
  }
  for v in vs {
    s = k(v, s);
    if (s.sig != OK) {
      return s;
    }
  }
  return s;
}

// The outputs of `if cond then yes else no end` when `cond` is single. The
// branch needs no value of the condition, so the run of the branch is the
// last call.
function run_branch(cond: filter.Ast, yes: filter.Ast, no: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let saved = st.items;
  let c = collected(cond, input, e, st);
  let taken = c.items.len() > 0 && truthy(c.items[0]);
  let given = c.items.len() > 0;
  let s = St { ...c, items: saved };
  if (s.sig != OK || !given) {
    return s;
  }
  return run(if (taken) { yes } else { no }, input, e, k, s);
}

// The state after the body of the label `id`: its own `break` ends it.
function ended(id: i32, own s: St): own St {
  if (s.sig == BREAK && s.brk == id) {
    return St { ...s, sig: OK };
  }
  return s;
}

function broken(own s: St, id: i32): own St {
  return St { ...s, sig: BREAK, brk: id };
}

function label_id(v: json.JsonValue): i32 {
  if let json.JNumber(t) = v {
    return number.value(t) as i32;
  }
  return -1;
}

// A new label number, and the state that has used it.
function new_label(own st: St): (i32, St) {
  let id = st.labels;
  return (id, St { ...st, labels: id + 1 });
}

// An attribute of jq. When it is not set, as in `--run-tests`, it gives no
// output.
function attribute(e: Env, name: string, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let found = lookup(e, name);
  if (found.values.len() == 0) {
    return st;
  }
  return k(found.values[0], st);
}

// True in `--run-tests`, which writes no messages.
function quiet(e: Env): boolean {
  return e.names.contains("*quiet");
}

function lookup(e: Env, name: string): Outputs {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return one(e.values[i]);
    }
    i -= 1;
  }
  return fail("$" + name + " is not defined");
}

// The items of `v` to `k`. With `guard`, a value that is not an array or an
// object gives no output.
function iterate_to(v: json.JsonValue, guard: boolean, k: (json.JsonValue, own St) => own St, own st: St): own St {
  match (v) {
    json.JArray(items) => {
      let s = st;
      for x in items {
        s = k(x, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    json.JObject(o) => {
      let s = st;
      for x in o.values() {
        s = k(x, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    _ => {
      if (guard) {
        return st;
      }
      return failed_with(st, "Cannot iterate over " + output.type_name(v) + " (" + output.shown(v) + ")");
    }
  }
}

function iterate(v: json.JsonValue): Outputs {
  return match (v) {
    json.JArray(items) => ok(items),
    json.JObject(o) => ok(o.values()),
    _ => fail("Cannot iterate over " + output.type_name(v) + " (" + output.shown(v) + ")"),
  };
}

function negate(v: json.JsonValue): Outputs {
  if let json.JNumber(t) = v {
    return one(json.JNumber(number.format(-number.value(t))));
  }
  return fail(output.type_name(v) + " (" + output.shown(v) + ") cannot be negated");
}

// The step `step` with a `?`: an error of the step itself gives no output.
// An error of the path before the step stays an error.
function run_guarded(step: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  match (step) {
    filter.Index(target, key) => {
      return run_index(target, key, input, e, true, k, st);
    },
    filter.Slice(target, from, to) => {
      return run_slice(target, from, to, input, e, true, k, st);
    },
    filter.Iterate(target) => {
      return run(target, input, e, (v: json.JsonValue, own s: St): own St => iterate_to(v, true, k, s), st);
    },
    _ => {
      let s = run(step, input, e, escaping(k), st);
      if (caught(s)) {
        return St { ...s, sig: OK, err: json.JNull };
      }
      return unescaped(s);
    }
  }
}

// The result of one step: its value to `k`, or its error. With `guard`, the
// error gives no output.
function step_to(o: Outputs, guard: boolean, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (o.failed() && guard) {
    return st;
  }
  return give(o, k, st);
}

// jq takes each key, and then each target.
function run_index(target: filter.Ast, key: filter.Ast, input: json.JsonValue, e: Env, guard: boolean, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if let filter.Literal(kv) = key {
    if let filter.Identity = target {
      return step_to(index(input, kv), guard, k, st);
    }
    return run(target, input, e, (t: json.JsonValue, own s: St): own St => step_to(index(t, kv), guard, k, s), st);
  }
  return run(key, input, e, (kv: json.JsonValue, own s: St): own St => run(target, input, e, (t: json.JsonValue, own s2: St): own St => step_to(index(t, kv), guard, k, s2), s), st);
}

// jq takes each end, then each start, then each target.
function run_slice(target: filter.Ast, from: filter.Ast, to: filter.Ast, input: json.JsonValue, e: Env, guard: boolean, k: (json.JsonValue, own St) => own St, own st: St): own St {
  return run(to, input, e, (t: json.JsonValue, own s: St): own St => run(from, input, e, (fv: json.JsonValue, own s2: St): own St => run(target, input, e, (x: json.JsonValue, own s3: St): own St => step_to(slice(x, fv, t), guard, k, s3), s2), s), st);
}

function build_object(keys: filter.Ast[], values: filter.Ast[], at: i32, names: string[], items: json.JsonValue[], input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (at == keys.len()) {
    return k(json.JObject(object_of(names, items)), st);
  }
  return run(keys[at], input, e, (kv: json.JsonValue, own s: St): own St => object_entry(keys, values, at, names, items, kv, input, e, k, s), st);
}

// The values of an entry come first in an array when they are single, as the
// right side of an operator does.
function object_entry(keys: filter.Ast[], values: filter.Ast[], at: i32, names: string[], items: json.JsonValue[], kv: json.JsonValue, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let json.JString(name) = kv else {
    return failed_with(st, "Cannot use " + output.type_name(kv) + " (" + output.shown(kv) + ") as object key");
  };
  if (!single(values[at], e)) {
    return run(values[at], input, e, (v: json.JsonValue, own s: St): own St => build_object(keys, values, at + 1, names.append(name), items.append(v), input, e, k, s), st);
  }
  let saved = st.items;
  let c = collected(values[at], input, e, st);
  let vs = c.items;
  let s = St { ...c, items: saved };
  if (s.sig != OK) {
    return s;
  }
  for v in vs {
    s = build_object(keys, values, at + 1, names.append(name), items.append(v), input, e, k, s);
    if (s.sig != OK) {
      return s;
    }
  }
  return s;
}

// jq takes each right value, and then each left value. A single right value
// comes first: then the frames of the right side are gone while the left
// side runs, and a function that calls itself on each side, as `fib` does,
// needs a stack in proportion to its depth only.
function run_binary(op: string, a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if let filter.Literal(r) = b {
    return run(a, input, e, (l: json.JsonValue, own s: St): own St => give(binary(op, l, r), k, s), st);
  }
  if (!single(b, e)) {
    return run(b, input, e, (r: json.JsonValue, own s: St): own St => run(a, input, e, (l: json.JsonValue, own s2: St): own St => give(binary(op, l, r), k, s2), s), st);
  }
  let saved = st.items;
  let c = collected(b, input, e, st);
  let rights = c.items;
  let s = St { ...c, items: saved };
  if (s.sig != OK) {
    return s;
  }
  for r in rights {
    s = run(a, input, e, (l: json.JsonValue, own s1: St): own St => give(binary(op, l, r), k, s1), s);
    if (s.sig != OK) {
      return s;
    }
  }
  return s;
}

// `a and b` is false for a false left value and takes each right value
// otherwise. `a or b` is true for a true left value.
function run_logic(is_or: boolean, a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  return run(a, input, e, (l: json.JsonValue, own s: St): own St => logic_right(is_or, l, b, input, e, k, s), st);
}

function logic_right(is_or: boolean, l: json.JsonValue, b: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (truthy(l) == is_or) {
    return k(json.JBool(is_or), st);
  }
  return run(b, input, e, (r: json.JsonValue, own s: St): own St => k(json.JBool(truthy(r)), s), st);
}

// `a // b` gives the values of `a` that are not false or null, and the values
// of `b` when `a` has none. The top of the stack says whether `a` gave one.
function run_alt(a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let depth = st.stack.len();
  let s = run(a, input, e, (v: json.JsonValue, own s1: St): own St => alt_out(v, depth, k, s1), St { ...st, stack: st.stack.append(json.JBool(false)) });
  let gave = truthy(s.stack[depth]);
  let t = St { ...s, stack: s.stack.truncate(depth) };
  if (t.sig != OK || gave) {
    return t;
  }
  return run(b, input, e, k, t);
}

function alt_out(v: json.JsonValue, depth: i32, k: (json.JsonValue, own St) => own St, own s: St): own St {
  if (!truthy(v)) {
    return s;
  }
  return k(v, St { ...s, stack: s.stack.with(depth, json.JBool(true)) });
}

// The state after an update is its last output, or null when it has none.
// A `reduce` gives the last state.
function reduce_from(source: filter.Ast, name: string, update: filter.Ast, first: json.JsonValue, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let saved = st.v;
  let s = run(source, input, e, (x: json.JsonValue, own s1: St): own St => reduce_step(update, name, x, e, s1), St { ...st, v: first });
  let acc = s.v;
  let t = St { ...s, v: saved };
  if (t.sig != OK) {
    return t;
  }
  return k(acc, t);
}

function reduce_step(update: filter.Ast, name: string, x: json.JsonValue, e: Env, own s: St): own St {
  let acc = s.v;
  return run(update, acc, e.with(name, x), set_v, St { ...s, v: json.JNull });
}

function set_v(v: json.JsonValue, own s: St): own St {
  return St { ...s, v: v };
}

// A `foreach` keeps its state on the stack, and gives the extract of each
// output of the update.
function foreach_from(source: filter.Ast, name: string, update: filter.Ast, extract: filter.Ast, first: json.JsonValue, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let depth = st.stack.len();
  let s = run(source, input, e, (x: json.JsonValue, own s1: St): own St => foreach_step(update, extract, name, x, depth, e, k, s1), St { ...st, stack: st.stack.append(first) });
  return St { ...s, stack: s.stack.truncate(depth) };
}

function foreach_step(update: filter.Ast, extract: filter.Ast, name: string, x: json.JsonValue, depth: i32, e: Env, k: (json.JsonValue, own St) => own St, own s: St): own St {
  let acc = s.stack[depth];
  let scope = e.with(name, x);
  return run(update, acc, scope, (u: json.JsonValue, own s1: St): own St => run(extract, u, scope, k, St { ...s1, stack: s1.stack.with(depth, u) }), St { ...s, stack: s.stack.with(depth, json.JNull) });
}

// ---- Functions ----

function call(name: string, args: filter.Ast[], input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (args.len() == 0) {
    return call0(name, input, e, k, st);
  }
  if (args.len() == 1) {
    return call1(name, args[0], input, e, k, st);
  }
  return call_many(name, args, input, e, k, st);
}

// The functions with no arguments that need the run: generators, input and
// output.
function call0(name: string, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  match (name) {
    "empty" => {
      return st;
    },
    "error" => {
      return raised(st, input);
    },
    "recurse" => {
      return recurse_all(input, k, st);
    },
    "paths" => {
      return paths_to(input, [], k, st);
    },
    "input" => {
      return read_input(k, st);
    },
    "inputs" => {
      return read_inputs(k, st);
    },
    "debug" => {
      if (!quiet(e)) {
        eprint("[\"DEBUG:\"," + output.compact(input) + "]");
      }
      return k(input, st);
    },
    "stderr" => {
      if (quiet(e)) {
        return k(input, st);
      }
      if let json.JString(s) = input {
        eprint_raw(s);
      } else {
        eprint_raw(output.compact(input));
      }
      return k(input, st);
    },
    "input_line_number" => {
      return k(whole(st.io.line()), st);
    },
    "input_filename" => {
      return k(st.io.filename(), st);
    },
    "get_search_list" => {
      return give(lookup(e, "*search"), k, st);
    },
    "get_jq_origin" => {
      return attribute(e, "*jq_origin", k, st);
    },
    "get_prog_origin" => {
      return attribute(e, "*prog_origin", k, st);
    },
    "modulemeta" => {
      return give(module_meta(input, e), k, st);
    },
    "halt" => {
      return St { ...st, sig: HALT, code: 0 };
    },
    "from_entries" => {
      return entries_to(input, k, st);
    },
    "halt_error" => {
      return halt_with(input, json.JNumber("5"), quiet(e), st);
    },
    _ => {
      return give(value0(name, input), k, st);
    }
  }
}

// The functions with one argument that need the run.
function call1(name: string, arg: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  match (name) {
    "select" => {
      return run(arg, input, e, (c: json.JsonValue, own s: St): own St => if (truthy(c)) { k(input, s) } else { s }, st);
    },
    "map" => {
      return run_collect(filter.Pipe(filter.Iterate(filter.Identity), arg), input, e, k, st);
    },
    "recurse" => {
      return recurse_to(input, arg, [], e, k, st);
    },
    "path" => {
      return run_paths(arg, root(input), e, (it: PathItem, own s: St): own St => path_out(it, k, s), st);
    },
    "paths" => {
      return paths_to(input, [], (p: json.JsonValue, own s: St): own St => paths_select(p, input, arg, e, k, s), st);
    },
    "del" => {
      return run_del(arg, input, e, k, st);
    },
    "map_values" => {
      return run_update("|=", filter.Iterate(filter.Identity), arg, input, e, k, st);
    },
    "with_entries" => {
      return give(to_entries(input), (entries: json.JsonValue, own s: St): own St => run_collect(filter.Pipe(filter.Iterate(filter.Identity), arg), entries, e, (mapped: json.JsonValue, own s2: St): own St => entries_to(mapped, k, s2), s), st);
    },
    "walk" => {
      return walk(input, arg, e, k, st);
    },
    "first" => {
      let (id, s) = new_label(st);
      return ended(id, run(arg, input, e, (v: json.JsonValue, own s1: St): own St => then_break(k(v, s1), id), s));
    },
    "last" => {
      return last_of(arg, input, e, k, st);
    },
    "isempty" => {
      return is_empty(arg, input, e, k, st);
    },
    "any" => {
      return quantify(true, filter.Iterate(filter.Identity), arg, input, e, k, st);
    },
    "all" => {
      return quantify(false, filter.Iterate(filter.Identity), arg, input, e, k, st);
    },
    "repeat" => {
      return repeat_to(input, arg, e, k, st);
    },
    "range" => {
      return run(arg, input, e, (t: json.JsonValue, own s: St): own St => count_to(whole(0), t, k, s), st);
    },
    "sort_by" => {
      return keyed("sort", arg, input, e, k, st);
    },
    "group_by" => {
      return keyed("group", arg, input, e, k, st);
    },
    "unique_by" => {
      return keyed("unique", arg, input, e, k, st);
    },
    "min_by" => {
      return keyed("min", arg, input, e, k, st);
    },
    "max_by" => {
      return keyed("max", arg, input, e, k, st);
    },
    "error" => {
      return run(arg, input, e, (v: json.JsonValue, own s: St): own St => raised(s, v), st);
    },
    "halt_error" => {
      return run(arg, input, e, (c: json.JsonValue, own s: St): own St => halt_with(input, c, quiet(e), s), st);
    },
    _ => {
      return run(arg, input, e, (a: json.JsonValue, own s: St): own St => give(value1(name, input, a), k, s), st);
    }
  }
}

function call_many(name: string, args: filter.Ast[], input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  match (name) {
    "recurse" => {
      return recurse_to(input, args[0], [args[1]], e, k, st);
    },
    "range" => {
      return run(args[0], input, e, (f: json.JsonValue, own s: St): own St => range_from(f, args, input, e, k, s), st);
    },
    "limit" => {
      return run(args[0], input, e, (n: json.JsonValue, own s: St): own St => limit_to(n, args[1], input, e, k, s), st);
    },
    "nth" => {
      return run(args[0], input, e, (n: json.JsonValue, own s: St): own St => nth_to(n, args[1], input, e, k, s), st);
    },
    "any" => {
      return quantify(true, args[0], args[1], input, e, k, st);
    },
    "all" => {
      return quantify(false, args[0], args[1], input, e, k, st);
    },
    "while" => {
      return while_to(input, args[0], args[1], e, k, st);
    },
    "until" => {
      return until_to(input, args[0], args[1], e, k, st);
    },
    "setpath" => {
      return run(args[1], input, e, (x: json.JsonValue, own s: St): own St => run(args[0], input, e, (p: json.JsonValue, own s2: St): own St => give(setpath_value(input, p, x), k, s2), s), st);
    },
    "_match_impl" => {
      return run(args[2], input, e, (t: json.JsonValue, own s: St): own St => run(args[1], input, e, (m: json.JsonValue, own s2: St): own St => run(args[0], input, e, (re: json.JsonValue, own s3: St): own St => give(match_impl(input, re, m, t), k, s3), s2), s), st);
    },
    _ => {
      if (args.len() == 2) {
        return run(args[1], input, e, (b: json.JsonValue, own s: St): own St => run(args[0], input, e, (a: json.JsonValue, own s2: St): own St => give(value2(name, input, a, b), k, s2), s), st);
      }
      return run(args[2], input, e, (c: json.JsonValue, own s: St): own St => run(args[1], input, e, (b: json.JsonValue, own s2: St): own St => run(args[0], input, e, (a: json.JsonValue, own s3: St): own St => give(value3(name, input, a, b, c), k, s3), s2), s), st);
    }
  }
}

// `from_entries`. Its definition in jq ends in `. //= {}`, which takes a
// label number.
function entries_to(v: json.JsonValue, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let o = from_entries(v);
  if (o.failed()) {
    return raised(st, o.error[0]);
  }
  return give(o, k, St { ...st, labels: st.labels + 1 });
}

// The state after an output of `first`: the output ends the label `id`.
function then_break(own s: St, id: i32): own St {
  if (s.sig != OK) {
    return s;
  }
  return broken(s, id);
}

// `last(f)` is `reduce f as $x (null; $x)`.
function last_of(f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let saved = st.v;
  let s = run(f, input, e, set_v, St { ...st, v: json.JNull });
  let v = s.v;
  let t = St { ...s, v: saved };
  if (t.sig != OK) {
    return t;
  }
  return k(v, t);
}

// `isempty(g)` is `first((g | false), true)`.
function is_empty(g: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let (id, s) = new_label(st);
  let t = run(g, input, e, (v: json.JsonValue, own s1: St): own St => then_break(k(json.JBool(false), s1), id), s);
  if (t.sig == BREAK && t.brk == id) {
    return St { ...t, sig: OK };
  }
  if (t.sig != OK) {
    return t;
  }
  return k(json.JBool(true), t);
}

// `any(g; c)` and `all(g; c)`: the first output of `c` that decides the answer
// stops `g`.
function quantify(is_any: boolean, g: filter.Ast, cond: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let (id, s) = new_label(st);
  let t = run(g, input, e, (v: json.JsonValue, own s1: St): own St => run(cond, v, e, (c: json.JsonValue, own s2: St): own St => if (truthy(c) == is_any) { broken(s2, id) } else { s2 }, s1), s);
  if (t.sig == BREAK && t.brk == id) {
    return k(json.JBool(is_any), St { ...t, sig: OK });
  }
  if (t.sig != OK) {
    return t;
  }
  return k(json.JBool(!is_any), t);
}

// `v`, and then the same for each output of `f` on `v`. With a condition,
// an output goes on one time for each true value of the condition.
function recurse_to(v: json.JsonValue, f: filter.Ast, conds: filter.Ast[], e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let s = k(v, st);
  if (s.sig != OK) {
    return s;
  }
  if (conds.len() == 0) {
    return run(f, v, e, (x: json.JsonValue, own s1: St): own St => recurse_to(x, f, conds, e, k, s1), s);
  }
  return run(f, v, e, (x: json.JsonValue, own s1: St): own St => run(conds[0], x, e, (c: json.JsonValue, own s2: St): own St => if (truthy(c)) { recurse_to(x, f, conds, e, k, s2) } else { s2 }, s1), s);
}

// `recurse` with no argument: `v`, and then each value inside it.
function recurse_all(v: json.JsonValue, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let s = k(v, st);
  if (s.sig != OK) {
    return s;
  }
  match (v) {
    json.JArray(items) => {
      for x in items {
        s = recurse_all(x, k, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    json.JObject(o) => {
      for x in o.values() {
        s = recurse_all(x, k, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    _ => {
      return s;
    }
  }
}

// `paths`: the path to each value inside `v`, as `path(..)` gives it with
// no empty path.
function paths_to(v: json.JsonValue, at: json.JsonValue[], k: (json.JsonValue, own St) => own St, own st: St): own St {
  let s = st;
  match (v) {
    json.JArray(items) => {
      for i in 0..items.len() {
        let p = at.append(whole(i));
        s = k(json.JArray(p), s);
        if (s.sig != OK) {
          return s;
        }
        s = paths_to(items[i], p, k, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    json.JObject(o) => {
      let names = o.keys();
      let values = o.values();
      for i in 0..names.len() {
        let p = at.append(json.JString(names[i]));
        s = k(json.JArray(p), s);
        if (s.sig != OK) {
          return s;
        }
        s = paths_to(values[i], p, k, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    _ => {
      return s;
    }
  }
}

// `paths(f)`: a path whose value gives a true output of `f`.
function paths_select(p: json.JsonValue, input: json.JsonValue, f: filter.Ast, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let json.JArray(keys) = p else {
    return st;
  };
  let v = getpath(input, keys, 0);
  if (v.failed()) {
    return raised(st, v.error[0]);
  }
  return run(f, v.values[0], e, (c: json.JsonValue, own s: St): own St => if (truthy(c)) { k(p, s) } else { s }, st);
}

// jq 1.7: `def _repeat: f, _repeat`, so `f` runs again on the same input
// until a signal stops it.
function repeat_to(v: json.JsonValue, f: filter.Ast, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let s = st;
  while (s.sig == OK) {
    s = run(f, v, e, k, s);
  }
  return s;
}

// jq 1.7: `def _while: if cond then ., (update | _while) else empty end`.
function while_to(v: json.JsonValue, cond: filter.Ast, update: filter.Ast, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  return run(cond, v, e, (c: json.JsonValue, own s: St): own St => while_body(v, c, cond, update, e, k, s), st);
}

function while_body(v: json.JsonValue, c: json.JsonValue, cond: filter.Ast, update: filter.Ast, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (!truthy(c)) {
    return st;
  }
  let s = k(v, st);
  if (s.sig != OK) {
    return s;
  }
  return run(update, v, e, (n: json.JsonValue, own s1: St): own St => while_to(n, cond, update, e, k, s1), s);
}

// jq 1.7: `def _until: if cond then . else (next | _until) end`. A single
// output of the condition and of `next` goes on in a loop.
function until_to(v: json.JsonValue, cond: filter.Ast, next: filter.Ast, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let cur = v;
  let s = st;
  while (true) {
    let saved = s.items;
    s = collected(cond, cur, e, s);
    let conds = s.items;
    s = St { ...s, items: saved };
    if (s.sig != OK) {
      return s;
    }
    if (conds.len() != 1) {
      for x in conds {
        s = until_branch(cur, x, cond, next, e, k, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    }
    if (truthy(conds[0])) {
      return k(cur, s);
    }
    let saved2 = s.items;
    s = collected(next, cur, e, s);
    let nexts = s.items;
    s = St { ...s, items: saved2 };
    if (s.sig != OK) {
      return s;
    }
    if (nexts.len() != 1) {
      for n in nexts {
        s = until_to(n, cond, next, e, k, s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    }
    cur = nexts[0];
  }
  return s;
}

function until_branch(v: json.JsonValue, c: json.JsonValue, cond: filter.Ast, next: filter.Ast, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (truthy(c)) {
    return k(v, st);
  }
  return run(next, v, e, (n: json.JsonValue, own s: St): own St => until_to(n, cond, next, e, k, s), st);
}

// jq takes each start, then each end, then each step.
function range_from(f: json.JsonValue, args: filter.Ast[], input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (args.len() == 2) {
    return run(args[1], input, e, (t: json.JsonValue, own s: St): own St => count_to(f, t, k, s), st);
  }
  return run(args[1], input, e, (t: json.JsonValue, own s: St): own St => run(args[2], input, e, (b: json.JsonValue, own s2: St): own St => steps_to(f, t, b, k, s2), s), st);
}

function count_to(from: json.JsonValue, upto: json.JsonValue, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let json.JNumber(f) = from else {
    return failed_with(st, "Range bounds must be numeric");
  };
  let json.JNumber(t) = upto else {
    return failed_with(st, "Range bounds must be numeric");
  };
  let x = number.value(f);
  let end = number.value(t);
  let s = st;
  while (x < end) {
    s = k(computed(x), s);
    if (s.sig != OK) {
      return s;
    }
    x += 1.0;
  }
  return s;
}

// `range(from; upto; by)` compares and adds as `<`, `>` and `+` do, so a
// bound that is not a number has the order of its type.
function steps_to(from: json.JsonValue, upto: json.JsonValue, by: json.JsonValue, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let direction = order(by, whole(0));
  if (direction == 0) {
    return st;
  }
  let x = from;
  let s = st;
  while (order(x, upto) * direction < 0) {
    s = k(x, s);
    if (s.sig != OK) {
      return s;
    }
    let next = add(x, by);
    if (next.failed()) {
      return raised(s, next.error[0]);
    }
    x = next.values[0];
  }
  return s;
}

// jq 1.7 counts down from `n` with `-`, and stops at 0 or less. A negative
// `n` gives each output. The count is on the stack.
function limit_to(n: json.JsonValue, f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let sign = order(n, whole(0));
  if (sign == 0) {
    return st;
  }
  if (sign < 0) {
    return run(f, input, e, k, st);
  }
  let (id, s) = new_label(st);
  let depth = s.stack.len();
  let t = run(f, input, e, (v: json.JsonValue, own s1: St): own St => limit_out(v, id, depth, k, s1), St { ...s, stack: s.stack.append(n) });
  return ended(id, St { ...t, stack: t.stack.truncate(depth) });
}

function limit_out(v: json.JsonValue, id: i32, depth: i32, k: (json.JsonValue, own St) => own St, own s: St): own St {
  let less = subtract(s.stack[depth], whole(1));
  if (less.failed()) {
    return raised(s, less.error[0]);
  }
  let left = less.values[0];
  let t = k(v, St { ...s, stack: s.stack.with(depth, left) });
  if (t.sig == OK && order(left, whole(0)) <= 0) {
    return broken(t, id);
  }
  return t;
}

// `nth(n; f)` counts down from `n + 1` with `-`, as jq 1.7 does, and gives
// the output at which the count is 0 or less.
function nth_to(n: json.JsonValue, f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (order(n, whole(0)) < 0) {
    return failed_with(st, "nth doesn't support negative indices");
  }
  let start = add(n, whole(1));
  if (start.failed()) {
    return raised(st, start.error[0]);
  }
  let (id, s) = new_label(st);
  let depth = s.stack.len();
  let t = run(f, input, e, (v: json.JsonValue, own s1: St): own St => nth_out(v, id, depth, k, s1), St { ...s, stack: s.stack.append(start.values[0]) });
  return ended(id, St { ...t, stack: t.stack.truncate(depth) });
}

function nth_out(v: json.JsonValue, id: i32, depth: i32, k: (json.JsonValue, own St) => own St, own s: St): own St {
  let less = subtract(s.stack[depth], whole(1));
  if (less.failed()) {
    return raised(s, less.error[0]);
  }
  let left = less.values[0];
  let t = St { ...s, stack: s.stack.with(depth, left) };
  if (order(left, whole(0)) > 0) {
    return t;
  }
  return then_break(k(v, t), id);
}

// `sort_by`, `group_by`, `unique_by`, `min_by` and `max_by`. The key of an
// item is the array of the outputs of `f` on it.
function keyed(what: string, f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let items = iterate(input);
  if (items.failed()) {
    return raised(st, items.error[0]);
  }
  let saved = st.items;
  let s = St { ...st, items: [] };
  let ks: json.JsonValue[] = [];
  for x in items.values {
    s = collected(f, x, e, s);
    if (s.sig != OK) {
      return St { ...s, items: saved };
    }
    ks = ks.append(json.JArray(s.items));
  }
  return give(by(what, input, items.values, ks), k, St { ...s, items: saved });
}

function walk(v: json.JsonValue, f: filter.Ast, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  match (v) {
    json.JObject(o) => {
      let names = o.keys();
      let values = o.values();
      let fields = json.object();
      let saved = st.items;
      let s = St { ...st, items: [] };
      for i in 0..names.len() {
        s = walk(values[i], f, e, append_item, St { ...s, items: [], labels: s.labels + 1 });
        if (s.sig != OK) {
          return St { ...s, items: saved };
        }
        if (s.items.len() > 0) {
          fields = fields.insert(names[i], s.items[0]);
        }
      }
      return run(f, json.JObject(fields), e, k, St { ...s, items: saved });
    },
    json.JArray(items) => {
      let saved = st.items;
      let s = St { ...st, items: [] };
      for x in items {
        s = walk(x, f, e, append_item, s);
        if (s.sig != OK) {
          return St { ...s, items: saved };
        }
      }
      let out = s.items;
      return run(f, json.JArray(out), e, k, St { ...s, items: saved });
    },
    _ => {
      return run(f, v, e, k, st);
    }
  }
}

// `halt_error` writes a string as it is and any other value as JSON with a
// newline, and stops with the exit status `code`. In `--run-tests`, jq has
// no callback for the messages, so `debug`, `stderr` and `halt_error` write
// nothing.
function halt_with(v: json.JsonValue, code: json.JsonValue, silent: boolean, own st: St): own St {
  let json.JNumber(t) = code else {
    return failed_with(st, "halt_error/1: number required");
  };
  if (silent) {
    return St { ...st, sig: HALT, code: number.value(t) as i32 };
  }
  if let json.JString(s) = v {
    eprint_raw(s);
  } else {
    eprint(output.compact(v));
  }
  return St { ...st, sig: HALT, code: number.value(t) as i32 };
}

function eprint_raw(s: string): void {
  let _ = stderr().write(s);
}

// `input` gives the next input, or the error "break" at the end.
function read_input(k: (json.JsonValue, own St) => own St, own st: St): own St {
  let (io, next) = st.io.next();
  let s = St { ...st, io: io };
  if (next.kind == stream.VALUE) {
    return k(next.value, s);
  }
  if (next.kind == stream.FAILED) {
    return failed_with(s, next.message);
  }
  return failed_with(s, "break");
}

function read_inputs(k: (json.JsonValue, own St) => own St, own st: St): own St {
  let s = st;
  while (true) {
    let (io, next) = s.io.next();
    s = St { ...s, io: io };
    if (next.kind == stream.VALUE) {
      s = k(next.value, s);
      if (s.sig != OK) {
        return s;
      }
    } else if (next.kind == stream.FAILED) {
      return failed_with(s, next.message);
    } else {
      return s;
    }
  }
  return s;
}

// ---- Functions of values ----

// The functions of the input alone.
function value0(name: string, v: json.JsonValue): Outputs {
  return match (name) {
    "not" => one(json.JBool(!truthy(v))),
    "type" => one(json.JString(output.type_name(v))),
    "length" => length(v),
    "keys" => keys(v, true),
    "keys_unsorted" => keys(v, false),
    "add" => sum(iterate(v)),
    "to_entries" => to_entries(v),
    "tostring" => one(to_string(v)),
    "tojson" => one(json.JString(output.compact(v))),
    "sort" => sort(v),
    "reverse" => reverse(v),
    "min" => extreme(v, true),
    "max" => extreme(v, false),
    "unique" => unique(v),
    "flatten" => flatten(v, whole(-1)),
    "any" => any_all(v, true),
    "all" => any_all(v, false),
    "first" => index(v, whole(0)),
    "last" => index(v, whole(-1)),
    _ => value0_text(name, v),
  };
}

function value0_text(name: string, v: json.JsonValue): Outputs {
  return match (name) {
    "ascii_downcase" => ascii_case(v, false),
    "ascii_upcase" => ascii_case(v, true),
    "explode" => explode(v),
    "implode" => implode(v),
    "fromjson" => from_json(v),
    "tonumber" => to_number(v),
    "utf8bytelength" => byte_length(v),
    "env" => one(environment()),
    "builtins" => one(json.JArray(texts(filter.functions()))),
    "now" => one(computed(now_unix_ms() as f64 / 1000.0)),
    "gmtime" => broken_down(name, v),
    "localtime" => broken_down(name, v),
    "mktime" => make_time(v),
    "nan" => one(computed(0.0 / 0.0)),
    "infinite" => one(computed(1.0 / 0.0)),
    "isnan" => one(json.JBool(number_is(name, v))),
    "isinfinite" => one(json.JBool(number_is(name, v))),
    "isnormal" => one(json.JBool(number_is(name, v))),
    _ => value0_number(name, v),
  };
}

function value0_number(name: string, v: json.JsonValue): Outputs {
  let selectors = ["values", "nulls", "scalars", "iterables", "arrays", "objects", "booleans", "numbers", "strings", "normals", "finites"];
  if (selectors.contains(name)) {
    return of_type(name, v);
  }
  if (name == "isfinite") {
    let json.JNumber(t) = v else {
      return one(json.JBool(false));
    };
    let x = number.value(t);
    return one(json.JBool(x == x && x.abs() <= 1.7976931348623157e308));
  }
  if (name == "pow10") {
    return fail("Error: pow10/0 not found at build time");
  }
  let (x, bad) = number_of(v);
  if (bad.failed()) {
    return bad;
  }
  if (name == "frexp" || name == "modf" || name == "lgamma_r") {
    return split_number(name, x);
  }

  return one(computed(math1(name, x)));
}

// The functions of the input and one argument value.
function value1(name: string, v: json.JsonValue, a: json.JsonValue): Outputs {
  return match (name) {
    "has" => has(v, a),
    "contains" => contains_checked(v, a),
    "inside" => contains_checked(a, v),
    "in" => has(a, v),
    "indices" => indices(v, a),
    "index" => index_of(v, a, false),
    "rindex" => index_of(v, a, true),
    "join" => join(v, a),
    "flatten" => flatten_checked(v, a),
    "getpath" => getpath_value(v, a),
    "delpaths" => delpaths(v, a),
    "nth" => index(v, a),
    "strftime" => strftime_value(name, v, a),
    "strflocaltime" => strftime_value(name, v, a),
    "strptime" => strptime_value(v, a),
    "format" => format_value(v, a),
    "ltrimstr" => text_function(name, v, a),
    "rtrimstr" => text_function(name, v, a),
    "startswith" => text_function(name, v, a),
    "endswith" => text_function(name, v, a),
    "split" => text_function(name, v, a),
    _ => fail(name + "/1 is not defined"),
  };
}

// The functions of the input and two argument values.
function value2(name: string, v: json.JsonValue, a: json.JsonValue, b: json.JsonValue): Outputs {
  let (x, bad_a) = number_of(a);
  if (bad_a.failed()) {
    return bad_a;
  }
  let (y, bad_b) = number_of(b);
  if (bad_b.failed()) {
    return bad_b;
  }
  return one(computed(math2(name, x, y)));
}

function value3(name: string, v: json.JsonValue, a: json.JsonValue, b: json.JsonValue, c: json.JsonValue): Outputs {
  let (x, bad_a) = number_of(a);
  if (bad_a.failed()) {
    return bad_a;
  }
  let (y, bad_b) = number_of(b);
  if (bad_b.failed()) {
    return bad_b;
  }
  let (z, bad_c) = number_of(c);
  if (bad_c.failed()) {
    return bad_c;
  }
  return one(computed(x.fma(y, z)));
}

// The environment of the process as an object.
pub function environment(): json.JsonValue {
  let o = json.object();
  for entry in environ() {
    let at = 0;
    while (at < entry.len() && entry[at] != b'=') {
      at += 1;
    }
    if (at < entry.len()) {
      o = o.insert(slice_unchecked(entry, 0, at).to_owned(), json.JString(slice_unchecked(entry, at + 1, entry.len()).to_owned()));
    }
  }
  return json.JObject(o);
}

function getpath_value(v: json.JsonValue, p: json.JsonValue): Outputs {
  let json.JArray(keys) = p else {
    return fail("Path must be specified as an array");
  };
  return getpath(v, keys, 0);
}

function setpath_value(v: json.JsonValue, p: json.JsonValue, x: json.JsonValue): Outputs {
  let json.JArray(keys) = p else {
    return fail("Path must be specified as an array");
  };
  return setpath(v, keys, 0, x);
}

function flatten_checked(v: json.JsonValue, depth: json.JsonValue): Outputs {
  if (order(depth, whole(0)) < 0) {
    return fail("flatten depth must not be negative");
  }
  return flatten(v, depth);
}

// `any` and `all` with no argument: the first item that decides stops.
function any_all(v: json.JsonValue, is_any: boolean): Outputs {
  let items = iterate(v);
  if (items.failed()) {
    return items;
  }
  for x in items.values {
    if (truthy(x) == is_any) {
      return one(json.JBool(is_any));
    }
  }
  return one(json.JBool(!is_any));
}

function unique(v: json.JsonValue): Outputs {
  let items = iterate(v);
  if (items.failed()) {
    return items;
  }
  let ks: json.JsonValue[] = [];
  for x in items.values {
    ks = ks.append(json.JArray([x]));
  }
  return by("unique", v, items.values, ks);
}

// `sort_by`, `group_by`, `unique_by`, `min_by` and `max_by` of the items with
// their keys `ks`.
function by(what: string, input: json.JsonValue, items: json.JsonValue[], ks: json.JsonValue[]): Outputs {
  let json.JArray(_) = input else {
    let both = output.type_name(input) + " (" + output.shown(input) + ") and array (" + output.shown(json.JArray(ks)) + ")";
    if (what == "min" || what == "max") {
      return fail(both + " cannot be iterated over");
    }
    return fail(both + " cannot be sorted, as they are not both arrays");
  };
  if (what == "min" || what == "max") {
    return one(extreme_by(items, ks, what == "min"));
  }
  return one(json.JArray(grouped(what, items, ks, sorted_indices(ks))));
}

function strftime_value(name: string, v: json.JsonValue, f: json.JsonValue): Outputs {
  let (t, bad) = time_input(name, v);
  if (bad.failed()) {
    return bad;
  }
  let json.JString(text) = f else {
    return fail(name + "/1 requires a string format");
  };
  let made = dates.strftime(text, t[0]);
  if (made.len() == 0) {
    return fail(name + "/1: unknown system failure");
  }
  return one(json.JString(made));
}

function strptime_value(v: json.JsonValue, f: json.JsonValue): Outputs {
  let json.JString(text) = v else {
    return fail("strptime/1 requires string inputs and arguments");
  };
  let json.JString(form) = f else {
    return fail("strptime/1 requires string inputs and arguments");
  };
  let (t, matched) = dates.strptime(text, form);
  if (!matched) {
    return fail("date " + output.compact(v) + " does not match format " + output.compact(f));
  }
  return one(tm_value(t, t.sec as f64));
}

// `format(name)` is `@name`.
function format_value(v: json.JsonValue, f: json.JsonValue): Outputs {
  let json.JString(name) = f else {
    return fail(output.type_name(f) + " (" + output.shown(f) + ") is not a valid format");
  };
  return format(name, v);
}

// ---- Paths ----

// A value that a path expression gave, and the path to it. `tracked` is the
// value that the path gives in the input. jq follows a path only from a value
// that is that same value, which `attached` says.
pub struct PathItem { path: json.JsonValue[], tracked: json.JsonValue, value: json.JsonValue, attached: boolean }

function root(v: json.JsonValue): PathItem {
  return PathItem { path: [], tracked: v, value: v, attached: true };
}

// The value as jq shows it in a message about a path: cut to 26 bytes and
// "..." when it is longer than 29.
function shown_long(v: json.JsonValue): string {
  let s = output.compact(v);
  if (s.len() > 29) {
    return slice_unchecked(s, 0, 26).to_owned() + "...";
  }
  return s;
}

function on_path(it: PathItem, key: json.JsonValue, v: json.JsonValue): PathItem {
  return PathItem { path: it.path.append(key), tracked: v, value: v, attached: true };
}

// A value that no path step gave. jq holds it to be the tracked value when it
// is the same null or boolean, or the same value through a variable.
function off_path(it: PathItem, v: json.JsonValue, through_variable: boolean): PathItem {
  let simple = match (v) {
    json.JNull => true,
    json.JBool(_) => true,
    _ => through_variable,
  };
  return PathItem { path: it.path, tracked: it.tracked, value: v, attached: simple && order(v, it.tracked) == 0 };
}

// The path of an output of `path(f)`.
function path_out(it: PathItem, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (!it.attached) {
    return failed_with(st, "Invalid path expression with result " + shown_long(it.value));
  }
  return k(json.JArray(it.path), st);
}

function append_found(it: PathItem, own s: St): own St {
  return St { ...s, found: s.found.append(it) };
}

// The paths that `f` gives on `input`, each as an array of its keys, in
// `items` of the state. The caller puts back its own `items` and `found`.
function paths_found(f: filter.Ast, input: json.JsonValue, e: Env, own st: St): own St {
  let s = run_paths(f, root(input), e, append_found, St { ...st, found: [] });
  let all: json.JsonValue[] = [];
  for it in s.found {
    if (s.sig == OK && !it.attached) {
      return failed_with(St { ...s, items: all }, "Invalid path expression with result " + shown_long(it.value));
    }
    all = all.append(json.JArray(it.path));
  }
  return St { ...s, items: all };
}

function pescaping(k: (PathItem, own St) => own St): (PathItem, own St) => own St {
  return (it: PathItem, own s: St): own St => escape_signal(k(it, s));
}

function run_paths(f: filter.Ast, it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  match (f) {
    filter.Identity => {
      return k(it, st);
    },
    filter.Index(target, key) => {
      return paths_index(target, key, it, e, false, k, st);
    },
    filter.Slice(target, from, to) => {
      return paths_slice(target, from, to, it, e, false, k, st);
    },
    filter.Iterate(target) => {
      return run_paths(target, it, e, (t: PathItem, own s: St): own St => path_iterate(t, false, k, s), st);
    },
    filter.Optional(step) => {
      return paths_guarded(step, it, e, k, st);
    },
    filter.Try(inner) => {
      let s = run_paths(inner, it, e, pescaping(k), st);
      if (caught(s)) {
        return St { ...s, sig: OK, err: json.JNull };
      }
      return unescaped(s);
    },
    filter.Pipe(a, b) => {
      return run_paths(a, it, e, (x: PathItem, own s: St): own St => run_paths(b, x, e, k, s), st);
    },
    filter.Comma(a, b) => {
      let s = run_paths(a, it, e, k, st);
      if (s.sig != OK) {
        return s;
      }
      return run_paths(b, it, e, k, s);
    },
    filter.If(cond, yes, no) => {
      return run(cond, it.value, e, (c: json.JsonValue, own s: St): own St => run_paths(if (truthy(c)) { yes } else { no }, it, e, k, s), st);
    },
    filter.Alt(a, b) => {
      return paths_alt(a, b, it, e, k, st);
    },
    filter.Bind(source, name, body) => {
      return run(source, it.value, e, (v: json.JsonValue, own s: St): own St => run_paths(body, it, e.with(name, v), k, s), st);
    },
    _ => {
      return paths_more(f, it, e, k, st);
    }
  }
}

function paths_more(f: filter.Ast, it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  match (f) {
    filter.Foreach(source, name, init, update, extract) => {
      return run(init, it.value, e, (first: json.JsonValue, own s: St): own St => paths_foreach(source, name, update, extract, first, it, e, k, s), st);
    },
    filter.Catch(body, handler) => {
      let s = run_paths(body, it, e, pescaping(k), st);
      if (caught(s)) {
        let err = caught_value(s);
        return run_paths(handler, off_path(it, err, false), e, k, St { ...s, sig: OK, err: json.JNull });
      }
      return unescaped(s);
    },
    filter.Call(name, args) => {
      let found = e.find(name, args.len());
      if (found.len() > 0) {
        return paths_defined(found[0], args, 0, it, e, callee_scope(found[0]), k, st);
      }
      return paths_call(name, args, it, e, k, st);
    },
    filter.Def(name, params, body, rest) => {
      return run_paths(rest, it, e.define(defined(name, params, body, e)), k, st);
    },
    filter.Label(name, body) => {
      let id = st.labels;
      return ended(id, run_paths(body, it, e.with(filter.label_var(name), whole(id)), k, St { ...st, labels: id + 1 }));
    },
    filter.Var(_) => {
      return paths_plain(f, it, e, true, k, st);
    },
    _ => {
      return paths_plain(f, it, e, false, k, st);
    }
  }
}

// A filter that makes no path step: each output is off the path.
function paths_plain(f: filter.Ast, it: PathItem, e: Env, through_variable: boolean, k: (PathItem, own St) => own St, own st: St): own St {
  return run(f, it.value, e, (v: json.JsonValue, own s: St): own St => k(off_path(it, v, through_variable), s), st);
}

function paths_guarded(step: filter.Ast, it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  match (step) {
    filter.Index(target, key) => {
      return paths_index(target, key, it, e, true, k, st);
    },
    filter.Slice(target, from, to) => {
      return paths_slice(target, from, to, it, e, true, k, st);
    },
    filter.Iterate(target) => {
      return run_paths(target, it, e, (t: PathItem, own s: St): own St => path_iterate(t, true, k, s), st);
    },
    _ => {
      let s = run_paths(step, it, e, pescaping(k), st);
      if (caught(s)) {
        return St { ...s, sig: OK, err: json.JNull };
      }
      return unescaped(s);
    }
  }
}

function path_iterate(it: PathItem, guard: boolean, k: (PathItem, own St) => own St, own st: St): own St {
  if (!it.attached) {
    return failed_with(st, "Invalid path expression near attempt to iterate through " + shown_long(it.value));
  }
  let s = st;
  match (it.value) {
    json.JArray(all) => {
      for i in 0..all.len() {
        s = k(on_path(it, whole(i), all[i]), s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    json.JObject(o) => {
      let names = o.keys();
      let values = o.values();
      for i in 0..names.len() {
        s = k(on_path(it, json.JString(names[i]), values[i]), s);
        if (s.sig != OK) {
          return s;
        }
      }
      return s;
    },
    _ => {
      if (guard) {
        return s;
      }
      return failed_with(s, "Cannot iterate over " + output.type_name(it.value) + " (" + output.shown(it.value) + ")");
    }
  }
}

// One step from `it` with the key `kv`. The value comes from `index`.
function path_step(it: PathItem, kv: json.JsonValue, guard: boolean, k: (PathItem, own St) => own St, own st: St): own St {
  if (!it.attached) {
    return failed_with(st, "Invalid path expression near attempt to access element " + output.shown(kv) + " of " + shown_long(it.value));
  }
  let v = index(it.value, kv);
  if (v.failed()) {
    if (guard) {
      return st;
    }
    return raised(st, v.error[0]);
  }
  return k(on_path(it, kv, v.values[0]), st);
}

function paths_index(target: filter.Ast, key: filter.Ast, it: PathItem, e: Env, guard: boolean, k: (PathItem, own St) => own St, own st: St): own St {
  return run(key, it.value, e, (kv: json.JsonValue, own s: St): own St => run_paths(target, it, e, (t: PathItem, own s2: St): own St => path_step(t, kv, guard, k, s2), s), st);
}

function paths_slice(target: filter.Ast, from: filter.Ast, to: filter.Ast, it: PathItem, e: Env, guard: boolean, k: (PathItem, own St) => own St, own st: St): own St {
  return run(to, it.value, e, (t: json.JsonValue, own s: St): own St => run(from, it.value, e, (fv: json.JsonValue, own s2: St): own St => run_paths(target, it, e, (x: PathItem, own s3: St): own St => path_step(x, json.JObject(json.object_of(["start", "end"], [fv, t])), guard, k, s3), s2), s), st);
}

function paths_alt(a: filter.Ast, b: filter.Ast, it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  let depth = st.stack.len();
  let s = run_paths(a, it, e, (x: PathItem, own s1: St): own St => if (truthy(x.value)) { k(x, St { ...s1, stack: s1.stack.with(depth, json.JBool(true)) }) } else { s1 }, St { ...st, stack: st.stack.append(json.JBool(false)) });
  let gave = truthy(s.stack[depth]);
  let t = St { ...s, stack: s.stack.truncate(depth) };
  if (t.sig != OK || gave) {
    return t;
  }
  return run_paths(b, it, e, k, t);
}

// jq keeps the value of the state of a `foreach` and not its path. Each
// update starts at the path of the `foreach` itself.
function paths_foreach(source: filter.Ast, name: string, update: filter.Ast, extract: filter.Ast, first: json.JsonValue, it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  let depth = st.stack.len();
  let s = run(source, it.value, e, (x: json.JsonValue, own s1: St): own St => paths_foreach_step(update, extract, name, x, depth, it, e, k, s1), St { ...st, stack: st.stack.append(first) });
  return St { ...s, stack: s.stack.truncate(depth) };
}

function paths_foreach_step(update: filter.Ast, extract: filter.Ast, name: string, x: json.JsonValue, depth: i32, it: PathItem, e: Env, k: (PathItem, own St) => own St, own s: St): own St {
  let acc = s.stack[depth];
  let scope = e.with(name, x);
  return run_paths(update, off_path(it, acc, true), scope, (u: PathItem, own s1: St): own St => run_paths(extract, u, scope, k, St { ...s1, stack: s1.stack.with(depth, u.value) }), St { ...s, stack: s.stack.with(depth, json.JNull) });
}

// The functions that keep a path. Each other function gives values that are
// off the path.
function paths_call(name: string, args: filter.Ast[], it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  let key = name + "/" + args.len().to_string();
  match (key) {
    "empty/0" => {
      return st;
    },
    "select/1" => {
      return run(args[0], it.value, e, (c: json.JsonValue, own s: St): own St => if (truthy(c)) { k(it, s) } else { s }, st);
    },
    "recurse/0" => {
      return paths_recurse(it, filter.Optional(filter.Iterate(filter.Identity)), [], e, k, st);
    },
    "recurse/1" => {
      return paths_recurse(it, args[0], [], e, k, st);
    },
    "recurse/2" => {
      return paths_recurse(it, args[0], [args[1]], e, k, st);
    },
    "first/0" => {
      return path_step(it, whole(0), false, k, st);
    },
    "last/0" => {
      return path_step(it, whole(-1), false, k, st);
    },
    "first/1" => {
      return paths_limit(whole(1), args[0], it, e, k, st);
    },
    "limit/2" => {
      return run(args[0], it.value, e, (n: json.JsonValue, own s: St): own St => paths_limit(n, args[1], it, e, k, s), st);
    },
    "nth/1" => {
      return paths_index(filter.Identity, args[0], it, e, false, k, st);
    },
    "getpath/1" => {
      return run(args[0], it.value, e, (p: json.JsonValue, own s: St): own St => paths_getpath(p, it, k, s), st);
    },
    _ => {
      return paths_other(name, args, it, e, k, st);
    }
  }
}

// A selector by type keeps the path. Each other function is off the path.
function paths_other(name: string, args: filter.Ast[], it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  let selectors = ["values", "nulls", "scalars", "iterables", "arrays", "objects", "booleans", "numbers", "strings"];
  if (args.len() == 0 && selectors.contains(name)) {
    if (of_type(name, it.value).values.len() > 0) {
      return k(it, st);
    }
    return st;
  }
  return paths_plain(filter.Call(name, args), it, e, false, k, st);
}

function paths_recurse(it: PathItem, f: filter.Ast, conds: filter.Ast[], e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  let s = k(it, st);
  if (s.sig != OK) {
    return s;
  }
  if (conds.len() == 0) {
    return run_paths(f, it, e, (x: PathItem, own s1: St): own St => paths_recurse(x, f, conds, e, k, s1), s);
  }
  return run_paths(f, it, e, (x: PathItem, own s1: St): own St => run(conds[0], x.value, e, (c: json.JsonValue, own s2: St): own St => if (truthy(c)) { paths_recurse(x, f, conds, e, k, s2) } else { s2 }, s1), s);
}

function paths_limit(n: json.JsonValue, f: filter.Ast, it: PathItem, e: Env, k: (PathItem, own St) => own St, own st: St): own St {
  let sign = order(n, whole(0));
  if (sign == 0) {
    return st;
  }
  if (sign < 0) {
    return run_paths(f, it, e, k, st);
  }
  let (id, s) = new_label(st);
  let depth = s.stack.len();
  let t = run_paths(f, it, e, (x: PathItem, own s1: St): own St => paths_limit_out(x, id, depth, k, s1), St { ...s, stack: s.stack.append(n) });
  return ended(id, St { ...t, stack: t.stack.truncate(depth) });
}

function paths_limit_out(x: PathItem, id: i32, depth: i32, k: (PathItem, own St) => own St, own s: St): own St {
  let less = subtract(s.stack[depth], whole(1));
  if (less.failed()) {
    return raised(s, less.error[0]);
  }
  let left = less.values[0];
  let t = k(x, St { ...s, stack: s.stack.with(depth, left) });
  if (t.sig == OK && order(left, whole(0)) <= 0) {
    return broken(t, id);
  }
  return t;
}

function paths_getpath(p: json.JsonValue, it: PathItem, k: (PathItem, own St) => own St, own st: St): own St {
  let json.JArray(keys) = p else {
    return failed_with(st, "Path must be specified as an array");
  };
  let v = getpath(it.value, keys, 0);
  if (v.failed()) {
    return raised(st, v.error[0]);
  }
  return k(PathItem { path: it.path.concat(keys), tracked: v.values[0], value: v.values[0], attached: it.attached }, st);
}

// ---- Deletes and updates ----

function run_del(f: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let saved = st.items;
  let saved_found = st.found;
  let s = paths_found(f, input, e, st);
  let ps = s.items;
  let t = St { ...s, items: saved, found: saved_found };
  if (t.sig != OK) {
    return t;
  }
  return give(delpaths(input, json.JArray(ps)), k, t);
}

// `target = value` sets each path of `target` to each output of `value`.
// The other operators change the value at each path: `|=` with a filter, and
// `+=` and the others with the operator and each output of `value`.
function run_update(op: string, target: filter.Ast, value: filter.Ast, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (op == "|=") {
    return modify(op, target, value, json.JNull, input, e, k, st);
  }
  return run(value, input, e, (x: json.JsonValue, own s: St): own St => modify(op, target, value, x, input, e, k, s), st);
}

// The value of an update. `|=` takes the first output of the filter, and no
// output deletes the path.
function modify(op: string, target: filter.Ast, f: filter.Ast, x: json.JsonValue, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let saved = st.items;
  let saved_found = st.found;
  let s = paths_found(target, input, e, st);
  let ps = s.items;
  s = St { ...s, found: saved_found };
  if (s.sig != OK) {
    return St { ...s, items: saved };
  }
  let out = input;
  let gone: json.JsonValue[] = [];
  for p in ps {
    let json.JArray(keys) = p else {
      continue;
    };
    if (op == "=") {
      let next = setpath(out, keys, 0, x);
      if (next.failed()) {
        return raised(St { ...s, items: saved }, next.error[0]);
      }
      out = next.values[0];
      continue;
    }
    let old = getpath(out, keys, 0);
    if (old.failed()) {
      return raised(St { ...s, items: saved }, old.error[0]);
    }
    let news: json.JsonValue[] = [];
    if (op == "|=") {
      s = first_output(f, old.values[0], e, s);
      if (s.sig != OK) {
        return St { ...s, items: saved };
      }
      news = s.items;
    } else {
      s = St { ...s, labels: s.labels + 1 };
      let o = updated(op, x, old.values[0]);
      if (o.failed()) {
        return raised(St { ...s, items: saved }, o.error[0]);
      }
      news = o.values;
    }
    if (news.len() == 0) {
      gone = gone.append(p);
      continue;
    }
    let next = setpath(out, keys, 0, news[0]);
    if (next.failed()) {
      return raised(St { ...s, items: saved }, next.error[0]);
    }
    out = next.values[0];
  }
  return give(delpaths(out, json.JArray(gone)), k, St { ...s, items: saved });
}

// The first output of `f` on `v`, alone in `items`.
function first_output(f: filter.Ast, v: json.JsonValue, e: Env, own st: St): own St {
  let (id, s) = new_label(st);
  return ended(id, run(f, v, e, (x: json.JsonValue, own s1: St): own St => broken(St { ...s1, items: [x] }, id), St { ...s, items: [] }));
}

function updated(op: string, x: json.JsonValue, v: json.JsonValue): Outputs {
  if (op == "//") {
    return if (truthy(v)) { one(v) } else { one(x) };
  }
  return binary(op, v, x);
}

// ---- Functions of a `def` ----

// The environment for the body of `f`, before its parameters. A function
// sees itself, so that it can call itself.
function callee_scope(f: Func): Env {
  let scope = f.scope[0];
  if (f.argument) {
    return scope;
  }
  return scope.define(Func { ...f, name: f.own_name });
}

// The outputs of the body of `f` with its parameters from `at` bound in
// `scope`. A parameter is the argument as a filter of the caller. A `$`
// parameter is a variable for each output of the argument also, and jq takes
// each value of an earlier parameter first.
function call_defined(f: Func, args: filter.Ast[], at: i32, input: json.JsonValue, e: Env, scope: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (at == args.len()) {
    return run(f.body, input, scope, k, st);
  }
  let name = filter.param_name(f.params[at]);
  let bound = scope.define(Func { name: name, own_name: name, params: [], body: args[at], scope: [e], argument: true, single: false });
  if (name == f.params[at]) {
    return call_defined(f, args, at + 1, input, e, bound, k, st);
  }
  return each_of(args[at], input, e, (v: json.JsonValue, own s: St): own St => call_defined(f, args, at + 1, input, e, bound.with(name, v), k, s), st);
}

function paths_defined(f: Func, args: filter.Ast[], at: i32, it: PathItem, e: Env, scope: Env, k: (PathItem, own St) => own St, own st: St): own St {
  if (at == args.len()) {
    return run_paths(f.body, it, scope, k, st);
  }
  let name = filter.param_name(f.params[at]);
  let bound = scope.define(Func { name: name, own_name: name, params: [], body: args[at], scope: [e], argument: true, single: false });
  if (name == f.params[at]) {
    return paths_defined(f, args, at + 1, it, e, bound, k, st);
  }
  return run(args[at], it.value, e, (v: json.JsonValue, own s: St): own St => paths_defined(f, args, at + 1, it, e, bound.with(name, v), k, s), st);
}

// ---- String interpolation ----

// The strings of a literal with interpolations. `tail` is the text after the
// part `at`. jq takes each value of a later part, and then each value of the
// part before it.
function interpolate(name: string, texts: string[], parts: filter.Ast[], at: i32, tail: string, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  if (at < 0) {
    return k(json.JString(tail), st);
  }
  return run(parts[at], input, e, (v: json.JsonValue, own s: St): own St => interpolate_part(name, texts, parts, at, tail, v, input, e, k, s), st);
}

function interpolate_part(name: string, texts: string[], parts: filter.Ast[], at: i32, tail: string, v: json.JsonValue, input: json.JsonValue, e: Env, k: (json.JsonValue, own St) => own St, own st: St): own St {
  let f = format(name, v);
  if (f.failed()) {
    return raised(st, f.error[0]);
  }
  let json.JString(piece) = f.values[0] else {
    return st;
  };
  return interpolate(name, texts, parts, at - 1, texts[at] + piece + tail, input, e, k, st);
}

// ---- Numbers ----

// A math function of one number.
function math1(name: string, x: f64): f64 {
  return match (name) {
    "floor" => x.floor(),
    "ceil" => x.ceil(),
    "round" => x.round(),
    "trunc" => x.trunc(),
    "fabs" => x.abs(),
    "sqrt" => x.sqrt(),
    "exp" => x.exp(),
    "log" => x.log(),
    "log2" => x.log2(),
    "log10" => x.log10(),
    "exp2" => x.exp2(),
    "exp10" => x.exp10(),
    "nearbyint" => x.rint(),
    "rint" => x.rint(),
    "logb" => x.logb(),
    "significand" => x.significand(),
    _ => circular(name, x),
  };
}

function circular(name: string, x: f64): f64 {
  return match (name) {
    "sin" => x.sin(),
    "cos" => x.cos(),
    "tan" => x.tan(),
    "asin" => x.asin(),
    "acos" => x.acos(),
    "atan" => x.atan(),
    "sinh" => x.sinh(),
    "cosh" => x.cosh(),
    "tanh" => x.tanh(),
    "asinh" => x.asinh(),
    "acosh" => x.acosh(),
    "atanh" => x.atanh(),
    "cbrt" => x.cbrt(),
    "log1p" => x.log1p(),
    "expm1" => x.expm1(),
    _ => special(name, x),
  };
}

function special(name: string, x: f64): f64 {
  return match (name) {
    "erf" => x.erf(),
    "erfc" => x.erfc(),
    "gamma" => x.lgamma(),
    "lgamma" => x.lgamma(),
    "tgamma" => x.tgamma(),
    "j0" => x.j0(),
    "j1" => x.j1(),
    "y0" => x.y0(),
    _ => x.y1(),
  };
}

// The int of C for a double: the whole part, held to the range of an i32.
function c_int(x: f64): i32 {
  if (x != x || x >= 2147483648.0 || x < -2147483648.0) {
    return -2147483647 - 1;
  }
  return x as i32;
}

// A math function of two numbers.
function math2(name: string, x: f64, y: f64): f64 {
  return match (name) {
    "pow" => x.pow(y),
    "atan2" => x.atan2(y),
    "fmod" => x.fmod(y),
    "remainder" => x.remainder(y),
    "drem" => x.remainder(y),
    "fdim" => x.fdim(y),
    "fmax" => x.fmax(y),
    "fmin" => x.fmin(y),
    "copysign" => x.copysign(y),
    "nextafter" => x.nextafter(y),
    "nexttoward" => x.nextafter(y),
    "hypot" => x.hypot(y),
    "ldexp" => x.scalbn(c_int(y)),
    "scalbln" => x.scalbn(c_int(y)),
    "scalb" => if (y == y.trunc() || y != y) { x.scalbn(c_int(y)) } else { 0.0 / 0.0 },
    "jn" => y.jn(c_int(x)),
    _ => y.yn(c_int(x)),
  };
}

// `frexp`, `modf` and `lgamma_r`, which give two numbers.
function split_number(name: string, x: f64): Outputs {
  if (name == "frexp") {
    let (f, e) = x.frexp();
    return one(json.JArray([computed(f), whole(e)]));
  }
  if (name == "modf") {
    let (f, w) = x.modf();
    return one(json.JArray([computed(f), computed(w)]));
  }
  let (v, sign) = x.lgamma_r();
  return one(json.JArray([computed(v), whole(sign)]));
}

// ---- Programs and modules ----

// `e` with each function of the definitions `defs`, which end in `.`.
function define_all(e: Env, defs: filter.Ast): Env {
  let out = e;
  let at = defs;
  while (true) {
    let filter.Def(name, params, body, rest) = at else {
      return out;
    };
    out = out.define(defined(name, params, body, out));
    at = rest;
  }
  return out;
}

// `e` with each dependency of `deps`. `own` holds the functions of each
// module. An import gives `NAME::f`, an include gives `f`, and a data import
// gives `$NAME` and `$NAME::NAME`.
function with_deps(e: Env, deps: modules.Dep[], own: Func[][]): Env {
  let out = e;
  for d in deps {
    if (d.is_data) {
      out = out.with(d.alias, d.data).with(d.alias + "::" + d.alias, d.data);
      continue;
    }
    for f in own[d.module] {
      if (d.include) {
        out = out.define(f);
      } else {
        out = out.define(Func { ...f, name: d.alias + "::" + f.name });
      }
    }
  }
  return out;
}

// The environment of the program of `c`: the variables of `e`, the functions
// that the port has as jq text, and the dependencies of the program. A module
// sees `$ENV` and the functions of its own dependencies.
pub function load(c: modules.Compiled, e: Env): Env {
  let base = define_all(env().with("ENV", environment()), filter.prelude());
  let own: Func[][] = [];
  for m in c.modules {
    let scope = with_deps(base, m.deps, own);
    let before = scope.funcs.len();
    let done = define_all(scope, m.defs);
    let mine: Func[] = [];
    for i in before..done.funcs.len() {
      mine = mine.append(done.funcs[i]);
    }
    own = own.append(mine);
  }
  return with_deps(define_all(e, filter.prelude()), c.deps, own);
}

// `modulemeta` of the module that the input names.
function module_meta(input: json.JsonValue, e: Env): Outputs {
  let json.JString(name) = input else {
    return fail("modulemeta input module name must be a string");
  };
  let search: string[] = [];
  let found = lookup(e, "*search");
  if (found.values.len() > 0) {
    if let json.JArray(items) = found.values[0] {
      for x in items {
        if let json.JString(s) = x {
          search = search.append(s);
        }
      }
    }
  }
  let origin = "";
  let o = lookup(e, "*jq_origin");
  if (o.values.len() > 0) {
    if let json.JString(s) = o.values[0] {
      origin = s;
    }
  }
  return match (modules.meta(name, search, origin)) {
    Ok(v) => one(v),
    Err(message) => fail(message),
  };
}

// ---- Values ----

// The slice of `v` that the path element `{"start": a, "end": b}` names.
function slice_of(v: json.JsonValue, o: json.JsonObject): Outputs {
  if (!o.contains("start") || !o.contains("end")) {
    return fail("Array/string slice indices must be integers");
  }
  return slice(v, o.get_or("start", json.JNull), o.get_or("end", json.JNull));
}

function index_error(v: json.JsonValue, k: json.JsonValue): Outputs {
  if let json.JString(s) = k {
    return fail("Cannot index " + output.type_name(v) + " with string \"" + s + "\"");
  }
  return fail("Cannot index " + output.type_name(v) + " with " + output.type_name(k));
}

pub function index(v: json.JsonValue, k: json.JsonValue): Outputs {
  match (v) {
    json.JNull => {
      return match (k) {
        json.JString(_) => one(json.JNull),
        json.JNumber(_) => one(json.JNull),
        json.JObject(_) => one(json.JNull),
        _ => index_error(v, k),
      };
    },
    json.JObject(o) => {
      if let json.JString(s) = k {
        return one(o.get_or(s, json.JNull));
      }
      return index_error(v, k);
    },
    json.JArray(items) => {
      if let json.JNumber(t) = k {
        let x = number.value(t);
        let i = floor_index(x);
        if (i < 0) {
          i += items.len();
        }
        if (x != x || i < 0 || i >= items.len()) {
          return one(json.JNull);
        }
        return one(items[i]);
      }
      if let json.JArray(part) = k {
        return one(json.JArray(positions(items, part)));
      }
      if let json.JObject(o) = k {
        return slice_of(v, o);
      }
      return index_error(v, k);
    },
    json.JString(_) => {
      if let json.JObject(o) = k {
        return slice_of(v, o);
      }
      return index_error(v, k);
    },
    _ => {
      return index_error(v, k);
    }
  }
}

// The i32 of a floored index. An index past the range of i32 is outside any
// array.
function floor_index(x: f64): i32 {
  if (x != x) {
    return 0;
  }
  if (x >= 2147483647.0) {
    return 2147483647;
  }
  if (x <= -2147483648.0) {
    return -2147483647;
  }
  let i = x as i32;
  if (i as f64 > x) {
    i -= 1;
  }
  return i;
}

function ceil_index(x: f64): i32 {
  let i = floor_index(x);
  if (i as f64 < x && i < 2147483647) {
    i += 1;
  }
  return i;
}

struct Bounds { start: i32, end: i32, error: string }

function bound(b: json.JsonValue, fallback: i32, len: i32, up: boolean): (i32, string) {
  let i = fallback;
  match (b) {
    json.JNull => {},
    json.JNumber(t) => {
      // A NaN bound is the end of its side, as a null bound is.
      let x = number.value(t);
      if (x != x) {
        return (i, "");
      }
      if (up) {
        i = ceil_index(x);
      } else {
        i = floor_index(x);
      }
      if (i < 0) {
        i += len;
      }
    },
    _ => {
      return (0, "Array/string slice indices must be integers");
    }
  }
  if (i < 0) {
    i = 0;
  }
  if (i > len) {
    i = len;
  }
  return (i, "");
}

function bounds(f: json.JsonValue, t: json.JsonValue, len: i32): Bounds {
  let (start, e1) = bound(f, 0, len, false);
  let (end, e2) = bound(t, len, len, true);
  if (e1.len() > 0 || e2.len() > 0) {
    return Bounds { start: 0, end: 0, error: if (e1.len() > 0) { e1 } else { e2 } };
  }
  if (end < start) {
    end = start;
  }
  return Bounds { start: start, end: end, error: "" };
}

pub function slice(v: json.JsonValue, f: json.JsonValue, t: json.JsonValue): Outputs {
  match (v) {
    json.JNull => {
      return one(json.JNull);
    },
    json.JArray(items) => {
      let b = bounds(f, t, items.len());
      if (b.error.len() > 0) {
        return fail(b.error);
      }
      let part: json.JsonValue[] = [];
      for i in b.start..b.end {
        part = part.append(items[i]);
      }
      return one(json.JArray(part));
    },
    json.JString(s) => {
      let starts = char_starts(s);
      let b = bounds(f, t, starts.len() - 1);
      if (b.error.len() > 0) {
        return fail(b.error);
      }
      return one(json.JString(slice_unchecked(s, starts[b.start], starts[b.end]).to_owned()));
    },
    _ => {
      return fail("Cannot index " + output.type_name(v) + " with object");
    }
  }
}

// The byte offset of each code point of `s`, and its length at the end.
function char_starts(s: string): i32[] {
  let out: i32[] = [];
  for i in 0..s.len() {
    if ((s[i] & 0xc0 as u8) != 0x80 as u8) {
      out = out.append(i);
    }
  }
  return out.append(s.len());
}

// A later entry with the same name replaces the value and keeps the place.
function object_of(names: string[], items: json.JsonValue[]): json.JsonObject {
  let o = json.object();
  for i in 0..names.len() {
    o = o.insert(names[i], items[i]);
  }
  return o;
}

function binary(op: string, l: json.JsonValue, r: json.JsonValue): Outputs {
  return match (op) {
    "+" => add(l, r),
    "-" => subtract(l, r),
    "*" => multiply(l, r),
    "/" => divide(l, r),
    "%" => remainder(l, r),
    _ => one(json.JBool(compare_holds(op, order(l, r)))),
  };
}

function compare_holds(op: string, c: i32): boolean {
  return match (op) {
    "==" => c == 0,
    "!=" => c != 0,
    "<" => c < 0,
    "<=" => c <= 0,
    ">" => c > 0,
    _ => c >= 0,
  };
}

function rank(v: json.JsonValue): i32 {
  return match (v) {
    json.JNull => 0,
    json.JBool(b) => if (b) { 2 } else { 1 },
    json.JNumber(_) => 3,
    json.JString(_) => 4,
    json.JArray(_) => 5,
    json.JObject(_) => 6,
  };
}

function sign(c: i32): i32 {
  if (c < 0) {
    return -1;
  }
  if (c > 0) {
    return 1;
  }
  return 0;
}

function compare_text(a: string, b: string): i32 {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  for i in 0..n {
    if (a[i] != b[i]) {
      if (a[i] < b[i]) {
        return -1;
      }
      return 1;
    }
  }
  return sign(a.len() - b.len());
}

function sorted(names: string[]): string[] {
  let out = names;
  for i in 1..out.len() {
    let j = i;
    while (j > 0 && compare_text(out[j - 1], out[j]) > 0) {
      let t = out[j];
      out = out.with(j, out[j - 1]).with(j - 1, t);
      j -= 1;
    }
  }
  return out;
}

function compare_arrays(a: json.JsonValue[], b: json.JsonValue[]): i32 {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  for i in 0..n {
    let c = order(a[i], b[i]);
    if (c != 0) {
      return c;
    }
  }
  return sign(a.len() - b.len());
}

// Objects compare by their sorted keys, and then by the values in the order
// of those keys.
function compare_objects(a: json.JsonObject, b: json.JsonObject): i32 {
  let ka = sorted(a.keys());
  let kb = sorted(b.keys());
  let ja: json.JsonValue[] = [];
  let jb: json.JsonValue[] = [];
  for k in ka {
    ja = ja.append(json.JString(k));
  }
  for k in kb {
    jb = jb.append(json.JString(k));
  }
  let c = compare_arrays(ja, jb);
  if (c != 0) {
    return c;
  }
  for k in ka {
    let d = order(a.get_or(k, json.JNull), b.get_or(k, json.JNull));
    if (d != 0) {
      return d;
    }
  }
  return 0;
}

// The order of jq: null, false, true, numbers, strings, arrays, objects.
pub function order(a: json.JsonValue, b: json.JsonValue): i32 {
  let ra = rank(a);
  let rb = rank(b);
  if (ra != rb) {
    return sign(ra - rb);
  }
  match (a) {
    json.JNumber(x) => {
      let json.JNumber(y) = b else {
        return 0;
      };
      return number.compare(x, y);
    },
    json.JString(x) => {
      let json.JString(y) = b else {
        return 0;
      };
      return compare_text(x, y);
    },
    json.JArray(x) => {
      let json.JArray(y) = b else {
        return 0;
      };
      return compare_arrays(x, y);
    },
    json.JObject(x) => {
      let json.JObject(y) = b else {
        return 0;
      };
      return compare_objects(x, y);
    },
    _ => {
      return 0;
    }
  }
}

function computed(x: f64): json.JsonValue {
  return json.JNumber(number.format(x));
}

function cannot(l: json.JsonValue, r: json.JsonValue, what: string): Outputs {
  return fail(output.type_name(l) + " (" + output.shown(l) + ") and " + output.type_name(r) + " (" + output.shown(r) + ") cannot be " + what);
}

function add(l: json.JsonValue, r: json.JsonValue): Outputs {
  if let json.JNull = l {
    return one(r);
  }
  match (r) {
    json.JNull => {
      return one(l);
    },
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        return one(computed(number.value(x) + number.value(y)));
      }
    },
    json.JString(y) => {
      if let json.JString(x) = l {
        return one(json.JString(x + y));
      }
    },
    json.JArray(y) => {
      if let json.JArray(x) = l {
        return one(json.JArray(x.concat(y)));
      }
    },
    json.JObject(y) => {
      if let json.JObject(x) = l {
        let o = x;
        for k in y.keys() {
          o = o.insert(k, y.get_or(k, json.JNull));
        }
        return one(json.JObject(o));
      }
    },
    _ => {}
  }
  return cannot(l, r, "added");
}

function subtract(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (r) {
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        return one(computed(number.value(x) - number.value(y)));
      }
    },
    json.JArray(y) => {
      if let json.JArray(x) = l {
        let kept: json.JsonValue[] = [];
        for v in x {
          if (!holds(y, v)) {
            kept = kept.append(v);
          }
        }
        return one(json.JArray(kept));
      }
    },
    _ => {}
  }
  return cannot(l, r, "subtracted");
}

function holds(items: json.JsonValue[], v: json.JsonValue): boolean {
  for x in items {
    if (order(x, v) == 0) {
      return true;
    }
  }
  return false;
}

function multiply(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (l) {
    json.JNumber(x) => {
      if let json.JNumber(y) = r {
        return one(computed(number.value(x) * number.value(y)));
      }
      if let json.JString(t) = r {
        return repeat(t, number.value(x));
      }
    },
    json.JString(t) => {
      if let json.JNumber(y) = r {
        return repeat(t, number.value(y));
      }
    },
    json.JObject(x) => {
      if let json.JObject(y) = r {
        return one(json.JObject(merge(x, y)));
      }
    },
    _ => {}
  }
  return cannot(l, r, "multiplied");
}

// `t` the whole number of times of `n`. A negative `n` gives null.
function repeat(t: string, n: f64): Outputs {
  if (n != n || n < 0.0) {
    return one(json.JNull);
  }
  if (n * (t.len() as f64) >= 2147483647.0) {
    return fail("Repeat string result too long");
  }
  return one(json.JString(t.repeat(n as i32)));
}

// The entries of `b` on those of `a`. Two objects with one key merge in turn.
function merge(a: json.JsonObject, b: json.JsonObject): json.JsonObject {
  let o = a;
  for k in b.keys() {
    let v = b.get_or(k, json.JNull);
    if let json.JObject(y) = v {
      if let json.JObject(x) = a.get_or(k, json.JNull) {
        v = json.JObject(merge(x, y));
      }
    }
    o = o.insert(k, v);
  }
  return o;
}

function divide(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (r) {
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        if (number.value(y) == 0.0) {
          return cannot(l, r, "divided because the divisor is zero");
        }
        return one(computed(number.value(x) / number.value(y)));
      }
    },
    json.JString(y) => {
      if let json.JString(x) = l {
        return one(json.JArray(split(x, y)));
      }
    },
    _ => {}
  }
  return cannot(l, r, "divided");
}

// The parts of `s` between each `sep`. An empty `sep` gives each code point.
function split(s: string, sep: string): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  if (s.len() == 0) {
    return out;
  }
  if (sep.len() == 0) {
    let starts = char_starts(s);
    for i in 0..starts.len() - 1 {
      out = out.append(json.JString(slice_unchecked(s, starts[i], starts[i + 1]).to_owned()));
    }
    return out;
  }
  for part in s.split(sep) {
    out = out.append(json.JString(part));
  }
  return out;
}

// jq takes the remainder of the whole parts. The sign is that of the left.
function remainder(l: json.JsonValue, r: json.JsonValue): Outputs {
  let json.JNumber(x) = l else {
    return cannot(l, r, "divided (remainder)");
  };
  let json.JNumber(y) = r else {
    return cannot(l, r, "divided (remainder)");
  };
  let a = number.value(x);
  let b = number.value(y);
  if (a != a || b != b) {
    return one(computed(0.0 / 0.0));
  }
  let d = number.int_magnitude(b);
  if (d == 0u64) {
    return cannot(l, r, "divided (remainder) because the divisor is zero");
  }
  let m = (number.int_magnitude(a) % d) as f64;
  if (a < 0.0) {
    return one(computed(-m));
  }
  return one(computed(m));
}

function whole(n: i32): json.JsonValue {
  return json.JNumber(number.integer(n as i64));
}

function length(v: json.JsonValue): Outputs {
  return match (v) {
    json.JNull => one(whole(0)),
    json.JNumber(t) => {
      let x = number.value(t);
      if (x < 0.0) { one(computed(-x)) } else { one(computed(x)) }
    },
    json.JString(s) => one(whole(char_starts(s).len() - 1)),
    json.JArray(items) => one(whole(items.len())),
    json.JObject(o) => one(whole(o.len())),
    _ => fail(output.type_name(v) + " (" + output.shown(v) + ") has no length"),
  };
}

function keys(v: json.JsonValue, in_order: boolean): Outputs {
  let out: json.JsonValue[] = [];
  match (v) {
    json.JObject(o) => {
      let names = o.keys();
      if (in_order) {
        names = sorted(names);
      }
      for k in names {
        out = out.append(json.JString(k));
      }
    },
    json.JArray(items) => {
      for i in 0..items.len() {
        out = out.append(whole(i));
      }
    },
    _ => {
      return fail(output.type_name(v) + " (" + output.shown(v) + ") has no keys");
    }
  }
  return one(json.JArray(out));
}

function has(v: json.JsonValue, k: json.JsonValue): Outputs {
  if let json.JObject(o) = v {
    if let json.JString(s) = k {
      return one(json.JBool(o.contains(s)));
    }
  }
  if let json.JArray(items) = v {
    if let json.JNumber(t) = k {
      // jq cuts the index to its whole part, so -0.5 is the index 0.
      let x = number.value(t);
      return one(json.JBool(items.len() > 0 && x > -1.0 && x < items.len() as f64));
    }
  }
  return fail("Cannot check whether " + output.type_name(v) + " has a " + output.type_name(k) + " key");
}

function sum(o: Outputs): Outputs {
  if (o.failed()) {
    return Outputs { values: [], error: o.error };
  }
  let total: json.JsonValue = json.JNull;
  for v in o.values {
    let next = add(total, v);
    if (next.failed()) {
      return next;
    }
    total = next.values[0];
  }
  return one(total);
}

function to_entries(v: json.JsonValue): Outputs {
  let ks = keys(v, false);
  if (ks.failed()) {
    return ks;
  }
  let json.JArray(names) = ks.values[0] else {
    return ks;
  };
  let out: json.JsonValue[] = [];
  for k in names {
    let item = index(v, k);
    out = out.append(json.JObject(json.object_of(["key", "value"], [k, item.values[0]])));
  }
  return one(json.JArray(out));
}

// The first of the fields `names` of `v` that is not false or null, or null.
function first_field(v: json.JsonValue, names: string[]): Outputs {
  for name in names {
    let o = index(v, json.JString(name));
    if (o.failed() || truthy(o.values[0])) {
      return o;
    }
  }
  return one(json.JNull);
}

// jq 1.7: `map({(.key // .Key // .name // .Name): (if has("value") then
// .value else .Value end)}) | add | . //= {}`.
function from_entries(v: json.JsonValue): Outputs {
  let entries = iterate(v);
  if (entries.failed()) {
    return entries;
  }
  let o = json.object();
  for x in entries.values {
    let key = first_field(x, ["key", "Key", "name", "Name"]);
    if (key.failed()) {
      return key;
    }
    let json.JString(name) = key.values[0] else {
      return fail("Cannot use " + output.type_name(key.values[0]) + " (" + output.shown(key.values[0]) + ") as object key");
    };
    let present = has(x, json.JString("value"));
    if (present.failed()) {
      return present;
    }
    let field = if (truthy(present.values[0])) { "value" } else { "Value" };
    o = o.insert(name, index(x, json.JString(field)).values[0]);
  }
  return one(json.JObject(o));
}

function to_string(v: json.JsonValue): json.JsonValue {
  if let json.JString(_) = v {
    return v;
  }
  return json.JString(output.compact(v));
}

// `values`, `nulls`, `scalars` and the other selectors by type.
function of_type(name: string, v: json.JsonValue): Outputs {
  let t = output.type_name(v);
  let nested = t == "array" || t == "object";
  let keep = match (name) {
    "values" => t != "null",
    "nulls" => t == "null",
    "scalars" => !nested,
    "iterables" => nested,
    "arrays" => t == "array",
    "objects" => t == "object",
    "booleans" => t == "boolean",
    "numbers" => t == "number",
    _ => t == "string",
  };
  if (keep) {
    return one(v);
  }
  return ok([]);
}

// The items in the order of jq, with equal items in their order.
function sorted_values(items: json.JsonValue[]): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  for p in sorted_indices(items) {
    out = out.append(items[p]);
  }
  return out;
}

function sort(v: json.JsonValue): Outputs {
  if let json.JArray(items) = v {
    return one(json.JArray(sorted_values(items)));
  }
  return fail(output.type_name(v) + " (" + output.shown(v) + ") cannot be sorted, as it is not an array");
}

// jq 1.7: `[.[length - 1 - range(0; length)]]`.
function reverse(v: json.JsonValue): Outputs {
  let n = length(v);
  if (n.failed()) {
    return n;
  }
  let out: json.JsonValue[] = [];
  if let json.JArray(items) = v {
    let i = items.len() - 1;
    while (i >= 0) {
      out = out.append(items[i]);
      i -= 1;
    }
    return one(json.JArray(out));
  }
  if (order(n.values[0], whole(0)) == 0) {
    return one(json.JArray(out));
  }
  return fail("Cannot index " + output.type_name(v) + " with number");
}

// Of equal values, `min` gives the first and `max` gives the last.
function extreme(v: json.JsonValue, least: boolean): Outputs {
  let json.JArray(items) = v else {
    let what = output.type_name(v) + " (" + output.shown(v) + ")";
    return fail(what + " and " + what + " cannot be iterated over");
  };
  if (items.len() == 0) {
    return one(json.JNull);
  }
  let best = items[0];
  for i in 1..items.len() {
    let c = order(items[i], best);
    if (least && c < 0 || !least && c >= 0) {
      best = items[i];
    }
  }
  return one(best);
}

// jq 1.7 adds the parts with `+`: a boolean or a number as its text, null as
// "", and each other value as it is.
function join(v: json.JsonValue, sep: json.JsonValue): Outputs {
  let items = iterate(v);
  if (items.failed()) {
    return items;
  }
  let text: json.JsonValue = json.JNull;
  for x in items.values {
    let left = one(json.JString(""));
    if let json.JString(_) = text {
      left = add(text, sep);
    }
    if (left.failed()) {
      return left;
    }
    let part = x;
    let t = output.type_name(x);
    if (t == "boolean" || t == "number") {
      part = to_string(x);
    } else if (t == "null") {
      part = json.JString("");
    }
    let next = add(left.values[0], part);
    if (next.failed()) {
      return next;
    }
    text = next.values[0];
  }
  if (truthy(text)) {
    return one(text);
  }
  return one(json.JString(""));
}

// An array in `v` opens while `depth` is not 0, as `_flatten` of jq 1.7 does.
function flatten(v: json.JsonValue, depth: json.JsonValue): Outputs {
  let items = iterate(v);
  if (items.failed()) {
    return items;
  }
  let out: json.JsonValue[] = [];
  for x in items.values {
    let opens = false;
    if let json.JArray(_) = x {
      opens = order(depth, whole(0)) != 0;
    }
    if (!opens) {
      out = out.append(x);
      continue;
    }
    let less = subtract(depth, whole(1));
    if (less.failed()) {
      return less;
    }
    let inner = flatten(x, less.values[0]);
    if (inner.failed()) {
      return inner;
    }
    if let json.JArray(more) = inner.values[0] {
      out = out.concat(more);
    }
  }
  return one(json.JArray(out));
}

function extreme_by(items: json.JsonValue[], ks: json.JsonValue[], least: boolean): json.JsonValue {
  if (items.len() == 0) {
    return json.JNull;
  }
  let best = 0;
  for i in 1..items.len() {
    let c = order(ks[i], ks[best]);
    if (least && c < 0 || !least && c >= 0) {
      best = i;
    }
  }
  return items[best];
}

// The items in the order `places` of their keys `ks`: each item for
// `sort`, the first of each run of equal keys for `unique`, and an array of
// each run for `group`.
function grouped(what: string, items: json.JsonValue[], ks: json.JsonValue[], places: i32[]): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  let group: json.JsonValue[] = [];
  let last = -1;
  for p in places {
    let item = items[p];
    let same = last >= 0 && order(ks[last], ks[p]) == 0;
    last = p;
    if (what == "sort") {
      out = out.append(item);
    } else if (what == "unique") {
      if (!same) {
        out = out.append(item);
      }
    } else if (same) {
      group = group.append(item);
    } else {
      if (group.len() > 0) {
        out = out.append(json.JArray(group));
      }
      group = [item];
    }
  }
  if (what == "group" && group.len() > 0) {
    out = out.append(json.JArray(group));
  }
  return out;
}

// The places of `ks` in the order of jq, with equal keys in their order: a
// merge sort of the places, from runs of one up.
function sorted_indices(ks: json.JsonValue[]): i32[] {
  let n = ks.len();
  let a: i32[] = [];
  for i in 0..n {
    a = a.append(i);
  }
  let b = a;
  let width = 1;
  while (width < n) {
    let lo = 0;
    while (lo < n) {
      let mid = lo + width;
      if (mid > n) {
        mid = n;
      }
      let hi = mid + width;
      if (hi > n) {
        hi = n;
      }
      let i = lo;
      let j = mid;
      let at = lo;
      while (at < hi) {
        if (j >= hi || i < mid && order(ks[a[i]], ks[a[j]]) <= 0) {
          b = b.with(at, a[i]);
          i += 1;
        } else {
          b = b.with(at, a[j]);
          j += 1;
        }
        at += 1;
      }
      lo = hi;
    }
    let swap = a;
    a = b;
    b = swap;
    width *= 2;
  }
  return a;
}

function ascii_case(v: json.JsonValue, upper: boolean): Outputs {
  let json.JString(s) = v else {
    return fail("explode input must be a string");
  };
  if (upper) {
    return one(json.JString(s.to_ascii_upper()));
  }
  return one(json.JString(s.to_ascii_lower()));
}

function explode(v: json.JsonValue): Outputs {
  let json.JString(s) = v else {
    return fail("explode input must be a string");
  };
  let out: json.JsonValue[] = [];
  let i = 0;
  while (i < s.len()) {
    let Some((cp, size)) = utf8.decode_at(s, i) else {
      break;
    };
    out = out.append(whole(cp));
    i += size;
  }
  return one(json.JArray(out));
}

function implode(v: json.JsonValue): Outputs {
  let json.JArray(items) = v else {
    return fail("implode input must be an array");
  };
  let s = "";
  for x in items {
    let cp = 0.0 / 0.0;
    if let json.JNumber(t) = x {
      cp = number.value(t);
    }
    if (cp != cp) {
      return fail(output.type_name(x) + " (" + output.shown(x) + ") can't be imploded, unicode codepoint needs to be numeric");
    }
    s += reader.codepoint_text(floor_index(cp));
  }
  return one(json.JString(s));
}

// The one value of the JSON text `v`, read as jq reads its input.
function from_json(v: json.JsonValue): Outputs {
  let json.JString(s) = v else {
    return fail(output.type_name(v) + " (" + output.shown(v) + ") only strings can be parsed");
  };
  let r = reader.read(s);
  let bad = r.error;
  if (r.values.len() > 1) {
    bad = "Unexpected extra JSON values";
  } else if (r.values.len() == 0 && bad.len() == 0) {
    bad = "Expected JSON value";
  }
  if (bad.len() > 0) {
    return fail(bad + " (while parsing '" + reader.c_string(s) + "')");
  }
  return one(r.values[0].value);
}

function to_number(v: json.JsonValue): Outputs {
  if let json.JNumber(_) = v {
    return one(v);
  }
  let json.JString(_) = v else {
    return fail(output.type_name(v) + " (" + output.shown(v) + ") cannot be parsed as a number");
  };
  let parsed = from_json(v);
  if (parsed.failed()) {
    return parsed;
  }
  if let json.JNumber(_) = parsed.values[0] {
    return parsed;
  }
  return fail(output.type_name(v) + " (" + output.shown(v) + ") cannot be parsed as a number");
}

function byte_length(v: json.JsonValue): Outputs {
  if let json.JString(s) = v {
    return one(whole(s.len()));
  }
  return fail(output.type_name(v) + " (" + output.shown(v) + ") only strings have UTF-8 byte length");
}

function text_function(name: string, v: json.JsonValue, a: json.JsonValue): Outputs {
  let trims = name == "ltrimstr" || name == "rtrimstr";
  let json.JString(s) = v else {
    return if (trims) { one(v) } else { fail(text_error(name)) };
  };
  let json.JString(t) = a else {
    return if (trims) { one(v) } else { fail(text_error(name)) };
  };
  return match (name) {
    "startswith" => one(json.JBool(s.starts_with(t))),
    "endswith" => one(json.JBool(s.ends_with(t))),
    "split" => one(json.JArray(split(s, t))),
    "ltrimstr" => if (s.starts_with(t)) { one(json.JString(slice_unchecked(s, t.len(), s.len()).to_owned())) } else { one(v) },
    _ => if (s.ends_with(t)) { one(json.JString(slice_unchecked(s, 0, s.len() - t.len()).to_owned())) } else { one(v) },
  };
}

function text_error(name: string): string {
  if (name == "split") {
    return "split input and separator must be strings";
  }
  return name + "() requires string inputs";
}

function contains_checked(a: json.JsonValue, b: json.JsonValue): Outputs {
  if (rank(a) != rank(b)) {
    return fail(output.type_name(a) + " (" + output.shown(a) + ") and " + output.type_name(b) + " (" + output.shown(b) + ") cannot have their containment checked");
  }
  return one(json.JBool(contains(a, b)));
}

// An object holds each key of `b` with a value that contains that of `b`. An
// array holds, for each item of `b`, an item that contains it. A string holds
// `b` as a part. Other values are equal.
function contains(a: json.JsonValue, b: json.JsonValue): boolean {
  match (a) {
    json.JObject(x) => {
      if let json.JObject(y) = b {
        for k in y.keys() {
          if (!x.contains(k) || !contains(x.get_or(k, json.JNull), y.get_or(k, json.JNull))) {
            return false;
          }
        }
        return true;
      }
    },
    json.JArray(x) => {
      if let json.JArray(y) = b {
        for want in y {
          if (!any_contains(x, want)) {
            return false;
          }
        }
        return true;
      }
    },
    json.JString(x) => {
      if let json.JString(y) = b {
        return x.contains(y);
      }
    },
    _ => {}
  }
  return order(a, b) == 0;
}

function any_contains(items: json.JsonValue[], want: json.JsonValue): boolean {
  for x in items {
    if (contains(x, want)) {
      return true;
    }
  }
  return false;
}

// Each place in `items` at which `part` starts.
function positions(items: json.JsonValue[], part: json.JsonValue[]): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  if (part.len() == 0) {
    return out;
  }
  for i in 0..items.len() {
    let here = i + part.len() <= items.len();
    for j in 0..part.len() {
      if (here && order(items[i + j], part[j]) != 0) {
        here = false;
      }
    }
    if (here) {
      out = out.append(whole(i));
    }
  }
  return out;
}

// jq 1.7 gives the byte offsets in a string.
function indices(v: json.JsonValue, a: json.JsonValue): Outputs {
  if let json.JArray(items) = v {
    if let json.JArray(_) = a {
      return index(v, a);
    }
    return one(json.JArray(positions(items, [a])));
  }
  if let json.JString(s) = v {
    if let json.JString(t) = a {
      let out: json.JsonValue[] = [];
      if (t.len() > 0) {
        for i in 0..s.len() - t.len() + 1 {
          if (slice_unchecked(s, i, i + t.len()).to_owned() == t) {
            out = out.append(whole(i));
          }
        }
      }
      return one(json.JArray(out));
    }
  }
  return index(v, a);
}

// jq 1.7: `indices($i) | .[0]`, and `.[-1:][0]` for the last.
function index_of(v: json.JsonValue, a: json.JsonValue, from_end: boolean): Outputs {
  let found = indices(v, a);
  if (found.failed()) {
    return found;
  }
  if (!from_end) {
    return index(found.values[0], whole(0));
  }
  let tail = slice(found.values[0], whole(-1), json.JNull);
  if (tail.failed()) {
    return tail;
  }
  return index(tail.values[0], whole(0));
}

// A value that is not a number is not NaN, not infinite and not normal.
function number_is(name: string, v: json.JsonValue): boolean {
  let json.JNumber(t) = v else {
    return false;
  };
  let x = number.value(t);
  if (name == "isnan") {
    return x != x;
  }
  let size = x.abs();
  if (name == "isinfinite") {
    return size > 1.7976931348623157e308;
  }
  return size >= 2.2250738585072014e-308 && size <= 1.7976931348623157e308;
}

function number_of(v: json.JsonValue): (f64, Outputs) {
  if let json.JNumber(t) = v {
    return (number.value(t), ok([]));
  }
  return (0.0, fail(output.type_name(v) + " (" + output.shown(v) + ") number required"));
}

function texts(names: string[]): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  for name in names {
    out = out.append(json.JString(name));
  }
  return out;
}

function tm_value(t: dates.Tm, seconds: f64): json.JsonValue {
  let parts: json.JsonValue[] = [];
  for n in [t.year, t.mon, t.mday, t.hour, t.min] {
    parts = parts.append(json.JNumber(number.integer(n)));
  }
  parts = parts.append(computed(seconds));
  parts = parts.append(json.JNumber(number.integer(t.wday)));
  return json.JArray(parts.append(json.JNumber(number.integer(t.yday))));
}

// `gmtime` and `localtime`. The seconds keep the fraction of the input.
function broken_down(name: string, input: json.JsonValue): Outputs {
  let json.JNumber(text) = input else {
    return fail(name + "() requires numeric inputs");
  };
  let x = number.value(text);
  if (!(x >= -67768040609740800.0 && x < 67768036191676800.0)) {
    return fail("error converting number of seconds since epoch to datetime");
  }
  let t = dates.gmtime(x.trunc() as i64);
  return one(tm_value(t, t.sec as f64 + (x - x.floor())));
}

// The time of an array of 8 numbers. jq cuts each number to an integer.
function tm_of(items: json.JsonValue[]): dates.Tm[] {
  let ns: i64[] = [];
  for item in items {
    if let json.JNumber(text) = item {
      ns = ns.append(number.value(text).trunc() as i64);
    }
  }
  if (items.len() < 8 || ns.len() != items.len()) {
    return [];
  }
  return [dates.Tm { year: ns[0], mon: ns[1], mday: ns[2], hour: ns[3], min: ns[4], sec: ns[5], wday: ns[6], yday: ns[7] }];
}

function make_time(input: json.JsonValue): Outputs {
  let json.JArray(items) = input else {
    return fail("mktime requires array inputs");
  };
  let t = tm_of(items);
  if (t.len() == 0) {
    return fail("mktime requires parsed datetime inputs");
  }
  let seconds = dates.timegm(t[0]);
  if (seconds == -1) {
    return fail("invalid gmtime representation");
  }
  if (seconds == -2) {
    return fail("mktime not supported on this platform");
  }
  return one(json.JNumber(number.integer(seconds)));
}

// The time of the input of `strftime`: an array, or a number of seconds.
function time_input(name: string, input: json.JsonValue): (dates.Tm[], Outputs) {
  let needs = fail(name + "/1 requires parsed datetime inputs");
  match (input) {
    json.JNumber(_) => {
      let parts = broken_down("gmtime", input);
      if (parts.failed()) {
        return ([], parts);
      }
      return time_input(name, parts.values[0]);
    },
    json.JArray(items) => {
      let t = tm_of(items);
      return (t, if (t.len() == 0) { needs } else { ok([]) });
    },
    _ => {
      return ([], needs);
    }
  }
}

function text_of(v: json.JsonValue): string {
  if let json.JString(s) = v {
    return s;
  }
  return output.compact(v);
}

function format(name: string, v: json.JsonValue): Outputs {
  return match (name) {
    "text" => one(json.JString(text_of(v))),
    "json" => one(json.JString(output.compact(v))),
    "html" => one(json.JString(escaped(text_of(v), "html"))),
    "uri" => one(json.JString(uri(text_of(v)))),
    "csv" => row(name, v),
    "tsv" => row(name, v),
    "sh" => shell(v),
    "base64" => one(json.JString(base64.encode(text_of(v).bytes()))),
    "base64d" => base64_decoded(text_of(v)),
    _ => fail(name + " is not a valid format"),
  };
}

// The text of one byte in the format `name`, or "" when the byte stays. jq
// writes a NUL as a backslash and a 0 in each of these formats.
function escape_of(b: u8, name: string): string {
  if (b == 0 as u8) {
    return "\\0";
  }
  if (name == "html") {
    return match (b) {
      b'<' => "&lt;",
      b'>' => "&gt;",
      b'&' => "&amp;",
      b'\'' => "&apos;",
      b'"' => "&quot;",
      _ => "",
    };
  }
  if (name == "csv") {
    return if (b == b'"') { "\"\"" } else { "" };
  }
  if (name == "sh") {
    return if (b == b'\'') { "'\\''" } else { "" };
  }
  return match (b) {
    b'\t' => "\\t",
    b'\n' => "\\n",
    b'\r' => "\\r",
    b'\\' => "\\\\",
    _ => "",
  };
}

function escaped(s: string, name: string): string {
  let out = "";
  let from = 0;
  for i in 0..s.len() {
    let piece = escape_of(s[i], name);
    if (piece.len() > 0) {
      out += slice_unchecked(s, from, i).to_owned() + piece;
      from = i + 1;
    }
  }
  return out + slice_unchecked(s, from, s.len()).to_owned();
}

// Each byte but a letter, a digit and `-_.~` as a percent sign and two hex
// digits in upper case.
function uri(s: string): string {
  let digits = "0123456789ABCDEF";
  let out = "";
  let from = 0;
  for i in 0..s.len() {
    let b = s[i];
    let stays = b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z' || b >= b'0' && b <= b'9' || b == b'-' || b == b'_' || b == b'.' || b == b'~';
    if (!stays) {
      let n = b as i32;
      out += slice_unchecked(s, from, i).to_owned() + "%" + slice_unchecked(digits, n / 16, n / 16 + 1).to_owned() + slice_unchecked(digits, n % 16, n % 16 + 1).to_owned();
      from = i + 1;
    }
  }
  return out + slice_unchecked(s, from, s.len()).to_owned();
}

// A row of `@csv` or of `@tsv`. null and NaN are empty fields.
function row(name: string, v: json.JsonValue): Outputs {
  let json.JArray(items) = v else {
    return fail(output.type_name(v) + " (" + output.shown(v) + ") cannot be " + name + "-formatted, only array");
  };
  let fields: string[] = [];
  for x in items {
    match (x) {
      json.JNull => {
        fields = fields.append("");
      },
      json.JBool(_) => {
        fields = fields.append(output.compact(x));
      },
      json.JNumber(t) => {
        let n = number.value(t);
        fields = fields.append(if (n != n) { "" } else { output.compact(x) });
      },
      json.JString(s) => {
        if (name == "csv") {
          fields = fields.append("\"" + escaped(s, name) + "\"");
        } else {
          fields = fields.append(escaped(s, name));
        }
      },
      _ => {
        return fail(output.type_name(x) + " (" + output.shown(x) + ") is not valid in a csv row");
      }
    }
  }
  if (name == "csv") {
    return one(json.JString(fields.join(",")));
  }
  return one(json.JString(fields.join("\t")));
}

// The words of a shell command: each string in single quotes.
function shell(v: json.JsonValue): Outputs {
  let items = [v];
  if let json.JArray(all) = v {
    items = all;
  }
  let words: string[] = [];
  for x in items {
    match (x) {
      json.JString(s) => {
        words = words.append("'" + escaped(s, "sh") + "'");
      },
      json.JArray(_) => {
        return fail(output.type_name(x) + " (" + output.shown(x) + ") can not be escaped for shell");
      },
      json.JObject(_) => {
        return fail(output.type_name(x) + " (" + output.shown(x) + ") can not be escaped for shell");
      },
      _ => {
        words = words.append(output.compact(x));
      }
    }
  }
  return one(json.JString(words.join(" ")));
}

function base64_digit(b: u8): i32 {
  if (b >= b'A' && b <= b'Z') {
    return (b - b'A') as i32;
  }
  if (b >= b'a' && b <= b'z') {
    return (b - b'a') as i32 + 26;
  }
  if (b >= b'0' && b <= b'9') {
    return (b - b'0') as i32 + 52;
  }
  if (b == b'+') {
    return 62;
  }
  if (b == b'/') {
    return 63;
  }
  return -1;
}

// jq reads to the first `=`, and gives U+FFFD for bytes that are not UTF-8.
function base64_decoded(s: string): Outputs {
  let bytes: u8[] = [];
  let code = 0;
  let pending = 0;
  for i in 0..s.len() {
    if (s[i] == b'=') {
      break;
    }
    let d = base64_digit(s[i]);
    if (d < 0) {
      return fail("string (" + output.shown(json.JString(s)) + ") is not valid base64 data");
    }
    code = code * 64 + d;
    pending += 1;
    if (pending == 4) {
      bytes = bytes.append((code >> 16 & 255) as u8).append((code >> 8 & 255) as u8).append((code & 255) as u8);
      code = 0;
      pending = 0;
    }
  }
  if (pending == 1) {
    return fail("string (" + output.shown(json.JString(s)) + ") trailing base64 byte found");
  }
  if (pending == 3) {
    bytes = bytes.append((code >> 10 & 255) as u8).append((code >> 2 & 255) as u8);
  } else if (pending == 2) {
    bytes = bytes.append((code >> 4 & 255) as u8);
  }
  let text = unsafe { string_from_bytes_unchecked(bytes) };
  if (utf8.is_valid(text)) {
    return one(json.JString(text));
  }
  return one(json.JString(reader.repaired(text)));
}

function getpath(v: json.JsonValue, keys: json.JsonValue[], at: i32): Outputs {
  if (at == keys.len()) {
    return one(v);
  }
  if let json.JNull = v {
    return one(v);
  }
  let child = index(v, keys[at]);
  if (child.failed()) {
    return child;
  }
  return getpath(child.values[0], keys, at + 1);
}

// `v` with `x` at the path `keys` from `at`. A null on the way becomes an
// object or an array.
function setpath(v: json.JsonValue, keys: json.JsonValue[], at: i32, x: json.JsonValue): Outputs {
  if (at == keys.len()) {
    return one(x);
  }
  let child = index(v, keys[at]);
  if (child.failed()) {
    return child;
  }
  let inner = setpath(child.values[0], keys, at + 1, x);
  if (inner.failed()) {
    return inner;
  }
  return set(v, keys[at], inner.values[0]);
}

function set(v: json.JsonValue, k: json.JsonValue, x: json.JsonValue): Outputs {
  match (k) {
    json.JString(name) => {
      if let json.JNull = v {
        return one(json.JObject(json.object_of([name], [x])));
      }
      if let json.JObject(o) = v {
        let fields = o;
        fields = fields.insert(name, x);
        return one(json.JObject(fields));
      }
    },
    json.JNumber(t) => {
      if let json.JNull = v {
        return set_item([], number.value(t), x);
      }
      if let json.JArray(items) = v {
        return set_item(items, number.value(t), x);
      }
    },
    json.JObject(o) => {
      if let json.JNull = v {
        return set_slice([], o, x);
      }
      if let json.JArray(items) = v {
        return set_slice(items, o, x);
      }
      if let json.JString(_) = v {
        return fail("Cannot update string slices");
      }
    },
    _ => {}
  }
  return index_error(v, k);
}

function set_item(items: json.JsonValue[], at: f64, x: json.JsonValue): Outputs {
  if (at != at) {
    return fail("Cannot set array element at NaN index");
  }
  let i = at as i32;
  if (i < 0) {
    i += items.len();
  }
  if (i < 0) {
    return fail("Out of bounds negative array index");
  }
  if (i > 536870911) {
    return fail("Array index too large");
  }
  let out = items;
  while (out.len() <= i) {
    out = out.append(json.JNull);
  }
  return one(json.JArray(out.with(i, x)));
}

function set_slice(items: json.JsonValue[], o: json.JsonObject, x: json.JsonValue): Outputs {
  let b = slice_bounds(o, items.len());
  if (b.error.len() > 0) {
    return fail(b.error);
  }
  let json.JArray(more) = x else {
    return fail("A slice of an array can only be assigned another array");
  };
  let out: json.JsonValue[] = [];
  for i in 0..b.start {
    out = out.append(items[i]);
  }
  out = out.concat(more);
  for i in b.end..items.len() {
    out = out.append(items[i]);
  }
  return one(json.JArray(out));
}

// The bounds of the path element `{"start": a, "end": b}` in an array of
// `len` items.
function slice_bounds(o: json.JsonObject, len: i32): Bounds {
  if (!o.contains("start") || !o.contains("end")) {
    return Bounds { start: 0, end: 0, error: "Array/string slice indices must be integers" };
  }
  return bounds(o.get_or("start", json.JNull), o.get_or("end", json.JNull), len);
}

// `v` with no value at each path of `paths`.
function delpaths(v: json.JsonValue, paths: json.JsonValue): Outputs {
  let json.JArray(all) = paths else {
    return fail("Paths must be specified as an array");
  };
  let sorted_paths: json.JsonValue[][] = [];
  for p in sorted_values(all) {
    let json.JArray(keys) = p else {
      return fail("Path must be specified as array, not " + output.type_name(p));
    };
    if (keys.len() == 0) {
      return one(json.JNull);
    }
    sorted_paths = sorted_paths.append(keys);
  }
  return delete_paths(v, sorted_paths, 0);
}

// `v` with no value at each of the sorted paths, which all have the same
// keys before `at`. A run of paths with one key at `at` goes down into that
// key, but when the first path of the run ends there, the key itself goes.
// The keys that go leave `v` in one step, so each index is a place of `v` as
// it was.
function delete_paths(v: json.JsonValue, paths: json.JsonValue[][], at: i32): Outputs {
  let out = v;
  let ends: json.JsonValue[] = [];
  let i = 0;
  while (i < paths.len()) {
    let key = paths[i][at];
    let run: json.JsonValue[][] = [];
    let j = i;
    while (j < paths.len() && order(paths[j][at], key) == 0) {
      run = run.append(paths[j]);
      j += 1;
    }
    if (paths[i].len() == at + 1) {
      ends = ends.append(key);
    } else {
      let child = index(out, key);
      if (child.failed()) {
        return child;
      }
      let inner = one(json.JNull);
      if let json.JNull = child.values[0] {
        inner = ok([]);
      } else {
        inner = delete_paths(child.values[0], run, at + 1);
      }
      if (inner.failed()) {
        return inner;
      }
      if (inner.values.len() > 0) {
        let next = set(out, key, inner.values[0]);
        if (next.failed()) {
          return next;
        }
        out = next.values[0];
      }
    }
    i = j;
  }
  return delete_keys(out, ends);
}

function delete_keys(v: json.JsonValue, keys: json.JsonValue[]): Outputs {
  if (keys.len() == 0) {
    return one(v);
  }
  match (v) {
    json.JNull => {
      return one(v);
    },
    json.JObject(o) => {
      let fields = o;
      for k in keys {
        let json.JString(name) = k else {
          return fail("Cannot delete " + output.type_name(k) + " field of object");
        };
        fields = fields.remove(name);
      }
      return one(json.JObject(fields));
    },
    json.JArray(items) => {
      return delete_items(items, keys);
    },
    _ => {
      return fail("Cannot delete fields from " + output.type_name(v));
    }
  }
}

// `items` with no item at each key: an index, an index from the end, or a
// slice. Each key is a place of `items` as it is now.
function delete_items(items: json.JsonValue[], keys: json.JsonValue[]): Outputs {
  let gone: boolean[] = [];
  for i in 0..items.len() {
    gone = gone.append(false);
  }
  for k in keys {
    let start = 0;
    let end = 0;
    match (k) {
      json.JNumber(t) => {
        start = number.value(t) as i32;
        if (start < 0) {
          start += items.len();
        }
        end = start + 1;
      },
      json.JObject(o) => {
        let b = slice_bounds(o, items.len());
        if (b.error.len() > 0) {
          return fail(b.error);
        }
        start = b.start;
        end = b.end;
      },
      _ => {
        return fail("Cannot delete " + output.type_name(k) + " element of array");
      }
    }
    for i in start..end {
      if (i >= 0 && i < items.len()) {
        gone = gone.with(i, true);
      }
    }
  }
  let out: json.JsonValue[] = [];
  for i in 0..items.len() {
    if (!gone[i]) {
      out = out.append(items[i]);
    }
  }
  return one(json.JArray(out));
}

// ---- Regular expressions ----

// `_match_impl(re; flags; test)` of jq: true or false for a test, and
// otherwise an array of the matches, with offsets and lengths in code points.
function match_impl(input: json.JsonValue, re: json.JsonValue, flags: json.JsonValue, test: json.JsonValue): Outputs {
  let json.JString(text) = input else {
    return fail(output.type_name(input) + " (" + output.shown(input) + ") cannot be matched, as it is not a string");
  };
  let json.JString(pattern) = re else {
    return fail(output.type_name(re) + " (" + output.shown(re) + ") is not a string");
  };
  let mode = "";
  match (flags) {
    json.JString(m) => {
      for i in 0..m.len() {
        if (!"gixmsplnx".contains(slice_unchecked(m, i, i + 1).to_owned())) {
          return fail(m + " is not a valid modifier string");
        }
      }
      mode = m;
    },
    json.JNull => {},
    _ => {
      return fail(output.type_name(flags) + " (" + output.shown(flags) + ") is not a string");
    }
  }
  let compiled = match (regex.compile(pattern, mode)) {
    Ok(r) => r,
    Err(message) => {
      return fail("Regex failure: " + message);
    },
  };
  let testing = order(test, json.JBool(true)) == 0;
  let global = mode.contains("g");
  let found: json.JsonValue[] = [];
  let start = 0;
  while (start <= text.len()) {
    let Some(m) = regex.search(compiled, text, start) else {
      break;
    };
    if (testing) {
      return one(json.JBool(true));
    }
    found = found.append(match_value(text, m, compiled.names));
    if (m.ends[0] == m.starts[0]) {
      start = m.ends[0] + 1;
    } else {
      start = m.ends[0];
    }
    if (!global) {
      break;
    }
  }
  if (testing) {
    return one(json.JBool(false));
  }
  return one(json.JArray(found));
}

// The number of code points of `s` before the byte `at`, as jq counts them.
function code_index(s: string, at: i32): i32 {
  let n = 0;
  let i = 0;
  while (i < at) {
    let b = s[i] as i32;
    if (b < 0x80) {
      i += 1;
    } else if (b < 0xe0) {
      i += 2;
    } else if (b < 0xf0) {
      i += 3;
    } else {
      i += 4;
    }
    n += 1;
  }
  return n;
}

function name_of(names: string[], g: i32): json.JsonValue {
  if (g < names.len() && names[g].len() > 0) {
    return json.JString(names[g]);
  }
  return json.JNull;
}

// One match as jq gives it. An empty match gives each group as an empty
// string at its offset.
function match_value(s: string, m: regex.Found, names: string[]): json.JsonValue {
  let from = m.starts[0];
  let to = m.ends[0];
  let offset = whole(code_index(s, from));
  let caps: json.JsonValue[] = [];
  if (from == to) {
    for g in 1..m.starts.len() {
      let c = json.object().insert("offset", offset).insert("string", json.JString("")).insert("length", whole(0));
      caps = caps.append(json.JObject(c.insert("name", name_of(names, g))));
    }
    let o = json.object().insert("offset", offset).insert("length", whole(0)).insert("string", json.JString(""));
    return json.JObject(o.insert("captures", json.JArray(caps)));
  }
  for g in 1..m.starts.len() {
    caps = caps.append(capture_value(s, m.starts[g], m.ends[g], name_of(names, g)));
  }
  let o = json.object().insert("offset", offset).insert("length", whole(code_index(s, to) - code_index(s, from)));
  o = o.insert("string", json.JString(slice_unchecked(s, from, to).to_owned()));
  return json.JObject(o.insert("captures", json.JArray(caps)));
}

function capture_value(s: string, from: i32, to: i32, name: json.JsonValue): json.JsonValue {
  if (from < 0) {
    let o = json.object().insert("offset", whole(-1)).insert("string", json.JNull).insert("length", whole(0));
    return json.JObject(o.insert("name", name));
  }
  if (from == to) {
    let o = json.object().insert("offset", whole(code_index(s, from))).insert("string", json.JString("")).insert("length", whole(0));
    return json.JObject(o.insert("name", name));
  }
  let o = json.object().insert("offset", whole(code_index(s, from))).insert("length", whole(code_index(s, to) - code_index(s, from)));
  o = o.insert("string", json.JString(slice_unchecked(s, from, to).to_owned()));
  return json.JObject(o.insert("name", name));
}

// ---- Streams ----

// The events of `--stream` for `v`, as `tostream` gives them: `[path, leaf]`
// for each scalar and empty container, and `[path]` after the last item of
// each container that is not empty.
pub function stream_events(v: json.JsonValue): json.JsonValue[] {
  return events_of(v, [], []);
}

function events_of(v: json.JsonValue, at: json.JsonValue[], own out: json.JsonValue[]): json.JsonValue[] {
  let events = out;
  match (v) {
    json.JArray(items) => {
      if (items.len() == 0) {
        return events.append(json.JArray([json.JArray(at), v]));
      }
      for i in 0..items.len() {
        events = events_of(items[i], at.append(whole(i)), events);
      }
      return events.append(json.JArray([json.JArray(at.append(whole(items.len() - 1)))]));
    },
    json.JObject(o) => {
      let names = o.keys();
      if (names.len() == 0) {
        return events.append(json.JArray([json.JArray(at), v]));
      }
      let values = o.values();
      for i in 0..names.len() {
        events = events_of(values[i], at.append(json.JString(names[i])), events);
      }
      return events.append(json.JArray([json.JArray(at.append(json.JString(names[names.len() - 1])))]));
    },
    _ => {
      return events.append(json.JArray([json.JArray(at), v]));
    }
  }
}
