// The evaluator of the jq language.
//
// `run` gives the outputs of a filter for one input. jq gives the outputs one
// at a time, and an error stops the filter; `Outputs` holds the values before
// the error and the error.
import "std/json";
import "std/string";
import "./filter";
import "./number";
import "./output";

// `error` is empty, or it holds the one value of the error.
pub struct Outputs { values: json.JsonValue[], error: json.JsonValue[] }

pub struct Env { names: string[], values: json.JsonValue[] }

pub function env(): Env {
  return Env { names: [], values: [] };
}

pub function (e: Env) with(name: string, value: json.JsonValue): Env {
  return Env { names: e.names.append(name), values: e.values.append(value) };
}

function ok(values: json.JsonValue[]): Outputs {
  return Outputs { values: values, error: [] };
}

function one(v: json.JsonValue): Outputs {
  return ok([v]);
}

function raise(v: json.JsonValue): Outputs {
  return Outputs { values: [], error: [v] };
}

function fail(message: string): Outputs {
  return raise(json.JString(message));
}

// The error after "jq: error (at ...)", or "" when there is none.
pub function (o: Outputs) message(): string {
  if (o.error.len() == 0) {
    return "";
  }
  if let json.JString(s) = o.error[0] {
    return ": " + s;
  }
  return " (not a string): " + output.compact(o.error[0]);
}

function (o: Outputs) failed(): boolean {
  return o.error.len() > 0;
}

// `more` after `o`, unless `o` already failed.
function (o: Outputs) then(more: Outputs): Outputs {
  return Outputs { values: o.values.concat(more.values), error: more.error };
}

pub function type_name(v: json.JsonValue): string {
  return match (v) {
    json.JNull => "null",
    json.JBool(_) => "boolean",
    json.JNumber(_) => "number",
    json.JString(_) => "string",
    json.JArray(_) => "array",
    json.JObject(_) => "object",
  };
}

// The value as an error message shows it: compact, and cut to 11 bytes and
// "..." when it is longer than 14.
pub function shown(v: json.JsonValue): string {
  let s = output.compact(v);
  if (s.len() > 14) {
    return slice_unchecked(s, 0, 11).to_owned() + "...";
  }
  return s;
}

pub function truthy(v: json.JsonValue): boolean {
  return match (v) {
    json.JNull => false,
    json.JBool(b) => b,
    _ => true,
  };
}

pub function run(f: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  match (f) {
    filter.Identity => {
      return one(input);
    },
    filter.Literal(v) => {
      return one(v);
    },
    filter.Var(name) => {
      return lookup(e, name);
    },
    filter.Index(target, key) => {
      return run_index(target, key, input, e);
    },
    filter.Slice(target, from, to) => {
      return run_slice(target, from, to, input, e);
    },
    filter.Iterate(target) => {
      return each(run(target, input, e), iterate);
    },
    filter.Optional(inner) => {
      let o = run(inner, input, e);
      return ok(o.values);
    },
    filter.Pipe(a, b) => {
      return run_pipe(run(a, input, e), b, e);
    },
    filter.Comma(a, b) => {
      let o = run(a, input, e);
      if (o.failed()) {
        return o;
      }
      return o.then(run(b, input, e));
    },
    filter.Collect(inner) => {
      let o = run(inner, input, e);
      if (o.failed()) {
        return Outputs { values: [], error: o.error };
      }
      return one(json.JArray(o.values));
    },
    filter.EmptyArray => {
      return one(json.JArray([]));
    },
    filter.Object(keys, values) => {
      return build_object(keys, values, 0, [], [], input, e);
    },
    filter.Compare(op, a, b) => {
      return run_binary(op, a, b, input, e);
    },
    filter.Arith(op, a, b) => {
      return run_binary(op, a, b, input, e);
    },
    filter.Alt(a, b) => {
      return run_alt(a, b, input, e);
    },
    filter.Call(name, args) => {
      return call(name, args, input, e);
    },
    filter.Catch(body, handler) => {
      let o = run(body, input, e);
      if (!o.failed()) {
        return o;
      }
      return ok(o.values).then(run(handler, o.error[0], e));
    },
    filter.If(cond, yes, no) => {
      return run_if(cond, yes, no, input, e);
    },
    filter.Bind(source, name, body) => {
      return run_bind(source, name, body, input, e);
    },
    filter.Reduce(source, name, init, update) => {
      return run_fold(false, source, name, init, [update, filter.Identity], input, e);
    },
    filter.Foreach(source, name, init, update, extract) => {
      return run_fold(true, source, name, init, [update, extract], input, e);
    },
    filter.And(a, b) => {
      return run_logic(false, a, b, input, e);
    },
    filter.Or(a, b) => {
      return run_logic(true, a, b, input, e);
    },
    filter.Negate(inner) => {
      return each(run(inner, input, e), negate);
    }
  }
}

function lookup(e: Env, name: string): Outputs {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return one(e.values[i]);
    }
    i -= 1;
  }
  return fail("$" + name + " is not defined");
}

// The outputs of `step` for each value of `o`, in order.
function each(o: Outputs, step: (json.JsonValue) => Outputs): Outputs {
  let out = ok([]);
  for v in o.values {
    out = out.then(step(v));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: o.error };
}

function run_pipe(o: Outputs, b: filter.Ast, e: Env): Outputs {
  let out = ok([]);
  for v in o.values {
    out = out.then(run(b, v, e));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: o.error };
}

function iterate(v: json.JsonValue): Outputs {
  return match (v) {
    json.JArray(items) => ok(items),
    json.JObject(o) => ok(o.values()),
    _ => fail("Cannot iterate over " + type_name(v) + " (" + shown(v) + ")"),
  };
}

function negate(v: json.JsonValue): Outputs {
  if let json.JNumber(t) = v {
    return one(json.JNumber(number.format(-number.value(t))));
  }
  return fail(type_name(v) + " (" + shown(v) + ") cannot be negated");
}

// The index runs on the input. jq takes each key, and then each target.
function run_index(target: filter.Ast, key: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let keys = run(key, input, e);
  let out = ok([]);
  for k in keys.values {
    let targets = run(target, input, e);
    for t in targets.values {
      out = out.then(index(t, k));
      if (out.failed()) {
        return out;
      }
    }
    if (targets.failed()) {
      return Outputs { ...out, error: targets.error };
    }
  }
  return Outputs { ...out, error: keys.error };
}

function index_error(v: json.JsonValue, k: json.JsonValue): Outputs {
  if let json.JString(s) = k {
    return fail("Cannot index " + type_name(v) + " with string \"" + s + "\"");
  }
  return fail("Cannot index " + type_name(v) + " with " + type_name(k));
}

pub function index(v: json.JsonValue, k: json.JsonValue): Outputs {
  match (v) {
    json.JNull => {
      return match (k) {
        json.JString(_) => one(json.JNull),
        json.JNumber(_) => one(json.JNull),
        json.JObject(_) => one(json.JNull),
        _ => index_error(v, k),
      };
    },
    json.JObject(o) => {
      if let json.JString(s) = k {
        return one(o.get_or(s, json.JNull));
      }
      return index_error(v, k);
    },
    json.JArray(items) => {
      if let json.JNumber(t) = k {
        let i = floor_index(number.value(t));
        if (i < 0) {
          i += items.len();
        }
        if (i < 0 || i >= items.len()) {
          return one(json.JNull);
        }
        return one(items[i]);
      }
      return index_error(v, k);
    },
    _ => {
      return index_error(v, k);
    }
  }
}

// The i32 of a floored index. An index past the range of i32 is outside any
// array.
function floor_index(x: f64): i32 {
  if (x != x) {
    return 0;
  }
  if (x >= 2147483647.0) {
    return 2147483647;
  }
  if (x <= -2147483648.0) {
    return -2147483647;
  }
  let i = x as i32;
  if (i as f64 > x) {
    i -= 1;
  }
  return i;
}

function ceil_index(x: f64): i32 {
  let i = floor_index(x);
  if (i as f64 < x && i < 2147483647) {
    i += 1;
  }
  return i;
}

function run_slice(target: filter.Ast, from: filter.Ast, to: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let tos = run(to, input, e);
  let out = ok([]);
  for t in tos.values {
    let froms = run(from, input, e);
    for f in froms.values {
      let targets = run(target, input, e);
      for v in targets.values {
        out = out.then(slice(v, f, t));
        if (out.failed()) {
          return out;
        }
      }
      if (targets.failed()) {
        return Outputs { ...out, error: targets.error };
      }
    }
    if (froms.failed()) {
      return Outputs { ...out, error: froms.error };
    }
  }
  return Outputs { ...out, error: tos.error };
}

struct Bounds { start: i32, end: i32, error: string }

function bound(b: json.JsonValue, fallback: i32, len: i32, up: boolean): (i32, string) {
  let i = fallback;
  match (b) {
    json.JNull => {},
    json.JNumber(t) => {
      if (up) {
        i = ceil_index(number.value(t));
      } else {
        i = floor_index(number.value(t));
      }
      if (i < 0) {
        i += len;
      }
    },
    _ => {
      return (0, "Start and end indices of an array slice must be numbers");
    }
  }
  if (i < 0) {
    i = 0;
  }
  if (i > len) {
    i = len;
  }
  return (i, "");
}

function bounds(f: json.JsonValue, t: json.JsonValue, len: i32): Bounds {
  let (start, e1) = bound(f, 0, len, false);
  let (end, e2) = bound(t, len, len, true);
  if (e1.len() > 0 || e2.len() > 0) {
    return Bounds { start: 0, end: 0, error: e1 + e2 };
  }
  if (end < start) {
    end = start;
  }
  return Bounds { start: start, end: end, error: "" };
}

pub function slice(v: json.JsonValue, f: json.JsonValue, t: json.JsonValue): Outputs {
  match (v) {
    json.JNull => {
      return one(json.JNull);
    },
    json.JArray(items) => {
      let b = bounds(f, t, items.len());
      if (b.error.len() > 0) {
        return fail(b.error);
      }
      let part: json.JsonValue[] = [];
      for i in b.start..b.end {
        part = part.append(items[i]);
      }
      return one(json.JArray(part));
    },
    json.JString(s) => {
      let starts = char_starts(s);
      let b = bounds(f, t, starts.len() - 1);
      if (b.error.len() > 0) {
        return fail(b.error);
      }
      return one(json.JString(slice_unchecked(s, starts[b.start], starts[b.end]).to_owned()));
    },
    _ => {
      return fail("Cannot index " + type_name(v) + " with object");
    }
  }
}

// The byte offset of each code point of `s`, and its length at the end.
function char_starts(s: string): i32[] {
  let out: i32[] = [];
  for i in 0..s.len() {
    if ((s[i] & 0xc0 as u8) != 0x80 as u8) {
      out = out.append(i);
    }
  }
  return out.append(s.len());
}

function build_object(keys: filter.Ast[], values: filter.Ast[], at: i32, names: string[], items: json.JsonValue[], input: json.JsonValue, e: Env): Outputs {
  if (at == keys.len()) {
    return one(json.JObject(object_of(names, items)));
  }
  let ks = run(keys[at], input, e);
  let out = ok([]);
  for k in ks.values {
    let json.JString(name) = k else {
      return out.then(fail("Cannot use " + type_name(k) + " (" + shown(k) + ") as object key"));
    };
    let vs = run(values[at], input, e);
    for v in vs.values {
      out = out.then(build_object(keys, values, at + 1, names.append(name), items.append(v), input, e));
      if (out.failed()) {
        return out;
      }
    }
    if (vs.failed()) {
      return Outputs { ...out, error: vs.error };
    }
  }
  return Outputs { ...out, error: ks.error };
}

// A later entry with the same name replaces the value and keeps the place.
function object_of(names: string[], items: json.JsonValue[]): json.JsonObject {
  let o = json.object();
  for i in 0..names.len() {
    o = o.insert(names[i], items[i]);
  }
  return o;
}

// jq takes each right value, and then each left value.
function run_binary(op: string, a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let rights = run(b, input, e);
  let out = ok([]);
  for r in rights.values {
    let lefts = run(a, input, e);
    for l in lefts.values {
      out = out.then(binary(op, l, r));
      if (out.failed()) {
        return out;
      }
    }
    if (lefts.failed()) {
      return Outputs { ...out, error: lefts.error };
    }
  }
  return Outputs { ...out, error: rights.error };
}

function binary(op: string, l: json.JsonValue, r: json.JsonValue): Outputs {
  return match (op) {
    "+" => add(l, r),
    "-" => subtract(l, r),
    "*" => multiply(l, r),
    "/" => divide(l, r),
    "%" => remainder(l, r),
    _ => one(json.JBool(compare_holds(op, order(l, r)))),
  };
}

function compare_holds(op: string, c: i32): boolean {
  return match (op) {
    "==" => c == 0,
    "!=" => c != 0,
    "<" => c < 0,
    "<=" => c <= 0,
    ">" => c > 0,
    _ => c >= 0,
  };
}

// `a and b` is false for a false left value and takes each right value
// otherwise. `a or b` is true for a true left value.
function run_logic(is_or: boolean, a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let lefts = run(a, input, e);
  let out = ok([]);
  for l in lefts.values {
    if (truthy(l) == is_or) {
      out = out.then(one(json.JBool(is_or)));
      continue;
    }
    let rights = run(b, input, e);
    for r in rights.values {
      out = out.then(one(json.JBool(truthy(r))));
    }
    if (rights.failed()) {
      return Outputs { ...out, error: rights.error };
    }
  }
  return Outputs { ...out, error: lefts.error };
}

function rank(v: json.JsonValue): i32 {
  return match (v) {
    json.JNull => 0,
    json.JBool(b) => if (b) { 2 } else { 1 },
    json.JNumber(_) => 3,
    json.JString(_) => 4,
    json.JArray(_) => 5,
    json.JObject(_) => 6,
  };
}

function sign(c: i32): i32 {
  if (c < 0) {
    return -1;
  }
  if (c > 0) {
    return 1;
  }
  return 0;
}

function compare_text(a: string, b: string): i32 {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  for i in 0..n {
    if (a[i] != b[i]) {
      if (a[i] < b[i]) {
        return -1;
      }
      return 1;
    }
  }
  return sign(a.len() - b.len());
}

function sorted(names: string[]): string[] {
  let out = names;
  for i in 1..out.len() {
    let j = i;
    while (j > 0 && compare_text(out[j - 1], out[j]) > 0) {
      let t = out[j];
      out = out.with(j, out[j - 1]).with(j - 1, t);
      j -= 1;
    }
  }
  return out;
}

function compare_arrays(a: json.JsonValue[], b: json.JsonValue[]): i32 {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  for i in 0..n {
    let c = order(a[i], b[i]);
    if (c != 0) {
      return c;
    }
  }
  return sign(a.len() - b.len());
}

// Objects compare by their sorted keys, and then by the values in the order
// of those keys.
function compare_objects(a: json.JsonObject, b: json.JsonObject): i32 {
  let ka = sorted(a.keys());
  let kb = sorted(b.keys());
  let ja: json.JsonValue[] = [];
  let jb: json.JsonValue[] = [];
  for k in ka {
    ja = ja.append(json.JString(k));
  }
  for k in kb {
    jb = jb.append(json.JString(k));
  }
  let c = compare_arrays(ja, jb);
  if (c != 0) {
    return c;
  }
  for k in ka {
    let d = order(a.get_or(k, json.JNull), b.get_or(k, json.JNull));
    if (d != 0) {
      return d;
    }
  }
  return 0;
}

// The order of jq: null, false, true, numbers, strings, arrays, objects.
pub function order(a: json.JsonValue, b: json.JsonValue): i32 {
  let ra = rank(a);
  let rb = rank(b);
  if (ra != rb) {
    return sign(ra - rb);
  }
  match (a) {
    json.JNumber(x) => {
      let json.JNumber(y) = b else {
        return 0;
      };
      return number.compare(x, y);
    },
    json.JString(x) => {
      let json.JString(y) = b else {
        return 0;
      };
      return compare_text(x, y);
    },
    json.JArray(x) => {
      let json.JArray(y) = b else {
        return 0;
      };
      return compare_arrays(x, y);
    },
    json.JObject(x) => {
      let json.JObject(y) = b else {
        return 0;
      };
      return compare_objects(x, y);
    },
    _ => {
      return 0;
    }
  }
}

// ---- Arithmetic ----

function computed(x: f64): json.JsonValue {
  return json.JNumber(number.format(x));
}

function cannot(l: json.JsonValue, r: json.JsonValue, what: string): Outputs {
  return fail(type_name(l) + " (" + shown(l) + ") and " + type_name(r) + " (" + shown(r) + ") cannot be " + what);
}

function add(l: json.JsonValue, r: json.JsonValue): Outputs {
  if let json.JNull = l {
    return one(r);
  }
  match (r) {
    json.JNull => {
      return one(l);
    },
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        return one(computed(number.value(x) + number.value(y)));
      }
    },
    json.JString(y) => {
      if let json.JString(x) = l {
        return one(json.JString(x + y));
      }
    },
    json.JArray(y) => {
      if let json.JArray(x) = l {
        return one(json.JArray(x.concat(y)));
      }
    },
    json.JObject(y) => {
      if let json.JObject(x) = l {
        let o = x;
        for k in y.keys() {
          o = o.insert(k, y.get_or(k, json.JNull));
        }
        return one(json.JObject(o));
      }
    },
    _ => {}
  }
  return cannot(l, r, "added");
}

function subtract(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (r) {
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        return one(computed(number.value(x) - number.value(y)));
      }
    },
    json.JArray(y) => {
      if let json.JArray(x) = l {
        let kept: json.JsonValue[] = [];
        for v in x {
          if (!holds(y, v)) {
            kept = kept.append(v);
          }
        }
        return one(json.JArray(kept));
      }
    },
    _ => {}
  }
  return cannot(l, r, "subtracted");
}

function holds(items: json.JsonValue[], v: json.JsonValue): boolean {
  for x in items {
    if (order(x, v) == 0) {
      return true;
    }
  }
  return false;
}

function multiply(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (l) {
    json.JNumber(x) => {
      if let json.JNumber(y) = r {
        return one(computed(number.value(x) * number.value(y)));
      }
      if let json.JString(t) = r {
        return repeat(t, number.value(x));
      }
    },
    json.JString(t) => {
      if let json.JNumber(y) = r {
        return repeat(t, number.value(y));
      }
    },
    json.JObject(x) => {
      if let json.JObject(y) = r {
        return one(json.JObject(merge(x, y)));
      }
    },
    _ => {}
  }
  return cannot(l, r, "multiplied");
}

// `t` the whole number of times of `n`. A negative `n` gives null.
function repeat(t: string, n: f64): Outputs {
  if (n != n || n < 0.0) {
    return one(json.JNull);
  }
  if (n * (t.len() as f64) >= 2147483647.0) {
    return fail("Repeat string result too long");
  }
  return one(json.JString(t.repeat(n as i32)));
}

// The entries of `b` on those of `a`. Two objects with one key merge in turn.
function merge(a: json.JsonObject, b: json.JsonObject): json.JsonObject {
  let o = a;
  for k in b.keys() {
    let v = b.get_or(k, json.JNull);
    if let json.JObject(y) = v {
      if let json.JObject(x) = a.get_or(k, json.JNull) {
        v = json.JObject(merge(x, y));
      }
    }
    o = o.insert(k, v);
  }
  return o;
}

function divide(l: json.JsonValue, r: json.JsonValue): Outputs {
  match (r) {
    json.JNumber(y) => {
      if let json.JNumber(x) = l {
        if (number.value(y) == 0.0) {
          return cannot(l, r, "divided because the divisor is zero");
        }
        return one(computed(number.value(x) / number.value(y)));
      }
    },
    json.JString(y) => {
      if let json.JString(x) = l {
        return one(json.JArray(split(x, y)));
      }
    },
    _ => {}
  }
  return cannot(l, r, "divided");
}

// The parts of `s` between each `sep`. An empty `sep` gives each code point.
function split(s: string, sep: string): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  if (s.len() == 0) {
    return out;
  }
  if (sep.len() == 0) {
    let starts = char_starts(s);
    for i in 0..starts.len() - 1 {
      out = out.append(json.JString(slice_unchecked(s, starts[i], starts[i + 1]).to_owned()));
    }
    return out;
  }
  for part in s.split(sep) {
    out = out.append(json.JString(part));
  }
  return out;
}

// The whole part of the size of `x`, held to the range of an i64 as jq does.
function magnitude(x: f64): u64 {
  if (x <= -9223372036854775808.0) {
    return 9223372036854775808u64;
  }
  if (x >= 9223372036854775807.0) {
    return 9223372036854775807u64;
  }
  if (x < 0.0) {
    return (-x) as u64;
  }
  return x as u64;
}

// jq takes the remainder of the whole parts. The sign is that of the left.
function remainder(l: json.JsonValue, r: json.JsonValue): Outputs {
  let json.JNumber(x) = l else {
    return cannot(l, r, "divided (remainder)");
  };
  let json.JNumber(y) = r else {
    return cannot(l, r, "divided (remainder)");
  };
  let a = number.value(x);
  let b = number.value(y);
  if (a != a || b != b) {
    return one(json.JNull);
  }
  let d = magnitude(b);
  if (d == 0u64) {
    return cannot(l, r, "divided (remainder) because the divisor is zero");
  }
  let m = (magnitude(a) % d) as f64;
  if (a < 0.0) {
    return one(computed(-m));
  }
  return one(computed(m));
}

// `a // b` gives the values of `a` that are not false or null, and the values
// of `b` when `a` has none.
function run_alt(a: filter.Ast, b: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let o = run(a, input, e);
  let kept: json.JsonValue[] = [];
  for v in o.values {
    if (truthy(v)) {
      kept = kept.append(v);
    }
  }
  if (o.failed() || kept.len() > 0) {
    return Outputs { values: kept, error: o.error };
  }
  return run(b, input, e);
}

// ---- Functions ----

function call(name: string, args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  return match (name) {
    "empty" => ok([]),
    "error" => run_error(args, input, e),
    "not" => one(json.JBool(!truthy(input))),
    "type" => one(json.JString(type_name(input))),
    "length" => length(input),
    "keys" => keys(input, true),
    "keys_unsorted" => keys(input, false),
    "has" => run_has(args[0], input, e),
    "map" => collect(run_pipe(iterate(input), args[0], e)),
    "select" => run_select(args[0], input, e),
    "add" => sum(iterate(input)),
    "to_entries" => to_entries(input),
    "from_entries" => from_entries(input),
    "tostring" => one(to_string(input)),
    _ => one(json.JString(output.compact(input))),
  };
}

// `error` raises the input. `error(f)` raises the first output of `f`.
function run_error(args: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  if (args.len() == 0) {
    return raise(input);
  }
  let o = run(args[0], input, e);
  if (o.values.len() > 0) {
    return raise(o.values[0]);
  }
  return o;
}

function collect(o: Outputs): Outputs {
  if (o.failed()) {
    return Outputs { values: [], error: o.error };
  }
  return one(json.JArray(o.values));
}

function whole(n: i32): json.JsonValue {
  return json.JNumber(n.to_string());
}

function length(v: json.JsonValue): Outputs {
  return match (v) {
    json.JNull => one(whole(0)),
    json.JNumber(t) => {
      let x = number.value(t);
      if (x < 0.0) { one(computed(-x)) } else { one(computed(x)) }
    },
    json.JString(s) => one(whole(char_starts(s).len() - 1)),
    json.JArray(items) => one(whole(items.len())),
    json.JObject(o) => one(whole(o.len())),
    _ => fail(type_name(v) + " (" + shown(v) + ") has no length"),
  };
}

function keys(v: json.JsonValue, in_order: boolean): Outputs {
  let out: json.JsonValue[] = [];
  match (v) {
    json.JObject(o) => {
      let names = o.keys();
      if (in_order) {
        names = sorted(names);
      }
      for k in names {
        out = out.append(json.JString(k));
      }
    },
    json.JArray(items) => {
      for i in 0..items.len() {
        out = out.append(whole(i));
      }
    },
    _ => {
      return fail(type_name(v) + " (" + shown(v) + ") has no keys");
    }
  }
  return one(json.JArray(out));
}

function run_has(key: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let ks = run(key, input, e);
  let out = ok([]);
  for k in ks.values {
    out = out.then(has(input, k));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: ks.error };
}

function has(v: json.JsonValue, k: json.JsonValue): Outputs {
  if let json.JObject(o) = v {
    if let json.JString(s) = k {
      return one(json.JBool(o.contains(s)));
    }
  }
  if let json.JArray(items) = v {
    if let json.JNumber(t) = k {
      // jq cuts the index to its whole part, so -0.5 is the index 0.
      let x = number.value(t);
      return one(json.JBool(items.len() > 0 && x > -1.0 && x < items.len() as f64));
    }
  }
  return fail("Cannot check whether " + type_name(v) + " has a " + type_name(k) + " key");
}

function run_select(cond: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let conds = run(cond, input, e);
  let kept: json.JsonValue[] = [];
  for c in conds.values {
    if (truthy(c)) {
      kept = kept.append(input);
    }
  }
  return Outputs { values: kept, error: conds.error };
}

function sum(o: Outputs): Outputs {
  if (o.failed()) {
    return Outputs { values: [], error: o.error };
  }
  let total: json.JsonValue = json.JNull;
  for v in o.values {
    let next = add(total, v);
    if (next.failed()) {
      return next;
    }
    total = next.values[0];
  }
  return one(total);
}

function to_entries(v: json.JsonValue): Outputs {
  let ks = keys(v, false);
  if (ks.failed()) {
    return ks;
  }
  let json.JArray(names) = ks.values[0] else {
    return ks;
  };
  let out: json.JsonValue[] = [];
  for k in names {
    let item = index(v, k);
    out = out.append(json.JObject(json.object_of(["key", "value"], [k, item.values[0]])));
  }
  return one(json.JArray(out));
}

// The first of the fields `names` of `v` that is not false or null, or null.
function first_field(v: json.JsonValue, names: string[]): Outputs {
  for name in names {
    let o = index(v, json.JString(name));
    if (o.failed() || truthy(o.values[0])) {
      return o;
    }
  }
  return one(json.JNull);
}

// jq 1.7: `map({(.key // .Key // .name // .Name): (if has("value") then
// .value else .Value end)}) | add | . //= {}`.
function from_entries(v: json.JsonValue): Outputs {
  let entries = iterate(v);
  if (entries.failed()) {
    return entries;
  }
  let o = json.object();
  for x in entries.values {
    let key = first_field(x, ["key", "Key", "name", "Name"]);
    if (key.failed()) {
      return key;
    }
    let json.JString(name) = key.values[0] else {
      return fail("Cannot use " + type_name(key.values[0]) + " (" + shown(key.values[0]) + ") as object key");
    };
    let present = has(x, json.JString("value"));
    if (present.failed()) {
      return present;
    }
    let field = if (truthy(present.values[0])) { "value" } else { "Value" };
    o = o.insert(name, index(x, json.JString(field)).values[0]);
  }
  return one(json.JObject(o));
}

function to_string(v: json.JsonValue): json.JsonValue {
  if let json.JString(_) = v {
    return v;
  }
  return json.JString(output.compact(v));
}

// ---- Control ----

function run_if(cond: filter.Ast, yes: filter.Ast, no: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let conds = run(cond, input, e);
  let out = ok([]);
  for c in conds.values {
    if (truthy(c)) {
      out = out.then(run(yes, input, e));
    } else {
      out = out.then(run(no, input, e));
    }
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: conds.error };
}

function run_bind(source: filter.Ast, name: string, body: filter.Ast, input: json.JsonValue, e: Env): Outputs {
  let sources = run(source, input, e);
  let out = ok([]);
  for v in sources.values {
    out = out.then(run(body, input, e.with(name, v)));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: sources.error };
}

// `reduce` and `foreach`. `steps` holds the update and the extract. Each
// initial value starts a fold of its own.
function run_fold(each: boolean, source: filter.Ast, name: string, init: filter.Ast, steps: filter.Ast[], input: json.JsonValue, e: Env): Outputs {
  let inits = run(init, input, e);
  let out = ok([]);
  for first in inits.values {
    out = out.then(fold(each, run(source, input, e), name, first, steps, e));
    if (out.failed()) {
      return out;
    }
  }
  return Outputs { ...out, error: inits.error };
}

// The state after an update is its last output, or null when it has none.
// A `foreach` gives the extract of each output of the update, and a `reduce`
// gives the last state.
function fold(each: boolean, sources: Outputs, name: string, first: json.JsonValue, steps: filter.Ast[], e: Env): Outputs {
  let state = first;
  let out = ok([]);
  for x in sources.values {
    let scope = e.with(name, x);
    let updates = run(steps[0], state, scope);
    if (each) {
      out = out.then(run_pipe(updates, steps[1], scope));
    } else {
      out = Outputs { ...out, error: updates.error };
    }
    if (out.failed()) {
      return out;
    }
    state = json.JNull;
    if (updates.values.len() > 0) {
      state = updates.values[updates.values.len() - 1];
    }
  }
  if (sources.failed()) {
    return Outputs { ...out, error: sources.error };
  }
  if (each) {
    return out;
  }
  return one(state);
}
