// The JSON reader of jq 1.7: its grammar, its messages, and the line and the
// column in each message.
//
// jq reads more than JSON. A number can be `nan`, `infinity`, `1.`, `.5` or
// `+1`, and the values of a stream need no separator between them. A value
// at the top level is complete as soon as its last byte is read, so `1,` gives
// the 1 and then an error for the comma.
import "std/json";
import "std/string";
import "std/utf8";
import "./filter";
import "./number";

// One value, and the offset in the text just after it.
pub struct Value { value: json.JsonValue, end: i32 }

// The values before the first error, and the error with its place and its
// offset `at`. `open` is the offset of the value that the text leaves open
// when more input follows, or -1. In `--seq`, the reader goes on after an
// error, or after a read with no input, from the offset `resume`. A `resume`
// of -1 ends the input.
pub struct Read { values: Value[], error: string, at: i32, open: i32, resume: i32 }

function failed(values: Value[], error: string, at: i32): Read {
  return Read { values: values, error: error, at: at, open: -1, resume: -1 };
}

function ended(values: Value[], open: i32): Read {
  return Read { values: values, error: "", at: -1, open: open, resume: -1 };
}

// No input for this read of jq, which reads on after the byte `at` next time.
function paused(values: Value[], at: i32): Read {
  return Read { values: values, error: "", at: -1, open: -1, resume: at + 1 };
}

// An error of `--seq` at the byte `at`. jq reads on after that byte.
function resumed(values: Value[], error: string, at: i32): Read {
  return Read { values: values, error: error, at: at, open: -1, resume: at + 1 };
}

// jq allows this many open arrays, objects and keys.
const MAX_DEPTH: i32 = 256;

// An open array keeps its items on `vals` from the offset of its frame. An
// open object keeps its keys on `keys` and its values on `vals`. So a value
// goes into its container in place.
enum Frame {
  Items(i32),
  Fields(i32, i32),
  Key(string),
}

struct State { stack: Frame[], vals: json.JsonValue[], keys: string[], next: json.JsonValue[], out: Value[], line: i32, column: i32 }

function is_space(b: u8): boolean {
  return b == b' ' || b == b'\t' || b == b'\n' || b == b'\r';
}

function is_structure(b: u8): boolean {
  return b == b'[' || b == b']' || b == b'{' || b == b'}' || b == b',' || b == b':';
}

function (st: State) place(at_end: boolean): string {
  let where = " at line " + st.line.to_string() + ", column " + st.column.to_string();
  if (at_end) {
    return " at EOF" + where;
  }
  return where;
}

// The values of `s`, which has no byte order mark.
pub function read(s: string): Read {
  return read_at(s, 1, 0, 0, false);
}

// The values of `s`, which starts at the line `line` and the column
// `column` of its input. `last_read` is the offset in `s` of the last read
// of jq, or -1 when more input follows `s`: then a value that `s` leaves
// open is no error. With `seq`, the input is a sequence of texts of `--seq`,
// and `s` starts after a record separator. When a separator in the last
// read cuts no value, and jq gave no value in that read before it, jq gives
// no input for that read, and reads on after the separator next time.
// fern-lint: allow cyclomatic-complexity
pub function read_at(s: string, line: i32, column: i32, last_read: i32, seq: boolean): Read {
  let last = last_read >= 0;
  let st = State { stack: [], vals: [], keys: [], next: [], out: [], line: line, column: column };
  let token = -1;
  let begun = 0;
  let after_space = false;
  let i = 0;
  while (i < s.len()) {
    let b = s[i];
    if (seq && b == RS) {
      st = st.step(b);
      if (!after_space && (st.stack.len() > 0 || token >= 0)) {
        return truncated(st, s, token, i);
      }
      if (last && i >= last_read && !gave_since(st.out, last_read)) {
        return paused(st.out, i);
      }
      st = st.reset();
      i += 1;
      continue;
    }
    if (st.stack.len() == 0 && token < 0 && !is_space(b)) {
      begun = i;
    }
    after_space = is_space(b);
    st = st.step(b);
    if (!is_space(b) && !is_structure(b) && b != b'"') {
      if (token < 0) {
        token = i;
      }
      i += 1;
      continue;
    }
    // jq loses the value of a literal when the byte that ends the literal is
    // an error itself, as in `1,`.
    let kept = st.out.len();
    if (token >= 0) {
      let (after, bad) = st.literal(slice_unchecked(s, token, i).to_owned(), i);
      if (bad.len() > 0) {
        return stopped(after.out, bad + after.place(false), i, seq);
      }
      st = after;
      token = -1;
    }
    if (is_structure(b)) {
      let (after, bad) = st.structure(b);
      if (bad.len() > 0) {
        return stopped(after.out.truncate(kept), bad + after.place(false), i, seq);
      }
      st = after.done(i + 1);
    } else if (b == b'"') {
      let end = i + 1;
      let closed = false;
      let escaped = false;
      let separator = -1;
      while (end < s.len() && !closed && separator < 0) {
        let c = s[end];
        st = st.step(c);
        if (seq && c == RS) {
          separator = end;
        } else if (escaped) {
          escaped = false;
        } else if (c == b'"') {
          closed = true;
        } else if (c == b'\\') {
          escaped = true;
        }
        end += 1;
      }
      if (separator == i + 1 && st.stack.len() == 0) {
        if (last && separator >= last_read && !gave_since(st.out, last_read)) {
          return paused(st.out, separator);
        }
        st = st.reset();
        i = end;
        continue;
      }
      if (separator >= 0) {
        return resumed(st.out, "Truncated value" + st.place(false), separator);
      }
      if (!closed && !last) {
        return ended(st.out, begun);
      }
      if (!closed) {
        return failed(st.out, "Unfinished string" + st.place(true), s.len());
      }
      let (text, bad) = unescape(slice_unchecked(s, i + 1, end - 1).to_owned());
      if (bad.len() == 0) {
        let (after, twice) = st.value(json.JString(text));
        st = after.done(end);
        bad = twice;
      }
      if (bad.len() > 0) {
        return stopped(st.out, bad + st.place(false), end - 1, seq);
      }
      i = end - 1;
    }
    i += 1;
  }
  if (!last && (token >= 0 || st.stack.len() > 0)) {
    return ended(st.out, begun);
  }
  if (token >= 0) {
    let kept = st.out.len();
    let text = slice_unchecked(s, token, s.len()).to_owned();
    let (after, bad) = st.literal(text, s.len());
    if (bad.len() > 0) {
      return failed(after.out, bad + after.place(true), s.len());
    }
    if (seq && after.stack.len() == 0 && is_number_literal(text)) {
      return failed(after.out.truncate(kept), "Potentially truncated top-level numeric value" + after.place(true), s.len());
    }
    st = after;
  }
  if (st.stack.len() > 0) {
    return failed(st.out, "Unfinished JSON term" + st.place(true), s.len());
  }
  return ended(st.out, -1);
}

// Whether jq gave one of `values` at the offset `at` or after it. jq gives a
// value at the byte after it.
function gave_since(values: Value[], at: i32): boolean {
  return values.len() > 0 && values[values.len() - 1].end >= at;
}

// The record separator of `--seq`.
pub const RS: u8 = 30u8;

// The error at the byte `at`. With `seq`, jq says that it waits for a record
// separator, but it reads on after the byte.
function stopped(values: Value[], error: string, at: i32, seq: boolean): Read {
  if (seq) {
    return resumed(values, error + " (need RS to resync)", at);
  }
  return failed(values, error, at);
}

// The error of a record separator at `at` that cuts a value. A number at the
// top level can be whole, and jq tells that.
function truncated(own st: State, s: string, token: i32, at: i32): Read {
  if (token < 0 || st.stack.len() > 0) {
    return resumed(st.out, "Truncated value" + st.place(false), at);
  }
  let kept = st.out.len();
  let text = slice_unchecked(s, token, at).to_owned();
  let number = is_number_literal(text);
  let (after, bad) = st.literal(text, at);
  let message = if (number && bad.len() == 0) { "Potentially truncated top-level numeric value" } else { "Truncated value" };
  return resumed(after.out.truncate(kept), message + after.place(false), at);
}

// The state after a record separator that cuts no value: jq drops an open
// array or object.
function (own st: State) reset(): State {
  return State { ...st, stack: [], vals: [], keys: [], next: [] };
}

// Whether jq reads the literal `text` as a number: a literal that is not
// `true`, `false` or one that starts with "nu".
function is_number_literal(text: string): boolean {
  if (text.len() == 0) {
    return false;
  }
  return text[0] != b't' && text[0] != b'f' && !text.starts_with("nu");
}

// The line and the column after the byte `b`.
function (own st: State) step(b: u8): State {
  if (b == b'\n') {
    return State { ...st, line: st.line + 1, column: 0 };
  }
  return State { ...st, column: st.column + 1 };
}

// A value at the top level is complete. `end` is the offset after it.
function (own st: State) done(end: i32): State {
  if (st.stack.len() > 0 || st.next.len() == 0) {
    return st;
  }
  let v = st.next[0];
  return State { ...st, next: [], out: st.out.append(Value { value: v, end: end }) };
}

function (own st: State) value(v: json.JsonValue): (State, string) {
  if (st.next.len() > 0) {
    return (st, "Expected separator between values");
  }
  return (State { ...st, next: [v] }, "");
}

// The literal `text` ends at the offset `end`.
function (own st: State) literal(text: string, end: i32): (State, string) {
  let (v, bad) = literal_value(text);
  if (bad.len() > 0) {
    return (st, bad);
  }
  let (after, twice) = st.value(v);
  return (after.done(end), twice);
}

function literal_value(text: string): (json.JsonValue, string) {
  let word = "";
  let v: json.JsonValue = json.JNull;
  if (text[0] == b't') {
    word = "true";
    v = json.JBool(true);
  } else if (text[0] == b'f') {
    word = "false";
    v = json.JBool(false);
  } else if (text.len() > 1 && text[0] == b'n' && text[1] == b'u') {
    word = "null";
  }
  if (word.len() > 0) {
    if (text != word) {
      return (v, "Invalid literal");
    }
    return (v, "");
  }
  let t = number_text(text);
  if (t.len() == 0) {
    return (v, "Invalid numeric literal");
  }
  return (json.JNumber(t), "");
}

// The number text of a literal, or "" when it is not a number. jq reads a
// decimal with an optional sign, and `nan`, `inf` and `infinity` in any case.
function number_text(whole: string): string {
  let text = c_string(whole);
  if (text.len() == 0) {
    return "";
  }
  let body = text;
  let negative = false;
  if (text[0] == b'-' || text[0] == b'+') {
    negative = text[0] == b'-';
    body = slice_unchecked(text, 1, text.len()).to_owned();
  }
  let name = body.to_ascii_lower();
  if (name == "nan") {
    return number.format(0.0 / 0.0);
  }
  if (name == "inf" || name == "infinity") {
    if (negative) {
      return number.format(-1.0 / 0.0);
    }
    return number.format(1.0 / 0.0);
  }
  if (!number.is_decimal(text)) {
    return "";
  }
  return number.canonical(text);
}

// `s` to its first NUL. jq reads a number, and writes the text of a message,
// as a C string.
pub function c_string(s: string): string {
  for i in 0..s.len() {
    if (s[i] == 0 as u8) {
      return slice_unchecked(s, 0, i).to_owned();
    }
  }
  return s;
}

function (own st: State) structure(b: u8): (State, string) {
  if (b == b'[' || b == b'{') {
    if (st.stack.len() >= MAX_DEPTH) {
      return (st, "Exceeds depth limit for parsing");
    }
    if (st.next.len() > 0) {
      return (st, "Expected separator between values");
    }
    let frame = if (b == b'[') { Items(st.vals.len()) } else { Fields(st.vals.len(), st.keys.len()) };
    return (State { ...st, stack: st.stack.append(frame) }, "");
  }
  if (b == b':') {
    return st.colon();
  }
  if (b == b',') {
    return st.comma();
  }
  if (b == b']') {
    return st.close_array();
  }
  return st.close_object();
}

function (st: State) top(): Frame {
  return st.stack[st.stack.len() - 1];
}

function (own st: State) pop(): State {
  let n = st.stack.len() - 1;
  return State { ...st, stack: st.stack.truncate(n) };
}

function (own st: State) colon(): (State, string) {
  if (st.next.len() == 0) {
    return (st, "Expected string key before ':'");
  }
  if (st.stack.len() == 0) {
    return (st, "':' not as part of an object");
  }
  let Fields(_, _) = st.top() else {
    return (st, "':' not as part of an object");
  };
  let json.JString(k) = st.next[0] else {
    return (st, "Object keys must be strings");
  };
  return (State { ...st, stack: st.stack.append(Key(k)), next: [] }, "");
}

// The pending value goes into the open array, or into the open object below
// the key.
function (own st: State) store(): (State, string) {
  let v = st.next[0];
  match (st.top()) {
    Items(_) => {
      return (State { ...st, vals: st.vals.append(v), next: [] }, "");
    },
    Key(k) => {
      if (st.stack.len() < 2) {
        return (st, "Objects must consist of key:value pairs");
      }
      let Fields(_, _) = st.stack[st.stack.len() - 2] else {
        return (st, "Objects must consist of key:value pairs");
      };
      let below = st.pop();
      return (State { ...below, keys: below.keys.append(k), vals: below.vals.append(v), next: [] }, "");
    },
    Fields(_, _) => {
      return (st, "Objects must consist of key:value pairs");
    }
  }
}

function (own st: State) comma(): (State, string) {
  if (st.next.len() == 0 || st.stack.len() == 0) {
    return (st, "Expected value before ','");
  }
  return st.store();
}

// The items of `vals` from `from`.
function tail_of(vals: json.JsonValue[], from: i32): json.JsonValue[] {
  let out: json.JsonValue[] = [];
  for i in from..vals.len() {
    out = out.append(vals[i]);
  }
  return out;
}

function keys_from(keys: string[], from: i32): string[] {
  let out: string[] = [];
  for i in from..keys.len() {
    out = out.append(keys[i]);
  }
  return out;
}

function (own st: State) close_array(): (State, string) {
  if (st.stack.len() == 0) {
    return (st, "Unmatched ']'");
  }
  let Items(start) = st.top() else {
    return (st, "Unmatched ']'");
  };
  let s = st;
  if (s.next.len() > 0) {
    let v = s.next[0];
    s = State { ...s, vals: s.vals.append(v), next: [] };
  } else if (s.vals.len() > start) {
    return (s, "Expected another array element");
  }
  let items = tail_of(s.vals, start);
  let below = s.pop();
  return (State { ...below, vals: below.vals.truncate(start), next: [json.JArray(items)] }, "");
}

function (own st: State) close_object(): (State, string) {
  if (st.stack.len() == 0) {
    return (st, "Unmatched '}'");
  }
  let filled = st;
  if (filled.next.len() > 0) {
    let Key(_) = filled.top() else {
      return (filled, "Objects must consist of key:value pairs");
    };
    let (stored, bad) = filled.store();
    if (bad.len() > 0) {
      return (stored, bad);
    }
    filled = stored;
  } else {
    let Fields(_, ks) = filled.top() else {
      return (filled, "Unmatched '}'");
    };
    if (filled.keys.len() > ks) {
      return (filled, "Expected another key-value pair");
    }
  }
  let Fields(vs, ks) = filled.top() else {
    return (filled, "Unmatched '}'");
  };
  let o = json.object_of(keys_from(filled.keys, ks), tail_of(filled.vals, vs));
  let below = filled.pop();
  return (State { ...below, vals: below.vals.truncate(vs), keys: below.keys.truncate(ks), next: [json.JObject(o)] }, "");
}

// The text of a string from the bytes between its quotes.
function unescape(raw: string): (string, string) {
  let out = "";
  let i = 0;
  let from = 0;
  while (i < raw.len()) {
    let b = raw[i];
    if (b < 0x20 as u8) {
      return ("", "Invalid string: control characters from U+0000 through U+001F must be escaped");
    }
    if (b != b'\\') {
      i += 1;
      continue;
    }
    out += slice_unchecked(raw, from, i).to_owned();
    let (text, size, bad) = escape(raw, i + 1);
    if (bad.len() > 0) {
      return ("", bad);
    }
    out += text;
    i += 1 + size;
    from = i;
  }
  out += slice_unchecked(raw, from, raw.len()).to_owned();
  if (utf8.is_valid(out)) {
    return (out, "");
  }
  return (repaired(out), "");
}

// The text of the escape after the backslash at `i - 1`, and its size.
function escape(raw: string, i: i32): (string, i32, string) {
  if (i >= raw.len()) {
    return ("", 0, "Invalid escape");
  }
  let simple = simple_escape(raw[i]);
  if (simple.len() > 0) {
    return (simple, 1, "");
  }
  if (raw[i] != b'u') {
    return ("", 0, "Invalid escape");
  }
  if (i + 5 > raw.len()) {
    return ("", 0, "Invalid \\uXXXX escape");
  }
  let cp = filter.hex4(raw, i + 1);
  if (cp < 0) {
    return ("", 0, "Invalid characters in \\uXXXX escape");
  }
  if (cp < 0xd800 || cp > 0xdbff) {
    return (filter.codepoint_text(cp), 5, "");
  }
  // A high surrogate needs the escape of a low surrogate after it.
  let low = -1;
  if (i + 6 < raw.len() && raw[i + 5] == b'\\' && raw[i + 6] == b'u') {
    low = filter.hex4(raw, i + 7);
  }
  if (low < 0xdc00 || low > 0xdfff) {
    return ("", 0, "Invalid \\uXXXX\\uXXXX surrogate pair escape");
  }
  return (filter.codepoint_text(0x10000 + (cp - 0xd800 << 10) + (low - 0xdc00)), 11, "");
}

function simple_escape(b: u8): string {
  if (b == b'"' || b == b'\\' || b == b'/') {
    return filter.codepoint_text(b as i32);
  }
  if (b == b'b') {
    return filter.codepoint_text(8);
  }
  if (b == b'f') {
    return filter.codepoint_text(12);
  }
  if (b == b'n') {
    return "\n";
  }
  if (b == b'r') {
    return "\r";
  }
  if (b == b't') {
    return "\t";
  }
  return "";
}

// `s` with U+FFFD in the place of each sequence that is not UTF-8.
pub function repaired(s: string): string {
  let out = "";
  let i = 0;
  while (i < s.len()) {
    if let Some((cp, size)) = utf8.decode_at(s, i) {
      out += slice_unchecked(s, i, i + size).to_owned();
      i += size;
      continue;
    }
    out += filter.codepoint_text(0xfffd);
    i += bad_size(s, i);
  }
  return out;
}

// The size of the bad sequence at `i`: its first byte, and the continuation
// bytes that its first byte calls for and that are there.
function bad_size(s: string, i: i32): i32 {
  let b = s[i] as i32;
  let want = 1;
  if (b >= 0xc2 && b < 0xe0) {
    want = 2;
  } else if (b >= 0xe0 && b < 0xf0) {
    want = 3;
  } else if (b >= 0xf0 && b < 0xf5) {
    want = 4;
  }
  let size = 1;
  while (size < want && i + size < s.len() && (s[i + size] as i32 & 0xc0) == 0x80) {
    size += 1;
  }
  return size;
}
