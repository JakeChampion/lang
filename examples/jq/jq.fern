// A jq command line: `jq [-c] [-r] [-n] [-s] [--arg NAME VALUE] FILTER [FILE...]`.
// It reads a stream of JSON values from the files, or from stdin when there
// is none, and writes the outputs of FILTER for each value.
import "std/io";
import "std/json";
import "std/string";
import "./eval";
import "./filter";
import "./input";
import "./output";

struct Options { compact: boolean, raw: boolean, null_input: boolean, slurp: boolean, env: eval.Env, filter: string, files: string[], error: string }

function usage(): i32 {
  eprint("Usage: jq [-c] [-r] [-n] [-s] [--arg NAME VALUE] FILTER [FILE...]");
  return 2;
}

function options(argv: string[]): Options {
  let o = Options { compact: false, raw: false, null_input: false, slurp: false, env: eval.env(), filter: "", files: [], error: "" };
  let have_filter = false;
  let i = 1;
  while (i < argv.len()) {
    let a = argv[i];
    if (a == "--") {
      for rest in i + 1..argv.len() {
        if (!have_filter) {
          o = Options { ...o, filter: argv[rest] };
          have_filter = true;
        } else {
          o = Options { ...o, files: o.files.append(argv[rest]) };
        }
      }
      break;
    }
    if (a == "--arg") {
      if (i + 2 >= argv.len()) {
        return Options { ...o, error: "--arg takes two parameters (e.g. --arg varname value)" };
      }
      o = Options { ...o, env: o.env.with(argv[i + 1], json.JString(argv[i + 2])) };
      i += 3;
      continue;
    }
    if (a.len() > 1 && a[0] == b'-' && a[1] != b'-') {
      for k in 1..a.len() {
        if (a[k] == b'c') {
          o = Options { ...o, compact: true };
        } else if (a[k] == b'r') {
          o = Options { ...o, raw: true };
        } else if (a[k] == b'n') {
          o = Options { ...o, null_input: true };
        } else if (a[k] == b's') {
          o = Options { ...o, slurp: true };
        } else {
          return Options { ...o, error: "Unknown option: " + a };
        }
      }
    } else if (a == "--compact-output") {
      o = Options { ...o, compact: true };
    } else if (a == "--raw-output") {
      o = Options { ...o, raw: true };
    } else if (a == "--null-input") {
      o = Options { ...o, null_input: true };
    } else if (a == "--slurp") {
      o = Options { ...o, slurp: true };
    } else if (a.starts_with("--")) {
      return Options { ...o, error: "Unknown option: " + a };
    } else if (!have_filter) {
      o = Options { ...o, filter: a };
      have_filter = true;
    } else {
      o = Options { ...o, files: o.files.append(a) };
    }
    i += 1;
  }
  if (!have_filter) {
    return Options { ...o, error: "usage" };
  }
  return o;
}

function read_inputs(files: string[]): Result[string, string] {
  if (files.len() == 0) {
    return match (io.read_all_stdin()) {
      Ok(s) => Ok(s),
      Err(e) => Err("Could not read stdin: " + e.message()),
    };
  }
  let all = "";
  for f in files {
    match (read_file(f)) {
      Ok(s) => {
        all += s + "\n";
      },
      Err(e) => {
        return Err("Could not open " + f + ": " + e.message());
      }
    }
  }
  return Ok(all);
}

function write_value(v: json.JsonValue, o: Options): void {
  if (o.raw) {
    if let json.JString(s) = v {
      print(s);
      return;
    }
  }
  if (o.compact) {
    print(output.compact(v));
  } else {
    print(output.pretty(v, 0));
  }
}

// Runs the filter on one input, and gives false when it ended in an error.
function apply(f: filter.Ast, input: json.JsonValue, at: string, o: Options): boolean {
  let out = eval.run(f, input, o.env);
  for v in out.values {
    write_value(v, o);
  }
  if (out.error.len() > 0) {
    eprint("jq: error (at " + at + "): " + out.error);
    return false;
  }
  return true;
}

function main(): i32 {
  let o = options(args());
  if (o.error == "usage") {
    return usage();
  }
  if (o.error.len() > 0) {
    eprint("jq: " + o.error);
    return usage();
  }
  let parsed = filter.parse(o.filter);
  if (parsed.error.len() == 0) {
    let free = filter.undefined_var(parsed.ast, o.env.names);
    if (free.len() > 0) {
      parsed = filter.Parsed { ...parsed, error: "$" + free + " is not defined" };
    }
  }
  if (parsed.error.len() > 0) {
    eprint("jq: error: " + parsed.error + " at <top-level>, line 1:");
    eprint(o.filter);
    eprint("jq: 1 compile error");
    return 3;
  }
  if (o.null_input && !o.slurp) {
    if (apply(parsed.ast, json.JNull, "<unknown>", o)) {
      return 0;
    }
    return 5;
  }
  let text = "";
  match (read_inputs(o.files)) {
    Ok(t) => {
      text = t;
    },
    Err(e) => {
      eprint("jq: error: " + e);
      return 2;
    }
  }
  let st = input.stream(text);
  let failed = false;
  if (o.slurp) {
    let all: json.JsonValue[] = [];
    for t in st.texts {
      all = all.append(t.value);
    }
    let input = json.JArray(all);
    if (o.null_input) {
      input = json.JNull;
    }
    failed = !apply(parsed.ast, input, "<unknown>", o);
  } else {
    // The exit status is that of the last input, as in jq.
    for t in st.texts {
      failed = !apply(parsed.ast, t.value, "<stdin>:" + t.line.to_string(), o);
    }
  }
  if (st.error.len() > 0) {
    eprint("jq: error (at <stdin>:0): Cannot parse input: " + st.error);
    return 2;
  }
  if (failed) {
    return 5;
  }
  return 0;
}
