// The jq port: the parts of the language in this slice, the number formats
// and the output of jq 1.7. Each expected text is the output of jq 1.7 with -c.
import "std/json";
import "std/test";
import "./eval";
import "./filter";
import "./input";
import "./number";
import "./output";

// The compact outputs of `program` on `doc`, one per line, and the error after
// them as "error: MESSAGE".
function outputs(program: string, doc: string): string {
  let parsed = filter.parse(program);
  if (parsed.error.len() > 0) {
    return "compile: " + parsed.error;
  }
  let st = input.stream(doc);
  if (st.error.len() > 0 || st.texts.len() != 1) {
    return "bad input";
  }
  let env = eval.env().with("x", json.JString("1"));
  let out = eval.run(parsed.ast, st.texts[0].value, env);
  let lines: string[] = [];
  for v in out.values {
    lines = lines.append(output.compact(v));
  }
  if (out.error.len() > 0) {
    lines = lines.append("error: " + out.error);
  }
  return lines.join("\n");
}

function check(program: string, doc: string, want: string): test.TestOutcome {
  return test.assert_eq(outputs(program, doc), want);
}

function checks(cases: (string, string, string)[]): test.TestOutcome {
  for c in cases {
    let (program, doc, want) = c;
    let got = outputs(program, doc);
    if (got != want) {
      return test.fail(program + " on " + doc + ": got \"" + got + "\", want \"" + want + "\"");
    }
  }
  return test.pass();
}

function test_paths(): test.TestOutcome {
  return checks([
    (".", "{\"a\":1}", "{\"a\":1}"),
    (".a", "{\"a\":1}", "1"),
    (".a.b.c", "{\"a\":{\"b\":null}}", "null"),
    (".\"a-b\"", "{\"a-b\":1}", "1"),
    (".[\"a\"]", "{\"a\":1}", "1"),
    (".foo[1]", "{\"foo\":[1,2]}", "2"),
    (".a.[0]", "{\"a\":[7]}", "7"),
    (".[-1]", "[0,1,2]", "2"),
    (".[10]", "[0,1,2]", "null"),
    (".[1.7]", "[0,1,2,3]", "1"),
    (".[1.2:3.5]", "[0,1,2,3,4,5]", "[1,2,3]"),
    (".[null:2]", "[1,2,3]", "[1,2]"),
    (".[:-1]", "[1,2,3]", "[1,2]"),
    (".[2:]", "\"abcdé\"", "\"cdé\""),
    (".[]", "{\"a\":1,\"b\":[2]}", "1\n[2]"),
    (".a?", "5", ""),
    ("[.[] | .x?]", "[1,{\"x\":2}]", "[2]"),
    (".[(0,1)]", "[1,2]", "1\n2"),
    (".[] [0,1]", "[[1,2],[3,4]]", "1\n3\n2\n4"),
  ]);
}

function test_construction(): test.TestOutcome {
  return checks([
    ("[]", "null", "[]"),
    ("{}", "null", "{}"),
    ("[.[] , 3]", "[1,2]", "[1,2,3]"),
    ("{x: -1}", "null", "{\"x\":-1}"),
    ("{a, \"b\": 2, (.c): 3}", "{\"a\":1,\"c\":\"x\"}", "{\"a\":1,\"b\":2,\"x\":3}"),
    ("{a: (1,2), b: (3,4)}", "null", "{\"a\":1,\"b\":3}\n{\"a\":1,\"b\":4}\n{\"a\":2,\"b\":3}\n{\"a\":2,\"b\":4}"),
    ("{a:1, b:2, a:3}", "null", "{\"a\":3,\"b\":2}"),
    ("{$x}", "null", "{\"x\":\"1\"}"),
    ("{a: .b | .c}", "{\"b\":{\"c\":5}}", "{\"a\":5}"),
    ("1, 2 | ., 3", "null", "1\n3\n2\n3"),
  ]);
}

function test_comparisons(): test.TestOutcome {
  return checks([
    ("[.[] | . < 1]", "[null,false,true,0,\"a\",[],{}]", "[true,true,true,true,false,false,false]"),
    ("[(1,2) < (1,2)]", "null", "[false,false,true,false]"),
    ("{a:1} == {a:1.0}", "null", "true"),
    ("13911860366432393 == 13911860366432392", "null", "false"),
    (". < {}", "[]", "true"),
    ("[{a:1,b:2} < {a:2,b:1}, {b:1} < {a:2}, [1,2] < [1,2,0], \"ab\" < \"b\"]", "null", "[true,false,true,true]"),
    ("[(true,false) and (true,false)]", "null", "[true,false,false]"),
    ("[(false,true) or (true,false)]", "null", "[true,false,true]"),
    ("true and null", "null", "false"),
  ]);
}

function test_errors(): test.TestOutcome {
  return checks([
    (".a", "5", "error: Cannot index number with string \"a\""),
    (".[0]", "{\"a\":1}", "error: Cannot index object with number"),
    (".[]", "5", "error: Cannot iterate over number (5)"),
    (".[]", "null", "error: Cannot iterate over null (null)"),
    (".[]", "\"aaaaaaaaaaaaaaaaaaaa\"", "error: Cannot iterate over string (\"aaaaaaaaaa...)"),
    (".[null]", "null", "error: Cannot index null with null"),
    (".[1:2]", "{\"a\":1}", "error: Cannot index object with object"),
    ("-.", "\"a\"", "error: string (\"a\") cannot be negated"),
    ("{(.): 1}", "1", "error: Cannot use number (1) as object key"),
    ("1, .a, 3", "5", "1\nerror: Cannot index number with string \"a\""),
    ("[1, .a]", "5", "error: Cannot index number with string \"a\""),
  ]);
}

function test_not_yet(): test.TestOutcome {
  return checks([
    ("1 + 2", "null", "compile: arithmetic " + filter.NOT_YET),
    ("[.[] // 1]", "null", "compile: the alternative operator " + filter.NOT_YET),
    ("map(.)", "null", "compile: the function map " + filter.NOT_YET),
    ("\"\\(1)\"", "null", "compile: string interpolation " + filter.NOT_YET),
    (". as $v | $v", "null", "compile: variable binding " + filter.NOT_YET),
    ("if . then 1 else 2 end", "null", "compile: 'if' " + filter.NOT_YET),
  ]);
}

function test_numbers(): test.TestOutcome {
  let literals = [("1e2", "1E+2"), ("1.5e-10", "1.5E-10"), ("0.0000001", "1E-7"), ("0.000001", "0.000001"), ("-0", "-0"), ("0.10", "0.10"), ("12.30e1", "123.0"), ("00", "0"), ("1.0e0", "1.0"), ("0e5", "0E+5"), ("123456789012345678901234567890", "123456789012345678901234567890")];
  for c in literals {
    let (text, want) = c;
    if (number.canonical(text) != want) {
      return test.fail("canonical " + text + ": got " + number.canonical(text) + ", want " + want);
    }
  }
  return checks([
    ("[.[] | -.]", "[1, 1.5, 1e17, 1e-7, -0, 123456789012345678]", "[-1,-1.5,-1e+17,-1e-07,0,-123456789012345680]"),
    ("[-(1e1000), 1e1000, 1.000]", "null", "[-1.7976931348623157e+308,1E+1000,1.000]"),
    (".", "[1e2, 12.30e1, 0.0001]", "[1E+2,123.0,0.0001]"),
  ]);
}

function test_output(): test.TestOutcome {
  let st = input.stream("{\"b\":[1,{}],\"a\":[],\"c\":\"x\\u0001\\u007fé/\\\"\\\\\"}");
  let want = "{\n  \"b\": [\n    1,\n    {}\n  ],\n  \"a\": [],\n  \"c\": \"x\\u0001\\u007fé/\\\"\\\\\"\n}";
  return test.assert_eq(output.pretty(st.texts[0].value, 0), want);
}

function test_stream(): test.TestOutcome {
  let st = input.stream("﻿1 2\n{\"a\":\n1}[3]\n\n\"x\"");
  let got: string[] = [];
  for t in st.texts {
    got = got.append(output.compact(t.value) + "@" + t.line.to_string());
  }
  return test.assert_eq(got.join(" "), "1@1 2@1 {\"a\":1}@3 [3]@3 \"x\"@4");
}

function test_undefined_var(): test.TestOutcome {
  let parsed = filter.parse("[$x, {$y}]");
  return test.assert_eq(filter.undefined_var(parsed.ast, ["x"]), "y");
}

function main(): i32 {
  let r = test.new("jq");
  r = r.it("paths, slices and iteration", test_paths);
  r = r.it("array and object construction", test_construction);
  r = r.it("comparisons, and, or", test_comparisons);
  r = r.it("error messages", test_errors);
  r = r.it("the parts that this slice leaves out", test_not_yet);
  r = r.it("number literals and computed numbers", test_numbers);
  r = r.it("pretty output", test_output);
  r = r.it("the input stream and its lines", test_stream);
  r = r.it("undefined variables", test_undefined_var);
  r = r.it("one check", (): test.TestOutcome => check(".a", "{\"a\":[1]}", "[1]"));
  return r.finish();
}
