// The jq language: the lexer, the parser and the evaluator. A port of the
// documented behaviour of jq 1.7 (https://jqlang.github.io/jq/manual/v1.7/).
//
// A filter takes one JSON value and gives zero or more values. The evaluator
// collects the outputs of a filter in an array. An error stops the filter, and
// the outputs before it stay, as they do in jq.
import "std/json";
import "std/string";
import "std/utf8";
import "./number";
import "./output";
import "./reader";

pub enum Ast {
  Identity,
  Literal(json.JsonValue),
  Var(string),
  Index(Ast, Ast),
  Slice(Ast, Ast, Ast),
  Iterate(Ast),
  // `?` after one step of a path: an error of that step gives no output.
  Optional(Ast),
  // `e?` and `try e`: an error of `e` stops `e` with no error.
  Try(Ast),
  Pipe(Ast, Ast),
  Comma(Ast, Ast),
  Collect(Ast),
  EmptyArray,
  Object(Ast[], Ast[]),
  Compare(string, Ast, Ast),
  Arith(string, Ast, Ast),
  Alt(Ast, Ast),
  // A call. `true` tells that the call is the last step of the body of its
  // function, or of the program: each output of the call is an output of
  // that body.
  Call(string, Ast[], boolean),
  Catch(Ast, Ast),
  Interp(string, string[], Ast[]),
  Format(string),
  Update(string, Ast, Ast),
  // `def name(params): body; rest`. A parameter with a `$` is a variable also.
  Def(string, string[], Ast, Ast),
  If(Ast, Ast, Ast),
  Bind(Ast, string, Ast),
  Reduce(Ast, string, Ast, Ast),
  Foreach(Ast, string, Ast, Ast, Ast),
  And(Ast, Ast),
  Or(Ast, Ast),
  Negate(Ast),
  // `label $name | body`. A `break $name` in the body stops the body.
  Label(string, Ast),
  Break(string),
}

// ---- Lexer ----

pub enum Tok {
  TDot,
  TField(string),
  TIdent(string),
  TVar(string),
  TNumber(string),
  TString(string),
  TInterp(string[], string[]),
  TFormat(string),
  TPunct(string),
  // `$__loc__`, with its line.
  TLoc(i32),
  TEnd,
}

struct Lexed { toks: Tok[], offs: i32[], error: string, at: i32 }

function is_ident_start(b: u8): boolean {
  return b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z' || b == b'_';
}

function is_ident_char(b: u8): boolean {
  return is_ident_start(b) || b >= b'0' && b <= b'9';
}

function is_digit(b: u8): boolean {
  return b >= b'0' && b <= b'9';
}

function ident_end(s: string, i: i32): i32 {
  let j = i;
  while (j < s.len() && (is_ident_char(s[j]) || j + 1 < s.len() && s[j] == b':' && s[j + 1] == b':')) {
    if (s[j] == b':') {
      j += 2;
    } else {
      j += 1;
    }
  }
  return j;
}

function number_end(s: string, i: i32): i32 {
  let j = i;
  while (j < s.len() && is_digit(s[j])) {
    j += 1;
  }
  if (j < s.len() && s[j] == b'.') {
    j += 1;
    while (j < s.len() && is_digit(s[j])) {
      j += 1;
    }
  }
  if (j < s.len() && (s[j] == b'e' || s[j] == b'E')) {
    let k = j + 1;
    if (k < s.len() && (s[k] == b'+' || s[k] == b'-')) {
      k += 1;
    }
    if (k < s.len() && is_digit(s[k])) {
      j = k;
      while (j < s.len() && is_digit(s[j])) {
        j += 1;
      }
    }
  }
  return j;
}

function text(s: string, from: i32, to: i32): string {
  return slice_unchecked(s, from, to).to_owned();
}

// A string literal. `texts` holds the text before each `\(...)`, and
// `sources` holds the program between each pair of parentheses. `at` is
// the place of an error.
struct Scanned { value: string, end: i32, error: string, texts: string[], sources: string[], at: i32 }

// The offset of the `)` that ends the interpolation whose program starts at
// `i`, or -1.
function interp_end(s: string, i: i32): i32 {
  let depth = 1;
  let k = i;
  while (k < s.len()) {
    if (s[k] == b'"') {
      k = string_end(s, k);
      if (k < 0) {
        return -1;
      }
      continue;
    }
    if (s[k] == b'(') {
      depth += 1;
    } else if (s[k] == b')') {
      depth -= 1;
      if (depth == 0) {
        return k;
      }
    }
    k += 1;
  }
  return -1;
}

// The offset after the string literal whose quote is at `i`, or -1.
function string_end(s: string, i: i32): i32 {
  let k = i + 1;
  while (k < s.len()) {
    if (s[k] == b'"') {
      return k + 1;
    }
    if (s[k] != b'\\') {
      k += 1;
    } else if (k + 1 < s.len() && s[k + 1] == b'(') {
      let e = interp_end(s, k + 2);
      if (e < 0) {
        return -1;
      }
      k = e + 1;
    } else {
      k += 2;
    }
  }
  return -1;
}

// The end of the run of escapes at `j`, as the lexer of jq finds it: `\`
// and a byte that is not `u` or `(`, or `\u` and up to four letters and
// digits. A byte of more than one byte of UTF-8 stays whole.
function escapes_end(s: string, j0: i32): i32 {
  let j = j0;
  while (j + 1 < s.len() && s[j] == b'\\' && s[j + 1] != b'(') {
    if (s[j + 1] == b'u') {
      j += 2;
      let n = 0;
      while (n < 4 && j < s.len() && is_alnum(s[j])) {
        j += 1;
        n += 1;
      }
    } else {
      j += 1 + utf8_width(s[j + 1]);
    }
  }
  return j;
}

function utf8_width(b: u8): i32 {
  if (b < 0xc0u8) {
    return 1;
  }
  if (b < 0xe0u8) {
    return 2;
  }
  if (b < 0xf0u8) {
    return 3;
  }
  return 4;
}

function is_alnum(b: u8): boolean {
  return b >= b'0' && b <= b'9' || b >= b'a' && b <= b'z' || b >= b'A' && b <= b'Z';
}

// The string literal that starts at the quote at `i`. As in jq, the JSON
// reader reads each run of escapes in quotes, and gives its errors.
function scan_string(s: string, i: i32): Scanned {
  let texts: string[] = [];
  let sources: string[] = [];
  let out = "";
  let j = i + 1;
  let run = j;
  while (j < s.len()) {
    let b = s[j];
    if (b == b'"') {
      return Scanned { value: out + text(s, run, j), end: j + 1, error: "", texts: texts, sources: sources, at: -1 };
    }
    if (b != b'\\') {
      j += 1;
      continue;
    }
    out += text(s, run, j);
    if (j + 1 >= s.len()) {
      break;
    }
    let e = s[j + 1];
    j += 2;
    if (e == b'(') {
      let close = interp_end(s, j);
      if (close < 0) {
        return Scanned { value: "", end: j, error: "syntax error, unexpected QQSTRING_START", texts: [], sources: [], at: -1 };
      }
      texts = texts.append(out);
      sources = sources.append(text(s, j, close));
      out = "";
      j = close + 1;
      run = j;
      continue;
    }
    let start = j - 2;
    let end = escapes_end(s, start);
    let quoted = "\"" + text(s, start, end) + "\"";
    let r = reader.read(quoted);
    if (r.error.len() > 0 || r.values.len() != 1) {
      return Scanned { value: "", end: end, error: r.error + " (while parsing '" + quoted + "')", texts: [], sources: [], at: start };
    }
    if let json.JString(v) = r.values[0].value {
      out += v;
    }
    j = end;
    run = j;
  }
  return Scanned { value: "", end: j, error: "unterminated string literal", texts: [], sources: [], at: -1 };
}

function two_char_punct(s: string, i: i32): string {
  if (i + 1 >= s.len()) {
    return "";
  }
  if (i + 2 < s.len() && text(s, i, i + 3) == "//=") {
    return "//=";
  }
  let p = text(s, i, i + 2);
  if (p == "==" || p == "!=" || p == "<=" || p == ">=" || p == "//" || p == "|=" || p == "+=" || p == "-=" || p == "*=" || p == "/=" || p == "%=" || p == "?/") {
    return p;
  }
  return "";
}

// The line of the byte `at` of `s`. The first line is 1.
function line_of(s: string, at: i32): i32 {
  let line = 1;
  for i in 0..at {
    if (s[i] == b'\n') {
      line += 1;
    }
  }
  return line;
}

// The value of `$__loc__` on `line` of `file`.
function location(file: string, line: i32): Ast {
  let o = json.object().insert("file", json.JString(file));
  return Literal(json.JObject(o.insert("line", json.JNumber(number.integer(line as i64)))));
}

pub function lex(s: string): Lexed {
  let toks: Tok[] = [];
  let offs: i32[] = [];
  let opens: string[] = [];
  let i = 0;
  while (i < s.len()) {
    let start = i;
    let b = s[i];
    if (b == b' ' || b == b'\t' || b == b'\n' || b == b'\r') {
      i += 1;
    } else if (b == b'#') {
      while (i < s.len() && s[i] != b'\n') {
        i += 1;
      }
    } else if (b == b'.') {
      if (i + 1 < s.len() && is_ident_start(s[i + 1])) {
        let e = ident_end(s, i + 1);
        toks = toks.append(TField(text(s, i + 1, e)));
        i = e;
      } else if (i + 1 < s.len() && s[i + 1] == b'.') {
        toks = toks.append(TPunct(".."));
        i += 2;
      } else if (i + 1 < s.len() && is_digit(s[i + 1])) {
        let e = number_end(s, i);
        toks = toks.append(TNumber("0" + text(s, i, e)));
        i = e;
      } else {
        toks = toks.append(TDot);
        i += 1;
      }
    } else if (b == b'$') {
      let e = ident_end(s, i + 1);
      let name = text(s, i + 1, e);
      toks = toks.append(if (name == "__loc__") { TLoc(line_of(s, i)) } else { TVar(name) });
      i = e;
    } else if (is_ident_start(b)) {
      let e = ident_end(s, i);
      toks = toks.append(TIdent(text(s, i, e)));
      i = e;
    } else if (is_digit(b)) {
      let e = number_end(s, i);
      toks = toks.append(TNumber(text(s, i, e)));
      i = e;
    } else if (b == b'"') {
      let sc = scan_string(s, i);
      if (sc.error.len() > 0) {
        return Lexed { toks: toks, offs: offs, error: sc.error, at: if (sc.at >= 0) { sc.at } else { 0 } };
      }
      if (sc.sources.len() > 0) {
        toks = toks.append(TInterp(sc.texts.append(sc.value), sc.sources));
      } else {
        toks = toks.append(TString(sc.value));
      }
      i = sc.end;
    } else if (b == b'@') {
      let e = ident_end(s, i + 1);
      toks = toks.append(TFormat(text(s, i + 1, e)));
      i = e;
    } else {
      let two = two_char_punct(s, i);
      if (two.len() > 0) {
        toks = toks.append(TPunct(two));
        i += two.len();
      } else {
        let c = text(s, i, i + 1);
        if (c == "(" || c == "[" || c == "{") {
          opens = opens.append(c);
        } else if (c == ")" || c == "]" || c == "}") {
          let want = if (c == ")") { "(" } else if (c == "]") { "[" } else { "{" };
          if (opens.len() == 0 || opens[opens.len() - 1] != want) {
            c = "INVALID_CHARACTER";
          } else {
            opens = opens.truncate(opens.len() - 1);
          }
        }
        toks = toks.append(TPunct(c));
        i += 1;
      }
    }
    while (offs.len() < toks.len()) {
      offs = offs.append(start);
    }
  }
  // jq places the end of the program at the start of its last token.
  let end = if (offs.len() > 0) { offs[offs.len() - 1] } else { 0 };
  return Lexed { toks: toks.append(TEnd), offs: offs.append(end), error: "", at: 0 };
}

// ---- Parser ----

// The filter of a program, or its error and the offset of the error. `defs`
// holds the functions that the program defines at its top level, as
// "name/arguments".
pub struct Parsed { ast: Ast, error: string, at: i32, defs: string[], undefined: string[], undefined_at: i32[] }

// `defs` holds each function that a `def` gave, as "name/arguments". A
// library has definitions and no program after them. `file` names the
// program in `$__loc__`.
// `undefined` holds the message of each call of a function that is not
// defined, and `undefined_at` its offset. jq reports each of them.
// `ended` is true when the definitions of a library reach the end of the
// text with no main expression.
struct P { toks: Tok[], offs: i32[], at: i32, error: string, err_at: i32, defs: string[], library: boolean, file: string, check: boolean, undefined: string[], undefined_at: i32[], ended: boolean }

function (p: P) peek(): Tok {
  return p.toks[p.at];
}

function (p: P) advance(): P {
  return P { ...p, at: p.at + 1 };
}

function (p: P) fail(message: string): P {
  if (p.error.len() > 0) {
    return p;
  }
  let at = 0;
  if (p.at < p.offs.len()) {
    at = p.offs[p.at];
  }
  return P { ...p, error: message, err_at: at };
}

function (p: P) is_punct(s: string): boolean {
  if let TPunct(x) = p.peek() {
    return x == s;
  }
  return false;
}

function (p: P) is_ident(s: string): boolean {
  if let TIdent(x) = p.peek() {
    return x == s;
  }
  return false;
}

function (p: P) expect(s: string): P {
  if (p.is_punct(s)) {
    return p.advance();
  }
  return p.fail(unexpected(p.peek()));
}

// `s` at `p`, or the error of bison that names the one token it expects.
function (p: P) expecting(s: string): P {
  if (p.is_punct(s)) {
    return p.advance();
  }
  return p.fail(unexpected(p.peek()) + ", expecting '" + s + "'");
}

function (p: P) expect_word(s: string): P {
  if (p.is_ident(s)) {
    return p.advance();
  }
  return p.fail(unexpected(p.peek()));
}

// The name of a token in a message of the parser of jq, which bison makes.
function describe(t: Tok): string {
  return match (t) {
    TDot => "'.'",
    TField(_) => "FIELD",
    TIdent(x) => if (KEYWORDS.contains(x)) { x } else { "IDENT" },
    TVar(_) => "BINDING",
    TNumber(_) => "LITERAL",
    TString(_) => "QQSTRING_START",
    TInterp(_, _) => "QQSTRING_START",
    TFormat(_) => "FORMAT",
    TPunct(x) => if (x.len() == 1) { "'" + x + "'" } else { x },
    TLoc(_) => "\"$__loc__\"",
    TEnd => "end of file",
  };
}

// The words that jq reads as keywords.
const KEYWORDS: string[] = ["def", "if", "then", "elif", "else", "end", "as", "reduce", "foreach", "try", "catch", "label", "import", "include", "module", "and", "or", "break", "__loc__"];

// The end of a syntax error after a whole program.
const END_EXPECTED: string = ", expecting end of file";

// The note that jq adds to each syntax error.
pub const QUOTING: string = " (Unix shell quoting issues?)";

// The filter of `program`, after the functions that the port has as jq
// text. A unit test reads a program so.
pub function parse(program: string): Parsed {
  let parsed = parse_in(program, [], "<top-level>", false, 0);
  if (parsed.error.len() > 0) {
    return parsed;
  }
  if (parsed.undefined.len() > 0) {
    return Parsed { ...parsed, error: parsed.undefined[0], at: parsed.undefined_at[0] };
  }
  return Parsed { ...parsed, ast: defined_before(prelude(), parsed.ast) };
}

// The definitions of the functions that the port has as jq text, before
// the filter `.`.
pub function prelude(): Ast {
  return parse_in(PRELUDE, [], "<builtin>", false, 0).ast;
}

// The functions that the port has as jq text, as jq has them.
const PRELUDE: string = "def abs: if . < 0 then - . else . end;"
  + "def transpose: [range(0; map(length) | max // 0) as $i | [.[][$i]]];"
  + "def pick(f): . as $in | reduce path(f) as $a (null; setpath($a; $in | getpath($a)));"
  + "def debug(msgs): (msgs | debug | empty), .;"
  + "def INDEX(stream; f): reduce stream as $row ({}; .[$row | f | tostring] = $row);"
  + "def INDEX(f): INDEX(.[]; f);"
  + "def JOIN($idx; f): [.[] | [., $idx[f]]];"
  + "def JOIN($idx; stream; f): stream | [., $idx[f]];"
  + "def JOIN($idx; stream; f; g): stream | [., $idx[f]] | g;"
  + "def todateiso8601: strftime(\"%Y-%m-%dT%H:%M:%SZ\");"
  + "def fromdateiso8601: strptime(\"%Y-%m-%dT%H:%M:%SZ\") | mktime;"
  + "def todate: todateiso8601;"
  + "def fromdate: fromdateiso8601;"
  + "def combinations: if length == 0 then [] else .[0][] as $x | (.[1:] | combinations) as $y | [$x] + $y end;"
  + "def combinations(n): . as $dot | [range(n) | $dot] | combinations;"
  + "def truncate_stream(stream): . as $n | null | stream | . as $input"
  + "  | if (.[0] | length) > $n then setpath([0]; $input[0][$n:]) else empty end;"
  + "def fromstream(i): {x: null, e: false} as $init"
  + "  | foreach i as $i ($init;"
  + "      if .e then $init else . end"
  + "      | if $i | length == 2"
  + "        then setpath([\"e\"]; $i[0] | length == 0) | setpath([\"x\"] + $i[0]; $i[1])"
  + "        else setpath([\"e\"]; $i[0] | length == 1) end;"
  + "      if .e then .x else empty end);"
  + "def tostream: path(def r: (.[]? | r), .; r) as $p | getpath($p) | reduce path(.[]?) as $q ([$p, .]; [$p + $q]);"
  + "def match(re; mode): _match_impl(re; mode; false) | .[];"
  + "def match($val): ($val | type) as $vt | if $vt == \"string\" then match($val; null)"
  + "  elif $vt == \"array\" and ($val | length) > 1 then match($val[0]; $val[1])"
  + "  elif $vt == \"array\" and ($val | length) > 0 then match($val[0]; null)"
  + "  else error($vt + \" not a string or array\") end;"
  + "def test(re; mode): _match_impl(re; mode; true);"
  + "def test($val): ($val | type) as $vt | if $vt == \"string\" then test($val; null)"
  + "  elif $vt == \"array\" and ($val | length) > 1 then test($val[0]; $val[1])"
  + "  elif $vt == \"array\" and ($val | length) > 0 then test($val[0]; null)"
  + "  else error($vt + \" not a string or array\") end;"
  + "def capture(re; mods): match(re; mods) | reduce (.captures | .[] | select(.name != null) | {(.name): .string}) as $pair ({}; . + $pair);"
  + "def capture($val): ($val | type) as $vt | if $vt == \"string\" then capture($val; null)"
  + "  elif $vt == \"array\" and ($val | length) > 1 then capture($val[0]; $val[1])"
  + "  elif $vt == \"array\" and ($val | length) > 0 then capture($val[0]; null)"
  + "  else error($vt + \" not a string or array\") end;"
  + "def scan($re; $flags): match($re; \"g\" + $flags) | if (.captures | length > 0) then [.captures | .[] | .string] else .string end;"
  + "def scan($re): scan($re; null);"
  + "def _nwise($n): def n: if length <= $n then . else .[0:$n], (.[$n:] | n) end; n;"
  + "def _nwise(a; $n): a | _nwise($n);"
  + "def splits($re; flags): . as $s | [match($re; \"g\" + flags) | (.offset, .offset + .length)]"
  + "  | [0] + . + [$s | length] | _nwise(2) | $s[.[0]:.[1]];"
  + "def splits($re): splits($re; null);"
  + "def split($re; flags): [splits($re; flags)];"
  + "def sub($re; s; $flags): . as $in"
  + "  | (reduce match($re; $flags) as $edit ({result: [], previous: 0};"
  + "      $in[.previous: ($edit | .offset)] as $gap"
  + "      | [reduce ($edit | .captures | .[] | select(.name != null) | {(.name): .string}) as $pair ({}; . + $pair) | s] as $inserts"
  + "      | reduce range(0; $inserts | length) as $ix (.; .result[$ix] += $gap + $inserts[$ix])"
  + "      | .previous = ($edit | .offset + .length))"
  + "    | .result[] + $in[.previous:])"
  + "  // $in;"
  + "def sub($re; s): sub($re; s; \"\");"
  + "def gsub($re; s; flags): sub($re; s; flags + \"g\");"
  + "def gsub($re; s): sub($re; s; \"g\");"
  + "def IN(s): any(s == .; .);"
  + "def IN(src; s): any(src == s; .);"
  + "def bsearch($target):"
  + "  if length == 0 then -1"
  + "  elif length == 1 then (if $target == .[0] then 0 elif $target < .[0] then -1 else -2 end)"
  + "  else . as $in | [0, length - 1, null]"
  + "    | until(.[0] > .[1];"
  + "        if .[2] != null then (.[1] = -1)"
  + "        else (((.[1] + .[0]) / 2) | floor) as $mid | $in[$mid] as $monkey"
  + "          | if $monkey == $target then (.[2] = $mid)"
  + "            elif .[0] == .[1] then (.[1] = -1)"
  + "            elif $monkey < $target then (.[0] = ($mid + 1))"
  + "            else (.[1] = ($mid - 1)) end"
  + "        end)"
  + "    | if .[2] == null then (if $in[.[0]] < $target then (-2 - .[0]) else (-1 - .[0]) end) else .[2] end"
  + "  end;"
  + ".";

// The library `program` from the token `skip`, read with no check of the
// functions that it calls. `modulemeta` reads a module so, as jq does.
pub function parse_unchecked(program: string, file: string, skip: i32): Parsed {
  let lx = lex(program);
  if (lx.error.len() > 0) {
    return Parsed { ast: Identity, error: lx.error, at: lx.at, defs: [], undefined: [], undefined_at: [] };
  }
  let p = P { toks: lx.toks, offs: lx.offs, at: skip, error: "", err_at: 0, defs: [], library: true, file: file, check: false, undefined: [], undefined_at: [], ended: false };
  if let TEnd = p.peek() {
    return Parsed { ast: Identity, error: "", at: 0, defs: [], undefined: [], undefined_at: [] };
  }
  let (ast, q) = parse_pipe(p);
  if (q.error.len() > 0) {
    return Parsed { ast: Identity, error: q.error, at: q.err_at, defs: [], undefined: [], undefined_at: [] };
  }
  return Parsed { ast: marked(ast, true), error: "", at: 0, defs: top_defs(ast), undefined: q.undefined, undefined_at: q.undefined_at };
}

// `f` with the mark of each call. `last` tells that each output of `f` is an
// output of the body around it. An argument of a call is not a body, because
// a `$` parameter takes its outputs one at a time.
function marked(f: Ast, last: boolean): Ast {
  return match (f) {
    Call(name, args, _) => Call(name, all_marked(args), last),
    Pipe(a, b) => Pipe(marked(a, false), marked(b, last)),
    Comma(a, b) => Comma(marked(a, last), marked(b, last)),
    If(cond, yes, no) => If(marked(cond, false), marked(yes, last), marked(no, last)),
    Def(name, params, body, rest) => Def(name, params, marked(body, true), marked(rest, last)),
    Bind(source, name, body) => Bind(marked(source, false), name, marked(body, last)),
    Label(name, body) => Label(name, marked(body, last)),
    _ => marked_parts(f),
  };
}

// `f` with the marks of its parts, when no part gives the outputs of `f`.
function marked_parts(f: Ast): Ast {
  return match (f) {
    Index(a, b) => Index(marked(a, false), marked(b, false)),
    Slice(a, b, c) => Slice(marked(a, false), marked(b, false), marked(c, false)),
    Iterate(a) => Iterate(marked(a, false)),
    Optional(a) => Optional(marked(a, false)),
    Try(a) => Try(marked(a, false)),
    Collect(a) => Collect(marked(a, false)),
    Object(keys, values) => Object(all_marked(keys), all_marked(values)),
    Compare(op, a, b) => Compare(op, marked(a, false), marked(b, false)),
    Arith(op, a, b) => Arith(op, marked(a, false), marked(b, false)),
    Alt(a, b) => Alt(marked(a, false), marked(b, false)),
    Catch(a, b) => Catch(marked(a, false), marked(b, false)),
    Interp(name, texts, parts) => Interp(name, texts, all_marked(parts)),
    Update(op, a, b) => Update(op, marked(a, false), marked(b, false)),
    Reduce(source, name, init, update) => Reduce(marked(source, false), name, marked(init, false), marked(update, false)),
    Foreach(source, name, init, update, extract) => Foreach(marked(source, false), name, marked(init, false), marked(update, false), marked(extract, false)),
    And(a, b) => And(marked(a, false), marked(b, false)),
    Or(a, b) => Or(marked(a, false), marked(b, false)),
    Negate(a) => Negate(marked(a, false)),
    _ => f,
  };
}

function all_marked(fs: Ast[]): Ast[] {
  let out: Ast[] = [];
  for f in fs {
    out = out.append(marked(f, false));
  }
  return out;
}

// The functions that the definitions at the start of `f` give, as
// "name/arguments".
function top_defs(f: Ast): string[] {
  let out: string[] = [];
  let at = f;
  while (true) {
    let Def(name, params, _, rest) = at else {
      return out;
    };
    out = out.append(name + "/" + params.len().to_string());
    at = rest;
  }
  return out;
}

// `program` after each definition of `defs`.
function defined_before(defs: Ast, program: Ast): Ast {
  if let Def(name, params, body, rest) = defs {
    return Def(name, params, body, defined_before(rest, program));
  }
  return program;
}

// The filter of `program` from the token `skip`, which can call the
// functions of `defs`. A library gives its definitions before `.`.
pub function parse_in(program: string, defs: string[], file: string, library: boolean, skip: i32): Parsed {
  let lx = lex(program);
  if (lx.error.len() > 0) {
    return Parsed { ast: Identity, error: lx.error, at: lx.at, defs: [], undefined: [], undefined_at: [] };
  }
  let p = P { toks: lx.toks, offs: lx.offs, at: skip, error: "", err_at: 0, defs: defs, library: library, file: file, check: true, undefined: [], undefined_at: [], ended: false };
  if (library) {
    if let TEnd = p.peek() {
      return Parsed { ast: Identity, error: "", at: 0, defs: [], undefined: [], undefined_at: [] };
    }
  }
  let (ast, q) = parse_pipe(p);
  if (q.error.len() == 0) {
    if let TEnd = q.peek() {
      // As jq_parse_library does, a library that parses and has a main
      // expression gets an error with no place.
      if (library && !q.ended) {
        return Parsed { ast: Identity, error: MAIN_IN_LIBRARY, at: -1, defs: [], undefined: [], undefined_at: [] };
      }
      return Parsed { ast: marked(ast, true), error: "", at: 0, defs: top_defs(ast), undefined: q.undefined, undefined_at: q.undefined_at };
    }
    q = q.fail(unexpected(q.peek()) + END_EXPECTED);
  } else if (q.err_at == p.offs[skip] && q.error == unexpected(p.peek())) {
    // An empty program is `.`, so bison reads a keyword at the start as a
    // token after a whole program.
    if let TIdent(x) = p.peek() {
      if (KEYWORDS.contains(x)) {
        q = P { ...q, error: q.error + END_EXPECTED };
      }
    }
  }
  return Parsed { ast: Identity, error: q.error, at: q.err_at, defs: [], undefined: [], undefined_at: [] };
}

function unexpected(t: Tok): string {
  return "syntax error, unexpected " + describe(t);
}

function parse_pipe(p: P): (Ast, P) {
  let (left, q) = parse_comma(p);
  if (q.error.len() == 0 && q.is_punct("|")) {
    let (right, r) = parse_pipe(q.advance());
    return (Pipe(left, right), r);
  }
  return (left, q);
}

function parse_comma(p: P): (Ast, P) {
  let (left, q) = parse_alt(p);
  while (q.error.len() == 0 && q.is_punct(",")) {
    let (right, r) = parse_alt(q.advance());
    left = Comma(left, right);
    q = r;
  }
  return (left, q);
}

// The operator of an update at `p`: "=", "|=", or the arithmetic operator of
// `+=` and the others. It is "" when `p` is not at an update.
function update_op(p: P): string {
  if let TPunct(x) = p.peek() {
    if (x == "=" || x == "|=") {
      return x;
    }
    if (x == "+=" || x == "-=" || x == "*=" || x == "/=" || x == "%=") {
      return text(x, 0, 1);
    }
    if (x == "//=") {
      return "//";
    }
  }
  return "";
}

// An update does not group: `.a = .b = 1` is a syntax error.
function parse_update(p: P): (Ast, P) {
  let (left, q) = parse_or(p);
  let op = update_op(q);
  if (q.error.len() > 0 || op.len() == 0) {
    return (left, q);
  }
  let (right, r) = parse_or(q.advance());
  if (r.error.len() == 0 && update_op(r).len() > 0) {
    return (left, r.fail(unexpected(r.peek())));
  }
  return (Update(op, left, right), r);
}

function parse_alt(p: P): (Ast, P) {
  let (left, q) = parse_update(p);
  if (q.error.len() == 0 && q.is_punct("//")) {
    let (right, r) = parse_alt(q.advance());
    return (Alt(left, right), r);
  }
  return (left, q);
}

function parse_or(p: P): (Ast, P) {
  let (left, q) = parse_and(p);
  while (q.error.len() == 0 && q.is_ident("or")) {
    let (right, r) = parse_and(q.advance());
    left = Or(left, right);
    q = r;
  }
  return (left, q);
}

function parse_and(p: P): (Ast, P) {
  let (left, q) = parse_compare(p);
  while (q.error.len() == 0 && q.is_ident("and")) {
    let (right, r) = parse_compare(q.advance());
    left = And(left, right);
    q = r;
  }
  return (left, q);
}

function compare_op(p: P): string {
  if let TPunct(x) = p.peek() {
    if (x == "==" || x == "!=" || x == "<" || x == "<=" || x == ">" || x == ">=") {
      return x;
    }
  }
  return "";
}

function parse_compare(p: P): (Ast, P) {
  let (left, q) = parse_add(p);
  let op = compare_op(q);
  if (q.error.len() > 0 || op.len() == 0) {
    return (left, q);
  }
  let (right, r) = parse_add(q.advance());
  if (compare_op(r).len() > 0) {
    return (left, r.fail(unexpected(r.peek())));
  }
  return (Compare(op, left, right), r);
}

function parse_add(p: P): (Ast, P) {
  let (left, q) = parse_multiply(p);
  while (q.error.len() == 0 && (q.is_punct("+") || q.is_punct("-"))) {
    let op = if (q.is_punct("+")) { "+" } else { "-" };
    let (right, r) = parse_multiply(q.advance());
    left = Arith(op, left, right);
    q = r;
  }
  return (left, q);
}

function multiply_op(p: P): string {
  if let TPunct(x) = p.peek() {
    if (x == "*" || x == "/" || x == "%") {
      return x;
    }
  }
  return "";
}

function parse_multiply(p: P): (Ast, P) {
  let (left, q) = parse_unary(p);
  while (q.error.len() == 0 && multiply_op(q).len() > 0) {
    let op = multiply_op(q);
    let (right, r) = parse_unary(q.advance());
    left = Arith(op, left, right);
    q = r;
  }
  return (left, q);
}

// The minus takes the product after it, so `-1 * 2` is `-(1 * 2)`.
function parse_unary(p: P): (Ast, P) {
  if (p.is_punct("-")) {
    let (inner, q) = parse_multiply(p.advance());
    return (Negate(inner), q);
  }
  let (source, q) = if (p.is_ident("try")) { parse_try(p.advance()) } else { parse_postfix(p) };
  if (q.error.len() == 0 && q.is_ident("as")) {
    let held = "*" + q.at.to_string();
    let (alts, r) = parse_binding(q, held);
    let (body, t) = parse_pipe(r.expecting("|"));
    return (bound(source, held, alts, body), t);
  }
  return (source, q);
}

// The body of a `try` at `p`, and its `catch` when it has one. `try e` is
// `e?`.
function parse_try(p: P): (Ast, P) {
  let (body, q) = parse_try_operand(p);
  if (q.error.len() == 0 && q.is_ident("catch")) {
    let (handler, r) = parse_try_operand(q.advance());
    return (Catch(body, handler), r);
  }
  return (Try(body), q);
}

function parse_try_operand(p: P): (Ast, P) {
  if (p.is_ident("try")) {
    return parse_try(p.advance());
  }
  if (p.is_punct("-")) {
    let (inner, q) = parse_try_operand(p.advance());
    return (Negate(inner), q);
  }
  return parse_postfix(p);
}

// One variable of a pattern, and the filter that gives its value.
struct Binding { name: string, source: Ast }

// `as PATTERN` at `p`, and each `?// PATTERN` after it. Each pattern takes
// the value of the variable `held`.
function parse_binding(p: P, held: string): (Binding[][], P) {
  let alts: Binding[][] = [];
  let q = p.expect_word("as");
  while (q.error.len() == 0) {
    let (found, r) = parse_pattern(q, Var(held), []);
    alts = alts.append(found);
    q = r;
    if (!q.is_punct("?/")) {
      break;
    }
    q = q.advance().expect("/");
  }
  return (alts, q);
}

// The pattern at `p` for the value of `source`. An array or an object keeps
// its value in a variable that no program can name.
function parse_pattern(p: P, source: Ast, found: Binding[]): (Binding[], P) {
  if let TVar(v) = p.peek() {
    return (found.append(Binding { name: v, source: source }), p.advance());
  }
  let held = "*" + p.at.to_string();
  let all = found.append(Binding { name: held, source: source });
  if (p.is_punct("[")) {
    return parse_array_pattern(p.advance(), Var(held), all);
  }
  if (p.is_punct("{")) {
    return parse_object_pattern(p.advance(), Var(held), all);
  }
  return (found, p.fail(unexpected(p.peek()) + ", expecting BINDING or '[' or '{'"));
}

function parse_array_pattern(p: P, held: Ast, found: Binding[]): (Binding[], P) {
  let all = found;
  let q = p;
  let i = 0;
  while (q.error.len() == 0) {
    let (more, r) = parse_pattern(q, Index(held, Literal(json.JNumber(number.integer(i as i64)))), all);
    all = more;
    if (r.is_punct("]")) {
      return (all, r.advance());
    }
    if (!r.is_punct(",")) {
      return (all, r.fail(unexpected(r.peek()) + ", expecting ',' or ']'"));
    }
    q = r.advance();
    i += 1;
  }
  return (all, q);
}

// When two entries of an object pattern have the same variable, jq keeps
// the value from the first entry. `kept` binds such a variable again.
function parse_object_pattern(p: P, held: Ast, found: Binding[]): (Binding[], P) {
  let q = p;
  let all = found;
  let kept: Binding[] = [];
  let seen: string[] = [];
  while (q.error.len() == 0) {
    let (entry, r) = parse_pattern_entry(q, held, []);
    all = all.concat(entry);
    for name in pattern_names([entry]) {
      if (!seen.contains(name)) {
        seen = seen.append(name);
        let first = "*" + q.at.to_string() + name;
        all = all.append(Binding { name: first, source: Var(name) });
        kept = kept.append(Binding { name: name, source: Var(first) });
      }
    }
    if (r.is_punct("}")) {
      return (all.concat(kept), r.advance());
    }
    q = r.expect(",");
  }
  return (found, q);
}

// `$name`, `$name: PATTERN` or `KEY: PATTERN` at `p`.
function parse_pattern_entry(p: P, held: Ast, found: Binding[]): (Binding[], P) {
  if let TVar(v) = p.peek() {
    let part = "*" + p.at.to_string();
    let all = found.append(Binding { name: part, source: Index(held, Literal(json.JString(v))) });
    all = all.append(Binding { name: v, source: Var(part) });
    let q = p.advance();
    if (q.is_punct(":")) {
      return parse_pattern(q.advance(), Var(part), all);
    }
    return (all, q);
  }
  let (key, q) = parse_pattern_key(p);
  if (q.error.len() > 0) {
    return (found, q);
  }
  return parse_pattern(q.expecting(":"), Index(held, key), found);
}

function parse_pattern_key(p: P): (Ast, P) {
  match (p.peek()) {
    TIdent(x) => {
      return (Literal(json.JString(x)), p.advance());
    },
    TString(_) => {
      return parse_string("text", p);
    },
    TInterp(_, _) => {
      return parse_string("text", p);
    },
    _ => {
      if (p.is_punct("(")) {
        let (key, q) = parse_pipe(p.advance());
        let bad = key_error(key);
        if (bad.len() > 0) {
          return (Identity, p.fail(bad));
        }
        return (key, q.expect(")"));
      }
      return (Identity, p.fail(unexpected(p.peek())));
    }
  }
}

// `body` with each variable of `bs`. A later variable hides an earlier one.
function nested(bs: Binding[], body: Ast): Ast {
  let out = body;
  let i = bs.len() - 1;
  while (i >= 0) {
    out = Bind(bs[i].source, bs[i].name, out);
    i -= 1;
  }
  return out;
}

// Each variable that a program can name in `alts`, one time.
function pattern_names(alts: Binding[][]): string[] {
  let names: string[] = [];
  for bs in alts {
    for b in bs {
      if (!b.name.starts_with("*") && !names.contains(b.name)) {
        names = names.append(b.name);
      }
    }
  }
  return names;
}

// `source as PATTERNS | body`. `held` is the variable that the patterns take.
function bound(source: Ast, held: string, alts: Binding[][], body: Ast): Ast {
  if (alts.len() == 0) {
    return Identity;
  }
  if (alts.len() == 1 && alts[0].len() == 1) {
    return Bind(source, alts[0][0].name, body);
  }
  if (alts.len() == 1) {
    return Bind(source, held, nested(alts[0], body));
  }
  let origin = held + "in";
  return Bind(Identity, origin, Bind(source, held, alternatives(alts, 0, origin, body)));
}

// The alternative `at` has each variable of each alternative: one that it
// does not bind is null. An error in it gives the next alternative on the
// input, which the variable `origin` holds.
function alternatives(alts: Binding[][], at: i32, origin: string, body: Ast): Ast {
  let nulls: Binding[] = [];
  for name in pattern_names(alts) {
    nulls = nulls.append(Binding { name: name, source: Literal(json.JNull) });
  }
  let this = nested(nulls, nested(alts[at], body));
  if (at + 1 == alts.len()) {
    return this;
  }
  return Catch(this, Pipe(Var(origin), alternatives(alts, at + 1, origin, body)));
}

// The source and the variable of a `reduce` or a `foreach` with patterns.
// The source gives an array of the variables, and `unpacked` binds them again.
function packed(source: Ast, held: string, alts: Binding[][]): (Ast, string) {
  if (alts.len() == 1 && alts[0].len() == 1) {
    return (source, alts[0][0].name);
  }
  let names = pattern_names(alts);
  let all = Var(names[names.len() - 1]);
  let i = names.len() - 2;
  while (i >= 0) {
    all = Comma(Var(names[i]), all);
    i -= 1;
  }
  return (bound(source, held, alts, Collect(all)), held);
}

function unpacked(held: string, alts: Binding[][], body: Ast): Ast {
  if (alts.len() == 1 && alts[0].len() == 1) {
    return body;
  }
  let bs: Binding[] = [];
  let names = pattern_names(alts);
  for i in 0..names.len() {
    bs = bs.append(Binding { name: names[i], source: Index(Var(held), Literal(json.JNumber(number.integer(i as i64)))) });
  }
  return nested(bs, body);
}

// The minus of an object value, which takes no operator after it.
function parse_negate(p: P): (Ast, P) {
  if (p.is_punct("-")) {
    let (inner, q) = parse_negate(p.advance());
    return (Negate(inner), q);
  }
  return parse_postfix(p);
}

// Whether the term at `p` starts with a step of a path: `.a`, `."a"`, `.[`.
function starts_with_step(p: P): boolean {
  if let TField(_) = p.peek() {
    return true;
  }
  if let TDot = p.peek() {
    let q = p.advance();
    return q.is_string() || q.is_punct("[");
  }
  return false;
}

function parse_postfix(p: P): (Ast, P) {
  let (t, q) = parse_primary(p);
  // jq reads a `?` after a step as a guard of that step only.
  let after_step = starts_with_step(p);
  while (q.error.len() == 0) {
    match (q.peek()) {
      TField(f) => {
        t = Index(t, Literal(json.JString(f)));
        q = q.advance();
        after_step = true;
      },
      TDot => {
        let r = q.advance();
        if (r.is_string()) {
          let (key, w) = parse_string("text", r);
          t = Index(t, key);
          q = w;
        } else if (r.is_punct("[")) {
          let (u, w) = parse_brackets(t, r);
          t = u;
          q = w;
        } else {
          return (t, r.fail(unexpected(r.peek())));
        }
        after_step = true;
      },
      TPunct(x) => {
        if (x == "[") {
          let (u, w) = parse_brackets(t, q);
          t = u;
          q = w;
          after_step = true;
        } else if (x == "?") {
          t = if (after_step) { Optional(t) } else { Try(t) };
          q = q.advance();
          after_step = false;
        } else {
          return (t, q);
        }
      },
      _ => {
        return (t, q);
      }
    }
  }
  return (t, q);
}

// `[` at `p`, after the term `t`: an iteration, an index or a slice.
function parse_brackets(t: Ast, p: P): (Ast, P) {
  let q = p.advance();
  if (q.is_punct("]")) {
    return (Iterate(t), q.advance());
  }
  if (q.is_punct(":")) {
    let (to, r) = parse_pipe(q.advance());
    return (Slice(t, Literal(json.JNull), to), r.expect("]"));
  }
  let (key, r) = parse_pipe(q);
  if (r.error.len() == 0 && r.is_punct(":")) {
    let s = r.advance();
    if (s.is_punct("]")) {
      return (Slice(t, key, Literal(json.JNull)), s.advance());
    }
    let (to, u) = parse_pipe(s);
    return (Slice(t, key, to), u.expect("]"));
  }
  return (Index(t, key), r.expect("]"));
}

function parse_primary(p: P): (Ast, P) {
  match (p.peek()) {
    TDot => {
      let q = p.advance();
      if (q.is_string()) {
        let (key, w) = parse_string("text", q);
        return (Index(Identity, key), w);
      }
      if (q.is_punct("[")) {
        return parse_brackets(Identity, q);
      }
      return (Identity, q);
    },
    TField(f) => {
      return (Index(Identity, Literal(json.JString(f))), p.advance());
    },
    TNumber(n) => {
      return (Literal(json.JNumber(number.canonical(n))), p.advance());
    },
    TString(_) => {
      return parse_string("text", p);
    },
    TInterp(_, _) => {
      return parse_string("text", p);
    },
    TFormat(f) => {
      return parse_format(f, p.advance());
    },
    TVar(v) => {
      return (Var(v), p.advance());
    },
    TLoc(line) => {
      return (location(p.file, line), p.advance());
    },
    TIdent(x) => {
      return parse_word(x, p);
    },
    TPunct(x) => {
      return parse_group(x, p);
    },
    TEnd => {
      return (Identity, p.fail(unexpected(TEnd)));
    }
  }
}

function (p: P) is_string(): boolean {
  return match (p.peek()) {
    TString(_) => true,
    TInterp(_, _) => true,
    _ => false,
  };
}

// The string literal at `p`. `format` is the format of its interpolations.
function parse_string(format: string, p: P): (Ast, P) {
  match (p.peek()) {
    TString(s) => {
      return (Literal(json.JString(s)), p.advance());
    },
    TInterp(texts, sources) => {
      let parts: Ast[] = [];
      for source in sources {
        let inner = parse_in(source, p.defs, p.file, false, 0);
        if (inner.error.len() > 0) {
          return (Identity, p.fail(inner.error.replace(END_EXPECTED, "")));
        }
        parts = parts.append(inner.ast);
      }
      return (Interp(format, texts, parts), p.advance());
    },
    _ => {
      return (Identity, p.fail(unexpected(p.peek())));
    }
  }
}

// `@format` alone is the format of the input. Before a string, it is the
// format of each interpolation of that string.
function parse_format(format: string, p: P): (Ast, P) {
  if (p.is_string()) {
    return parse_string(format, p);
  }
  return (Format(format), p);
}

function parse_word(x: string, p: P): (Ast, P) {
  if (x == "true") {
    return (Literal(json.JBool(true)), p.advance());
  }
  if (x == "false") {
    return (Literal(json.JBool(false)), p.advance());
  }
  if (x == "null") {
    return (Literal(json.JNull), p.advance());
  }
  if (x == "if") {
    return parse_if(p.advance());
  }
  if (x == "reduce" || x == "foreach") {
    return parse_fold(x == "foreach", p.advance());
  }
  if (x == "then" || x == "elif" || x == "else" || x == "end" || x == "as" || x == "and" || x == "or" || x == "catch" || x == "try") {
    return (Identity, p.fail(unexpected(TIdent(x))));
  }
  if (x == "def") {
    return parse_def(p.advance());
  }
  if (x == "label") {
    return parse_label(p.advance());
  }
  if (x == "break") {
    let TVar(name) = p.advance().peek() else {
      return (Identity, p.advance().fail(unexpected(p.advance().peek()) + ", expecting BINDING"));
    };
    return (Break(name), p.advance().advance());
  }
  if (x == "import" || x == "include" || x == "module") {
    return (Identity, p.fail(unexpected(TIdent(x))));
  }
  return parse_call(x, p.advance());
}

// The condition of an `if` or an `elif` at `p`, and the rest to its `end`.
function parse_if(p: P): (Ast, P) {
  let (cond, q) = parse_pipe(p);
  let (yes, r) = parse_pipe(q.expect_word("then"));
  if (r.error.len() > 0) {
    return (Identity, r);
  }
  if (r.is_ident("elif")) {
    let (no, t) = parse_if(r.advance());
    return (If(cond, yes, no), t);
  }
  if (r.is_ident("else")) {
    let (no, t) = parse_pipe(r.advance());
    return (If(cond, yes, no), t.expect_word("end"));
  }
  return (If(cond, yes, Identity), r.expect_word("end"));
}

// `$name | BODY` at `p`, after `label`.
function parse_label(p: P): (Ast, P) {
  let TVar(name) = p.peek() else {
    return (Identity, p.fail(unexpected(p.peek())));
  };
  let (body, q) = parse_pipe(p.advance().expect("|"));
  return (Label(name, body), q);
}

// The variable that holds the label `name`.
pub function label_var(name: string): string {
  return "*label-" + name;
}

// `TERM as $x (INIT; UPDATE)` at `p`. A `foreach` can have `; EXTRACT`.
function parse_fold(each: boolean, p: P): (Ast, P) {
  let (source, q) = parse_postfix(p);
  if (q.error.len() > 0) {
    return (Identity, q);
  }
  let held = "*" + q.at.to_string();
  let (alts, r) = parse_binding(q, held);
  let (init, t) = parse_pipe(r.expect("("));
  let (step, u) = parse_pipe(t.expect(";"));
  if (u.error.len() > 0) {
    return (Identity, u);
  }
  let (values, name) = packed(source, held, alts);
  let update = unpacked(held, alts, step);
  if (!each) {
    return (Reduce(values, name, init, update), u.expect(")"));
  }
  if (u.is_punct(";")) {
    let (extract, w) = parse_pipe(u.advance());
    return (Foreach(values, name, init, update, unpacked(held, alts, extract)), w.expect(")"));
  }
  return (Foreach(values, name, init, update, Identity), u.expect(")"));
}

// Each function of jq 1.7, as "name/arguments", in the order of `builtins`.
pub function functions(): string[] {
  return [
    "input_line_number/0", "input_filename/0", "now/0", "localtime/0", "gmtime/0", "mktime/0", "strflocaltime/1",
    "strftime/1", "strptime/1", "stderr/0", "debug/0", "input/0", "modulemeta/0", "get_jq_origin/0",
    "get_prog_origin/0", "get_search_list/0", "halt_error/1", "halt/0", "env/0", "format/1", "error/0", "max/0",
    "min/0", "sort/0", "nan/0", "infinite/0", "isnormal/0", "isnan/0", "isinfinite/0", "type/0",
    "utf8bytelength/0", "length/0", "contains/1", "has/1", "delpaths/1", "getpath/1", "setpath/2", "implode/0",
    "explode/0", "split/1", "rtrimstr/1", "ltrimstr/1", "endswith/1", "startswith/1", "keys_unsorted/0", "keys/0",
    "tostring/0", "tonumber/0", "fromjson/0", "tojson/0", "lgamma_r/0", "modf/0", "frexp/0", "ldexp/2", "trunc/0",
    "significand/0", "scalbln/2", "scalb/2", "round/0", "rint/0", "nexttoward/2", "nextafter/2", "nearbyint/0",
    "logb/0", "log1p/0", "lgamma/0", "gamma/0", "fmod/2", "fmin/2", "fmax/2", "fma/3", "fdim/2", "fabs/0",
    "expm1/0", "exp10/0", "erfc/0", "erf/0", "drem/2", "copysign/2", "ceil/0", "yn/2", "jn/2", "y1/0", "y0/0",
    "tgamma/0", "tanh/0", "tan/0", "sqrt/0", "sinh/0", "sin/0", "remainder/2", "pow/2", "log2/0", "log10/0",
    "log/0", "j1/0", "j0/0", "hypot/2", "floor/0", "exp2/0", "exp/0", "cosh/0", "cos/0", "cbrt/0", "atanh/0",
    "atan2/2", "atan/0", "asinh/0", "asin/0", "acosh/0", "acos/0", "empty/0", "not/0", "path/1", "range/2",
    "halt_error/0", "error/1", "map/1", "select/1", "sort_by/1", "group_by/1", "unique/0", "unique_by/1",
    "max_by/1", "min_by/1", "add/0", "del/1", "abs/0", "map_values/1", "recurse/1", "recurse/2", "recurse/0",
    "to_entries/0", "from_entries/0", "with_entries/1", "reverse/0", "indices/1", "index/1", "rindex/1", "paths/0",
    "paths/1", "isfinite/0", "arrays/0", "objects/0", "iterables/0", "booleans/0", "numbers/0", "normals/0",
    "finites/0", "strings/0", "nulls/0", "values/0", "scalars/0", "join/1", "flatten/1", "flatten/0", "range/1",
    "fromdateiso8601/0", "todateiso8601/0", "fromdate/0", "todate/0", "match/2", "match/1", "test/2", "test/1",
    "capture/2", "capture/1", "scan/2", "scan/1", "splits/2", "splits/1", "split/2", "sub/3", "sub/2", "gsub/3",
    "gsub/2", "while/2", "until/2", "limit/2", "range/3", "first/1", "isempty/1", "all/2", "any/2", "all/1",
    "any/1", "all/0", "any/0", "last/1", "nth/2", "first/0", "last/0", "nth/1", "combinations/0", "combinations/1",
    "transpose/0", "in/1", "inside/1", "repeat/1", "inputs/0", "ascii_downcase/0", "ascii_upcase/0",
    "truncate_stream/1", "fromstream/1", "tostream/0", "bsearch/1", "walk/1", "pick/1", "debug/1", "INDEX/2",
    "INDEX/1", "JOIN/2", "JOIN/3", "JOIN/4", "IN/1", "IN/2", "pow10/0", "builtins/0",
  ];
}

// `name(params): body; rest` after a `def`. The body can call the function
// itself and its parameters, and the rest can call the function.
function parse_def(p: P): (Ast, P) {
  let TIdent(name) = p.peek() else {
    return (Identity, p.fail(unexpected(p.peek())));
  };
  let q = p.advance();
  let params: string[] = [];
  if (q.is_punct("(")) {
    q = q.advance();
    while (q.error.len() == 0) {
      match (q.peek()) {
        TIdent(x) => {
          params = params.append(x);
        },
        TVar(x) => {
          params = params.append("$" + x);
        },
        _ => {
          return (Identity, q.fail(unexpected(q.peek())));
        }
      }
      q = q.advance();
      if (q.is_punct(")")) {
        q = q.advance();
        break;
      }
      q = q.expect(";");
    }
  }
  q = q.expect(":");
  let outer = p.defs;
  let own = outer.append(name + "/" + params.len().to_string());
  let inner = own;
  for x in params {
    inner = inner.append(param_name(x) + "/0");
  }
  let (body, r) = parse_pipe(P { ...q, defs: inner });
  let t = P { ...r, defs: own }.expect(";");
  if (t.error.len() > 0) {
    return (Identity, t);
  }
  if let TEnd = t.peek() {
    if (t.library) {
      return (Def(name, params, body, Identity), P { ...t, defs: outer, ended: true });
    }
    return (Identity, t.fail("Top-level program not given (try \".\")"));
  }
  let (rest, u) = parse_pipe(t);
  return (Def(name, params, body, rest), P { ...u, defs: outer });
}

pub const MAIN_IN_LIBRARY: string = "jq: error: library should only have function definitions, not a main expression";

// The name of a parameter with no `$`.
pub function param_name(x: string): string {
  if (x.starts_with("$")) {
    return text(x, 1, x.len());
  }
  return x;
}

// The arguments of the function `name`, when it has some: `(e; e)`.
function parse_call(name: string, p: P): (Ast, P) {
  let args: Ast[] = [];
  let q = p;
  if (q.is_punct("(")) {
    q = q.advance();
    while (q.error.len() == 0) {
      let (arg, r) = parse_pipe(q);
      args = args.append(arg);
      q = r;
      if (q.is_punct(")")) {
        q = q.advance();
        break;
      }
      q = q.expect(";");
    }
  }
  let called = name + "/" + args.len().to_string();
  if (q.error.len() == 0 && p.check && !functions().contains(called) && !p.defs.contains(called) && called != "_match_impl/3") {
    let at = if (p.at - 1 < p.offs.len()) { p.offs[p.at - 1] } else { 0 };
    return (Call(name, args, false), P { ...q, undefined: q.undefined.append(called + " is not defined"), undefined_at: q.undefined_at.append(at) });
  }
  return (Call(name, args, false), q);
}

function parse_group(x: string, p: P): (Ast, P) {
  if (x == "(") {
    let (inner, q) = parse_pipe(p.advance());
    return (inner, q.expect(")"));
  }
  if (x == "[") {
    let q = p.advance();
    if (q.is_punct("]")) {
      return (EmptyArray, q.advance());
    }
    let (inner, r) = parse_pipe(q);
    return (Collect(inner), r.expect("]"));
  }
  if (x == "{") {
    return parse_object(p.advance());
  }
  if (x == "..") {
    return (Call("recurse", [], false), p.advance());
  }
  return (Identity, p.fail(unexpected(TPunct(x))));
}

// The entries of `{...}` after its brace.
function parse_object(p: P): (Ast, P) {
  let keys: Ast[] = [];
  let values: Ast[] = [];
  let q = p;
  if (q.is_punct("}")) {
    return (Object(keys, values), q.advance());
  }
  while (q.error.len() == 0) {
    let (key, implied, r) = parse_object_key(q);
    q = r;
    if (q.is_punct(":")) {
      let (value, s) = parse_object_value(q.advance());
      // `{$x: e}` takes the value of `$x` as the key.
      if let Var(_) = implied {
        key = implied;
      }
      keys = keys.append(key);
      values = values.append(value);
      q = s;
    } else {
      keys = keys.append(key);
      values = values.append(implied);
    }
    if (q.is_punct("}")) {
      return (Object(keys, values), q.advance());
    }
    if (q.error.len() == 0 && !q.is_punct(",")) {
      return (Object(keys, values), q.fail(unexpected(q.peek()) + ", expecting '}'"));
    }
    q = q.expect(",");
  }
  return (Object(keys, values), q);
}

// A key, and the value that `{key}` without a `:` takes.
function parse_object_key(p: P): (Ast, Ast, P) {
  match (p.peek()) {
    TIdent(x) => {
      let k = Literal(json.JString(x));
      return (k, Index(Identity, k), p.advance());
    },
    TString(_) => {
      let (k, q) = parse_string("text", p);
      return (k, Index(Identity, k), q);
    },
    TInterp(_, _) => {
      let (k, q) = parse_string("text", p);
      return (k, Index(Identity, k), q);
    },
    TFormat(f) => {
      let (k, q) = parse_format(f, p.advance());
      return (k, Index(Identity, k), q);
    },
    TVar(v) => {
      return (Literal(json.JString(v)), Var(v), p.advance());
    },
    TLoc(line) => {
      return (Literal(json.JString("__loc__")), location(p.file, line), p.advance());
    },
    TNumber(n) => {
      return (Identity, Identity, p.fail("Cannot use number (" + n + ") as object key"));
    },
    TPunct(x) => {
      if (x == "(") {
        let (k, q) = parse_pipe(p.advance());
        let bad = key_error(k);
        if (bad.len() > 0) {
          return (Identity, Identity, p.fail(bad));
        }
        return (k, Index(Identity, k), q.expect(")"));
      }
      return (Identity, Identity, p.fail(unexpected(p.peek())));
    },
    _ => {
      return (Identity, Identity, p.fail(unexpected(p.peek())));
    }
  }
}

// A value of an object entry: terms joined by `|`, with no comma.
function parse_object_value(p: P): (Ast, P) {
  let (left, q) = parse_negate(p);
  if (q.error.len() == 0 && q.is_punct("|")) {
    let (right, r) = parse_object_value(q.advance());
    return (Pipe(left, right), r);
  }
  return (left, q);
}

// The first variable of `f` that is not one of `names`, or "".
pub function undefined_var(f: Ast, names: string[]): string {
  let all = undefined_vars(f, names);
  if (all.len() == 0) {
    return "";
  }
  return all[0];
}

// Each variable of `f` that is not one of `names`, in the order of `f`.
pub function undefined_vars(f: Ast, names: string[]): string[] {
  return match (f) {
    Var(v) => if (names.contains(v)) { [] } else { [v] },
    Index(a, b) => all_undefined([a, b], names),
    Slice(a, b, c) => all_undefined([a, b, c], names),
    Iterate(a) => undefined_vars(a, names),
    Optional(a) => undefined_vars(a, names),
    Try(a) => undefined_vars(a, names),
    Pipe(a, b) => all_undefined([a, b], names),
    Comma(a, b) => all_undefined([a, b], names),
    Collect(a) => undefined_vars(a, names),
    Object(keys, values) => all_undefined(keys.concat(values), names),
    Compare(_, a, b) => all_undefined([a, b], names),
    Arith(_, a, b) => all_undefined([a, b], names),
    Alt(a, b) => all_undefined([a, b], names),
    Call(_, args, _) => all_undefined(args, names),
    Catch(a, b) => all_undefined([a, b], names),
    Interp(_, _, parts) => all_undefined(parts, names),
    Update(_, a, b) => all_undefined([a, b], names),
    Def(_, params, body, rest) => undefined_in_def(params, body, rest, names),
    If(a, b, c) => all_undefined([a, b, c], names),
    Bind(source, name, body) => all_scoped([source], [body], name, names),
    Reduce(source, name, init, update) => all_scoped([source, init], [update], name, names),
    Foreach(source, name, init, update, extract) => all_scoped([source, init], [update, extract], name, names),
    And(a, b) => all_undefined([a, b], names),
    Or(a, b) => all_undefined([a, b], names),
    Negate(a) => undefined_vars(a, names),
    Label(name, body) => undefined_vars(body, names.append(label_var(name))),
    Break(name) => if (names.contains(label_var(name))) { [] } else { [label_var(name)] },
    _ => [],
  };
}

function all_undefined(fs: Ast[], names: string[]): string[] {
  let out: string[] = [];
  for f in fs {
    out = out.concat(undefined_vars(f, names));
  }
  return out;
}

// `outer` sees `names`, and `inner` sees `name` also.
function all_scoped(outer: Ast[], inner: Ast[], name: string, names: string[]): string[] {
  return all_undefined(outer, names).concat(all_undefined(inner, names.append(name)));
}

// The variables of a `def`: the body sees each `$` parameter also.
function undefined_in_def(params: string[], body: Ast, rest: Ast, names: string[]): string[] {
  let inner = names;
  for x in params {
    if (x.starts_with("$")) {
      inner = inner.append(param_name(x));
    }
  }
  return undefined_vars(body, inner).concat(undefined_vars(rest, names));
}

// ---- Modules ----

// A directive at the start of a program or a module: `import PATH as NAME`,
// `import PATH as $NAME` for data, or `include PATH`, with optional
// metadata.
pub struct Directive { include: boolean, path: string, alias: string, is_data: boolean, meta: json.JsonValue }

// The metadata of `module`, the directives, and the token after them.
pub struct Directives { meta: json.JsonValue, deps: Directive[], next: i32, error: string, at: i32 }

pub function directives(program: string): Directives {
  let lx = lex(program);
  if (lx.error.len() > 0) {
    return Directives { meta: json.JNull, deps: [], next: 0, error: lx.error, at: lx.at };
  }
  let p = P { toks: lx.toks, offs: lx.offs, at: 0, error: "", err_at: 0, defs: [], library: false, file: "", check: true, undefined: [], undefined_at: [], ended: false };
  let meta: json.JsonValue = json.JNull;
  if (p.is_ident("module")) {
    let (m, q) = parse_metadata(p.advance());
    meta = m;
    p = q.expect(";");
  }
  let deps: Directive[] = [];
  while (p.error.len() == 0 && (p.is_ident("import") || p.is_ident("include"))) {
    let (d, q) = parse_directive(p);
    deps = deps.append(d);
    p = q;
  }
  return Directives { meta: meta, deps: deps, next: p.at, error: p.error, at: p.err_at };
}

// `PATH as NAME [META];` after `import`, or `PATH [META];` after `include`.
function parse_directive(p: P): (Directive, P) {
  let include = p.is_ident("include");
  let d = Directive { include: include, path: "", alias: "", is_data: false, meta: json.JNull };
  let q = p.advance();
  match (q.peek()) {
    TString(s) => {
      d = Directive { ...d, path: s };
      q = q.advance();
    },
    TInterp(_, _) => {
      return (d, q.fail("Import path must be constant"));
    },
    _ => {
      return (d, q.fail(unexpected(q.peek())));
    }
  }
  if (!include) {
    q = q.expect_word("as");
    match (q.peek()) {
      TIdent(name) => {
        d = Directive { ...d, alias: name };
      },
      TVar(name) => {
        d = Directive { ...d, alias: name, is_data: true };
      },
      _ => {
        return (d, q.fail(unexpected(q.peek())));
      }
    }
    q = q.advance();
  }
  if (q.error.len() == 0 && !q.is_punct(";")) {
    let (m, r) = parse_metadata(q);
    d = Directive { ...d, meta: m };
    q = r;
  }
  return (d, q.expect(";"));
}

// A metadata expression, which must be a constant object.
function parse_metadata(p: P): (json.JsonValue, P) {
  let (e, q) = parse_pipe(p);
  if (q.error.len() > 0) {
    return (json.JNull, q);
  }
  let (v, constant) = const_of(e);
  if (!constant) {
    return (json.JNull, P { ...q, at: p.at }.fail("Module metadata must be constant"));
  }
  let json.JObject(_) = v else {
    return (json.JNull, P { ...q, at: p.at }.fail("Module metadata must be an object"));
  };
  return (v, q);
}

// jq's check_object_key: the error of a key in parentheses that is a
// constant but not a string, or "".
function key_error(k: Ast): string {
  let (v, constant) = const_of(k);
  if (!constant) {
    return "";
  }
  if let json.JString(_) = v {
    return "";
  }
  return "Cannot use " + output.type_name(v) + " (" + output.shown(v) + ") as object key";
}

// The value of a constant filter, and whether it is constant.
function const_of(e: Ast): (json.JsonValue, boolean) {
  match (e) {
    Literal(v) => {
      return (v, true);
    },
    EmptyArray => {
      return (json.JArray([]), true);
    },
    Collect(inner) => {
      let items: json.JsonValue[] = [];
      for part in commas(inner) {
        let (v, constant) = const_of(part);
        if (!constant) {
          return (json.JNull, false);
        }
        items = items.append(v);
      }
      return (json.JArray(items), true);
    },
    Object(keys, values) => {
      let o = json.object();
      for i in 0..keys.len() {
        let (k, kc) = const_of(keys[i]);
        let (v, vc) = const_of(values[i]);
        let json.JString(name) = k else {
          return (json.JNull, false);
        };
        if (!kc || !vc) {
          return (json.JNull, false);
        }
        o = o.insert(name, v);
      }
      return (json.JObject(o), true);
    },
    Arith(op, a, b) => {
      return fold_arith(op, a, b);
    },
    Compare(op, a, b) => {
      return fold_compare(op, a, b);
    },
    _ => {
      return (json.JNull, false);
    }
  }
}

// jq's constant_fold of an operator of arithmetic on two constants. jq
// folds each operator, and an error gives no constant. This folds the
// operators on numbers, and `+` on null, strings and arrays.
function fold_arith(op: string, a: Ast, b: Ast): (json.JsonValue, boolean) {
  let (x, xc) = const_of(a);
  let (y, yc) = const_of(b);
  if (!xc || !yc) {
    return (json.JNull, false);
  }
  if (op == "+") {
    if let json.JNull = x {
      return (y, true);
    }
    if let json.JNull = y {
      return (x, true);
    }
    if let json.JString(s) = x {
      if let json.JString(t) = y {
        return (json.JString(s + t), true);
      }
    }
    if let json.JArray(s) = x {
      if let json.JArray(t) = y {
        return (json.JArray(s.concat(t)), true);
      }
    }
  }
  let json.JNumber(m) = x else {
    return (json.JNull, false);
  };
  let json.JNumber(n) = y else {
    return (json.JNull, false);
  };
  let u = number.value(m);
  let v = number.value(n);
  if (op == "+") {
    return (json.JNumber(number.format(u + v)), true);
  }
  if (op == "-") {
    return (json.JNumber(number.format(u - v)), true);
  }
  if (op == "*") {
    return (json.JNumber(number.format(u * v)), true);
  }
  if (op == "/" && v != 0.0) {
    return (json.JNumber(number.format(u / v)), true);
  }
  if (op == "%") {
    return fold_remainder(u, v);
  }
  return (json.JNull, false);
}

// The remainder of jq on two integers of intmax_t, as eval gives it.
function fold_remainder(u: f64, v: f64): (json.JsonValue, boolean) {
  if (u != u || v != v) {
    return (json.JNumber(number.format(0.0 / 0.0)), true);
  }
  let d = number.int_magnitude(v);
  if (d == 0u64) {
    return (json.JNull, false);
  }
  let m = (number.int_magnitude(u) % d) as f64;
  return (json.JNumber(number.format(if (u < 0.0) { -m } else { m })), true);
}

// jq's constant_fold of a comparison of two constants that are null,
// booleans, numbers or strings.
function fold_compare(op: string, a: Ast, b: Ast): (json.JsonValue, boolean) {
  let (x, xc) = const_of(a);
  let (y, yc) = const_of(b);
  if (!xc || !yc) {
    return (json.JNull, false);
  }
  let kx = scalar_rank(x);
  let ky = scalar_rank(y);
  if (kx < 0 || ky < 0) {
    return (json.JNull, false);
  }
  let c = kx - ky;
  if (c == 0) {
    if let json.JNumber(m) = x {
      if let json.JNumber(n) = y {
        c = number.compare(m, n);
      }
    }
    if let json.JString(s) = x {
      if let json.JString(t) = y {
        c = if (s < t) { -1 } else if (s > t) { 1 } else { 0 };
      }
    }
  }
  let r = match (op) {
    "==" => c == 0,
    "!=" => c != 0,
    "<" => c < 0,
    "<=" => c <= 0,
    ">" => c > 0,
    _ => c >= 0,
  };
  return (json.JBool(r), true);
}

// The place of a value in the order of jq for the kinds before arrays, or
// -1 for an array or an object.
function scalar_rank(v: json.JsonValue): i32 {
  return match (v) {
    json.JNull => 0,
    json.JBool(b) => if (b) { 2 } else { 1 },
    json.JNumber(_) => 3,
    json.JString(_) => 4,
    _ => -1,
  };
}

// The parts of `a, b, c`.
function commas(e: Ast): Ast[] {
  if let Comma(a, b) = e {
    return commas(a).concat(commas(b));
  }
  return [e];
}
