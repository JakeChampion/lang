// Regex capture groups — a tour of std/regex's extraction API.
//
// The Thompson-NFA matcher (`regex_match` / `regex_search`) answers "does it
// match, and where". The capture engine answers "what did each group match".
// `regex_captures` runs a linear-time Pike VM (no backtracking blow-up) and
// returns an `RCaps` carrying every group's span; groups are numbered by their
// `(` from 1, and a `(?<name>…)` group is ALSO reachable by name. None of this
// is built into the language — it is ordinary Fern over the raw-byte matcher,
// and it lowers on every backend (interp / x86-64 / arm64 / wasm).
import "std/i32";
import "std/result";
import "std/regex" as regex;
import "std/result";
import "std/string";
import "std/option";

function main(): i32 {
  let line: string = "GET /api/users 200 15ms";
  let pat: string = "(?<method>\\w+) (?<path>\\S+) (?<status>\\d+) (?<ms>\\d+)ms";
  let Some(m) = { let __checked_regex_2: regex.Regex = match (regex.compile(pat)) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_2.captures(line) } else {
    return 1;
  };

  // Named extraction — `.group_named` resolves the label to its span. The
  // same groups are still positional: `.group_index("status")` is Some(3).
  let status: i32 = require_regex_text(match (m.group_named("status")) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }).parse_int_or(0);  // 200
  let ms: i32 = require_regex_text(match (m.group_named("ms")) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }).parse_int_or(0);  // 15

  // `${name}` template substitution: swap each `k=v` pair to `v=k`.
  let swapped: string = require_regex_text(match ({ let __checked_regex_1: regex.Regex = match (regex.compile("(?<k>\\w+)=(?<v>\\d+)")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_1.replace_all_groups("a=1 b=2", "${v}=${k}") }) { Ok(__text) => Some(__text), Err(__error) => { eprint(__error.to_string()); return 98; } });

  // A whole-token scan: four fields in the log line.
  let fields: i32 = { let __checked_regex_0: regex.Regex = match (regex.compile("\\S+")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_0.count(line) };  // 4

  let result: i32 = status + ms + fields;
  if (require_regex_text(match (m.group_named("method")) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "GET" && m.group_index("path").unwrap_or(0) == 2 && swapped == "1=a 2=b") {
    return result;
  }
  return 0;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
