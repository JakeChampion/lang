// Regex capture groups — a tour of std/regex's extraction API.
//
// The Thompson-NFA matcher (`regex_match` / `regex_search`) answers "does it
// match, and where". The capture engine answers "what did each group match".
// `regex_captures` runs a linear-time Pike VM (no backtracking blow-up) and
// returns an `RCaps` carrying every group's span; groups are numbered by their
// `(` from 1, and a `(?<name>…)` group is ALSO reachable by name. None of this
// is built into the language — it is ordinary Fern over the raw-byte matcher,
// and it lowers on every backend (interp / x86-64 / arm64 / wasm).
import "std/i32";
import "std/regex" as regex;
import "std/result";
import "std/string";
import "std/option";

function main(): i32 {
  let line = "GET /api/users 200 15ms";
  let pat = "(?<method>\\w+) (?<path>\\S+) (?<status>\\d+) (?<ms>\\d+)ms";
  let Some(m) = compiled(pat).captures(line) else {
    return 1;
  };

  // Named extraction — `.group_named` resolves the label to its span. The
  // same groups are still positional: `.group_index("status")` is Some(3).
  let status = i32.parse_i32(group_text(m, "status")).unwrap_or(0);  // 200
  let ms = i32.parse_i32(group_text(m, "ms")).unwrap_or(0);  // 15

  // `${name}` template substitution: swap each `k=v` pair to `v=k`.
  let swapped = match (compiled("(?<k>\\w+)=(?<v>\\d+)").replace_all_groups("a=1 b=2", "${v}=${k}")) { Ok(text) => text, Err(e) => { eprint(e.to_string()); return 98; } };

  // A whole-token scan: four fields in the log line.
  let fields = compiled("\\S+").count(line);  // 4

  let result = status + ms + fields;
  if (group_text(m, "method") == "GET" && m.group_index("path").unwrap_or(0) == 2 && swapped == "1=a 2=b") {
    return result;
  }
  return 0;
}

function compiled(pat: string): regex.Regex {
  match (regex.compile(pat)) {
    Ok(re) => {
      return re;
    },
    Err(e) => {
      eprint(e.to_string());
      exit(98);
    }
  }
}

function group_text(m: regex.Captures, name: string): string {
  match (m.group_named(name)) {
    Ok(Some(value)) => {
      return value;
    },
    Ok(None()) => {
      exit(1);
    },
    Err(e) => {
      eprint(e.to_string());
      exit(98);
    }
  }
}
