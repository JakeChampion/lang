import "std/regex" as regex;
import "std/string";
import "std/option";

function main(): i32 {
  let line: string = "GET /api/users 200 15ms";
  let pat: string = "(?<method>\\w+) (?<path>\\S+) (?<status>\\d+) (?<ms>\\d+)ms";
  let Some(m) = regex.regex_captures(pat, line) else {
    return 1;
  };

  let status: i32 = require_regex_text(m.group_named("status")).parse_int_or(0);
  let ms: i32 = require_regex_text(m.group_named("ms")).parse_int_or(0);

  let swapped: string = require_regex_text(regex.regex_replace_all_groups("(?<k>\\w+)=(?<v>\\d+)", "a=1 b=2", "${v}=${k}"));

  let fields: i32 = regex.regex_count("\\S+", line);

  let result: i32 = status + ms + fields;
  if (require_regex_text(m.group_named("method")) == "GET" && m.group_index("path").unwrap_or(0) == 2 && swapped == "1=a 2=b") {
    return result;
  }
  return 0;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
