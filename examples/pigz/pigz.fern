// pigz — compress and decompress gzip, zlib and zip files.
//
// A port of pigz 2.8 (zlib.net/pigz). It compresses blocks of the input on
// all CPUs, in std/worker workers, and writes the same bytes as pigz.
//
//   $ pigz file              # writes file.gz and removes file
//   $ pigz -d file.gz        # writes file and removes file.gz
//   $ pigz -9 -k file        # the smallest output, and file stays
//   $ pigz -c file > out.gz  # writes to the standard output
//   $ pigz -t file.gz        # tests file.gz
//   $ pigz -l file.gz        # lists file.gz
//
// With no file, pigz reads the standard input and writes the standard output.
import "std/io";
import "std/result";
import "std/array";
import "std/errno";
import "std/hash/crc32";
import "std/deflate" as deflate;
import "std/worker";
import "./gz";
import "./layout";
import "./zopfli";

const S_IFMT: u32 = 61440u32;

const S_IFREG: u32 = 32768u32;

const S_IFIFO: u32 = 4096u32;

const S_IFLNK: u32 = 40960u32;

const S_IFDIR: u32 = 16384u32;

// The state of a run of pigz: the options, the name of the program for the
// messages, the exit code, the listing so far, and the time when it
// started.
struct Run {
  o: gz.Options,
  prog: string,
  ret: i32,
  listing: gz.Listing,
  now: i64,
}

function say(r: Run, text: string): void {
  if (r.o.verbosity > 0) {
    eprint(r.prog + ": " + text);
  }
}

// complain(): a message, and exit code 1.
function complain(r: Run, text: string): Run {
  say(r, text);
  return Run { ...r, ret: 1 };
}

// The text of strerror() for an I/O error.
function error_text(e: IoError): string {
  match (e) {
    NotFound(_) => {
      return "No such file or directory";
    },
    PermissionDenied(_) => {
      return "Permission denied";
    },
    AlreadyExists(_) => {
      return "File exists";
    },
    Interrupted => {
      return "Interrupted system call";
    },
    Unsupported => {
      return "Operation not supported";
    },
    Other(_, msg, _) => {
      return msg;
    },
    _ => {
      return e.message();
    }
  }
  return e.message();
}

function fatal(what: string, name: string, e: IoError): gz.Fail {
  return gz.Fail { why: what + " error on " + name + " (" + error_text(e) + ")", code: errno.of(e) };
}

// The processes of a compression: -p, or one for each CPU.
function procs(o: gz.Options): i32 {
  if (o.procs > 0) {
    return o.procs;
  }
  let n = cpu_count();
  if (n < 1) {
    return 8;
  }
  return n;
}

// The input bytes of the first jobs of parallel_compress: whole blocks,
// about 1 MiB, so that a small input still runs on each process.
function job_size(block: i32): i32 {
  if (block >= 1048576) {
    return block;
  }
  return 1048576 / block * block;
}

// The largest job that `grown` makes.
const MAX_JOB: i32 = 8388608;

// The size of the job after a job of `size` bytes. Each job is a process,
// whose start costs about 3 ms of kernel time, so the jobs after the first
// ones double up to MAX_JOB. The output does not depend on the size.
function grown(size: i32): i32 {
  if (size > MAX_JOB / 2) {
    return size;
  }
  return size * 2;
}

// readn(): up to `n` bytes, fewer only at the end of the input.
function readn(rd: Reader, n: i32, path: string): Result[u8[], gz.Fail] {
  let out: u8[] = [];
  while (out.len() < n) {
    match (rd.read_chunk_bytes(n - out.len())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return Ok(out);
        }
        out = if (out.len() == 0) { chunk } else { out.concat(chunk) };
      },
      Err(e) => {
        return Err(fatal("read", path, e));
      }
    }
  }
  return Ok(out);
}

function settings(o: gz.Options): layout.Settings {
  let zopts = zopfli.Options { iterations: o.iterations, blocksplitting: o.blocksplitting, maxblocks: o.maxsplits };
  return layout.Settings { level: o.level, strategy: o.strategy, block: o.block, rsync: o.rsync, setdict: o.setdict, zopts: zopts };
}

// The check of the input so far: CRC-32, or Adler-32 for zlib.
struct Check {
  crc: u32,
  adler: u32,
  zlib: boolean,
  ulen: i64,
}

function new_check(zlib: boolean): Check {
  return Check { crc: 0u32, adler: 1u32, zlib: zlib, ulen: 0i64 };
}

// The check of one chunk of the input alone.
function chunk_check(zlib: boolean, chunk: u8[]): u32 {
  if (zlib) {
    return deflate.adler32(chunk);
  }
  return crc32.new().update(chunk).finish();
}

// The check of the input so far, then `len` bytes whose own check is `value`.
function check_add(c: Check, value: u32, len: i32): Check {
  if (c.zlib) {
    return Check { ...c, adler: gz.crc_combine(c.adler, value, len as i64, true), ulen: c.ulen + len as i64 };
  }
  return Check { ...c, crc: gz.crc_combine(c.crc, value, len as i64, false), ulen: c.ulen + len as i64 };
}

function check_of(c: Check, chunk: u8[]): Check {
  return check_add(c, chunk_check(c.zlib, chunk), chunk.len());
}

function header(r: Run, name: Option[string], mtime: i64): (Run, u8[]) {
  let o = r.o;
  if (o.form == 1) {
    if (o.comment.is_some()) {
      return (complain(r, "can't store comment in zlib format -- ignoring"), gz.zlib_header(o.level));
    }
    return (r, gz.zlib_header(o.level));
  }
  if (o.form == 2) {
    return (r, gz.zip_header(zip_name(o, name), mtime, gz.time2dos(mtime, r.now)));
  }
  return (r, gz.gzip_header(name, mtime, o.level, o.comment));
}

function trailer(r: Run, name: Option[string], mtime: i64, c: Check, clen: i64, head: i64): u8[] {
  let o = r.o;
  if (o.form == 1) {
    return gz.zlib_trailer(c.adler);
  }
  let crc = c.crc;
  if (o.form == 2) {
    return gz.zip_trailer(zip_name(o, name), mtime, gz.time2dos(mtime, r.now), o.comment, crc, c.ulen, clen, head);
  }
  return gz.gzip_trailer(crc, c.ulen);
}

function put(w: Writer, bytes: u8[], outf: string): Result[void, gz.Fail] {
  match (w.write_bytes(bytes)) {
    Ok(_) => {
      return Ok(());
    },
    Err(e) => {
      return Err(fatal("write", outf, e));
    }
  }
  return Ok(());
}

// What a compression has written: the check of the input and the length of
// the deflate data.
struct Written {
  check: Check,
  clen: i64,
}

// The compressed length that single_compress counts for a block. pigz 2.8
// does not count the output of zopfli there, so the zip entry of -11 -p 1
// has a compressed length of zero.
function single_clen(s: layout.Settings, bytes: u8[]): i64 {
  return if (s.level > 9) { 0i64 } else { bytes.len() as i64 };
}

// single_compress: one deflate stream, a block at a time.
function single_to(s: layout.Settings, rd: Reader, w: Writer, path: string, outf: string, c0: Check): Result[Written, gz.Fail] {
  let c = c0;
  let clen = 0i64;
  let st = layout.single_start(s);
  let cur = readn(rd, s.block, path)?;
  loop {
    let next = readn(rd, s.block, path)?;
    let more = next.len() > 0;
    let (after, bytes) = layout.single_block(s, st, cur, 0, cur.len(), more);
    st = after;
    c = check_of(c, cur);
    put(w, bytes, outf)?;
    clen += single_clen(s, bytes);
    if (!more) {
      break;
    }
    cur = next;
  }
  return Ok(Written { check: c, clen: clen });
}

// The input of parallel_compress that no job has yet: the next job, read
// ahead to know if more input follows it, and the 32 KiB before it.
struct Feed {
  next: u8[],
  dict: u8[],
  ended: boolean,
  failed: Option[gz.Fail],
}

// The input of one job, with the 32 KiB before it.
struct Taken {
  feed: Feed,
  dict: u8[],
  cur: u8[],
  more: boolean,
}

// What a job gives back: its deflate data, and the length and the check of
// its input, which the parent combines in order, as the write thread of pigz
// does.
struct JobOut {
  bytes: u8[],
  len: i32,
  check: u32,
}

// The next job of the feed. A read that fails ends the feed, and the job
// before it does not start, as a read error stops a compression.
function take(own f: Feed, rd: Reader, size: i32, setdict: boolean, path: string): Taken {
  let cur = f.next;
  let next: u8[] = [];
  let failed = f.failed;
  match (readn(rd, size, path)) {
    Ok(bytes) => {
      next = bytes;
    },
    Err(e) => {
      failed = Some(e);
    }
  }
  let more = next.len() > 0;
  let dict: u8[] = [];
  if (more && setdict) {
    if (cur.len() >= layout.DICT) {
      dict = array.slice(cur, cur.len() - layout.DICT, cur.len());
    } else {
      let keep = layout.DICT - cur.len();
      let start = if (f.dict.len() > keep) { f.dict.len() - keep } else { 0 };
      dict = array.slice(f.dict, start, f.dict.len()).concat(cur);
    }
  }
  let feed = Feed { next: next, dict: dict, ended: !more || failed.is_some(), failed: failed };
  return Taken { feed: feed, dict: f.dict, cur: cur, more: more };
}

// A worker compresses the job and takes the check of its input, so the
// parent only reads, starts, joins and writes.
function start_job(s: layout.Settings, zlib: boolean, t: Taken): worker.Worker[JobOut] {
  let dict = t.dict;
  let cur = t.cur;
  let more = t.more;
  return worker.spawn((): JobOut => {
    let input = if (dict.len() == 0) { cur } else { dict.concat(cur) };
    return JobOut { bytes: layout.blocks(s, input, dict.len(), more), len: cur.len(), check: chunk_check(zlib, cur) };
  });
}

function index_of(xs: i32[], x: i32): i32 {
  for k in 0..xs.len() {
    if (xs[k] == x) {
      return k;
    }
  }
  return -1;
}

function without[T](xs: T[], at: i32): T[] {
  return array.slice(xs, 0, at).concat(array.slice(xs, at + 1, xs.len()));
}

// parallel_compress: a job for each `job_size` bytes of the input, each with
// the 32 KiB before it as its dictionary. Up to `procs` jobs run in workers
// at a time. The parent reads the input and starts a job when any job ends.
// It writes the output of the jobs in order, as pigz does, and keeps at most
// 2 * procs jobs between the next one to write and the last one started.
// fern-lint: allow cyclomatic-complexity
function parallel_to(s: layout.Settings, procs: i32, rd: Reader, w: Writer, path: string, outf: string, c0: Check): Result[Written, gz.Fail] {
  let size = job_size(s.block);
  let first = readn(rd, size, path)?;
  let none: Option[gz.Fail] = None;
  let feed = Feed { next: first, dict: [], ended: false, failed: none };
  let check = c0;
  let clen = 0i64;
  let failed: Option[gz.Fail] = None;
  let running: worker.Worker[JobOut][] = [];
  // The number of each running job, and the outputs that wait for their turn.
  let numbers: i32[] = [];
  let done_numbers: i32[] = [];
  let done: JobOut[] = [];
  let started = 0;
  let written = 0;
  loop {
    while (!feed.ended && failed.is_none() && running.len() < procs && started - written < 2 * procs) {
      if (started >= procs) {
        size = grown(size);
      }
      let t = take(feed, rd, size, s.setdict, path);
      feed = t.feed;
      if (feed.failed.is_none()) {
        running = running.append(start_job(s, c0.zlib, t));
        numbers = numbers.append(started);
        started += 1;
      }
    }
    if (running.len() == 0) {
      break;
    }
    let got = worker.wait_any(running);
    running = got.rest;
    done_numbers = done_numbers.append(numbers[got.index]);
    done = done.append(got.value);
    numbers = without(numbers, got.index);
    let at = index_of(done_numbers, written);
    while (at >= 0) {
      let out = done[at];
      check = check_add(check, out.check, out.len);
      if (failed.is_none()) {
        if let Err(e) = put(w, out.bytes, outf) {
          failed = Some(e);
        }
        clen += out.bytes.len() as i64;
      }
      done_numbers = without(done_numbers, at);
      done = without(done, at);
      written += 1;
      at = index_of(done_numbers, written);
    }
  }
  if let Some(e) = failed {
    return Err(e);
  }
  if let Some(e) = feed.failed {
    return Err(e);
  }
  return Ok(Written { check: check, clen: clen });
}

// The input of -R: the check of the input so far and the first read error.
// The compression reads through layout, so these are cells.
struct RsyncIn {
  err: Cell[Option[gz.Fail]],
  check: Cell[Check],
}

function rsync_read(rd: Reader, n: i32, path: string, inp: RsyncIn): u8[] {
  if (inp.err.get().is_some()) {
    return [];
  }
  match (rd.read_chunk_bytes(n)) {
    Ok(chunk) => {
      inp.check.set(check_of(inp.check.get(), chunk));
      return chunk;
    },
    Err(e) => {
      inp.err.set(Some(fatal("read", path, e)));
    }
  }
  return [];
}

// What -R has written: the compressed length and the first write error.
struct RsyncOut {
  clen: i64,
  failed: Option[gz.Fail],
}

// Writes a block of single_compress with -R. A read error or a write error
// stops the compression.
function rsync_put(w: Writer, bytes: u8[], outf: string, s: layout.Settings, inp: RsyncIn, out: Cell[RsyncOut]): boolean {
  if (inp.err.get().is_some()) {
    return false;
  }
  let o = out.get();
  if let Err(e) = put(w, bytes, outf) {
    out.set(RsyncOut { ...o, failed: Some(e) });
    return false;
  }
  out.set(RsyncOut { ...o, clen: o.clen + single_clen(s, bytes) });
  return true;
}

function rsync_input(c0: Check): RsyncIn {
  let none: Option[gz.Fail] = None;
  return RsyncIn { err: cell_new(none), check: cell_new(c0) };
}

// single_compress with -R, which reads the input in blocks.
function rsync_single_to(s: layout.Settings, rd: Reader, w: Writer, path: string, outf: string, c0: Check): Result[Written, gz.Fail] {
  let inp = rsync_input(c0);
  let none: Option[gz.Fail] = None;
  let out = cell_new(RsyncOut { clen: 0i64, failed: none });
  layout.single_rsync_to(s, layout.lazy_reader((n: i32): u8[] => rsync_read(rd, n, path, inp)), (b: u8[]): boolean => rsync_put(w, b, outf, s, inp, out));
  if let Some(e) = inp.err.get() {
    return Err(e);
  }
  if let Some(e) = out.get().failed {
    return Err(e);
  }
  return Ok(Written { check: inp.check.get(), clen: out.get().clen });
}

// A run of the jobs of -R for one worker: the input from the 32 KiB before
// the first job, and the jobs at their positions in it.
struct RsyncGroup {
  data: u8[],
  jobs: layout.Job[],
  last: boolean,
}

// The jobs of -R up to `size` bytes, or to the last job.
function rsync_group(s: layout.Settings, own g0: layout.RsyncJobs, own l0: layout.Lazy, size: i32): (layout.RsyncJobs, layout.Lazy, RsyncGroup) {
  let g = g0;
  let l = l0;
  let first = g.ns;
  let start = if (first > layout.DICT as i64) { first - layout.DICT as i64 } else { 0i64 };
  let jobs: layout.Job[] = [];
  let total = 0;
  let end = first;
  let last = false;
  loop {
    let (g1, l1, j) = layout.rsync_next(s, g, l);
    g = g1;
    l = l1;
    jobs = jobs.append(layout.Job { from: (j.from - start) as i32, len: j.len, lens: j.lens });
    total += j.len;
    end = j.from + j.len as i64;
    last = j.last;
    if (last || total >= size) {
      break;
    }
  }
  let data = layout.lazy_bytes(l, start, end);
  let keep = if (g.ns > layout.DICT as i64) { g.ns - layout.DICT as i64 } else { 0i64 };
  return (g, layout.lazy_forget(l, keep), RsyncGroup { data: data, jobs: jobs, last: last });
}

function start_group(s: layout.Settings, grp: RsyncGroup): worker.Worker[u8[]] {
  let data = grp.data;
  let jobs = grp.jobs;
  let more = !grp.last;
  return worker.spawn((): u8[] => layout.run_group(s, data, jobs, more));
}

// parallel_compress with -R: the jobs end after the last hash hit in the
// next block. Up to `procs` runs of jobs are in workers at a time, and the
// parent writes their output in order.
// It keeps the branches of parallel_compress() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function rsync_parallel_to(s: layout.Settings, procs: i32, rd: Reader, w: Writer, path: string, outf: string, c0: Check): Result[Written, gz.Fail] {
  let inp = rsync_input(c0);
  let (g0, l0) = layout.rsync_start(s, layout.lazy_reader((n: i32): u8[] => rsync_read(rd, n, path, inp)));
  let g = g0;
  let l = l0;
  let size = job_size(s.block);
  let ended = false;
  let clen = 0i64;
  let failed: Option[gz.Fail] = None;
  let running: worker.Worker[u8[]][] = [];
  let numbers: i32[] = [];
  let done_numbers: i32[] = [];
  let done: u8[][] = [];
  let started = 0;
  let written = 0;
  loop {
    while (!ended && failed.is_none() && inp.err.get().is_none() && running.len() < procs && started - written < 2 * procs) {
      if (started >= procs) {
        size = grown(size);
      }
      let (g1, l1, grp) = rsync_group(s, g, l, size);
      g = g1;
      l = l1;
      ended = grp.last;
      running = running.append(start_group(s, grp));
      numbers = numbers.append(started);
      started += 1;
    }
    if (running.len() == 0) {
      break;
    }
    let got = worker.wait_any(running);
    running = got.rest;
    done_numbers = done_numbers.append(numbers[got.index]);
    done = done.append(got.value);
    numbers = without(numbers, got.index);
    let at = index_of(done_numbers, written);
    while (at >= 0) {
      let bytes = done[at];
      if (failed.is_none() && inp.err.get().is_none()) {
        if let Err(e) = put(w, bytes, outf) {
          failed = Some(e);
        }
        clen += bytes.len() as i64;
      }
      done_numbers = without(done_numbers, at);
      done = without(done, at);
      written += 1;
      at = index_of(done_numbers, written);
    }
  }
  if let Some(e) = inp.err.get() {
    return Err(e);
  }
  if let Some(e) = failed {
    return Err(e);
  }
  return Ok(Written { check: inp.check.get(), clen: clen });
}

// The name in the header: the name of a file without its directory, for -N
// and by default.
function header_name(o: gz.Options, src: Source): Option[string] {
  if ((o.headis & 1) != 0 && src.st.is_some()) {
    return Some(gz.justname(src.path));
  }
  return None;
}

// The compression of the input that `rd` streams: the header, the deflate
// data in the block layout of pigz, and the trailer, each written to `w`
// as it is ready.
// It keeps the branches of single_compress() and parallel_compress() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function compress_to(r0: Run, src: Source, rd: Reader, w: Writer, outf: string): Result[Run, gz.Fail] {
  let o = r0.o;
  let name = header_name(o, src);
  let (r, head) = header(r0, name, src.mtime);
  put(w, head, outf)?;
  let s = settings(o);
  let n = procs(o);
  let c = new_check(o.form == 1);
  let done = if (s.rsync && n > 1) {
    rsync_parallel_to(s, n, rd, w, src.path, outf, c)?
  } else if (s.rsync) {
    rsync_single_to(s, rd, w, src.path, outf, c)?
  } else if (n > 1) {
    parallel_to(s, n, rd, w, src.path, outf, c)?
  } else {
    single_to(s, rd, w, src.path, outf, c)?
  };
  put(w, trailer(r, name, src.mtime, done.check, done.clen, head.len() as i64), outf)?;
  return Ok(r);
}

// A streamed compression to the standard output or to `outf`. A file that
// a fatal error leaves is removed.
function streamed(r: Run, src: Source, own rd: Reader, to_stdout: boolean, outf: string): Result[Run, gz.Fail] {
  if (to_stdout) {
    let done = compress_to(r, src, rd, stdout(), outf);
    if (src.st.is_some()) {
      let _ = rd.close();
    }
    return done;
  }
  match (open_writer(outf)) {
    Ok(w) => {
      let done = compress_to(r, src, rd, w, outf);
      let _ = rd.close();
      if (done.is_ok() && r.o.sync) {
        if let Err(e) = w.fsync() {
          w.close();
          let _ = remove_file(outf);
          return Err(gz.Fail { why: "sync error on " + outf + " (" + error_text(e) + ")", code: errno.of(e) });
        }
      }
      w.close();
      if (done.is_err()) {
        let _ = remove_file(outf);
      }
      return done;
    },
    Err(e) => {
      let _ = rd.close();
      return Err(fatal("write", outf, e));
    }
  }
  return Ok(r);
}

function zip_name(o: gz.Options, name: Option[string]): string {
  match (name) {
    Some(n) => {
      return n;
    },
    None => {
      return o.alias;
    }
  }
  return o.alias;
}

// The input and its name in the messages.
struct Source {
  path: string,
  // The input, or None in a copy of the source for its name and status.
  reader: Option[Reader],
  // The status from lstat(), or None for the standard input.
  st: Option[FileStat],
  // The time to keep in the header, from the status before the read.
  mtime: i64,
}

function write_stdout(bytes: u8[]): Result[void, gz.Fail] {
  match (stdout().write_bytes(bytes)) {
    Ok(_) => {
      return Ok(());
    },
    Err(e) => {
      return Err(fatal("write", "<stdout>", e));
    }
  }
  return Ok(());
}

function print_listing(r: Run): Result[Run, gz.Fail] {
  if (r.listing.text.len() > 0) {
    write_stdout(r.listing.text)?;
  }
  return Ok(Run { ...r, listing: gz.Listing { ...r.listing, text: [] } });
}

// list_info(): one line for the input from its header and trailer. It reads
// the input to its end, to know its length and its last bytes.
// It keeps the branches of list_info() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function list_info(r: Run, src: Source, own f: gz.Feed, h: gz.Header): Result[Run, gz.Fail] {
  if (h.method < 0) {
    return Ok(complain(r, "skipping: " + list_refusal(h.method, src.path)));
  }
  let o = r.o;
  if (h.form > 1) {
    let all = if (o.verbosity >= 2) { gz.fill_all(f)? } else { f };
    let (_, comment) = gz.zip_comment(all.buf, h.next, 0u32, o.verbosity >= 2);
    r = Run { ...r, listing: gz.show_info(r.listing, o, src.path, h.name, h.stamp, r.now, h.form, h.method, h.zip_crc as u32, h.zip_clen, h.zip_ulen, false, comment) };
    return print_listing(r);
  }
  let (size, tail) = gz.tail_of(f, 8)?;
  if (h.form == 1) {
    let check = if (tail.len() >= 4) { gz.be32(tail, tail.len() - 4) } else { 0u32 };
    r = Run { ...r, listing: gz.show_info(r.listing, o, src.path, h.name, h.stamp, r.now, 1, h.method, check, size - 6i64, 0i64, false, None) };
    return print_listing(r);
  }
  if (h.method == 257) {
    r = Run { ...r, listing: gz.show_info(r.listing, o, src.path, h.name, h.stamp, r.now, h.form, 257, 0u32, size - 3i64, 0i64, false, None) };
    return print_listing(r);
  }
  let rest = size - h.next as i64;
  if (rest < 8i64 || rest - 8i64 < 2i64) {
    return Ok(complain(r, "skipping: " + src.path + " not a valid gzip file"));
  }
  let check = gz.le32_of(tail, 0);
  let len = gz.le32_of(tail, 4) as i64;
  r = Run { ...r, listing: gz.show_info(r.listing, o, src.path, h.name, h.stamp, r.now, h.form, h.method, check, rest - 8i64, len, false, h.comment) };
  return print_listing(r);
}

function list_refusal(method: i32, path: string): string {
  if (method == -6) {
    return path + " corrupt: header crc error";
  }
  if (method == -1) {
    return path + " empty";
  }
  return path + " unrecognized format";
}

// The listing lines of a test with -l: one for each member, and a total
// for more than one.
function list_members(r: Run, src: Source, h: gz.Header, d: gz.Decoded, method: i32): Run {
  if (!r.o.list) {
    return r;
  }
  let l = r.listing;
  let clen = 0i64;
  let ulen = 0i64;
  let total = 0u32;
  for i in 0..d.members.len() {
    let m = d.members[i];
    let comment = if (m.form > 1) { d.comment } else { h.comment };
    l = gz.show_info(l, r.o, src.path, h.name, h.stamp, r.now, m.form, method, m.check, m.clen, m.ulen, i > 0, comment);
    clen += m.clen;
    ulen += m.ulen;
    total = gz.crc_combine(total, m.check, m.ulen, m.form == 1);
  }
  if (d.members.len() > 1 && d.error.len() == 0 && r.o.verbosity > 0) {
    l = gz.show_total(l, r.o, total, clen, ulen);
  }
  return Run { ...r, listing: l };
}

// The input of `path` and its status, or None after the message that skips
// it. Directories with -r return their entries.
enum Opened {
  Skip(Run),
  Dir(Run, string),
  File(Run, Source),
}

// The standard input, with the time of the file it is, if any.
function open_stdin(r: Run): Result[Opened, gz.Fail] {
  let mtime = 0i64;
  if ((r.o.headis & 2) != 0) {
    if let Ok(st) = stdin().stat() {
      if (st.is_file) {
        mtime = st.mtime;
      }
    }
  }
  let none: Option[FileStat] = None;
  return Ok(File(r, Source { path: "<stdin>", reader: Some(stdin()), st: none, mtime: mtime }));
}

// The name of the input and its lstat(). A decompression of a name that
// does not exist tries the name with each compressed suffix.
function looked_up(o: gz.Options, path: string): (string, Result[FileStat, IoError]) {
  let looked = lstat(path);
  if (!(looked.is_err() && (o.list || o.decode != 0) && is_missing(looked))) {
    return (path, looked);
  }
  for sufx in gz.suffixes() {
    let next = lstat(path + sufx);
    if (next.is_ok()) {
      return (path + sufx, next);
    }
    if (!is_missing(next)) {
      return (path, next);
    }
  }
  return (path, looked);
}

// The message that skips a file of the wrong kind, or "".
function wrong_kind(o: gz.Options, inf: string, kind: u32): string {
  if (kind != S_IFREG && kind != S_IFIFO && kind != S_IFLNK && kind != S_IFDIR) {
    return "skipping: " + inf + " is a special file or device";
  }
  if (kind == S_IFLNK && !o.force && !o.pipeout) {
    return "skipping: " + inf + " is a symbolic link";
  }
  if (kind == S_IFDIR && !o.recurse) {
    return "skipping: " + inf + " is a directory";
  }
  return "";
}

// It keeps the branches of process() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function open_source(r: Run, path: string): Result[Opened, gz.Fail] {
  if (path == "") {
    return open_stdin(r);
  }
  let o = r.o;
  let (inf, looked) = looked_up(o, path);
  let Ok(st) = looked else {
    return Ok(Skip(complain(r, "skipping: " + path + " does not exist")));
  };
  let kind = st.mode & S_IFMT;
  let refusal = wrong_kind(o, inf, kind);
  if (refusal.len() > 0) {
    return Ok(Skip(complain(r, refusal)));
  }
  if (kind == S_IFDIR) {
    return Ok(Dir(r, inf));
  }
  if (!(o.force || o.list || o.decode != 0) && inf.ends_with(o.sufx)) {
    say(r, "skipping: " + inf + " ends with " + o.sufx);
    return Ok(Skip(r));
  }
  if (o.decode == 1 && !o.pipeout && !o.list && gz.compressed_suffix(inf) == 0) {
    return Ok(Skip(complain(r, "skipping: " + inf + " does not have compressed suffix")));
  }
  let mtime = if ((o.headis & 2) != 0) { st.mtime } else { 0i64 };
  match (open_reader(inf)) {
    Ok(rd) => {
      return Ok(File(r, Source { path: inf, reader: Some(rd), st: Some(st), mtime: mtime }));
    },
    Err(e) => {
      return Err(fatal("read", inf, e));
    }
  }
  return Ok(Skip(r));
}

function is_missing(looked: Result[FileStat, IoError]): boolean {
  match (looked) {
    Err(e) => {
      return errno.of(e) == errno.ENOENT;
    },
    Ok(_) => {
      return false;
    }
  }
  return false;
}

// process(): one file, or the standard input for "".
function process(r0: Run, path: string): Result[Run, gz.Fail] {
  let opened = open_source(r0, path)?;
  match (opened) {
    Skip(next) => {
      return Ok(next);
    },
    Dir(next, dir) => {
      return recurse(next, dir);
    },
    File(r, src) => {
      return convert(r, src);
    }
  }
  return Ok(r0);
}

// The input of `src` as a feed, read in parts.
function feed_of(path: string, reader: Option[Reader]): gz.Feed {
  match (reader) {
    Some(rd) => {
      return gz.feed_of((n: i32): Result[u8[], gz.Fail] => read_part(rd, n, path));
    },
    None => {
      return gz.memory_feed([]);
    }
  }
  return gz.memory_feed([]);
}

function read_part(rd: Reader, n: i32, path: string): Result[u8[], gz.Fail] {
  match (rd.read_chunk_bytes(n)) {
    Ok(chunk) => {
      return Ok(chunk);
    },
    Err(e) => {
      return Err(fatal("read", path, e));
    }
  }
  return Ok([]);
}

// The input of process(): a listing, a test, or an output. A decompression,
// a test and a listing read the input in parts.
function convert(r: Run, own src: Source): Result[Run, gz.Fail] {
  if (r.o.decode == 0 && !r.o.list) {
    return output(r, src);
  }
  let Source { path, reader, st, mtime } = src;
  let plain = Source { path: path, reader: None, st: st, mtime: mtime };
  let done = match (gz.fill(feed_of(path, reader), gz.HEADER_NEED)) {
    Ok(f) => decode_convert(r, plain, f),
    Err(e) => Err(e),
  };
  if let Some(rd) = reader {
    if (st.is_some()) {
      let _ = rd.close();
    }
  }
  return done;
}

// It keeps the branches of process() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function decode_convert(r: Run, src: Source, own f: gz.Feed): Result[Run, gz.Fail] {
  let o = r.o;
  let h = gz.get_header(f.buf, f.at, true, 0, r.now);
  if (o.list && o.decode != 2) {
    return list_info(r, src, f, h);
  }
  let cat = (h.method == -1 || h.method == -2) && o.force && o.pipeout && o.decode != 2 && !o.list;
  if (h.method != 8 && h.method != 257 && !cat) {
    return Ok(complain(r, "skipping: " + gz.header_refusal(h.method, src.path)));
  }
  if (o.decode == 2) {
    return tested(r, src, f, h);
  }
  return decode_output(r, src, f, h);
}

// A test, with the listing of -l.
function tested(r0: Run, src: Source, own f: gz.Feed, h: gz.Header): Result[Run, gz.Fail] {
  let d = decoded(r0, f, h, src.path, (b: u8[]): Result[void, gz.Fail] => Ok(()))?;
  let r = print_listing(list_members(r0, src, h, d, h.method))?;
  if (d.error.len() > 0) {
    return Ok(complain(r, "skipping: " + d.error));
  }
  if (d.warning.len() > 0) {
    r = complain(r, d.warning);
  }
  return Ok(Run { ...r, o: gz.Options { ...r.o, keep: r.o.keep || d.keep } });
}

// The decompression of the input, with the output to `out` as it decodes.
function decoded(r: Run, own f: gz.Feed, h: gz.Header, path: string, out: (u8[]) => Result[void, gz.Fail]): Result[gz.Decoded, gz.Fail] {
  if (h.method == 8) {
    return gz.infchk(f, h, path, r.o, r.now, out);
  }
  if (h.method == 257) {
    return gz.unlzw(gz.Feed { ...f, at: h.next }, path, out);
  }
  gz.copy_rest(f, out)?;
  return Ok(gz.Decoded { members: [], error: "", warning: "", keep: false, comment: None });
}

// Where the output goes.
enum Dest {
  ToStdout,
  ToFile(string),
  Refused(Run),
}

function destination(r: Run, src: Source, h: gz.Header): Result[Dest, gz.Fail] {
  let o = r.o;
  if (src.st.is_none() || o.pipeout) {
    if (o.decode == 0 && !o.force && isatty(1)) {
      return Err(gz.Fail { why: "trying to write compressed data to a terminal (use -f to force)", code: 22 });
    }
    return Ok(ToStdout);
  }
  let outf = if (o.decode != 0) { gz.decompressed_name(src.path, gz.name_text(h.name), (o.headis & 1) != 0) } else { src.path + o.sufx };
  if (lstat(outf).is_ok() && !o.force && !overwrite(r, outf)) {
    return Ok(Refused(complain(r, "skipping: " + outf + " exists")));
  }
  return Ok(ToFile(outf));
}

// The rest of process() for a compression: write the output to the
// standard output or to a file, then keep the time and the mode, and remove
// the input.
// It keeps the branches of process() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function output(r0: Run, own input: Source): Result[Run, gz.Fail] {
  let h = gz.get_header([], 0, false, 0, r0.now);
  let Source { path, reader, st, mtime } = input;
  let src = Source { path: path, reader: None, st: st, mtime: mtime };
  let dest = destination(r0, src, h)?;
  let outf = match (dest) {
    Refused(r) => {
      return Ok(r);
    },
    ToFile(name) => name,
    ToStdout => "<stdout>",
  };
  let verbose = r0.o.verbosity > 1;
  if (verbose) {
    let _ = stderr().write(src.path + " to " + outf + " ");
  }
  let to_stdout = src.st.is_none() || r0.o.pipeout;
  let r = r0;
  if let Some(rd) = reader {
    r = streamed(r0, src, rd, to_stdout, outf)?;
  }
  if (verbose) {
    let _ = stderr().write("\n");
  }
  if (to_stdout) {
    return Ok(r);
  }
  return finish(r, src, h, outf);
}

// The output of a decompression to `w`.
function sink(w: Writer, outf: string): (u8[]) => Result[void, gz.Fail] {
  return (b: u8[]): Result[void, gz.Fail] => put(w, b, outf);
}

// The rest of process() for a decompression. The output goes to the
// standard output or to a file as it decodes. When the data does not decode,
// the standard output keeps the output before the error, and a file is
// removed.
// It keeps the branches of process() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function decode_output(r0: Run, src: Source, own f: gz.Feed, h: gz.Header): Result[Run, gz.Fail] {
  let dest = destination(r0, src, h)?;
  let outf = match (dest) {
    Refused(r) => {
      return Ok(r);
    },
    ToFile(name) => name,
    ToStdout => "<stdout>",
  };
  let verbose = r0.o.verbosity > 1;
  if (verbose) {
    let _ = stderr().write(src.path + " to " + outf + " ");
  }
  let to_stdout = src.st.is_none() || r0.o.pipeout;
  let w = stdout();
  if (!to_stdout) {
    match (open_writer(outf)) {
      Ok(file) => {
        w = file;
      },
      Err(e) => {
        return Err(fatal("write", outf, e));
      }
    }
  }
  let done = decoded(r0, f, h, src.path, sink(w, outf));
  let failed = match (done) {
    Ok(d) => d.error.len() > 0,
    Err(_) => true,
  };
  let synced: Result[void, IoError] = Ok(());
  if (!to_stdout) {
    if (!failed && r0.o.sync) {
      synced = w.fsync();
    }
    w.close();
    if (failed) {
      let _ = remove_file(outf);
    }
  }
  let d = done?;
  let r = Run { ...r0, o: gz.Options { ...r0.o, keep: r0.o.keep || d.keep } };
  if (d.error.len() > 0) {
    r = complain(r, "skipping: " + d.error);
    if (verbose) {
      let _ = stderr().write("\n");
    }
    return Ok(r);
  }
  if let Err(e) = synced {
    return Err(gz.Fail { why: "sync error on " + outf + " (" + error_text(e) + ")", code: errno.of(e) });
  }
  if (d.warning.len() > 0) {
    r = complain(r, d.warning);
  }
  if (verbose) {
    let _ = stderr().write("\n");
  }
  if (to_stdout) {
    return Ok(r);
  }
  return finish(r, src, h, outf);
}

// The question of pigz when the output exists and the standard input is a
// terminal: the first character of the answer that is not a blank must be
// y or Y.
function overwrite(r: Run, outf: string): boolean {
  if (!isatty(0) || r.o.verbosity == 0) {
    return false;
  }
  let _ = stderr().write(outf + " exists -- overwrite (y/n)? ");
  let Ok(Some(line)) = io.read_line(stdin()) else {
    return false;
  };
  let answer = line.trim_start();
  return answer.starts_with("y") || answer.starts_with("Y");
}

// The end of process() for an output file: copymeta(), then the removal of
// the input, then the time of the header for -dN and -dM.
function finish(r0: Run, src: Source, h: gz.Header, outf: string): Result[Run, gz.Fail] {
  let r = r0;
  let o = r.o;
  copymeta(src.path, outf);
  if (!o.keep) {
    let links = match (src.st) {
      Some(st) => st.nlink,
      None => 1u32,
    };
    if (links > 1u32 && !o.force) {
      r = complain(r, src.path + " has hard links -- not unlinking");
    } else {
      let _ = remove_file(src.path);
    }
  }
  if (o.decode != 0 && (o.headis & 2) != 0 && h.stamp != 0i64) {
    let _ = set_file_times(outf, h.stamp, 0i64, h.stamp, 0i64, 0);
  }
  return Ok(r);
}

// copymeta(): the mode, the owner and the times of a regular file `from`,
// on `to`, as well as the system allows.
function copymeta(from: string, to: string): void {
  let Ok(st) = stat(from) else {
    return;
  };
  if ((st.mode & S_IFMT) != S_IFREG) {
    return;
  }
  let _ = chmod(to, (st.mode & 4095u32) as i32);
  let _ = chown_at(to, st.uid as i32, st.gid as i32, true);
  let _ = set_file_times(to, st.atime, 0i64, st.mtime, 0i64, 0);
}

// The entries of a directory for -r, in the order of readdir().
function recurse(r0: Run, dir: string): Result[Run, gz.Fail] {
  let r = r0;
  let Ok(names) = read_dir(dir) else {
    return Ok(r);
  };
  let base = if (dir.len() > 0 && !dir.ends_with("/")) { dir + "/" } else { dir };
  for name in names {
    r = process(r, base + name)?;
  }
  return Ok(r);
}

function run_all(r0: Run): Result[Run, gz.Fail] {
  let r = r0;
  let o = r.o;
  if (o.files.len() == 0) {
    return process(r, "");
  }
  let done = 0;
  for path in o.files {
    if (done == 1 && r.o.pipeout && r.o.decode == 0 && !r.o.list && r.o.form > 1) {
      r = complain(r, "warning: output will be concatenated zip files -- " + r.prog + " will not be able to extract");
    }
    r = process(r, path)?;
    done += 1;
  }
  return Ok(r);
}

// The options of GZIP and then of PIGZ in the environment, then those of
// the name of the program.
function environment(o0: gz.Options, prog: string): gz.Parsed {
  let o = o0;
  for name in ["GZIP", "PIGZ"] {
    if let Some(text) = env(name) {
      let parsed = gz.parse_env(o, name, text);
      let gz.Run(next) = parsed else {
        return parsed;
      };
      o = next;
    }
  }
  return gz.Run(gz.by_name(o, prog));
}

// What a parse that stops gives: the exit code after its message or text.
function stopped(p: gz.Parsed, prog: string): i32 {
  match (p) {
    gz.Abort(why, verbosity) => {
      if (verbosity > 0) {
        eprint(prog + ": abort: " + why);
      }
      return 22;
    },
    gz.Stop(out, err) => {
      if (out.len() > 0) {
        let _ = stdout().write(out);
      }
      if (err.len() > 0) {
        let _ = stderr().write(err);
      }
      return 0;
    },
    gz.Run(_) => {
      return 0;
    }
  }
  return 0;
}

// It keeps the branches of main() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
function main(): i32 {
  let argv = args();
  let prog = if (argv.len() > 0) { gz.justname(argv[0]) } else { "" };
  if (prog.len() == 0) {
    prog = "pigz";
  }
  let o = gz.defaults();
  let from_env = environment(o, prog);
  let gz.Run(start) = from_env else {
    return stopped(from_env, prog);
  };
  o = start;
  if (argv.len() < 2 && isatty(if (o.decode != 0) { 0 } else { 1 }) && o.verbosity > 0) {
    let _ = stderr().write(gz.help_text());
    return 0;
  }
  let rest: string[] = [];
  for i in 1..argv.len() {
    rest = rest.append(argv[i]);
  }
  let parsed = gz.parse_args(o, rest);
  let gz.Run(all) = parsed else {
    return stopped(parsed, prog);
  };
  o = all;
  let r = Run { o: o, prog: prog, ret: 0, listing: gz.Listing { first: true, text: [] }, now: now_unix_ms() / 1000i64 };
  match (run_all(r)) {
    Ok(done) => {
      return done.ret;
    },
    Err(f) => {
      if (f.code != 32 && o.verbosity > 0) {
        eprint(prog + ": abort: " + f.why);
      }
      return f.code;
    }
  }
  return 0;
}
