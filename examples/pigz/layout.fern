// The block layout of pigz 2.8 over std/deflate/zlib: single_compress for one
// process, and the jobs of parallel_compress for more. With one process,
// pigz writes one deflate stream. With more, each job starts a new stream
// with the 32 KiB before it as its dictionary. So the two give different
// bytes, and each gives the bytes of pigz.
import "std/array";
import "std/worker";
import "std/deflate/zlib" as zd;
import "./zopfli";

pub const DICT: i32 = 32768;

pub struct Settings {
  level: i32,
  strategy: i32,
  // The input bytes of one job: -b in KiB.
  block: i32,
  rsync: boolean,
  // False for -i: each block is independent.
  setdict: boolean,
  // The settings of level 11.
  zopts: zopfli.Options,
}

// OUTPOOL: the first size of the output buffer of a job.
function outpool(block: i32): i32 {
  return block + (block >> 4) + DICT;
}

// grow: the next size of an output buffer.
function grow(size: i32): i32 {
  let was = size;
  let next = size + (size >> 2);
  let top = next;
  let shift = 0;
  while (top > 7) {
    top >>= 1;
    shift += 1;
  }
  if (top == 7) {
    next = 1 << shift + 3;
  }
  if (next < 16) {
    next = 16;
  }
  if (next <= was) {
    return 2147483647;
  }
  return next;
}

// deflate_engine: deflate until the output fits, with an output buffer of
// `size` bytes that grows as pigz grows it. The job output starts at the
// start of the stream.
function engine(own z: zd.Z, size: i32, flush: i32): (zd.Z, i32) {
  let room = size;
  loop {
    if (room - z.delivered == 0) {
      room = grow(room);
    }
    z = zd.deflate(zd.Z { ...z, avail: room - z.delivered }, flush);
    if (z.avail != 0) {
      break;
    }
  }
  return (z, room);
}

// Deflate with the output buffer of a job (`single` false) or of
// single_compress, which writes `size` bytes at a time.
function run(own z: zd.Z, size: i32, flush: i32, single: boolean): (zd.Z, i32) {
  if (single) {
    return (written(z, size, flush), size);
  }
  return engine(z, size, flush);
}

// The end of a run of input that more input follows: a byte boundary, with
// empty static blocks when that is shorter, and a full flush for -i.
function boundary(own z: zd.Z, size: i32, setdict: boolean, single: boolean): (zd.Z, i32) {
  let (a, s1) = run(z, size, zd.BLOCK, single);
  z = a;
  let room = s1;
  let bits = zd.pending_bits(z);
  if ((bits & 1) != 0 || !setdict) {
    let (b, s2) = run(z, room, zd.SYNC_FLUSH, single);
    z = b;
    room = s2;
  } else if ((bits & 7) != 0) {
    while ((bits & 7) != 0) {
      z = zd.prime(z, 10, 2);
      bits = zd.pending_bits(z);
    }
    let (b, s2) = run(z, room, if (single) { zd.NO_FLUSH } else { zd.BLOCK }, single);
    z = b;
    room = s2;
  }
  if (!setdict) {
    let (c, s3) = run(z, room, zd.FULL_FLUSH, single);
    z = c;
    room = s3;
  }
  return (z, room);
}

// One job of parallel_compress: the deflate data of data[from:from + len],
// with the 32 KiB before `from` as its dictionary unless -i. `lens` are the
// lengths of the rsyncable parts of the job, or empty for one part. `more`
// is true when another job follows.
pub function job(own z: zd.Z, s: Settings, data: u8[], from: i32, len: i32, lens: i32[], more: boolean): (zd.Z, u8[]) {
  if (s.level > 9) {
    return (z, zopfli_job(s, data, from, len, lens, more));
  }
  z = zd.start(z, s.level, s.strategy);
  if (s.setdict && from > 0) {
    let dict = if (from < DICT) { from } else { DICT };
    z = zd.set_dictionary(z, data, from - dict, dict);
  }
  let size = outpool(s.block);
  let left = len;
  let pos = from;
  let part = 0;
  loop {
    let n = if (part < lens.len()) { lens[part] } else { left };
    part += 1;
    left -= n;
    z = zd.input(z, data, pos, n);
    pos += n;
    if (left > 0 || more) {
      let (b, room) = boundary(z, size, s.setdict, false);
      z = b;
      size = room;
    } else {
      let (b, room) = engine(z, size, zd.FINISH);
      z = b;
      size = room;
    }
    if (left == 0) {
      break;
    }
  }
  return zd.take(z);
}

// A job of level 11: each part has the window before it, back to the
// dictionary of the job.
function zopfli_job(s: Settings, data: u8[], from: i32, len: i32, lens: i32[], more: boolean): u8[] {
  let start = if (s.setdict && from > DICT) { from - DICT } else if (s.setdict) { 0 } else { from };
  let out: u8[] = [];
  let left = len;
  let pos = from;
  let part = 0;
  loop {
    let n = if (part < lens.len()) { lens[part] } else { left };
    part += 1;
    left -= n;
    out = out.concat(zopfli.block(s.zopts, data, window(start as i64, pos as i64) as i32, pos, n, left > 0 || more, s.setdict));
    pos += n;
    if (left == 0) {
      break;
    }
  }
  return out;
}

// The start of the 32 KiB window before `pos` that does not go before
// `start`.
function window(start: i64, pos: i64): i64 {
  return if (pos - start > DICT as i64) { pos - DICT as i64 } else { start };
}

// The rsyncable hash: a hit is where the 12-bit hash of the bytes so far is
// RSYNCHIT.
pub const RSYNCMASK: i32 = 4095;

pub const RSYNCHIT: i32 = 2047;

// The stream of single_compress between two blocks, and the input bytes
// since its last reset for -i. For level 11, `hist` is the last 32 KiB of
// input since that reset.
pub struct Single {
  z: zd.Z,
  have: i32,
  hist: u8[],
}

pub function single_start(s: Settings): Single {
  return Single { z: zd.start(zd.new(), s.level, s.strategy), have: 0, hist: [] };
}

// One block of single_compress without -R: the deflate data of
// data[from:from + len], where `more` is true when more input follows.
pub function single_block(s: Settings, own st: Single, data: u8[], from: i32, len: i32, more: boolean): (Single, u8[]) {
  let z = st.z;
  let have = st.have;
  let fresh = false;
  if (!s.setdict) {
    have += len;
    if (have > s.block) {
      have = len;
      fresh = true;
    }
  }
  if (s.level > 9) {
    let buf = (if (fresh) { [] } else { st.hist }).concat(array.slice(data, from, from + len));
    let bytes = zopfli.block(s.zopts, buf, 0, buf.len() - len, len, more, s.setdict);
    let keep = if (buf.len() > DICT) { buf.len() - DICT } else { 0 };
    return (Single { z: z, have: have, hist: array.slice(buf, keep, buf.len()) }, bytes);
  }
  if (fresh) {
    z = zd.start(z, s.level, s.strategy);
  }
  z = zd.input(z, data, from, len);
  if (more) {
    let (b, _) = boundary(z, s.block, s.setdict, true);
    z = b;
  } else {
    z = written(z, s.block, zd.FINISH);
  }
  let (next, bytes) = zd.take(z);
  return (Single { z: next, have: have, hist: [] }, bytes);
}

// single_compress over all of `data`, in the blocks of pigz with one
// process.
pub function single(s: Settings, data: u8[]): u8[] {
  if (s.rsync) {
    return single_rsync(s, data);
  }
  let st = single_start(s);
  let out: u8[] = [];
  let from = 0;
  loop {
    let len = if (data.len() - from < s.block) { data.len() - from } else { s.block };
    let more = from + len < data.len();
    let (next, bytes) = single_block(s, st, data, from, len, more);
    st = next;
    out = out.concat(bytes);
    from += len;
    if (!more) {
      break;
    }
  }
  return out;
}

// Input that a compression reads when it needs it: buf holds the input from
// byte `base`. `read` gives up to n more bytes, and none at the end of the
// input.
pub struct Lazy {
  buf: u8[],
  base: i64,
  ended: boolean,
  read: (i32) => u8[],
}

pub function lazy_memory(data: u8[]): Lazy {
  return Lazy { buf: data, base: 0i64, ended: true, read: (n: i32): u8[] => [] };
}

pub function lazy_reader(read: (i32) => u8[]): Lazy {
  return Lazy { buf: [], base: 0i64, ended: false, read: read };
}

// The position after the last byte that `l` holds.
function lazy_end(l: Lazy): i64 {
  return l.base + l.buf.len() as i64;
}

// The input with up to `n` bytes after `at`: n bytes, or fewer at the end
// of the input. It gives the count.
function take(own l: Lazy, at: i64, n: i32): (Lazy, i32) {
  while (!l.ended && lazy_end(l) < at + n as i64) {
    let chunk = l.read((at + n as i64 - lazy_end(l)) as i32);
    if (chunk.len() == 0) {
      l = Lazy { ...l, ended: true };
    } else {
      l = Lazy { ...l, buf: l.buf.concat(chunk) };
    }
  }
  let have = lazy_end(l) - at;
  return (l, if (have < n as i64) { have as i32 } else { n });
}

// The input without the bytes before `at`.
function forget(own l: Lazy, at: i64): Lazy {
  let drop = (at - l.base) as i32;
  if (drop <= 0) {
    return l;
  }
  let rest = __bytes_into(__alloc_u8(l.buf.len() - drop), 0, l.buf, drop, l.buf.len() - drop);
  return Lazy { ...l, buf: rest, base: at };
}

// single_compress with -R over all of `data`.
function single_rsync(s: Settings, data: u8[]): u8[] {
  let out: u8[] = [];
  let all = cell_new(out);
  single_rsync_to(s, lazy_memory(data), (b: u8[]): boolean => appended(all, b));
  return all.get();
}

function appended(all: Cell[u8[]], b: u8[]): boolean {
  all.set(all.get().concat(b));
  return true;
}

// single_compress with -R: a block ends after the last hash hit in it. It
// reads the input in blocks, as pigz does, and gives each block of output
// to `write` until `write` gives false.
// It keeps the branches of single_compress() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
pub function single_rsync_to(s: Settings, own input: Lazy, write: (u8[]) => boolean): void {
  let z = zd.start(zd.new(), s.level, s.strategy);
  let block = s.block;
  let (l0, first) = take(input, 0i64, block);
  let l = l0;
  let pos = 0i64;
  let got = 0;
  let more = first;
  let read = more as i64;
  let have = 0;
  let reset = 0i64;
  let hash = RSYNCHIT;
  loop {
    if (got == 0) {
      got = more;
      let (l1, n) = take(l, read, block);
      l = l1;
      more = n;
      read += more as i64;
    }
    let left = 0;
    if (s.rsync && got > 0) {
      let scan = pos;
      left = got;
      loop {
        if (left == 0) {
          if (more == 0 || got == block) {
            break;
          }
          left = if (more > block - got) { block - got } else { more };
          got += left;
          more -= left;
          if (more == 0) {
            let (l1, n) = take(l, read, block);
            l = l1;
            more = n;
            read += more as i64;
          }
        }
        left -= 1;
        hash = (hash << 1 ^ l.buf[(scan - l.base) as i32] as i32) & RSYNCMASK;
        scan += 1i64;
        if (hash == RSYNCHIT) {
          break;
        }
      }
      got -= left;
    }
    let fresh = false;
    if (!s.setdict) {
      have += got;
      if (have > block) {
        fresh = true;
        have = got;
      }
    }
    if (fresh) {
      z = zd.start(z, s.level, s.strategy);
      reset = pos;
    }
    let at = (pos - l.base) as i32;
    let bytes: u8[] = [];
    if (s.level > 9) {
      let from = window(reset, pos);
      bytes = zopfli.block(s.zopts, l.buf, (from - l.base) as i32, at, got, more > 0 || left > 0, s.setdict);
    } else {
      z = zd.input(z, l.buf, at, got);
      if (more > 0 || left > 0) {
        let (b, _) = boundary(z, block, s.setdict, true);
        z = b;
      } else {
        z = written(z, block, zd.FINISH);
      }
      let (r, out) = zd.take(z);
      z = r;
      bytes = out;
    }
    pos += got as i64;
    got = left;
    if (!write(bytes)) {
      return;
    }
    l = forget(l, if (s.level > 9) { window(reset, pos) } else { pos });
    if (more == 0 && got == 0) {
      break;
    }
  }
}

// DEFLATE_WRITE: deflate with a fresh output buffer of `size` bytes until
// the output fits.
function written(own z: zd.Z, size: i32, flush: i32): zd.Z {
  loop {
    z = zd.deflate(zd.Z { ...z, avail: size }, flush);
    if (z.avail != 0) {
      break;
    }
  }
  return z;
}

// The input of one job of parallel_compress: data[from:from + len], in
// parts of `lens` bytes for -R, and a last part with the rest.
pub struct Job {
  from: i32,
  len: i32,
  lens: i32[],
}

// The jobs of parallel_compress over `data`: blocks of `block` bytes, or
// for -R, blocks that end after the last hash hit in them, with a part for
// each hit.
pub function jobs(s: Settings, data: u8[]): Job[] {
  let total = data.len();
  let out: Job[] = [];
  let none: i32[] = [];
  if (!s.rsync) {
    let from = 0;
    loop {
      let len = if (total - from < s.block) { total - from } else { s.block };
      out = out.append(Job { from: from, len: len, lens: none });
      from += len;
      if (from >= total) {
        break;
      }
    }
    return out;
  }
  return rsync_jobs(s, data);
}

// The jobs of -R over all of `data`.
function rsync_jobs(s: Settings, data: u8[]): Job[] {
  let out: Job[] = [];
  let (g0, l0) = rsync_start(s, lazy_memory(data));
  let g = g0;
  let l = l0;
  loop {
    let (g1, l1, j) = rsync_next(s, g, l);
    g = g1;
    l = l1;
    out = out.append(Job { from: j.from as i32, len: j.len, lens: j.lens });
    if (j.last) {
      break;
    }
  }
  return out;
}

// The state of the jobs of -R between two jobs: the current block cs..ce,
// the next block ns..ne, a block hs..he that waits, and the hash.
pub struct RsyncJobs {
  frontier: i64,
  ns: i64,
  ne: i64,
  hs: i64,
  he: i64,
  scan: i64,
  hash: i32,
  left: i64,
}

// A job of -R: `len` bytes from `from` in the input, in parts of `lens`
// bytes and a last part with the rest. `last` is true for the last job.
pub struct RsyncJob {
  from: i64,
  len: i32,
  lens: i32[],
  last: boolean,
}

pub function rsync_start(s: Settings, own input: Lazy): (RsyncJobs, Lazy) {
  let (l, n) = take(input, 0i64, s.block);
  return (RsyncJobs { frontier: n as i64, ns: 0i64, ne: n as i64, hs: -1i64, he: -1i64, scan: 0i64, hash: RSYNCHIT, left: 0i64 }, l);
}

// The next job of -R: each job ends after the last hash hit in the next
// block. It reads one block past the job.
// It keeps the branches of parallel_compress() of pigz in their order, to check against it.
// fern-lint: allow cyclomatic-complexity
pub function rsync_next(s: Settings, own g: RsyncJobs, own input: Lazy): (RsyncJobs, Lazy, RsyncJob) {
  let l = input;
  let RsyncJobs { frontier, ns, ne, hs, he, scan, hash, left } = g;
  let block = s.block as i64;
  let cs = ns;
  let ce = ne;
  if (hs >= 0i64) {
    ns = hs;
    ne = he;
    hs = -1i64;
  } else {
    let (l1, n) = take(l, frontier, s.block);
    l = l1;
    ns = frontier;
    ne = frontier + n as i64;
    frontier = ne;
  }
  let lens: i32[] = [];
  if (ce > cs) {
    if (left == 0i64) {
      let last = cs;
      while (scan < ce) {
        hash = (hash << 1 ^ l.buf[(scan - l.base) as i32] as i32) & RSYNCMASK;
        scan += 1i64;
        if (hash == RSYNCHIT) {
          lens = lens.append((scan - last) as i32);
          last = scan;
        }
      }
      left = scan - last;
      scan = ns;
    }
    let last = ns;
    let room = block - (ce - cs);
    if (room > ne - ns) {
      room = ne - ns;
    }
    let end = ns + room;
    while (scan < end) {
      hash = (hash << 1 ^ l.buf[(scan - l.base) as i32] as i32) & RSYNCMASK;
      scan += 1i64;
      if (hash == RSYNCHIT) {
        lens = lens.append((scan - last + left) as i32);
        left = 0i64;
        last = scan;
      }
    }
    let n = (if (lens.len() == 0) { scan } else { last }) - ns;
    if (n > 0i64) {
      ce += n;
      ns += n;
      left = 0i64;
    } else if (lens.len() > 0 && left > 0i64 && ne > ns) {
      hs = ns;
      he = ne;
      ns = ce - left;
      ne = ce;
      ce -= left;
    } else {
      left = 0i64;
    }
  }
  let next = RsyncJobs { frontier: frontier, ns: ns, ne: ne, hs: hs, he: he, scan: scan, hash: hash, left: left };
  return (next, l, RsyncJob { from: cs, len: (ce - cs) as i32, lens: lens, last: ne <= ns });
}

// The input without the bytes before `at`, for the caller of rsync_next.
pub function lazy_forget(own l: Lazy, at: i64): Lazy {
  return forget(l, at);
}

// The bytes of `l` from `from` to `to`.
pub function lazy_bytes(l: Lazy, from: i64, to: i64): u8[] {
  let at = (from - l.base) as i32;
  let n = (to - from) as i32;
  return __bytes_into(__alloc_u8(n), 0, l.buf, at, n);
}

// The deflate data of the jobs of parallel_compress in data[start:], one for
// each block, each with the 32 KiB before it as its dictionary. data[:start]
// is the input before them, and `more` is true when more input follows data.
pub function blocks(s: Settings, data: u8[], start: i32, more: boolean): u8[] {
  let z = zd.new();
  let none: i32[] = [];
  let out: u8[] = [];
  let from = start;
  loop {
    let len = if (data.len() - from < s.block) { data.len() - from } else { s.block };
    let last = from + len >= data.len();
    let (next, bytes) = job(z, s, data, from, len, none, more || !last);
    z = next;
    out = out.concat(bytes);
    from += len;
    if (last) {
      break;
    }
  }
  return out;
}

// parallel_compress: the deflate data of the jobs, each compressed with the
// 32 KiB before it as its dictionary. Each worker compresses a run of
// consecutive jobs, and the parent compresses the last run. The output does
// not depend on the count of workers.
pub function parallel(s: Settings, data: u8[], all: Job[], procs: i32): u8[] {
  let count = all.len();
  let workers = if (procs < count) { procs } else { count };
  if (workers < 1) {
    workers = 1;
  }
  let per = (count + workers - 1) / workers;
  let out: u8[] = [];
  for part in runs(s, data, all, 0, per) {
    out = out.concat(part);
  }
  return out;
}

function runs(s: Settings, data: u8[], all: Job[], first: i32, per: i32): u8[][] {
  let count = all.len();
  if (first + per >= count) {
    return [run_jobs(s, data, all, first, count)];
  }
  let w = worker.spawn((): u8[] => run_jobs(s, data, all, first, first + per));
  let rest = runs(s, data, all, first + per, per);
  return [w.join()].concat(rest);
}

function run_jobs(s: Settings, data: u8[], all: Job[], first: i32, end: i32): u8[] {
  let some: Job[] = [];
  for i in first..end {
    some = some.append(all[i]);
  }
  return run_group(s, data, some, end < all.len());
}

// The deflate data of consecutive jobs. `more` is true when a job follows
// the last of them.
pub function run_group(s: Settings, data: u8[], all: Job[], more: boolean): u8[] {
  let z = zd.new();
  let out: u8[] = [];
  for i in 0..all.len() {
    let j = all[i];
    let (next, bytes) = job(z, s, data, j.from, j.len, j.lens, more || i < all.len() - 1);
    z = next;
    out = out.concat(bytes);
  }
  return out;
}
