// age-plugin-batchpass: an age plugin for passphrases from the environment,
// with no terminal. A port of age's cmd/age-plugin-batchpass.
//
//   $ AGE_PASSPHRASE=password age -e -j batchpass file.txt > file.txt.age
//   $ AGE_PASSPHRASE=password age -d -j batchpass file.txt.age > file.txt
import "std/array";
import "std/hex";
import "std/rand";
import "./format";
import "./goflag";
import "./pluginserver";
import "./text";

const USAGE: string = "age-plugin-batchpass is an age plugin that enables non-interactive\npassphrase-based encryption and decryption using environment variables.\n\nWARNING: IN 90% OF CASES, YOU DON'T NEED THIS PLUGIN.\n\nThis functionality is not built into the age CLI because most applications\nshould use native keys instead of scripting passphrase-based encryption.\n\nHumans are notoriously bad at remembering and generating strong passphrases.\nage uses scrypt to partially mitigate this, which is necessarily very slow.\n\nIf a computer will be doing the remembering anyway, you can and should use\nnative keys instead. There is no need to manage separate public and private\nkeys, you encrypt directly to the private key:\n\n    $ age-keygen -o key.txt\n    $ age -e -i key.txt file.txt > file.txt.age\n    $ age -d -i key.txt file.txt.age > file.txt\n\nLikewise, you can store a native identity string in an environment variable\nor through your CI secrets manager and use it to encrypt and decrypt files\nnon-interactively:\n\n    $ export AGE_SECRET=$(age-keygen)\n    $ age -e -i <(echo \"$AGE_SECRET\") file.txt > file.txt.age\n    $ age -d -i <(echo \"$AGE_SECRET\") file.txt.age > file.txt\n\nThe age CLI also natively supports passphrase-encrypted identity files, so you\ncan use that functionality to non-interactively encrypt multiple files such that\nyou will be able to decrypt them later by entering the same passphrase:\n\n    $ age-keygen -pq | age -p -o encrypted-identity.txt\n    Public key: age1pq1cd[... 1950 more characters ...]\n    Enter passphrase (leave empty to autogenerate a secure one):\n    age: using autogenerated passphrase \"eternal-erase-keen-suffer-fog-exclude-huge-scorpion-escape-scrub\"\n    $ age -r age1pq1cd[... 1950 more characters ...] file.txt > file.txt.age\n    $ age -d -i encrypted-identity.txt file.txt.age > file.txt\n    Enter passphrase for identity file \"encrypted-identity.txt\":\n\nFinally, when using this plugin care should be taken not to let the password be\npersisted in the shell history or leaked to other users on multi-user systems.\n\nUsage:\n\n    $ AGE_PASSPHRASE=password age -e -j batchpass file.txt > file.txt.age\n\n    $ AGE_PASSPHRASE=password age -d -j batchpass file.txt.age > file.txt\n\nAlternatively, you can use AGE_PASSPHRASE_FD to read the passphrase from\na file descriptor. Trailing newlines are stripped from the file contents.\n\nWhen encrypting, you can set AGE_PASSPHRASE_WORK_FACTOR to adjust the scrypt\nwork factor (between 1 and 30, default 18). Higher values are more secure\nbut slower. The age CLI refuses to decrypt files above 22, and so does this\nplugin unless AGE_PASSPHRASE_MAX_WORK_FACTOR is set to at least the same value.\n\nWhen decrypting, you can set AGE_PASSPHRASE_MAX_WORK_FACTOR to change the\nmaximum scrypt work factor accepted (between 1 and 30, default 22). This can\nbe used to avoid very slow decryptions, or to allow slower ones.";

// A passphrase with the work factor to encrypt with, or the largest work
// factor to decrypt.
struct Pass { passphrase: u8[], work_factor: i32 }

function q(s: string): string {
  return text.quote(s.as_bytes());
}

const MAX_PASSPHRASE: i32 = 1048576;

// Go's strconv.Atoi, with its message.
function atoi(s: string): Result[i32, string] {
  let digits = if (s.len() > 0 && (s[0] == b'+' || s[0] == b'-')) { 1 } else { 0 };
  if (digits == s.len()) {
    return Err(f"strconv.Atoi: parsing {q(s)}: invalid syntax");
  }
  let v = 0i64;
  for i in digits..s.len() {
    if (s[i] < b'0' || s[i] > b'9') {
      return Err(f"strconv.Atoi: parsing {q(s)}: invalid syntax");
    }
    v = v * 10i64 + (s[i] - b'0') as i64;
    if (v > 9223372036854775807i64 / 10i64) {
      return Err(f"strconv.Atoi: parsing {q(s)}: value out of range");
    }
  }
  let n = if (s[0] == b'-') { 0i64 - v } else { v };
  if (n > 2147483647i64 || n < -2147483648i64) {
    return Ok(if (n > 0i64) { 2147483647 } else { -2147483648 });
  }
  return Ok(n as i32);
}

// The passphrase in a file descriptor, with the new lines at its end cut.
function passphrase_from_fd(fd: i32): Result[u8[], string] {
  if (fd < 0) {
    return Err(f"failed to open file descriptor {fd}");
  }
  let r = match (open_reader(f"/dev/fd/{fd}")) {
    Ok(r) => r,
    Err(_) => {
      return Err(f"failed to read passphrase from fd {fd}: read AGE_PASSPHRASE_FD: bad file descriptor");
    },
  };
  let out: u8[] = [];
  while (out.len() <= MAX_PASSPHRASE) {
    match (r.read_chunk_bytes(MAX_PASSPHRASE + 1 - out.len())) {
      Ok(b) => {
        if (b.len() == 0) {
          break;
        }
        out = out.concat(b);
      },
      Err(e) => {
        return Err(f"failed to read passphrase from fd {fd}: read AGE_PASSPHRASE_FD: {text.errno_text(e)}");
      }
    }
  }
  r.close();
  if (out.len() > MAX_PASSPHRASE) {
    return Err(f"passphrase from fd {fd} is too long");
  }
  let end = out.len();
  while (end > 0 && (out[end - 1] == b'\n' || out[end - 1] == b'\r')) {
    end -= 1;
  }
  return Ok(array.slice(out, 0, end));
}

// age-plugin-batchpass's passphrase: AGE_PASSPHRASE, or the file descriptor
// of AGE_PASSPHRASE_FD.
function passphrase(): Result[u8[], string] {
  let value = env("AGE_PASSPHRASE").unwrap_or("");
  let fd = env("AGE_PASSPHRASE_FD").unwrap_or("");
  if (value.len() > 0 && fd.len() > 0) {
    return Err("AGE_PASSPHRASE and AGE_PASSPHRASE_FD are mutually exclusive");
  }
  if (value.len() == 0 && fd.len() == 0) {
    return Err("either AGE_PASSPHRASE or AGE_PASSPHRASE_FD must be set");
  }
  if (value.len() > 0) {
    return Ok(value.bytes());
  }
  let n = match (atoi(fd)) {
    Ok(n) => n,
    Err(why) => {
      return Err("invalid AGE_PASSPHRASE_FD: " + why);
    },
  };
  return passphrase_from_fd(n);
}

// A work factor from the environment: the default when it is not set.
function work_factor(name: string, default: i32): Result[i32, string] {
  let v = env(name).unwrap_or("");
  if (v.len() == 0) {
    return Ok(default);
  }
  let n = match (atoi(v)) {
    Ok(n) => n,
    Err(why) => {
      return Err(f"invalid {name}: {why}");
    },
  };
  if (n > 30 || n < 1) {
    return Err(f"{name} must be between 1 and 30");
  }
  return Ok(n);
}

function identity_as_recipient(data: u8[]): Result[Pass, string] {
  if (data.len() != 0) {
    return Err("batchpass identity does not take any payload");
  }
  let pass = passphrase()?;
  if (pass.len() == 0) {
    return Err("failed to create scrypt recipient: passphrase can't be empty");
  }
  let n = work_factor("AGE_PASSPHRASE_WORK_FACTOR", format.SCRYPT_WORK_FACTOR)?;
  return Ok(Pass { passphrase: pass, work_factor: n });
}

function identity(data: u8[]): Result[Pass, string] {
  if (data.len() != 0) {
    return Err("batchpass identity does not take any payload");
  }
  let pass = passphrase()?;
  let n = work_factor("AGE_PASSPHRASE_MAX_WORK_FACTOR", format.SCRYPT_MAX_WORK_FACTOR)?;
  return Ok(Pass { passphrase: pass, work_factor: n });
}

// age's ScryptRecipient.WrapWithLabels: the scrypt stanza and a random label,
// so that no other recipient can join it.
function wrap(own s: pluginserver.Session, p: Pass, file_key: u8[]): (pluginserver.Session, Result[pluginserver.Wrapped, string]) {
  return match (format.wrap_scrypt(file_key, p.passphrase, rand.bytes(16), p.work_factor)) {
    Ok(st) => (s, Ok(pluginserver.Wrapped { stanzas: [st], labels: [hex.encode(rand.bytes(16))] })),
    Err(why) => (s, Err(why)),
  };
}

// batchpassIdentity.Unwrap: the file must have one scrypt stanza, and a
// wrong passphrase is an error.
function unwrap(own s: pluginserver.Session, p: Pass, stanzas: format.Stanza[]): (pluginserver.Session, format.Unwrapped) {
  for st in stanzas {
    if (st.kind == "scrypt" && stanzas.len() != 1) {
      return (s, format.Invalid("an scrypt recipient must be the only one"));
    }
  }
  if (stanzas.len() != 1 || stanzas[0].kind != "scrypt") {
    return (s, format.Invalid("file is not passphrase-encrypted"));
  }
  if (p.passphrase.len() == 0) {
    return (s, format.Invalid("passphrase can't be empty"));
  }
  let got = format.unwrap_scrypt_max(stanzas[0], p.passphrase, p.work_factor);
  return match (got) {
    format.Incorrect => (s, format.Invalid("incorrect passphrase")),
    _ => (s, got),
  };
}

function main(): i32 {
  let argv = args();
  let flags = match (pluginserver.flags(goflag.Names { bools: [], values: [] }, USAGE, array.slice(argv, 1, argv.len()))) {
    Ok(f) => f,
    Err(code) => {
      return code;
    },
  };
  let (machine, version) = pluginserver.machine_of(flags);
  if (version) {
    print(pluginserver.VERSION);
    return 0;
  }
  let h = pluginserver.Handlers { name: "batchpass", recipient: None, identity_as_recipient: Some(identity_as_recipient), identity: Some(identity), wrap: wrap, unwrap: unwrap };
  return pluginserver.serve(h, machine);
}
