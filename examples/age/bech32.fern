// Bech32 (BIP 173) as age uses it: no limit on the length, and the messages
// of the age bech32 package for each malformed string.
import "./text";

const CHARSET: string = "qpzry9x8gf2tvdw0s3jn54khce6mua7l";

const GEN: i32[] = [0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3];

// The bytes in a key line before its data part: an X25519 key and an
// ML-KEM-768 + X25519 key.
pub const SECRET_PREFIX: string = "AGE-SECRET-KEY-1";

pub const PQ_SECRET_PREFIX: string = "AGE-SECRET-KEY-PQ-1";

function polymod_step(chk: i32, v: i32): i32 {
  let b = chk >> 25;
  let next = (chk & 0x1ffffff) << 5 ^ v;
  for i in 0..5 {
    next ^= -(b >> i & 1) & GEN[i];
  }
  return next;
}

// The checksum state after the expanded human-readable part. The part must
// be lower case.
function hrp_state(hrp: [u8]): i32 {
  let chk = 1;
  for c in hrp {
    chk = polymod_step(chk, c as i32 >> 5);
  }
  chk = polymod_step(chk, 0);
  for c in hrp {
    chk = polymod_step(chk, c as i32 & 31);
  }
  return chk;
}

function lower_ascii(c: u8): u8 {
  if (c >= b'A' && c <= b'Z') {
    return c + 32;
  }
  return c;
}

function upper_ascii(c: u8): u8 {
  if (c >= b'a' && c <= b'z') {
    return c - 32;
  }
  return c;
}

function lowered(s: [u8]): u8[] {
  let out = __alloc_u8(s.len());
  for i in 0..s.len() {
    out = out.with(i, lower_ascii(s[i]));
  }
  return out;
}

// 8-bit groups to 5-bit groups, with the last group padded with zero bits.
function to_five(data: [u8]): u8[] {
  let out: u8[] = [];
  let acc = 0;
  let bits = 0;
  for v in data {
    acc = (acc << 8 | v as i32) & 0xfff;
    bits += 8;
    while (bits >= 5) {
      bits -= 5;
      out = out.append((acc >> bits & 31) as u8);
    }
  }
  if (bits > 0) {
    out = out.append((acc << 5 - bits & 31) as u8);
  }
  return out;
}

// Encodes data under hrp. An upper-case hrp gives an upper-case string, as
// age writes a secret key.
pub function encode(hrp: string, data: [u8]): string {
  let low = lowered(hrp.as_bytes());
  let values = to_five(data);
  let chk = hrp_state(low);
  for v in values {
    chk = polymod_step(chk, v as i32);
  }
  for _ in 0..6 {
    chk = polymod_step(chk, 0);
  }
  chk ^= 1;
  let out = low.append(b'1');
  for v in values {
    out = out.append(CHARSET[v as i32]);
  }
  for i in 0..6 {
    out = out.append(CHARSET[chk >> 5 * (5 - i) & 31]);
  }
  if (hrp.to_ascii_lower() != hrp) {
    for i in 0..out.len() {
      out = out.with(i, upper_ascii(out[i]));
    }
  }
  return text.ascii(out);
}

pub struct Decoded { hrp: string, data: u8[] }

function charset_index(c: u8): Option[i32] {
  for i in 0..32 {
    if (CHARSET[i] == c) {
      return Some(i);
    }
  }
  return None;
}

function has_case(s: [u8], lo: u8, hi: u8): boolean {
  for c in s {
    if (c >= lo && c <= hi) {
      return true;
    }
  }
  return false;
}

// 5-bit groups to bytes. The padding must be shorter than five bits and zero.
function from_five(values: [u8]): Result[u8[], string] {
  let out: u8[] = [];
  let acc = 0;
  let bits = 0;
  for v in values {
    acc = (acc << 5 | v as i32) & 0xfff;
    bits += 5;
    if (bits >= 8) {
      bits -= 8;
      out = out.append((acc >> bits & 255) as u8);
    }
  }
  if (bits >= 5) {
    return Err("illegal zero padding");
  }
  if ((acc << 8 - bits & 255) != 0) {
    return Err("non-zero padding");
  }
  return Ok(out);
}

// The index of the last "1" in s, or -1.
function separator(s: [u8]): i32 {
  let pos = -1;
  for i in 0..s.len() {
    if (s[i] == b'1') {
      pos = i;
    }
  }
  return pos;
}

function check_hrp(hrp: [u8]): Result[i32, string] {
  let at = 0;
  while (at < hrp.len()) {
    let (r, n) = text.rune_at(hrp, at);
    if (r < 33 || r > 126) {
      return Err(f"invalid character human-readable part: s[{at}]={r}");
    }
    at += n;
  }
  return Ok(0);
}

// The 5-bit values of the data part. Go reports a bad character by its
// offset in the part and its value in the lowered string.
function data_values(part: [u8]): Result[u8[], string] {
  let values: u8[] = [];
  for at in 0..part.len() {
    let (rune, n) = text.rune_at(part, at);
    let low = lower_ascii(part[at]);
    let found = if (n == 1) { charset_index(low) } else { None };
    let Some(v) = found else {
      let r = if (n == 1) { low as i32 } else { rune };
      return Err(f"invalid character data part: s[{at}]={r}");
    };
    values = values.append(v as u8);
  }
  return Ok(values);
}

// Decodes s, a string that is not secret. The error is the message of the age
// bech32 package.
pub function decode(s: [u8]): Result[Decoded, string] {
  if (has_case(s, b'a', b'z') && has_case(s, b'A', b'Z')) {
    return Err("mixed case");
  }
  let pos = separator(s);
  if (pos < 1 || pos + 7 > s.len()) {
    return Err(f"separator '1' at invalid position: pos={pos}, len={s.len()}");
  }
  check_hrp(s[0:pos])?;
  let values = data_values(s[pos + 1:s.len()])?;
  let chk = hrp_state(lowered(s[0:pos]));
  for v in values {
    chk = polymod_step(chk, v as i32);
  }
  if (chk != 1) {
    return Err("invalid checksum");
  }
  let data = from_five(values[0:values.len() - 6])?;
  return Ok(Decoded { hrp: text.ascii(s[0:pos]), data: data });
}

// 1 when lo <= c <= hi, else 0, with no branch on c.
function within(c: i32, lo: i32, hi: i32): i32 {
  return (c - lo | hi - c) >> 31 & 1 ^ 1;
}

// Decodes the data part of a secret key line, the bytes after prefix, with
// no branch and no index on its bytes. The line starts with prefix, and the
// caller marks the data part secret. The result is the 32 bytes of the key,
// or None when the line is not a valid key: then the caller gets the message
// from decode.
pub function decode_secret(line: [u8], prefix: string): Option[u8[]] {
  if (line.len() != prefix.len() + 58) {
    return None;
  }
  let data = line[prefix.len():line.len()];
  let bad = 0;
  let chk = hrp_state(lowered(prefix.as_bytes()[0:prefix.len() - 1]));
  let out = __alloc_u8(32);
  let acc = 0;
  let bits = 0;
  let at = 0;
  for i in 0..58 {
    let c = data[i] as i32;
    bad |= within(c, 97, 122);
    let low = c | within(c, 65, 90) << 5;
    let v = 0;
    let found = 0;
    for j in 0..32 {
      let hit = (low ^ CHARSET[j] as i32) - 1 >> 31 & 1;
      v |= -hit & j;
      found |= hit;
    }
    bad |= found ^ 1;
    chk = polymod_step(chk, v);
    if (i < 52) {
      acc = (acc << 5 | v) & 0xfff;
      bits += 5;
      if (bits >= 8) {
        bits -= 8;
        out = out.with(at, (acc >> bits & 255) as u8);
        at += 1;
      }
    }
  }
  bad |= acc & 15;
  bad |= chk ^ 1;
  let verdict = __alloc_u8(1);
  verdict = verdict.with(0, ((bad | -bad) >> 31 & 1) as u8);
  __ct_public(verdict);
  if (verdict[0] != 0) {
    return None;
  }
  return Some(out);
}
