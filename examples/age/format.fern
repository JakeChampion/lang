// The age v1 format: the header, its MAC, the X25519 recipient stanza, and
// the STREAM of ChaCha20-Poly1305 chunks (age-encryption.org/v1).
import "std/array";
import "std/crypto";
import "std/crypto/aead";
import "std/crypto/chacha20poly1305";
import "std/crypto/hpke";
import "std/option";
import "std/result";
import "std/crypto/scrypt";
import "std/crypto/x25519";
import "./source";
import "./text";

pub const INTRO: string = "age-encryption.org/v1";

// The plaintext bytes in one chunk of the payload.
pub const CHUNK: i32 = 65536;

// The bytes of a sealed chunk: the text and the 16-byte tag.
pub const SEALED: i32 = 65552;

const X25519_LABEL: string = "age-encryption.org/v1/X25519";

const SCRYPT_LABEL: string = "age-encryption.org/v1/scrypt";

// The scrypt work factor of age's ScryptRecipient, and the largest that its
// ScryptIdentity accepts.
pub const SCRYPT_WORK_FACTOR: i32 = 18;

pub const SCRYPT_MAX_WORK_FACTOR: i32 = 22;

pub struct Stanza { kind: string, args: string[], body: u8[] }

pub struct Header { stanzas: Stanza[], mac: u8[] }

// The prefix of age's format.ParseError.
function parse_error(m: string): string {
  return "parsing age header: " + m;
}

// The limits of age's header reader: its bytes, its stanzas and the
// arguments of one stanza.
const MAX_HEADER: i32 = 2097152;

const MAX_STANZAS: i32 = 1024;

const MAX_ARGS: i32 = 128;

const TOO_BIG: string = "parsing age header: header exceeds 2 MiB";

// A stanza argument: one or more bytes from 33 to 126.
function valid_arg(a: [u8]): boolean {
  if (a.len() == 0) {
    return false;
  }
  for c in a {
    if (c < 33 || c > 126) {
      return false;
    }
  }
  return true;
}

// age's splitArgs: the line without its "\n", cut at the first space, and
// the arguments after it, split at each space. When an argument is not valid,
// or there are too many, the prefix is the whole line with no arguments.
function split_args(line: [u8]): (u8[], u8[][]) {
  let n = line.len();
  if (n > 0 && line[n - 1] == b'\n') {
    n -= 1;
  }
  let Some(cut) = first_space(line, n) else {
    return (text.copy(line[0:n]), []);
  };
  let args: u8[][] = [];
  let start = cut + 1;
  for i in cut + 1..n + 1 {
    if (i == n || line[i] == b' ') {
      let arg = line[start:i];
      if (!valid_arg(arg) || args.len() > MAX_ARGS) {
        return (text.copy(line[0:n]), []);
      }
      args = args.append(text.copy(arg));
      start = i + 1;
    }
  }
  return (text.copy(line[0:cut]), args);
}

function first_space(line: [u8], n: i32): Option[i32] {
  for i in 0..n {
    if (line[i] == b' ') {
      return Some(i);
    }
  }
  return None;
}

function body_line_error(line: [u8], why: string): string {
  return parse_error("malformed body line " + text.quote(line) + ": " + why);
}

// A header line. used is the count of header bytes before it; a line past
// the limit of age's header reader gives TOO_BIG.
function header_line(own s: source.Src, used: i32): (source.Src, u8[], Option[string]) {
  let (t, line, f) = source.read_line(s, MAX_HEADER - used);
  if (line.len() > MAX_HEADER - used) {
    return (t, line, Some(TOO_BIG));
  }
  return match (f) {
    Some(e) => (t, line, Some(e.message())),
    None => (t, line, None),
  };
}

// A stanza and the header bytes after it, or the message after
// "failed to parse header: ".
struct Parsed { stanza: Stanza, used: i32 }

function read_body(own s: source.Src, used: i32, kind: string, args: string[]): (source.Src, Result[Parsed, string]) {
  let body: u8[] = [];
  loop {
    let (t, line, f) = header_line(s, used);
    s = t;
    if let Some(why) = f {
      return (s, Err("failed to read line: " + why));
    }
    used += line.len();
    let content = line[0:line.len() - 1];
    let b = match (text.decode_string(content)) {
      Ok(b) => b,
      Err(why) => {
        if (text.has_prefix(line, "---") || text.has_prefix(line, "->")) {
          return (s, Err("malformed body line " + text.quote(line) + ": stanza ended without a short line\nnote: this might be a file encrypted with an old beta version of age or rage; use age v1.0.0-beta6 or rage to decrypt it"));
        }
        return (s, Err(body_line_error(line, why)));
      },
    };
    if (b.len() > 48) {
      return (s, Err(body_line_error(line, "too long")));
    }
    body = body.concat(b);
    if (b.len() < 48) {
      return (s, Ok(Parsed { stanza: Stanza { kind: kind, args: args, body: body }, used: used }));
    }
  }
  return (s, Err(""));
}

// age's StanzaReader.ReadStanza.
function read_stanza(own s: source.Src, used: i32): (source.Src, Result[Parsed, string]) {
  let (t, line, f) = header_line(s, used);
  if let Some(why) = f {
    return (t, Err("failed to read line: " + why));
  }
  if (!text.has_prefix(line, "->")) {
    return (t, Err("malformed stanza opening line: " + text.quote(line)));
  }
  let (prefix, parts) = split_args(line);
  if (!text.equals(prefix, "->") || parts.len() < 1) {
    return (t, Err("malformed stanza: " + text.quote(line)));
  }
  let args: string[] = [];
  for i in 1..parts.len() {
    args = args.append(text.ascii(parts[i]));
  }
  return read_body(t, used + line.len(), text.ascii(parts[0]), args);
}

// The MAC line, after "---".
function read_mac(own s: source.Src, used: i32): (source.Src, Result[u8[], string]) {
  let (t, line, f) = header_line(s, used);
  if let Some(why) = f {
    return (t, Err("failed to read header: " + why));
  }
  let (prefix, args) = split_args(line);
  if (!text.equals(prefix, "---") || args.len() != 1) {
    return (t, Err(parse_error("malformed closing line: " + text.quote(line))));
  }
  match (text.decode_string(args[0])) {
    Ok(mac) => {
      if (mac.len() != 32) {
        return (t, Err(parse_error("malformed closing line " + text.quote(line) + ": <nil>")));
      }
      return (t, Ok(mac));
    },
    Err(why) => {
      return (t, Err(parse_error("malformed closing line " + text.quote(line) + ": " + why)));
    }
  }
}

// age's describeIntro: the start of a bad intro line, quoted, or None for a
// line that holds a key.
function describe_intro(line: [u8]): Option[string] {
  if (text.has_prefix(line, "AGE-SECRET-KEY-") || text.has_prefix(line, "AGE-PLUGIN-")) {
    return None;
  }
  let n = if (line.len() < INTRO.len() + 1) { line.len() } else { INTRO.len() + 1 };
  return Some(text.quote(line[0:n]));
}

// The message for an intro line that is not age's.
function intro_error(line: [u8], f: Option[string]): Option[string] {
  let Some(why) = f else {
    if (text.equals(line, INTRO + "\n")) {
      return None;
    }
    return match (describe_intro(line)) {
      Some(d) => Some(parse_error("unexpected intro: " + d)),
      None => Some(parse_error("unexpected intro, expected " + text.quote((INTRO + "\n").as_bytes()))),
    };
  };
  if (why == TOO_BIG) {
    return Some(why);
  }
  if (why != "EOF") {
    return Some(parse_error("failed to read intro: " + why));
  }
  if (line.len() == 0) {
    return Some(parse_error("file is empty"));
  }
  return match (describe_intro(line)) {
    Some(d) => Some(parse_error("unexpected EOF reading intro: " + d)),
    None => Some(parse_error("unexpected EOF reading intro, expected " + text.quote((INTRO + "\n").as_bytes()))),
  };
}

// The MAC line and the header that it ends.
function header_end(own s: source.Src, used: i32, stanzas: Stanza[]): (source.Src, Result[Header, string]) {
  let (v, mac) = read_mac(s, used);
  return match (mac) {
    Ok(m) => if (stanzas.len() == 0) {
      (v, Err(parse_error("no recipient stanzas")))
    } else {
      (v, Ok(Header { stanzas: stanzas, mac: m }))
    },
    Err(why) => (v, Err(why)),
  };
}

// age's format.Parse. The error is the message after "failed to read
// header: ".
pub function parse(own s: source.Src): (source.Src, Result[Header, string]) {
  let (t, intro, f) = header_line(s, 0);
  s = t;
  if let Some(why) = intro_error(intro, f) {
    return (s, Err(why));
  }
  let used = intro.len();
  let stanzas: Stanza[] = [];
  loop {
    if (used + 3 > MAX_HEADER) {
      return (s, Err(TOO_BIG));
    }
    let (u, g) = source.peek(s, 3);
    s = u;
    if let Some(e) = g {
      return (s, Err(parse_error("failed to read header: " + e.message())));
    }
    if (source.next_is(s, "---")) {
      return header_end(s, used, stanzas);
    }
    if (stanzas.len() == MAX_STANZAS) {
      return (s, Err(parse_error(f"header contains more than {MAX_STANZAS} recipient stanzas")));
    }
    let (v, st) = read_stanza(s, used);
    s = v;
    match (st) {
      Ok(x) => {
        stanzas = stanzas.append(x.stanza);
        used = x.used;
      },
      Err(why) => {
        return (s, Err("failed to parse header: " + why));
      }
    }
  }
  return (s, Err(""));
}

// A stanza as the header holds it: the body is in lines of 64 columns, and
// the last line is shorter, so it can be empty.
pub function marshal_stanza(st: Stanza): string {
  let out = "-> " + st.kind;
  for a in st.args {
    out += " " + a;
  }
  out += "\n";
  let body = text.b64_raw(st.body);
  let at = 0;
  while (at + 64 <= body.len()) {
    out += body[at:at + 64].unwrap_or("") + "\n";
    at += 64;
  }
  return out + body[at:body.len()].unwrap_or("") + "\n";
}

// The header up to and with "---": the bytes that the MAC covers.
pub function marshal_without_mac(h: Header): string {
  let out = INTRO + "\n";
  for st in h.stanzas {
    out += marshal_stanza(st);
  }
  return out + "---";
}

pub function marshal(h: Header): string {
  return marshal_without_mac(h) + " " + text.b64_raw(h.mac) + "\n";
}

pub function header_mac(file_key: [u8], h: Header): u8[] {
  let key = crypto.hkdf_sha256([], file_key, "header".as_bytes(), 32);
  let mac = crypto.hmac_sha256(key, marshal_without_mac(h).as_bytes());
  crypto.erase(key);
  return mac;
}

// True when the MAC of the header under the file key is the MAC in the
// header. Only the verdict is public.
pub function mac_ok(file_key: [u8], h: Header): boolean {
  let want = header_mac(file_key, h);
  let diff = 0;
  for i in 0..32 {
    diff |= want[i] ^ h.mac[i];
  }
  let verdict = __alloc_u8(1);
  verdict = verdict.with(0, diff);
  __ct_public(verdict);
  return verdict[0] == 0;
}

// The nonce of chunk n as the iv and the sequence number that
// std/crypto/chacha20poly1305 folds into the iv: an 11-byte big-endian counter
// and a last-chunk flag byte. The counter must be less than 2^55.
pub function chunk_seq(n: i64, last: boolean): u64 {
  let flag = if (last) { 1i64 } else { 0i64 };
  return (n << 8 | flag) as u64;
}

// The 12 bytes of the nonce of chunk n.
pub function chunk_nonce(n: i64, last: boolean): u8[] {
  let seq = chunk_seq(n, last);
  let out = __alloc_u8(12);
  for i in 0..8 {
    out = out.with(4 + i, (seq >> (56 - 8 * i) as u64 & 255u64) as u8);
  }
  return out;
}

pub const ZERO_IV: u8[] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];

// The key of the payload STREAM: HKDF-SHA256 with the payload nonce as salt.
pub function payload_key(file_key: [u8], nonce: [u8]): Result[chacha20poly1305.Key, aead.AeadError] {
  let k = crypto.hkdf_sha256(nonce, file_key, "payload".as_bytes(), 32);
  let key = chacha20poly1305.key(k);
  crypto.erase(k);
  return key;
}

// Seals buf[0:n] as chunk index in place and gives the n + 16 sealed bytes.
pub function seal_chunk(k: chacha20poly1305.Key, index: i64, last: boolean, own buf: u8[], n: i32): Result[u8[], aead.AeadError] {
  return k.seal_in_place(ZERO_IV, chunk_seq(index, last), buf, 0, 0, 0, n);
}

// Opens a sealed chunk. The result holds the plaintext in its first
// sealed.len() - 16 bytes.
pub function open_chunk(k: chacha20poly1305.Key, index: i64, last: boolean, own sealed: u8[]): Option[u8[]] {
  let n = sealed.len() - 16;
  if (n < 0) {
    return None;
  }
  match (k.open_in_place(ZERO_IV, chunk_seq(index, last), sealed, 0, 0, 0, n)) {
    Ok(b) => {
      return Some(b);
    },
    Err(_) => {
      return None;
    }
  }
}

function wrap_key(shared: [u8], share: [u8], recipient: [u8]): Result[chacha20poly1305.Key, aead.AeadError] {
  let k = crypto.hkdf_sha256(text.copy(share).concat(recipient), shared, X25519_LABEL.as_bytes(), 32);
  let key = chacha20poly1305.key(k);
  crypto.erase(k);
  return key;
}

// The X25519 stanza that wraps the file key to the recipient's public key.
// ephemeral is a fresh secret scalar.
pub function wrap(file_key: [u8], recipient: [u8], ephemeral: [u8]): Result[Stanza, string] {
  let share = match (x25519.public_key(ephemeral)) {
    Ok(p) => p,
    Err(e) => {
      return Err(e.message());
    },
  };
  __ct_public(share);
  let shared = match (x25519.x25519(ephemeral, recipient)) {
    Ok(p) => p,
    Err(e) => {
      return Err(e.message());
    },
  };
  let wrapped = wrap_key(shared, share, recipient);
  crypto.erase(shared);
  let body = match (wrapped) {
    Ok(key) => match (key.seal(ZERO_IV, file_key, [])) {
      Ok(b) => b,
      Err(e) => {
        return Err(e.message());
      },
    },
    Err(e) => {
      return Err(e.message());
    },
  };
  __ct_public(body);
  return Ok(Stanza { kind: "X25519", args: [text.b64_raw(share)], body: body });
}

// The result of one identity on one stanza.
pub enum Unwrapped {
  FileKey(u8[]),
  // Not this identity's stanza: age's ErrIncorrectIdentity.
  Incorrect,
  Invalid(string),
}

// age's X25519Identity.unwrap. scalar is secret; public is its public key.
// The ephemeral share of an X25519 stanza.
function share_of(st: Stanza): Result[u8[], string] {
  if (st.args.len() != 1) {
    return Err("invalid X25519 recipient block");
  }
  let share = match (text.decode_string(st.args[0].as_bytes())) {
    Ok(b) => b,
    Err(why) => {
      return Err("failed to parse X25519 recipient: " + why);
    },
  };
  if (share.len() != 32) {
    return Err("invalid X25519 recipient block");
  }
  return Ok(share);
}

pub function unwrap(st: Stanza, scalar: [u8], public: [u8]): Unwrapped {
  if (st.kind != "X25519") {
    return Incorrect;
  }
  let share = match (share_of(st)) {
    Ok(b) => b,
    Err(why) => {
      return Invalid(why);
    },
  };
  let shared = match (x25519.x25519(scalar, share)) {
    Ok(p) => p,
    Err(_) => {
      return Invalid("invalid X25519 recipient: crypto/ecdh: bad X25519 remote ECDH input: low order point");
    },
  };
  let key = wrap_key(shared, share, public);
  crypto.erase(shared);
  if (st.body.len() != 32) {
    return Invalid("invalid X25519 recipient block: incorrect file key size");
  }
  let Ok(k) = key else {
    return Incorrect;
  };
  return match (k.open(ZERO_IV, st.body, [])) {
    Ok(file_key) => FileKey(file_key),
    Err(_) => Incorrect,
  };
}

// The HPKE info of the mlkem768x25519 stanza.
const PQ_LABEL: string = "age-encryption.org/mlkem768x25519";

// The mlkem768x25519 stanza that wraps the file key to the 1216-byte public
// key of a hybrid recipient with HPKE. randomness is 64 fresh secret bytes.
pub function wrap_hybrid(file_key: [u8], public: [u8], randomness: [u8]): Result[Stanza, string] {
  let sender = match (hpke.setup_sender_derand(public, PQ_LABEL.as_bytes(), randomness)) {
    Ok(s) => s,
    Err(e) => {
      return Err("failed to set up HPKE sender: " + e.message());
    },
  };
  let (body, _) = sender.context.seal([], file_key);
  __ct_public(sender.enc);
  __ct_public(body);
  return Ok(Stanza { kind: "mlkem768x25519", args: [text.b64_raw(sender.enc)], body: body });
}

// The encapsulated key of an mlkem768x25519 stanza, after the checks of the
// stanza.
function enc_of(st: Stanza): Result[u8[], string] {
  if (st.args.len() != 1) {
    return Err("invalid mlkem768x25519 recipient block");
  }
  let enc = match (text.decode_string(st.args[0].as_bytes())) {
    Ok(b) => b,
    Err(why) => {
      return Err("failed to parse mlkem768x25519 recipient: " + why);
    },
  };
  if (st.body.len() != 32) {
    return Err("encrypted value has unexpected length");
  }
  return Ok(enc);
}

// age's HybridIdentity.unwrap.
pub function unwrap_hybrid(st: Stanza, k: hpke.HybridKey): Unwrapped {
  if (st.kind != "mlkem768x25519") {
    return Incorrect;
  }
  let enc = match (enc_of(st)) {
    Ok(b) => b,
    Err(why) => {
      return Invalid(why);
    },
  };
  let c = match (hpke.setup_recipient(k, enc, PQ_LABEL.as_bytes())) {
    Ok(c) => c,
    Err(hpke.LowOrder) => {
      return Invalid("invalid mlkem768x25519 recipient: crypto/ecdh: bad X25519 remote ECDH input: low order point");
    },
    Err(_) => {
      return Invalid("invalid mlkem768x25519 recipient: invalid encapsulated key size");
    },
  };
  return match (c.open([], st.body)) {
    Ok((file_key, _)) => FileKey(file_key),
    Err(_) => Incorrect,
  };
}

// The wrapping key of an scrypt stanza: scrypt with N = 2^log_n, r = 8 and
// p = 1, and the label before the salt.
function scrypt_key(passphrase: [u8], salt: [u8], log_n: i32): Result[chacha20poly1305.Key, string] {
  let k = match (scrypt.key(passphrase, SCRYPT_LABEL.bytes().concat(salt), 1 << log_n, 8, 1, 32)) {
    Ok(k) => k,
    Err(e) => {
      return Err("failed to generate scrypt hash: " + e.message());
    },
  };
  let key = chacha20poly1305.key(k);
  crypto.erase(k);
  return match (key) {
    Ok(key) => Ok(key),
    Err(e) => Err(e.message()),
  };
}

// The scrypt stanza that wraps the file key with a passphrase. salt is 16
// fresh bytes.
pub function wrap_scrypt(file_key: [u8], passphrase: [u8], salt: [u8], log_n: i32): Result[Stanza, string] {
  let key = scrypt_key(passphrase, salt, log_n)?;
  let body = match (key.seal(ZERO_IV, file_key, [])) {
    Ok(b) => b,
    Err(e) => {
      return Err(e.message());
    },
  };
  __ct_public(body);
  return Ok(Stanza { kind: "scrypt", args: [text.b64_raw(salt), log_n.to_string()], body: body });
}

// age's check of the work factor: decimal digits that do not start with 0,
// then Go's strconv.Atoi, then the limit of age.
function work_factor(w: string): Result[i32, string] {
  let encoding = f"scrypt work factor encoding invalid: {text.quote(w.as_bytes())}";
  if (w.len() == 0 || w[0] == b'0') {
    return Err(encoding);
  }
  let v = 0i64;
  let overflow = false;
  for c in w.bytes() {
    if (c < b'0' || c > b'9') {
      return Err(encoding);
    }
    let d = (c - b'0') as i64;
    if (v > (9223372036854775807i64 - d) / 10i64) {
      overflow = true;
    }
    v = v * 10i64 + d;
  }
  if (overflow) {
    return Err(f"failed to parse scrypt work factor: strconv.Atoi: parsing {text.quote(w.as_bytes())}: value out of range");
  }
  if (v > SCRYPT_MAX_WORK_FACTOR as i64) {
    return Err(f"scrypt work factor too large: {v}");
  }
  return Ok(v as i32);
}

// age's ScryptIdentity.unwrap for one stanza.
// The salt and the work factor of an scrypt stanza.
function scrypt_args(st: Stanza): Result[(u8[], i32), string] {
  if (st.args.len() != 2) {
    return Err("invalid scrypt recipient block");
  }
  let salt = match (text.decode_string(st.args[0].as_bytes())) {
    Ok(b) => b,
    Err(why) => {
      return Err("failed to parse scrypt salt: " + why);
    },
  };
  if (salt.len() != 16) {
    return Err("invalid scrypt recipient block");
  }
  return Ok((salt, work_factor(st.args[1])?));
}

pub function unwrap_scrypt(st: Stanza, passphrase: [u8]): Unwrapped {
  if (st.kind != "scrypt") {
    return Incorrect;
  }
  let (salt, log_n) = match (scrypt_args(st)) {
    Ok(a) => a,
    Err(why) => { return Invalid(why); },
  };
  let key = match (scrypt_key(passphrase, salt, log_n)) {
    Ok(k) => k,
    Err(why) => {
      return Invalid(why);
    },
  };
  if (st.body.len() != 32) {
    return Invalid("invalid scrypt recipient block: incorrect file key size");
  }
  return match (key.open(ZERO_IV, st.body, [])) {
    Ok(file_key) => FileKey(file_key),
    Err(_) => Incorrect,
  };
}
