// SSH keys for age: the SSH wire format, authorized_keys lines, OpenSSH
// private key files, and the ssh-ed25519 and ssh-rsa stanzas of age's
// agessh package. The messages are those of age 1.3.2 and of
// golang.org/x/crypto/ssh.
import "std/array";
import "std/bigint";
import "std/crypto";
import "std/crypto/aes";
import "std/crypto/chacha20poly1305";
import "std/crypto/des";
import "std/crypto/ed25519";
import "std/crypto/rsa";
import "std/crypto/sha2";
import "std/crypto/x25519";
import "std/hex";
import "std/option";
import "./bcrypt";
import "./format";
import "./goasn1";
import "./text";

const ED25519_LABEL: string = "age-encryption.org/v1/ssh-ed25519";

const RSA_LABEL: string = "age-encryption.org/v1/ssh-rsa";

const NO_KEY: string = "ssh: no key found";

// An SSH public key. wire is its SSH wire encoding, as Go's
// ssh.PublicKey.Marshal gives it.
pub enum Public {
  Ed25519Public(u8[], u8[]),
  RsaPublic(u8[], rsa.PublicKey),
  // A key of another type, which age does not use: its type name.
  OtherPublic(string),
}

pub function (k: Public) kind(): string {
  return match (k) {
    Ed25519Public(_, _) => "ssh-ed25519",
    RsaPublic(_, _) => "ssh-rsa",
    OtherPublic(t) => t,
  };
}

// An SSH private key that age uses: the public key and the secret parts.
pub enum Private {
  // The public key, and the 32-byte seed.
  Ed25519Private(Public, u8[]),
  RsaPrivate(Public, rsa.PrivateKey),
}

// A reader of the SSH wire format: big-endian uint32 values and strings
// with a uint32 length.
struct Wire { b: u8[], at: i32 }

function wire_of(b: [u8]): Wire {
  return Wire { b: text.copy(b), at: 0 };
}

function read_u32(w: Wire): Option[(Wire, i64)] {
  if (w.b.len() - w.at < 4) {
    return None;
  }
  let v = w.b[w.at] as i64 << 24 | w.b[w.at + 1] as i64 << 16 | w.b[w.at + 2] as i64 << 8 | w.b[w.at + 3] as i64;
  return Some((Wire { ...w, at: w.at + 4 }, v));
}

function read_string(w: Wire): Option[(Wire, u8[])] {
  let (v, n) = read_u32(w)?;
  if (n > (v.b.len() - v.at) as i64) {
    return None;
  }
  let end = v.at + n as i32;
  return Some((Wire { ...v, at: end }, array.slice(v.b, v.at, end)));
}

function rest_of(w: Wire): u8[] {
  return array.slice(w.b, w.at, w.b.len());
}

function put_string(own out: u8[], s: [u8]): u8[] {
  let n = s.len();
  out = out.append((n >> 24 & 255) as u8).append((n >> 16 & 255) as u8).append((n >> 8 & 255) as u8).append((n & 255) as u8);
  return out.concat(s);
}

// The minimal SSH mpint of a positive big-endian integer.
function mpint(b: [u8]): u8[] {
  let at = 0;
  while (at < b.len() && b[at] == 0) {
    at += 1;
  }
  let v = text.copy(b[at:b.len()]);
  if (v.len() > 0 && v[0] >= 128) {
    return put_string([], [0u8].concat(v));
  }
  return put_string([], v);
}

// The value of an SSH mpint that is not negative, with no leading zeros.
function positive(m: [u8]): Option[u8[]] {
  if (m.len() > 0 && m[0] >= 128) {
    return None;
  }
  let at = 0;
  while (at < m.len() && m[at] == 0) {
    at += 1;
  }
  return Some(text.copy(m[at:m.len()]));
}

pub function ed25519_wire(key: [u8]): u8[] {
  return put_string(put_string([], "ssh-ed25519".as_bytes()), key);
}

function rsa_wire(n: [u8], e: [u8]): u8[] {
  return put_string([], "ssh-rsa".as_bytes()).concat(mpint(e)).concat(mpint(n));
}

// The value of a big-endian integer of at most 3 bytes.
function small(b: [u8]): i64 {
  let v = 0i64;
  for c in b {
    v = v << 8 | c as i64;
  }
  return v;
}

// The magnitude of an SSH mpint, big-endian with no leading zeros, and
// whether the mpint is negative. Go's parseInt reads a two's complement.
function magnitude(m: [u8]): (u8[], boolean) {
  if (m.len() == 0 || m[0] < 128) {
    let at = 0;
    while (at < m.len() && m[at] == 0) {
      at += 1;
    }
    return (text.copy(m[at:m.len()]), false);
  }
  let out = __alloc_u8(m.len());
  let carry = 1;
  let i = m.len() - 1;
  while (i >= 0) {
    let v = (m[i] ^ 255u8) as i32 + carry;
    out = out.with(i, (v & 255) as u8);
    carry = v >> 8;
    i -= 1;
  }
  let (mag, _) = magnitude(out);
  return (mag, true);
}

// Go's big.Int.BitLen of an SSH mpint.
function bit_len(m: [u8]): i32 {
  let (mag, _) = magnitude(m);
  if (mag.len() == 0) {
    return 0;
  }
  let bits = 8 * (mag.len() - 1);
  let top = mag[0] as i32;
  while (top > 0) {
    bits += 1;
    top >>= 1;
  }
  return bits;
}

// -1, 0 or 1 as the mpint a is less than, equal to or more than b.
function cmp_mpint(a: [u8], b: [u8]): i32 {
  let (ma, na) = magnitude(a);
  let (mb, nb) = magnitude(b);
  let sa = if (ma.len() == 0) { 0 } else if (na) { -1 } else { 1 };
  let sb = if (mb.len() == 0) { 0 } else if (nb) { -1 } else { 1 };
  if (sa != sb) {
    return if (sa < sb) { -1 } else { 1 };
  }
  let c = if (ma.len() != mb.len()) {
    if (ma.len() < mb.len()) { -1 } else { 1 }
  } else {
    cmp_bytes(ma, mb)
  };
  return c * (if (sa < 0) { -1 } else { 1 });
}

function cmp_bytes(a: [u8], b: [u8]): i32 {
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return if (a[i] < b[i]) { -1 } else { 1 };
    }
  }
  return 0;
}

// The sign of an mpint: -1, 0 or 1.
function sign(m: [u8]): i32 {
  return cmp_mpint(m, []);
}

// Go's ssh.Unmarshal of a struct of n strings or mpints and the rest: the
// fields and the bytes after them.
function fields(w: Wire, n: i32): Result[(u8[][], u8[]), string] {
  if (w.at == w.b.len()) {
    return Err("ssh: parse error in message type 0");
  }
  let out: u8[][] = [];
  let at = w;
  for _ in 0..n {
    let Some((v, s)) = read_string(at) else {
      return Err("ssh: short read");
    };
    out = out.append(s);
    at = v;
  }
  return Ok((out, rest_of(at)));
}

const TRAILING_JUNK: string = "ssh: trailing junk in public key";

// ssh's checks of the modulus and the exponent of an RSA key. The result is
// the exponent with no leading zeros.
function rsa_sizes(e_raw: [u8], n_raw: [u8]): Result[u8[], string] {
  if (bit_len(n_raw) > 16384) {
    return Err("ssh: rsa modulus too large");
  }
  if (bit_len(e_raw) > 24) {
    return Err("ssh: exponent too large");
  }
  let (e, negative) = magnitude(e_raw);
  let v = small(e);
  if (negative || v < 3 || v % 2 == 0) {
    return Err("ssh: incorrect exponent");
  }
  return Ok(e);
}

// ssh's parseRSA: e, n and the checks of each.
function parse_rsa(w: Wire): Result[Public, string] {
  let (f, rest) = fields(w, 2)?;
  let n_raw = f[1];
  let e = rsa_sizes(f[0], n_raw)?;
  if (rest.len() != 0) {
    return Err(TRAILING_JUNK);
  }
  let Some(n) = positive(n_raw) else {
    return Err("ssh: the modulus is negative");
  };
  return match (rsa.public_key(n, e)) {
    Ok(k) => Ok(RsaPublic(rsa_wire(n, e), k)),
    Err(why) => Err(why.message()),
  };
}

// ssh's parseED25519.
function parse_ed25519(w: Wire): Result[Public, string] {
  let (f, rest) = fields(w, 1)?;
  let key = f[0];
  if (key.len() != 32) {
    return Err(f"invalid size {key.len()} for Ed25519 public key");
  }
  if (rest.len() != 0) {
    return Err(TRAILING_JUNK);
  }
  return Ok(Ed25519Public(ed25519_wire(key), key));
}

// ssh's parseDSA: p, q, g and y, with the checks of checkDSAParams.
function parse_dss(w: Wire): Result[Public, string] {
  let (f, rest) = fields(w, 4)?;
  dss_checks(f)?;
  if (rest.len() != 0) {
    return Err(TRAILING_JUNK);
  }
  return Ok(OtherPublic("ssh-dss"));
}

function dss_checks(f: u8[][]): Result[void, string] {
  let p = f[0];
  let g = f[2];
  let y = f[3];
  if (bit_len(p) != 1024) {
    return Err(f"ssh: unsupported DSA key size {bit_len(p)}");
  }
  if (bit_len(f[1]) != 160) {
    return Err(f"ssh: unsupported DSA sub-prime size {bit_len(f[1])}");
  }
  if (cmp_mpint(g, p) >= 0) {
    return Err("ssh: DSA generator larger than modulus");
  }
  if (sign(g) <= 0) {
    return Err("ssh: DSA generator must be positive");
  }
  if (sign(y) <= 0 || cmp_mpint(y, p) >= 0) {
    return Err("ssh: DSA public value Y out of range");
  }
  return Ok(());
}

// A field of a struct that ssh.Unmarshal fills: a string, a []byte, a
// *big.Int, a uint64 or a uint32, and the name of the field.
struct WireField { kind: i32, name: string }

const W_STRING: i32 = 0;

const W_BYTES: i32 = 1;

const W_MPINT: i32 = 2;

const W_U64: i32 = 3;

const W_U32: i32 = 4;

// Go's ssh.Unmarshal of the struct `name` with the fields `spec`: the value
// of each field, and the bytes after them. A struct with no `ssh:"rest"`
// field must use all of the bytes.
function unmarshal_wire(w: Wire, name: string, spec: WireField[], has_rest: boolean): Result[(u8[][], u8[]), string] {
  if (w.at == w.b.len()) {
    return Err("ssh: parse error in message type 0");
  }
  let out: u8[][] = [];
  let at = w;
  for f in spec {
    if (f.kind == W_U64 || f.kind == W_U32) {
      let size = if (f.kind == W_U64) { 8 } else { 4 };
      if (at.b.len() - at.at < size) {
        return Err("ssh: short read");
      }
      out = out.append(array.slice(at.b, at.at, at.at + size));
      at = Wire { ...at, at: at.at + size };
      continue;
    }
    let Some((v, s)) = read_string(at) else {
      if (f.kind == W_STRING) {
        return Err(f"ssh: unmarshal error for field {f.name} of type {name}");
      }
      return Err("ssh: short read");
    };
    out = out.append(s);
    at = v;
  }
  let rest = rest_of(at);
  if (!has_rest && rest.len() > 0) {
    return Err("ssh: parse error in message type 0");
  }
  return Ok((out, rest));
}

// The prime, the coefficient b and the size of a NIST curve, by its name.
struct Curve { p: bigint.BigInt, b: bigint.BigInt, size: i32 }

function nist_curve(name: string): Option[Curve] {
  let hex_p = "";
  let hex_b = "";
  if (name == "nistp256") {
    hex_p = "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff";
    hex_b = "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b";
  } else if (name == "nistp384") {
    hex_p = "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff";
    hex_b = "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef";
  } else if (name == "nistp521") {
    hex_p = "01ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
    hex_b = "0051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00";
  } else {
    return None;
  }
  let p = bigint_of(hex.decode(hex_p).unwrap_or([]));
  let b = bigint_of(hex.decode(hex_b).unwrap_or([]));
  return Some(Curve { p: p, b: b, size: (p.bit_length() + 7) / 8 });
}

// elliptic.Unmarshal of a NIST curve: an uncompressed point with each
// coordinate below p, on the curve y² = x³ - 3x + b.
function on_curve(c: Curve, point: [u8]): boolean {
  if (point.len() != 1 + 2 * c.size || point[0] != 4u8) {
    return false;
  }
  let x = bigint_of(point[1:1 + c.size]);
  let y = bigint_of(point[1 + c.size:point.len()]);
  if (x.cmp(c.p) >= 0 || y.cmp(c.p) >= 0) {
    return false;
  }
  let lhs = y.mul(y).divmod(c.p).1;
  let rhs = x.mul(x).mul(x).add(c.b).add(c.p.mul(bigint.from_i64(3))).sub(x.mul(bigint.from_i64(3))).divmod(c.p).1;
  return lhs.cmp(rhs) == 0;
}

// ssh's parseECDSA: the bytes after the key.
function ecdsa_body(w: Wire, algo: string): Result[u8[], string] {
  let (f, rest) = unmarshal_wire(w, "", [WireField { kind: W_STRING, name: "Curve" }, WireField { kind: W_BYTES, name: "KeyBytes" }], true)?;
  let actual = text.copy("ecdsa-sha2-".as_bytes()).concat(f[0]);
  if (!text.equals(actual, algo)) {
    return Err(f"ssh: algorithm type mismatch: expected {text.quote(algo.as_bytes())}, found curve {text.quote(f[0])} (type {text.quote(actual)})");
  }
  let Some(c) = nist_curve(text.ascii(f[0])) else {
    return Err("ssh: unsupported curve");
  };
  if (!on_curve(c, f[1])) {
    return Err("ssh: invalid curve point");
  }
  return Ok(rest);
}

// ssh's parseSKECDSA.
function sk_ecdsa_body(w: Wire): Result[u8[], string] {
  let (f, rest) = unmarshal_wire(w, "", [WireField { kind: W_STRING, name: "Curve" }, WireField { kind: W_BYTES, name: "KeyBytes" }, WireField { kind: W_STRING, name: "Application" }], true)?;
  if (!text.equals(f[0], "nistp256")) {
    return Err("ssh: unsupported curve");
  }
  let Some(c) = nist_curve("nistp256") else {
    return Err("ssh: unsupported curve");
  };
  if (!on_curve(c, f[1])) {
    return Err("ssh: invalid curve point");
  }
  return Ok(rest);
}

// ssh's parseSKEd25519.
function sk_ed25519_body(w: Wire): Result[u8[], string] {
  let (f, rest) = unmarshal_wire(w, "", [WireField { kind: W_BYTES, name: "KeyBytes" }, WireField { kind: W_STRING, name: "Application" }], true)?;
  if (f[0].len() != 32) {
    return Err(f"invalid size {f[0].len()} for Ed25519 public key");
  }
  return Ok(rest);
}

// ssh's certKeyAlgoNames: the key type of each type of certificate.
function cert_key(t: string): Option[string] {
  return match (t) {
    "ssh-rsa-cert-v01@openssh.com" => Some("ssh-rsa"),
    "ssh-dss-cert-v01@openssh.com" => Some("ssh-dss"),
    "ecdsa-sha2-nistp256-cert-v01@openssh.com" => Some("ecdsa-sha2-nistp256"),
    "ecdsa-sha2-nistp384-cert-v01@openssh.com" => Some("ecdsa-sha2-nistp384"),
    "ecdsa-sha2-nistp521-cert-v01@openssh.com" => Some("ecdsa-sha2-nistp521"),
    "sk-ecdsa-sha2-nistp256-cert-v01@openssh.com" => Some("sk-ecdsa-sha2-nistp256@openssh.com"),
    "ssh-ed25519-cert-v01@openssh.com" => Some("ssh-ed25519"),
    "sk-ssh-ed25519-cert-v01@openssh.com" => Some("sk-ssh-ed25519@openssh.com"),
    _ => None,
  };
}

// The fields of genericCertData, after the key of the certificate.
function cert_fields(): WireField[] {
  return [
    WireField { kind: W_U64, name: "Serial" }, WireField { kind: W_U32, name: "CertType" }, WireField { kind: W_STRING, name: "KeyId" },
    WireField { kind: W_BYTES, name: "ValidPrincipals" }, WireField { kind: W_U64, name: "ValidAfter" }, WireField { kind: W_U64, name: "ValidBefore" },
    WireField { kind: W_BYTES, name: "CriticalOptions" }, WireField { kind: W_BYTES, name: "Extensions" }, WireField { kind: W_BYTES, name: "Reserved" },
    WireField { kind: W_BYTES, name: "SignatureKey" }, WireField { kind: W_BYTES, name: "Signature" },
  ];
}

// ssh's parseCert, for a certificate of a key of the type `algo`.
function cert_body(w: Wire, algo: string): Result[u8[], string] {
  let Some((after_nonce, _)) = read_string(w) else {
    return Err("ssh: short read");
  };
  let rest = key_body(wire_of(rest_of(after_nonce)), algo)?;
  let (g, _) = unmarshal_wire(wire_of(rest), "genericCertData", cert_fields(), false)?;
  let principals = wire_of(g[3]);
  while (principals.at < principals.b.len()) {
    let Some((next, _)) = read_string(principals) else {
      return Err("ssh: short read");
    };
    principals = next;
  }
  tuples(g[6])?;
  tuples(g[7])?;
  let Some((_, sig_algo)) = read_string(wire_of(g[9])) else {
    return Err("ssh: short read");
  };
  if (cert_key(text.ascii(sig_algo)).is_some()) {
    return Err(f"ssh: the signature key type {text.quote(sig_algo)} is invalid for certificates");
  }
  validate_public(g[9])?;
  if (!signature_body(g[10])) {
    return Err("ssh: signature parse error");
  }
  return Ok([]);
}

// ssh's parseTuples: names in lexical order, each with a value that is
// empty or holds one string.
function tuples(b: [u8]): Result[void, string] {
  let w = wire_of(b);
  let last: Option[u8[]] = None;
  while (w.at < w.b.len()) {
    let Some((v, key)) = read_string(w) else {
      return Err("ssh: short read");
    };
    if let Some(prev) = last {
      if (cmp_bytes(key, prev) <= 0) {
        return Err("ssh: certificate options are not in lexical order");
      }
    }
    last = Some(key);
    let Some((v2, value)) = read_string(v) else {
      return Err("ssh: short read");
    };
    if (value.len() > 0) {
      let Some((inner, _)) = read_string(wire_of(value)) else {
        return Err("ssh: short read");
      };
      if (inner.at < inner.b.len()) {
        return Err("ssh: unexpected trailing data after certificate option value");
      }
    }
    w = v2;
  }
  return Ok(());
}

// ssh's parseSignatureBody with no bytes after it: a format and a blob. A
// signature of a security key keeps the bytes after its blob.
function signature_body(b: [u8]): boolean {
  let Some((v, format)) = read_string(wire_of(b)) else {
    return false;
  };
  let Some((v2, _)) = read_string(v) else {
    return false;
  };
  let t = text.ascii(format);
  if (t == "sk-ecdsa-sha2-nistp256@openssh.com" || t == "sk-ecdsa-sha2-nistp256-cert-v01@openssh.com" || t == "sk-ssh-ed25519@openssh.com" || t == "sk-ssh-ed25519-cert-v01@openssh.com") {
    return true;
  }
  return v2.at == v2.b.len();
}

// ssh's parsePubKey for each key type of x/crypto/ssh: the bytes after the
// key.
function key_body(w: Wire, algo: string): Result[u8[], string] {
  if (algo == "ssh-rsa") {
    let (f, rest) = fields(w, 2)?;
    rsa_sizes(f[0], f[1])?;
    return Ok(rest);
  }
  if (algo == "ssh-dss") {
    let (f, rest) = fields(w, 4)?;
    dss_checks(f)?;
    return Ok(rest);
  }
  if (algo == "ssh-ed25519") {
    let (f, rest) = fields(w, 1)?;
    if (f[0].len() != 32) {
      return Err(f"invalid size {f[0].len()} for Ed25519 public key");
    }
    return Ok(rest);
  }
  if (algo == "ecdsa-sha2-nistp256" || algo == "ecdsa-sha2-nistp384" || algo == "ecdsa-sha2-nistp521") {
    return ecdsa_body(w, algo);
  }
  if (algo == "sk-ecdsa-sha2-nistp256@openssh.com") {
    return sk_ecdsa_body(w);
  }
  if (algo == "sk-ssh-ed25519@openssh.com") {
    return sk_ed25519_body(w);
  }
  if let Some(k) = cert_key(algo) {
    return cert_body(w, k);
  }
  if let Some(format) = key_format(algo) {
    return Err(f"ssh: signature algorithm {text.quote(algo.as_bytes())} isn't a key format; key is malformed and should be re-encoded with type {text.quote(format.as_bytes())}");
  }
  return Err(f"ssh: unknown key algorithm: {algo}");
}

// ssh.ParsePublicKey with no key object: the checks of each key type, and
// no bytes after the key.
function validate_public(b: [u8]): Result[void, string] {
  let Some((w, kind)) = read_string(wire_of(b)) else {
    return Err("ssh: short read");
  };
  let rest = key_body(w, text.ascii(kind))?;
  if (rest.len() != 0) {
    return Err(TRAILING_JUNK);
  }
  return Ok(());
}

// ssh's keyFormatForAlgorithm for a signature algorithm that is not a key
// type.
function key_format(t: string): Option[string] {
  return match (t) {
    "rsa-sha2-256" | "rsa-sha2-512" => Some("ssh-rsa"),
    "rsa-sha2-256-cert-v01@openssh.com" | "rsa-sha2-512-cert-v01@openssh.com" => Some("ssh-rsa-cert-v01@openssh.com"),
    _ => None,
  };
}

// Go's ssh.ParsePublicKey for the key types that age uses.
pub function parse_public(b: [u8]): Result[Public, string] {
  let Some((w, kind)) = read_string(wire_of(b)) else {
    return Err("ssh: short read");
  };
  let t = text.ascii(kind);
  if (t == "ssh-rsa") {
    return parse_rsa(w);
  }
  if (t == "ssh-ed25519") {
    return parse_ed25519(w);
  }
  if (t == "ssh-dss") {
    return parse_dss(w);
  }
  let rest = key_body(w, t)?;
  if (cert_key(t).is_none() && rest.len() != 0) {
    return Err(TRAILING_JUNK);
  }
  return Ok(OtherPublic(t));
}

function blank(c: u8): boolean {
  return c == b' ' || c == b'\t';
}

function space_at(b: [u8]): i32 {
  for i in 0..b.len() {
    if (blank(b[i])) {
      return i;
    }
  }
  return -1;
}

// Go's bytes.TrimSpace for ASCII.
function trim(b: [u8]): u8[] {
  let from = 0;
  let to = b.len();
  while (from < to && text.blank(b[from:from + 1])) {
    from += 1;
  }
  while (to > from && text.blank(b[to - 1:to])) {
    to -= 1;
  }
  return text.copy(b[from:to]);
}

// ssh's parseAuthorizedKey: the base64 key, then an optional comment.
function key_field(b: [u8]): Result[Public, string] {
  let s = trim(b);
  let i = space_at(s);
  let end = if (i < 0) { s.len() } else { i };
  let blob = match (text.b64_lax(s[0:end])) {
    Ok(blob) => blob,
    Err(at) => {
      return Err(f"illegal base64 data at input byte {at}");
    },
  };
  return parse_public(blob);
}

// The key of the fields after the type field, which must name the type of
// the key.
function typed_key(kind: [u8], rest: [u8]): Result[Public, string] {
  let k = key_field(rest)?;
  if (!text.equals(kind, k.kind())) {
    return Err(f"ssh: authorized keys key type mismatch: human-readable type {text.quote(kind)}, encoded type {text.quote(k.kind().as_bytes())}");
  }
  return Ok(k);
}

// The index after the options field of an authorized_keys line, or -1.
function after_options(s: [u8]): i32 {
  let quoted = false;
  let i = 0;
  while (i < s.len()) {
    let b = s[i];
    if (!quoted && blank(b)) {
      break;
    }
    if (b == b'"' && (i == 0 || s[i - 1] != b'\\')) {
      quoted = !quoted;
    }
    i += 1;
  }
  while (i < s.len() && blank(s[i])) {
    i += 1;
  }
  if (i == s.len()) {
    return -1;
  }
  return i;
}

// One line of ssh.ParseAuthorizedKey: a key type, the key and a comment,
// maybe after an options field. The result is the key, or the last parse
// error after the line.
function authorized_line(line: [u8], last: Option[string]): Result[Public, Option[string]] {
  let s = trim(line);
  if (s.len() == 0 || s[0] == b'#') {
    return Err(last);
  }
  let i = space_at(s);
  if (i < 0) {
    return Err(last);
  }
  let first = match (typed_key(s[0:i], s[i:s.len()])) {
    Ok(k) => {
      return Ok(k);
    },
    Err(why) => why,
  };
  let at = after_options(s);
  if (at < 0) {
    return Err(Some(first));
  }
  let t = array.slice(s, at, s.len());
  let j = space_at(t);
  if (j < 0) {
    return Err(Some(first));
  }
  return match (typed_key(t[0:j], t[j:t.len()])) {
    Ok(k) => Ok(k),
    Err(why) => Err(Some(why)),
  };
}

// Go's ssh.ParseAuthorizedKey: the first key in the text.
pub function parse_authorized(b: [u8]): Result[Public, string] {
  let last: Option[string] = None;
  let start = 0;
  while (start < b.len()) {
    let end = start;
    while (end < b.len() && b[end] != b'\n') {
      end += 1;
    }
    let line = b[start:end];
    let cut = 0;
    while (cut < line.len() && line[cut] != b'\r') {
      cut += 1;
    }
    match (authorized_line(line[0:cut], last)) {
      Ok(k) => {
        return Ok(k);
      },
      Err(e) => {
        last = e;
      }
    }
    start = end + 1;
  }
  return match (last) {
    Some(why) => Err(NO_KEY + "; last parsing error for ignored line: " + why),
    None => Err(NO_KEY),
  };
}

// age's unsupportedSSHKey: the type of an SSH key line that age skips in a
// recipients file. That is a key of a type that age does not use, or an RSA
// key of less than 2048 bits.
pub function unsupported_key(line: [u8]): Option[string] {
  let s = text.ascii(line);
  let fields = s.split(" ");
  if (fields.len() < 2) {
    return None;
  }
  let blob = text.b64_lax(fields[1].as_bytes()).ok()?;
  let (_, kind) = read_string(wire_of(blob))?;
  if (text.ascii(kind) != fields[0]) {
    return None;
  }
  if (fields[0] == "ssh-ed25519") {
    return None;
  }
  if (fields[0] != "ssh-rsa") {
    return Some(fields[0]);
  }
  return match (parse_authorized(line)) {
    Ok(RsaPublic(_, k)) => if (k.bits < 2048) { Some(fields[0]) } else { None },
    _ => None,
  };
}

// The Curve25519 public key of an Ed25519 key. As edwards25519's SetBytes
// does, the encoding can hold a y of p or more, and the sign bit of a zero x.
// The key becomes canonical first.
function montgomery_of(key: [u8]): Result[u8[], string] {
  return match (ed25519.public_key(canonical_ed25519(key))) {
    Ok(k) => Ok(k.montgomery()),
    Err(_) => Err("invalid Ed25519 public key: edwards25519: invalid point encoding"),
  };
}

// The canonical encoding of the point of an Ed25519 public key: y below
// p = 2^255 - 19, and no sign bit when x is zero, which is when y is 1 or -1.
function canonical_ed25519(key: [u8]): u8[] {
  let b = text.copy(key);
  if (b.len() != 32) {
    return b;
  }
  let sign = b[31] & 128u8;
  b = b.with(31, b[31] & 127u8);
  let high = true;
  for i in 1..31 {
    high = high && b[i] == 255u8;
  }
  if (high && b[31] == 127u8 && b[0] >= 0xedu8) {
    b = b.with(0, b[0] - 0xedu8);
    for i in 1..32 {
      b = b.with(i, 0u8);
    }
  }
  let rest_zero = true;
  for i in 1..32 {
    rest_zero = rest_zero && b[i] == 0u8;
  }
  let minus_one = high && b[31] == 127u8 && b[0] == 0xecu8;
  if (sign != 0u8 && !(rest_zero && b[0] == 1u8 || minus_one)) {
    b = b.with(31, b[31] | 128u8);
  }
  return b;
}

// The wire form, and for Ed25519 the Curve25519 public key, of a key that
// age can encrypt to. age's NewEd25519Recipient and NewRSARecipient.
pub enum Recipient {
  Ed25519To(u8[], u8[]),
  RsaTo(u8[], rsa.PublicKey),
}

pub function recipient_of(k: Public): Result[Recipient, string] {
  match (k) {
    Ed25519Public(wire, key) => {
      return Ok(Ed25519To(wire, montgomery_of(key)?));
    },
    RsaPublic(wire, key) => {
      if (key.bits < 2048) {
        return Err("RSA key size is too small");
      }
      return Ok(RsaTo(wire, key));
    },
    OtherPublic(t) => {
      return Err(f"unknown SSH recipient type: {text.quote(t.as_bytes())}");
    }
  }
  return Err("");
}

// age's agessh.ParseRecipient.
pub function parse_recipient(arg: string): Result[Recipient, string] {
  let k = match (parse_authorized(arg.as_bytes())) {
    Ok(k) => k,
    Err(why) => {
      return Err(f"malformed SSH recipient: {text.quote(arg.as_bytes())}: {why}");
    },
  };
  return match (k) {
    OtherPublic(t) => Err(f"unknown SSH recipient type: {text.quote(t.as_bytes())}"),
    _ => match (recipient_of(k)) {
      Ok(r) => Ok(r),
      Err(why) => Err(f"malformed SSH recipient: {text.quote(arg.as_bytes())}: {why}"),
    },
  };
}

// age's sshFingerprint: the first 4 bytes of SHA-256 of the wire form.
pub function fingerprint(wire: [u8]): string {
  return text.b64_raw(crypto.sha256(wire)[0:4]);
}

function key_of(own k: u8[]): Result[chacha20poly1305.Key, string] {
  let key = chacha20poly1305.key(k);
  crypto.erase(k);
  return match (key) {
    Ok(key) => Ok(key),
    Err(e) => Err(e.message()),
  };
}

// The wrapping key of an ssh-ed25519 stanza. shared is the X25519 shared
// secret, and the tweak of the SSH key multiplies it.
function ed25519_key(shared: [u8], share: [u8], public: [u8], wire: [u8]): Result[chacha20poly1305.Key, string] {
  let tweak = crypto.hkdf_sha256(wire, [], ED25519_LABEL.as_bytes(), 32);
  let tweaked = match (x25519.x25519(tweak, shared)) {
    Ok(t) => t,
    Err(_) => [],
  };
  let k = crypto.hkdf_sha256(text.copy(share).concat(public), tweaked, ED25519_LABEL.as_bytes(), 32);
  crypto.erase(tweaked);
  return key_of(k);
}

function seal(key: chacha20poly1305.Key, file_key: [u8]): Result[u8[], string] {
  return match (key.seal(format.ZERO_IV, file_key, [])) {
    Ok(b) => {
      __ct_public(b);
      Ok(b)
    },
    Err(e) => Err(e.message()),
  };
}

// The stanza that wraps the file key to an SSH recipient. random gives 32
// fresh bytes: the ephemeral scalar of ssh-ed25519, or the OAEP seed of
// ssh-rsa.
pub function wrap(file_key: [u8], r: Recipient, own random: u8[]): Result[format.Stanza, string] {
  return match (r) {
    Ed25519To(wire, public) => wrap_ed25519(file_key, wire, public, random),
    RsaTo(wire, public) => wrap_rsa(file_key, wire, public, random),
  };
}

// age's Ed25519Recipient.Wrap. ephemeral is a fresh secret scalar.
function wrap_ed25519(file_key: [u8], wire: [u8], public: [u8], own ephemeral: u8[]): Result[format.Stanza, string] {
  __ct_secret(ephemeral);
  let share = match (x25519.public_key(ephemeral)) {
    Ok(p) => p,
    Err(e) => {
      return Err(e.message());
    },
  };
  __ct_public(share);
  let shared = match (x25519.x25519(ephemeral, public)) {
    Ok(s) => s,
    Err(_) => {
      return Err(format.LOW_ORDER);
    },
  };
  crypto.erase(ephemeral);
  let key = ed25519_key(shared, share, public, wire)?;
  return Ok(format.Stanza { kind: "ssh-ed25519", args: [fingerprint(wire), text.b64_raw(share)], body: seal(key, file_key)? });
}

// age's RSARecipient.Wrap with the OAEP seed.
function wrap_rsa(file_key: [u8], wire: [u8], public: rsa.PublicKey, seed: [u8]): Result[format.Stanza, string] {
  let body = match (public.encrypt_oaep(sha2.Hash.Sha256, seed, file_key, RSA_LABEL.as_bytes())) {
    Ok(c) => c,
    Err(e) => {
      return Err(e.message());
    },
  };
  __ct_public(body);
  return Ok(format.Stanza { kind: "ssh-rsa", args: [fingerprint(wire)], body: body });
}

// An SSH identity: the wire form of its public key and its secret.
pub enum Identity {
  // The Curve25519 secret scalar and public key.
  Ed25519Id(u8[], u8[], u8[]),
  RsaId(u8[], rsa.PrivateKey),
}

// age's NewEd25519Identity and NewRSAIdentity.
pub function identity_of(k: Private): Result[Identity, string] {
  match (k) {
    Ed25519Private(public, seed) => {
      let wire = match (public) {
        Ed25519Public(w, _) => w,
        _ => [],
      };
      let scalar = array.slice(crypto.sha512(seed), 0, 32);
      __ct_secret(scalar);
      let ours = match (x25519.public_key(scalar)) {
        Ok(p) => p,
        Err(e) => {
          return Err(e.message());
        },
      };
      __ct_public(ours);
      return Ok(Ed25519Id(wire, scalar, ours));
    },
    RsaPrivate(public, key) => {
      let wire = match (public) {
        RsaPublic(w, _) => w,
        _ => [],
      };
      return Ok(RsaId(wire, key));
    }
  }
  return Err("");
}

// The recipient of an identity, for -e -i.
pub function recipient_of_identity(id: Identity): Recipient {
  return match (id) {
    Ed25519Id(wire, _, ours) => Ed25519To(wire, ours),
    RsaId(wire, key) => RsaTo(wire, key.public_key()),
  };
}

// The ephemeral share of an ssh-ed25519 stanza.
function ed25519_share(st: format.Stanza): Result[u8[], string] {
  if (st.args.len() != 2) {
    return Err("invalid ssh-ed25519 recipient block");
  }
  let share = match (text.decode_string(st.args[1].as_bytes())) {
    Ok(b) => b,
    Err(why) => {
      return Err("failed to parse ssh-ed25519 recipient: " + why);
    },
  };
  if (share.len() != 32) {
    return Err("invalid ssh-ed25519 recipient block");
  }
  return Ok(share);
}

// The wrapping key of an ssh-ed25519 stanza on the side of the identity.
function identity_key(scalar: [u8], share: [u8], ours: [u8], wire: [u8]): Result[chacha20poly1305.Key, string] {
  let shared = match (x25519.x25519(scalar, share)) {
    Ok(s) => s,
    Err(_) => {
      return Err("invalid X25519 recipient: " + format.LOW_ORDER);
    },
  };
  return ed25519_key(shared, share, ours, wire);
}

function unwrap_ed25519(st: format.Stanza, wire: [u8], scalar: [u8], ours: [u8]): format.Unwrapped {
  if (st.kind != "ssh-ed25519") {
    return format.Incorrect;
  }
  let share = match (ed25519_share(st)) {
    Ok(b) => b,
    Err(why) => {
      return format.Invalid(why);
    },
  };
  if (st.args[0] != fingerprint(wire)) {
    return format.Incorrect;
  }
  let key = match (identity_key(scalar, share, ours, wire)) {
    Ok(k) => k,
    Err(why) => {
      return format.Invalid(why);
    },
  };
  return match (key.open(format.ZERO_IV, st.body, [])) {
    Ok(file_key) => format.FileKey(file_key),
    Err(_) => format.Incorrect,
  };
}

function unwrap_rsa(st: format.Stanza, wire: [u8], key: rsa.PrivateKey): format.Unwrapped {
  if (st.kind != "ssh-rsa") {
    return format.Incorrect;
  }
  if (st.args.len() != 1) {
    return format.Invalid("invalid ssh-rsa recipient block");
  }
  if (st.args[0] != fingerprint(wire)) {
    return format.Incorrect;
  }
  return match (key.decrypt_oaep(sha2.Hash.Sha256, st.body, RSA_LABEL.as_bytes())) {
    Ok(file_key) => format.FileKey(file_key),
    Err(_) => format.Incorrect,
  };
}

// age's unwrap of one stanza with an SSH identity.
pub function unwrap(st: format.Stanza, id: Identity): format.Unwrapped {
  return match (id) {
    Ed25519Id(wire, scalar, ours) => unwrap_ed25519(st, wire, scalar, ours),
    RsaId(wire, key) => unwrap_rsa(st, wire, key),
  };
}

// The check of an encrypted SSH key on the stanzas: age asks for its
// passphrase only when a stanza has its type and its fingerprint.
pub function encrypted_match(stanzas: format.Stanza[], k: Public): Result[boolean, string] {
  let kind = k.kind();
  let wire = match (k) {
    Ed25519Public(w, _) => w,
    RsaPublic(w, _) => w,
    OtherPublic(_) => [],
  };
  for st in stanzas {
    if (st.kind != kind) {
      continue;
    }
    if (st.args.len() < 1) {
      return Err(f"invalid {kind} recipient block");
    }
    if (st.args[0] == fingerprint(wire)) {
      return Ok(true);
    }
  }
  return Ok(false);
}

// A PEM block: its type, whether its headers mark it encrypted, its
// DEK-Info header, and its bytes.
struct Pem { kind: string, encrypted: boolean, dek: Option[string], bytes: u8[] }

function index_from(b: [u8], s: string, from: i32): i32 {
  let n = s.len();
  let i = from;
  while (i + n <= b.len()) {
    if (text.has_prefix(b[i:b.len()], s)) {
      return i;
    }
    i += 1;
  }
  return -1;
}

// The end of the line at at, after its "\n", or the end of b.
function line_end(b: [u8], at: i32): i32 {
  let i = at;
  while (i < b.len() && b[i] != b'\n') {
    i += 1;
  }
  return i;
}

// The body of a PEM block, with its header lines. A line with a ":" is a
// header, before the first line that has none. The result holds whether the
// Proc-Type header says ENCRYPTED, the DEK-Info header, and the body.
function pem_body(b: [u8], from: i32, to: i32): (boolean, Option[string], u8[]) {
  let encrypted = false;
  let dek: Option[string] = None;
  let body: u8[] = [];
  let headers = true;
  let at = from;
  while (at < to) {
    let end = line_end(b, at);
    let stop = if (end < to) { end } else { to };
    let line = trim(b[at:stop]);
    let colon = index_from(line, ":", 0);
    if (headers && colon >= 0) {
      let key = text.ascii(trim(line[0:colon]));
      let value = text.ascii(trim(line[colon + 1:line.len()]));
      if (key == "Proc-Type") {
        encrypted = value.index_of("ENCRYPTED").is_some();
      }
      if (key == "DEK-Info") {
        dek = Some(value);
      }
    } else {
      headers = headers && line.len() == 0;
      body = body.concat(line);
    }
    at = end + 1;
  }
  return (encrypted, dek, body);
}

// The ciphers of x509's DecryptPEMBlock: the key size and the block size.
function pem_cipher(mode: string): Option[(i32, i32)] {
  return match (mode) {
    "DES-CBC" => Some((8, 8)),
    "DES-EDE3-CBC" => Some((24, 8)),
    "AES-128-CBC" => Some((16, 16)),
    "AES-192-CBC" => Some((24, 16)),
    "AES-256-CBC" => Some((32, 16)),
    _ => None,
  };
}

// Go's hex.DecodeString, with its messages.
function go_hex(s: string): Result[u8[], string] {
  let out: u8[] = [];
  let i = 0;
  while (i + 1 < s.len()) {
    let hi = hex_value(s[i]);
    let lo = hex_value(s[i + 1]);
    if (hi < 0) {
      return Err(f"encoding/hex: invalid byte: {text.go_rune(s[i] as i32)}");
    }
    if (lo < 0) {
      return Err(f"encoding/hex: invalid byte: {text.go_rune(s[i + 1] as i32)}");
    }
    out = out.append((hi * 16 + lo) as u8);
    i += 2;
  }
  if (s.len() % 2 == 1) {
    if (hex_value(s[s.len() - 1]) < 0) {
      return Err(f"encoding/hex: invalid byte: {text.go_rune(s[s.len() - 1] as i32)}");
    }
    return Err("encoding/hex: odd length hex string");
  }
  return Ok(out);
}

function hex_value(c: u8): i32 {
  if (c >= b'0' && c <= b'9') {
    return (c - b'0') as i32;
  }
  if (c >= b'a' && c <= b'f') {
    return (c - b'a') as i32 + 10;
  }
  if (c >= b'A' && c <= b'F') {
    return (c - b'A') as i32 + 10;
  }
  return -1;
}

// OpenSSL's EVP_BytesToKey with MD5 and one round, as x509's deriveKey
// stretches the passphrase.
function pem_key(passphrase: [u8], salt: [u8], size: i32): u8[] {
  let out: u8[] = [];
  let digest: u8[] = [];
  while (out.len() < size) {
    digest = crypto.md5(digest.concat(passphrase).concat(salt));
    out = out.concat(digest);
  }
  let key = __bytes_into(__alloc_u8(size), 0, out, 0, size);
  crypto.erase(out);
  return key;
}

// x509's DecryptPEMBlock. None is IncorrectPasswordError.
function pem_decrypt(block: Pem, dek: string, passphrase: [u8]): Result[Option[u8[]], string] {
  let Some(comma) = dek.index_of(",") else {
    return Err("x509: malformed DEK-Info header");
  };
  let mode = dek[0:comma].unwrap_or("").to_owned();
  let Some((key_size, block_size)) = pem_cipher(mode) else {
    return Err("x509: unknown encryption mode");
  };
  let iv = go_hex(dek[comma + 1:dek.len()].unwrap_or("").to_owned())?;
  if (iv.len() != block_size) {
    return Err("x509: incorrect IV size");
  }
  if (block.bytes.len() % block_size != 0) {
    return Err("x509: encrypted PEM data is not a multiple of the block size");
  }
  let key = pem_key(passphrase, iv[0:8], key_size);
  let decrypted = if (block_size == 8) {
    match (des.cbc_decrypt(key, iv, block.bytes)) {
      Ok(d) => d,
      Err(e) => {
        return Err(e.message());
      },
    }
  } else {
    match (aes.cbc_decrypt(key, iv, block.bytes)) {
      Ok(d) => d,
      Err(e) => {
        return Err(e.message());
      },
    }
  };
  let data = decrypted;
  crypto.erase(key);
  __ct_public(data);
  if (data.len() == 0) {
    return Err("x509: invalid padding");
  }
  let last = data[data.len() - 1] as i32;
  if (last == 0 || last > block_size || data.len() < last) {
    return Ok(None);
  }
  for i in data.len() - last..data.len() {
    if (data[i] as i32 != last) {
      return Ok(None);
    }
  }
  return Ok(Some(array.slice(data, 0, data.len() - last)));
}

const WRONG_PASSWORD: string = "x509: decryption password incorrect";

// ssh's ParseRawPrivateKeyWithPassphrase for a PEM key in the old format.
// The key becomes secret after its checks, as an unencrypted key does.
function decrypt_pem(block: Pem, passphrase: [u8]): Parsed {
  let dek = block.dek.unwrap_or("");
  if (!block.encrypted || block.dek.is_none()) {
    return Bad("ssh: not an encrypted key");
  }
  let der = match (pem_decrypt(block, dek, passphrase)) {
    Ok(Some(d)) => d,
    Ok(None()) => {
      return Bad(WRONG_PASSWORD);
    },
    Err(why) => {
      return Bad("ssh: cannot decode encrypted private keys: " + why);
    },
  };
  // A wrong passphrase can give valid padding. Then the key is noise, and
  // ssh gives the error of a wrong passphrase for an asn1 structure error.
  if (block.kind == "RSA PRIVATE KEY") {
    let (p, structure) = pkcs1_parse(der);
    if (structure) {
      return Bad(WRONG_PASSWORD);
    }
    return p;
  }
  if (block.kind == "EC PRIVATE KEY") {
    return ec_private(der);
  }
  if (block.kind == "DSA PRIVATE KEY") {
    return dsa_private(der);
  }
  return Bad(f"ssh: unsupported key type {text.quote(block.kind.as_bytes())}");
}

// Go's pem.Decode, for the first block.
function pem_decode(b: [u8]): Option[Pem] {
  let begin = if (text.has_prefix(b, "-----BEGIN ")) { 0 } else { index_from(b, "\n-----BEGIN ", 0) + 1 };
  if (begin <= 0 && !text.has_prefix(b, "-----BEGIN ")) {
    return None;
  }
  let type_end = index_from(b, "-----", begin + 11);
  if (type_end < 0) {
    return None;
  }
  let kind = text.ascii(b[begin + 11:type_end]);
  let body_start = line_end(b, type_end) + 1;
  let footer = "-----END " + kind + "-----";
  let end = index_from(b, footer, body_start);
  if (end < 0 || body_start > end) {
    return None;
  }
  let (encrypted, dek, body) = pem_body(b, body_start, end);
  let bytes = text.b64_lax(body).ok()?;
  return Some(Pem { kind: kind, encrypted: encrypted, dek: dek, bytes: bytes });
}

// A private key file that ParseRawPrivateKey reads: a key, a key that
// needs a passphrase (with its public key when the file has one), or
// the message of the failure.
pub enum Parsed {
  Key(Private),
  NeedsPassphrase(Option[Public]),
  Bad(string),
  // A key of a type that age does not use, by its Go type.
  Unsupported(string),
}

const OPENSSH_MAGIC: string = "openssh-key-v1\x00";

// ssh's checkOpenSSHKeyPadding: the bytes 1, 2, 3 and on.
function padding_ok(pad: [u8]): boolean {
  for i in 0..pad.len() {
    if (pad[i] as i32 != i + 1) {
      return false;
    }
  }
  return true;
}

function openssh_ed25519(rest: Wire): Parsed {
  let Some((w1, public)) = read_string(rest) else {
    return Bad("ssh: short read");
  };
  let Some((w2, private)) = read_string(w1) else {
    return Bad("ssh: short read");
  };
  let Some((w3, _)) = read_string(w2) else {
    return Bad("ssh: short read");
  };
  if (private.len() != 64) {
    return Bad("ssh: private key unexpected length");
  }
  if (!padding_ok(rest_of(w3))) {
    return Bad("ssh: padding not as expected");
  }
  let seed = array.slice(private, 0, 32);
  __ct_secret(seed);
  let key = array.slice(private, 32, 64);
  return Key(Ed25519Private(Ed25519Public(ed25519_wire(key), key), seed));
}

// The fields of an OpenSSH RSA private key: n, e, d, iqmp, p, q.
function rsa_fields(rest: Wire): Result[(u8[][], Wire), string] {
  let out: u8[][] = [];
  let w = rest;
  for _ in 0..6 {
    let Some((v, field)) = read_string(w) else {
      return Err("ssh: short read");
    };
    let Some(p) = positive(field) else {
      return Err("crypto/rsa: invalid key");
    };
    out = out.append(p);
    w = v;
  }
  return Ok((out, w));
}

function openssh_rsa(rest: Wire): Parsed {
  let (f, w) = match (rsa_fields(rest)) {
    Ok(x) => x,
    Err(why) => { return Bad(why); },
  };
  let Some((w1, _)) = read_string(w) else {
    return Bad("ssh: short read");
  };
  if (!padding_ok(rest_of(w1))) {
    return Bad("ssh: padding not as expected");
  }
  return match (rsa.private_key(f[0], f[1], f[2], f[4], f[5], f[3])) {
    Ok(key) => {
      mark_rsa(key);
      Key(RsaPrivate(RsaPublic(rsa_wire(f[0], f[1]), key.public_key()), key))
    },
    Err(e) => Bad(e.message()),
  };
}

// The fields of the openssh-key-v1 header: the cipher, the KDF, the KDF
// options, the public key and the private block.
struct OpenSsh { cipher: string, kdf: string, kdf_opts: u8[], public: u8[], block: u8[] }

function openssh_header(b: [u8]): Result[OpenSsh, string] {
  if (!text.has_prefix(b, OPENSSH_MAGIC)) {
    return Err("ssh: invalid openssh private key format");
  }
  let w = wire_of(b[OPENSSH_MAGIC.len():b.len()]);
  let Some((w1, cipher)) = read_string(w) else {
    return Err("ssh: short read");
  };
  let Some((w2, kdf)) = read_string(w1) else {
    return Err("ssh: short read");
  };
  let Some((w3, kdf_opts)) = read_string(w2) else {
    return Err("ssh: short read");
  };
  let Some((w4, count)) = read_u32(w3) else {
    return Err("ssh: short read");
  };
  let Some((w5, public)) = read_string(w4) else {
    return Err("ssh: short read");
  };
  let Some((_, block)) = read_string(w5) else {
    return Err("ssh: short read");
  };
  if (count != 1i64) {
    return Err("ssh: multi-key files are not supported");
  }
  return Ok(OpenSsh { cipher: text.ascii(cipher), kdf: text.ascii(kdf), kdf_opts: kdf_opts, public: public, block: block });
}

// The private block of a key with no passphrase, or the block that the
// passphrase decrypts.
// x/crypto's unencryptedOpenSSHKey: an encrypted key gives its public key.
function plain_block(h: OpenSsh): Result[u8[], Parsed] {
  if (h.cipher != "none" || h.kdf != "none") {
    return match (parse_public(h.public)) {
      Ok(k) => Err(NeedsPassphrase(Some(k))),
      Err(why) => Err(Bad("ssh: failed to parse embedded public key: " + why)),
    };
  }
  if (h.kdf_opts.len() != 0) {
    return Err(Bad("ssh: invalid openssh private key"));
  }
  return Ok(h.block);
}

function openssh_block(h: OpenSsh, passphrase: Option[u8[]]): Result[u8[], Parsed] {
  let Some(pass) = passphrase else {
    return plain_block(h);
  };
  if (h.cipher == "none" || h.kdf == "none") {
    return Err(NeedsPassphrase(None));
  }
  return match (bcrypt.decrypt_block(h.cipher, h.kdf, h.kdf_opts, h.block, pass)) {
    Ok(b) => Ok(b),
    Err(why) => Err(Bad(why)),
  };
}

// ssh's parseOpenSSHPrivateKey. With no passphrase, an encrypted key gives
// its public key.
// The private block after its two equal check words: the key type and the
// rest. The words differ when the passphrase is wrong.
function checked_block(block: [u8]): Option[(Wire, string)] {
  let (b1, check1) = read_u32(wire_of(block))?;
  let (b2, check2) = read_u32(b1)?;
  let (b3, kind) = read_string(b2)?;
  if (check1 != check2) {
    return None;
  }
  return Some((b3, text.ascii(kind)));
}

function openssh_with(b: [u8], passphrase: Option[u8[]]): Parsed {
  let h = match (openssh_header(b)) {
    Ok(h) => h,
    Err(why) => {
      return Bad(why);
    },
  };
  let block = match (openssh_block(h, passphrase)) {
    Ok(b) => b,
    Err(p) => {
      return p;
    },
  };
  let wrong = if (h.cipher != "none") { "x509: decryption password incorrect" } else { "ssh: malformed OpenSSH key" };
  let Some((b3, t)) = checked_block(block) else {
    return Bad(wrong);
  };
  if (t == "ssh-ed25519") {
    return openssh_ed25519(b3);
  }
  if (t == "ssh-rsa") {
    return openssh_rsa(b3);
  }
  return Bad("ssh: unhandled key type");
}

// The private key matches the public key.
pub function same_public(k: Private, p: Public): boolean {
  let (a, b) = match (k) {
    Ed25519Private(q, _) => (wire_of_public(q), wire_of_public(p)),
    RsaPrivate(q, _) => (wire_of_public(q), wire_of_public(p)),
  };
  return a == b;
}

function wire_of_public(k: Public): u8[] {
  return match (k) {
    Ed25519Public(w, _) => w,
    RsaPublic(w, _) => w,
    OtherPublic(_) => [],
  };
}

// ssh's ParseRawPrivateKeyWithPassphrase for a private key file.
pub function decrypt_private(b: [u8], passphrase: [u8]): Parsed {
  let Some(block) = pem_decode(b) else {
    return Bad(NO_KEY);
  };
  if (block.kind != "OPENSSH PRIVATE KEY") {
    return decrypt_pem(block, passphrase);
  }
  return openssh_with(block.bytes, Some(text.copy(passphrase)));
}

// ssh's ParseRawPrivateKey for the key types that age uses.
pub function parse_private(b: [u8]): Parsed {
  let Some(block) = pem_decode(b) else {
    return Bad(NO_KEY);
  };
  if (block.encrypted) {
    return NeedsPassphrase(None);
  }
  if (block.kind == "OPENSSH PRIVATE KEY") {
    return openssh_with(block.bytes, None);
  }
  if (block.kind == "RSA PRIVATE KEY") {
    return pkcs1(block.bytes);
  }
  if (block.kind == "PRIVATE KEY") {
    return pkcs8(block.bytes);
  }
  if (block.kind == "EC PRIVATE KEY") {
    return ec_private(block.bytes);
  }
  if (block.kind == "DSA PRIVATE KEY") {
    return dsa_private(block.bytes);
  }
  return Bad(f"ssh: unsupported key type {text.quote(block.kind.as_bytes())}");
}

// The Go structs of the private keys, as goasn1 types: x509's
// pkcs1PrivateKey, pkcs1AdditionalRSAPrime, ecPrivateKey, pkcs8 and
// pkix.AlgorithmIdentifier, and the struct of ssh's ParseDSAPrivateKey.
const PKCS1: i32 = 0;

const PRIME: i32 = 1;

const EC: i32 = 2;

const PKCS8: i32 = 3;

const ALGORITHM: i32 = 4;

const DSA: i32 = 5;

function key_types(): goasn1.Type[] {
  let whole = goasn1.field(goasn1.INT);
  let big = goasn1.field(goasn1.BIG);
  let bytes = goasn1.field(goasn1.BYTES);
  let crt = goasn1.optional(goasn1.BIG);
  let primes = goasn1.Field { ...goasn1.nested(goasn1.SLICE, PRIME), optional: true, omit_empty: true };
  let curve = goasn1.Field { ...goasn1.optional(goasn1.OID), explicit: true, tag: 0 };
  let public = goasn1.Field { ...goasn1.optional(goasn1.BITS), explicit: true, tag: 1 };
  return [
    goasn1.Type { name: "pkcs1PrivateKey", fields: [whole, big, whole, big, big, big, crt, crt, crt, primes] },
    goasn1.Type { name: "pkcs1AdditionalRSAPrime", fields: [big, big, big] },
    goasn1.Type { name: "ecPrivateKey", fields: [whole, bytes, curve, public] },
    goasn1.Type { name: "pkcs8", fields: [whole, goasn1.nested(goasn1.STRUCT, ALGORITHM), bytes] },
    goasn1.Type { name: "AlgorithmIdentifier", fields: [goasn1.field(goasn1.OID), goasn1.optional(goasn1.RAW)] },
    goasn1.Type { name: "", fields: [whole, big, big, big, big, big] },
  ];
}

// True when asn1.Unmarshal of `der` into the type `t` gives no error.
function parses_as(der: [u8], t: i32): boolean {
  return goasn1.unmarshal(der, key_types(), t).is_ok();
}

// True for an INTEGER above zero: big.Int's Sign() > 0.
function above_zero(v: goasn1.Value): boolean {
  if (v.content.len() == 0 || v.content[0] >= 128u8) {
    return false;
  }
  for c in v.content {
    if (c != 0u8) {
      return true;
    }
  }
  return false;
}

// The value of an INTEGER that is not negative, with no leading zeros. A
// field that is not there is empty.
function unsigned(v: goasn1.Value): u8[] {
  return positive(v.content).unwrap_or([]);
}

// The minimal big-endian form of an int64 above zero.
function int_bytes(v: i64): u8[] {
  let out: u8[] = [];
  let x = v;
  while (x > 0) {
    out = [(x & 255) as u8].concat(out);
    x >>= 8;
  }
  return out;
}

// The secret values of an RSA key become secret after the checks of the
// key, which are not constant-time, as in Go.
function mark_rsa(k: rsa.PrivateKey): void {
  for s in k.secrets() {
    __ct_secret(s);
  }
}

// Go's x509.ParsePKCS1PrivateKey, and true when its error is an
// asn1.StructuralError.
function pkcs1_parse(der: [u8]): (Parsed, boolean) {
  let v = match (goasn1.unmarshal(der, key_types(), PKCS1)) {
    Ok((values, end)) => {
      if (end < der.len()) {
        return (Bad("asn1: syntax error: trailing data"), false);
      }
      values
    },
    Err(e) => {
      if (parses_as(der, EC)) {
        return (Bad("x509: failed to parse private key (use ParseECPrivateKey instead for this key format)"), false);
      }
      if (parses_as(der, PKCS8)) {
        return (Bad("x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)"), false);
      }
      return (Bad(e.message()), e.structural);
    },
  };
  if (v[0].n > 1i64) {
    return (Bad("x509: unsupported private key version"), false);
  }
  let some = !above_zero(v[1]) || !above_zero(v[3]) || !above_zero(v[4]) || !above_zero(v[5]);
  for i in 6..9 {
    some = some || v[i].present && !above_zero(v[i]);
  }
  if (some) {
    return (Bad("x509: private key contains zero or negative value"), false);
  }
  for i in 0..v[9].n as i32 {
    if (!above_zero(v[10 + 3 * i])) {
      return (Bad("x509: private key contains zero or negative prime"), false);
    }
  }
  let n = unsigned(v[1]);
  let e = int_bytes(v[2].n);
  let crt: Option[(u8[], u8[], u8[])] = None;
  if (v[6].present && v[7].present && v[8].present) {
    crt = Some((unsigned(v[6]), unsigned(v[7]), unsigned(v[8])));
  }
  if (v[9].n == 0i64) {
    let why = go_rsa_check(n, v[2].n, unsigned(v[3]), unsigned(v[4]), unsigned(v[5]), crt);
    if (why.len() > 0) {
      return (Bad(why), false);
    }
  }
  return match (rsa.private_key(n, e, unsigned(v[3]), unsigned(v[4]), unsigned(v[5]), unsigned(v[8]))) {
    Ok(key) => {
      mark_rsa(key);
      (Key(RsaPrivate(RsaPublic(rsa_wire(n, e), key.public_key()), key)), false)
    },
    Err(why) => (Bad(why.message()), false),
  };
}

// The checks of Go's crypto/rsa for a key of two primes, in the order of
// NewPrivateKeyWithPrecomputation, or of NewPrivateKey for a key with no CRT
// values. Gives Go's error, or "" for a valid key.
function go_rsa_check(n0: [u8], e: i64, d0: [u8], p0: [u8], q0: [u8], crt: Option[(u8[], u8[], u8[])]): string {
  let one = bigint.from_i64(1);
  let n = bigint_of(n0);
  let p = bigint_of(p0);
  let q = bigint_of(q0);
  let d = bigint_of(d0);
  if (n.cmp(one) <= 0 || p.cmp(one) <= 0 || q.cmp(one) <= 0) {
    return "modulus must be > 1";
  }
  if (d.cmp(n) >= 0) {
    return "input overflows the modulus";
  }
  let p1 = p.sub(one);
  let q1 = q.sub(one);
  let Some((dp0, dq0, qinv0)) = crt else {
    if (p1.cmp(one) <= 0 || q1.cmp(one) <= 0) {
      return "modulus must be > 1";
    }
    if (!p.bit(0)) {
      return "crypto/rsa: p is even";
    }
    let qinv = mod_pow(q.divmod(p).1, p.sub(bigint.from_i64(2)), p);
    return go_rsa_key(n, e, d, p, q, d.divmod(p1).1, d.divmod(q1).1, qinv);
  };
  let qinv = bigint_of(qinv0);
  if (qinv.cmp(p) >= 0) {
    return "input overflows the modulus";
  }
  return go_rsa_key(n, e, d, p, q, bigint_of(dp0), bigint_of(dq0), qinv);
}

// Go's checkPrivateKey for a key of two primes.
function go_rsa_key(n: bigint.BigInt, e: i64, d: bigint.BigInt, p: bigint.BigInt, q: bigint.BigInt, dp: bigint.BigInt, dq: bigint.BigInt, qinv: bigint.BigInt): string {
  let one = bigint.from_i64(1);
  if (!n.bit(0)) {
    return "crypto/rsa: public modulus is even";
  }
  if (e < 2i64) {
    return "crypto/rsa: public exponent too small or negative";
  }
  if (e % 2i64 == 0i64) {
    return "crypto/rsa: public exponent is even";
  }
  if (e > 2147483647i64) {
    return "crypto/rsa: public exponent too large";
  }
  if (p.cmp(n) >= 0 || q.cmp(n) >= 0) {
    return "crypto/rsa: invalid prime";
  }
  if (!p.mul(q).divmod(n).1.is_zero()) {
    return "crypto/rsa: p * q != n";
  }
  let big_e = bigint.from_i64(e);
  for (prime, exponent) in [(p, dp), (q, dq)] {
    let m = prime.sub(one);
    if (m.cmp(one) <= 0) {
      return "crypto/rsa: invalid prime";
    }
    if (exponent.cmp(m) >= 0 || big_e.mul(exponent).divmod(m).1.cmp(one) != 0) {
      return "crypto/rsa: invalid CRT exponent";
    }
  }
  if (q.divmod(p).1.mul(qinv).divmod(p).1.cmp(one) != 0) {
    return "crypto/rsa: invalid CRT coefficient";
  }
  if (d.divmod(p.sub(one)).1.cmp(dp) != 0) {
    return "crypto/rsa: d does not match dP";
  }
  if (d.divmod(q.sub(one)).1.cmp(dq) != 0) {
    return "crypto/rsa: d does not match dQ";
  }
  if (p.cmp(q) == 0) {
    return "crypto/rsa: p == q";
  }
  let diff = if (p.cmp(q) > 0) { p.sub(q) } else { q.sub(p) };
  if (diff.bit_length() <= n.bit_length() / 2 - 100) {
    return "crypto/rsa: |p - q| too small";
  }
  if (d.bit_length() <= n.bit_length() / 2) {
    return "crypto/rsa: d too small";
  }
  return "";
}

// b to the power e modulo m.
function mod_pow(b: bigint.BigInt, e: bigint.BigInt, m: bigint.BigInt): bigint.BigInt {
  let r = bigint.from_i64(1);
  let i = e.bit_length() - 1;
  while (i >= 0) {
    r = r.mul(r).divmod(m).1;
    if (e.bit(i)) {
      r = r.mul(b).divmod(m).1;
    }
    i -= 1;
  }
  return r;
}

function pkcs1(der: [u8]): Parsed {
  return pkcs1_parse(der).0;
}

// The NIST curves of x509's namedCurveFromOID, by OID, with the hex of the
// order of each one.
const EC_CURVES: string[] = [
  "1.3.132.0.33", "ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3d",
  "1.2.840.10045.3.1.7", "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
  "1.3.132.0.34", "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973",
  "1.3.132.0.35", "01ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffbfa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409",
];

function curve_order(oid: string): string {
  let i = 0;
  while (i + 1 < EC_CURVES.len()) {
    if (EC_CURVES[i] == oid) {
      return EC_CURVES[i + 1];
    }
    i += 2;
  }
  return "";
}

// Go's x509.parseECPrivateKey: version 1, and a private key of the size of
// a named curve. `named` is the curve of a PKCS#8 key. A valid key is a type
// that age does not use. As ecdsa.ParseRawPrivateKey does, a multiple of
// the order gives the point at infinity, and a value above the order
// overflows.
function ec_private_with(der: [u8], named: Option[string]): Parsed {
  let v = match (goasn1.unmarshal(der, key_types(), EC)) {
    Ok((values, _)) => values,
    Err(e) => {
      if (parses_as(der, PKCS8)) {
        return Bad("x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)");
      }
      if (parses_as(der, PKCS1)) {
        return Bad("x509: failed to parse private key (use ParsePKCS1PrivateKey instead for this key format)");
      }
      return Bad("x509: failed to parse EC private key: " + e.message());
    },
  };
  if (v[0].n != 1i64) {
    return Bad(f"x509: unknown EC private key version {v[0].n}");
  }
  let order = curve_order(named.unwrap_or(v[2].oid));
  if (order.len() == 0) {
    return Bad("x509: unknown elliptic curve");
  }
  let n = match (hex.decode(order)) {
    Ok(b) => b,
    Err(_) => [],
  };
  let size = (bigint_of(n).bit_length() + 7) / 8;
  let key = v[1].content;
  let at = 0;
  while (key.len() - at > size) {
    if (key[at] != 0u8) {
      return Bad("x509: invalid private key length");
    }
    at += 1;
  }
  let d = bigint_of(key[at:key.len()]);
  let order_n = bigint_of(n);
  if (d.divmod(order_n).1.is_zero()) {
    return Bad("ecdsa: invalid public key encoding");
  }
  if (d.cmp(order_n) >= 0) {
    return Bad("input overflows the modulus");
  }
  return Unsupported("*ecdsa.PrivateKey");
}

function ec_private(der: [u8]): Parsed {
  return ec_private_with(der, None);
}

function bigint_of(b: [u8]): bigint.BigInt {
  let v = bigint.zero();
  for c in b {
    v = v.shl(8).add(bigint.from_i64(c as i64));
  }
  return v;
}

// x/crypto's ParseDSAPrivateKey: a SEQUENCE of six integers.
function dsa_private(der: [u8]): Parsed {
  match (goasn1.unmarshal(der, key_types(), DSA)) {
    Ok((_, end)) => {
      if (end < der.len()) {
        return Bad("ssh: garbage after DSA key");
      }
      return Unsupported("*dsa.PrivateKey");
    },
    Err(e) => {
      return Bad("ssh: failed to parse DSA key: " + e.message());
    }
  }
  return Unsupported("*dsa.PrivateKey");
}

// The OBJECT IDENTIFIERs of the key algorithms of x509's PKCS#8 parser.
const OID_RSA: string = "1.2.840.113549.1.1.1";

const OID_ECDSA: string = "1.2.840.10045.2.1";

const OID_ED25519: string = "1.3.101.112";

const OID_X25519: string = "1.3.101.110";

const OID_MLDSA: string[] = ["2.16.840.1.101.3.4.3.17", "2.16.840.1.101.3.4.3.18", "2.16.840.1.101.3.4.3.19"];

// Go's x509.ParsePKCS8PrivateKey.
function pkcs8(der: [u8]): Parsed {
  let v = match (goasn1.unmarshal(der, key_types(), PKCS8)) {
    Ok((values, _)) => values,
    Err(e) => {
      if (parses_as(der, EC)) {
        return Bad("x509: failed to parse private key (use ParseECPrivateKey instead for this key format)");
      }
      if (parses_as(der, PKCS1)) {
        return Bad("x509: failed to parse private key (use ParsePKCS1PrivateKey instead for this key format)");
      }
      return Bad(e.message());
    },
  };
  let oid = v[1].oid;
  let params = v[2].full;
  let key = v[3].content;
  if (oid == OID_RSA) {
    return embedded(pkcs1(key), "x509: failed to parse RSA private key embedded in PKCS#8: ");
  }
  if (oid == OID_ECDSA) {
    let named = match (goasn1.unmarshal_field(params, [], goasn1.field(goasn1.OID))) {
      Ok((values, _)) => Some(values[0].oid),
      Err(_) => None,
    };
    return embedded(ec_private_with(key, named), "x509: failed to parse EC private key embedded in PKCS#8: ");
  }
  if (oid == OID_ED25519) {
    return pkcs8_ed25519(key, params);
  }
  if (OID_MLDSA.contains(oid)) {
    return pkcs8_mldsa(key, params);
  }
  if (oid == OID_X25519) {
    if (params.len() != 0) {
      return Bad("x509: invalid X25519 private key parameters");
    }
    let seed = match (goasn1.unmarshal_field(key, [], goasn1.field(goasn1.BYTES))) {
      Ok((values, _)) => values[0].content,
      Err(e) => {
        return Bad("x509: invalid X25519 private key: " + e.message());
      },
    };
    if (seed.len() != 32) {
      return Bad("crypto/ecdh: invalid private key size");
    }
    return Unsupported("*ecdh.PrivateKey");
  }
  return Bad("x509: PKCS#8 wrapping contained private key with unknown algorithm: " + oid);
}

// The result of the parser of a key in a PKCS#8 key, with `prefix` before
// its error.
function embedded(p: Parsed, prefix: string): Parsed {
  if let Bad(why) = p {
    return Bad(prefix + why);
  }
  return p;
}

// The seed of a PKCS#8 Ed25519 key, in an OCTET STRING.
function pkcs8_ed25519(key: [u8], params: [u8]): Parsed {
  if (params.len() != 0) {
    return Bad("x509: invalid Ed25519 private key parameters");
  }
  let seed = match (goasn1.unmarshal_field(key, [], goasn1.field(goasn1.BYTES))) {
    Ok((values, _)) => values[0].content,
    Err(e) => {
      return Bad("x509: invalid Ed25519 private key: " + e.message());
    },
  };
  if (seed.len() != 32) {
    return Bad(f"x509: invalid Ed25519 private key length: {seed.len()}");
  }
  __ct_secret(seed);
  return match (ed25519.private_key(seed)) {
    Ok(k) => {
      let public = k.public_point();
      __ct_public(public);
      Key(Ed25519Private(Ed25519Public(ed25519_wire(public), public), seed))
    },
    Err(e) => Bad(e.message()),
  };
}

// The checks of x509 for a PKCS#8 ML-DSA key, which must hold only a seed.
function pkcs8_mldsa(key: [u8], params: [u8]): Parsed {
  if (params.len() != 0) {
    return Bad("x509: invalid ML-DSA private key parameters");
  }
  if (key.len() == 0) {
    return Bad("x509: invalid ML-DSA private key length: 0");
  }
  if (key[0] == 0x04u8) {
    return Bad("x509: semi-expanded ML-DSA private keys without seed are not supported");
  }
  if (key[0] == 0x30u8) {
    return Bad("x509: ML-DSA private keys with both seed and expanded key are not supported, use e.g. \"openssl pkey -provparam ml-dsa.output_formats=seed-only\" to convert to a seed-only key");
  }
  if (key[0] != 0x80u8) {
    return Bad("x509: invalid ML-DSA private key: invalid ASN.1 tag " + hex.encode(key[0:1]));
  }
  if (key.len() != 34) {
    return Bad(f"x509: invalid ML-DSA private key length: {key.len()}");
  }
  if (key[1] != 32u8) {
    return Bad("x509: invalid ML-DSA private key ASN.1 encoding");
  }
  return Unsupported("*mldsa.PrivateKey");
}
