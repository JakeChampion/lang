// age — encrypt and decrypt files in the age v1 format.
//
// A port of age 1.3.2 (age-encryption.org): X25519 and ML-KEM-768 + X25519
// hybrid recipients, passphrases and SSH keys.
//
//   $ age -r age1... -o file.age file          # encrypt to a recipient
//   $ age -r age1pq1... -o file.age file       # encrypt to a hybrid recipient
//   $ age -a -r age1... file > file.age        # encrypt to the ASCII armor
//   $ age -p -o file.age file                  # encrypt with a passphrase
//   $ age -R ~/.ssh/id_ed25519.pub file        # encrypt to an SSH key
//   $ age -d -i key.txt -o file file.age       # decrypt
//
// With no INPUT, age reads the standard input. With no -o, it writes the
// standard output. A file given with -o gets its bytes only after all of the
// input decrypts: the bytes go to a temporary file beside it, which takes
// its name at the end.
import "std/array";
import "std/crypto";
import "std/crypto/chacha20poly1305";
import "std/hex";
import "std/option";
import "std/path";
import "std/rand";
import "./cli";
import "./format";
import "./keys";
import "./plugin";
import "./ssh";
import "./source";
import "./tag";
import "./text";
import "./tty";
import "./wordlist";

const MANGLED_CRLF: string = "age-encryption.org/v1\r";

// "age-encryption.org/v1" in UTF-16 with a byte-order mark, cut to the
// length of MANGLED_CRLF.
const MANGLED_UTF16: u8[] = [0xffu8, 0xfeu8, b'a', 0u8, b'g', 0u8, b'e', 0u8, b'-', 0u8, b'e', 0u8, b'n', 0u8, b'c', 0u8, b'r', 0u8, b'y', 0u8, b'p', 0u8];

const STDIN_NAME: string = "/dev/stdin";

function q(s: string): string {
  return text.quote(s.as_bytes());
}

function report(f: cli.Fatal): i32 {
  eprint("age: error: " + f.msg);
  for h in f.hints {
    eprint("age: hint: " + h);
  }
  return 1;
}

// A file read whole: its bytes, or the error of a read after the open.
enum Content {
  Read(u8[]),
  ReadFailed(string),
}

// Reads up to limit bytes of a file, or of the standard input for "-". The
// error is for the open.
function read_named(name: string, stdin_used: boolean, limit: i32, open_failed: string): Result[Content, string] {
  if (name == "-" && stdin_used) {
    return Err("standard input is used for multiple purposes");
  }
  let r = if (name == "-") {
    stdin()
  } else {
    match (open_reader(name)) {
      Ok(r) => r,
      Err(e) => {
        return Err(f"{open_failed}: open {name}: {text.errno_text(e)}");
      },
    }
  };
  let shown = if (name == "-") { STDIN_NAME } else { name };
  let raw = source.open_raw(r, shown);
  let (t, b) = source.raw_peek(raw, limit);
  if (b.len() < limit) {
    if let Some(f) = t.fail {
      if (!f.is_eof()) {
        return Ok(ReadFailed(f.message()));
      }
    }
  }
  return Ok(Read(b));
}

// The age file in an identity file that age encrypts with a passphrase,
// with no armor.
function encrypted_identity(name: string, b: u8[]): Result[keys.Identity[], string] {
  if (!source.after_space(b, source.ARMOR_HEADER)) {
    if (b.len() >= IDENTITY_LIMIT) {
      return Err(f"failed to read {q(name)}: file too long");
    }
    return Ok([keys.Encrypted(name, b)]);
  }
  let (_, all, f) = source.read_full(source.armored(source.raw_bytes(b)), IDENTITY_LIMIT);
  if let Some(e) = f {
    if (!e.is_end()) {
      return Err(f"failed to read {q(name)}: {e.message()}");
    }
  }
  if (all.len() == IDENTITY_LIMIT) {
    return Err(f"failed to read {q(name)}: file too long");
  }
  return Ok([keys.Encrypted(name, all)]);
}

// The identities of a file that holds age secret keys.
function key_identities(name: string, b: [u8]): Result[keys.Identity[], string] {
  return match (keys.identities(b)) {
    Ok(ids) => Ok(ids),
    Err(why) => Err(f"failed to read {q(name)}: {why}"),
  };
}

const IDENTITY_LIMIT: i32 = 16777216;

// The size limit of a PEM file, as in age.
const SSH_KEY_LIMIT: i32 = 16384;

const RFC4716: string = "convert the private key to a modern format with \"ssh-keygen -p -m RFC4716\"";

// age's readPubFile: the public key of an SSH key file in the old PEM
// format, from the file beside it.
function pub_file(name: string): Result[ssh.Public, string] {
  if (name == "-") {
    return Err("failed to obtain public key for \"-\" SSH key\n\nUse a file for which the corresponding \".pub\" file exists, or " + RFC4716);
  }
  let path = name + ".pub";
  let r = match (open_reader(path)) {
    Ok(r) => r,
    Err(e) => {
      return Err(f"failed to obtain public key for {q(name)} SSH key: open {path}: {text.errno_text(e)}\n\nEnsure {q(path)} exists, or convert the private key {q(name)} to a modern format with \"ssh-keygen -p -m RFC4716\"");
    },
  };
  let (t, b) = source.raw_peek(source.open_raw(r, path), IDENTITY_LIMIT);
  if let Some(f) = t.fail {
    if (!f.is_eof()) {
      return Err(f"failed to read {q(path)}: {f.message()}");
    }
  }
  return match (ssh.parse_authorized(b)) {
    Ok(k) => Ok(k),
    Err(why) => Err(f"failed to parse {q(path)}: {why}"),
  };
}

// age's parseSSHIdentity.
function ssh_identity(name: string, b: u8[]): Result[keys.Identity[], string] {
  match (ssh.parse_private(b)) {
    ssh.Key(k) => {
      return match (ssh.identity_of(k)) {
        Ok(id) => Ok([keys.SshId(id)]),
        Err(why) => Err(f"malformed SSH identity in {q(name)}: {why}"),
      };
    },
    ssh.Bad(why) => {
      return Err(f"malformed SSH identity in {q(name)}: {why}");
    },
    ssh.NeedsPassphrase(embedded) => {
      return encrypted_ssh_identity(name, b, embedded);
    }
  }
  return Err("");
}

// age's NewEncryptedSSHIdentity. The public key is in the file, or in the
// .pub file beside it.
function encrypted_ssh_identity(name: string, b: u8[], embedded: Option[ssh.Public]): Result[keys.Identity[], string] {
  let public = match (embedded) {
    Some(k) => k,
    None => pub_file(name)?,
  };
  if let ssh.OtherPublic(t) = public {
    return Err(f"unsupported SSH key type: {t}");
  }
  ssh.recipient_of(public)?;
  return Ok([keys.EncryptedSsh(name, b, public)]);
}

function identity_file(name: string, stdin_used: boolean): Result[keys.Identity[], string] {
  let content = read_named(name, stdin_used, IDENTITY_LIMIT + 1, "failed to open file")?;
  match (content) {
    Read(b) => {
      if (text.has_prefix(b, "age-encryption") || source.after_space(b, source.ARMOR_HEADER)) {
        return encrypted_identity(name, b);
      }
      if (source.after_space(b, "-----BEGIN")) {
        if (b.len() >= SSH_KEY_LIMIT) {
          return Err(f"failed to read {q(name)}: file too long");
        }
        return ssh_identity(name, b);
      }
      return key_identities(name, b);
    },
    ReadFailed(why) => {
      return Err(f"failed to read {q(name)}: failed to read identities file: {why}");
    }
  }
  return Err("");
}

// age's plugin.NewIdentityWithoutData, for -j NAME.
function data_less(name: string): Result[keys.Identity, cli.Fatal] {
  let encoding = plugin.encode_identity(name, []);
  if (encoding.len() == 0) {
    return Err(cli.fatal(f"initializing {q(name)}: invalid plugin name: {q(name)}"));
  }
  return Ok(keys.PluginId(name.to_ascii_lower(), encoding));
}

// The identities of -i and -j, in the order of the command line.
function identities(o: cli.Opts, stdin_used: boolean): Result[keys.Identity[], cli.Fatal] {
  let out: keys.Identity[] = [];
  for f in o.id_flags {
    if (f.plugin) {
      out = out.append(data_less(f.value)?);
      continue;
    }
    match (identity_file(f.value, stdin_used)) {
      Ok(ids) => {
        out = out.concat(ids);
      },
      Err(why) => {
        return Err(cli.fatal(f"reading {q(f.value)}: {why}"));
      }
    }
  }
  return Ok(out);
}

function recipient_file(name: string, stdin_used: boolean): Result[keys.Recipient[], string] {
  return match (read_named(name, stdin_used, 16777216, "failed to open recipient file")) {
    Ok(Read(b)) => keys.recipients_file(b, name),
    Ok(ReadFailed(why)) => Err(f"{q(name)}: failed to read recipients file: {why}"),
    Err(why) => Err(why),
  };
}

// The recipients of the identities of an identity file.
function recipients_of(id: keys.Identity): Result[keys.Recipient[], string] {
  return match (id) {
    keys.X25519Id(k) => Ok([keys.X25519To(k.public)]),
    keys.HybridId(k) => Ok([keys.HybridTo(k.public_key)]),
    keys.SshId(s) => Ok([keys.SshTo(ssh.recipient_of_identity(s))]),
    keys.EncryptedSsh(_, _, public) => match (ssh.recipient_of(public)) {
      Ok(r) => Ok([keys.SshTo(r)]),
      Err(why) => Err(why),
    },
    keys.Encrypted(name, b) => encrypted_recipients(name, b),
    keys.PluginId(name, encoding) => Ok([keys.PluginTo(name, encoding, true)]),
  };
}

// The recipients of the identities in an identity file that a passphrase
// encrypts.
function encrypted_recipients(name: string, b: u8[]): Result[keys.Recipient[], string] {
  let out: keys.Recipient[] = [];
  for inner in open_encrypted(name, b)? {
    out = out.concat(recipients_of(inner)?);
  }
  return Ok(out);
}

// The number of words in a passphrase that age makes.
const PASSPHRASE_WORDS: i32 = 10;

// A passphrase from the terminal. It is secret.
function secret(prompt: string): Result[u8[], string] {
  let p = tty.read_secret(prompt)?;
  __ct_secret(p);
  return Ok(p);
}

// Two secrets are equal. Only the verdict is public.
function same_secret(a: [u8], b: [u8]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let diff = 0u8;
  for i in 0..a.len() {
    diff |= a[i] ^ b[i];
  }
  let verdict = __alloc_u8(1).with(0, diff);
  __ct_public(verdict);
  return verdict[0] == 0;
}

// age's passphrasePromptForEncryption. For an empty passphrase, age makes
// one of 10 random words from the BIP 39 list and shows it on the terminal.
function encryption_passphrase(): Result[u8[], cli.Fatal] {
  let pass = match (secret("Enter passphrase (leave empty to autogenerate a secure one):")) {
    Ok(p) => p,
    Err(why) => {
      return Err(cli.fatal("could not read passphrase: " + why));
    },
  };
  if (pass.len() == 0) {
    let words: string[] = [];
    for _ in 0..PASSPHRASE_WORDS {
      let r = rand.bytes(2);
      words = words.append(wordlist.word((r[0] as i32 << 8 | r[1] as i32) % 2048));
    }
    let made = words.join("-");
    if let Some(why) = tty.tell("using autogenerated passphrase " + q(made)) {
      return Err(cli.fatal("could not print passphrase: " + why));
    }
    return Ok(made.bytes());
  }
  let confirm = match (secret("Confirm passphrase:")) {
    Ok(p) => p,
    Err(why) => {
      return Err(cli.fatal("could not read passphrase: " + why));
    },
  };
  if (!same_secret(confirm, pass)) {
    return Err(cli.fatal("passphrases didn't match"));
  }
  return Ok(pass);
}

// The recipients of the identity files and plugins, for -e -i and -e -j.
function identity_recipients(o: cli.Opts, stdin_used: boolean): Result[keys.Recipient[], cli.Fatal] {
  let out: keys.Recipient[] = [];
  for f in o.id_flags {
    let name = f.value;
    if (f.plugin) {
      if let keys.PluginId(n, encoding) = data_less(name)? {
        out = out.append(keys.PluginTo(n, encoding, true));
      }
      continue;
    }
    let ids = match (identity_file(name, stdin_used)) {
      Ok(ids) => ids,
      Err(why) => {
        return Err(cli.fatal(f"reading {q(name)}: {why}"));
      },
    };
    for id in ids {
      match (recipients_of(id)) {
        Ok(rs) => {
          out = out.concat(rs);
        },
        Err(why) => {
          return Err(cli.fatal(f"internal error processing {q(name)}: {why}"));
        }
      }
    }
  }
  return Ok(out);
}

function recipients(o: cli.Opts, stdin_used: boolean): Result[keys.Recipient[], cli.Fatal] {
  if (o.passphrase) {
    return Ok([keys.ScryptTo(encryption_passphrase()?)]);
  }
  let named = named_recipients(o, stdin_used)?;
  return Ok(named.concat(identity_recipients(o, stdin_used)?));
}

// The recipients of -r and -R.
function named_recipients(o: cli.Opts, stdin_used: boolean): Result[keys.Recipient[], cli.Fatal] {
  let out: keys.Recipient[] = [];
  for arg in o.recipients {
    match (keys.parse_recipient(arg)) {
      Ok(k) => {
        out = out.append(k);
      },
      Err(why) => {
        return Err(cli.fatal(why));
      }
    }
  }
  for name in o.recipient_files {
    match (recipient_file(name, stdin_used)) {
      Ok(ks) => {
        out = out.concat(ks);
      },
      Err(why) => {
        return Err(cli.fatal(f"failed to parse recipient file {q(name)}: {why}"));
      }
    }
  }
  return Ok(out);
}

// Where the result goes: the standard output, or the file at path through a
// temporary file in the same directory. A path that is there and is not a
// regular file, such as a device, takes the bytes directly. After an error,
// fail holds the message and the sink writes nothing more.
struct Sink {
  path: string,
  w: Option[Writer],
  temp: string,
  armor: boolean,
  started: boolean,
  // Bytes for the armor that do not fill a line yet.
  pending: u8[],
  fail: Option[string],
  // Hold all of the output until the end, for the check of a decryption to a
  // terminal.
  hold: boolean,
  held: u8[],
}

function sink_to(path: string, armor: boolean): Sink {
  let w = if (path == "" || path == "-") { Some(stdout()) } else { None };
  return Sink { path: path, w: w, temp: "", armor: armor, started: false, pending: [], fail: None, hold: false, held: [] };
}

function to_file(k: Sink): boolean {
  return k.path != "" && k.path != "-";
}

function directory_of(path: string): string {
  return match (path.last_index_of("/")) {
    Some(at) => path[0:at + 1].unwrap_or("").to_owned(),
    None => "",
  };
}

function failed(own k: Sink, why: string): Sink {
  return Sink { ...k, fail: Some(why) };
}

// Opens the output file on the first write, as age does.
function sink_open(own k: Sink): Sink {
  if (k.w.is_some() || k.fail.is_some()) {
    return k;
  }
  let direct = match (lstat(k.path)) {
    Ok(st) => !st.is_file,
    Err(_) => false,
  };
  let temp = if (direct) { "" } else { directory_of(k.path) + ".age-" + hex.encode(rand.bytes(8)) + ".tmp" };
  let opened = if (direct) { open_writer(k.path) } else { open_exclusive(temp) };
  let path = k.path;
  return match (opened) {
    Ok(w) => Sink { ...k, w: Some(w), temp: temp },
    Err(e) => failed(k, f"open {path}: {text.errno_text(e)}"),
  };
}

function write_raw(own k: Sink, b: [u8]): Sink {
  if (k.hold) {
    let held = k.held.concat(b);
    return Sink { ...k, held: held };
  }
  k = sink_open(k);
  if (k.fail.is_some()) {
    return k;
  }
  let Some(w) = k.w else {
    return k;
  };
  if let Err(e) = w.write_bytes(b) {
    let name = if (to_file(k)) { k.path } else { "/dev/stdout" };
    return failed(k, f"write {name}: {text.errno_text(e)}");
  }
  return k;
}

// The armor lines for the whole groups of 48 bytes in b[0:n].
function armor_lines(b: [u8], n: i32): string {
  let out = "";
  let at = 0;
  while (at + 48 <= n) {
    out += text.b64_padded(b[at:at + 48]) + "\n";
    at += 48;
  }
  return out;
}

function sink_write(own k: Sink, b: [u8]): Sink {
  if (!k.armor) {
    return write_raw(k, b);
  }
  let head = if (k.started) { "" } else { source.ARMOR_HEADER + "\n" };
  let all = k.pending.concat(b);
  let whole = all.len() / 48 * 48;
  let lines = head + armor_lines(all, whole);
  let rest = array.slice(all, whole, all.len());
  let t = Sink { ...k, started: true, pending: rest };
  if (lines.len() == 0) {
    return t;
  }
  return write_raw(t, lines.as_bytes());
}

// Gives the temporary file the mode that os.Create gives a new file, then
// the name of the output.
function install(temp: string, path: string): Option[string] {
  let mask = umask(63);
  umask(mask);
  if let Err(e) = chmod(temp, 438 & ~mask) {
    remove_file(temp);
    return Some(f"chmod {temp}: {text.errno_text(e)}");
  }
  if let Err(e) = rename(temp, path) {
    remove_file(temp);
    return Some(f"rename {temp} {path}: {text.errno_text(e)}");
  }
  return None;
}

// Closes the output file. A temporary file then takes the output's name.
function sink_close(own k: Sink): Option[string] {
  let path = k.path;
  let temp = k.temp;
  let closed = match (k.w) {
    Some(w) => w.close(),
    None => Ok(()),
  };
  if let Err(e) = closed {
    if (temp != "") {
      remove_file(temp);
    }
    return Some(f"failed to close output file {q(path)}: {text.errno_text(e)}");
  }
  if (temp == "") {
    return None;
  }
  return install(temp, path);
}

// Ends the armor and closes the output.
function sink_finish(own k: Sink): Option[string] {
  if (k.armor) {
    let head = if (k.started) { "" } else { source.ARMOR_HEADER + "\n" };
    let last = if (k.pending.len() > 0) { text.b64_padded(k.pending) + "\n" } else { "" };
    k = write_raw(Sink { ...k, started: true, pending: [] }, (head + last + source.ARMOR_FOOTER + "\n").as_bytes());
  }
  if (k.hold) {
    let held = k.held;
    k = write_raw(Sink { ...k, hold: false, held: [] }, held);
  }
  if (!to_file(k)) {
    return k.fail;
  }
  k = sink_open(k);
  if let Some(why) = k.fail {
    sink_abort(k);
    return Some(why);
  }
  return sink_close(k);
}

// Closes the file of a sink that did not finish and removes its temporary
// file.
function sink_abort(own k: Sink): void {
  if (!to_file(k)) {
    return;
  }
  let temp = k.temp;
  match (k.w) {
    Some(w) => {
      w.close();
    },
    None => {}
  }
  if (temp != "") {
    remove_file(temp);
  }
}

// A sealed chunk of the payload, and whether it is the last one by its
// length, or age's message for a payload that ends too soon.
enum Sealed {
  Chunk(u8[], boolean),
  Cut(string),
}

function next_sealed(own s: source.Src, index: i64): (source.Src, Sealed) {
  let (t, sealed, f) = source.read_full(s, format.SEALED);
  let Some(e) = f else {
    return (t, Chunk(sealed, false));
  };
  return match (e) {
    source.Eof => (t, Cut("unexpected EOF")),
    source.Short => if (index != 0 && sealed.len() == 16) {
      (t, Cut("last chunk is empty, try age v1.0.0, and please consider reporting this"))
    } else {
      (t, Chunk(sealed, true))
    },
    _ => (t, Cut(e.message())),
  };
}

// Opens a chunk. A full chunk that does not open as a middle chunk can be the
// last one. The result is the plaintext and whether the chunk was the last.
function open_sealed(key: chacha20poly1305.Key, index: i64, own sealed: u8[], last: boolean): Option[(u8[], boolean)] {
  let n = sealed.len() - 16;
  let spare = if (last) { [] } else { array.slice(sealed, 0, sealed.len()) };
  if let Some(b) = format.open_chunk(key, index, last, sealed) {
    return Some((b, last));
  }
  if (last) {
    return None;
  }
  return match (format.open_chunk(key, index, true, spare)) {
    Some(b) => Some((b, true)),
    None => None,
  };
}

// age's check for bytes after the last chunk.
function after_last(own s: source.Src): Option[string] {
  let (_, g) = source.read_one(s);
  return match (g) {
    None => Some("trailing data after end of encrypted file"),
    Some(source.Eof) => None,
    Some(e) => Some("non-EOF error reading after end of encrypted file: " + e.message()),
  };
}

// The decrypted payload, written chunk by chunk as each one authenticates.
// age's stream.Reader.
function decrypt_stream(own s: source.Src, own out: Sink, key: chacha20poly1305.Key): (Sink, Option[string]) {
  let index = 0i64;
  loop {
    let (t, next) = next_sealed(s, index);
    s = t;
    let (sealed, by_length) = match (next) {
      Chunk(b, l) => (b, l),
      Cut(why) => { return (out, Some(why)); },
    };
    let n = sealed.len() - 16;
    let Some((plain, last)) = open_sealed(key, index, sealed, by_length) else {
      return (out, Some("failed to decrypt and authenticate payload chunk, file may be corrupted or tampered with"));
    };
    let text_part = plain[0:n];
    __ct_public(text_part);
    out = sink_write(out, text_part);
    if (out.fail.is_some()) {
      let why = out.fail;
      return (out, why);
    }
    index += 1;
    if (last) {
      return (out, after_last(s));
    }
  }
  return (out, None);
}

// The specification's rule: an scrypt stanza is the only stanza.
function scrypt_not_alone(h: format.Header): boolean {
  for st in h.stanzas {
    if (st.kind == "scrypt" && h.stanzas.len() != 1) {
      return true;
    }
  }
  return false;
}

function scrypt_file(h: format.Header): boolean {
  return h.stanzas.len() == 1 && h.stanzas[0].kind == "scrypt";
}

const SCRYPT_ALONE: string = "an scrypt recipient must be the only one";

const NO_MATCH: string = "no identity matched any of the recipients";

// age's LazyScryptIdentity: it asks for a passphrase only for a file with
// one scrypt stanza.
function lazy_scrypt(h: format.Header, prompt: string): format.Unwrapped {
  if (scrypt_not_alone(h)) {
    return format.Invalid(SCRYPT_ALONE);
  }
  if (!scrypt_file(h)) {
    return format.Incorrect;
  }
  let pass = match (secret(prompt)) {
    Ok(p) => p,
    Err(why) => {
      return format.Invalid("could not read passphrase: could not read passphrase: " + why);
    },
  };
  if (pass.len() == 0) {
    return format.Invalid("passphrase can't be empty");
  }
  let got = format.unwrap_scrypt(h.stanzas[0], pass);
  crypto.erase(pass);
  return match (got) {
    format.Incorrect => format.Invalid("incorrect passphrase"),
    _ => got,
  };
}

// The key of the payload, after the header MAC verifies.
function payload_key_of(own s: source.Src, h: format.Header, own file_key: u8[]): (source.Src, Result[chacha20poly1305.Key, string]) {
  if (!format.mac_ok(file_key, h)) {
    return (s, Err("bad header MAC"));
  }
  let (t, nonce, f) = source.read_full(s, 16);
  if let Some(e) = f {
    return (t, Err("failed to read nonce: " + e.message()));
  }
  let key = format.payload_key(file_key, nonce);
  crypto.erase(file_key);
  return match (key) {
    Ok(k) => (t, Ok(k)),
    Err(e) => (t, Err(e.message())),
  };
}

// The whole payload in memory, or the message of the first failure.
function decrypt_all(own s: source.Src, key: chacha20poly1305.Key): Result[u8[], string] {
  let out: u8[] = [];
  let index = 0i64;
  loop {
    let (t, next) = next_sealed(s, index);
    s = t;
    let (sealed, by_length) = match (next) {
      Chunk(b, l) => (b, l),
      Cut(why) => { return Err(why); },
    };
    let n = sealed.len() - 16;
    let Some((plain, last)) = open_sealed(key, index, sealed, by_length) else {
      return Err("failed to decrypt and authenticate payload chunk, file may be corrupted or tampered with");
    };
    out = out.concat(plain[0:n]);
    index += 1;
    if (last) {
      if let Some(why) = after_last(s) {
        return Err(why);
      }
      return Ok(out);
    }
  }
  return Ok(out);
}

// The plaintext of an identity file that age encrypts with a passphrase.
// age's EncryptedIdentity.decrypt.
function decrypt_identity_file(name: string, b: u8[]): Result[u8[], string] {
  let (s, parsed) = format.parse(source.plain(source.raw_bytes(b)));
  let h = match (parsed) {
    Ok(h) => h,
    Err(why) => {
      return Err("failed to decrypt identity file: failed to read header: " + why);
    },
  };
  let file_key = match (lazy_scrypt(h, f"Enter passphrase for identity file {q(name)}:")) {
    format.FileKey(k) => k,
    format.Incorrect => {
      return Err("identity file is encrypted with age but not with a passphrase");
    },
    format.Invalid(why) => {
      return Err("failed to decrypt identity file: " + why);
    },
    format.Missing(why, _) => {
      return Err("failed to decrypt identity file: " + why);
    },
  };
  let (t, keyed) = payload_key_of(s, h, file_key);
  let key = match (keyed) {
    Ok(k) => k,
    Err(why) => {
      return Err("failed to decrypt identity file: " + why);
    },
  };
  return match (decrypt_all(t, key)) {
    Ok(plain) => Ok(plain),
    Err(why) => Err("failed to read identities file: " + why),
  };
}

// The identities in an identity file that age encrypts with a passphrase.
function open_encrypted(name: string, b: u8[]): Result[keys.Identity[], string] {
  let plain = decrypt_identity_file(name, b)?;
  __ct_secret(plain);
  let found = keys.identities(plain);
  crypto.erase(plain);
  return found;
}

// age's ErrIncorrectIdentity: the identity is not for this stanza.
function incorrect(u: format.Unwrapped): boolean {
  return match (u) {
    format.Incorrect => true,
    _ => false,
  };
}

// One stanza with an identity that has its key in memory.
function unwrap_stanza(id: keys.Identity, st: format.Stanza): format.Unwrapped {
  return match (id) {
    keys.X25519Id(k) => format.unwrap(st, k.scalar, k.public),
    keys.HybridId(k) => format.unwrap_hybrid(st, k),
    keys.SshId(s) => ssh.unwrap(st, s),
    _ => format.Incorrect,
  };
}

// The identities of an identity file that a passphrase encrypts, on the
// stanzas. age's EncryptedIdentity.Unwrap.
function unwrap_encrypted(name: string, b: u8[], h: format.Header): format.Unwrapped {
  let ids = match (open_encrypted(name, b)) {
    Ok(ids) => ids,
    Err(why) => {
      return format.Invalid(why);
    },
  };
  for inner in ids {
    let got = unwrap_with(inner, h);
    if (!incorrect(got)) {
      return got;
    }
  }
  eprint(f"age: warning: encrypted identity file {q(name)} didn't match file's recipients");
  return format.Incorrect;
}

// age's multiUnwrap: the first stanza that the identity unwraps, or the
// first stanza that is not valid for it.
function unwrap_with(id: keys.Identity, h: format.Header): format.Unwrapped {
  match (id) {
    keys.Encrypted(name, b) => {
      return unwrap_encrypted(name, b, h);
    },
    keys.EncryptedSsh(name, b, public) => {
      return unwrap_encrypted_ssh(name, b, public, h);
    },
    keys.PluginId(name, encoding) => {
      return unwrap_plugin(name, encoding, h);
    },
    _ => {}
  }
  for st in h.stanzas {
    let got = unwrap_stanza(id, st);
    if (!incorrect(got)) {
      return got;
    }
  }
  return format.Incorrect;
}

// age's plugin Identity.Unwrap: the plugin gets all of the stanzas.
function unwrap_plugin(name: string, encoding: string, h: format.Header): format.Unwrapped {
  return match (plugin.unwrap(name, encoding, h.stanzas)) {
    plugin.Key(k) => format.FileKey(k),
    plugin.NoMatch => format.Incorrect,
    plugin.Failed(f) => if (f.missing.len() > 0) {
      format.Missing(f"{name} plugin: {f.msg}", f.missing)
    } else {
      format.Invalid(f"{name} plugin: {f.msg}")
    },
  };
}

// age's hints for a plugin that is not on the PATH.
function missing_hints(name: string): string[] {
  return [f"you might want to install the {q(name)} plugin", "visit https://age-encryption.org/awesome#plugins for a list of available plugins"];
}

// age's EncryptedSSHIdentity.Unwrap: a passphrase only when a stanza is for
// this key.
function unwrap_encrypted_ssh(name: string, b: u8[], public: ssh.Public, h: format.Header): format.Unwrapped {
  match (ssh.encrypted_match(h.stanzas, public)) {
    Ok(true) => {},
    Ok(false) => {
      return format.Incorrect;
    },
    Err(why) => {
      return format.Invalid(why);
    }
  }
  return match (decrypted_ssh(name, b, public)) {
    Ok(id) => unwrap_with(keys.SshId(id), h),
    Err(why) => format.Invalid(why),
  };
}

// The identity of an SSH key file after its passphrase decrypts it.
function decrypted_ssh(name: string, b: u8[], public: ssh.Public): Result[ssh.Identity, string] {
  let pass = match (secret(f"Enter passphrase for {q(name)}:")) {
    Ok(p) => p,
    Err(why) => {
      return Err(f"failed to obtain passphrase: could not read passphrase for {q(name)}: {why}");
    },
  };
  let key = match (ssh.decrypt_private(b, pass)) {
    ssh.Key(k) => k,
    ssh.Bad(why) => {
      return Err("failed to decrypt SSH key file: " + why);
    },
    ssh.NeedsPassphrase(_) => {
      return Err("failed to decrypt SSH key file: ssh: this private key is passphrase protected");
    },
  };
  if (!ssh.same_public(key, public)) {
    return Err("mismatched private and public SSH key");
  }
  return match (ssh.identity_of(key)) {
    Ok(id) => Ok(id),
    Err(why) => Err("invalid SSH key: " + why),
  };
}

const PASSPHRASE_AND_IDENTITIES: string = "file is passphrase-encrypted but identities were specified with -i/--identity or -j";

// The file key of an unwrap, or age's message.
function key_or_fatal(u: format.Unwrapped): Result[u8[], cli.Fatal] {
  return match (u) {
    format.FileKey(k) => Ok(k),
    format.Incorrect => Err(cli.fatal(NO_MATCH)),
    format.Invalid(why) => Err(cli.fatal(why)),
    format.Missing(why, name) => Err(cli.Fatal { msg: why, hints: missing_hints(name) }),
  };
}

// age's native identities: the keys that age tries before the others.
function native(id: keys.Identity): boolean {
  return match (id) {
    keys.X25519Id(_) | keys.HybridId(_) => true,
    _ => false,
  };
}

// The identities in the order that age.Decrypt tries them: the native ones
// first, and then the others, each group in the order of the flags.
function in_age_order(ids: keys.Identity[]): keys.Identity[] {
  let first: keys.Identity[] = [];
  let rest: keys.Identity[] = [];
  for id in ids {
    if (native(id)) {
      first = first.append(id);
    } else {
      rest = rest.append(id);
    }
  }
  return first.concat(rest);
}

// The file key from the first identity that unwraps a stanza, in age's order.
// With no -i, age asks for a passphrase. After the identities of -i, age's
// rejectScryptIdentity refuses a file that a passphrase encrypts.
function file_key_of(h: format.Header, ids: keys.Identity[], flagged: boolean): Result[u8[], cli.Fatal] {
  if (!flagged) {
    let u = lazy_scrypt(h, "Enter passphrase:");
    if (incorrect(u)) {
      return Err(cli.Fatal { msg: "the file is not passphrase-encrypted, identities are required", hints: ["specify identities with -i/--identity or -j to decrypt this file"] });
    }
    return key_or_fatal(u);
  }
  if (scrypt_not_alone(h)) {
    return Err(cli.fatal(SCRYPT_ALONE));
  }
  for id in in_age_order(ids) {
    let got = unwrap_with(id, h);
    if (!incorrect(got)) {
      return key_or_fatal(got);
    }
  }
  if (scrypt_file(h)) {
    return Err(cli.Fatal { msg: PASSPHRASE_AND_IDENTITIES, hints: ["remove all -i/--identity/-j flags to decrypt passphrase-encrypted files"] });
  }
  return Err(cli.fatal(NO_MATCH));
}

// The header and the input after it, or age's message.
function read_header(own input: source.Raw): (source.Src, Result[format.Header, cli.Fatal]) {
  let (raw, head) = source.raw_peek(input, MANGLED_CRLF.len());
  if (text.equals(head, MANGLED_CRLF) || head == MANGLED_UTF16) {
    return (source.plain(raw), Err(cli.Fatal { msg: "invalid header intro", hints: ["it looks like this file was corrupted by PowerShell redirection", "consider using -o or -a to encrypt files in PowerShell"] }));
  }
  let (t, parsed) = format.parse(source.start(raw));
  return match (parsed) {
    Ok(h) => (t, Ok(h)),
    Err(why) => (t, Err(cli.fatal("failed to read header: " + why))),
  };
}

function decrypt(o: cli.Opts, own input: source.Raw, stdin_used: boolean): Option[cli.Fatal] {
  let ids = match (identities(o, stdin_used)) {
    Ok(ids) => ids,
    Err(f) => {
      return Some(f);
    },
  };
  let (s, parsed) = read_header(input);
  let h = match (parsed) {
    Ok(h) => h,
    Err(f) => {
      return Some(f);
    },
  };
  let file_key = match (file_key_of(h, ids, o.identities.len() + o.plugins.len() > 0)) {
    Ok(k) => k,
    Err(f) => {
      return Some(f);
    },
  };
  let (t, keyed) = payload_key_of(s, h, file_key);
  let key = match (keyed) {
    Ok(k) => k,
    Err(why) => {
      return Some(cli.fatal(why));
    },
  };
  let (out, failed) = decrypt_stream(t, Sink { ...sink_to(o.output, false), hold: holds_for_terminal(o, stdin_used) }, key);
  if let Some(why) = failed {
    sink_abort(out);
    return Some(cli.fatal(why));
  }
  if (checks_text(o) && !printable(out.held)) {
    return Some(cli.Fatal { msg: "refusing to output binary to the terminal", hints: ["force anyway with \"-o -\""] });
  }
  return sink_finish(out).map((why: string) => cli.fatal(why));
}

// age holds the output to a terminal until the end: a decryption, to check
// that it is text, and any output when the input is the terminal too, so
// that it does not mix with a prompt.
function holds_for_terminal(o: cli.Opts, stdin_used: boolean): boolean {
  if (o.output != "" && o.output != "-" || !stdout().isatty()) {
    return false;
  }
  return o.decrypt && o.output == "" || stdin_used && stdin().isatty();
}

// age's check that a decryption to a terminal is text.
function checks_text(o: cli.Opts): boolean {
  return o.decrypt && o.output == "" && stdout().isatty();
}

// age's bufferTerminalInput: the input that a user types at the terminal, up
// to the line after the end of the armor.
function buffer_terminal(): Result[source.Raw, cli.Fatal] {
  let end = (source.ARMOR_FOOTER + "\n").as_bytes();
  let buf: u8[] = [];
  while (!contains(buf, end)) {
    match (stdin().read_chunk_bytes(512)) {
      Ok(b) => {
        if (b.len() == 0) {
          break;
        }
        buf = buf.concat(b);
      },
      Err(e) => {
        return Err(cli.fatal(f"failed to buffer terminal input: read {STDIN_NAME}: {text.errno_text(e)}"));
      }
    }
  }
  return Ok(source.raw_bytes(buf));
}

function contains(b: [u8], p: [u8]): boolean {
  let i = 0;
  while (i + p.len() <= b.len()) {
    let j = 0;
    while (j < p.len() && b[i + j] == p[j]) {
      j += 1;
    }
    if (j == p.len()) {
      return true;
    }
    i += 1;
  }
  return false;
}

// A chunk of plaintext, and whether the input ended in it.
struct Plain { bytes: u8[], ended: boolean }

function read_plain(own s: source.Src): (source.Src, Result[Plain, string]) {
  let (t, chunk, f) = source.read_full(s, format.CHUNK);
  return match (f) {
    None => (t, Ok(Plain { bytes: chunk, ended: false })),
    Some(source.Eof) | Some(source.Short) => (t, Ok(Plain { bytes: chunk, ended: true })),
    Some(e) => (t, Err(e.message())),
  };
}

const TAG_ROOM: u8[] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];

// A full chunk is the last one when the input ends after it, so each chunk is
// sealed after the read of the next one.
function encrypt_stream(own s: source.Src, own out: Sink, key: chacha20poly1305.Key): (Sink, Option[string]) {
  let index = 0i64;
  let (t, first) = read_plain(s);
  s = t;
  let cur = match (first) {
    Ok(p) => p,
    Err(why) => { return (out, Some(why)); },
  };
  loop {
    let next = Plain { bytes: [], ended: true };
    if (!cur.ended) {
      let (u, r) = read_plain(s);
      s = u;
      next = match (r) {
        Ok(p) => p,
        Err(why) => { return (out, Some(why)); },
      };
    }
    let last = cur.ended || next.bytes.len() == 0;
    let n = cur.bytes.len();
    let sealed = match (format.seal_chunk(key, index, last, cur.bytes.concat(TAG_ROOM), n)) {
      Ok(b) => b,
      Err(e) => {
        return (out, Some(e.message()));
      },
    };
    __ct_public(sealed);
    out = sink_write(out, sealed);
    if (out.fail.is_some() || last) {
      let why = out.fail;
      return (out, why);
    }
    cur = next;
    index += 1;
  }
  return (out, None);
}

// The stanzas that wrap the file key to one recipient, and its labels,
// sorted. age's wrapWithLabels.
struct Wrapped { stanzas: format.Stanza[], labels: string[] }

function wrapped_one(st: Result[format.Stanza, string], labels: string[]): Result[Wrapped, cli.Fatal] {
  return match (st) {
    Ok(s) => Ok(Wrapped { stanzas: [s], labels: labels }),
    Err(why) => Err(cli.fatal(why)),
  };
}

function sorted(labels: string[]): string[] {
  let out = labels;
  for i in 1..out.len() {
    let j = i;
    while (j > 0 && out[j - 1] > out[j]) {
      let t = out[j];
      out = out.with(j, out[j - 1]).with(j - 1, t);
      j -= 1;
    }
  }
  return out;
}

function wrap_to(file_key: [u8], r: keys.Recipient): Result[Wrapped, cli.Fatal] {
  match (r) {
    keys.TagTo(k) => {
      return wrapped_one(tag.wrap_random(file_key, k), tag.labels(k));
    },
    keys.PluginTo(name, encoding, identity) => {
      return match (plugin.wrap(name, encoding, identity, file_key)) {
        Ok(w) => Ok(Wrapped { stanzas: w.stanzas, labels: sorted(w.labels.unwrap_or([])) }),
        Err(f) => Err(cli.Fatal { msg: f"{name} plugin: {f.msg}", hints: if (f.missing.len() > 0) { missing_hints(f.missing) } else { [] } }),
      };
    },
    keys.HybridTo(_) => {
      return wrapped_one(wrap_native(file_key, r), ["postquantum"]);
    },
    keys.ScryptTo(_) => {
      return wrapped_one(wrap_native(file_key, r), [hex.encode(rand.bytes(16))]);
    },
    _ => {
      return wrapped_one(wrap_native(file_key, r), []);
    }
  }
  return Err(cli.fatal(""));
}

// The stanza that wraps the file key to a recipient of age itself.
function wrap_native(file_key: [u8], r: keys.Recipient): Result[format.Stanza, string] {
  match (r) {
    keys.X25519To(public) => {
      let ephemeral = rand.bytes(32);
      __ct_secret(ephemeral);
      let st = format.wrap(file_key, public, ephemeral);
      crypto.erase(ephemeral);
      return st;
    },
    keys.HybridTo(public) => {
      let randomness = rand.bytes(64);
      __ct_secret(randomness);
      let st = format.wrap_hybrid(file_key, public, randomness);
      crypto.erase(randomness);
      return st;
    },
    keys.SshTo(r) => {
      return ssh.wrap(file_key, r, rand.bytes(32));
    },
    keys.ScryptTo(pass) => {
      return format.wrap_scrypt(file_key, pass, rand.bytes(16), format.SCRYPT_WORK_FACTOR);
    },
    _ => {}
  }
  return Err("");
}

function same_labels(a: string[], b: string[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

function has_label(labels: string[], label: string): boolean {
  for l in labels {
    if (l == label) {
      return true;
    }
  }
  return false;
}

// Go's %q of a []string.
function quoted_list(labels: string[]): string {
  let shown: string[] = [];
  for l in labels {
    shown = shown.append(q(l));
  }
  return "[" + shown.join(" ") + "]";
}

// age's incompatibleLabelsError.
function incompatible(a: string[], b: string[]): string {
  if (has_label(a, "postquantum") != has_label(b, "postquantum")) {
    return "incompatible recipients: can't mix post-quantum and classic recipients, or the file would be vulnerable to quantum computers";
  }
  return f"incompatible recipients: {quoted_list(a)} and {quoted_list(b)} can't be mixed";
}

// The header for a fresh file key and the payload key. Only the file key's
// stanzas and the MAC leave this function. age's encryptHdr: the labels of
// each recipient must be the labels of the first one.
function seal_header(rs: keys.Recipient[], nonce: [u8]): Result[(format.Header, chacha20poly1305.Key), cli.Fatal] {
  let file_key = rand.bytes(16);
  __ct_secret(file_key);
  let stanzas: format.Stanza[] = [];
  let labels: string[] = [];
  for i in 0..rs.len() {
    let w = match (wrap_to(file_key, rs[i])) {
      Ok(w) => w,
      Err(f) => {
        return Err(cli.Fatal { ...f, msg: f"failed to wrap key for recipient #{i}: {f.msg}" });
      },
    };
    if (i == 0) {
      labels = w.labels;
    } else if (!same_labels(labels, w.labels)) {
      return Err(cli.fatal(incompatible(labels, w.labels)));
    }
    stanzas = stanzas.concat(w.stanzas);
  }
  let unsigned = format.Header { stanzas: stanzas, mac: [] };
  let mac = format.header_mac(file_key, unsigned);
  __ct_public(mac);
  let key = format.payload_key(file_key, nonce);
  crypto.erase(file_key);
  return match (key) {
    Ok(k) => Ok((format.Header { ...unsigned, mac: mac }, k)),
    Err(e) => Err(cli.fatal(e.message())),
  };
}

// The header and the nonce, as age.Encrypt writes them.
function start_output(o: cli.Opts, h: format.Header, nonce: [u8], stdin_used: boolean): (Sink, Option[string]) {
  let out = sink_write(Sink { ...sink_to(o.output, o.armor), hold: holds_for_terminal(o, stdin_used) }, format.marshal(h).as_bytes());
  if let Some(why) = out.fail {
    return (out, Some("failed to write header: " + why));
  }
  out = sink_write(out, nonce);
  if let Some(why) = out.fail {
    return (out, Some("failed to write nonce: " + why));
  }
  return (out, None);
}

function encrypt(o: cli.Opts, own input: source.Raw, stdin_used: boolean): Option[cli.Fatal] {
  let rs = match (recipients(o, stdin_used)) {
    Ok(rs) => rs,
    Err(f) => {
      return Some(f);
    },
  };
  let nonce = rand.bytes(16);
  let (h, key) = match (seal_header(rs, nonce)) {
    Ok(hk) => hk,
    Err(f) => { return Some(f); },
  };
  let (out, started) = start_output(o, h, nonce, stdin_used);
  if let Some(why) = started {
    sink_abort(out);
    return Some(cli.fatal(why));
  }
  let (done, failed) = encrypt_stream(source.plain(input), out, key);
  if let Some(why) = failed {
    sink_abort(done);
    return Some(cli.fatal(why));
  }
  return sink_finish(done).map((why: string) => cli.fatal(why));
}

function finish(failed: Option[cli.Fatal]): i32 {
  return match (failed) {
    Some(f) => report(f),
    None => 0,
  };
}

// The input file, or the standard input for "" and "-".
function open_input(name: string): Result[source.Raw, cli.Fatal] {
  if (name == "" || name == "-") {
    return Ok(source.open_raw(stdin(), STDIN_NAME));
  }
  return match (open_reader(name)) {
    Ok(r) => Ok(source.open_raw(r, name)),
    Err(e) => Err(cli.fatal(f"failed to open input file {q(name)}: open {name}: {text.errno_text(e)}")),
  };
}

// age refuses to write a binary file to a terminal unless "-o -" asks for it.
function terminal_refusal(o: cli.Opts): Option[cli.Fatal] {
  if (o.output != "" || o.decrypt || o.armor || !stdout().isatty()) {
    return None;
  }
  return Some(cli.Fatal { msg: "refusing to output binary to the terminal", hints: ["did you mean to use -a/--armor?", "force anyway with \"-o -\""] });
}

// The check of a decryption to a terminal: valid UTF-8 with no control
// character other than "\n", "\r" and "\t" (Go's unicode.IsControl).
function printable(b: [u8]): boolean {
  if (!text.valid_utf8(b)) {
    return false;
  }
  for i in 0..b.len() {
    if (control_at(b, i)) {
      return false;
    }
  }
  return true;
}

// A C0 or C1 control character, or DEL, starts at b[i]. In valid UTF-8, a C1
// character is 0xc2 and then a byte below 0xa0.
function control_at(b: [u8], i: i32): boolean {
  let c = b[i];
  let c0 = c < 0x20u8 && c != b'\n' && c != b'\r' && c != b'\t';
  return c0 || c == 0x7fu8 || c == 0xc2u8 && i + 1 < b.len() && b[i + 1] < 0xa0u8;
}

// age's warnDuplicates: one warning for each value that a flag repeats.
function warn_duplicates(values: string[], what: string): void {
  for i in 0..values.len() {
    let earlier = 0;
    for j in 0..i {
      if (values[j] == values[i]) {
        earlier += 1;
      }
    }
    if (earlier == 1) {
      eprint(f"age: warning: duplicate {what} {q(values[i])}");
    }
  }
}

// Go's filepath.Abs.
function abs_path(name: string): string {
  if (path.is_absolute(name)) {
    return path.clean(name);
  }
  return match (getcwd()) {
    Ok(dir) => path.clean(dir + "/" + name),
    Err(_) => name,
  };
}

// age refuses an output file that is an input file, an identity file or a
// recipients file, by its path or by its device and inode.
function same_file_refusal(o: cli.Opts, input: string): Option[cli.Fatal] {
  if (o.output == "" || o.output == "-") {
    return None;
  }
  let in_use = o.identities.concat(o.recipient_files);
  if (input != "" && input != "-") {
    in_use = in_use.append(input);
  }
  let out = abs_path(o.output);
  let out_stat = stat(o.output);
  for f in in_use {
    let same = abs_path(f) == out || match ((out_stat, stat(f))) {
      (Ok(a), Ok(b)) => a.dev == b.dev && a.ino == b.ino,
      _ => false,
    };
    if (same) {
      return Some(cli.fatal(f"input and output file are the same: {q(o.output)}"));
    }
  }
  return None;
}

function run(argv: string[], o: cli.Opts): i32 {
  if let Some(f) = cli.check(argv, o) {
    return report(f);
  }
  warn_duplicates(o.recipients, "recipient");
  warn_duplicates(o.recipient_files, "recipients file");
  warn_duplicates(o.identities, "identity file");
  let name = if (o.inputs.len() > 0) { o.inputs[0] } else { "" };
  let input = match (open_input(name)) {
    Ok(raw) => raw,
    Err(f) => {
      return report(f);
    },
  };
  if (o.decrypt && (name == "" || name == "-") && stdin().isatty()) {
    input = match (buffer_terminal()) {
      Ok(raw) => raw,
      Err(f) => {
        return report(f);
      },
    };
  }
  if let Some(f) = same_file_refusal(o, name) {
    return report(f);
  }
  if let Some(f) = terminal_refusal(o) {
    return report(f);
  }
  let stdin_used = name == "" || name == "-";
  if (o.decrypt) {
    return finish(decrypt(o, input, stdin_used));
  }
  return finish(encrypt(o, input, stdin_used));
}

function main(): i32 {
  let argv = args();
  if (argv.len() == 1) {
    eprint(cli.USAGE.join("\n"));
    return 1;
  }
  match (cli.parse(array.slice(argv, 1, argv.len()))) {
    cli.Help => {
      eprint(cli.USAGE.join("\n"));
      return 0;
    },
    cli.Bad(why) => {
      eprint(why);
      eprint(cli.USAGE.join("\n"));
      return 2;
    },
    cli.Run(o) => {
      if (o.version) {
        print("v1.3.2-fern");
        return 0;
      }
      return run(argv, o);
    }
  }
  return 0;
}
