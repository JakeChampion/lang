// age-keygen — make an age key pair, or give the recipients of an identity
// file.
//
// A port of age-keygen from age 1.3.2 (age-encryption.org).
//
//   $ age-keygen -o key.txt         # write a new X25519 key pair to key.txt
//   $ age-keygen -pq -o key.txt     # write a new ML-KEM-768 + X25519 key pair
//   $ age-keygen -y key.txt         # write the recipients of key.txt
import "std/array";
import "std/crypto/hpke";
import "std/rand";
import "std/time";
import "std/tz";
import "./goflag";
import "./keys";
import "./text";

const USAGE: string[] = [
  "Usage:",
  "    age-keygen [-pq] [-o OUTPUT]",
  "    age-keygen -y [-o OUTPUT] [INPUT]",
  "",
  "Options:",
  "    -pq                       Make an ML-KEM-768 + X25519 hybrid key pair.",
  "    -o, --output OUTPUT       Write the result to the file at path OUTPUT.",
  "    -y                        Write the recipients of an identity file.",
  "",
  "age-keygen makes a new X25519 key pair, or with -pq a new ML-KEM-768 +",
  "X25519 hybrid key pair. It writes the key pair to the standard output or to",
  "OUTPUT. When the output is not a terminal, it also writes the public key to",
  "the standard error. age-keygen does not write over an OUTPUT that is there.",
  "",
  "With -y, age-keygen reads an identity file from INPUT or from the standard",
  "input. It writes the recipient of each key, one for each line, to OUTPUT or",
  "to the standard output.",
];

const NAMES: goflag.Names = goflag.Names { bools: ["version", "pq", "y"], values: ["o", "output"] };

function fail(msg: string): i32 {
  eprint("age-keygen: error: " + msg);
  return 1;
}

function q(s: string): string {
  return text.quote(s.as_bytes());
}

struct Opts { version: boolean, pq: boolean, convert: boolean, output: string }

function options(flags: goflag.Flag[]): Opts {
  let o = Opts { version: false, pq: false, convert: false, output: "" };
  for f in flags {
    o = match (f) {
      goflag.BoolFlag(name, v) => if (name == "y") {
        Opts { ...o, convert: v }
      } else if (name == "pq") {
        Opts { ...o, pq: v }
      } else {
        Opts { ...o, version: v }
      },
      goflag.ValueFlag(_, v) => Opts { ...o, output: v },
    };
  }
  return o;
}

// age-keygen -y: the recipient of each key of the identity file.
function convert(input: Reader, name: string): Result[string, string] {
  let content = match (keys.read_all(input, name)) {
    Ok(b) => b,
    Err(why) => {
      return Err("failed to parse input: failed to read identities file: " + why);
    },
  };
  let found = match (keys.parse_identities(content)) {
    Ok(ks) => ks,
    Err(why) => {
      return Err("failed to parse input: " + why);
    },
  };
  let out = "";
  for id in found {
    out += keys.identity_recipient(id) + "\n";
  }
  return Ok(out);
}

// The time now in the local time zone, as Go's time.RFC3339 writes it.
function created(): string {
  let now = time.timestamp_from_unix(now_unix_ms() / 1000i64);
  return tz.local_zone().at(now).format_rfc3339();
}

// The recipient and the secret key line of a new key pair.
function new_key(pq: boolean): Result[(string, string), string] {
  if (pq) {
    let seed = rand.bytes(32);
    __ct_secret(seed);
    return match (hpke.mlkem768x25519_key(seed)) {
      Ok(k) => Ok((keys.hybrid_recipient_text(k.public_key), keys.hybrid_secret_text(seed))),
      Err(e) => Err("internal error: " + e.message()),
    };
  }
  return match (keys.key_of(rand.bytes(32))) {
    Ok(k) => Ok((keys.recipient_text(k.public), keys.secret_text(k.scalar))),
    Err(why) => Err("internal error: " + why),
  };
}

// Go's error for a write to the output.
function write_error(out_name: string, e: IoError): string {
  return f"failed to write output: write {out_name}: {text.errno_text(e)}";
}

// A new key pair. The public key goes to the standard error too when out is
// not a terminal.
function generate(out: Writer, out_name: string, pq: boolean): Option[string] {
  match (out.stat()) {
    Ok(st) => {
      if (st.is_file && (st.mode & 4u32) != 0u32) {
        eprint("age-keygen: warning: writing secret key to a world-readable file");
      }
    },
    Err(_) => {}
  }
  let (recipient, secret) = match (new_key(pq)) {
    Ok(k) => k,
    Err(why) => { return Some(why); },
  };
  if (!out.isatty()) {
    eprint("Public key: " + recipient);
  }
  let text_out = f"# created: {created()}\n# public key: {recipient}\n{secret}\n";
  if let Err(e) = out.write(text_out) {
    return Some(write_error(out_name, e));
  }
  return None;
}

// The input: the standard input for "" and "-".
function open_input(name: string): Result[Reader, string] {
  if (name == "" || name == "-") {
    return Ok(stdin());
  }
  return match (open_reader(name)) {
    Ok(r) => Ok(r),
    Err(e) => Err(f"failed to open input file {q(name)}: open {name}: {text.errno_text(e)}"),
  };
}

// The output: the standard output, or a new file.
function output(path: string): Result[Writer, string] {
  if (path == "") {
    return Ok(stdout());
  }
  return keys.create(path);
}

// The recipients of -y, read before the output opens, as age-keygen does.
function converted(inputs: string[]): Result[string, string] {
  let name = if (inputs.len() > 0) { inputs[0] } else { "" };
  let shown = if (name == "" || name == "-") { "/dev/stdin" } else { name };
  return convert(open_input(name)?, shown);
}

// The work of age-keygen after the flags, or its message.
// The text of -y, or "" for a new key pair.
function recipients_text(o: Opts, inputs: string[]): Result[string, string] {
  if (!o.convert) {
    return Ok("");
  }
  return converted(inputs);
}

// Writes the recipients of -y, or a new key pair.
function write_out(o: Opts, out: Writer, recipients: string): Option[string] {
  let out_name = if (o.output == "") { "/dev/stdout" } else { o.output };
  if (!o.convert) {
    return generate(out, out_name, o.pq);
  }
  return match (out.write(recipients)) {
    Ok(_) => None,
    Err(e) => Some(write_error(out_name, e)),
  };
}

function work(o: Opts, inputs: string[]): Option[string] {
  let recipients = match (recipients_text(o, inputs)) {
    Ok(s) => s,
    Err(why) => {
      return Some(why);
    },
  };
  let out = match (output(o.output)) {
    Ok(w) => w,
    Err(why) => {
      return Some(why);
    },
  };
  let failed = write_out(o, out, recipients);
  if (failed.is_some() || o.output == "") {
    return failed;
  }
  return match (out.close()) {
    Ok(_) => None,
    Err(e) => Some(f"failed to close output file {q(o.output)}: {text.errno_text(e)}"),
  };
}

function run(o: Opts, inputs: string[]): i32 {
  if (o.version) {
    print("v1.3.2-fern");
    return 0;
  }
  if (inputs.len() != 0 && !o.convert || inputs.len() > 1 && o.convert) {
    return fail("too many arguments");
  }
  if (o.pq && o.convert) {
    return fail("-pq cannot be used with -y");
  }
  return match (work(o, inputs)) {
    Some(why) => fail(why),
    None => 0,
  };
}

function main(): i32 {
  let argv = args();
  match (goflag.parse(NAMES, array.slice(argv, 1, argv.len()))) {
    goflag.Help => {
      eprint(USAGE.join("\n"));
      return 0;
    },
    goflag.Bad(why) => {
      eprint(why);
      eprint(USAGE.join("\n"));
      return 2;
    },
    goflag.Run(flags, rest) => {
      return run(options(flags), rest);
    }
  }
  return 0;
}
