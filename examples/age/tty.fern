// The terminal of age: prompts for passphrases with no echo, and messages
// that only the user at the terminal sees. A port of age's tui.go and of
// golang.org/x/term's ReadPassword on Linux.
import "std/array";
import "./text";

// The Linux termios flags that ReadPassword changes.
const ECHO: i64 = 8;

const ICANON: i64 = 2;

const ISIG: i64 = 1;

const ICRNL: i64 = 256;

// The input and the output of the terminal.
struct Terminal { input: Reader, output: Writer, own_input: boolean }

// age's withTerminal: /dev/tty, or the standard input when it is a terminal.
function terminal(): Result[Terminal, string] {
  match (open_reader("/dev/tty")) {
    Ok(r) => {
      return match (open_writer("/dev/tty")) {
        Ok(w) => Ok(Terminal { input: r, output: w, own_input: true }),
        Err(e) => Err("open /dev/tty: " + text.errno_text(e)),
      };
    },
    Err(e) => {
      if (stdin().isatty()) {
        return match (open_writer("/dev/stdin")) {
          Ok(w) => Ok(Terminal { input: stdin(), output: w, own_input: false }),
          Err(f) => Err("open /dev/stdin: " + text.errno_text(f)),
        };
      }
      return Err("standard input is not a terminal, and /dev/tty is not available: open /dev/tty: " + text.errno_text(e));
    }
  }
}

function close(own t: Terminal): void {
  t.output.close();
  if (t.own_input) {
    t.input.close();
  }
}

// x/term's readPasswordLine: one byte at a time up to "\n". A backspace
// removes the byte before it, and "\r" is dropped.
function password_line(r: Reader): Result[u8[], string] {
  let out: u8[] = [];
  loop {
    let b = match (r.read_chunk_bytes(1)) {
      Ok(b) => b,
      Err(e) => {
        return Err(text.errno_text(e));
      },
    };
    // x/term reads with read(2), which gives no error at the end of a
    // line that the user ends with Ctrl-D: it reads again.
    if (b.len() == 0) {
      continue;
    }
    let c = b[0];
    if (c == b'\n') {
      return Ok(out);
    }
    if (c == 8u8) {
      if (out.len() > 0) {
        out = array.slice(out, 0, out.len() - 1);
      }
    } else if (c != b'\r') {
      out = out.append(c);
    }
  }
  return Ok(out);
}

// x/term's ReadPassword: the terminal echoes nothing while the user types.
function read_password(r: Reader): Result[u8[], string] {
  let saved = match (r.termios_get()) {
    Ok(t) => t,
    Err(e) => {
      return Err(text.errno_text(e));
    },
  };
  let quiet = saved.with(3, saved[3] & ~ECHO | ICANON | ISIG).with(0, saved[0] | ICRNL);
  if let Err(e) = r.termios_set(0, quiet) {
    return Err(text.errno_text(e));
  }
  let line = password_line(r);
  r.termios_set(0, saved);
  return line;
}

// age's clearLine: a new line, then an escape sequence that erases it.
const CLEAR_LINE: string = "\r\n\x1b[F\x1b[K";

// age's printPrompt: a control character in the prompt shows as U+FFFD.
function prompt_text(prompt: string): string {
  return text.without_controls(prompt.as_bytes()) + " ";
}

// age's readSecret: the prompt, then a line with no echo.
pub function read_secret(prompt: string): Result[u8[], string] {
  let t = terminal()?;
  t.output.write(prompt_text(prompt));
  let s = read_password(t.input);
  t.output.write(CLEAR_LINE);
  close(t);
  return s;
}

// The Linux termios flags that x/term's MakeRaw clears and sets.
const RAW_IFLAG: i64 = 1 | 2 | 8 | 0x20 | 0x40 | 0x80 | 0x100 | 0x400;

const OPOST: i64 = 1;

const RAW_LFLAG: i64 = 1 | 2 | 8 | 0x40 | 0x8000;

const CSIZE_PARENB: i64 = 0x30 | 0x100;

const CS8: i64 = 0x30;

// The indexes of VTIME and VMIN in the termios array of Linux.
const VTIME_AT: i32 = 10;

const VMIN_AT: i32 = 11;

// x/term's MakeRaw: no echo, no line discipline, no signals and 8-bit
// bytes, one byte at a time.
function make_raw(r: Reader): Result[i64[], string] {
  let saved = match (r.termios_get()) {
    Ok(t) => t,
    Err(e) => {
      return Err(text.errno_text(e));
    },
  };
  let raw = saved.with(0, saved[0] & ~RAW_IFLAG).with(1, saved[1] & ~OPOST).with(3, saved[3] & ~RAW_LFLAG);
  raw = raw.with(2, raw[2] & ~CSIZE_PARENB | CS8).with(VMIN_AT, 1i64).with(VTIME_AT, 0i64);
  if let Err(e) = r.termios_set(0, raw) {
    return Err(text.errno_text(e));
  }
  return Ok(saved);
}

// One byte from the terminal. read(2) on a terminal in raw mode waits for a
// byte.
function read_byte(r: Reader): Result[u8, string] {
  loop {
    let b = match (r.read_chunk_bytes(1)) {
      Ok(b) => b,
      Err(e) => {
        return Err(text.errno_text(e));
      },
    };
    if (b.len() == 1) {
      return Ok(b[0]);
    }
    return Err("EOF");
  }
  return Err("EOF");
}

// The line editor of x/term's Terminal.ReadLine for the keys of a simple
// line: each printable byte shows as the user types it, Backspace erases
// the last byte, and Enter ends the line. Ctrl-C, and Ctrl-D on an empty
// line, end the input.
function edit_line(r: Reader, w: Writer): Result[u8[], string] {
  let line: u8[] = [];
  loop {
    let c = read_byte(r)?;
    if (c == b'\r' || c == b'\n') {
      w.write("\r\n");
      return Ok(line);
    }
    if (c == 3u8 || c == 4u8 && line.len() == 0) {
      return Err("EOF");
    }
    if (c == 127u8 || c == 8u8) {
      if (line.len() > 0) {
        line = array.slice(line, 0, line.len() - 1);
        w.write("\x1b[D \x1b[D");
      }
    } else if (c >= 32u8) {
      line = line.append(c);
      w.write_bytes([c]);
    }
  }
  return Ok(line);
}

// age's term.ReadPublic: the prompt, then a line that the terminal shows.
pub function read_public(prompt: string): Result[u8[], string] {
  let t = terminal()?;
  t.output.write(prompt_text(prompt));
  let line = match (make_raw(t.input)) {
    Ok(saved) => {
      let l = edit_line(t.input, t.output);
      t.input.termios_set(0, saved);
      l
    },
    Err(why) => Err(why),
  };
  t.output.write(CLEAR_LINE);
  close(t);
  return line;
}

// age's term.ReadCharacter: the prompt, then one byte in raw mode.
pub function read_character(prompt: string): Result[u8, string] {
  let t = terminal()?;
  t.output.write(prompt_text(prompt));
  let c = match (make_raw(t.input)) {
    Ok(saved) => {
      let b = read_byte(t.input);
      t.input.termios_set(0, saved);
      b
    },
    Err(why) => Err(why),
  };
  t.output.write(CLEAR_LINE);
  close(t);
  return c;
}

// age's printfToTerminal.
pub function tell(msg: string): Option[string] {
  let t = match (terminal()) {
    Ok(t) => t,
    Err(why) => {
      return Some(why);
    },
  };
  let wrote = t.output.write("age: " + msg + "\n");
  close(t);
  return match (wrote) {
    Ok(_) => None,
    Err(e) => Some("write /dev/tty: " + text.errno_text(e)),
  };
}
