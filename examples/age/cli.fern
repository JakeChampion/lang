// The command line of age: Go's flag package rules, and the checks that age
// 1.3.2 makes before it reads any input.
import "std/array";
import "std/option";
import "./goflag";
import "./text";

pub const USAGE: string[] = [
  "Usage:",
  "    age [--encrypt] (-r RECIPIENT | -R PATH)... [--armor] [-o OUTPUT] [INPUT]",
  "    age [--encrypt] --passphrase [--armor] [-o OUTPUT] [INPUT]",
  "    age --decrypt [-i PATH]... [-o OUTPUT] [INPUT]",
  "",
  "Options:",
  "    -e, --encrypt               Encrypt the input to the output. This is the default.",
  "    -d, --decrypt               Decrypt the input to the output.",
  "    -o, --output OUTPUT         Write the result to the file at path OUTPUT.",
  "    -a, --armor                 Encrypt to the PEM-like ASCII armor.",
  "    -p, --passphrase            Encrypt with a passphrase.",
  "    -r, --recipient RECIPIENT   Encrypt to RECIPIENT. Can be repeated.",
  "    -R, --recipients-file PATH  Encrypt to the recipients in the file at PATH. Can be repeated.",
  "    -i, --identity PATH         Use the identity file at PATH. Can be repeated.",
  "",
  "INPUT is the standard input when it is missing or \"-\". OUTPUT is the",
  "standard output when it is missing or \"-\". This port writes OUTPUT only when",
  "all of the input decrypts: a file that does not decrypt leaves OUTPUT as it was.",
  "",
  "RECIPIENT is an age public key (\"age1...\") from age-keygen, or an SSH public",
  "key (\"ssh-ed25519 AAAA...\" or \"ssh-rsa AAAA...\").",
  "",
  "A recipients file holds one or more recipients, one for each line. An",
  "identity file holds one or more secret keys (\"AGE-SECRET-KEY-1...\"), one",
  "for each line, or an SSH private key. In both files, empty lines and lines",
  "that start with \"#\" are comments. An age file that a passphrase encrypts",
  "can be an identity file. \"-\" reads the file from the standard input.",
  "",
  "With -e, -i also encrypts to the keys of an identity file.",
];

pub struct Opts {
  encrypt: boolean,
  decrypt: boolean,
  passphrase: boolean,
  armor: boolean,
  version: boolean,
  output: string,
  recipients: string[],
  recipient_files: string[],
  identities: string[],
  plugins: string[],
  // The values of -i and -j in the order of the command line.
  id_flags: IdFlag[],
  inputs: string[],
}

// A value of -i, or of -j when plugin is true.
pub struct IdFlag { plugin: boolean, value: string }

// The result of the flags: the options, a request for the usage, or Go's
// message for a bad flag (exit 2).
pub enum Parsed {
  Run(Opts),
  Help,
  Bad(string),
}

const NAMES: goflag.Names = goflag.Names {
  bools: ["e", "encrypt", "d", "decrypt", "p", "passphrase", "a", "armor", "version"],
  values: ["o", "output", "r", "recipient", "R", "recipients-file", "i", "identity", "j"],
};

function set_bool(o: Opts, name: string, v: boolean): Opts {
  return match (name) {
    "e" | "encrypt" => Opts { ...o, encrypt: v },
    "d" | "decrypt" => Opts { ...o, decrypt: v },
    "p" | "passphrase" => Opts { ...o, passphrase: v },
    "a" | "armor" => Opts { ...o, armor: v },
    _ => Opts { ...o, version: v },
  };
}

function set_value(o: Opts, name: string, v: string): Opts {
  return match (name) {
    "o" | "output" => Opts { ...o, output: v },
    "r" | "recipient" => Opts { ...o, recipients: o.recipients.append(v) },
    "R" | "recipients-file" => Opts { ...o, recipient_files: o.recipient_files.append(v) },
    "i" | "identity" => Opts { ...o, identities: o.identities.append(v), id_flags: o.id_flags.append(IdFlag { plugin: false, value: v }) },
    _ => Opts { ...o, plugins: o.plugins.append(v), id_flags: o.id_flags.append(IdFlag { plugin: true, value: v }) },
  };
}

// Go's flag.Parse over the arguments after the program name, with age's
// flags.
pub function parse(args: string[]): Parsed {
  return match (goflag.parse(NAMES, args)) {
    goflag.Help => Help,
    goflag.Bad(why) => Bad(why),
    goflag.Run(flags, rest) => {
      let o = Opts { encrypt: false, decrypt: false, passphrase: false, armor: false, version: false, output: "", recipients: [], recipient_files: [], identities: [], plugins: [], id_flags: [], inputs: rest };
      for f in flags {
        o = match (f) {
          goflag.BoolFlag(name, v) => set_bool(o, name, v),
          goflag.ValueFlag(name, v) => set_value(o, name, v),
        };
      }
      Run(o)
    },
  };
}

// A failure that age reports with "age: error: " and its hints.
pub struct Fatal { msg: string, hints: string[] }

pub function fatal(msg: string): Fatal {
  return Fatal { msg: msg, hints: [] };
}

function hinted(msg: string, hints: string[]): Option[Fatal] {
  return Some(Fatal { msg: msg, hints: hints });
}

const SHELL_PUNCTUATION: string = "_@%+=:,./-";

function alnum(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9';
}

// An argument that a POSIX shell takes as it is: age's [\w@%+=:,./-]*.
function shell_safe(s: string): boolean {
  for i in 0..s.len() {
    if (!alnum(s[i]) && SHELL_PUNCTUATION.index_of(s[i:i + 1].unwrap_or("")).is_none()) {
      return false;
    }
  }
  return true;
}

// age's message for two or more INPUT arguments. argv has the program name.
function too_many(argv: string[], inputs: string[]): Fatal {
  let quoted: string[] = [];
  for a in inputs {
    quoted = quoted.append(text.quote(a.as_bytes()));
  }
  let msg = "too many INPUT arguments: " + quoted.join(" ");
  if (!inputs[1].starts_with("-")) {
    return Fatal { msg: msg, hints: ["only a single input file may be specified at a time"] };
  }
  let hints = ["the input file must be specified after all flags"];
  for a in argv {
    if (!shell_safe(a)) {
      return Fatal { msg: msg, hints: hints };
    }
  }
  let at = argv.len() - inputs.len();
  let moved = array.slice(argv, 0, at).concat(array.slice(argv, at + 1, argv.len())).append(argv[at]);
  return Fatal { msg: msg, hints: hints.append("did you mean:").append("    " + moved.join(" ")) };
}

function decrypt_conflict(o: Opts): Option[Fatal] {
  if (o.encrypt) {
    return Some(fatal("-e/--encrypt can't be used with -d/--decrypt"));
  }
  if (o.armor) {
    return hinted("-a/--armor can't be used with -d/--decrypt", ["note that armored files are detected automatically, try again without -a/--armor"]);
  }
  if (o.passphrase) {
    return hinted("-p/--passphrase can't be used with -d/--decrypt", ["note that password protected files are detected automatically"]);
  }
  if (o.recipients.len() > 0) {
    return hinted("-r/--recipient can't be used with -d/--decrypt", ["did you mean to use -i/--identity to specify a private key?"]);
  }
  if (o.recipient_files.len() > 0) {
    return hinted("-R/--recipients-file can't be used with -d/--decrypt", ["did you mean to use -i/--identity to specify a private key?"]);
  }
  return None;
}

function passphrase_conflict(o: Opts, ids: i32): Option[Fatal] {
  if (o.recipients.len() > 0) {
    return Some(fatal("-p/--passphrase can't be combined with -r/--recipient"));
  }
  if (o.recipient_files.len() > 0) {
    return Some(fatal("-p/--passphrase can't be combined with -R/--recipients-file"));
  }
  if (ids > 0) {
    return Some(fatal("-p/--passphrase can't be combined with -i/--identity and -j"));
  }
  return None;
}

function encrypt_conflict(o: Opts): Option[Fatal] {
  let ids = o.identities.len() + o.plugins.len();
  if (ids > 0 && !o.encrypt) {
    return hinted("-i/--identity and -j can't be used in encryption mode unless symmetric encryption is explicitly selected with -e/--encrypt", ["did you forget to specify -d/--decrypt?"]);
  }
  if (o.recipients.len() + o.recipient_files.len() + ids == 0 && !o.passphrase) {
    return hinted("missing recipients", ["did you forget to specify -r/--recipient, -R/--recipients-file or -p/--passphrase?"]);
  }
  if (o.passphrase) {
    return passphrase_conflict(o, ids);
  }
  return None;
}

// The checks that age makes after the flags, in its order.
pub function check(argv: string[], o: Opts): Option[Fatal] {
  if (o.inputs.len() > 1) {
    return Some(too_many(argv, o.inputs));
  }
  if (o.decrypt) {
    return decrypt_conflict(o);
  }
  return encrypt_conflict(o);
}
