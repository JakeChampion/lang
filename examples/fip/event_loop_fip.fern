import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";

fip function max_entries(): i32 {
  return 256;
}

fip function queue_cap(): i32 {
  return 64;
}

fip function out_cap(): i32 {
  return 64;
}

fip function idx_q_head(): i32 {
  return 0;
}

fip function idx_q_count(): i32 {
  return 1;
}

fip function idx_out_count(): i32 {
  return 2;
}

fip function idx_live(): i32 {
  return 3;
}

fip function idx_m_ok(): i32 {
  return 4;
}

fip function idx_m_miss(): i32 {
  return 5;
}

fip function idx_m_full(): i32 {
  return 6;
}

fip function idx_m_dropped(): i32 {
  return 7;
}

fip function q_base(): i32 {
  return 8;
}

fip function q_words(): i32 {
  return queue_cap() * 3;
}

fip function out_base(): i32 {
  return q_base() + q_words();
}

fip function key_base(): i32 {
  return out_base() + out_cap();
}

fip function val_base(): i32 {
  return key_base() + max_entries();
}

fip function used_base(): i32 {
  return val_base() + max_entries();
}

fip function state_words(): i32 {
  return used_base() + max_entries();
}

fip function ev_create(): i64 {
  return 1 as i64;
}

fip function ev_update(): i64 {
  return 2 as i64;
}

fip function ev_read(): i64 {
  return 3 as i64;
}

fip function ev_delete(): i64 {
  return 4 as i64;
}

fip function rsp_ok(): i64 {
  return 1 as i64;
}

fip function rsp_missing(): i64 {
  return 2 as i64;
}

fip function rsp_full(): i64 {
  return 3 as i64;
}

fip function rsp_value(): i64 {
  return 4 as i64;
}

function new_state(): i64[] {
  let s: i64[] = [];
  let i: i32 = 0;
  while (i < state_words()) {
    s = s.append(0 as i64);
    i = i + 1;
  }
  return s;
}

fip function enqueue(own s: i64[], kind: i64, id: i64, value: i64): i64[] {
  let count: i32 = s[idx_q_count()] as i32;
  if (count >= queue_cap()) {
    return s.with(idx_m_dropped(), s[idx_m_dropped()] + 1 as i64);
  }
  let head: i32 = s[idx_q_head()] as i32;
  let slot: i32 = (head + count) % queue_cap();
  let at: i32 = q_base() + slot * 3;
  s = s.with(at, kind);
  s = s.with(at + 1, id);
  s = s.with(at + 2, value);
  return s.with(idx_q_count(), (count + 1) as i64);
}

fip function respond(own s: i64[], code: i64): i64[] {
  let n: i32 = s[idx_out_count()] as i32;
  if (n >= out_cap()) {
    return s.with(idx_m_dropped(), s[idx_m_dropped()] + 1 as i64);
  }
  s = s.with(out_base() + n, code);
  return s.with(idx_out_count(), (n + 1) as i64);
}

fip function find_slot(s: i64[], id: i64): i32 {
  let i: i32 = 0;
  while (i < max_entries()) {
    if (s[used_base() + i] != 0 as i64 && s[key_base() + i] == id) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

fip function free_slot(s: i64[]): i32 {
  let i: i32 = 0;
  while (i < max_entries()) {
    if (s[used_base() + i] == 0 as i64) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

fip function apply_create(own s: i64[], id: i64, value: i64): i64[] {
  let at: i32 = find_slot(s, id);
  if (at >= 0) {
    s = s.with(val_base() + at, value);
    s = s.with(idx_m_ok(), s[idx_m_ok()] + 1 as i64);
    return respond(s, rsp_ok());
  }
  let slot: i32 = free_slot(s);
  if (slot < 0) {
    s = s.with(idx_m_full(), s[idx_m_full()] + 1 as i64);
    return respond(s, rsp_full());
  }
  s = s.with(key_base() + slot, id);
  s = s.with(val_base() + slot, value);
  s = s.with(used_base() + slot, 1 as i64);
  s = s.with(idx_live(), s[idx_live()] + 1 as i64);
  s = s.with(idx_m_ok(), s[idx_m_ok()] + 1 as i64);
  return respond(s, rsp_ok());
}

fip function apply_update(own s: i64[], id: i64, delta: i64): i64[] {
  let at: i32 = find_slot(s, id);
  if (at < 0) {
    s = s.with(idx_m_miss(), s[idx_m_miss()] + 1 as i64);
    return respond(s, rsp_missing());
  }
  s = s.with(val_base() + at, s[val_base() + at] + delta);
  s = s.with(idx_m_ok(), s[idx_m_ok()] + 1 as i64);
  return respond(s, rsp_ok());
}

fip function apply_read(own s: i64[], id: i64): i64[] {
  let at: i32 = find_slot(s, id);
  if (at < 0) {
    s = s.with(idx_m_miss(), s[idx_m_miss()] + 1 as i64);
    return respond(s, rsp_missing());
  }
  s = s.with(idx_m_ok(), s[idx_m_ok()] + 1 as i64);
  return respond(s, rsp_value());
}

fip function apply_delete(own s: i64[], id: i64): i64[] {
  let at: i32 = find_slot(s, id);
  if (at < 0) {
    s = s.with(idx_m_miss(), s[idx_m_miss()] + 1 as i64);
    return respond(s, rsp_missing());
  }
  s = s.with(used_base() + at, 0 as i64);
  s = s.with(idx_live(), s[idx_live()] - 1 as i64);
  s = s.with(idx_m_ok(), s[idx_m_ok()] + 1 as i64);
  return respond(s, rsp_ok());
}

fip function iteration(own s: i64[]): i64[] {
  let count: i32 = s[idx_q_count()] as i32;
  if (count == 0) {
    return s;
  }
  let head: i32 = s[idx_q_head()] as i32;
  let at: i32 = q_base() + head * 3;
  let kind: i64 = s[at];
  let id: i64 = s[at + 1];
  let value: i64 = s[at + 2];
  s = s.with(idx_q_head(), ((head + 1) % queue_cap()) as i64);
  s = s.with(idx_q_count(), (count - 1) as i64);
  if (kind == ev_create()) {
    return apply_create(s, id, value);
  }
  if (kind == ev_update()) {
    return apply_update(s, id, value);
  }
  if (kind == ev_read()) {
    return apply_read(s, id);
  }
  if (kind == ev_delete()) {
    return apply_delete(s, id);
  }
  return s;
}

fip function drain_output(own s: i64[]): i64[] {
  return s.with(idx_out_count(), 0 as i64);
}

fip function event_id(n: i64): i64 {
  let x: i64 = n * (2654435761 as i64);
  x = x ^ x >> 15 as i64;
  x = x * (2246822519 as i64);
  x = x ^ x >> 13 as i64;
  if (x < 0 as i64) {
    x = 0 - x;
  }
  return x % (max_entries() as i64);
}

fip function event_kind(n: i64): i64 {
  let bucket: i64 = n % (10 as i64);
  if (bucket == 0 as i64) {
    return ev_create();
  }
  if (bucket == 1 as i64) {
    return ev_delete();
  }
  if (bucket < 4 as i64) {
    return ev_update();
  }
  return ev_read();
}

fip function prefill(own s: i64[]): i64[] {
  let id: i32 = 0;
  while (id < max_entries()) {
    s = apply_create(s, id as i64, id as i64 * (10 as i64));
    id = id + 1;
  }
  return drain_output(s);
}

fip function reset_metrics(own s: i64[]): i64[] {
  s = s.with(idx_m_ok(), 0 as i64);
  s = s.with(idx_m_miss(), 0 as i64);
  s = s.with(idx_m_full(), 0 as i64);
  return s.with(idx_m_dropped(), 0 as i64);
}

fip function round(own s: i64[], seed: i64, batch: i32): i64[] {
  let i: i32 = 0;
  while (i < batch) {
    let n: i64 = seed + i as i64;
    s = enqueue(s, event_kind(n), event_id(n), n);
    i = i + 1;
  }
  let worked: i32 = 0;
  while (worked < batch) {
    s = iteration(s);
    worked = worked + 1;
  }
  return drain_output(s);
}

function main(): i32 {
  let s: i64[] = new_state();
  s = prefill(s);
  s = round(s, 1 as i64, queue_cap());
  s = reset_metrics(s);
  let rounds: i32 = 20000;
  let samples: i64[] = [];
  let p: i32 = 0;
  while (p < rounds) {
    samples = samples.append(0 as i64);
    p = p + 1;
  }
  let at_allocs: i64 = bench.alloc_count();
  let at_fresh: i64 = bench.bump_bytes();
  let started_ns: i64 = monotonic_ns();
  let r: i32 = 0;
  while (r < rounds) {
    let t0: i64 = monotonic_ns();
    s = round(s, r as i64 * (7 as i64) + 1 as i64, queue_cap());
    samples = samples.with(r, monotonic_ns() - t0);
    r = r + 1;
  }
  let elapsed_ns: i64 = monotonic_ns() - started_ns;
  let allocs: i64 = bench.allocs_after(at_allocs);
  let fresh: i64 = bench.fresh_bytes_after(at_fresh);
  let events: i64 = rounds as i64 * (queue_cap() as i64);
  let rep: bench.Report = bench.Report {
    name: "fip",
    iterations: rounds,
    wall_ns: elapsed_ns,
    samples_ns: cmp.sort(samples),
    allocs: allocs,
    fresh_bytes: fresh,
  };
  print("{\"variant\":\"fip\""
    + ",\"events\":" + events.to_string()
    + ",\"events_per_round\":" + queue_cap().to_string()
    + ",\"live_entries\":" + s[idx_live()].to_string()
    + ",\"ok\":" + s[idx_m_ok()].to_string()
    + ",\"missing\":" + s[idx_m_miss()].to_string()
    + ",\"table_full\":" + s[idx_m_full()].to_string()
    + ",\"dropped\":" + s[idx_m_dropped()].to_string()
    + ",\"steady_allocs\":" + allocs.to_string()
    + ",\"steady_fresh_bytes\":" + fresh.to_string()
    + ",\"allocs_per_event_milli\":" + (allocs * (1000 as i64) / events).to_string()
    + ",\"ns_per_event\":" + (elapsed_ns / events).to_string()
    + ",\"events_per_sec\":" + (events * 1000000000i64 / elapsed_ns).to_string()
    + ",\"round_p50_ns\":" + rep.p50_ns().to_string()
    + ",\"round_p95_ns\":" + rep.p95_ns().to_string()
    + ",\"round_p99_ns\":" + rep.p99_ns().to_string()
    + ",\"round_p999_ns\":" + rep.p999_ns().to_string()
    + ",\"round_max_ns\":" + rep.max_ns().to_string()
    + "}");
  return 0;
}
