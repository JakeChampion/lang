// examples/fip/packet_borrowed.fern — the sliced-parse variant of the bounded
// packet codec (#9584).
//
// Same protocol, same workload and the same answers as the other three. The
// one change from the baseline is that a parse no longer copies: a `Request`
// carries the OFFSET and LENGTH of its payload inside the wire buffer, and
// every read goes back to that buffer. Nothing is annotated and nothing is
// owned — this is still ordinary Fern.
//
// It is the middle rung, and the interesting one. It removes the copy a reader
// would notice first while keeping the two allocations a reader would not: the
// transform still builds a fresh array and the encode still builds another. So
// it says how much of the baseline's cost was the payload copy and how much was
// everything else, which is the question "just take a slice" always raises.
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";

// ===================== THE PROTOCOL =====================
//
// A 16-byte fixed header and a bounded payload, so a whole packet fits in 256
// bytes and every buffer in every variant can be sized once, up front.
//
//   0..1   magic 0xFE 0x52
//   2      version
//   3      message type
//   4      status (0 on a request)
//   5      reserved
//   6..9   request id, u32 little-endian
//   10..11 payload length, u16 little-endian
//   12..13 Fletcher-16 of the payload
//   14..15 reserved
function header_len(): i32 { return 16; }
function max_payload(): i32 { return 240; }
function max_packet(): i32 { return 256; }
function magic0(): i32 { return 254; }
function magic1(): i32 { return 82; }
function version(): i32 { return 1; }

function msg_echo(): i32 { return 1; }
function msg_sum(): i32 { return 2; }
function msg_reverse(): i32 { return 3; }
function msg_upper(): i32 { return 4; }

function st_ok(): i32 { return 0; }
function st_bad_magic(): i32 { return 1; }
function st_bad_version(): i32 { return 2; }
function st_bad_type(): i32 { return 3; }
function st_oversize(): i32 { return 4; }
function st_truncated(): i32 { return 5; }
function st_bad_checksum(): i32 { return 6; }

// Fletcher-16: two running sums mod 255, which catches byte transposition
// where a plain sum does not. Cheap enough that it is not what any variant's
// throughput is measuring.
function checksum(bytes: u8[], from: i32, n: i32): i32 {
    var a: i32 = 0;
    var b: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        a = (a + (bytes[from + i] as i32)) % 255;
        b = (b + a) % 255;
        i = i + 1;
    }
    return b * 256 + a;
}

// ===================== THE PARSE (no copy) =====================
//
// The payload stays in the wire buffer; the request names where it is. The
// record is four scalars, so constructing one allocates nothing — but it is
// only valid while that buffer holds this request, which is the discipline a
// slice asks of its caller and the compiler is not being asked to check here.
struct Request {
    status: i32,
    msg_type: i32,
    req_id: i64,
    at: i32,
    len: i32,
}

function read_u16(bytes: u8[], at: i32): i32 {
    return (bytes[at] as i32) + (bytes[at + 1] as i32) * 256;
}

function read_u32(bytes: u8[], at: i32): i64 {
    return (bytes[at] as i64)
        + (bytes[at + 1] as i64) * (256 as i64)
        + (bytes[at + 2] as i64) * (65536 as i64)
        + (bytes[at + 3] as i64) * (16777216 as i64);
}

function known_type(t: i32): boolean {
    return t == msg_echo() || t == msg_sum() || t == msg_reverse() || t == msg_upper();
}

// The validation ladder, in the order a receiver can actually apply it: the
// framing first, because a bad length makes every later read a guess.
function parse(wire: u8[], wire_len: i32): Request {
    if (wire_len < header_len()) {
        return Request { status: st_truncated(), msg_type: 0, req_id: 0 as i64, at: 0, len: 0 };
    }
    if ((wire[0] as i32) != magic0() || (wire[1] as i32) != magic1()) {
        return Request { status: st_bad_magic(), msg_type: 0, req_id: 0 as i64, at: 0, len: 0 };
    }
    if ((wire[2] as i32) != version()) {
        return Request { status: st_bad_version(), msg_type: 0, req_id: 0 as i64, at: 0, len: 0 };
    }
    var t: i32 = wire[3] as i32;
    var id: i64 = read_u32(wire, 6);
    var plen: i32 = read_u16(wire, 10);
    if (plen > max_payload()) {
        return Request { status: st_oversize(), msg_type: t, req_id: id, at: 0, len: 0 };
    }
    if (wire_len < header_len() + plen) {
        return Request { status: st_truncated(), msg_type: t, req_id: id, at: 0, len: 0 };
    }
    if (checksum(wire, header_len(), plen) != read_u16(wire, 12)) {
        return Request { status: st_bad_checksum(), msg_type: t, req_id: id, at: 0, len: 0 };
    }
    if (!known_type(t)) {
        return Request { status: st_bad_type(), msg_type: t, req_id: id, at: 0, len: 0 };
    }
    // No copy: the payload is already in the buffer, at a known place.
    return Request { status: st_ok(), msg_type: t, req_id: id, at: header_len(), len: plen };
}

// ===================== THE TRANSFORM (allocating) =====================
//
// Four shapes, chosen so the copying differs between them: echo and reverse
// move the whole payload, upper moves it and rewrites some of it, sum reduces
// it to eight bytes.
function transform(wire: u8[], req: Request): u8[] {
    var out: u8[] = [];
    var n: i32 = req.len;
    if (req.msg_type == msg_echo()) {
        var i: i32 = 0;
        while (i < n) { out = out.append(wire[req.at + i]); i = i + 1; }
        return out;
    }
    if (req.msg_type == msg_reverse()) {
        var j: i32 = n - 1;
        while (j >= 0) { out = out.append(wire[req.at + j]); j = j - 1; }
        return out;
    }
    if (req.msg_type == msg_upper()) {
        var k: i32 = 0;
        while (k < n) {
            var c: i32 = wire[req.at + k] as i32;
            if (c >= 97 && c <= 122) { c = c - 32; }
            out = out.append(c as u8);
            k = k + 1;
        }
        return out;
    }
    // sum: eight little-endian bytes of the payload's byte sum.
    var total: i64 = 0 as i64;
    var s: i32 = 0;
    while (s < n) { total = total + (wire[req.at + s] as i64); s = s + 1; }
    var b: i32 = 0;
    while (b < 8) {
        out = out.append(((total / pow256(b)) % (256 as i64)) as u8);
        b = b + 1;
    }
    return out;
}

function pow256(k: i32): i64 {
    var p: i64 = 1 as i64;
    var i: i32 = 0;
    while (i < k) { p = p * (256 as i64); i = i + 1; }
    return p;
}

// ===================== THE ENCODE (allocating) =====================

function encode(req: Request, body: u8[]): u8[] {
    var out: u8[] = [];
    var plen: i32 = body.len();
    var ck: i32 = checksum(body, 0, plen);
    out = out.append(magic0() as u8);
    out = out.append(magic1() as u8);
    out = out.append(version() as u8);
    out = out.append(req.msg_type as u8);
    out = out.append(req.status as u8);
    out = out.append(0 as u8);
    var idb: i32 = 0;
    while (idb < 4) {
        out = out.append(((req.req_id / pow256(idb)) % (256 as i64)) as u8);
        idb = idb + 1;
    }
    out = out.append((plen % 256) as u8);
    out = out.append((plen / 256) as u8);
    out = out.append((ck % 256) as u8);
    out = out.append((ck / 256) as u8);
    out = out.append(0 as u8);
    out = out.append(0 as u8);
    var i: i32 = 0;
    while (i < plen) { out = out.append(body[i]); i = i + 1; }
    return out;
}

// ===================== THE WORKLOAD =====================
//
// Identical in all four variants, verbatim, so the runs differ in how the
// bytes are held and in nothing else. Every 17th request is malformed, cycling
// through the six rejections, so the error ladder is exercised in the steady
// state rather than in a separate test that proves nothing about throughput.

function gen_payload_len(n: i64): i32 {
    return ((n * (37 as i64)) % (241 as i64)) as i32;
}

function gen_byte(n: i64, j: i32): u8 {
    return (((n + (j as i64)) % (251 as i64)) as i32) as u8;
}

function corruption(n: i64): i32 {
    if (n % (17 as i64) != (0 as i64)) { return 0 - 1; }
    return ((n / (17 as i64)) % (6 as i64)) as i32;
}

// Writes one request into the buffer it is handed and gives it back. It takes
// the buffer `own` in every variant, including this one: generating the input
// is the harness, not the codec, and a borrowed `wire` would copy all 256
// bytes on each `.with` — charging every variant for the instrument.
function build_request(own wire: u8[], n: i64): u8[] {
    var t: i32 = 1 + ((n % (4 as i64)) as i32);
    var plen: i32 = gen_payload_len(n);
    var corrupt: i32 = corruption(n);
    var i: i32 = 0;
    while (i < plen) { wire = wire.with(header_len() + i, gen_byte(n, i)); i = i + 1; }
    var ck: i32 = checksum(wire, header_len(), plen);
    var m0: i32 = magic0();
    var ver: i32 = version();
    var wire_plen: i32 = plen;
    if (corrupt == 0) { m0 = 1; }
    if (corrupt == 1) { ver = 9; }
    if (corrupt == 2) { t = 77; }
    if (corrupt == 3) { wire_plen = max_payload() + 8; }
    if (corrupt == 5) { ck = ck ^ 1; }
    wire = wire.with(0, m0 as u8);
    wire = wire.with(1, magic1() as u8);
    wire = wire.with(2, ver as u8);
    wire = wire.with(3, t as u8);
    wire = wire.with(4, 0 as u8);
    wire = wire.with(5, 0 as u8);
    var idb: i32 = 0;
    while (idb < 4) {
        wire = wire.with(6 + idb, ((n / pow256(idb)) % (256 as i64)) as u8);
        idb = idb + 1;
    }
    wire = wire.with(10, (wire_plen % 256) as u8);
    wire = wire.with(11, (wire_plen / 256) as u8);
    wire = wire.with(12, (ck % 256) as u8);
    wire = wire.with(13, (ck / 256) as u8);
    wire = wire.with(14, 0 as u8);
    return wire.with(15, 0 as u8);
}

function wire_len_for(n: i64): i32 {
    var plen: i32 = gen_payload_len(n);
    if (corruption(n) == 4) { return header_len() + plen - 1; }
    return header_len() + plen;
}

// A running digest over every response byte. Four implementations of one codec
// agree only if this agrees, which is what makes the comparison a differential
// test rather than three unrelated benchmarks.
function mix(d: i64, b: i32): i64 {
    var x: i64 = d ^ (b as i64);
    x = x * (1099511628211 as i64);
    x = x ^ (x >> (29 as i64));
    if (x < (0 as i64)) { x = 0 - x; }
    return x % (1000000007 as i64);
}

struct Counts {
    ok: i64, bad_magic: i64, bad_version: i64, bad_type: i64,
    oversize: i64, truncated: i64, bad_checksum: i64,
    digest: i64, copied: i64,
}

function tally(c: Counts, status: i32): Counts {
    if (status == st_ok()) { return Counts { ...c, ok: c.ok + (1 as i64) }; }
    if (status == st_bad_magic()) { return Counts { ...c, bad_magic: c.bad_magic + (1 as i64) }; }
    if (status == st_bad_version()) { return Counts { ...c, bad_version: c.bad_version + (1 as i64) }; }
    if (status == st_bad_type()) { return Counts { ...c, bad_type: c.bad_type + (1 as i64) }; }
    if (status == st_oversize()) { return Counts { ...c, oversize: c.oversize + (1 as i64) }; }
    if (status == st_truncated()) { return Counts { ...c, truncated: c.truncated + (1 as i64) }; }
    return Counts { ...c, bad_checksum: c.bad_checksum + (1 as i64) };
}

function serve(wire: u8[], n: i64, c: Counts): Counts {
    var req: Request = parse(wire, wire_len_for(n));
    var body: u8[] = [];
    if (req.status == st_ok()) { body = transform(wire, req); }
    var resp: u8[] = encode(req, body);
    var d: i64 = c.digest;
    var i: i32 = 0;
    while (i < resp.len()) { d = mix(d, resp[i] as i32); i = i + 1; }
    // Bytes moved on this request: the transform's output and the encode's copy
    // of it into the response frame. The parse copy is the term that is gone.
    var moved: i64 = (body.len() as i64) + (resp.len() as i64);
    var out: Counts = tally(c, req.status);
    return Counts { ...out, digest: d, copied: out.copied + moved };
}

function zero_counts(): Counts {
    return Counts {
        ok: 0 as i64, bad_magic: 0 as i64, bad_version: 0 as i64, bad_type: 0 as i64,
        oversize: 0 as i64, truncated: 0 as i64, bad_checksum: 0 as i64,
        digest: 1469598103934665603 as i64, copied: 0 as i64,
    };
}

function zeros_u8(n: i32): u8[] {
    var xs: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) { xs = xs.with(i, 0 as u8); i = i + 1; }
    return xs;
}

function main(): i32 {
    var batch: i32 = 64;
    // 4000 rounds is 256,000 requests, which holds the per-request medians steady
    // while keeping this program the same weight as experiment 1's — it is run
    // under both backends, under qemu, by the SSA differential sweep over
    // examples/, and five times that was 5x the cost for no more signal.
    var rounds: i32 = 4000;
    var wire: u8[] = zeros_u8(max_packet());
    var c: Counts = zero_counts();
    // One warm round before the mark, so first-touch costs are not measured.
    var w: i32 = 0;
    while (w < batch) {
        wire = build_request(wire, w as i64);
        c = serve(wire, w as i64, c);
        w = w + 1;
    }
    c = zero_counts();
    var samples: i64[] = [];
    var p: i32 = 0;
    while (p < rounds) { samples = samples.append(0 as i64); p = p + 1; }
    var at_allocs: i64 = bench.alloc_count();
    var at_fresh: i64 = bench.bump_bytes();
    var started_ns: i64 = monotonic_ns();
    var r: i32 = 0;
    while (r < rounds) {
        var t0: i64 = monotonic_ns();
        var k: i32 = 0;
        while (k < batch) {
            var n: i64 = (r as i64) * (batch as i64) + (k as i64);
            wire = build_request(wire, n);
            c = serve(wire, n, c);
            k = k + 1;
        }
        samples = samples.with(r, monotonic_ns() - t0);
        r = r + 1;
    }
    var elapsed_ns: i64 = monotonic_ns() - started_ns;
    var allocs: i64 = bench.allocs_after(at_allocs);
    var fresh: i64 = bench.fresh_bytes_after(at_fresh);
    var requests: i64 = (rounds as i64) * (batch as i64);
    var rep: bench.Report = bench.Report {
        name: "borrowed",
        iterations: rounds,
        wall_ns: elapsed_ns,
        samples_ns: cmp.sort(samples),
        allocs: allocs,
        fresh_bytes: fresh,
    };
    print("{\"variant\":\"borrowed\""
        + ",\"requests\":" + requests.to_string()
        + ",\"requests_per_round\":" + batch.to_string()
        + ",\"ok\":" + c.ok.to_string()
        + ",\"bad_magic\":" + c.bad_magic.to_string()
        + ",\"bad_version\":" + c.bad_version.to_string()
        + ",\"bad_type\":" + c.bad_type.to_string()
        + ",\"oversize\":" + c.oversize.to_string()
        + ",\"truncated\":" + c.truncated.to_string()
        + ",\"bad_checksum\":" + c.bad_checksum.to_string()
        + ",\"digest\":" + c.digest.to_string()
        + ",\"bytes_copied\":" + c.copied.to_string()
        + ",\"bytes_copied_per_request\":" + (c.copied / requests).to_string()
        + ",\"steady_allocs\":" + allocs.to_string()
        + ",\"steady_fresh_bytes\":" + fresh.to_string()
        + ",\"allocs_per_request_milli\":" + (allocs * (1000 as i64) / requests).to_string()
        + ",\"ns_per_request\":" + (elapsed_ns / requests).to_string()
        + ",\"requests_per_sec\":" + (requests * 1000000000i64 / elapsed_ns).to_string()
        + ",\"round_p50_ns\":" + rep.p50_ns().to_string()
        + ",\"round_p95_ns\":" + rep.p95_ns().to_string()
        + ",\"round_p99_ns\":" + rep.p99_ns().to_string()
        + ",\"round_p999_ns\":" + rep.p999_ns().to_string()
        + ",\"round_max_ns\":" + rep.max_ns().to_string()
        + "}");
    return 0;
}
