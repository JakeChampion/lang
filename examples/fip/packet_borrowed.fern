import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";

function header_len(): i32 {
  return 16;
}

function max_payload(): i32 {
  return 240;
}

function max_packet(): i32 {
  return 256;
}

function magic0(): i32 {
  return 254;
}

function magic1(): i32 {
  return 82;
}

function version(): i32 {
  return 1;
}

function msg_echo(): i32 {
  return 1;
}

function msg_sum(): i32 {
  return 2;
}

function msg_reverse(): i32 {
  return 3;
}

function msg_upper(): i32 {
  return 4;
}

function st_ok(): i32 {
  return 0;
}

function st_bad_magic(): i32 {
  return 1;
}

function st_bad_version(): i32 {
  return 2;
}

function st_bad_type(): i32 {
  return 3;
}

function st_oversize(): i32 {
  return 4;
}

function st_truncated(): i32 {
  return 5;
}

function st_bad_checksum(): i32 {
  return 6;
}

function checksum(bytes: u8[], from: i32, n: i32): i32 {
  let a = 0;
  let b = 0;
  for i in 0..n {
    a = (a + bytes[from + i] as i32) % 255;
    b = (b + a) % 255;
  }
  return b * 256 + a;
}

struct Request {
  status: i32,
  msg_type: i32,
  req_id: i64,
  at: i32,
  len: i32,
}

function read_u16(bytes: u8[], at: i32): i32 {
  return bytes[at] as i32 + bytes[at + 1] as i32 * 256;
}

function read_u32(bytes: u8[], at: i32): i64 {
  return bytes[at] as i64
    + bytes[at + 1] as i64 * 256i64
    + bytes[at + 2] as i64 * 65536i64
    + bytes[at + 3] as i64 * 16777216i64;
}

function known_type(t: i32): boolean {
  return t == msg_echo() || t == msg_sum() || t == msg_reverse() || t == msg_upper();
}

function parse(wire: u8[], wire_len: i32): Request {
  if (wire_len < header_len()) {
    return Request { status: st_truncated(), msg_type: 0, req_id: 0i64, at: 0, len: 0 };
  }
  if (wire[0] as i32 != magic0() || wire[1] as i32 != magic1()) {
    return Request { status: st_bad_magic(), msg_type: 0, req_id: 0i64, at: 0, len: 0 };
  }
  if (wire[2] as i32 != version()) {
    return Request { status: st_bad_version(), msg_type: 0, req_id: 0i64, at: 0, len: 0 };
  }
  let t = wire[3] as i32;
  let id = read_u32(wire, 6);
  let plen = read_u16(wire, 10);
  if (plen > max_payload()) {
    return Request { status: st_oversize(), msg_type: t, req_id: id, at: 0, len: 0 };
  }
  if (wire_len < header_len() + plen) {
    return Request { status: st_truncated(), msg_type: t, req_id: id, at: 0, len: 0 };
  }
  if (checksum(wire, header_len(), plen) != read_u16(wire, 12)) {
    return Request { status: st_bad_checksum(), msg_type: t, req_id: id, at: 0, len: 0 };
  }
  if (!known_type(t)) {
    return Request { status: st_bad_type(), msg_type: t, req_id: id, at: 0, len: 0 };
  }
  return Request { status: st_ok(), msg_type: t, req_id: id, at: header_len(), len: plen };
}

function transform(wire: u8[], req: Request): u8[] {
  let out: u8[] = [];
  let n = req.len;
  if (req.msg_type == msg_echo()) {
    for i in 0..n {
      out = out.append(wire[req.at + i]);
    }
    return out;
  }
  if (req.msg_type == msg_reverse()) {
    let j = n - 1;
    while (j >= 0) {
      out = out.append(wire[req.at + j]);
      j -= 1;
    }
    return out;
  }
  if (req.msg_type == msg_upper()) {
    for k in 0..n {
      let c = wire[req.at + k];
      out = out.append(if (c >= b'a' && c <= b'z') { c - 32 } else { c });
    }
    return out;
  }
  let total = 0i64;
  for s in 0..n {
    total += wire[req.at + s] as i64;
  }
  for b in 0..8 {
    out = out.append((total / pow256(b) % 256i64) as u8);
  }
  return out;
}

function pow256(k: i32): i64 {
  let p = 1i64;
  for _ in 0..k {
    p *= 256i64;
  }
  return p;
}

function encode(req: Request, body: u8[]): u8[] {
  let out: u8[] = [];
  let plen = body.len();
  let ck = checksum(body, 0, plen);
  out = out.append(magic0() as u8);
  out = out.append(magic1() as u8);
  out = out.append(version() as u8);
  out = out.append(req.msg_type as u8);
  out = out.append(req.status as u8);
  out = out.append(0 as u8);
  for idb in 0..4 {
    out = out.append((req.req_id / pow256(idb) % 256i64) as u8);
  }
  out = out.append((plen % 256) as u8);
  out = out.append((plen / 256) as u8);
  out = out.append((ck % 256) as u8);
  out = out.append((ck / 256) as u8);
  out = out.append(0 as u8);
  out = out.append(0 as u8);
  for i in 0..plen {
    out = out.append(body[i]);
  }
  return out;
}

function gen_payload_len(n: i64): i32 {
  return (n * 37i64 % 241i64) as i32;
}

function gen_byte(n: i64, j: i32): u8 {
  return (((n + j as i64) % 251i64) as i32) as u8;
}

function corruption(n: i64): i32 {
  if (n % 17i64 != 0i64) {
    return -1;
  }
  return (n / 17i64 % 6i64) as i32;
}

function build_request(own wire: u8[], n: i64): u8[] {
  let t = 1 + (n % 4i64) as i32;
  let plen = gen_payload_len(n);
  let corrupt = corruption(n);
  for i in 0..plen {
    wire = wire.with(header_len() + i, gen_byte(n, i));
  }
  let ck = checksum(wire, header_len(), plen);
  let m0 = magic0();
  let ver = version();
  let wire_plen = plen;
  match (corrupt) {
    0 => {
      m0 = 1;
    },
    1 => {
      ver = 9;
    },
    2 => {
      t = 77;
    },
    3 => {
      wire_plen = max_payload() + 8;
    },
    5 => {
      ck ^= 1;
    },
    _ => {}
  }
  wire = wire.with(0, m0 as u8);
  wire = wire.with(1, magic1() as u8);
  wire = wire.with(2, ver as u8);
  wire = wire.with(3, t as u8);
  wire = wire.with(4, 0 as u8);
  wire = wire.with(5, 0 as u8);
  for idb in 0..4 {
    wire = wire.with(6 + idb, (n / pow256(idb) % 256i64) as u8);
  }
  wire = wire.with(10, (wire_plen % 256) as u8);
  wire = wire.with(11, (wire_plen / 256) as u8);
  wire = wire.with(12, (ck % 256) as u8);
  wire = wire.with(13, (ck / 256) as u8);
  wire = wire.with(14, 0 as u8);
  return wire.with(15, 0 as u8);
}

function wire_len_for(n: i64): i32 {
  let plen = gen_payload_len(n);
  if (corruption(n) == 4) {
    return header_len() + plen - 1;
  }
  return header_len() + plen;
}

function mix(d: i64, b: i32): i64 {
  let x = d ^ b as i64;
  x *= 1099511628211i64;
  x ^= x >> 29i64;
  if (x < 0i64) {
    x = -x;
  }
  return x % 1000000007i64;
}

struct Counts {
  ok: i64,
  bad_magic: i64,
  bad_version: i64,
  bad_type: i64,
  oversize: i64,
  truncated: i64,
  bad_checksum: i64,
  digest: i64,
  copied: i64,
}

function tally(c: Counts, status: i32): Counts {
  if (status == st_ok()) {
    return Counts { ...c, ok: c.ok + 1i64 };
  }
  if (status == st_bad_magic()) {
    return Counts { ...c, bad_magic: c.bad_magic + 1i64 };
  }
  if (status == st_bad_version()) {
    return Counts { ...c, bad_version: c.bad_version + 1i64 };
  }
  if (status == st_bad_type()) {
    return Counts { ...c, bad_type: c.bad_type + 1i64 };
  }
  if (status == st_oversize()) {
    return Counts { ...c, oversize: c.oversize + 1i64 };
  }
  if (status == st_truncated()) {
    return Counts { ...c, truncated: c.truncated + 1i64 };
  }
  return Counts { ...c, bad_checksum: c.bad_checksum + 1i64 };
}

function serve(wire: u8[], n: i64, c: Counts): Counts {
  let req = parse(wire, wire_len_for(n));
  let body: u8[] = [];
  if (req.status == st_ok()) {
    body = transform(wire, req);
  }
  let resp = encode(req, body);
  let d = c.digest;
  for b in resp {
    d = mix(d, b as i32);
  }
  let moved = body.len() as i64 + resp.len() as i64;
  let out = tally(c, req.status);
  return Counts { ...out, digest: d, copied: out.copied + moved };
}

function zero_counts(): Counts {
  return Counts {
    ok: 0i64, bad_magic: 0i64, bad_version: 0i64, bad_type: 0i64,
    oversize: 0i64, truncated: 0i64, bad_checksum: 0i64,
    digest: 1469598103934665603i64, copied: 0i64,
  };
}

function zeros_u8(n: i32): u8[] {
  let xs = __alloc_u8(n);
  for i in 0..n {
    xs = xs.with(i, 0 as u8);
  }
  return xs;
}

function main(): i32 {
  let batch = 64;
  let rounds = 4000;
  let wire = zeros_u8(max_packet());
  let c = zero_counts();
  for w in 0..batch {
    wire = build_request(wire, w as i64);
    c = serve(wire, w as i64, c);
  }
  c = zero_counts();
  let samples: i64[] = [];
  for _ in 0..rounds {
    samples = samples.append(0i64);
  }
  let at_allocs = bench.alloc_count();
  let at_fresh = bench.bump_bytes();
  let started_ns = monotonic_ns();
  for r in 0..rounds {
    let t0 = monotonic_ns();
    for k in 0..batch {
      let n = r as i64 * (batch as i64) + k as i64;
      wire = build_request(wire, n);
      c = serve(wire, n, c);
    }
    samples = samples.with(r, monotonic_ns() - t0);
  }
  let elapsed_ns = monotonic_ns() - started_ns;
  let allocs = bench.allocs_after(at_allocs);
  let fresh = bench.fresh_bytes_after(at_fresh);
  let requests = rounds as i64 * (batch as i64);
  let rep = bench.Report {
    name: "borrowed",
    iterations: rounds,
    wall_ns: elapsed_ns,
    samples_ns: cmp.sort(samples),
    allocs: allocs,
    fresh_bytes: fresh,
  };
  print(f"{{\"variant\":\"borrowed\",\"requests\":{requests},\"requests_per_round\":{batch},\"ok\":{c.ok}"
    + f",\"bad_magic\":{c.bad_magic},\"bad_version\":{c.bad_version},\"bad_type\":{c.bad_type}"
    + f",\"oversize\":{c.oversize},\"truncated\":{c.truncated},\"bad_checksum\":{c.bad_checksum}"
    + f",\"digest\":{c.digest},\"bytes_copied\":{c.copied}"
    + f",\"bytes_copied_per_request\":{c.copied / requests},\"steady_allocs\":{allocs}"
    + f",\"steady_fresh_bytes\":{fresh},\"allocs_per_request_milli\":{allocs * 1000i64 / requests}"
    + f",\"ns_per_request\":{elapsed_ns / requests}"
    + f",\"requests_per_sec\":{requests * 1000000000i64 / elapsed_ns},\"round_p50_ns\":{rep.p50_ns()}"
    + f",\"round_p95_ns\":{rep.p95_ns()},\"round_p99_ns\":{rep.p99_ns()}"
    + f",\"round_p999_ns\":{rep.p999_ns()},\"round_max_ns\":{rep.max_ns()}}}");
  return 0;
}
