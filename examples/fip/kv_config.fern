import "./kv_config_core";
import "./kv_config_map";
import "./kv_config_pmap";
import "./kv_workload";
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

struct RunReport {
  samples: i64[],
  wall: i64,
  allocations: i64,
  first: i64,
  fresh: i64,
  startup_ns: i64,
  startup_allocs: i64,
  startup_fresh: i64,
  seed_allocs: i64,
  responses: i64,
  snapshot_checks: i64,
  live: i32,
}

function report(c: kv_workload.Config, r: RunReport): i32 {
  if (c.samples) {
    for i in 0..c.turns {
      print(f"sample,{i},{r.samples[i]}");
    }
  }
  let stats = bench.Report { name: c.mix, iterations: c.turns, wall_ns: r.wall, samples_ns: cmp.sort(r.samples), allocs: r.allocations, fresh_bytes: r.fresh };
  print(f"{{\"representation\":\"{c.representation}\",\"capacity\":{c.capacity}"
    + f",\"key_bytes\":{c.key_bytes},\"value_bytes\":{c.value_bytes}"
    + f",\"batch\":{c.batch},\"turns\":{c.turns}"
    + f",\"mix\":\"{c.mix}\",\"load\":{c.load},\"sharing\":\"{c.sharing}\""
    + f",\"universe\":{kv_workload.universe(c)},\"live\":{r.live}"
    + f",\"response_digest\":{r.responses},\"snapshot_checks\":{r.snapshot_checks}"
    + f",\"wall_ns\":{r.wall},\"allocs\":{r.allocations}"
    + f",\"first_batch_allocs\":{r.first},\"fresh_bytes\":{r.fresh}"
    + f",\"startup_ns\":{r.startup_ns},\"startup_allocs\":{r.startup_allocs}"
    + f",\"startup_fresh_bytes\":{r.startup_fresh},\"seed_allocs\":{r.seed_allocs}"
    + f",\"batch_p50_ns\":{stats.p50_ns()},\"batch_p95_ns\":{stats.p95_ns()}"
    + f",\"batch_p99_ns\":{stats.p99_ns()},\"batch_p999_ns\":{stats.p999_ns()}"
    + f",\"batch_max_ns\":{stats.max_ns()}}}");
  if (c.representation == "fip" && c.sharing == "unique" && r.allocations != 0i64) {
    return 7;
  }
  return 0;
}

function saved_core(db: kv_config_core.Db): kv_config_core.Db {
  return db;
}

function probe_core(db: kv_config_core.Db, tape: kv_workload.Tape, c: kv_workload.Config, index: i32): i64 {
  let digest = db.live as i64;
  let slot = kv_config_core.find(db, tape.input, index * c.batch * kv_workload.stride(c) + 1);
  if (slot >= 0) {
    for j in 0..c.value_bytes {
      digest = kv_workload.fold(digest, db.values[slot * c.value_bytes + j] as i64);
    }
  }
  return kv_workload.bytes_digest(digest, db.output, db.out_count);
}

function export_core(db: kv_config_core.Db): void {
  for i in 0..db.slots {
    if (db.used[i] != 0) {
      print(f"entry,{kv_workload.hex(db.keys, i * db.key_bytes, db.key_bytes)},{kv_workload.hex(db.values, i * db.value_bytes, db.value_bytes)}");
    }
  }
}

function run_core(c: kv_workload.Config): i32 {
  let startup_mark = bench.alloc_count();
  let startup_fresh = bench.bump_bytes();
  let startup = monotonic_ns();
  let tape = kv_workload.build(c);
  let samples = __alloc_i64(c.turns);
  let Some(db) = kv_config_core.new_db(c.capacity, c.key_bytes, c.value_bytes, c.batch) else {
    return 2;
  };
  let seed_mark = bench.alloc_count();
  let i = 0;
  while (i < tape.seed_count) {
    let count = tape.seed_count - i;
    if (count > c.batch) {
      count = c.batch;
    }
    db = kv_config_core.process(db, tape.seed, i * kv_workload.stride(c), count);
    if (db.refused) {
      return 3;
    }
    i += count;
  }
  let seed_allocs = bench.allocs_after(seed_mark);
  let startup_ns = monotonic_ns() - startup;
  let startup_allocs = bench.allocs_after(startup_mark);
  let startup_bytes = bench.fresh_bytes_after(startup_fresh);
  let mark = bench.alloc_count();
  let fresh_mark = bench.bump_bytes();
  let started = monotonic_ns();
  let responses = 0i64;
  let checks = 0i64;
  let first = 0i64;
  for turn in 0..c.turns {
    let index = turn % 100;
    let observed = 0i64;
    let duration = 0i64;
    if (c.sharing == "shared") {
      let old = saved_core(db);
      let t0 = monotonic_ns();
      db = kv_config_core.process(db, tape.input, index * c.batch * kv_workload.stride(c), c.batch);
      duration = monotonic_ns() - t0;
      observed = probe_core(old, tape, c, index);
    } else {
      observed = probe_core(db, tape, c, index);
      let t0 = monotonic_ns();
      db = kv_config_core.process(db, tape.input, index * c.batch * kv_workload.stride(c), c.batch);
      duration = monotonic_ns() - t0;
    }
    if (db.refused) {
      return 4;
    }
    checks = (checks + observed) % 2147483647i64;
    responses = kv_workload.bytes_digest(responses, db.output, db.out_count);
    samples = samples.with(turn, duration);
    if (turn == 0) {
      first = bench.allocs_after(mark);
    }
  }
  let elapsed = monotonic_ns() - started;
  let allocations = bench.allocs_after(mark);
  let fresh = bench.fresh_bytes_after(fresh_mark);
  export_core(db);
  return report(c, RunReport { samples: samples, wall: elapsed, allocations: allocations, first: first, fresh: fresh, startup_ns: startup_ns, startup_allocs: startup_allocs, startup_fresh: startup_bytes, seed_allocs: seed_allocs, responses: responses, snapshot_checks: checks, live: db.live });
}

function saved_map(db: kv_config_map.Db): kv_config_map.Db {
  return db;
}

function probe_map(db: kv_config_map.Db, tape: kv_workload.Tape, c: kv_workload.Config, index: i32): i64 {
  let digest = db.entries.len() as i64;
  digest = kv_workload.string_digest(digest, db.entries.get_or(tape.probes[index], ""));
  return kv_workload.bytes_digest(digest, db.output, db.output.len());
}

function export_map(db: kv_config_map.Db): void {
  for key in db.entries.keys() {
    let value = db.entries.get_or(key, "");
    print(f"entry,{kv_workload.hex(key.bytes(), 0, db.key_bytes)},{kv_workload.hex(value.bytes(), 0, db.value_bytes)}");
  }
}

function run_map(c: kv_workload.Config): i32 {
  let startup_mark = bench.alloc_count();
  let startup_fresh = bench.bump_bytes();
  let startup = monotonic_ns();
  let tape = kv_workload.build(c);
  let samples = __alloc_i64(c.turns);
  let Some(db) = kv_config_map.new_db(c.capacity, c.key_bytes, c.value_bytes, c.batch) else {
    return 2;
  };
  let seed_mark = bench.alloc_count();
  let i = 0;
  while (i < tape.seed_count) {
    let count = tape.seed_count - i;
    if (count > c.batch) {
      count = c.batch;
    }
    db = kv_config_map.process(db, tape.seed, i * kv_workload.stride(c), count);
    if (db.refused) {
      return 3;
    }
    i += count;
  }
  let seed_allocs = bench.allocs_after(seed_mark);
  let startup_ns = monotonic_ns() - startup;
  let startup_allocs = bench.allocs_after(startup_mark);
  let startup_bytes = bench.fresh_bytes_after(startup_fresh);
  let mark = bench.alloc_count();
  let fresh_mark = bench.bump_bytes();
  let started = monotonic_ns();
  let responses = 0i64;
  let checks = 0i64;
  let first = 0i64;
  for turn in 0..c.turns {
    let index = turn % 100;
    let observed = 0i64;
    let duration = 0i64;
    if (c.sharing == "shared") {
      let old = saved_map(db);
      let t0 = monotonic_ns();
      db = kv_config_map.process(db, tape.input, index * c.batch * kv_workload.stride(c), c.batch);
      duration = monotonic_ns() - t0;
      observed = probe_map(old, tape, c, index);
    } else {
      observed = probe_map(db, tape, c, index);
      let t0 = monotonic_ns();
      db = kv_config_map.process(db, tape.input, index * c.batch * kv_workload.stride(c), c.batch);
      duration = monotonic_ns() - t0;
    }
    if (db.refused) {
      return 4;
    }
    checks = (checks + observed) % 2147483647i64;
    responses = kv_workload.bytes_digest(responses, db.output, db.output.len());
    samples = samples.with(turn, duration);
    if (turn == 0) {
      first = bench.allocs_after(mark);
    }
  }
  let elapsed = monotonic_ns() - started;
  let allocations = bench.allocs_after(mark);
  let fresh = bench.fresh_bytes_after(fresh_mark);
  export_map(db);
  return report(c, RunReport { samples: samples, wall: elapsed, allocations: allocations, first: first, fresh: fresh, startup_ns: startup_ns, startup_allocs: startup_allocs, startup_fresh: startup_bytes, seed_allocs: seed_allocs, responses: responses, snapshot_checks: checks, live: db.entries.len() });
}

function saved_pmap(db: kv_config_pmap.Db): kv_config_pmap.Db {
  return db;
}

function probe_pmap(db: kv_config_pmap.Db, tape: kv_workload.Tape, c: kv_workload.Config, index: i32): i64 {
  let digest = db.entries.len() as i64;
  digest = kv_workload.string_digest(digest, db.entries.get_or(tape.probes[index], ""));
  return kv_workload.bytes_digest(digest, db.output, db.output.len());
