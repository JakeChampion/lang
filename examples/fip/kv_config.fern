    Some(db) => {
      let seed_mark: i64 = bench.alloc_count();
      let i: i32 = 0;
      while (i < tape.seed_count) {
        let count: i32 = tape.seed_count - i;
        if (count > c.batch) {
          count = c.batch;
        }
        db = kv_config_pmap.process(db, tape.seed, i * kv_workload.stride(c), count);
        if (db.refused) {
          return 3;
        }
        i = i + count;
      }
