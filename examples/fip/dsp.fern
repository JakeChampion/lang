import "./dsp_core";
import "./dsp_fip";
import "./dsp_direct";
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

function snapshot(g: dsp_core.Graph): dsp_core.Graph {
  return g;
}

function checksum(values: f64[], count: i32): i64 {
  let hash = 0i64;
  for i in 0..count {
    let quantized = (values[i] * 4096.0) as i64;
    hash = (hash * 65599i64 + quantized + 1048576i64) % 1000000007i64;
  }
  return hash;
}

function process(own g: dsp_core.Graph, input: f64[], block: i32, variant: string): dsp_core.Graph {
  if (variant == "fip") {
    return dsp_fip.process(g, input, block);
  }
  return dsp_direct.process(g, input, block);
}

function run(variant: string, block: i32, blocks: i32, delay: i32, sharing: string, export_samples: boolean): i32 {
  let startup_alloc = bench.alloc_count();
  let startup_fresh = bench.bump_bytes();
  let startup = monotonic_ns();
  let input = dsp_core.dataset(block);
  let samples = __alloc_i64(blocks);
  let Some(g) = dsp_core.new_graph(block, delay) else {
    return 2;
  };
  let startup_ns = monotonic_ns() - startup;
  let startup_allocs = bench.allocs_after(startup_alloc);
  let startup_bytes = bench.fresh_bytes_after(startup_fresh);
  let mark = bench.alloc_count();
  let fresh_mark = bench.bump_bytes();
  let started = monotonic_ns();
  let current = 0i64;
  let checks = 0i64;
  let first_allocs = 0i64;
  for i in 0..blocks {
    let observed = 0i64;
    let duration = 0i64;
    if (sharing == "shared") {
      let saved = snapshot(g);
      let t0 = monotonic_ns();
      g = process(g, input, block, variant);
      duration = monotonic_ns() - t0;
      observed = checksum(saved.output, saved.output_count);
    } else {
      observed = checksum(g.output, g.output_count);
      let t0 = monotonic_ns();
      g = process(g, input, block, variant);
      duration = monotonic_ns() - t0;
    }
    samples = samples.with(i, duration);
    if (observed != current || g.refused || g.output_count != block) {
      return 1;
    }
    current = checksum(g.output, g.output_count);
    checks = (checks + current) % 1000000007i64;
    if (i == 0) {
      first_allocs = bench.allocs_after(mark);
    }
  }
  let elapsed = monotonic_ns() - started;
  let allocations = bench.allocs_after(mark);
  let fresh = bench.fresh_bytes_after(fresh_mark);
  if (export_samples) {
    for i in 0..blocks {
      print(f"sample,{i},{samples[i]}");
    }
  }
  let stats = bench.Report { name: variant, iterations: blocks, wall_ns: elapsed, samples_ns: cmp.sort(samples), allocs: allocations, fresh_bytes: fresh };
  print(f"{{\"variant\":\"{variant}\",\"block_size\":{block}"
    + f",\"blocks\":{blocks},\"delay_samples\":{delay}"
    + f",\"sharing\":\"{sharing}\",\"processed_samples\":{g.samples}"
    + f",\"checksum\":{current},\"block_checks\":{checks}"
    + f",\"ring_checksum\":{checksum(g.delay, g.delay.len())},\"cursor\":{g.cursor}"
    + f",\"startup_ns\":{startup_ns},\"startup_allocs\":{startup_allocs}"
    + f",\"startup_fresh_bytes\":{startup_bytes},\"wall_ns\":{elapsed}"
    + f",\"allocs\":{allocations},\"first_callback_allocs\":{first_allocs}"
    + f",\"fresh_bytes\":{fresh},\"block_p50_ns\":{stats.p50_ns()}"
    + f",\"block_p95_ns\":{stats.p95_ns()},\"block_p99_ns\":{stats.p99_ns()}"
    + f",\"block_p999_ns\":{stats.p999_ns()},\"block_max_ns\":{stats.max_ns()}}}");
  if (g.samples != block as i64 * (blocks as i64) || variant == "fip" && sharing == "unique" && allocations != 0i64) {
    return 1;
  }
  return 0;
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 6 || argv.len() > 7) {
    return 2;
  }
  if (argv[1] != "fip" && argv[1] != "direct") {
    return 2;
  }
  let Ok(block) = i32.parse_i32(argv[2]) else {
    return 2;
  };
  let Ok(blocks) = i32.parse_i32(argv[3]) else {
    return 2;
  };
  let Ok(delay) = i32.parse_i32(argv[4]) else {
    return 2;
  };
  if (block < 1 || block > 4096 || blocks < 1 || blocks > 1000000 || delay < 1 || delay > 8192) {
    return 2;
  }
  if (argv[5] != "unique" && argv[5] != "shared") {
    return 2;
  }
  let export_samples = argv.len() == 7;
  if (export_samples && argv[6] != "samples") {
    return 2;
  }
  return run(argv[1], block, blocks, delay, argv[5], export_samples);
}
