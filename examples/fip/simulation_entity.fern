import "./simulation_rules";

pub struct Entity {
  x: i32,
  y: i32,
  vx: i32,
  vy: i32,
  health: i32,
  kind: i32,
  target: i32,
  mode: i32,
}

pub function initial(index: i32, count: i32, clustered: boolean): Entity {
  let x: i32 = index * 73 % 4096;
  let y: i32 = index * 151 % 4096;
  if (clustered) {
    x = index % 8;
    y = index / 8 % 8;
  }
  let target: i32 = -1;
  if (index % 3 != 0) {
    target = (index + 1) % count;
  }
  return Entity {
    x: x, y: y, vx: index * 7 % 9 - 4, vy: index * 11 % 9 - 4,
    health: 100, kind: index % 3, target: target,
    mode: simulation_rules.mode(0, 100, target),
  };
}

pub fbip function input_ai(own row: Entity, index: i32, tick: i32, target: i32, target_x: i32, target_y: i32): Entity {
  let vx: i32 = 0;
  let vy: i32 = 0;
  if (row.mode != 2) {
    if (target >= 0) {
      vx = simulation_rules.steer(simulation_rules.delta(target_x, row.x), row.kind);
      vy = simulation_rules.steer(simulation_rules.delta(target_y, row.y), row.kind);
    } else {
      vx = (index * 7 + tick) % 9 - 4;
      vy = (index * 11 + tick * 3) % 9 - 4;
    }
  }
  return Entity { ...row, vx: vx, vy: vy, target: target };
}

pub fbip function move(own row: Entity): Entity {
  let x: i32 = simulation_rules.wrap(row.x + row.vx);
  let y: i32 = simulation_rules.wrap(row.y + row.vy);
  return Entity { ...row, x: x, y: y };
}

pub fbip function update(own row: Entity, neighbors: i32): Entity {
  let health: i32 = simulation_rules.health(row.health, row.mode, neighbors, row.kind);
  let mode: i32 = simulation_rules.mode(row.mode, health, row.target);
  return Entity { ...row, health: health, mode: mode };
}

pub fip function mix(hash: i64, row: Entity, neighbors: i32): i64 {
  hash = simulation_rules.mix(hash, row.x);
  hash = simulation_rules.mix(hash, row.y);
  hash = simulation_rules.mix(hash, row.vx + 4);
  hash = simulation_rules.mix(hash, row.vy + 4);
  hash = simulation_rules.mix(hash, row.health);
  hash = simulation_rules.mix(hash, row.kind);
  hash = simulation_rules.mix(hash, row.target + 1);
  hash = simulation_rules.mix(hash, row.mode);
  return simulation_rules.mix(hash, neighbors);
}
