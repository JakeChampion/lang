// examples/fip/kv_baseline.fern — the idiomatic, allocating variant of the
// bounded key/value core (#9585).
//
// A request is a record of three fields, a key and a value are strings, the
// database is the built-in `Map[string, string]`, and a batch is answered
// with an array of response records. Nothing here is written for allocation:
// it is the shape a first draft of a key/value service takes, and it is the
// control the other variants are measured against.
//
// Three things about its shape are deliberate, and each is a finding of the
// experiment rather than a style choice; `docs/FIP-KV-CORE.md` has the
// numbers. The database parameters are `own`, which is how Fern says a value
// is handed on rather than shared: borrowed, the first measurement copied the
// whole map on every write and exhausted the arena. The map is threaded as a
// value of its own beside the counters rather than as a field of one struct,
// because a map mutator on a field of an owned struct copies the map today
// (#11119). And every operation is written as a read-only classification
// followed by an update that returns the map and nothing else, because a map
// mutator whose result sits inside a tuple literal is miscompiled today
// (#11121) and the bound spelling that avoids the miscompile copies the map.
//
// # The protocol every variant shares
//
// A request is `op` + a `key_size()`-byte key + a `value_size()`-byte value;
// GET and DELETE carry a value and ignore it. The operations:
//
//   PUT       store the value under the key; `full` when the key is new and
//             the table holds `max_entries()` already
//   GET       answer the stored value, or `missing`
//   DELETE    remove the key, or `missing`
//   INCREMENT add the request value's first eight bytes, little-endian, to
//             the stored value's first eight bytes and answer the new value,
//             or `missing`
//
// A response is a status byte — ok, missing, full, or value — followed by
// `value_size()` bytes when the status is `value`. Every variant folds every
// response byte, in order, into one running digest; three implementations
// answering the same 640,000 requests to the same digest is the experiment's
// differential test, and `internal/e2e/fip_kv_test.go` holds them to it.
//
// # The workload
//
// Request n draws a key index from a mixing hash over a universe of
// `max_entries() * load / 100` keys, so the load factor is the one knob a run
// turns, and an operation from `n % 100` against a mix: read-heavy (80% GET,
// 10% PUT, 5% INCREMENT, 5% DELETE), write-heavy (20 / 45 / 20 / 15), or mixed
// (50 / 25 / 15 / 10). Half the universe is PUT before the measured region so
// reads have something to hit. Arguments: `mix load_pct rounds`, defaulting to
// `mixed 50 10000`; a load above 100 is how the full-table path is reached.
import "core/cmp";
import "core/map";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

// ===================== CAPACITIES =====================

function max_entries(): i32 {
  return 4096;
}

function key_size(): i32 {
  return 16;
}

function value_size(): i32 {
  return 32;
}

function batch_size(): i32 {
  return 64;
}

// ===================== PROTOCOL =====================

function op_put(): i32 {
  return 1;
}

function op_get(): i32 {
  return 2;
}

function op_delete(): i32 {
  return 3;
}

function op_incr(): i32 {
  return 4;
}

function st_ok(): i32 {
  return 1;
}

function st_missing(): i32 {
  return 2;
}

function st_full(): i32 {
  return 3;
}

function st_value(): i32 {
  return 4;
}

function mix_read(): i32 {
  return 1;
}

function mix_write(): i32 {
  return 2;
}

function mix_mixed(): i32 {
  return 3;
}

struct Request {
  op: i32,
  key: string,
  value: string,
}

struct Response {
  status: i32,
  value: string,
}

// The counters and the digest. The map travels beside this rather than
// inside it — see the header.
struct Counters {
  m_ok: i64,
  m_miss: i64,
  m_full: i64,
  m_val: i64,
  digest: i64,
}

// ===================== BYTE HELPERS =====================

function pow256(k: i32): i64 {
  let v: i64 = 1 as i64;
  let i: i32 = 0;
  while (i < k) {
    v = v * (256 as i64);
    i = i + 1;
  }
  return v;
}

function byte_of(v: i64, k: i32): u8 {
  return (v / pow256(k) % (256 as i64)) as u8;
}

function read_i64(s: string, at: i32): i64 {
  let v: i64 = 0 as i64;
  let k: i32 = 7;
  while (k >= 0) {
    v = v * (256 as i64) + s[at + k] as i64;
    k = k - 1;
  }
  return v;
}

// ===================== OPERATIONS =====================

// The status a request will get, read without touching the map.
function classify(entries: Map[string, string], req: Request): i32 {
  let present: boolean = entries.has(req.key);
  if (req.op == op_put()) {
    if (!present && entries.len() >= max_entries()) {
      return st_full();
    }
    return st_ok();
  }
  if (!present) {
    return st_missing();
  }
  if (req.op == op_delete()) {
    return st_ok();
  }
  return st_value();
}

function incremented(current: string, delta: i64): string {
  let next: i64 = read_i64(current, 0) + delta;
  let bytes: u8[] = current.bytes();
  let k: i32 = 0;
  while (k < 8) {
    bytes = bytes.with(k, byte_of(next, k));
    k = k + 1;
  }
  return string_from_bytes_unchecked(bytes);
}

// The map after each request classify did not refuse. One mutator per
// function, returned directly: the analysis that lets a mutator write in
// place reads the receiver's last use in source order over the whole
// function, so a second mutator later in the same body — even on another
// path — makes the first one copy the map (#11119 records the shape).
function put(own entries: Map[string, string], req: Request): Map[string, string] {
  return entries.insert(req.key, req.value);
}

function delete(own entries: Map[string, string], req: Request): Map[string, string] {
  // The destructuring spelling: projecting the tuple with `.0` copies the
  // map (#11121), this one shrinks it in place.
  let (rest, _) = entries.without(req.key);
  return rest;
}

function incr(own entries: Map[string, string], req: Request): Map[string, string] {
  let next: string = incremented(entries.get_or(req.key, ""), read_i64(req.value, 0));
  return entries.insert(req.key, next);
}

function update(own entries: Map[string, string], req: Request): Map[string, string] {
  if (req.op == op_put()) {
    return put(entries, req);
  }
  if (req.op == op_delete()) {
    return delete(entries, req);
  }
  if (req.op == op_incr()) {
    return incr(entries, req);
  }
  return entries;
}

function counted(own c: Counters, status: i32): Counters {
  if (status == st_ok()) {
    return Counters { ...c, m_ok: c.m_ok + 1 as i64 };
  }
  if (status == st_full()) {
    return Counters { ...c, m_full: c.m_full + 1 as i64 };
  }
  if (status == st_value()) {
    return Counters { ...c, m_val: c.m_val + 1 as i64 };
  }
  return Counters { ...c, m_miss: c.m_miss + 1 as i64 };
}

function fold_byte(d: i64, b: i64): i64 {
  return (d * 1000003i64 + b) % 2147483647i64;
}

function digest_responses(own c: Counters, rsps: Response[]): Counters {
  let d: i64 = c.digest;
  let i: i32 = 0;
  while (i < rsps.len()) {
    d = fold_byte(d, rsps[i].status as i64);
    if (rsps[i].status == st_value()) {
      let j: i32 = 0;
      while (j < value_size()) {
        d = fold_byte(d, rsps[i].value[j] as i64);
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return Counters { ...c, digest: d };
}

// Answers the batch into an array of records, then folds those records into
// the digest: the responses exist as values, which is the shape a caller that
// serialises them would want and the allocation a bounded design avoids.
function process_batch(own entries: Map[string, string], own c: Counters, reqs: Request[]): (Map[string, string], Counters) {
  let out: Response[] = [];
  let i: i32 = 0;
  while (i < reqs.len()) {
    let req: Request = reqs[i];
    let status: i32 = classify(entries, req);
    if (status == st_ok() || status == st_value()) {
      entries = update(entries, req);
    }
    let value: string = "";
    if (status == st_value()) {
      value = entries.get_or(req.key, "");
    }
    out = out.append(Response { status: status, value: value });
    c = counted(c, status);
    i = i + 1;
  }
  return (entries, digest_responses(c, out));
}

function fresh_counters(): Counters {
  return Counters { m_ok: 0 as i64, m_miss: 0 as i64, m_full: 0 as i64, m_val: 0 as i64, digest: 0 as i64 };
}

// ===================== THE WORKLOAD =====================

function mix64(n: i64): i64 {
  let x: i64 = n * (2654435761 as i64);
  x = x ^ x >> 15 as i64;
  x = x * (2246822519 as i64);
  x = x ^ x >> 13 as i64;
  if (x < 0 as i64) {
    x = 0 - x;
  }
  return x;
}

function op_for(n: i64, mix: i32): i32 {
  let bucket: i32 = (n % (100 as i64)) as i32;
  let gets: i32 = 50;
  let puts: i32 = 25;
  let incrs: i32 = 15;
  if (mix == mix_read()) {
    gets = 80;
    puts = 10;
    incrs = 5;
  }
  if (mix == mix_write()) {
    gets = 20;
    puts = 45;
    incrs = 20;
  }
  if (bucket < gets) {
    return op_get();
  }
  if (bucket < gets + puts) {
    return op_put();
  }
  if (bucket < gets + puts + incrs) {
    return op_incr();
  }
  return op_delete();
}

function key_byte(idx: i64, j: i32): u8 {
  if (j < 8) {
    return byte_of(idx, j);
  }
  return ((idx * (2654435761 as i64) + j as i64 * (40503 as i64)) / (256 as i64) % (256 as i64)) as u8;
}

function value_byte(v: i64, j: i32): u8 {
  if (j < 8) {
    return byte_of(v, j);
  }
  return ((v + j as i64 * (13 as i64)) % (256 as i64)) as u8;
}

function key_string(idx: i64): string {
  let bytes: u8[] = __alloc_u8(key_size());
  let j: i32 = 0;
  while (j < key_size()) {
    bytes = bytes.with(j, key_byte(idx, j));
    j = j + 1;
  }
  return string_from_bytes_unchecked(bytes);
}

function value_string(v: i64): string {
  let bytes: u8[] = __alloc_u8(value_size());
  let j: i32 = 0;
  while (j < value_size()) {
    bytes = bytes.with(j, value_byte(v, j));
    j = j + 1;
  }
  return string_from_bytes_unchecked(bytes);
}

function gen_batch(seed: i64, universe: i64, mix: i32): Request[] {
  let reqs: Request[] = [];
  let i: i32 = 0;
  while (i < batch_size()) {
    let n: i64 = seed + i as i64;
    let h: i64 = mix64(n);
    reqs = reqs.append(Request {
      op: op_for(n, mix),
      key: key_string(h % universe),
      value: value_string(h / (7 as i64) % (1000000 as i64)),
    });
    i = i + 1;
  }
  return reqs;
}

function gen_prefill(first_key: i64): Request[] {
  let reqs: Request[] = [];
  let i: i32 = 0;
  while (i < batch_size()) {
    let idx: i64 = first_key + i as i64;
    reqs = reqs.append(Request { op: op_put(), key: key_string(idx), value: value_string(idx * (10 as i64)) });
    i = i + 1;
  }
  return reqs;
}

// ===================== DRIVER =====================

function mix_of(name: string): i32 {
  if (name == "read") {
    return mix_read();
  }
  if (name == "write") {
    return mix_write();
  }
  return mix_mixed();
}

// `mix load_pct rounds` from the command line, each defaulting when absent
// or unreadable.
function options(argv: string[]): (string, i32, i32) {
  let mix_name: string = "mixed";
  let load_pct: i32 = 50;
  let rounds: i32 = 10000;
  if (argv.len() > 1) {
    mix_name = argv[1];
  }
  if (argv.len() > 2) {
    match (argv[2].parse_int()) {
      Some(n) => {
        load_pct = n;
      },
      None => {}
    }
  }
  if (argv.len() > 3) {
    match (argv[3].parse_int()) {
      Some(n) => {
        rounds = n;
      },
      None => {}
    }
  }
  return (mix_name, load_pct, rounds);
}

function main(): i32 {
  let argv: string[] = args();
  let (mix_name, load_pct, rounds) = options(argv);
  let mix: i32 = mix_of(mix_name);
  let universe: i64 = max_entries() as i64 * (load_pct as i64) / (100 as i64);

  let entries: Map[string, string] = Map { };
  let c: Counters = fresh_counters();
  let prefilled: i64 = 0 as i64;
  while (prefilled + batch_size() as i64 <= universe / (2 as i64)) {
    let (e2, c2) = process_batch(entries, c, gen_prefill(prefilled));
    entries = e2;
    c = c2;
    prefilled = prefilled + batch_size() as i64;
  }
  c = fresh_counters();
  let samples: i64[] = [];
  let p: i32 = 0;
  while (p < rounds) {
    samples = samples.append(0 as i64);
    p = p + 1;
  }
  let at_allocs: i64 = bench.alloc_count();
  let at_fresh: i64 = bench.bump_bytes();
  let started_ns: i64 = monotonic_ns();
  let r: i32 = 0;
  while (r < rounds) {
    let t0: i64 = monotonic_ns();
    let (e2, c2) = process_batch(entries, c, gen_batch(r as i64 * (97 as i64) + 1 as i64, universe, mix));
    entries = e2;
    c = c2;
    samples = samples.with(r, monotonic_ns() - t0);
    r = r + 1;
  }
  let elapsed_ns: i64 = monotonic_ns() - started_ns;
  let allocs: i64 = bench.allocs_after(at_allocs);
  let fresh: i64 = bench.fresh_bytes_after(at_fresh);
  let requests: i64 = rounds as i64 * (batch_size() as i64);
  let rep: bench.Report = bench.Report {
    name: "baseline",
    iterations: rounds,
    wall_ns: elapsed_ns,
    samples_ns: cmp.sort(samples),
    allocs: allocs,
    fresh_bytes: fresh,
  };
  print("{\"variant\":\"baseline\""
    + ",\"mix\":\"" + mix_name + "\""
    + ",\"load_pct\":" + load_pct.to_string()
    + ",\"requests\":" + requests.to_string()
    + ",\"requests_per_round\":" + batch_size().to_string()
    + ",\"live_entries\":" + entries.len().to_string()
    + ",\"ok\":" + c.m_ok.to_string()
    + ",\"missing\":" + c.m_miss.to_string()
    + ",\"table_full\":" + c.m_full.to_string()
    + ",\"values\":" + c.m_val.to_string()
    + ",\"digest\":" + c.digest.to_string()
    + ",\"steady_allocs\":" + allocs.to_string()
    + ",\"steady_fresh_bytes\":" + fresh.to_string()
    + ",\"allocs_per_request_milli\":" + (allocs * (1000 as i64) / requests).to_string()
    + ",\"ns_per_request\":" + (elapsed_ns / requests).to_string()
    + ",\"requests_per_sec\":" + (requests * 1000000000i64 / elapsed_ns).to_string()
    + ",\"round_p50_ns\":" + rep.p50_ns().to_string()
    + ",\"round_p95_ns\":" + rep.p95_ns().to_string()
    + ",\"round_p99_ns\":" + rep.p99_ns().to_string()
    + ",\"round_p999_ns\":" + rep.p999_ns().to_string()
    + ",\"round_max_ns\":" + rep.max_ns().to_string()
    + "}");
  return 0;
}
