import "core/cmp";
import "core/map";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

function max_entries(): i32 {
  return 4096;
}

function key_size(): i32 {
  return 16;
}

function value_size(): i32 {
  return 32;
}

function batch_size(): i32 {
  return 64;
}

function op_put(): i32 {
  return 1;
}

function op_get(): i32 {
  return 2;
}

function op_delete(): i32 {
  return 3;
}

function op_incr(): i32 {
  return 4;
}

function st_ok(): i32 {
  return 1;
}

function st_missing(): i32 {
  return 2;
}

function st_full(): i32 {
  return 3;
}

function st_value(): i32 {
  return 4;
}

function mix_read(): i32 {
  return 1;
}

function mix_write(): i32 {
  return 2;
}

function mix_mixed(): i32 {
  return 3;
}

struct Request {
  op: i32,
  key: string,
  value: string,
}

struct Response {
  status: i32,
  value: string,
}

struct Counters {
  m_ok: i64,
  m_miss: i64,
  m_full: i64,
  m_val: i64,
  digest: i64,
}

function pow256(k: i32): i64 {
  let v = 1i64;
  for _ in 0..k {
    v *= 256i64;
  }
  return v;
}

function byte_of(v: i64, k: i32): u8 {
  return (v / pow256(k) % 256i64) as u8;
}

function read_i64(s: string, at: i32): i64 {
  let v = 0i64;
  let k = 7;
  while (k >= 0) {
    v = v * 256i64 + s[at + k] as i64;
    k -= 1;
  }
  return v;
}

function classify(entries: Map[string, string], req: Request): i32 {
  let present = entries.contains(req.key);
  if (req.op == op_put()) {
    if (!present && entries.len() >= max_entries()) {
      return st_full();
    }
    return st_ok();
  }
  if (!present) {
    return st_missing();
  }
  if (req.op == op_delete()) {
    return st_ok();
  }
  return st_value();
}

function incremented(current: string, delta: i64): string {
  let next = read_i64(current, 0) + delta;
  let bytes = current.bytes();
  for k in 0..8 {
    bytes = bytes.with(k, byte_of(next, k));
  }
  return unsafe { string_from_bytes_unchecked(bytes) };
}

function put(own entries: Map[string, string], req: Request): Map[string, string] {
  return entries.insert(req.key, req.value);
}

function delete(own entries: Map[string, string], req: Request): Map[string, string] {
  return entries.remove(req.key);
}

function incr(own entries: Map[string, string], req: Request): Map[string, string] {
  let next = incremented(entries.get_or(req.key, ""), read_i64(req.value, 0));
  return entries.insert(req.key, next);
}

function update(own entries: Map[string, string], req: Request): Map[string, string] {
  if (req.op == op_put()) {
    return put(entries, req);
  }
  if (req.op == op_delete()) {
    return delete(entries, req);
  }
  if (req.op == op_incr()) {
    return incr(entries, req);
  }
  return entries;
}

function counted(own c: Counters, status: i32): Counters {
  if (status == st_ok()) {
    return Counters { ...c, m_ok: c.m_ok + 1i64 };
  }
  if (status == st_full()) {
    return Counters { ...c, m_full: c.m_full + 1i64 };
  }
  if (status == st_value()) {
    return Counters { ...c, m_val: c.m_val + 1i64 };
  }
  return Counters { ...c, m_miss: c.m_miss + 1i64 };
}

function fold_byte(d: i64, b: i64): i64 {
  return (d * 1000003i64 + b) % 2147483647i64;
}

function digest_responses(own c: Counters, rsps: Response[]): Counters {
  let d = c.digest;
  for rsp in rsps {
    d = fold_byte(d, rsp.status as i64);
    if (rsp.status == st_value()) {
      for j in 0..value_size() {
        d = fold_byte(d, rsp.value[j] as i64);
      }
    }
  }
  return Counters { ...c, digest: d };
}

function process_batch(own entries: Map[string, string], own c: Counters, reqs: Request[]): (Map[string, string], Counters) {
  let out: Response[] = [];
  for req in reqs {
    let status = classify(entries, req);
    if (status == st_ok() || status == st_value()) {
      entries = update(entries, req);
    }
    let value = "";
    if (status == st_value()) {
      value = entries.get_or(req.key, "");
    }
    out = out.append(Response { status: status, value: value });
    c = counted(c, status);
  }
  return (entries, digest_responses(c, out));
}

function fresh_counters(): Counters {
  return Counters { m_ok: 0i64, m_miss: 0i64, m_full: 0i64, m_val: 0i64, digest: 0i64 };
}

function mix64(n: i64): i64 {
  let x = n * 2654435761i64;
  x ^= x >> 15i64;
  x *= 2246822519i64;
  x ^= x >> 13i64;
  if (x < 0i64) {
    x = -x;
  }
  return x;
}

function op_for(n: i64, mix: i32): i32 {
  let bucket = (n % 100i64) as i32;
  let gets = 50;
  let puts = 25;
  let incrs = 15;
  if (mix == mix_read()) {
    gets = 80;
    puts = 10;
    incrs = 5;
  }
  if (mix == mix_write()) {
    gets = 20;
    puts = 45;
    incrs = 20;
  }
  if (bucket < gets) {
    return op_get();
  }
  if (bucket < gets + puts) {
    return op_put();
  }
  if (bucket < gets + puts + incrs) {
    return op_incr();
  }
  return op_delete();
}

function key_byte(idx: i64, j: i32): u8 {
  if (j < 8) {
    return byte_of(idx, j);
  }
  return ((idx * 2654435761i64 + j as i64 * 40503i64) / 256i64 % 256i64) as u8;
}

function value_byte(v: i64, j: i32): u8 {
  if (j < 8) {
    return byte_of(v, j);
  }
  return ((v + j as i64 * 13i64) % 256i64) as u8;
}

function key_string(idx: i64): string {
  let bytes = __alloc_u8(key_size());
  for j in 0..key_size() {
    bytes = bytes.with(j, key_byte(idx, j));
  }
  return unsafe { string_from_bytes_unchecked(bytes) };
}

function value_string(v: i64): string {
  let bytes = __alloc_u8(value_size());
  for j in 0..value_size() {
    bytes = bytes.with(j, value_byte(v, j));
  }
  return unsafe { string_from_bytes_unchecked(bytes) };
}

function gen_batch(seed: i64, universe: i64, mix: i32): Request[] {
  let reqs: Request[] = [];
  for i in 0..batch_size() {
    let n = seed + i as i64;
    let h = mix64(n);
    reqs = reqs.append(Request {
      op: op_for(n, mix),
      key: key_string(h % universe),
      value: value_string(h / 7i64 % 1000000i64),
    });
  }
  return reqs;
}

function gen_prefill(first_key: i64): Request[] {
  let reqs: Request[] = [];
  for i in 0..batch_size() {
    let idx = first_key + i as i64;
    reqs = reqs.append(Request { op: op_put(), key: key_string(idx), value: value_string(idx * 10i64) });
  }
  return reqs;
}

function mix_of(name: string): i32 {
  return match (name) { "read" => mix_read(), "write" => mix_write(), _ => mix_mixed() };
}

function options(argv: string[]): (string, i32, i32) {
  let mix_name = if (argv.len() > 1) { argv[1] } else { "mixed" };
  let load_pct = 50;
  let rounds = 10000;
  if (argv.len() > 2) {
    if let Ok(n) = i32.parse_i32(argv[2]) {
      load_pct = n;
    }
  }
  if (argv.len() > 3) {
    if let Ok(n) = i32.parse_i32(argv[3]) {
      rounds = n;
    }
  }
  return (mix_name, load_pct, rounds);
}

function main(): i32 {
  let argv = args();
  let (mix_name, load_pct, rounds) = options(argv);
  let mix = mix_of(mix_name);
  let universe = max_entries() as i64 * (load_pct as i64) / 100i64;

  let entries: Map[string, string] = Map { };
  let c = fresh_counters();
  let prefilled = 0i64;
  while (prefilled + batch_size() as i64 <= universe / 2i64) {
    let (e2, c2) = process_batch(entries, c, gen_prefill(prefilled));
    entries = e2;
    c = c2;
    prefilled += batch_size() as i64;
  }
  c = fresh_counters();
  let samples: i64[] = [];
  for _ in 0..rounds {
    samples = samples.append(0i64);
  }
  let at_allocs = bench.alloc_count();
  let at_fresh = bench.bump_bytes();
  let started_ns = monotonic_ns();
  for r in 0..rounds {
    let t0 = monotonic_ns();
    let (e2, c2) = process_batch(entries, c, gen_batch(r as i64 * 97i64 + 1i64, universe, mix));
    entries = e2;
    c = c2;
    samples = samples.with(r, monotonic_ns() - t0);
  }
  let elapsed_ns = monotonic_ns() - started_ns;
  let allocs = bench.allocs_after(at_allocs);
  let fresh = bench.fresh_bytes_after(at_fresh);
  let requests = rounds as i64 * (batch_size() as i64);
  let rep = bench.Report {
    name: "baseline",
    iterations: rounds,
    wall_ns: elapsed_ns,
    samples_ns: cmp.sort(samples),
    allocs: allocs,
    fresh_bytes: fresh,
  };
  print(f"{{\"variant\":\"baseline\",\"mix\":\"{mix_name}\",\"load_pct\":{load_pct}"
    + f",\"requests\":{requests},\"requests_per_round\":{batch_size()},\"live_entries\":{entries.len()}"
    + f",\"ok\":{c.m_ok},\"missing\":{c.m_miss},\"table_full\":{c.m_full},\"values\":{c.m_val}"
    + f",\"digest\":{c.digest},\"steady_allocs\":{allocs},\"steady_fresh_bytes\":{fresh}"
    + f",\"allocs_per_request_milli\":{allocs * 1000i64 / requests}"
    + f",\"ns_per_request\":{elapsed_ns / requests}"
    + f",\"requests_per_sec\":{requests * 1000000000i64 / elapsed_ns},\"round_p50_ns\":{rep.p50_ns()}"
    + f",\"round_p95_ns\":{rep.p95_ns()},\"round_p99_ns\":{rep.p99_ns()}"
    + f",\"round_p999_ns\":{rep.p999_ns()},\"round_max_ns\":{rep.max_ns()}}}");
  return 0;
}
