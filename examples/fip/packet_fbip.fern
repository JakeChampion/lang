import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";

fip function header_len(): i32 {
  return 16;
}

fip function max_payload(): i32 {
  return 240;
}

fip function max_packet(): i32 {
  return 256;
}

fip function magic0(): i32 {
  return 254;
}

fip function magic1(): i32 {
  return 82;
}

fip function version(): i32 {
  return 1;
}

fip function msg_echo(): i32 {
  return 1;
}

fip function msg_sum(): i32 {
  return 2;
}

fip function msg_reverse(): i32 {
  return 3;
}

fip function msg_upper(): i32 {
  return 4;
}

fip function st_ok(): i32 {
  return 0;
}

fip function st_bad_magic(): i32 {
  return 1;
}

fip function st_bad_version(): i32 {
  return 2;
}

fip function st_bad_type(): i32 {
  return 3;
}

fip function st_oversize(): i32 {
  return 4;
}

fip function st_truncated(): i32 {
  return 5;
}

fip function st_bad_checksum(): i32 {
  return 6;
}

fip function checksum(bytes: u8[], from: i32, n: i32): i32 {
  let a = 0;
  let b = 0;
  let i = 0;
  while (i < n) {
    a = (a + bytes[from + i] as i32) % 255;
    b = (b + a) % 255;
    i += 1;
  }
  return b * 256 + a;
}

fip function read_u16(bytes: u8[], at: i32): i32 {
  return bytes[at] as i32 + bytes[at + 1] as i32 * 256;
}

fip function read_u32(bytes: u8[], at: i32): i64 {
  return bytes[at] as i64
    + bytes[at + 1] as i64 * 256i64
    + bytes[at + 2] as i64 * 65536i64
    + bytes[at + 3] as i64 * 16777216i64;
}

fip function known_type(t: i32): boolean {
  return t == msg_echo() || t == msg_sum() || t == msg_reverse() || t == msg_upper();
}

fip function pow256(k: i32): i64 {
  let p = 1i64;
  let i = 0;
  while (i < k) {
    p *= 256i64;
    i += 1;
  }
  return p;
}

struct Codec {
  out: u8[],
  out_len: i32,
  st: i32,
  mtype: i32,
  rid: i64,
  at: i32,
  plen: i32,
  ok: i64,
  bad_magic: i64,
  bad_version: i64,
  bad_type: i64,
  oversize: i64,
  truncated: i64,
  bad_checksum: i64,
  digest: i64,
  copied: i64,
}

fbip function reject(own c: Codec, status: i32): Codec {
  return Codec { ...c, st: status, plen: 0, at: 0 };
}

fbip function parse_into(own c: Codec, wire: u8[], wire_len: i32): Codec {
  if (wire_len < header_len()) {
    return reject(c, st_truncated());
  }
  if (wire[0] as i32 != magic0() || wire[1] as i32 != magic1()) {
    return reject(c, st_bad_magic());
  }
  if (wire[2] as i32 != version()) {
    return reject(c, st_bad_version());
  }
  c = Codec { ...c, mtype: wire[3] as i32 };
  c = Codec { ...c, rid: read_u32(wire, 6) };
  let n = read_u16(wire, 10);
  if (n > max_payload()) {
    return reject(c, st_oversize());
  }
  if (wire_len < header_len() + n) {
    return reject(c, st_truncated());
  }
  if (checksum(wire, header_len(), n) != read_u16(wire, 12)) {
    return reject(c, st_bad_checksum());
  }
  if (!known_type(c.mtype)) {
    return reject(c, st_bad_type());
  }
  return Codec { ...c, st: st_ok(), at: header_len(), plen: n };
}

fbip function put(own c: Codec, at: i32, v: u8): Codec {
  return Codec { ...c, out: c.out.with(at, v) };
}

fbip function write_echo(own c: Codec, wire: u8[]): Codec {
  let at = c.at;
  let n = c.plen;
  let i = 0;
  while (i < n) {
    c = put(c, header_len() + i, wire[at + i]);
    i += 1;
  }
  return Codec { ...c, out_len: n };
}

fbip function write_reverse(own c: Codec, wire: u8[]): Codec {
  let at = c.at;
  let n = c.plen;
  let i = 0;
  while (i < n) {
    c = put(c, header_len() + i, wire[at + n - 1 - i]);
    i += 1;
  }
  return Codec { ...c, out_len: n };
}

fbip function write_upper(own c: Codec, wire: u8[]): Codec {
  let at = c.at;
  let n = c.plen;
  let i = 0;
  while (i < n) {
    let ch = wire[at + i] as i32;
    if (ch >= 97 && ch <= 122) {
      ch -= 32;
    }
    c = put(c, header_len() + i, ch as u8);
    i += 1;
  }
  return Codec { ...c, out_len: n };
}

fbip function write_sum(own c: Codec, wire: u8[]): Codec {
  let at = c.at;
  let n = c.plen;
  let total = 0i64;
  let s = 0;
  while (s < n) {
    total += wire[at + s] as i64;
    s += 1;
  }
  let b = 0;
  while (b < 8) {
    c = put(c, header_len() + b, (total / pow256(b) % 256i64) as u8);
    b += 1;
  }
  return Codec { ...c, out_len: 8 };
}

fbip function transform(own c: Codec, wire: u8[]): Codec {
  if (c.mtype == msg_echo()) {
    return write_echo(c, wire);
  }
  if (c.mtype == msg_reverse()) {
    return write_reverse(c, wire);
  }
  if (c.mtype == msg_upper()) {
    return write_upper(c, wire);
  }
  return write_sum(c, wire);
}

fbip function encode_header(own c: Codec): Codec {
  let plen = c.out_len;
  let mt = c.mtype;
  let status = c.st;
  let rid = c.rid;
  let ck = checksum(c.out, header_len(), plen);
  c = put(c, 0, magic0() as u8);
  c = put(c, 1, magic1() as u8);
  c = put(c, 2, version() as u8);
  c = put(c, 3, mt as u8);
  c = put(c, 4, status as u8);
  c = put(c, 5, 0 as u8);
  let idb = 0;
  while (idb < 4) {
    c = put(c, 6 + idb, (rid / pow256(idb) % 256i64) as u8);
    idb += 1;
  }
  c = put(c, 10, (plen % 256) as u8);
  c = put(c, 11, (plen / 256) as u8);
  c = put(c, 12, (ck % 256) as u8);
  c = put(c, 13, (ck / 256) as u8);
  c = put(c, 14, 0 as u8);
  return put(c, 15, 0 as u8);
}

fbip function tally(own c: Codec): Codec {
  if (c.st == st_ok()) {
    return Codec { ...c, ok: c.ok + 1i64 };
  }
  if (c.st == st_bad_magic()) {
    return Codec { ...c, bad_magic: c.bad_magic + 1i64 };
  }
  if (c.st == st_bad_version()) {
    return Codec { ...c, bad_version: c.bad_version + 1i64 };
  }
  if (c.st == st_bad_type()) {
    return Codec { ...c, bad_type: c.bad_type + 1i64 };
  }
  if (c.st == st_oversize()) {
    return Codec { ...c, oversize: c.oversize + 1i64 };
  }
  if (c.st == st_truncated()) {
    return Codec { ...c, truncated: c.truncated + 1i64 };
  }
  return Codec { ...c, bad_checksum: c.bad_checksum + 1i64 };
}

fbip function absorb(own c: Codec, n: i32): Codec {
  let d = c.digest;
  let i = 0;
  while (i < n) {
    d = mix(d, c.out[i] as i32);
    i += 1;
  }
  return Codec { ...c, digest: d };
}

fbip function serve(own c: Codec, wire: u8[], n: i64): Codec {
  c = Codec { ...c, out_len: 0, st: st_ok(), mtype: 0, rid: 0i64, at: 0, plen: 0 };
  c = parse_into(c, wire, wire_len_for(n));
  if (c.st == st_ok()) {
    c = transform(c, wire);
  }
  c = encode_header(c);
  let framed = header_len() + c.out_len;
  c = absorb(c, framed);
  c = tally(c);
  return Codec { ...c, copied: c.copied + c.out_len as i64 + header_len() as i64 };
}

fbip function reset(own c: Codec): Codec {
  return Codec {
    ...c,
    out_len: 0, st: 0, mtype: 0, rid: 0i64, at: 0, plen: 0,
    ok: 0i64, bad_magic: 0i64, bad_version: 0i64, bad_type: 0i64,
    oversize: 0i64, truncated: 0i64, bad_checksum: 0i64,
    digest: 1469598103934665603i64, copied: 0i64,
  };
}

fip function gen_payload_len(n: i64): i32 {
  return (n * 37i64 % 241i64) as i32;
}

fip function gen_byte(n: i64, j: i32): u8 {
  return (((n + j as i64) % 251i64) as i32) as u8;
}

fip function corruption(n: i64): i32 {
  if (n % 17i64 != 0i64) {
    return -1;
  }
  return (n / 17i64 % 6i64) as i32;
}

fip function build_request(own wire: u8[], n: i64): u8[] {
  let t = 1 + (n % 4i64) as i32;
  let plen = gen_payload_len(n);
  let corrupt = corruption(n);
  let i = 0;
  while (i < plen) {
    wire = wire.with(header_len() + i, gen_byte(n, i));
    i += 1;
  }
  let ck = checksum(wire, header_len(), plen);
  let m0 = magic0();
  let ver = version();
  let wire_plen = plen;
  if (corrupt == 0) {
    m0 = 1;
  }
  if (corrupt == 1) {
    ver = 9;
  }
  if (corrupt == 2) {
    t = 77;
  }
  if (corrupt == 3) {
    wire_plen = max_payload() + 8;
  }
  if (corrupt == 5) {
    ck ^= 1;
  }
  wire = wire.with(0, m0 as u8);
  wire = wire.with(1, magic1() as u8);
  wire = wire.with(2, ver as u8);
  wire = wire.with(3, t as u8);
  wire = wire.with(4, 0 as u8);
  wire = wire.with(5, 0 as u8);
  let idb = 0;
  while (idb < 4) {
    wire = wire.with(6 + idb, (n / pow256(idb) % 256i64) as u8);
    idb += 1;
  }
  wire = wire.with(10, (wire_plen % 256) as u8);
  wire = wire.with(11, (wire_plen / 256) as u8);
  wire = wire.with(12, (ck % 256) as u8);
  wire = wire.with(13, (ck / 256) as u8);
  wire = wire.with(14, 0 as u8);
  return wire.with(15, 0 as u8);
}

fip function wire_len_for(n: i64): i32 {
  let plen = gen_payload_len(n);
  if (corruption(n) == 4) {
    return header_len() + plen - 1;
  }
  return header_len() + plen;
}

fip function mix(d: i64, b: i32): i64 {
  let x = d ^ b as i64;
  x *= 1099511628211i64;
  x ^= x >> 29i64;
  if (x < 0i64) {
    x = -x;
  }
  return x % 1000000007i64;
}

function zeros_u8(n: i32): u8[] {
  let xs = __alloc_u8(n);
  for i in 0..n {
    xs = xs.with(i, 0 as u8);
  }
  return xs;
}

function new_codec(): Codec {
  return Codec {
    out: zeros_u8(max_packet()), out_len: 0,
    st: 0, mtype: 0, rid: 0i64, at: 0, plen: 0,
    ok: 0i64, bad_magic: 0i64, bad_version: 0i64, bad_type: 0i64,
    oversize: 0i64, truncated: 0i64, bad_checksum: 0i64,
    digest: 1469598103934665603i64, copied: 0i64,
  };
}

function main(): i32 {
  let batch = 64;
  let rounds = 4000;
  let wire = zeros_u8(max_packet());
  let c = new_codec();
  for w in 0..batch {
    wire = build_request(wire, w as i64);
    c = serve(c, wire, w as i64);
  }
  c = reset(c);
  let samples: i64[] = [];
  for _ in 0..rounds {
    samples = samples.append(0i64);
  }
  let at_allocs = bench.alloc_count();
  let at_fresh = bench.bump_bytes();
  let started_ns = monotonic_ns();
  for r in 0..rounds {
    let t0 = monotonic_ns();
    for k in 0..batch {
      let n = r as i64 * (batch as i64) + k as i64;
      wire = build_request(wire, n);
      c = serve(c, wire, n);
    }
    samples = samples.with(r, monotonic_ns() - t0);
  }
  let elapsed_ns = monotonic_ns() - started_ns;
  let allocs = bench.allocs_after(at_allocs);
  let fresh = bench.fresh_bytes_after(at_fresh);
  let requests = rounds as i64 * (batch as i64);
  let rep = bench.Report {
    name: "fbip",
    iterations: rounds,
    wall_ns: elapsed_ns,
    samples_ns: cmp.sort(samples),
    allocs: allocs,
    fresh_bytes: fresh,
  };
  print(f"{{\"variant\":\"fbip\",\"requests\":{requests},\"requests_per_round\":{batch},\"ok\":{c.ok}"
    + f",\"bad_magic\":{c.bad_magic},\"bad_version\":{c.bad_version},\"bad_type\":{c.bad_type}"
    + f",\"oversize\":{c.oversize},\"truncated\":{c.truncated},\"bad_checksum\":{c.bad_checksum}"
    + f",\"digest\":{c.digest},\"bytes_copied\":{c.copied}"
    + f",\"bytes_copied_per_request\":{c.copied / requests},\"steady_allocs\":{allocs}"
    + f",\"steady_fresh_bytes\":{fresh},\"allocs_per_request_milli\":{allocs * 1000i64 / requests}"
    + f",\"ns_per_request\":{elapsed_ns / requests}"
    + f",\"requests_per_sec\":{requests * 1000000000i64 / elapsed_ns},\"round_p50_ns\":{rep.p50_ns()}"
    + f",\"round_p95_ns\":{rep.p95_ns()},\"round_p99_ns\":{rep.p99_ns()}"
    + f",\"round_p999_ns\":{rep.p999_ns()},\"round_max_ns\":{rep.max_ns()}}}");
  return 0;
}
