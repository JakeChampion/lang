import "./etl_core";
import "./etl_variants";
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

function process(variant: i32, own s: etl_core.State, data: u8[], offset: i32, count: i32): etl_core.State {
  match (variant) {
    0 => {
      return etl_variants.process_baseline(s, data, offset, count);
    },
    1 => {
      return etl_variants.process_batched(s, data, offset, count);
    },
    2 => {
      return etl_variants.process_fbip(s, data, offset, count);
    },
    _ => {
      return etl_core.process(s, data, offset, count);
    }
  }
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 4 || argv.len() > 5) {
    return 2;
  }
  let variant = match (argv[1]) { "baseline" => 0, "batched" => 1, "fbip" => 2, "fip" => 3, _ => -1 };
  let Ok(records) = i32.parse_i32(argv[2]) else {
    return 2;
  };
  let Ok(batch) = i32.parse_i32(argv[3]) else {
    return 2;
  };
  if (variant < 0 || records <= 0 || records > 268435455 || batch <= 0 || batch > 268435455) {
    return 2;
  }
  let export_samples = argv.len() == 5;
  if (export_samples && argv[4] != "samples") {
    return 2;
  }
  let start_allocs = bench.alloc_count();
  let start_fresh = bench.bump_bytes();
  let start_ns = monotonic_ns();
  let data = etl_core.dataset(records);
  let s = etl_core.new_state(batch);
  let warm = if (batch > records) { records } else { batch };
  s = process(variant, s, data, 0, warm);
  s = etl_core.reset(s);
  let rounds = (records - 1) / batch + 1;
  let samples = __alloc_i64(rounds);
  let startup_ns = monotonic_ns() - start_ns;
  let startup_allocs = bench.allocs_after(start_allocs);
  let startup_fresh = bench.fresh_bytes_after(start_fresh);

  let mark_allocs = bench.alloc_count();
  let mark_fresh = bench.bump_bytes();
  let started = monotonic_ns();
  let first = 0;
  let r = 0;
  let checksum = 0i64;
  while (first < records) {
    let count = if (batch > records - first) { records - first } else { batch };
    let t0 = monotonic_ns();
    s = process(variant, s, data, first * 8, count);
    samples = samples.with(r, monotonic_ns() - t0);
    for i in 0..s.output_count * 8 {
      checksum += s.output[i] as i64;
    }
    first += count;
    r += 1;
  }
  let elapsed = monotonic_ns() - started;
  let allocations = bench.allocs_after(mark_allocs);
  let fresh = bench.fresh_bytes_after(mark_fresh);
  if (export_samples) {
    for r in 0..rounds {
      print(f"sample,{r},{samples[r]}");
    }
  }
  let rep = bench.Report {
    name: argv[1], iterations: rounds,
    wall_ns: elapsed, samples_ns: cmp.sort(samples), allocs: allocations, fresh_bytes: fresh,
  };
  print(f"{{\"variant\":\"{argv[1]}\",\"records\":{records}"
    + f",\"batch\":{batch},\"batches\":{rounds}"
    + f",\"seen\":{s.seen},\"accepted\":{s.accepted}"
    + f",\"invalid\":{s.invalid},\"filtered\":{s.filtered}"
    + f",\"refused\":{s.refused},\"total\":{s.total}"
    + f",\"low\":{s.low},\"high\":{s.high}"
    + f",\"checksum\":{checksum}"
    + f",\"startup_ns\":{startup_ns}"
    + f",\"startup_allocs\":{startup_allocs}"
    + f",\"startup_fresh_bytes\":{startup_fresh}"
    + f",\"wall_ns\":{elapsed}"
    + f",\"steady_allocs\":{allocations}"
    + f",\"steady_fresh_bytes\":{fresh}"
    + f",\"batch_p50_ns\":{rep.p50_ns()}"
    + f",\"batch_p95_ns\":{rep.p95_ns()}"
    + f",\"batch_p99_ns\":{rep.p99_ns()}"
    + f",\"batch_p999_ns\":{rep.p999_ns()}"
    + f",\"batch_max_ns\":{rep.max_ns()}}}");
  if (s.seen != records as i64 || s.refused != 0i64) {
    return 1;
  }
  if (variant >= 2 && allocations != 0i64) {
    return 1;
  }
  return 0;
}
