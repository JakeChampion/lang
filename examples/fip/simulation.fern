import "./simulation_fip";
import "./simulation_fbip";
import "./simulation_persistent";
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

struct Measurement {
  samples: i64[],
  wall_ns: i64,
  allocs: i64,
  fresh: i64,
  startup_ns: i64,
  startup_allocs: i64,
  startup_fresh: i64,
  tick: i32,
  checksum: i64,
  candidates: i64,
  checks: i64,
}

function snapshot_persistent(w: simulation_persistent.World): simulation_persistent.World {
  return w;
}

function snapshot_fbip(w: simulation_fbip.World): simulation_fbip.World {
  return w;
}

function snapshot_fip(w: simulation_fip.World): simulation_fip.World {
  return w;
}

function report(r: Measurement, variant: string, count: i32, ticks: i32, layout: string, sharing: string, export_samples: boolean): i32 {
  if (export_samples) {
    for i in 0..ticks {
      print(f"sample,{i},{r.samples[i]}");
    }
  }
  let stats = bench.Report {
    name: variant, iterations: ticks, wall_ns: r.wall_ns,
    samples_ns: cmp.sort(r.samples), allocs: r.allocs, fresh_bytes: r.fresh,
  };
  print(f"{{\"variant\":\"{variant}\",\"entities\":{count}"
    + f",\"ticks\":{ticks},\"initial_tick\":1,\"final_tick\":{r.tick}"
    + f",\"layout\":\"{layout}\",\"sharing\":\"{sharing}\""
    + f",\"checksum\":{r.checksum},\"snapshot_checks\":{r.checks}"
    + f",\"candidates\":{r.candidates}"
    + f",\"startup_ns\":{r.startup_ns},\"startup_allocs\":{r.startup_allocs}"
    + f",\"startup_fresh_bytes\":{r.startup_fresh}"
    + f",\"wall_ns\":{r.wall_ns},\"steady_allocs\":{r.allocs}"
    + f",\"steady_fresh_bytes\":{r.fresh}"
    + f",\"tick_p50_ns\":{stats.p50_ns()},\"tick_p95_ns\":{stats.p95_ns()}"
    + f",\"tick_p99_ns\":{stats.p99_ns()},\"tick_p999_ns\":{stats.p999_ns()}"
    + f",\"tick_max_ns\":{stats.max_ns()}}}");
  if (r.tick != ticks + 1 || sharing == "unique" && variant != "persistent" && r.allocs != 0i64) {
    return 1;
  }
  return 0;
}

function run_persistent(count: i32, ticks: i32, layout: string, sharing: string, export_samples: boolean): i32 {
  let start_allocs = bench.alloc_count();
  let start_fresh = bench.bump_bytes();
  let start_ns = monotonic_ns();
  let Some(w) = simulation_persistent.new_world(count, layout == "cluster") else {
    return 2;
  };
  w = simulation_persistent.step(w);
  let samples = __alloc_i64(ticks);
  let startup_ns = monotonic_ns() - start_ns;
  let startup_allocs = bench.allocs_after(start_allocs);
  let startup_fresh = bench.fresh_bytes_after(start_fresh);
  let mark_allocs = bench.alloc_count();
  let mark_fresh = bench.bump_bytes();
  let started = monotonic_ns();
  let candidates = 0i64;
  let checks = 0i64;
  for i in 0..ticks {
    let expected = w.checksum;
    let observed = 0i64;
    let t0 = monotonic_ns();
    if (sharing == "shared") {
      let saved = snapshot_persistent(w);
      w = simulation_persistent.step(w);
      observed = simulation_persistent.checksum(saved);
    } else {
      observed = simulation_persistent.checksum(w);
      w = simulation_persistent.step(w);
    }
    samples = samples.with(i, monotonic_ns() - t0);
    if (observed != expected || w.refused != 0
      || w.candidates < count as i64 || w.candidates > count as i64 * (count as i64)) {
      return 1;
    }
    checks = (checks + observed) % 1000000007i64;
    candidates += w.candidates;
  }
  let elapsed = monotonic_ns() - started;
  let allocations = bench.allocs_after(mark_allocs);
  let fresh = bench.fresh_bytes_after(mark_fresh);
  return report(
    Measurement {
      samples: samples, wall_ns: elapsed, allocs: allocations, fresh: fresh,
      startup_ns: startup_ns, startup_allocs: startup_allocs, startup_fresh: startup_fresh,
      tick: w.tick, checksum: w.checksum, candidates: candidates, checks: checks,
    },
    "persistent", count, ticks, layout, sharing, export_samples,
  );
}

