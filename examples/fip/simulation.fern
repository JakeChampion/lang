function main(): i32 {
  let argv = args();
  if (argv.len() < 6 || argv.len() > 7) {
    return 2;
  }
  if (argv[1] != "fip" && argv[1] != "fbip" && argv[1] != "persistent") {
    return 2;
  }
  let Ok(count) = i32.parse_i32(argv[2]) else {
    return 2;
  };
  let Ok(ticks) = i32.parse_i32(argv[3]) else {
    return 2;
  };
  if (count < 0 || count > 4096 || ticks <= 0 || ticks > 999999) {
    return 2;
  }
  if (argv[4] != "spread" && argv[4] != "cluster") {
    return 2;
  }
  if (argv[5] != "unique" && argv[5] != "shared") {
    return 2;
  }
  let export_samples = argv.len() == 7;
  if (export_samples && argv[6] != "samples") {
    return 2;
  }
  match (argv[1]) {
    "persistent" => {
      return run_persistent(count, ticks, argv[4], argv[5], export_samples);
    },
    "fbip" => {
      return run_fbip(count, ticks, argv[4], argv[5], export_samples);
    },
    _ => {
      return run_fip(count, ticks, argv[4], argv[5], export_samples);
    }
  }
}
