// Scalar inline control for the generic bounded ring. Same capacity and clearing.
pub struct Ring {
  data: i64[],
  empty: i64,
  head: i32,
  count: i32,
  status: i32,
}

pub function new_ring(capacity: i32, empty: i64): Option[Ring] {
  if (capacity < 1 || capacity > 4096) {
    return None;
  }
  let data: i64[] = [];
  let i: i32 = 0;
  while (i < capacity) {
    data = data.append(empty);
    i = i + 1;
  }
  return Some(Ring { data: data, empty: empty, head: 0, count: 0, status: 0 });
}

pub fip function at_or(q: Ring, index: i32, fallback: i64): i64 {
  if (index < 0 || index >= q.count) {
    return fallback;
  }
  return q.data[(q.head + index) % q.data.len()];
}

pub fip function push(own q: Ring, value: i64): Ring {
  if (q.count == q.data.len()) {
    return Ring { ...q, status: 1 };
  }
  q = Ring { ...q, data: q.data.with((q.head + q.count) % q.data.len(), value) };
  return Ring { ...q, count: q.count + 1, status: 0 };
}

pub fip function drop(own q: Ring): Ring {
  if (q.count == 0) {
    return Ring { ...q, status: 2 };
  }
  q = Ring { ...q, data: q.data.with(q.head, q.empty) };
  return Ring { ...q, head: (q.head + 1) % q.data.len(), count: q.count - 1, status: 0 };
}
