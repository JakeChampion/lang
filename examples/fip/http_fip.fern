import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";

fip function out_base(): i32 {
  return 8;
}

fip function max_wire(): i32 {
  return 1024;
}

fip function max_out(): i32 {
  return 1024;
}

fip function cl_ok(): i32 {
  return 0;
}

fip function cl_bad_request_line(): i32 {
  return 1;
}

fip function cl_no_version(): i32 {
  return 2;
}

fip function cl_transfer_encoding(): i32 {
  return 3;
}

fip function cl_duplicate_length(): i32 {
  return 4;
}

fip function cl_bad_length(): i32 {
  return 5;
}

fip function cl_truncated(): i32 {
  return 6;
}

fip function cr(): u8 {
  return b'\r';
}

fip function lf(): u8 {
  return b'\n';
}

fip function sp(): u8 {
  return b' ';
}

fip function colon(): u8 {
  return b':';
}

fip function lower(b: u8): u8 {
  if (b >= b'A' && b <= b'Z') {
    return (b as i32 + 32) as u8;
  }
  return b;
}

fip function find_crlf(buf: u8[], from: i32, end: i32): i32 {
  let i = from;
  while (i + 1 < end) {
    if (buf[i] == cr() && buf[i + 1] == lf()) {
      return i;
    }
    i += 1;
  }
  return -1;
}

fip function find_byte(buf: u8[], from: i32, end: i32, b: u8): i32 {
  let i = from;
  while (i < end) {
    if (buf[i] == b) {
      return i;
    }
    i += 1;
  }
  return -1;
}

fip function name_is(buf: u8[], from: i32, end: i32, lit: string): boolean {
  if (end - from != lit.len()) {
    return false;
  }
  let i = 0;
  while (i < lit.len()) {
    if (lower(buf[from + i]) != lit[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fip function bytes_are(buf: u8[], from: i32, end: i32, lit: string): boolean {
  if (end - from != lit.len()) {
    return false;
  }
  let i = 0;
  while (i < lit.len()) {
    if (buf[from + i] != lit[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fip function starts_with(buf: u8[], from: i32, end: i32, lit: string): boolean {
  if (end - from < lit.len()) {
    return false;
  }
  let i = 0;
  while (i < lit.len()) {
    if (buf[from + i] != lit[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fip function is_space(b: u8): boolean {
  return b == sp() || b == b'\t';
}

fip function trim_start(buf: u8[], from: i32, end: i32): i32 {
  let i = from;
  while (i < end && is_space(buf[i])) {
    i += 1;
  }
  return i;
}

fip function trim_end(buf: u8[], from: i32, end: i32): i32 {
  let e = end;
  while (e > from && is_space(buf[e - 1])) {
    e -= 1;
  }
  return e;
}

fip function parse_length(buf: u8[], from: i32, end: i32): i32 {
  let s = trim_start(buf, from, end);
  let e = trim_end(buf, s, end);
  if (e <= s) {
    return -1;
  }
  let acc = 0;
  let i = s;
  while (i < e) {
    let b = buf[i] as i32;
    if (b < 48 || b > 57) {
      return -1;
    }
    let digit = b - 48;
    if (acc > 214748364 || acc == 214748364 && digit > 7) {
      return -1;
    }
    acc = acc * 10 + digit;
    i += 1;
  }
  return acc;
}

fip function put_str(own out: u8[], at: i32, lit: string): u8[] {
  let i = 0;
  while (i < lit.len()) {
    out = out.with(at + i, lit[i]);
    i += 1;
  }
  return out;
}

fip function put_bytes(own out: u8[], at: i32, src: u8[], from: i32, n: i32): u8[] {
  let i = 0;
  while (i < n) {
    out = out.with(at + i, src[from + i]);
    i += 1;
  }
  return out;
}

fip function digits(n: i32): i32 {
  let d = 1;
  let v = n;
  while (v >= 10) {
    v /= 10;
    d += 1;
  }
  return d;
}

fip function put_int(own out: u8[], at: i32, n: i32): u8[] {
  let d = digits(n);
  let v = n;
  let i = d - 1;
  while (i >= 0) {
    out = out.with(at + i, (48 + v % 10) as u8);
    v /= 10;
    i -= 1;
  }
  return out;
}

fip function reason_len(status: i32): i32 {
  if (status == 200) {
    return 2;
  }
  if (status == 404) {
    return 9;
  }
  return 11;
}

fip function put_reason(own out: u8[], at: i32, status: i32): u8[] {
  if (status == 200) {
    return put_str(out, at, "OK");
  }
  if (status == 404) {
    return put_str(out, at, "Not Found");
  }
  return put_str(out, at, "Bad Request");
}

fip function head_len(status: i32, rid_len: i32, body_len: i32): i32 {
  let n = 9 + 3 + 1 + reason_len(status) + 2 + 16 + digits(body_len) + 23;
  if (rid_len > 0) {
    n += 14 + rid_len + 2;
  }
  return n;
}

fip function put_head(own out: u8[], status: i32, src: u8[], rid_at: i32, rid_len: i32, body_len: i32): u8[] {
  let at = out_base();
  out = put_str(out, at, "HTTP/1.1 ");
  at += 9;
  out = put_int(out, at, status);
  at += 3;
  out = out.with(at, sp());
  at += 1;
  out = put_reason(out, at, status);
  at += reason_len(status);
  out = out.with(at, cr());
  out = out.with(at + 1, lf());
  at += 2;
  if (rid_len > 0) {
    out = put_str(out, at, "X-Request-Id: ");
    at += 14;
    out = put_bytes(out, at, src, rid_at, rid_len);
    at += rid_len;
    out = out.with(at, cr());
    out = out.with(at + 1, lf());
    at += 2;
  }
  out = put_str(out, at, "Content-Length: ");
  at += 16;
  out = put_int(out, at, body_len);
  at += digits(body_len);
  return put_str(out, at, "\r\nConnection: close\r\n\r\n");
}

fip function seal(own out: u8[], class: i32, n: i32): u8[] {
  out = out.with(0, (n % 256) as u8);
  out = out.with(1, (n / 256 % 256) as u8);
  out = out.with(2, (n / 65536 % 256) as u8);
  out = out.with(3, 0 as u8);
  out = out.with(4, class as u8);
  out = out.with(5, 0 as u8);
  out = out.with(6, 0 as u8);
  return out.with(7, 0 as u8);
}

fip function frame(own out: u8[], class: i32, status: i32, src: u8[], rid_at: i32, rid_len: i32, body_from: i32, body_len: i32): u8[] {
  let h = head_len(status, rid_len, body_len);
  out = put_head(out, status, src, rid_at, rid_len, body_len);
  out = put_bytes(out, out_base() + h, src, body_from, body_len);
  return seal(out, class, h + body_len);
}

fip function frame_lit(own out: u8[], class: i32, status: i32, src: u8[], rid_at: i32, rid_len: i32, body: string): u8[] {
  let h = head_len(status, rid_len, body.len());
  out = put_head(out, status, src, rid_at, rid_len, body.len());
  out = put_str(out, out_base() + h, body);
  return seal(out, class, h + body.len());
}

fip function reject(own out: u8[], class: i32, src: u8[]): u8[] {
  return frame_lit(out, class, 400, src, 0, 0, "bad request");
}

fip function serve(own out: u8[], wire: u8[], wire_len: i32): u8[] {
  let hend = -1;
  let i = 0;
  while (i + 3 < wire_len) {
    if (wire[i] == cr() && wire[i + 1] == lf() && wire[i + 2] == cr() && wire[i + 3] == lf()) {
      hend = i;
      i = wire_len;
    }
    i += 1;
  }
  if (hend < 0) {
    return reject(out, cl_truncated(), wire);
  }
  let body_at = hend + 4;
  let line_end = find_crlf(wire, 0, wire_len);

  let cl = 0;
  let cl_seen = 0;
  let te_seen = false;
  let bad_cl = false;
  let rid_at = 0;
  let rid_len = 0;
  let rid_seen = false;
  let at = line_end + 2;
  if (at > hend) {
    at = hend;
  }
  while (at < hend) {
    let e = find_crlf(wire, at, hend);
    if (e < 0) {
      e = hend;
    }
    let c = find_byte(wire, at, e, colon());
    if (c > at) {
      if (name_is(wire, at, c, "content-length")) {
        cl_seen += 1;
        let v = parse_length(wire, c + 1, e);
        if (v < 0) {
          bad_cl = true;
        }
        cl = v;
      }
      if (name_is(wire, at, c, "transfer-encoding")) {
        te_seen = true;
      }
      if (!rid_seen && name_is(wire, at, c, "x-request-id")) {
        rid_seen = true;
        rid_at = trim_start(wire, c + 1, e);
        rid_len = trim_end(wire, rid_at, e) - rid_at;
      }
    }
    at = e + 2;
  }
  if (te_seen) {
    return reject(out, cl_transfer_encoding(), wire);
  }
  if (cl_seen > 1) {
    return reject(out, cl_duplicate_length(), wire);
  }
  if (cl_seen == 1 && bad_cl) {
    return reject(out, cl_bad_length(), wire);
  }
  if (cl_seen == 0) {
    cl = 0;
  }
  if (body_at + cl > wire_len) {
    return reject(out, cl_truncated(), wire);
  }

  let sp1 = find_byte(wire, 0, line_end, sp());
  if (sp1 < 0) {
    return reject(out, cl_bad_request_line(), wire);
  }
  let sp2 = find_byte(wire, sp1 + 1, line_end, sp());
  if (sp2 < 0) {
    return reject(out, cl_no_version(), wire);
  }
  return route(out, wire, sp1, sp1 + 1, sp2, rid_at, rid_len, body_at, cl);
}

fip function route(own out: u8[], wire: u8[], sp1: i32, path_at: i32, path_end: i32, rid_at: i32, rid_len: i32, body_at: i32, cl: i32): u8[] {
  if (bytes_are(wire, path_at, path_end, "/")) {
    return frame_lit(out, cl_ok(), 200, wire, rid_at, rid_len, "ok");
  }
  if (bytes_are(wire, path_at, path_end, "/echo") && bytes_are(wire, 0, sp1, "POST")) {
    return frame(out, cl_ok(), 200, wire, rid_at, rid_len, body_at, cl);
  }
  if (starts_with(wire, path_at, path_end, "/users/")) {
    return frame(out, cl_ok(), 200, wire, rid_at, rid_len, path_at + 7, path_end - path_at - 7);
  }
  return frame_lit(out, cl_ok(), 404, wire, rid_at, rid_len, "not found");
}

fip function wire_len_at(): i32 {
  return max_wire() - 4;
}

fip function gen_body_len(n: i64): i32 {
  return (n * 37i64 % 241i64) as i32;
}

fip function gen_byte(n: i64, j: i32): u8 {
  return (((n + j as i64) % 26i64) as i32 + 97) as u8;
}

fip function corruption(n: i64): i32 {
  if (n % 17i64 != 0i64) {
    return -1;
  }
  return (n / 17i64 % 6i64) as i32;
}

fip function method_of(n: i64): i32 {
  return (n % 4i64) as i32;
}

fip function method_len(m: i32): i32 {
  if (m == 0) {
    return 3;
  }
  if (m == 1) {
    return 4;
  }
  if (m == 2) {
    return 3;
  }
  return 6;
}

fip function put_method(own w: u8[], at: i32, m: i32): u8[] {
  if (m == 0) {
    return put_str(w, at, "GET");
  }
  if (m == 1) {
    return put_str(w, at, "POST");
  }
  if (m == 2) {
    return put_str(w, at, "PUT");
  }
  return put_str(w, at, "DELETE");
}

fip function path_of(n: i64): i32 {
  return (n % 5i64) as i32;
}

fip function path_len(p: i32, id: i32): i32 {
  if (p == 0) {
    return 1;
  }
  if (p == 1 || p == 4) {
    return 5;
  }
  if (p == 2) {
    return 7 + digits(id);
  }
  return 9 + digits(id);
}

fip function put_path(own w: u8[], at: i32, p: i32, id: i32): u8[] {
  if (p == 0) {
    return put_str(w, at, "/");
  }
  if (p == 1 || p == 4) {
    return put_str(w, at, "/echo");
  }
  if (p == 2) {
    w = put_str(w, at, "/users/");
    return put_int(w, at + 7, id);
  }
  w = put_str(w, at, "/missing/");
  return put_int(w, at + 9, id);
}

fip function put_crlf(own w: u8[], at: i32): u8[] {
  w = w.with(at, cr());
  return w.with(at + 1, lf());
}

fip function length_line_len(cl: i32): i32 {
  return 16 + digits(cl) + 2;
}

fip function put_length(own w: u8[], at: i32, cl: i32): u8[] {
  w = put_str(w, at, "Content-Length: ");
  w = put_int(w, at + 16, cl);
  return put_crlf(w, at + 16 + digits(cl));
}

fip function build_request(own w: u8[], n: i64): u8[] {
  let id = n as i32;
  let m = method_of(n);
  let p = path_of(n);
  let corrupt = corruption(n);
  let has_body = m == 1 || m == 2;
  let blen = 0;
  if (has_body) {
    blen = gen_body_len(n);
  }
  let at = 0;
  w = put_method(w, at, m);
  at += method_len(m);
  if (corrupt != 0) {
    w = w.with(at, sp());
    at += 1;
  }
  w = put_path(w, at, p, id);
  at += path_len(p, id);
  if (corrupt != 0 && corrupt != 1) {
    w = w.with(at, sp());
    at += 1;
  }
  if (corrupt != 1) {
    w = put_str(w, at, "HTTP/1.1");
    at += 8;
  }
  w = put_crlf(w, at);
  at += 2;
  w = put_str(w, at, "Host: example.test\r\nUser-Agent: bench/");
  at += 38;
  let ua = (n % 61i64) as i32;
  let j = 0;
  while (j < ua) {
    w = w.with(at + j, b'a');
    j += 1;
  }
  at += ua;
  w = put_str(w, at, "\r\nAccept: */*\r\nX-Request-Id: ");
  at += 29;
  w = put_int(w, at, id);
  at += digits(id);
  w = put_crlf(w, at);
  at += 2;
  if (corrupt == 2) {
    w = put_str(w, at, "Transfer-Encoding: chunked\r\n");
    at += 28;
  }
  if (corrupt == 4) {
    w = put_str(w, at, "Content-Length: 12a\r\n");
    at += 21;
  } else if (has_body || corrupt == 3 || corrupt == 5) {
    let declared = blen;
    if (corrupt == 5) {
      declared = blen + 7;
    }
    w = put_length(w, at, declared);
    at += length_line_len(declared);
    if (corrupt == 3) {
      w = put_length(w, at, declared);
      at += length_line_len(declared);
    }
  }
  w = put_crlf(w, at);
  at += 2;
  let k = 0;
  while (k < blen) {
    w = w.with(at + k, gen_byte(n, k));
    k += 1;
  }
  at += blen;
  w = w.with(wire_len_at(), (at % 256) as u8);
  w = w.with(wire_len_at() + 1, (at / 256 % 256) as u8);
  w = w.with(wire_len_at() + 2, 0 as u8);
  return w.with(wire_len_at() + 3, 0 as u8);
}

fip function wire_len_of(w: u8[]): i32 {
  return w[wire_len_at()] as i32 + w[wire_len_at() + 1] as i32 * 256;
}

fip function out_len_of(o: u8[]): i32 {
  return o[0] as i32 + o[1] as i32 * 256 + o[2] as i32 * 65536;
}

fip function mix(d: i64, b: i32): i64 {
  let x = d ^ b as i64;
  x *= 1099511628211i64;
  x ^= x >> 29i64;
  if (x < 0i64) {
    x = -x;
  }
  return x % 1000000007i64;
}

function zeros_u8(n: i32): u8[] {
  let xs = __alloc_u8(n);
  for i in 0..n {
    xs = xs.with(i, 0 as u8);
  }
  return xs;
}

function main(): i32 {
  let batch = 64;
  let rounds = 2000;
  let wire = zeros_u8(max_wire());
  let out = zeros_u8(max_out());

  let ok = 0i64;
  let c1 = 0i64;
  let c2 = 0i64;
  let c3 = 0i64;
  let c4 = 0i64;
  let c5 = 0i64;
  let c6 = 0i64;
  let digest = 1469598103934665603i64;
  let written = 0i64;

  let samples: i64[] = [];
  for _ in 0..rounds {
    samples = samples.append(0i64);
  }

  for w in 0..batch {
    wire = build_request(wire, w as i64);
    out = serve(out, wire, wire_len_of(wire));
  }

  let at_allocs = bench.alloc_count();
  let at_fresh = bench.bump_bytes();
  let started_ns = monotonic_ns();
  for r in 0..rounds {
    let t0 = monotonic_ns();
    for k in 0..batch {
      let n = r as i64 * (batch as i64) + k as i64;
      wire = build_request(wire, n);
      out = serve(out, wire, wire_len_of(wire));
      let len = out_len_of(out);
      let class = out[4] as i32;
      for i in 0..len {
        digest = mix(digest, out[out_base() + i] as i32);
      }
      written += len as i64;
      match (class) {
        0 => {
          ok += 1i64;
        },
        1 => {
          c1 += 1i64;
        },
        2 => {
          c2 += 1i64;
        },
        3 => {
          c3 += 1i64;
        },
        4 => {
          c4 += 1i64;
        },
        5 => {
          c5 += 1i64;
        },
        6 => {
          c6 += 1i64;
        },
        _ => {}
      }
    }
    samples = samples.with(r, monotonic_ns() - t0);
  }
  let elapsed_ns = monotonic_ns() - started_ns;
  let allocs = bench.allocs_after(at_allocs);
  let fresh = bench.fresh_bytes_after(at_fresh);
  let requests = rounds as i64 * (batch as i64);
  let rep = bench.Report {
    name: "fip",
    iterations: rounds,
    wall_ns: elapsed_ns,
    samples_ns: cmp.sort(samples),
    allocs: allocs,
    fresh_bytes: fresh,
  };
  print(f"{{\"variant\":\"fip\",\"requests\":{requests},\"requests_per_round\":{batch},\"ok\":{ok}"
    + f",\"rejected\":{c1 + c2 + c3 + c4 + c5 + c6},\"bad_request_line\":{c1},\"no_version\":{c2}"
    + f",\"transfer_encoding\":{c3},\"duplicate_length\":{c4},\"bad_length\":{c5},\"truncated\":{c6}"
    + f",\"digest\":{digest},\"response_bytes\":{written}"
    + f",\"response_bytes_per_request\":{written / requests},\"steady_allocs\":{allocs}"
    + f",\"steady_fresh_bytes\":{fresh},\"allocs_per_request_milli\":{allocs * 1000i64 / requests}"
    + f",\"fresh_bytes_per_request\":{fresh / requests},\"ns_per_request\":{elapsed_ns / requests}"
    + f",\"requests_per_sec\":{requests * 1000000000i64 / elapsed_ns},\"round_p50_ns\":{rep.p50_ns()}"
    + f",\"round_p95_ns\":{rep.p95_ns()},\"round_p99_ns\":{rep.p99_ns()}"
    + f",\"round_p999_ns\":{rep.p999_ns()},\"round_max_ns\":{rep.max_ns()}}}");
  return 0;
}
