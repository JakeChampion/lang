import "./storage_core";
import "./storage_fip";
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

function snapshot(s: storage_core.State): storage_core.State {
  return s;
}

function disk_checksum(s: storage_core.State): i64 {
  let sum = 0i64;
  for i in 0..s.disk.len() {
    sum += (i as i64 + 1i64) * s.disk[i];
  }
  return sum;
}

function data_checksum(s: storage_core.State): i64 {
  let sum = disk_checksum(s);
  for i in 0..s.cache.len() {
    sum += (i as i64 + 1i64) * s.cache[i];
  }
  for i in 0..s.frames {
    sum += (i as i64 + 1i64) * (s.mapped[i] as i64 * 13i64 + s.dirty[i] as i64);
  }
  return sum;
}

function wave(own s: storage_core.State, round: i32, mode: string): storage_core.State {
  let depth = s.capacity;
  let kind = match (round % 4) { 2 => 0, 3 => 3, _ => round % 4 + 1 };
  let delay = if (mode == "delayed") { 17 } else { 0 };
  let start = s.tick;
  for p in 0..depth {
    let value = (round as i64 + 1i64) * 17i64 + p as i64 - 1000000i64;
    let fault = mode == "faulted" && (round * depth + p) % 11 == 0;
    s = storage_fip.submit(s, kind, p, round / 4 % 8, value, delay, fault);
    if (s.status != 0 || s.result_slot != p) {
      return storage_core.result(s, 90, -1, 0i64, 0i64);
    }
  }
  s = storage_fip.submit(s, 0, 0, 0, 0i64, 0, false);
  if (s.status != 2) {
    return storage_core.result(s, 91, -1, 0i64, 0i64);
  }
  let remaining = depth;
  let latency = 0i64;
  while (remaining > 0) {
    let slot = s.cursor;
    let before = s.phase[slot];
    s = storage_fip.advance(s);
    if (s.status != 0 || s.work != 1 || s.tick - start > (delay as i64 + 2i64) * (depth as i64)) {
      return storage_core.result(s, 92, -1, 0i64, 0i64);
    }
    if (before != 3 && s.phase[slot] == 3) {
      remaining -= 1;
      latency += s.tick - start;
    }
  }
  let errors = 0;
  let checks = 0i64;
  for p in 0..depth {
    let ticket = s.ticket[p];
    s = storage_fip.collect(s, p, ticket);
    if (s.status != 0) {
      errors += 1;
    }
    checks += (p as i64 + 1i64) * (s.status as i64 * 1000003i64 + s.result_value);
  }
  return storage_core.result(s, 0, errors, latency, checks);
}

function run(depth: i32, waves: i32, mode: string, sharing: string, export_samples: boolean): i32 {
  let start_allocs = bench.alloc_count();
  let start_bytes = bench.bump_bytes();
  let startup = monotonic_ns();
  let samples = __alloc_i64(waves);
  let Some(s) = storage_core.new_state(depth, depth, 8, depth, 1) else {
    return 2;
  };
  let startup_ns = monotonic_ns() - startup;
  let startup_allocs = bench.allocs_after(start_allocs);
  let startup_bytes = bench.fresh_bytes_after(start_bytes);
  let mark = bench.alloc_count();
  let fresh_mark = bench.bump_bytes();
  let started = monotonic_ns();
  let checks = 0i64;
  let snapshots = 0i64;
  let latency = 0i64;
  let max_latency = 0i64;
  let errors = 0i64;
  let first_allocs = 0i64;
  for i in 0..waves {
    let old_tick = s.tick;
    let duration = 0i64;
    let observed = 0i64;
    if (sharing == "shared") {
      let saved = snapshot(s);
      let t0 = monotonic_ns();
      s = wave(s, i, mode);
      duration = monotonic_ns() - t0;
      observed = data_checksum(saved);
    } else {
      observed = data_checksum(s);
      let t0 = monotonic_ns();
      s = wave(s, i, mode);
      duration = monotonic_ns() - t0;
    }
    if (s.status != 0 || s.outstanding != 0) {
      return 3;
    }
    snapshots += observed;
    checks += s.result_value;
    errors += s.result_slot as i64;
    latency += s.result_ticket;
    if (s.tick - old_tick > max_latency) {
      max_latency = s.tick - old_tick;
    }
    samples = samples.with(i, duration);
    if (i == 0) {
      first_allocs = bench.allocs_after(mark);
    }
  }
  let elapsed = monotonic_ns() - started;
  let allocations = bench.allocs_after(mark);
  let fresh = bench.fresh_bytes_after(fresh_mark);
  if (export_samples) {
    for i in 0..waves {
      print(f"sample,{i},{samples[i]}");
    }
  }
  let stats = bench.Report { name: mode, iterations: waves, wall_ns: elapsed, samples_ns: cmp.sort(samples), allocs: allocations, fresh_bytes: fresh };
  print(f"{{\"depth\":{depth},\"waves\":{waves}"
    + f",\"mode\":\"{mode}\",\"sharing\":\"{sharing}\""
    + f",\"accepted\":{s.serial},\"completed\":{s.serial}"
    + f",\"errors\":{errors},\"refusals\":{waves}"
    + f",\"checksum\":{checks},\"snapshot_checks\":{snapshots}"
    + f",\"disk_checksum\":{disk_checksum(s)},\"data_checksum\":{data_checksum(s)}"
    + f",\"logical_ticks\":{s.tick},\"logical_latency_sum\":{latency}"
    + f",\"logical_latency_max\":{max_latency},\"scheduling_work\":{s.tick}"
    + f",\"startup_ns\":{startup_ns},\"startup_allocs\":{startup_allocs}"
    + f",\"startup_fresh_bytes\":{startup_bytes},\"wall_ns\":{elapsed}"
    + f",\"allocs\":{allocations},\"first_wave_allocs\":{first_allocs}"
    + f",\"fresh_bytes\":{fresh},\"wave_p50_ns\":{stats.p50_ns()}"
    + f",\"wave_p95_ns\":{stats.p95_ns()},\"wave_p99_ns\":{stats.p99_ns()}"
    + f",\"wave_p999_ns\":{stats.p999_ns()},\"wave_max_ns\":{stats.max_ns()}}}");
  if (sharing == "unique" && allocations != 0i64) {
    return 4;
  }
  return 0;
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 5 || argv.len() > 6) {
    return 2;
  }
  let Ok(depth) = i32.parse_i32(argv[1]) else {
    return 2;
  };
  let Ok(waves) = i32.parse_i32(argv[2]) else {
    return 2;
  };
  if (depth < 1 || depth > 128 || waves < 1 || waves > 10000) {
    return 2;
  }
  if (argv[3] != "plain" && argv[3] != "delayed" && argv[3] != "faulted" || argv[4] != "unique" && argv[4] != "shared") {
    return 2;
  }
  if (argv.len() == 6 && argv[5] != "samples") {
    return 2;
  }
  return run(depth, waves, argv[3], argv[4], argv.len() == 6);
}
