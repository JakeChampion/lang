// Usage: broker subscribers occupancy turns flow|full unique|shared [samples]
import "./broker_core";
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

function payload(serial: i64): i64 {
  return serial * 17i64 - 1000000i64;
}

function oldest(b: broker_core.Broker): broker_core.Message {
  return broker_core.slot_message(b, b.queues[b.heads[0]]);
}

function queued_checksum(b: broker_core.Broker): i64 {
  let sum: i64 = 0i64;
  let i: i32 = 0;
  while (i < b.lengths[0]) {
    let slot: i32 = b.queues[(b.heads[0] + i) % b.queue_capacity];
    sum = sum + broker_core.slot_message(b, slot).payload;
    i = i + 1;
  }
  return sum;
}

function turnover(own b: broker_core.Broker, serial: i64): broker_core.Broker {
  let s: i32 = 0;
  while (s < b.subscribers) {
    b = broker_core.consume(b, s);
    if (b.status != 0 || broker_core.message(b, s).serial != serial || broker_core.message(b, s).payload != payload(serial)) {
      return broker_core.result(b, 90, -1);
    }
    b = broker_core.acknowledge(b, s, serial);
    if (b.status != 0) {
      return broker_core.result(b, 91, -1);
    }
    s = s + 1;
  }
  let next: i64 = b.serial + 1i64;
  b = broker_core.reserve(b, 0, payload(next));
  if (b.status != 0) {
    return broker_core.result(b, 92, -1);
  }
  return broker_core.publish(b);
}

function operation(own b: broker_core.Broker, serial: i64, mode: string): broker_core.Broker {
  if (mode == "full") {
    return broker_core.publish(b);
  }
  return turnover(b, serial);
}

function run(subscribers: i32, occupancy: i32, turns: i32, mode: string, sharing: string, export_samples: boolean): i32 {
  let startup_mark: i64 = bench.alloc_count();
  let startup_fresh: i64 = bench.bump_bytes();
  let startup: i64 = monotonic_ns();
  let samples: i64[] = __alloc_i64(turns);
  let pool: i32 = occupancy;
  if (mode == "full") {
    pool = pool + 1;
  }
  match (broker_core.new_broker(1, subscribers, pool, occupancy)) {
    None => {
      return 2;
    },
    Some(b) => {
      let fill_mark: i64 = bench.alloc_count();
      let i: i32 = 0;
      while (i < occupancy) {
        b = broker_core.reserve(b, 0, payload(i as i64 + 1i64));
        b = broker_core.publish(b);
        if (b.status != 0) {
          return 3;
        }
        i = i + 1;
      }
      if (mode == "full") {
        b = broker_core.reserve(b, 0, payload(occupancy as i64 + 1i64));
        if (b.status != 0) {
          return 4;
        }
      }
      let fill_allocs: i64 = bench.allocs_after(fill_mark);
      let startup_ns: i64 = monotonic_ns() - startup;
      let startup_allocs: i64 = bench.allocs_after(startup_mark);
      let startup_bytes: i64 = bench.fresh_bytes_after(startup_fresh);
      let mark: i64 = bench.alloc_count();
      let fresh_mark: i64 = bench.bump_bytes();
      let started: i64 = monotonic_ns();
      let checks: i64 = 0i64;
      let first_allocs: i64 = 0i64;
      i = 0;
      while (i < turns) {
        let serial: i64 = i as i64 + 1i64;
        let expected_status: i32 = 0;
        if (mode == "full") {
          serial = 1i64;
          expected_status = 4;
        }
        let observed: i64 = 0i64;
        let duration: i64 = 0i64;
        if (sharing == "shared") {
          let saved: broker_core.Message = oldest(b);
          let t0: i64 = monotonic_ns();
          b = operation(b, serial, mode);
          duration = monotonic_ns() - t0;
          observed = saved.payload;
          if (saved.serial != serial) {
            return 5;
          }
        } else {
          observed = oldest(b).payload;
          if (oldest(b).serial != serial) {
            return 5;
          }
          let t0: i64 = monotonic_ns();
          b = operation(b, serial, mode);
          duration = monotonic_ns() - t0;
        }
        if (b.status != expected_status || observed != payload(serial)) {
          return 6;
        }
        checks = checks + observed;
        samples = samples.with(i, duration);
        if (i == 0) {
          first_allocs = bench.allocs_after(mark);
        }
        i = i + 1;
      }
      let elapsed: i64 = monotonic_ns() - started;
      let allocations: i64 = bench.allocs_after(mark);
      let fresh: i64 = bench.fresh_bytes_after(fresh_mark);
      let deliveries: i64 = turns as i64 * (subscribers as i64);
      let refused: i32 = 0;
      if (mode == "full") {
        deliveries = 0i64;
        refused = turns;
      }
      if (export_samples) {
        i = 0;
        while (i < turns) {
          print("sample," + i.to_string() + "," + samples[i].to_string());
          i = i + 1;
        }
      }
      let stats: bench.Report = bench.Report { name: mode, iterations: turns, wall_ns: elapsed, samples_ns: cmp.sort(samples), allocs: allocations, fresh_bytes: fresh };
      print("{\"subscribers\":" + subscribers.to_string() + ",\"occupancy\":" + occupancy.to_string()
        + ",\"turns\":" + turns.to_string() + ",\"mode\":\"" + mode + "\",\"sharing\":\"" + sharing + "\""
        + ",\"observed_checksum\":" + checks.to_string() + ",\"queued_checksum\":" + queued_checksum(b).to_string()
        + ",\"serial\":" + b.serial.to_string() + ",\"deliveries\":" + deliveries.to_string()
        + ",\"refusals\":" + refused.to_string() + ",\"free_slots\":" + b.free_count.to_string()
        + ",\"producer_slot\":" + b.producer_slot.to_string() + ",\"fill_allocs\":" + fill_allocs.to_string()
        + ",\"startup_ns\":" + startup_ns.to_string() + ",\"startup_allocs\":" + startup_allocs.to_string()
        + ",\"startup_fresh_bytes\":" + startup_bytes.to_string() + ",\"wall_ns\":" + elapsed.to_string()
        + ",\"allocs\":" + allocations.to_string() + ",\"first_turn_allocs\":" + first_allocs.to_string()
        + ",\"fresh_bytes\":" + fresh.to_string() + ",\"turn_p50_ns\":" + stats.p50_ns().to_string()
        + ",\"turn_p95_ns\":" + stats.p95_ns().to_string() + ",\"turn_p99_ns\":" + stats.p99_ns().to_string()
        + ",\"turn_p999_ns\":" + stats.p999_ns().to_string() + ",\"turn_max_ns\":" + stats.max_ns().to_string() + "}");
      if (fill_allocs != 0i64 || sharing == "unique" && allocations != 0i64) {
        return 7;
      }
      return 0;
    }
  }
}

function main(): i32 {
  let argv: string[] = args();
  if (argv.len() < 6 || argv.len() > 7) {
    return 2;
  }
  let subscribers: i32 = 0;
  let occupancy: i32 = 0;
  let turns: i32 = 0;
  match (argv[1].parse_int()) {
    Some(n) => {
      subscribers = n;
    },
    None => {
      return 2;
    }
  }
  match (argv[2].parse_int()) {
    Some(n) => {
      occupancy = n;
    },
    None => {
      return 2;
    }
  }
  match (argv[3].parse_int()) {
    Some(n) => {
      turns = n;
    },
    None => {
      return 2;
    }
  }
  if (subscribers < 1 || subscribers > 16 || occupancy < 1 || occupancy > 4096 || turns < 1 || turns > 1000000) {
    return 2;
  }
  if (argv[4] != "flow" && argv[4] != "full" || argv[4] == "full" && occupancy == 4096) {
    return 2;
  }
  if (argv[5] != "unique" && argv[5] != "shared") {
    return 2;
  }
  if (argv.len() == 7 && argv[6] != "samples") {
    return 2;
  }
  return run(subscribers, occupancy, turns, argv[4], argv[5], argv.len() == 7);
}
