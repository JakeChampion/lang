import "./broker_core";
import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";
import "std/string";

function payload(serial: i64): i64 {
  return serial * 17i64 - 1000000i64;
}

function oldest(b: broker_core.Broker): broker_core.Message {
  return broker_core.slot_message(b, b.queues[b.heads[0]]);
}

function queued_checksum(b: broker_core.Broker): i64 {
  let sum = 0i64;
  for i in 0..b.lengths[0] {
    let slot = b.queues[(b.heads[0] + i) % b.queue_capacity];
    sum += broker_core.slot_message(b, slot).payload;
  }
  return sum;
}

function turnover(own b: broker_core.Broker, serial: i64): broker_core.Broker {
  for s in 0..b.subscribers {
    b = broker_core.consume(b, s);
    if (b.status != 0 || broker_core.message(b, s).serial != serial || broker_core.message(b, s).payload != payload(serial)) {
      return broker_core.result(b, 90, -1);
    }
    b = broker_core.acknowledge(b, s, serial);
    if (b.status != 0) {
      return broker_core.result(b, 91, -1);
    }
  }
  let next = b.serial + 1i64;
  b = broker_core.reserve(b, 0, payload(next));
  if (b.status != 0) {
    return broker_core.result(b, 92, -1);
  }
  return broker_core.publish(b);
}

function operation(own b: broker_core.Broker, serial: i64, mode: string): broker_core.Broker {
  if (mode == "full") {
    return broker_core.publish(b);
  }
  return turnover(b, serial);
}

function run(subscribers: i32, occupancy: i32, turns: i32, mode: string, sharing: string, export_samples: boolean): i32 {
  let startup_mark = bench.alloc_count();
  let startup_fresh = bench.bump_bytes();
  let startup = monotonic_ns();
  let samples = __alloc_i64(turns);
  let pool = if (mode == "full") { occupancy + 1 } else { occupancy };
  let Some(b) = broker_core.new_broker(1, subscribers, pool, occupancy) else {
    return 2;
  };
  let fill_mark = bench.alloc_count();
  for i in 0..occupancy {
    b = broker_core.reserve(b, 0, payload(i as i64 + 1i64));
    b = broker_core.publish(b);
    if (b.status != 0) {
      return 3;
    }
  }
  if (mode == "full") {
    b = broker_core.reserve(b, 0, payload(occupancy as i64 + 1i64));
    if (b.status != 0) {
      return 4;
    }
  }
  let fill_allocs = bench.allocs_after(fill_mark);
  let startup_ns = monotonic_ns() - startup;
  let startup_allocs = bench.allocs_after(startup_mark);
  let startup_bytes = bench.fresh_bytes_after(startup_fresh);
  let mark = bench.alloc_count();
  let fresh_mark = bench.bump_bytes();
  let started = monotonic_ns();
  let checks = 0i64;
  let first_allocs = 0i64;
  for i in 0..turns {
    let serial = if (mode == "full") { 1i64 } else { i as i64 + 1i64 };
    let expected_status = if (mode == "full") { 4 } else { 0 };
    let observed = 0i64;
    let duration = 0i64;
    if (sharing == "shared") {
      let saved = oldest(b);
      let t0 = monotonic_ns();
      b = operation(b, serial, mode);
      duration = monotonic_ns() - t0;
      observed = saved.payload;
      if (saved.serial != serial) {
        return 5;
      }
    } else {
      observed = oldest(b).payload;
      if (oldest(b).serial != serial) {
        return 5;
      }
      let t0 = monotonic_ns();
      b = operation(b, serial, mode);
      duration = monotonic_ns() - t0;
    }
    if (b.status != expected_status || observed != payload(serial)) {
      return 6;
    }
    checks += observed;
    samples = samples.with(i, duration);
    if (i == 0) {
      first_allocs = bench.allocs_after(mark);
    }
  }
  let elapsed = monotonic_ns() - started;
  let allocations = bench.allocs_after(mark);
  let fresh = bench.fresh_bytes_after(fresh_mark);
  let deliveries = if (mode == "full") { 0i64 } else { turns as i64 * (subscribers as i64) };
  let refused = if (mode == "full") { turns } else { 0 };
  if (export_samples) {
    for i in 0..turns {
      print(f"sample,{i},{samples[i]}");
    }
  }
  let stats = bench.Report { name: mode, iterations: turns, wall_ns: elapsed, samples_ns: cmp.sort(samples), allocs: allocations, fresh_bytes: fresh };
  print(f"{{\"subscribers\":{subscribers},\"occupancy\":{occupancy},\"turns\":{turns},\"mode\":\"{mode}\",\"sharing\":\"{sharing}\""
    + f",\"observed_checksum\":{checks},\"queued_checksum\":{queued_checksum(b)}"
    + f",\"serial\":{b.serial},\"deliveries\":{deliveries},\"refusals\":{refused},\"free_slots\":{b.free_count}"
    + f",\"producer_slot\":{b.producer_slot},\"fill_allocs\":{fill_allocs}"
    + f",\"startup_ns\":{startup_ns},\"startup_allocs\":{startup_allocs},\"startup_fresh_bytes\":{startup_bytes}"
    + f",\"wall_ns\":{elapsed},\"allocs\":{allocations},\"first_turn_allocs\":{first_allocs},\"fresh_bytes\":{fresh}"
    + f",\"turn_p50_ns\":{stats.p50_ns()},\"turn_p95_ns\":{stats.p95_ns()},\"turn_p99_ns\":{stats.p99_ns()}"
    + f",\"turn_p999_ns\":{stats.p999_ns()},\"turn_max_ns\":{stats.max_ns()}}}");
  if (fill_allocs != 0i64 || sharing == "unique" && allocations != 0i64) {
    return 7;
  }
  return 0;
}

function main(): i32 {
  let argv = args();
  if (argv.len() < 6 || argv.len() > 7) {
    return 2;
  }
  let Ok(subscribers) = i32.parse_i32(argv[1]) else {
    return 2;
  };
  let Ok(occupancy) = i32.parse_i32(argv[2]) else {
    return 2;
  };
  let Ok(turns) = i32.parse_i32(argv[3]) else {
    return 2;
  };
  if (subscribers < 1 || subscribers > 16 || occupancy < 1 || occupancy > 4096 || turns < 1 || turns > 1000000) {
    return 2;
  }
  if (argv[4] != "flow" && argv[4] != "full" || argv[4] == "full" && occupancy == 4096) {
    return 2;
  }
  if (argv[5] != "unique" && argv[5] != "shared") {
    return 2;
  }
  if (argv.len() == 7 && argv[6] != "samples") {
    return 2;
  }
  return run(subscribers, occupancy, turns, argv[4], argv[5], argv.len() == 7);
}
