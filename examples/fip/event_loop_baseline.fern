import "core/cmp";
import "std/bench";
import "std/i32";
import "std/i64";

function max_entries(): i32 {
  return 256;
}

function queue_cap(): i32 {
  return 64;
}

enum Event {
  Create(i64, i64),
  Update(i64, i64),
  Read(i64),
  Delete(i64),
}

enum Response {
  Ok,
  Missing,
  Full,
  Value(i64),
}

struct Entry { key: i64, value: i64 }

struct State {
  entries: Entry[],
  queue: Event[],
  out: Response[],
  m_ok: i64,
  m_miss: i64,
  m_full: i64,
  m_dropped: i64,
}

function new_state(): State {
  let none: Entry[] = [];
  let q: Event[] = [];
  let o: Response[] = [];
  return State {
    entries: none, queue: q, out: o,
    m_ok: 0i64, m_miss: 0i64, m_full: 0i64, m_dropped: 0i64,
  };
}

function enqueue(s: State, e: Event): State {
  if (s.queue.len() >= queue_cap()) {
    return State { ...s, m_dropped: s.m_dropped + 1i64 };
  }
  return State { ...s, queue: s.queue.append(e) };
}

function respond(s: State, r: Response): State {
  return State { ...s, out: s.out.append(r) };
}

function find_slot(entries: Entry[], id: i64): Option[i32] {
  for i in 0..entries.len() {
    if (entries[i].key == id) {
      return Some(i);
    }
  }
  return None;
}

function apply_create(s: State, id: i64, value: i64): State {
  if let Some(at) = find_slot(s.entries, id) {
    let updated = s.entries.with(at, Entry { key: id, value: value });
    return respond(State { ...s, entries: updated, m_ok: s.m_ok + 1i64 }, Response.Ok);
  }
  if (s.entries.len() >= max_entries()) {
    return respond(State { ...s, m_full: s.m_full + 1i64 }, Response.Full);
  }
  let grown = s.entries.append(Entry { key: id, value: value });
  return respond(State { ...s, entries: grown, m_ok: s.m_ok + 1i64 }, Response.Ok);
}

function apply_update(s: State, id: i64, delta: i64): State {
  let Some(at) = find_slot(s.entries, id) else {
    return respond(State { ...s, m_miss: s.m_miss + 1i64 }, Response.Missing);
  };
  let e = s.entries[at];
  let updated = s.entries.with(at, Entry { ...e, value: e.value + delta });
  return respond(State { ...s, entries: updated, m_ok: s.m_ok + 1i64 }, Response.Ok);
}

function apply_read(s: State, id: i64): State {
  let Some(at) = find_slot(s.entries, id) else {
    return respond(State { ...s, m_miss: s.m_miss + 1i64 }, Response.Missing);
  };
  let e = s.entries[at];
  return respond(State { ...s, m_ok: s.m_ok + 1i64 }, Response.Value(e.value));
}

function apply_delete(s: State, id: i64): State {
  let Some(at) = find_slot(s.entries, id) else {
    return respond(State { ...s, m_miss: s.m_miss + 1i64 }, Response.Missing);
  };
  let kept: Entry[] = [];
  for i in 0..s.entries.len() {
    if (i != at) {
      kept = kept.append(s.entries[i]);
    }
  }
  return respond(State { ...s, entries: kept, m_ok: s.m_ok + 1i64 }, Response.Ok);
}

function iteration(s: State): State {
  if (s.queue.len() == 0) {
    return s;
  }
  let head = s.queue[0];
  let rest: Event[] = [];
  for i in 1..s.queue.len() {
    rest = rest.append(s.queue[i]);
  }
  let t = State { ...s, queue: rest };
  match (head) {
    Create(id, value) => {
      return apply_create(t, id, value);
    },
    Update(id, delta) => {
      return apply_update(t, id, delta);
    },
    Read(id) => {
      return apply_read(t, id);
    },
    Delete(id) => {
      return apply_delete(t, id);
    }
  }
}

function drain_output(s: State): State {
  let empty: Response[] = [];
  return State { ...s, out: empty };
}

function reset_metrics(s: State): State {
  return State { ...s, m_ok: 0i64, m_miss: 0i64, m_full: 0i64, m_dropped: 0i64 };
}

function event_id(n: i64): i64 {
  let x = n * 2654435761i64;
  x ^= x >> 15i64;
  x *= 2246822519i64;
  x ^= x >> 13i64;
  if (x < 0i64) {
    x = -x;
  }
  return x % (max_entries() as i64);
}

function event_of(n: i64): Event {
  let bucket = n % 10i64;
  let id = event_id(n);
  if (bucket == 0i64) {
    return Create(id, n);
  }
  if (bucket == 1i64) {
    return Delete(id);
  }
  if (bucket < 4i64) {
    return Update(id, n);
  }
  return Read(id);
}

function prefill(s: State): State {
  let t = s;
  for id in 0..max_entries() {
    t = apply_create(t, id as i64, id as i64 * 10i64);
  }
  return drain_output(t);
}

function round(s: State, seed: i64, batch: i32): State {
  let t = s;
  for i in 0..batch {
    t = enqueue(t, event_of(seed + i as i64));
  }
  for _ in 0..batch {
    t = iteration(t);
  }
  return drain_output(t);
}

function main(): i32 {
  let s = new_state();
  s = prefill(s);
  s = round(s, 1i64, queue_cap());
  s = reset_metrics(s);
  let rounds = 20000;
  let samples: i64[] = [];
  for _ in 0..rounds {
    samples = samples.append(0i64);
  }
  let at_allocs = bench.alloc_count();
  let at_fresh = bench.bump_bytes();
  let started_ns = monotonic_ns();
  for r in 0..rounds {
    let t0 = monotonic_ns();
    s = round(s, r as i64 * 7i64 + 1i64, queue_cap());
    samples = samples.with(r, monotonic_ns() - t0);
  }
  let elapsed_ns = monotonic_ns() - started_ns;
  let allocs = bench.allocs_after(at_allocs);
  let fresh = bench.fresh_bytes_after(at_fresh);
  let events = rounds as i64 * (queue_cap() as i64);
  let rep = bench.Report {
    name: "baseline",
    iterations: rounds,
    wall_ns: elapsed_ns,
    samples_ns: cmp.sort(samples),
    allocs: allocs,
    fresh_bytes: fresh,
  };
  print(f"{{\"variant\":\"baseline\",\"events\":{events}"
    + f",\"events_per_round\":{queue_cap()}"
    + f",\"live_entries\":{s.entries.len()}"
    + f",\"ok\":{s.m_ok}"
    + f",\"missing\":{s.m_miss}"
    + f",\"table_full\":{s.m_full}"
    + f",\"dropped\":{s.m_dropped}"
    + f",\"steady_allocs\":{allocs}"
    + f",\"steady_fresh_bytes\":{fresh}"
    + f",\"allocs_per_event_milli\":{allocs * 1000i64 / events}"
    + f",\"ns_per_event\":{elapsed_ns / events}"
    + f",\"events_per_sec\":{events * 1000000000i64 / elapsed_ns}"
    + f",\"round_p50_ns\":{rep.p50_ns()}"
    + f",\"round_p95_ns\":{rep.p95_ns()}"
    + f",\"round_p99_ns\":{rep.p99_ns()}"
    + f",\"round_p999_ns\":{rep.p999_ns()}"
    + f",\"round_max_ns\":{rep.max_ns()}}}");
  return 0;
}
