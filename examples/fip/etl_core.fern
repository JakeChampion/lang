pub struct Record {
  sensor: i32,
  quality: i32,
  value: i32,
}

pub struct State {
  capacity: i32,
  seen: i64,
  invalid: i64,
  filtered: i64,
  accepted: i64,
  refused: i64,
  total: i64,
  low: i32,
  high: i32,
  histogram: i64[],
  output: u8[],
  output_count: i32,
  scratch: Record,
}

pub function new_state(capacity: i32): State {
  return State {
    capacity: capacity, seen: 0i64, invalid: 0i64, filtered: 0i64,
    accepted: 0i64, refused: 0i64, total: 0i64, low: 16501, high: -1,
    histogram: __alloc_i64(16), output: __alloc_u8(capacity * 8), output_count: 0,
    scratch: Record { sensor: 0, quality: 0, value: 0 },
  };
}

pub fip function reset(own s: State): State {
  let i: i32 = 0;
  while (i < 16) {
    s = State { ...s, histogram: s.histogram.with(i, 0i64) };
    i = i + 1;
  }
  return State {
    ...s, seen: 0i64, invalid: 0i64, filtered: 0i64,
    accepted: 0i64, refused: 0i64, total: 0i64, low: 16501, high: -1,
    output_count: 0,
  };
}

pub fip function read16(data: u8[], at: i32): i32 {
  return data[at] as i32 | data[at + 1] as i32 << 8;
}

pub fip function reading(data: u8[], at: i32): i32 {
  let value: i32 = read16(data, at + 2);
  if (value >= 32768) {
    return value - 65536;
  }
  return value;
}

pub fip function valid(sensor: i32, quality: i32, value: i32): boolean {
  return sensor < 16 && quality < 4 && value >= -4000 && value <= 12500;
}

pub fip function bucket(value: i32): i32 {
  let bin: i32 = value / 1024;
  if (bin > 15) {
    return 15;
  }
  return bin;
}

pub fip function write32(own out: u8[], at: i32, value: i32): u8[] {
  out = out.with(at, (value & 255) as u8);
  out = out.with(at + 1, (value >> 8 & 255) as u8);
  out = out.with(at + 2, (value >> 16 & 255) as u8);
  return out.with(at + 3, (value >> 24 & 255) as u8);
}

pub fip function encode(own out: u8[], pos: i32, normalized: i32, data: u8[], at: i32): u8[] {
  out = write32(out, pos, normalized);
  let i: i32 = 0;
  while (i < 4) {
    out = out.with(pos + 4 + i, data[at + 4 + i]);
    i = i + 1;
  }
  return out;
}

// Eight bytes: sensor, quality, signed little-endian centidegrees, sequence.
pub function dataset(records: i32): u8[] {
  let data: u8[] = __alloc_u8(records * 8);
  for i in 0..records {
    let sensor: i32 = i % 16;
    if (i % 19 == 0) {
      sensor = 255;
    }
    let quality: i32 = i % 4;
    if (i % 23 == 0) {
      quality = 7;
    }
    let value: i32 = (i as i64 * 173i64 % 20000i64) as i32 - 5000;
    let at: i32 = i * 8;
    data = data.with(at, sensor as u8);
    data = data.with(at + 1, quality as u8);
    data = data.with(at + 2, (value & 255) as u8);
    data = data.with(at + 3, (value >> 8 & 255) as u8);
    data = write32(data, at + 4, i);
  }
  return data;
}

pub fip function fits(s: State, data: u8[], offset: i32, count: i32): boolean {
  if (count < 0 || count > s.capacity || offset < 0 || offset > data.len()) {
    return false;
  }
  return count <= (data.len() - offset) / 8;
}

pub fip function refuse(own s: State): State {
  return State { ...s, refused: s.refused + 1i64, output_count: 0 };
}

pub fip function apply(own s: State, data: u8[], at: i32, sensor: i32, quality: i32, value: i32): State {
  s = State { ...s, seen: s.seen + 1i64 };
  if (!valid(sensor, quality, value)) {
    return State { ...s, invalid: s.invalid + 1i64 };
  }
  if (quality < 2) {
    return State { ...s, filtered: s.filtered + 1i64 };
  }
  let normalized: i32 = value + 4000;
  let bin: i32 = bucket(normalized);
  let low: i32 = s.low;
  let high: i32 = s.high;
  if (normalized < low) {
    low = normalized;
  }
  if (normalized > high) {
    high = normalized;
  }
  let hits: i64 = s.histogram[bin] + 1i64;
  let pos: i32 = s.output_count;
  s = State { ...s, histogram: s.histogram.with(bin, hits) };
  s = State { ...s, output: encode(s.output, pos * 8, normalized, data, at) };
  return State {
    ...s, accepted: s.accepted + 1i64, total: s.total + normalized as i64,
    low: low, high: high, output_count: pos + 1,
  };
}

pub fip function record(own s: State, data: u8[], at: i32): State {
  return apply(s, data, at, data[at] as i32, data[at + 1] as i32, reading(data, at));
}

pub fip function process(own s: State, data: u8[], offset: i32, count: i32): State {
  if (!fits(s, data, offset, count)) {
    return refuse(s);
  }
  s = State { ...s, output_count: 0 };
  let i: i32 = 0;
  while (i < count) {
    s = record(s, data, offset + i * 8);
    i = i + 1;
  }
  return s;
}
