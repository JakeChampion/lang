import "std/http";
import "std/serve";
import "std/url";
import "std/json";
import "core/map";
import "std/string";
import "std/platform";

function values_as_jarray(values: string[]): json.JsonValue {
  let arr: json.JsonValue[] = [];
  let i: i32 = 0;
  while (i < values.len()) {
    arr = arr.append(JString(values[i]));
    i = i + 1;
  }
  return JArray(arr);
}

function describe(path: string, q: Map[string, string[]]): json.JsonValue {
  let out: json.JsonObject = json.object();
  out = out.insert("path", JString(path));
  match (q.get("q")) {
    Some(qs) => {
      if (qs.len() > 0) {
        out = out.insert("q", JString(qs[0]));
      }
    },
    None => {}
  }
  match (q.get("tag")) {
    Some(tags) => {
      out = out.insert("tags", values_as_jarray(tags));
    },
    None => {}
  }
  return JObject(out);
}

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  let full: string = "http://example.local" + req.path;
  match (url.url_parse(full)) {
    None => {
      return http.bad_request("bad URL\n");
    },
    Some(u) => {
      let q: Map[string, string[]] = url.query_parse(u.query);
      let body: string = describe(u.path, q) |> json.json_encode;
      return http.ok(body);
    }
  }
  return http.internal_error("unreachable\n");
}
