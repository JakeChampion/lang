import "std/http";
import "std/serve";
import "std/url";
import "std/json";
import "core/map";
import "std/string";
import "std/platform";

function values_as_jarray(values: string[]): json.JsonValue {
  let arr: json.JsonValue[] = [];
  for v in values {
    arr = arr.append(JString(v));
  }
  return JArray(arr);
}

function describe(path: string, q: Map[string, string[]]): json.JsonValue {
  let out = json.object().insert("path", JString(path));
  if let Some(qs) = q.get("q") {
    if (qs.len() > 0) {
      out = out.insert("q", JString(qs[0]));
    }
  }
  if let Some(tags) = q.get("tag") {
    out = out.insert("tags", values_as_jarray(tags));
  }
  return JObject(out);
}

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  let Ok(u) = url.parse("http://example.local" + req.path) else {
    return http.bad_request("bad URL\n");
  };
  let body = describe(u.path, url.query_parse(u.query)) |> json.encode;
  return http.ok(body);
}
