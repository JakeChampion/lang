import "std/http";
import "std/serve";
import "std/i32";
import "std/platform";

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  return match (req.body_text()) { Ok(text) => http.ok(f"{req.method} {req.path} ({req.body_len()} bytes)\n\n{text}"), Err(e) => e.to_response() };
}
