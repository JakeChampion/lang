import "std/io";
import "std/json";
import "std/string";

function pretty(v: json.JsonValue, depth: i32): string {
  let pad = "  ".repeat(depth);
  let pad_inner = "  ".repeat(depth + 1);
  match (v) {
    JNull => {
      return "null";
    },
    JBool(b) => {
      if (b) {
        return "true";
      }
      return "false";
    },
    JNumber(n) => {
      return n;
    },
    JString(s) => {
      return json.encode(JString(s));
    },
    JArray(elems) => {
      if (elems.len() == 0) {
        return "[]";
      }
      let arr_out = "[\n";
      let i = 0;
      while (i < elems.len()) {
        arr_out = arr_out + pad_inner + pretty(elems[i], depth + 1);
        if (i + 1 < elems.len()) {
          arr_out += ",";
        }
        arr_out += "\n";
        i += 1;
      }
      return arr_out + pad + "]";
    },
    JObject(m) => {
      if (m.len() == 0) {
        return "{}";
      }
      let obj_out = "{\n";
      let keys = m.keys();
      let values = m.values();
      let i = 0;
      while (i < keys.len()) {
        if (i > 0) {
          obj_out += ",\n";
        }
        obj_out = obj_out + pad_inner + json.encode(JString(keys[i])) + ": " + pretty(values[i], depth + 1);
        i += 1;
      }
      return obj_out + "\n" + pad + "}";
    }
  }
  return "";
}

function main(): i32 {
  let input = "";
  match (io.read_all_stdin()) {
    Ok(t) => {
      input = t;
    },
    Err(_) => {
      eprint("json_pretty: cannot read stdin");
      return 1;
    }
  }
  match (json.parse(input)) {
    Ok(v) => {
      print(pretty(v, 0));
      return 0;
    },
    Err(_) => {
      eprint("json_pretty: malformed input");
      return 1;
    }
  }
  return 0;
}
