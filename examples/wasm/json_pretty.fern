import "std/io";
import "std/json";
import "std/string";

function pretty(v: json.JsonValue, depth: i32): string {
  let pad = "  ".repeat(depth);
  let pad_inner = "  ".repeat(depth + 1);
  match (v) {
    JNull => {
      return "null";
    },
    JBool(b) => {
      return if (b) { "true" } else { "false" };
    },
    JNumber(n) => {
      return n;
    },
    JString(s) => {
      return json.encode(JString(s));
    },
    JArray(elems) => {
      if (elems.len() == 0) {
        return "[]";
      }
      let arr_out = "[\n";
      for i in 0..elems.len() {
        arr_out += pad_inner + pretty(elems[i], depth + 1);
        if (i + 1 < elems.len()) {
          arr_out += ",";
        }
        arr_out += "\n";
      }
      return f"{arr_out}{pad}]";
    },
    JObject(m) => {
      if (m.len() == 0) {
        return "{}";
      }
      let obj_out = "{\n";
      let keys = m.keys();
      let values = m.values();
      for i in 0..keys.len() {
        if (i > 0) {
          obj_out += ",\n";
        }
        obj_out += f"{pad_inner}{json.encode(JString(keys[i]))}: {pretty(values[i], depth + 1)}";
      }
      return f"{obj_out}\n{pad}}}";
    }
  }
}

function main(): i32 {
  let Ok(input) = io.read_all_stdin() else {
    eprint("json_pretty: cannot read stdin");
    return 1;
  };
  let Ok(v) = json.parse(input) else {
    eprint("json_pretty: malformed input");
    return 1;
  };
  print(pretty(v, 0));
  return 0;
}
