// json_pretty.fern — read JSON from stdin, pretty-print to
// stdout with 2-space indents.
//
// Showcases: std/json's JsonValue enum, recursive
// match (over JNull / JBool / JNumber / JString / JArray /
// JObject), an object's members in document order, the
// `s.repeat(n)` indentation helper, build-once-print-once.
// The parser's intermediate allocations are reclaimed by
// reference counting as they fall out of scope; for CLI mode
// the OS reaps the heap on exit anyway (main runs once).
//
//   $ echo '{"a":1,"b":[true,null,3.14]}' | wasmtime json_pretty.wasm
//   {
//     "a": 1,
//     "b": [
//       true,
//       null,
//       3.14
//     ]
//   }
// json.json_parse / json.json_encode for the read/write halves;
// std/string for (string).repeat used by the indent helper.
import "std/io";
import "std/json";
import "std/string";

function pretty(v: json.JsonValue, depth: i32): string {
  let pad: string = "  ".repeat(depth);
  let pad_inner: string = "  ".repeat(depth + 1);
  match (v) {
    JNull => {
      return "null";
    },
    JBool(b) => {
      if (b) {
        return "true";
      }
      return "false";
    },
    JNumber(n) => {
      return n;
    },
    JString(s) => {
      // Round-trip via json_encode so escapes are
      // re-applied identically to the parser's input.
      return json.json_encode(JString(s));
    },
    JArray(elems) => {
      if (elems.len() == 0) {
        return "[]";
      }
      let arr_out: string = "[\n";
      let i: i32 = 0;
      while (i < elems.len()) {
        arr_out = arr_out + pad_inner + pretty(elems[i], depth + 1);
        if (i + 1 < elems.len()) {
          arr_out = arr_out + ",";
        }
        arr_out = arr_out + "\n";
        i = i + 1;
      }
      return arr_out + pad + "]";
    },
    JObject(m) => {
      if (m.len() == 0) {
        return "{}";
      }
      let obj_out: string = "{\n";
      let i: i32 = 0;
      while (i < m.len()) {
        if (i > 0) {
          obj_out = obj_out + ",\n";
        }
        obj_out = obj_out + pad_inner + json.json_encode(JString(m.keys()[i])) + ": " + pretty(m.values()[i], depth + 1);
        i = i + 1;
      }
      return obj_out + "\n" + pad + "}";
    }
  }
  return "";  // unreachable
}

function main(): i32 {
  let input: string = "";
  match (io.read_all_stdin()) {
    Ok(t) => {
      input = t;
    },
    Err(_) => {
      eprint("json_pretty: cannot read stdin");
      return 1;
    }
  }
  match (json.json_parse(input)) {
    Some(v) => {
      print(pretty(v, 0));
      return 0;
    },
    None => {
      eprint("json_pretty: malformed input");
      return 1;
    }
  }
  return 0;  // unreachable
}
