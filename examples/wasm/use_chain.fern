import "std/i32";

function adder(n: i32): (i32) => i32 {
  function add(x: i32): i32 {
    return x + n;
  }
  return add;
}

function maybe_double(n: i32, cb: (i32) => Option[i32]): Option[i32] {
  return cb(n + n);
}

function maybe_plus2(n: i32, cb: (i32) => Option[i32]): Option[i32] {
  return cb(n + 2);
}

function chain(start: i32): Option[i32] {
  use a <- maybe_double(start);
  use b <- maybe_double(a);
  use c <- maybe_double(b);
  use d <- maybe_plus2(c);
  return Some(d);
}

function main(): i32 {
  if let Some(n) = chain(1) {
    print(f"triple-doubled then plus two: {n}");
  } else {
    print("triple-doubled then plus two: fail");
  }
  let add7 = adder(7);
  print(f"adder factory: 7 + 35 = {add7(35)}");
  return 0;
}
