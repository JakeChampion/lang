import "std/string";
import "std/i32";
import "std/io_buffered";

struct Counts { lines: i32, words: i32, bytes: i32 }

function count_chunk(chunk: string, acc: Counts): Counts {
  let parts: string[] = chunk.split(" ");
  let nwords: i32 = 0;
  let i: i32 = 0;
  while (i < parts.len()) {
    if (!parts[i].is_empty()) {
      nwords = nwords + 1;
    }
    i = i + 1;
  }
  return Counts {
    ...acc,
    bytes: acc.bytes + chunk.len(),
    lines: acc.lines + 1,
    words: acc.words + nwords,
  };
}

function count_reader(r: Reader): Option[Counts] {
  let acc: Counts = Counts { lines: 0, words: 0, bytes: 0 };
  defer r.close();
  let lr: io_buffered.LineReader = io_buffered.line_reader_new(r, 10, 65536);
  while (true) {
    let (line, next) = lr.next_line();
    lr = next;
    match (line) {
      Some(l) => {
        acc = count_chunk(l, acc);
      },
      None => {
        match (lr.error()) {
          Some(_) => {
            return None;
          },
          None => {
            return Some(acc);
          }
        }
      }
    }
  }
  return Some(acc);
}

function format_counts(label: string, c: Counts): string {
  return f"{c.lines}\t{c.words}\t{c.bytes}\t{label}";
}

function main(): i32 {
  let argv: string[] = args();
  let total: Counts = Counts { lines: 0, words: 0, bytes: 0 };
  let nfiles: i32 = 0;
  let status: i32 = 0;
  let i: i32 = 1;
  while (i < argv.len()) {
    let path: string = argv[i];
    match (open_reader(path)) {
      Ok(r) => {
        match (count_reader(r)) {
          Some(got) => {
            print(format_counts(path, got));
            total = Counts {
              lines: total.lines + got.lines,
              words: total.words + got.words,
              bytes: total.bytes + got.bytes,
            };
            nfiles = nfiles + 1;
          },
          None => {
            eprint("wc: " + path + ": read error");
            status = 1;
          }
        }
      },
      Err(_) => {
        eprint("wc: " + path + ": cannot open");
        status = 1;
      }
    }
    i = i + 1;
  }
  if (argv.len() <= 1) {
    match (count_reader(stdin())) {
      Some(got) => {
        print(format_counts("-", got));
      },
      None => {
        eprint("wc: -: read error");
        return 1;
      }
    }
  } else if (nfiles > 1) {
    print(format_counts("total", total));
  }
  return status;
}
