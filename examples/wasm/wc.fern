import "std/string";
import "std/i32";
import "std/io_buffered";
import "std/array";

struct Counts { lines: i32, words: i32, bytes: i32 }

function count_chunk(chunk: string, acc: Counts): Counts {
  let nwords = 0;
  for part in chunk.split(" ") {
    if (!part.is_empty()) {
      nwords += 1;
    }
  }
  return Counts {
    ...acc,
    bytes: acc.bytes + chunk.len(),
    lines: acc.lines + 1,
    words: acc.words + nwords,
  };
}

function count_reader(own r: Reader): Result[Counts, IoError] {
  let acc = Counts { lines: 0, words: 0, bytes: 0 };
  defer r.close();
  let lr = io_buffered.line_reader_new(r, 10, 65536);
  loop {
    let (line, next) = lr.next_line()?;
    lr = next;
    let Some(l) = line else {
      return Ok(acc);
    };
    acc = count_chunk(l, acc);
  }
}

function format_counts(label: string, c: Counts): string {
  return f"{c.lines}\t{c.words}\t{c.bytes}\t{label}";
}

function main(): i32 {
  let argv = args();
  let total = Counts { lines: 0, words: 0, bytes: 0 };
  let nfiles = 0;
  let status = 0;
  for path in array.drop(argv, 1) {
    match (open_reader(path)) {
      Ok(r) => {
        match (count_reader(r)) {
          Ok(got) => {
            print(format_counts(path, got));
            total = Counts {
              lines: total.lines + got.lines,
              words: total.words + got.words,
              bytes: total.bytes + got.bytes,
            };
            nfiles += 1;
          },
          Err(_) => {
            eprint(f"wc: {path}: read error");
            status = 1;
          }
        }
      },
      Err(_) => {
        eprint(f"wc: {path}: cannot open");
        status = 1;
      }
    }
  }
  if (argv.len() <= 1) {
    match (count_reader(stdin())) {
      Ok(got) => {
        print(format_counts("-", got));
      },
      Err(_) => {
        eprint("wc: -: read error");
        return 1;
      }
    }
  } else if (nfiles > 1) {
    print(format_counts("total", total));
  }
  return status;
}
