// wc.fern — word / line / byte counter, like `wc(1)`.
//
// Reads from each file path in argv (skipping argv[0]); falls
// back to stdin when no paths are given. Prints the per-input
// totals + a grand total.
//
// Showcases: command-line args, stdin/Reader API, file I/O,
// string methods (split, len), `defer` for cleanup, and the
// `Result` + `match` idiom for fallible operations.
//
//   $ fern -target wasm32-wasi -o wc.wasm wc.fern
//   $ wasmtime --dir=. wc.wasm README.md docs/LANGUAGE-DIRECTION.md
//   ...
// (string).split / (string).is_empty inside count_chunk; the
// f-string in format_counts dispatches (i32).to_string on
// each Counts field.
import "std/string";
import "std/i32";

struct Counts { lines: i32, words: i32, bytes: i32 }

function count_chunk(chunk: string, acc: Counts): Counts {
  // `read_line` strips the trailing '\n'; we count the line
  // ourselves by incrementing once per non-empty chunk.
  var parts: string[] = chunk.split(" ");
  var nwords: i32 = 0;
  var i: i32 = 0;
  while (i < parts.len()) {
    if (!parts[i].is_empty()) {
      nwords = nwords + 1;
    }
    i = i + 1;
  }
  // Functional update — produce a new Counts rather than mutating
  // acc in place (immutable-data-structures migration).
  return Counts {
    ...acc,
    bytes: acc.bytes + chunk.len(),
    lines: acc.lines + 1,
    words: acc.words + nwords,
  };
}

function count_reader(r: Reader): Counts {
  var acc: Counts = Counts { lines: 0, words: 0, bytes: 0 };
  // `r.close()` is best-effort — its Option[IoError] return
  // is dropped here. defer fires even when one of the match
  // arms below short-circuits with `return`.
  defer r.close();
  while (true) {
    match (r.read_line()) {
      Some(line) => {
        acc = count_chunk(line, acc);
      },
      None => {
        return acc;
      }
    }
  }
  return acc;  // unreachable
}

function format_counts(label: string, c: Counts): string {
  return f"{c.lines}\t{c.words}\t{c.bytes}\t{label}";
}

function main(): i32 {
  var argv: string[] = args();
  var total: Counts = Counts { lines: 0, words: 0, bytes: 0 };
  var nfiles: i32 = 0;
  var i: i32 = 1;  // skip argv[0]
  while (i < argv.len()) {
    var path: string = argv[i];
    match (open_reader(path)) {
      Ok(r) => {
        var got: Counts = count_reader(r);
        print(format_counts(path, got));
        total = Counts {
          lines: total.lines + got.lines,
          words: total.words + got.words,
          bytes: total.bytes + got.bytes,
        };
        nfiles = nfiles + 1;
      },
      Err(_) => {
        eprint("wc: " + path + ": cannot open");
      }
    }
    i = i + 1;
  }
  if (nfiles == 0) {
    var stdin_got: Counts = count_reader(stdin());
    print(format_counts("-", stdin_got));
  } else if (nfiles > 1) {
    print(format_counts("total", total));
  }
  return 0;
}
