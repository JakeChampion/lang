// use_chain.lang — Gleam-style `use` syntax for chained
// fallible operations, plus the closure-factory pattern.
//
// `use n: i32 <- f(arg);` desugars at parse time to:
//   f(arg, function (n: i32) { <rest of block> });
// flattening the pyramid that `match` / `if-let` would
// otherwise force on right-leaning chains.
//
// Showcases: closures (the `adder` factory returns a
// closure capturing `n`), `use` desugaring across
// fallible Option-returning calls, defunctionalisation —
// the closure factory's return-target is monomorphic, so
// PR #204 rewrites the call site to a direct call, then
// PR #205 drops the closure-pair allocation entirely.
// Final emitted wat for `add7(35)` ends up as a direct
// call (or fully inlined when the body fits) with no
// call_indirect at all.
//
// Note on `use`: the lang's closure capture today is
// scalar-only (i32 / i64 / floats / bool — no arrays /
// strings / structs), so `use` chains across array values
// don't work yet. The chain here threads scalars only.
//
//   $ wasmtime use_chain.wasm
//   triple-doubled then plus two: 10
//   adder factory: 7 + 35 = 42
import "core/no_prelude";
// `.to_string()` on i32 inside main's match arm.
import "std/i32";

function adder(n: i32): (i32) => i32 {
  function add(x: i32): i32 {
    return x + n;
  }
  return add;
}

// Helper that wraps the result-or-fail Option pattern in
// the use-friendly `(value, callback) -> result` shape.
// The use-syntax expects the receiving function to take a
// callback as its LAST parameter.
function maybe_double(n: i32, cb: (i32) => Option[i32]): Option[i32] {
  return cb(n + n);
}

function maybe_plus2(n: i32, cb: (i32) => Option[i32]): Option[i32] {
  return cb(n + 2);
}

// Triple-double + 2 via `use`. Equivalent to:
//   maybe_double(start, fn(a) {
//     maybe_double(a, fn(b) {
//       maybe_double(b, fn(c) { Some(c + 2) })
//     })
//   })
// but written linearly without the right-leaning pyramid.
function chain(start: i32): Option[i32] {
  function __use_4(a: i32): Option[i32] {
    function __use_3(b: i32): Option[i32] {
      function __use_2(c: i32): Option[i32] {
        function __use_1(d: i32): Option[i32] {
          return Some(d);
        }
        return maybe_plus2(c, __use_1);
      }
      return maybe_double(b, __use_2);
    }
    return maybe_double(a, __use_3);
  }
  return maybe_double(start, __use_4);
}

function main(): i32 {
  match (chain(1)) {
    Some(n) => {
      print("triple-doubled then plus two: " + n.to_string());
    },
    None => {
      print("triple-doubled then plus two: fail");
    }
  }
  var add7: (i32) => i32 = adder(7);
  print("adder factory: 7 + 35 = " + add7(35).to_string());
  return 0;
}
