// word_freq.fern — read text from stdin, print the top-N
// most-frequent words as `count<TAB>word`, ordered.
//
// Showcases: the auto-injected Map[K, V] for the count
// table (string keys, i32 values), `m.keys()` / `m.values()`
// for parallel-array snapshots, `s.to_lower` for the
// case-fold pass, manual whitespace tokenisation via
// byte-class matching, `defer` for the stdin close, and the
// immutable-array update idiom (`arr = arr.with(i, value)`)
// — arrays are values, so `sort_pairs` returns the reordered
// pair as a tuple rather than mutating in place.
//
//   $ printf 'a b a c b a' | wasmtime word_freq.wasm
//   3\ta
//   2\tb
//   1\tc
// Map runtime for the count table; std/string for
// (string).to_lower and the tokenisation byte-class methods;
// std/i32 for the f-string interpolation of counts.
import "core/map";
import "std/string";
import "std/i32";

function read_all(r: Reader): string {
  let out: string = "";
  while (true) {
    match (r.read_line()) {
      Some(line) => {
        out = out + line + "\n";
      },
      None => {
        return out;
      }
    }
  }
  return out;  // unreachable
}

// Tokenize on whitespace. Simplification: ASCII punctuation
// stays attached to words. A real version would walk bytes
// and split on the wider whitespace + punctuation classes.
function tokenize(s: string): string[] {
  let lower: string = s.to_lower();
  let out: string[] = [];
  let i: i32 = 0;
  let sLen: i32 = lower.len();
  let start: i32 = 0;
  while (i <= sLen) {
    let b: i32 = 0;
    if (i < sLen) {
      b = lower[i] as i32;
    }
    let is_break: boolean = i == sLen || b == 32 || b == 9 || b == 10 || b == 13;
    if (is_break) {
      if (i > start) {
        out = out.append(slice_unchecked(lower, start, i).to_owned());
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

// Sort by count descending via insertion sort on parallel
// keys / counts arrays. Arrays are immutable, so each swap
// rebinds the locals through `.with(...)` and the reordered
// pair is returned to the caller as a tuple — the rebinds
// inside this function aren't visible outside it.
function sort_pairs(keys: string[], counts: i32[]): (string[], i32[]) {
  let i: i32 = 1;
  while (i < counts.len()) {
    let j: i32 = i;
    while (j > 0 && counts[j] > counts[j - 1]) {
      let tk: string = keys[j];
      let tc: i32 = counts[j];
      keys = keys.with(j, keys[j - 1]);
      counts = counts.with(j, counts[j - 1]);
      keys = keys.with(j - 1, tk);
      counts = counts.with(j - 1, tc);
      j = j - 1;
    }
    i = i + 1;
  }
  return (keys, counts);
}

function main(): i32 {
  let r: Reader = stdin();
  defer r.close();
  let text: string = read_all(r);
  let words: string[] = tokenize(text);
  let counts: Map[string, i32] = map_new(64);
  let i: i32 = 0;
  while (i < words.len()) {
    let w: string = words[i];
    match (counts.get(w)) {
      Some(n) => {
        counts = counts.insert(w, n + 1);
      },
      None => {
        counts = counts.insert(w, 1);
      }
    }
    i = i + 1;
  }
  // Snapshot keys + values into parallel arrays for sort.
  // Insertion-order Map.iter() doesn't guarantee count
  // order — that's what sort_pairs is for.
  let keys_arr: string[] = counts.keys();
  let vals_arr: i32[] = counts.values();
  let sorted: (string[], i32[]) = sort_pairs(keys_arr, vals_arr);
  keys_arr = sorted.0;
  vals_arr = sorted.1;
  let topN: i32 = 5;
  if (keys_arr.len() < topN) {
    topN = keys_arr.len();
  }
  let k: i32 = 0;
  while (k < topN) {
    print(vals_arr[k].to_string() + "\t" + keys_arr[k]);
    k = k + 1;
  }
  return 0;
}
