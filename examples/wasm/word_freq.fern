import "std/unicode";
import "core/map";
import "std/io";
import "std/string";
import "std/i32";

function tokenize(s: string): string[] {
  let lower = s.to_lower();
  let out: string[] = [];
  let n = lower.len();
  let start = 0;
  for i in 0..=n {
    let b = if (i < n) { lower[i] } else { 0 };
    let is_break = i == n || b == b' ' || b == b'\t' || b == b'\n' || b == b'\r';
    if (is_break) {
      if (i > start) {
        out = out.append(slice_unchecked(lower, start, i).to_owned());
      }
      start = i + 1;
    }
  }
  return out;
}

function sort_pairs(keys: string[], counts: i32[]): (string[], i32[]) {
  for i in 1..counts.len() {
    let j = i;
    while (j > 0 && counts[j] > counts[j - 1]) {
      let tk = keys[j];
      let tc = counts[j];
      keys = keys.with(j, keys[j - 1]);
      counts = counts.with(j, counts[j - 1]);
      keys = keys.with(j - 1, tk);
      counts = counts.with(j - 1, tc);
      j -= 1;
    }
  }
  return (keys, counts);
}

function main(): i32 {
  let Ok(text) = io.read_all_stdin() else {
    eprint("word_freq: cannot read stdin");
    return 1;
  };
  let counts: Map[string, i32] = map_new(64);
  for w in tokenize(text) {
    if let Some(n) = counts.get(w) {
      counts = counts.insert(w, n + 1);
    } else {
      counts = counts.insert(w, 1);
    }
  }
  let (keys, vals) = sort_pairs(counts.keys(), counts.values());
  for k in 0..keys.len().min(5) {
    print(f"{vals[k]}\t{keys[k]}");
  }
  return 0;
}
