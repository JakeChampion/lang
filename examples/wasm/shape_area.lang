// shape_area.lang — pattern-matching tour over user-defined
// enums with mixed-type payloads.
//
// Showcases: tagged-union enums with numeric + struct
// payloads, exhaustive `match` over variants, payload
// destructuring (`Circle(r)`), match guards
// (`Square(side) when side <= 0 => …`), generic enums
// (`Result[T, E]`) and the auto-injected Option built-in,
// the IR's wide-payload (i64 / f64) handling — `Volume`
// uses `f64` for the result so heap allocations carry the
// 8-byte slot from PR #184.
//
//   $ wasmtime shape_area.wasm
//   circle r=2.5 → area 19.6349372
//   square s=3 → area 9
//   triangle b=4 h=2.5 → area 5
//   degenerate input → area: zero or negative side
//   cuboid 2x3x5 → volume 30
enum Shape { Circle(f32), Square(f32), Triangle(f32, f32), Cuboid(f64, f64, f64) }

// radius
// side
// base, height
// wide-payload demo
// `area` returns Result[f32, string] — Ok on success, Err
// with a description otherwise. Match guards drop into the
// next arm when the predicate fails.
function area(s: Shape): Result[f32, string] {
  match (s) {
    Circle(r) when r <= 0 as f32 => {
      return Err("non-positive radius");
    },
    Circle(r) => {
      return Ok(3.14159 as f32 * r * r);
    },
    Square(side) when side <= 0 as f32 => {
      return Err("zero or negative side");
    },
    Square(side) => {
      return Ok(side * side);
    },
    Triangle(b, h) when b <= 0 as f32 || h <= 0 as f32 => {
      return Err("non-positive triangle dim");
    },
    Triangle(b, h) => {
      return Ok(0.5 as f32 * b * h);
    },
    Cuboid(_, _, _) => {
      return Err("area undefined for 3D -- call volume()");
    }
  }
  return Err("unreachable");
}

// 8-byte payload demo: f64 multiplication in match-bound
// locals. The IR's wide-payload work (PR #184) lays out
// `Cuboid(f64, f64, f64)` with 8-byte slots at the right
// offsets; the destructuring loads each via f64.load.
function volume(s: Shape): f64 {
  match (s) {
    Cuboid(x, y, z) => {
      return x * y * z;
    },
    Circle(_) => {
      return 0 as f64;
    },
    Square(_) => {
      return 0 as f64;
    },
    Triangle(_, _) => {
      return 0 as f64;
    }
  }
  return 0 as f64;
}

function show_area(label: string, s: Shape): void {
  match (area(s)) {
    Ok(a) => {
      print(f"{label} -> area {a}");
    },
    Err(msg) => {
      print(f"{label} -> area: {msg}");
    }
  }
}

function main(): i32 {
  show_area("circle r=2.5", Circle(2.5 as f32));
  show_area("square s=3", Square(3 as f32));
  show_area("triangle b=4 h=2.5", Triangle(4 as f32, 2.5 as f32));
  show_area("degenerate input", Square(0 as f32));
  print(f"cuboid 2x3x5 -> volume {volume(Cuboid(2 as f64, 3 as f64, 5 as f64))}");
  return 0;
}
