// todo_api.lang — wasi:http TODO-shaped API with persistent
// state. Cross-request state lives in a `state {}` block —
// the two-cursor allocator (PR #227) routes state-rooted
// allocations to the persistent heap region so Map.set /
// Map.delete grows survive the per-request arena_restore at
// handler exit.
//
// Routes:
//   GET    /todos          — list every todo, sorted by id
//   POST   /todos          — create a new todo from JSON;
//                            assigns the next id and returns
//                            the created object
//   GET    /todos/<id>     — return one todo (404 if missing)
//   DELETE /todos/<id>     — remove one todo (404 if missing)
//
// Showcases: state{} with `Map[i32, string]` mutated across
// requests, `next_id` counter incrementing on POST, nested
// match over JsonValue, the generic Map[K, V] / MapIter API,
// the implicit per-request arena (per-request JsonValue
// allocations get reclaimed at handler return; only state
// allocations survive — see PR #227).
//
// State persistence across `handle()` invocations depends on
// the host runtime keeping the wasm instance alive between
// requests. `wasmtime serve` instantiates a fresh module per
// request, so each call resets state to its initial values
// (next_id=1, todos empty). Production hosts that reuse
// instances (Fastly Compute, Netlify Edge Functions, custom
// wasmtime embeddings) DO see cross-request persistence.
//
//   $ lang -target wasi-http -wasi-adapter ... -o todo.wasm todo_api.lang
//   $ wasmtime serve todo.wasm &
//   $ curl -X POST -d '{"text":"buy milk"}' http://localhost:8080/todos
//   {"id":1,"text":"buy milk"}
//   $ curl http://localhost:8080/todos
//   [{"id":1,"text":"buy milk"}]

state {
  // Persistent todo store. Keyed by integer id, value is the
  // todo's text. Survives `arena_save` / `arena_restore` at
  // each handle() boundary because state-rooted Map.set calls
  // toggle the persistent allocator mode for the duration of
  // the call (PR #227).
  var todos: Map[i32, string] = map_new(8);
  // Monotonic id counter. POST advances this; nothing else
  // reads it. Starting at 1 keeps the first id user-friendly.
  var next_id: i32 = 1;
}

function ok(body: string): HttpResponse {
  return HttpResponse { status: 200, body: body };
}

function err(code: i32, msg: string): HttpResponse {
  return HttpResponse { status: code, body: msg + "\n" };
}

// Build a JsonValue object {"id": id, "text": text}.
function todo_json(id: i32, text: string): JsonValue {
  var m: Map[string, JsonValue] = map_new(2);
  m.set("id", JNumber(id.to_string()));
  m.set("text", JString(text));
  return JObject(m);
}

// Path /todos/<id> → Some(id). Returns None on shape
// mismatch or non-integer trailing segment.
function path_id(path: string): Option[i32] {
  var prefix: string = "/todos/";
  if (!path.starts_with(prefix)) {
    return None;
  }
  return path[len(prefix):len(path)].parse_int();
}

// Pull `text` field out of a parsed JsonValue request body.
// Returns None on any structural mismatch.
function extract_text(v: JsonValue): Option[string] {
  match (v) {
    JObject(m) => {
      match (m.get("text")) {
        Some(text_v) => {
          match (text_v) {
            JString(t) => {
              return Some(t);
            },
            _ => {
              return None;
            }
          }
        },
        None => {
          return None;
        }
      }
    },
    _ => {
      return None;
    }
  }
  return None;  // unreachable
}

// Snapshot the persistent store into a JsonValue array
// sorted by id. The Map's iteration order is insertion-
// ordered; sorting is a (small) per-request cost paid out of
// the per-request arena, so it doesn't bloat persistent
// state.
function handle_list(): HttpResponse {
  var ids: i32[] = todos.keys();
  // Insertion-sort the keys ascending. Per-request arena
  // alloc; the array goes away at handler exit.
  var i: i32 = 1;
  while (i < len(ids)) {
    var j: i32 = i;
    while (j > 0 && ids[j - 1] > ids[j]) {
      var tmp: i32 = ids[j - 1];
      ids[j - 1] = ids[j];
      ids[j] = tmp;
      j = j - 1;
    }
    i = i + 1;
  }
  var arr: JsonValue[] = [];
  var k: i32 = 0;
  while (k < len(ids)) {
    var id: i32 = ids[k];
    arr = arr.push(todo_json(id, todos.get_or(id, "")));
    k = k + 1;
  }
  return ok(json_encode(JArray(arr)));
}

function handle_create(body: string): HttpResponse {
  match (json_parse(body)) {
    None => {
      return err(400, "invalid JSON");
    },
    Some(v) => {
      match (extract_text(v)) {
        Some(text) => {
          var id: i32 = next_id;
          todos.set(id, text);
          next_id = next_id + 1;
          return ok(json_encode(todo_json(id, text)));
        },
        None => {
          return err(400, "expected {\"text\": string}");
        }
      }
    }
  }
  return err(500, "unreachable");
}

function handle_get_one(id: i32): HttpResponse {
  if (todos.has(id)) {
    return ok(json_encode(todo_json(id, todos.get_or(id, ""))));
  }
  return err(404, "not found");
}

function handle_delete(id: i32): HttpResponse {
  if (todos.delete(id)) {
    return ok("");
  }
  return err(404, "not found");
}

function handle(req: HttpRequest): HttpResponse {
  if (req.method == "GET" && req.path == "/todos") {
    return handle_list();
  }
  if (req.method == "POST" && req.path == "/todos") {
    return handle_create(req.body);
  }
  if (req.path.starts_with("/todos/")) {
    match (path_id(req.path)) {
      Some(id) => {
        if (req.method == "GET") {
          return handle_get_one(id);
        }
        if (req.method == "DELETE") {
          return handle_delete(id);
        }
        return err(405, "method not allowed");
      },
      None => {
        return err(400, "bad id");
      }
    }
  }
  return err(404, "not found");
}
