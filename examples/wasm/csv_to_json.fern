import "std/io";
import "std/json";
import "std/string";
import "std/i32";
import "std/array";

function row_to_object(headers: string[], row: string[]): json.JsonValue {
  let m = json.object();
  for i in 0..headers.len().min(row.len()) {
    m = m.insert(headers[i].trim().to_owned(), JString(row[i].trim().to_owned()));
  }
  return JObject(m);
}

function main(): i32 {
  let Ok(text) = io.read_all_stdin() else {
    eprint("csv_to_json: cannot read stdin");
    return 1;
  };
  let lines = text.trim().split("\n");
  if (lines.len() == 0 || lines[0].is_empty()) {
    print("[]");
    return 0;
  }
  let headers = lines[0].split(",");
  let rows: json.JsonValue[] = [];
  for line in array.drop(lines, 1) {
    if (!line.is_empty()) {
      rows = rows.append(row_to_object(headers, line.split(",")));
    }
  }
  print(json.encode(JArray(rows)));
  return 0;
}
